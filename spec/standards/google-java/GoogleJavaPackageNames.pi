use ../lib/CodingRule

from ./GoogleJava import GoogleJava

export coding-rule GoogleJavaPackageNames:
    standard: @{GoogleJava}
    ruleId: 5.2.1
    title: Write package and module names in lowercase without underscores
    statement:
        Use only lowercase letters and digits in package and module names,
        and join words directly with no separator.
    rationale:
        All-lowercase names avoid case problems across file systems and
        follow long Java convention.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        package com.example.orderHistory;
        package com.example.order_history;
        \\\
        ```
    compliant:
        ```java
        \\\
        package com.example.orderhistory;
        \\\
        ```
    languages: [java]
    tags: [naming, packages]
    source: https://google.github.io/styleguide/javaguide.html#s5.2.1-package-names
