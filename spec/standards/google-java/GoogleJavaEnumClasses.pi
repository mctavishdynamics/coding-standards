use ../lib/CodingRule

from ./GoogleJava import GoogleJava

export coding-rule GoogleJavaEnumClasses:
    standard: @{GoogleJava}
    ruleId: 4.8.1
    title: Format enum classes like other classes, with some freedom for constants
    statement:
        Enum constants may each sit on their own line or share lines, and blank
        lines between them are permitted. When the enum has neither methods nor
        javadoc on its constants, it can be laid out on one line like an array
        initializer. Beyond that, an enum follows the same formatting as any
        class.
    rationale:
        Enums are classes, so they share class formatting, but simple
        constant lists read best when kept compact.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```java
        \\\
        enum Direction { NORTH, EAST, SOUTH, WEST }

        enum Level {
          LOW,
          HIGH {
            @Override boolean isUrgent() {
              return true;
            }
          };

          boolean isUrgent() {
            return false;
          }
        }
        \\\
        ```
    languages: [java]
    tags: [formatting, enums]
    source: https://google.github.io/styleguide/javaguide.html#s4.8.1-enum-classes
