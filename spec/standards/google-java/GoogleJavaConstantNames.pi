use ../lib/CodingRule

from ./GoogleJava import GoogleJava

export coding-rule GoogleJavaConstantNames:
    standard: @{GoogleJava}
    ruleId: 5.2.4
    title: Write constant names in UPPER_SNAKE_CASE
    statement:
        Constants use UPPER_SNAKE_CASE. A field counts as a constant only
        when it is static and final, its contents can never change, and
        calling its methods causes no observable effect; a static final
        field that holds changeable state is named like any other field.
    rationale:
        The distinct style tells readers a value can never change, so it
        must be reserved for values that truly cannot.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        static final int maxRetries = 3;
        static final List<String> ALLOWED_HOSTS = new ArrayList<>();
        \\\
        ```
    compliant:
        ```java
        \\\
        static final int MAX_RETRIES = 3;
        static final ImmutableList<String> ALLOWED_HOSTS = ImmutableList.of("a.example", "b.example");
        static final List<String> pendingHosts = new ArrayList<>();
        \\\
        ```
    languages: [java]
    tags: [naming, constants, immutability]
    source: https://google.github.io/styleguide/javaguide.html#s5.2.4-constant-names
