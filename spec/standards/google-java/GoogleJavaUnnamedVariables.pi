use ../lib/CodingRule

from ./GoogleJava import GoogleJava

export coding-rule GoogleJavaUnnamedVariables:
    standard: @{GoogleJava}
    ruleId: 5.2.9
    title: Use the underscore for unused variables where the language allows
    statement:
        The underscore syntax for unnamed variables and parameters may be
        used wherever it applies.
    rationale:
        An unnamed variable states plainly that the value is deliberately
        unused.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        Function<String, Integer> zero = ignored -> 0;
        \\\
        ```
    compliant:
        ```java
        \\\
        Function<String, Integer> zero = _ -> 0;
        \\\
        ```
    languages: [java]
    tags: [naming, variables]
    source: https://google.github.io/styleguide/javaguide.html#s5.2.9-unnamed-variables
