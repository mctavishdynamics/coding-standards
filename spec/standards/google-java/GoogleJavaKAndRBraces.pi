use ../lib/CodingRule

from ./GoogleJava import GoogleJava

export coding-rule GoogleJavaKAndRBraces:
    standard: @{GoogleJava}
    ruleId: 4.1.2
    title: Format nonempty blocks in K and R style
    statement:
        Use Kernighan and Ritchie bracing for blocks that have content: the
        opening brace ends the line that starts the block, the body begins
        on the next line, and the closing brace starts a line of its own. A
        line break follows the closing brace only if it finishes a statement
        or a method, constructor or named class body; so else, catch or a
        comma go right after it.
    rationale:
        A single brace style makes block structure look the same everywhere
        and keeps code compact.
    exceptions:
        Where a single statement could appear, a standalone block may be
        used, and its opening brace is then preceded by a line break; such
        blocks usually limit variable scope. Enum classes have some extra
        freedom, covered in 4.8.1.
    severity: null
    noncompliant:
        ```java
        \\\
        if (ready)
        {
          start();
        }
        else
        {
          wait(); }
        \\\
        ```
    compliant:
        ```java
        \\\
        if (ready) {
          start();
        } else {
          wait();
        }
        \\\
        ```
    languages: [java]
    tags: [formatting, braces]
    source: https://google.github.io/styleguide/javaguide.html#s4.1.2-blocks-k-r-style
