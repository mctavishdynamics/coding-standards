use ../lib/CodingRule

from ./GoogleJava import GoogleJava

export coding-rule GoogleJavaFileNameMatchesClass:
    standard: @{GoogleJava}
    ruleId: 2.1
    title: Name the file after its top-level class
    statement:
        A source file that contains classes is named exactly after its
        single top-level class, with matching case, plus the .java
        extension.
    rationale:
        Readers and tools can find a class from its file name and a file
        from its class name without searching.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        // File: orderqueue.java
        package com.example.shop;

        public final class OrderQueue {}
        \\\
        ```
    compliant:
        ```java
        \\\
        // File: OrderQueue.java
        package com.example.shop;

        public final class OrderQueue {}
        \\\
        ```
    languages: [java]
    tags: [source-files, naming]
    source: https://google.github.io/styleguide/javaguide.html#s2.1-file-name
