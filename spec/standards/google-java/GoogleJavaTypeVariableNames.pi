use ../lib/CodingRule

from ./GoogleJava import GoogleJava

export coding-rule GoogleJavaTypeVariableNames:
    standard: @{GoogleJava}
    ruleId: 5.2.8
    title: Name type variables with one capital letter or a class name plus T
    statement:
        Name a type variable either with a single capital letter, optionally
        followed by one digit, or with a class-style name followed by a
        capital T.
    rationale:
        Both forms are short and clearly distinguish type parameters from
        real classes.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        interface Cache<key, Value> {}
        \\\
        ```
    compliant:
        ```java
        \\\
        interface Cache<K, V> {}
        interface Handler<RequestT, ResponseT> {}
        \\\
        ```
    languages: [java]
    tags: [naming, generics]
    source: https://google.github.io/styleguide/javaguide.html#s5.2.8-type-variable-names
