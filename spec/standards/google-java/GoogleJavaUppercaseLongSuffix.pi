use ../lib/CodingRule

from ./GoogleJava import GoogleJava

export coding-rule GoogleJavaUppercaseLongSuffix:
    standard: @{GoogleJava}
    ruleId: 4.8.8
    title: Use an uppercase L suffix on long literals
    statement:
        Write the suffix of a long integer literal as an uppercase L, never
        a lowercase l.
    rationale:
        A lowercase l is easily mistaken for the digit 1.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        long maxBytes = 2147483648l;
        \\\
        ```
    compliant:
        ```java
        \\\
        long maxBytes = 2147483648L;
        \\\
        ```
    languages: [java]
    tags: [literals]
    source: https://google.github.io/styleguide/javaguide.html#s4.8.8-numeric-literals
