use ../lib/CodingRule

from ./GoogleJava import GoogleJava

export coding-rule GoogleJavaOverloadsNeverSplit:
    standard: @{GoogleJava}
    ruleId: 3.4.2.1
    title: Keep overloads together
    statement:
        Keep all methods with the same name next to each other, with nothing
        else in between, and group constructors the same way. Differences in
        modifiers, for instance one being static or private, do not justify
        splitting them.
    rationale:
        Readers comparing overloads expect to see all variants side by side.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        final class Totals {
          int sum(int a, int b) {
            return a + b;
          }

          int count() {
            return 0;
          }

          int sum(int a, int b, int c) {
            return a + b + c;
          }
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        final class Totals {
          int sum(int a, int b) {
            return a + b;
          }

          int sum(int a, int b, int c) {
            return a + b + c;
          }

          int count() {
            return 0;
          }
        }
        \\\
        ```
    languages: [java]
    tags: [classes, ordering, overloading]
    source: https://google.github.io/styleguide/javaguide.html#s3.4.2.1-overloads-never-split
