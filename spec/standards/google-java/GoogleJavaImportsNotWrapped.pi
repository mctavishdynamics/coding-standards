use ../lib/CodingRule

from ./GoogleJava import GoogleJava

export coding-rule GoogleJavaImportsNotWrapped:
    standard: @{GoogleJava}
    ruleId: 3.3.2
    title: Do not line-wrap imports
    statement:
        Keep each import statement on a single line. The column limit does
        not apply to imports.
    rationale:
        Single-line imports stay easy to sort, search and compare in diffs.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        import com.example.platform.notifications.delivery
            .RetryingEmailDispatcher;
        \\\
        ```
    compliant:
        ```java
        \\\
        import com.example.platform.notifications.delivery.RetryingEmailDispatcher;
        \\\
        ```
    languages: [java]
    tags: [imports, line-wrapping]
    source: https://google.github.io/styleguide/javaguide.html#s3.3.2-import-line-wrapping
