use ../lib/CodingRule

from ./GoogleJava import GoogleJava

export coding-rule GoogleJavaParameterNames:
    standard: @{GoogleJava}
    ruleId: 5.2.6
    title: Write parameter names in lowerCamelCase
    statement:
        Parameters use lowerCamelCase. Public methods should not have
        parameters whose names are just one letter.
    rationale:
        Descriptive parameter names document a public API where callers see
        them in Javadoc and IDE hints.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        public Money convert(Money m, Currency c) {}
        \\\
        ```
    compliant:
        ```java
        \\\
        public Money convert(Money amount, Currency target) {}
        \\\
        ```
    languages: [java]
    tags: [naming, parameters]
    source: https://google.github.io/styleguide/javaguide.html#s5.2.6-parameter-names
