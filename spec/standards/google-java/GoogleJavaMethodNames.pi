use ../lib/CodingRule

from ./GoogleJava import GoogleJava

export coding-rule GoogleJavaMethodNames:
    standard: @{GoogleJava}
    ruleId: 5.2.3
    title: Write method names in lowerCamelCase
    statement:
        Name methods in lowerCamelCase, usually with a verb or verb phrase.
    rationale:
        Verb names in a consistent case tell the reader that the name
        performs an action.
    exceptions:
        JUnit test method names may use underscores to separate logical
        parts, each part in lowerCamelCase.
    severity: null
    noncompliant:
        ```java
        \\\
        void Send_Invoice(Invoice invoice) {}
        \\\
        ```
    compliant:
        ```java
        \\\
        void sendInvoice(Invoice invoice) {}

        @Test
        public void refund_restoresBalance() {}
        \\\
        ```
    languages: [java]
    tags: [naming, methods]
    source: https://google.github.io/styleguide/javaguide.html#s5.2.3-method-names
