use ../lib/CodingRule

from ./GoogleJava import GoogleJava

export coding-rule GoogleJavaOneStatementPerLine:
    standard: @{GoogleJava}
    ruleId: 4.3
    title: Put one statement per line
    statement:
        End every statement with a line break.
    rationale:
        One statement per line makes each step visible, easier to debug and
        cleaner in diffs.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        count++; total += price; log(total);
        \\\
        ```
    compliant:
        ```java
        \\\
        count++;
        total += price;
        log(total);
        \\\
        ```
    languages: [java]
    tags: [formatting]
    source: https://google.github.io/styleguide/javaguide.html#s4.3-one-statement-per-line
