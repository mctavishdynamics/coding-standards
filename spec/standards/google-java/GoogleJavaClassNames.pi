use ../lib/CodingRule

from ./GoogleJava import GoogleJava

export coding-rule GoogleJavaClassNames:
    standard: @{GoogleJava}
    ruleId: 5.2.2
    title: Write class names in UpperCamelCase
    statement:
        Name classes in UpperCamelCase, usually with a noun or noun phrase;
        interfaces may also use adjectives. Name a test class with a Test
        suffix, and for a test of a single class use that class's name plus
        Test.
    rationale:
        Consistent casing separates types from variables at a glance, and
        the Test suffix links each test to the code it covers.
    exceptions:
        There is no fixed convention for naming annotation types.
    severity: null
    noncompliant:
        ```java
        \\\
        class invoice_printer {}
        class TestsForRateCalculator {}
        \\\
        ```
    compliant:
        ```java
        \\\
        class InvoicePrinter {}
        class RateCalculatorTest {}
        \\\
        ```
    languages: [java]
    tags: [naming, classes]
    source: https://google.github.io/styleguide/javaguide.html#s5.2.2-class-names
