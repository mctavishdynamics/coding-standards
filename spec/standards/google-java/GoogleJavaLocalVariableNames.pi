use ../lib/CodingRule

from ./GoogleJava import GoogleJava

export coding-rule GoogleJavaLocalVariableNames:
    standard: @{GoogleJava}
    ruleId: 5.2.7
    title: Write local variable names in lowerCamelCase
    statement:
        Name local variables in lowerCamelCase, even final and immutable
        ones; they are not constants and are not styled as constants.
    rationale:
        Constant style is reserved for static final fields, so using it for
        locals would send a misleading signal.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        final int MAX_ATTEMPTS = config.attempts();
        \\\
        ```
    compliant:
        ```java
        \\\
        final int maxAttempts = config.attempts();
        \\\
        ```
    languages: [java]
    tags: [naming, variables]
    source: https://google.github.io/styleguide/javaguide.html#s5.2.7-local-variable-names
