from ./GoogleJavaTextBlocks import GoogleJavaTextBlocks
from ./GoogleJavaTodoComments import GoogleJavaTodoComments
from ./GoogleJavaTypeUseAnnotations import GoogleJavaTypeUseAnnotations
from ./GoogleJavaTypeVariableNames import GoogleJavaTypeVariableNames
from ./GoogleJavaUnnamedVariables import GoogleJavaUnnamedVariables
from ./GoogleJavaUppercaseLongSuffix import GoogleJavaUppercaseLongSuffix
from ./GoogleJavaVerticalWhitespace import GoogleJavaVerticalWhitespace
from ./GoogleJavaWhereToBreak import GoogleJavaWhereToBreak
from ./GoogleJavaWhitespaceCharacters import GoogleJavaWhitespaceCharacters

export coding-standard GoogleJava:
    title: Google Java Style Guide
    publisher: Google
    url: https://google.github.io/styleguide/javaguide.html
    version: null
    license: CC BY 3.0 (code samples Apache 2.0)
    description:
        Google's style rules for Java source code, covering file structure,
        formatting, naming, programming practices and Javadoc.
    rules:
        - @{GoogleJavaFileNameMatchesClass}
        - @{GoogleJavaFileEncodingUtf8}
        - @{GoogleJavaWhitespaceCharacters}
        - @{GoogleJavaSpecialEscapeSequences}
        - @{GoogleJavaNonAsciiCharacters}
        - @{GoogleJavaSourceFileStructure}
        - @{GoogleJavaCopyrightPlacement}
        - @{GoogleJavaPackageDeclaration}
        - @{GoogleJavaNoWildcardImports}
        - @{GoogleJavaNoModuleImports}
        - @{GoogleJavaImportsNotWrapped}
        - @{GoogleJavaImportOrdering}
        - @{GoogleJavaNoStaticImportForClasses}
        - @{GoogleJavaOneTopLevelClass}
        - @{GoogleJavaLogicalMemberOrdering}
        - @{GoogleJavaOverloadsNeverSplit}
        - @{GoogleJavaModuleDirectiveOrdering}
        - @{GoogleJavaBracesAlwaysUsed}
        - @{GoogleJavaKAndRBraces}
        - @{GoogleJavaEmptyBlocks}
        - @{GoogleJavaBlockIndentation}
        - @{GoogleJavaOneStatementPerLine}
        - @{GoogleJavaColumnLimit}
        - @{GoogleJavaWhereToBreak}
        - @{GoogleJavaContinuationIndent}
        - @{GoogleJavaVerticalWhitespace}
        - @{GoogleJavaHorizontalWhitespace}
        - @{GoogleJavaHorizontalAlignment}
        - @{GoogleJavaGroupingParentheses}
        - @{GoogleJavaEnumClasses}
        - @{GoogleJavaOneVariablePerDeclaration}
        - @{GoogleJavaDeclaredWhenNeeded}
        - @{GoogleJavaArrayInitializers}
        - @{GoogleJavaNoCStyleArrays}
        - @{GoogleJavaSwitchIndentation}
        - @{GoogleJavaSwitchFallThrough}
        - @{GoogleJavaSwitchExhaustive}
        - @{GoogleJavaSwitchExpressions}
        - @{GoogleJavaTypeUseAnnotations}
        - @{GoogleJavaClassAnnotations}
        - @{GoogleJavaMethodAnnotations}
        - @{GoogleJavaFieldAnnotations}
        - @{GoogleJavaBlockCommentStyle}
        - @{GoogleJavaTodoComments}
        - @{GoogleJavaModifierOrder}
        - @{GoogleJavaUppercaseLongSuffix}
        - @{GoogleJavaTextBlocks}
        - @{GoogleJavaIdentifierCharacters}
        - @{GoogleJavaPackageNames}
        - @{GoogleJavaClassNames}
        - @{GoogleJavaMethodNames}
        - @{GoogleJavaConstantNames}
        - @{GoogleJavaNonConstantFieldNames}
        - @{GoogleJavaParameterNames}
        - @{GoogleJavaLocalVariableNames}
        - @{GoogleJavaTypeVariableNames}
        - @{GoogleJavaUnnamedVariables}
        - @{GoogleJavaCamelCaseDefined}
        - @{GoogleJavaOverrideAlwaysUsed}
        - @{GoogleJavaCaughtExceptionsNotIgnored}
        - @{GoogleJavaStaticMembersQualifiedByClass}
        - @{GoogleJavaNoFinalizers}
        - @{GoogleJavaJavadocGeneralForm}
        - @{GoogleJavaJavadocParagraphs}
        - @{GoogleJavaJavadocBlockTags}
        - @{GoogleJavaSummaryFragment}
        - @{GoogleJavaJavadocWhereRequired}
        - @{GoogleJavaJavadocSelfExplanatory}
        - @{GoogleJavaJavadocOverrides}
        - @{GoogleJavaNonRequiredJavadoc}
