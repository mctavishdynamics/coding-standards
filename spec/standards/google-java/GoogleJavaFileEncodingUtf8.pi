use ../lib/CodingRule

from ./GoogleJava import GoogleJava

export coding-rule GoogleJavaFileEncodingUtf8:
    standard: @{GoogleJava}
    ruleId: 2.2
    title: Encode source files in UTF-8
    statement:
        Save every Java source file in the UTF-8 encoding.
    rationale:
        One fixed encoding means every editor, compiler and review tool
        reads the same characters, including non-ASCII text in strings and
        comments.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [java]
    tags: [source-files, encoding]
    source: https://google.github.io/styleguide/javaguide.html#s2.2-file-encoding
