use ../lib/CodingRule

from ./GoogleJava import GoogleJava

export coding-rule GoogleJavaFieldAnnotations:
    standard: @{GoogleJava}
    ruleId: 4.8.5.4
    title: Allow several field annotations on one line
    statement:
        Annotations on a field also come right after its documentation, but
        several of them, including ones with parameters, may share a line.
    rationale:
        Fields are short declarations, and stacking their annotations
        vertically would add noise.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```java
        \\\
        @Inject @Named("primary") DataSource dataSource;
        \\\
        ```
    languages: [java]
    tags: [annotations, formatting]
    source: https://google.github.io/styleguide/javaguide.html#s4.8.5.4-field-annotation-style
