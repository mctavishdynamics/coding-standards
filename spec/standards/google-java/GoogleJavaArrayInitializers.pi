use ../lib/CodingRule

from ./GoogleJava import GoogleJava

export coding-rule GoogleJavaArrayInitializers:
    standard: @{GoogleJava}
    ruleId: 4.8.3.1
    title: Format array initializers freely, optionally as blocks
    statement:
        An array initializer may be laid out as if it were a block-like
        construct, with elements on their own lines, or kept compact;
        several layouts are valid.
    rationale:
        Long or structured initializers read better as blocks, while short
        ones fit on a line.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```java
        \\\
        int[] primes = {2, 3, 5, 7};

        String[] weekdays = {
          "Monday",
          "Tuesday",
          "Wednesday",
        };
        \\\
        ```
    languages: [java]
    tags: [formatting, arrays]
    source: https://google.github.io/styleguide/javaguide.html#s4.8.3.1-array-initializers
