use ../lib/CodingRule

from ./GoogleJava import GoogleJava

export coding-rule GoogleJavaLogicalMemberOrdering:
    standard: @{GoogleJava}
    ruleId: 3.4.2
    title: Order class contents logically
    statement:
        Arrange the members and initializers of a class in some logical
        order that its maintainer could explain. Do not simply append new
        methods to the end of the class.
    rationale:
        A deliberate order makes a class easier to learn, while an order by
        date of addition carries no meaning for the reader.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [java]
    tags: [classes, ordering, readability]
    source: https://google.github.io/styleguide/javaguide.html#s3.4.2-ordering-class-contents
