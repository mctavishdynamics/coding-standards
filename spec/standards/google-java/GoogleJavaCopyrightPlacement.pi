use ../lib/CodingRule

from ./GoogleJava import GoogleJava

export coding-rule GoogleJavaCopyrightPlacement:
    standard: @{GoogleJava}
    ruleId: 3.1
    title: Put license or copyright information at the top of the file
    statement:
        If a file carries license or copyright information, place it first,
        before the package declaration.
    rationale:
        Legal notices are found in a predictable spot and do not interrupt
        the code.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        package com.example.billing;

        /* Copyright 2026 Example Ltd. */

        public final class Invoice {}
        \\\
        ```
    compliant:
        ```java
        \\\
        /* Copyright 2026 Example Ltd. */

        package com.example.billing;

        public final class Invoice {}
        \\\
        ```
    languages: [java]
    tags: [source-files, structure, licensing]
    source: https://google.github.io/styleguide/javaguide.html#s3.1-copyright-statement
