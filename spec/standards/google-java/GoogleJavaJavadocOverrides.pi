use ../lib/CodingRule

from ./GoogleJava import GoogleJava

export coding-rule GoogleJavaJavadocOverrides:
    standard: @{GoogleJava}
    ruleId: 7.3.2
    title: Javadoc may be omitted on overriding methods
    statement:
        Javadoc is optional on a method that overrides one from a superclass
        or interface.
    rationale:
        The supertype's documentation usually describes the contract
        already.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```java
        \\\
        @Override
        public int compareTo(Version other) {
          return Integer.compare(number, other.number);
        }
        \\\
        ```
    languages: [java]
    tags: [javadoc, documentation, inheritance]
    source: https://google.github.io/styleguide/javaguide.html#s7.3.2-javadoc-exception-overrides
