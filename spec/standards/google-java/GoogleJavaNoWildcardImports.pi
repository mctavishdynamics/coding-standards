use ../lib/CodingRule

from ./GoogleJava import GoogleJava

export coding-rule GoogleJavaNoWildcardImports:
    standard: @{GoogleJava}
    ruleId: 3.3.1
    title: Do not use wildcard imports
    statement:
        Import each type or static member by name. Do not use on-demand
        imports, static or otherwise.
    rationale:
        Named imports show exactly where each name comes from and avoid
        clashes when a package gains a class with the same simple name.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        import java.util.*;
        import static org.junit.Assert.*;
        \\\
        ```
    compliant:
        ```java
        \\\
        import static org.junit.Assert.assertEquals;

        import java.util.List;
        import java.util.Map;
        \\\
        ```
    languages: [java]
    tags: [imports]
    source: https://google.github.io/styleguide/javaguide.html#s3.3.1-wildcard-imports
