use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleMinimalAbstractions:
    standard: @{TigerStyle}
    ruleId: minimal-abstractions
    title: Keep abstractions few and well chosen
    statement:
        Introduce an abstraction only when it captures the domain especially
        well, and keep the total number small.
    rationale:
        No abstraction is free, and each one brings the risk that its
        details leak through.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [zig, any]
    tags: [design, abstraction]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#safety
