use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleZeroDependencies:
    standard: @{TigerStyle}
    ruleId: zero-dependencies
    title: Avoid external dependencies
    statement:
        Take on no dependencies beyond the language toolchain.
    rationale:
        Dependencies bring supply chain attacks, safety and performance
        risks and slow installs, and in foundational software their cost
        spreads through the whole stack.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [zig, any]
    tags: [dependencies, security]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#dependencies
