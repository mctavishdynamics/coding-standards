use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleFunctionLengthLimit:
    standard: @{TigerStyle}
    ruleId: function-length-limit
    title: Keep functions to 70 lines or fewer
    statement:
        Enforce a hard limit of seventy lines per function, and choose the
        places where you split a long function with care.
    rationale:
        Code that fits on one screen can be taken in at a glance, while
        having to scroll breaks that view.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [zig, any]
    tags: [function-length, readability]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#safety
