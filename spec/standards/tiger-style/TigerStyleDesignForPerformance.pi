use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleDesignForPerformance:
    standard: @{TigerStyle}
    ruleId: design-for-performance
    title: Consider performance from the design stage
    statement:
        Think about performance from the very start, while the design is
        still taking shape, and work with the grain of the hardware.
    rationale:
        The largest gains are only available during design, before anything
        can be measured, and fixing a slow system later is harder and yields
        less.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [zig, any]
    tags: [performance, design]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#performance
