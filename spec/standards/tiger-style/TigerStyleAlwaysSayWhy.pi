use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleAlwaysSayWhy:
    standard: @{TigerStyle}
    ruleId: always-say-why
    title: Explain the reason behind every decision
    statement:
        Whenever you make or communicate a decision, give the reasoning
        behind it.
    rationale:
        Explaining why helps others understand, makes them more likely to
        follow, and gives them the criteria to judge the decision
        themselves.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [zig, any]
    tags: [communication, documentation]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#safety
