use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleCommentsAreSentences:
    standard: @{TigerStyle}
    ruleId: comments-are-sentences
    title: Write comments as proper sentences
    statement:
        Write comments as sentences, with a space after the slashes, a
        capital letter and a closing full stop or colon. Trailing
        end-of-line comments may be short phrases.
    rationale:
        Comments are prose that explains the code and deserve the same care
        as any other writing.
    exceptions: null
    severity: null
    noncompliant:
        ```zig
        \\\
        //check bounds
        \\\
        ```
    compliant:
        ```zig
        \\\
        // Check bounds before indexing into the ring.
        \\\
        ```
    languages: [zig, any]
    tags: [comments, formatting]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#naming-things
