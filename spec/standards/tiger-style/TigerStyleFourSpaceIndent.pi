use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleFourSpaceIndent:
    standard: @{TigerStyle}
    ruleId: four-space-indent
    title: Indent with four spaces
    statement:
        Use four spaces per indentation level, not two.
    rationale:
        Four spaces are easier to see at a distance.
    exceptions: null
    severity: null
    noncompliant:
        ```zig
        \\\
        fn main() void {
          run();
        }
        \\\
        ```
    compliant:
        ```zig
        \\\
        fn main() void {
            run();
        }
        \\\
        ```
    languages: [zig, any]
    tags: [formatting, indentation]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#style-by-the-numbers
