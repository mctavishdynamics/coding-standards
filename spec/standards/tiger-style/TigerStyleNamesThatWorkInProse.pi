use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleNamesThatWorkInProse:
    standard: @{TigerStyle}
    ruleId: names-that-work-in-prose
    title: Prefer nouns that also work in documentation
    statement:
        Pick names that can be used unchanged in documents and conversation;
        nouns usually do this better than adjectives or participles.
    rationale:
        A noun can serve as a heading or be dropped into a sentence, and it
        composes cleanly into derived names.
    exceptions: null
    severity: null
    noncompliant:
        ```zig
        \\\
        replica.preparing
        \\\
        ```
    compliant:
        ```zig
        \\\
        replica.pipeline
        config.pipeline_max
        \\\
        ```
    languages: [zig, any]
    tags: [naming, documentation]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#naming-things
