use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleUnderstandBeforeFuzzing:
    standard: @{TigerStyle}
    ruleId: understand-before-fuzzing
    title: Build a mental model before relying on the fuzzer
    statement:
        Understand the code precisely first, encode that understanding as
        assertions, explain it in code and comments for the reviewer, and
        only then use simulation testing as the last safety net.
    rationale:
        A fuzzer can show that bugs exist but never that they are absent, so
        it cannot stand in for human understanding.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [zig, any]
    tags: [testing, assertions, review]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#safety
