use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleOptimizeSlowestResourcesFirst:
    standard: @{TigerStyle}
    ruleId: optimize-slowest-resources-first
    title: Optimize the slowest resources first
    statement:
        Work on network first, then disk, then memory, then CPU, after
        allowing for how often each is used.
    rationale:
        Slower resources usually dominate, but a fast operation repeated
        often enough, such as a cache miss, can cost as much as a slow one.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [zig, any]
    tags: [performance, optimization]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#performance
