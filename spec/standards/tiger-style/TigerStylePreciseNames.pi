use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStylePreciseNames:
    standard: @{TigerStyle}
    ruleId: precise-names
    title: Choose nouns and verbs that fit exactly
    statement:
        Take the time to choose nouns and verbs that say exactly what
        something is or does, and that combine well.
    rationale:
        Good names give the reader an accurate mental model and show that
        the author understands the domain.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [zig, any]
    tags: [naming]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#naming-things
