use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleRunToCompletion:
    standard: @{TigerStyle}
    ruleId: run-to-completion
    title: Make functions run to completion without suspending
    statement:
        Write functions that run from start to finish without suspending, so
        the preconditions asserted at the top remain true until they return.
    rationale:
        If a function suspends, other code can change state in between and
        its assertions become misleading.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [zig, any]
    tags: [concurrency, assertions]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#cache-invalidation
