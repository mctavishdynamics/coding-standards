use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStylePredictableCpuWork:
    standard: @{TigerStyle}
    ruleId: predictable-cpu-work
    title: Give the CPU large, predictable chunks of work
    statement:
        Feed the processor big, regular units of work and avoid code that
        makes it jump unpredictably between tasks.
    rationale:
        A CPU runs fastest on predictable straight-line work, which again
        comes down to batching.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [zig, any]
    tags: [performance, batching]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#performance
