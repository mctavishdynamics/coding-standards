use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleFunctionShape:
    standard: @{TigerStyle}
    ruleId: function-shape
    title: Prefer short parameter lists, simple return types and meaty bodies
    statement:
        Aim for functions shaped like an inverted hourglass: a small number
        of parameters, a simple return type and substantial logic in
        between.
    rationale:
        Narrow inputs and outputs keep call sites simple while the function
        itself does meaningful work.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [zig, any]
    tags: [functions, design]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#safety
