use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleTestExhaustively:
    standard: @{TigerStyle}
    ruleId: test-exhaustively
    title: Test with valid and invalid data and the transitions between them
    statement:
        Write tests that cover valid input, invalid input and the moment
        when valid data turns invalid.
    rationale:
        Bugs cluster at the boundary between valid and invalid states, so
        tests that stay on the happy path miss them.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [zig, any]
    tags: [testing, boundaries]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#safety
