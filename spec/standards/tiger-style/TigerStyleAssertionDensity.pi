use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleAssertionDensity:
    standard: @{TigerStyle}
    ruleId: assertion-density
    title: Average at least two assertions per function
    statement:
        Keep the density of assertions across the code at an average of two
        or more per function.
    rationale:
        A measurable target keeps assertions from being skipped and spreads
        checks throughout the code.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [zig, any]
    tags: [assertions, metrics]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#safety
