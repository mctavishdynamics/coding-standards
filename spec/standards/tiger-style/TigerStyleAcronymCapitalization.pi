use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleAcronymCapitalization:
    standard: @{TigerStyle}
    ruleId: acronym-capitalization
    title: Keep acronyms fully capitalized in names
    statement:
        Write acronyms inside names in their proper capitals, as in
        VSRState, not VsrState.
    rationale:
        Proper capitalization keeps the acronym recognizable.
    exceptions: null
    severity: null
    noncompliant:
        ```zig
        \\\
        const HttpClient = struct {};
        \\\
        ```
    compliant:
        ```zig
        \\\
        const HTTPClient = struct {};
        \\\
        ```
    languages: [zig, any]
    tags: [naming, case]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#naming-things
