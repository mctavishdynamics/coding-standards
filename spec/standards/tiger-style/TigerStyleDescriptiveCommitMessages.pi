use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleDescriptiveCommitMessages:
    standard: @{TigerStyle}
    ruleId: descriptive-commit-messages
    title: Write descriptive commit messages
    statement:
        Write commit messages that inform the reader. Do not rely on the
        pull request description, which is not stored in the repository.
    rationale:
        Commit messages are read later through history and blame, where a
        pull request description cannot be seen.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [zig, any]
    tags: [practice, version-control, documentation]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#naming-things
