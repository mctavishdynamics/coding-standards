use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStylePositionalSingletons:
    standard: @{TigerStyle}
    ruleId: positional-singletons
    title: Pass singleton dependencies positionally, general first
    statement:
        Pass dependencies such as an allocator or a tracer, which have
        unique types, through constructors as positional arguments ordered
        from most general to most specific.
    rationale:
        Their unique types already prevent mix-ups, so positional passing
        stays safe and keeps a consistent order.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [zig, any]
    tags: [parameters, dependencies]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#naming-things
