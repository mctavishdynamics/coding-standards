use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleStrictCompilerWarnings:
    standard: @{TigerStyle}
    ruleId: strict-compiler-warnings
    title: Heed all compiler warnings at the strictest setting
    statement:
        From the start of a project, compile with the strictest warning
        level and act on every warning.
    rationale:
        Warnings point to real defects early, and they are easiest to keep
        at zero if they are never allowed to accumulate.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [zig, any]
    tags: [tooling, warnings]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#safety
