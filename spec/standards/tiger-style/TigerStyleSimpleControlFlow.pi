use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleSimpleControlFlow:
    standard: @{TigerStyle}
    ruleId: simple-control-flow
    title: Use only simple, explicit control flow
    statement:
        Keep control flow plain and explicit so that every path through the
        code is easy to see.
    rationale:
        Simple control flow is easier to read, review and reason about,
        which is the first of the safety rules adapted from NASA's Power of
        Ten.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [zig, any]
    tags: [control-flow, safety]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#safety
