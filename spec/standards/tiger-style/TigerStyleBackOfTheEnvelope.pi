use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleBackOfTheEnvelope:
    standard: @{TigerStyle}
    ruleId: back-of-the-envelope
    title: Sketch resource costs on the back of an envelope
    statement:
        Estimate the bandwidth and latency of network, disk, memory and CPU
        for a design with quick rough calculations.
    rationale:
        Sketches cost almost nothing and are enough to land close to the
        best possible design.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [zig, any]
    tags: [performance, estimation]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#performance
