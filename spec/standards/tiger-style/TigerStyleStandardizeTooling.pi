use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleStandardizeTooling:
    standard: @{TigerStyle}
    ruleId: standardize-tooling
    title: Keep a small standard toolbox and write scripts in Zig
    statement:
        Prefer the tools you already use over adding new ones, and write
        project scripts in Zig rather than shell.
    rationale:
        A small set of tools is simpler to run, and scripts in the main
        language are portable and type safe, so they work for everyone on
        the team.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [zig, any]
    tags: [tooling, scripts]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#tooling
