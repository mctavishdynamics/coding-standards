use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleFollowZigStyleGuide:
    standard: @{TigerStyle}
    ruleId: follow-zig-style-guide
    title: Follow the Zig style guide for everything else
    statement:
        Where Tiger Style says nothing about naming, follow the official Zig
        style guide.
    rationale:
        Falling back on the language's own conventions keeps the code
        familiar to Zig programmers.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [zig]
    tags: [naming, conventions]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#naming-things
