use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleRunZigFmt:
    standard: @{TigerStyle}
    ruleId: run-zig-fmt
    title: Format code with zig fmt
    statement:
        Run the standard formatter on all code.
    rationale:
        A single automatic format removes style debates and keeps diffs
        focused.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [zig]
    tags: [formatting, tooling]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#style-by-the-numbers
