use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleCrashOnProgrammerErrors:
    standard: @{TigerStyle}
    ruleId: crash-on-programmer-errors
    title: Use assertions to crash on programmer errors
    statement:
        Use assertions to catch programmer mistakes, and treat a failed
        assertion as a reason to crash. Handle expected operating errors
        separately and gracefully.
    rationale:
        Crashing is the only safe response to code that is known to be
        wrong. It turns silent correctness bugs into visible liveness bugs
        and makes fuzzing far more effective.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [zig, any]
    tags: [assertions, error-handling]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#safety
