use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleZeroTechnicalDebt:
    standard: @{TigerStyle}
    ruleId: zero-technical-debt
    title: Fix design problems when they are found
    statement:
        Follow a zero technical debt policy: when a showstopper such as a
        latency spike or an exponential algorithm turns up, solve it before
        moving on instead of shipping it.
    rationale:
        Problems cost far less to fix in design or implementation than in
        production, and a second chance to fix them may never come.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [zig, any]
    tags: [practice, technical-debt, quality]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#technical-debt
