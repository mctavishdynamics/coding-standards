from ./TigerStyleStandardizeTooling import TigerStyleStandardizeTooling
from ./TigerStyleStateInvariantsPositively import
    TigerStyleStateInvariantsPositively
from ./TigerStyleStaticAllocation import TigerStyleStaticAllocation
from ./TigerStyleStrictCompilerWarnings import TigerStyleStrictCompilerWarnings
from ./TigerStyleTestExhaustively import TigerStyleTestExhaustively
from ./TigerStyleUnderstandBeforeFuzzing import
    TigerStyleUnderstandBeforeFuzzing
from ./TigerStyleUnitsLastInNames import TigerStyleUnitsLastInNames
from ./TigerStyleZeroDependencies import TigerStyleZeroDependencies
from ./TigerStyleZeroTechnicalDebt import TigerStyleZeroTechnicalDebt

export coding-standard TigerStyle:
    title: Tiger Style
    publisher: TigerBeetle
    url: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md
    version: 2026-07-16
    license: Apache License 2.0
    description:
        TigerBeetle's coding style for safety, performance and developer
        experience, covering assertions, explicit limits, static allocation,
        naming and formatting, written for Zig.
    rules:
        - @{TigerStyleZeroTechnicalDebt}
        - @{TigerStyleSimpleControlFlow}
        - @{TigerStyleNoRecursion}
        - @{TigerStyleMinimalAbstractions}
        - @{TigerStyleLimitEverything}
        - @{TigerStyleExplicitlySizedTypes}
        - @{TigerStyleCrashOnProgrammerErrors}
        - @{TigerStyleAssertArgumentsAndResults}
        - @{TigerStyleAssertionDensity}
        - @{TigerStylePairAssertions}
        - @{TigerStyleAssertionsAsDocumentation}
        - @{TigerStyleSplitCompoundAssertions}
        - @{TigerStyleAssertImplications}
        - @{TigerStyleAssertCompileTimeConstants}
        - @{TigerStyleAssertPositiveAndNegativeSpace}
        - @{TigerStyleTestExhaustively}
        - @{TigerStyleUnderstandBeforeFuzzing}
        - @{TigerStyleStaticAllocation}
        - @{TigerStyleSmallestScope}
        - @{TigerStyleFunctionLengthLimit}
        - @{TigerStyleFunctionShape}
        - @{TigerStyleCentralizeControlFlow}
        - @{TigerStyleCentralizeStateChanges}
        - @{TigerStyleStrictCompilerWarnings}
        - @{TigerStyleOwnPaceNotEvents}
        - @{TigerStyleSplitCompoundConditions}
        - @{TigerStyleStateInvariantsPositively}
        - @{TigerStyleHandleAllErrors}
        - @{TigerStyleAlwaysSayWhy}
        - @{TigerStyleExplicitLibraryOptions}
        - @{TigerStyleDesignForPerformance}
        - @{TigerStyleBackOfTheEnvelope}
        - @{TigerStyleOptimizeSlowestResourcesFirst}
        - @{TigerStyleSeparateControlAndDataPlanes}
        - @{TigerStyleBatchAccesses}
        - @{TigerStylePredictableCpuWork}
        - @{TigerStyleExtractHotLoops}
        - @{TigerStylePreciseNames}
        - @{TigerStyleSnakeCase}
        - @{TigerStyleNoAbbreviations}
        - @{TigerStyleAcronymCapitalization}
        - @{TigerStyleFollowZigStyleGuide}
        - @{TigerStyleUnitsLastInNames}
        - @{TigerStyleMeaningfulNames}
        - @{TigerStyleEqualLengthRelatedNames}
        - @{TigerStylePrefixHelperWithCaller}
        - @{TigerStyleCallbacksLast}
        - @{TigerStyleOrderForReading}
        - @{TigerStyleNoOverloadedNames}
        - @{TigerStyleNamesThatWorkInProse}
        - @{TigerStyleOptionsStructForMixableArguments}
        - @{TigerStylePositionalSingletons}
        - @{TigerStyleDescriptiveCommitMessages}
        - @{TigerStyleCommentWhy}
        - @{TigerStyleCommentHow}
        - @{TigerStyleCommentsAreSentences}
        - @{TigerStyleNoDuplicateState}
        - @{TigerStyleConstPointerForLargeArguments}
        - @{TigerStyleInPlaceInitialization}
        - @{TigerStyleDeclareNearUse}
        - @{TigerStyleSimpleReturnTypes}
        - @{TigerStyleRunToCompletion}
        - @{TigerStyleGuardAgainstBufferBleeds}
        - @{TigerStyleGroupAllocationAndDeallocation}
        - @{TigerStyleIndexCountSize}
        - @{TigerStyleShowDivisionIntent}
        - @{TigerStyleRunZigFmt}
        - @{TigerStyleFourSpaceIndent}
        - @{TigerStyleLineLengthLimit}
        - @{TigerStyleBraceIfStatements}
        - @{TigerStyleZeroDependencies}
        - @{TigerStyleStandardizeTooling}
