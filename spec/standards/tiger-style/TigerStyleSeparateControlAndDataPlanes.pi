use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleSeparateControlAndDataPlanes:
    standard: @{TigerStyle}
    ruleId: separate-control-and-data-planes
    title: Keep the control plane separate from the data plane
    statement:
        Draw a clear line between control logic and bulk data processing,
        and use batching to connect them.
    rationale:
        The separation lets the control plane carry heavy assertion checking
        without slowing the data path.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [zig, any]
    tags: [performance, architecture, batching]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#performance
