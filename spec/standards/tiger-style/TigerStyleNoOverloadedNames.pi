use ../lib/CodingRule

from ./TigerStyle import TigerStyle

export coding-rule TigerStyleNoOverloadedNames:
    standard: @{TigerStyle}
    ruleId: no-overloaded-names
    title: Avoid names whose meaning depends on context
    statement:
        Do not reuse a term for a new concept when it already means
        something else in the system.
    rationale:
        TigerBeetle found that naming a transfer feature after a consensus
        term caused confusion between the two.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [zig, any]
    tags: [naming, domain]
    source: https://github.com/tigerbeetle/tigerbeetle/blob/main/docs/TIGER_STYLE.md#naming-things
