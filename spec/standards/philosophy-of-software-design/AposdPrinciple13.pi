use ../lib/CodingRule

from ./PhilosophyOfSoftwareDesign import PhilosophyOfSoftwareDesign

export coding-rule AposdPrinciple13:
    standard: @{PhilosophyOfSoftwareDesign}
    ruleId: principle-13
    title: Use comments for what the code cannot show
    statement:
        Write comments that add information the code does not make obvious,
        such as intent, units, invariants and the reasons behind a decision.
    rationale:
        Code shows the details but not the abstraction or the reasoning.
        Comments that only repeat the code add nothing.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        // Set timeout to 30.
        timeout = 30;
        \\\
        ```
    compliant:
        ```java
        \\\
        // Seconds; must exceed the server's 25 s keep-alive or
        // idle connections are dropped mid-request.
        timeout = 30;
        \\\
        ```
    languages: [any]
    tags: [principle, comments, documentation]
    source: https://web.stanford.edu/~ouster/cgi-bin/book.php
