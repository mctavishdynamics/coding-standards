use ../lib/CodingRule

from ./PhilosophyOfSoftwareDesign import PhilosophyOfSoftwareDesign

export coding-rule AposdRedFlagConjoinedMethods:
    standard: @{PhilosophyOfSoftwareDesign}
    ruleId: red-flag-conjoined-methods
    title: Avoid pieces of code that cannot be understood apart
    statement:
        Avoid splitting code so that one method or block can only be
        understood by also reading another. Each piece should make sense on
        its own, or the pieces should be combined.
    rationale:
        When two pieces depend on each other's details, the split adds
        interfaces without reducing what a reader must keep in mind.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [red-flag, modularity, readability]
    source: https://web.stanford.edu/~ouster/cgi-bin/book.php
