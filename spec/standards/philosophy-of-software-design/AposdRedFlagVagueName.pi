use ../lib/CodingRule

from ./PhilosophyOfSoftwareDesign import PhilosophyOfSoftwareDesign

export coding-rule AposdRedFlagVagueName:
    standard: @{PhilosophyOfSoftwareDesign}
    ruleId: red-flag-vague-name
    title: Avoid vague names
    statement:
        Avoid variable and method names so broad that they say little about
        what the thing is, such as data, value or result. Choose a precise
        name.
    rationale:
        A vague name makes readers look elsewhere to learn what it refers to
        and makes misuse more likely.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        data = fetch(url)
        count = len(data)
        \\\
        ```
    compliant:
        ```python
        \\\
        unread_messages = fetch(url)
        unread_count = len(unread_messages)
        \\\
        ```
    languages: [any]
    tags: [red-flag, naming]
    source: https://web.stanford.edu/~ouster/cgi-bin/book.php
