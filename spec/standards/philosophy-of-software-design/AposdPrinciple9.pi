use ../lib/CodingRule

from ./PhilosophyOfSoftwareDesign import PhilosophyOfSoftwareDesign

export coding-rule AposdPrinciple9:
    standard: @{PhilosophyOfSoftwareDesign}
    ruleId: principle-9
    title: Give each layer its own abstraction
    statement:
        Make each layer of a system offer an abstraction that differs from
        the layers above and below it.
    rationale:
        Adjacent layers with nearly the same abstraction add interface cost
        without adding value, and often show up as pass-through methods.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [principle, layering, abstraction]
    source: https://web.stanford.edu/~ouster/cgi-bin/book.php
