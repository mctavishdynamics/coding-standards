use ../lib/CodingRule

from ./PhilosophyOfSoftwareDesign import PhilosophyOfSoftwareDesign

export coding-rule AposdPrinciple16:
    standard: @{PhilosophyOfSoftwareDesign}
    ruleId: principle-16
    title: Separate what matters from what does not and emphasise what matters
    statement:
        Decide which aspects of a design are important, structure the system
        around them and make them prominent. Keep unimportant details hidden
        and limit where they can have an effect.
    rationale:
        Treating too much as important clutters the design, while missing
        what is important hides key information. Both raise cognitive load.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [principle, design-process, abstraction]
    source: https://web.stanford.edu/~ouster/cgi-bin/book.php
