use ../lib/CodingStandard

from ./AposdPrinciple1 import AposdPrinciple1
from ./AposdPrinciple10 import AposdPrinciple10
from ./AposdPrinciple11 import AposdPrinciple11
from ./AposdPrinciple12 import AposdPrinciple12
from ./AposdPrinciple13 import AposdPrinciple13
from ./AposdPrinciple14 import AposdPrinciple14
from ./AposdPrinciple15 import AposdPrinciple15
from ./AposdPrinciple16 import AposdPrinciple16
from ./AposdPrinciple2 import AposdPrinciple2
from ./AposdPrinciple3 import AposdPrinciple3
from ./AposdPrinciple4 import AposdPrinciple4
from ./AposdPrinciple5 import AposdPrinciple5
from ./AposdPrinciple6 import AposdPrinciple6
from ./AposdPrinciple7 import AposdPrinciple7
from ./AposdPrinciple8 import AposdPrinciple8
from ./AposdPrinciple9 import AposdPrinciple9
from ./AposdRedFlagCommentRepeatsCode import AposdRedFlagCommentRepeatsCode
from ./AposdRedFlagConjoinedMethods import AposdRedFlagConjoinedMethods
from ./AposdRedFlagHardToDescribe import AposdRedFlagHardToDescribe
from ./AposdRedFlagHardToPickName import AposdRedFlagHardToPickName
from ./AposdRedFlagImplementationDocumentationContaminatesInterface import
    AposdRedFlagImplementationDocumentationContaminatesInterface
from ./AposdRedFlagInformationLeakage import AposdRedFlagInformationLeakage
from ./AposdRedFlagNonobviousCode import AposdRedFlagNonobviousCode
from ./AposdRedFlagOverexposure import AposdRedFlagOverexposure
from ./AposdRedFlagPassThroughMethod import AposdRedFlagPassThroughMethod
from ./AposdRedFlagRepetition import AposdRedFlagRepetition
from ./AposdRedFlagShallowModule import AposdRedFlagShallowModule
from ./AposdRedFlagSpecialGeneralMixture import
    AposdRedFlagSpecialGeneralMixture
from ./AposdRedFlagTemporalDecomposition import
    AposdRedFlagTemporalDecomposition
from ./AposdRedFlagVagueName import AposdRedFlagVagueName

export coding-standard PhilosophyOfSoftwareDesign:
    title: A Philosophy of Software Design - Summary of Design Principles and Red Flags
    publisher: John Ousterhout, Yaknyam Press
    url: https://web.stanford.edu/~ouster/cgi-bin/book.php
    version: 2nd edition, 2021
    license: Copyright John Ousterhout, all rights reserved. Rules are paraphrased.
    description:
        The design principles and red flags summarised at the end of John
        Ousterhout's book on managing software complexity, paraphrased as
        rules to follow and warning signs to avoid.
    rules:
        - @{AposdPrinciple1}
        - @{AposdPrinciple2}
        - @{AposdPrinciple3}
        - @{AposdPrinciple4}
        - @{AposdPrinciple5}
        - @{AposdPrinciple6}
        - @{AposdPrinciple7}
        - @{AposdPrinciple8}
        - @{AposdPrinciple9}
        - @{AposdPrinciple10}
        - @{AposdPrinciple11}
        - @{AposdPrinciple12}
        - @{AposdPrinciple13}
        - @{AposdPrinciple14}
        - @{AposdPrinciple15}
        - @{AposdPrinciple16}
        - @{AposdRedFlagShallowModule}
        - @{AposdRedFlagInformationLeakage}
        - @{AposdRedFlagTemporalDecomposition}
        - @{AposdRedFlagOverexposure}
        - @{AposdRedFlagPassThroughMethod}
        - @{AposdRedFlagRepetition}
        - @{AposdRedFlagSpecialGeneralMixture}
        - @{AposdRedFlagConjoinedMethods}
        - @{AposdRedFlagCommentRepeatsCode}
        - @{AposdRedFlagImplementationDocumentationContaminatesInterface}
        - @{AposdRedFlagVagueName}
        - @{AposdRedFlagHardToPickName}
        - @{AposdRedFlagHardToDescribe}
        - @{AposdRedFlagNonobviousCode}
