use ../lib/CodingRule

from ./PhilosophyOfSoftwareDesign import PhilosophyOfSoftwareDesign

export coding-rule AposdPrinciple12:
    standard: @{PhilosophyOfSoftwareDesign}
    ruleId: principle-12
    title: Consider more than one design
    statement:
        For each significant design decision, sketch at least two quite
        different approaches and compare them before choosing.
    rationale:
        The first idea is rarely the best one. Comparing alternatives
        reveals their weaknesses and often leads to a better combined
        design.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [principle, design-process]
    source: https://web.stanford.edu/~ouster/cgi-bin/book.php
