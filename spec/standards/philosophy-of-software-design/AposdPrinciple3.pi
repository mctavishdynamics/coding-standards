use ../lib/CodingRule

from ./PhilosophyOfSoftwareDesign import PhilosophyOfSoftwareDesign

export coding-rule AposdPrinciple3:
    standard: @{PhilosophyOfSoftwareDesign}
    ruleId: principle-3
    title: Invest a little in the design all the time
    statement:
        Spend a modest, steady share of development time improving the
        structure of the system, such as cleaning up a design problem you
        find while adding a feature.
    rationale:
        Small, continual investments keep the design healthy and pay back in
        faster development later. Postponing them lets problems compound.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [principle, strategic-programming, refactoring]
    source: https://web.stanford.edu/~ouster/cgi-bin/book.php
