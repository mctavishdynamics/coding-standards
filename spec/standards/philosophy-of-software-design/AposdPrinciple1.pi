use ../lib/CodingRule

from ./PhilosophyOfSoftwareDesign import PhilosophyOfSoftwareDesign

export coding-rule AposdPrinciple1:
    standard: @{PhilosophyOfSoftwareDesign}
    ruleId: principle-1
    title: Treat small sources of complexity as serious because they add up
    statement:
        Do not let small shortcuts and minor dependencies slip in on the
        grounds that each one is harmless. Care about the details, since
        complexity in a system grows from many small additions.
    rationale:
        No single small shortcut makes a system hard to work on, but
        hundreds of them do, and once they accumulate they are very hard to
        remove.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [principle, complexity]
    source: https://web.stanford.edu/~ouster/cgi-bin/book.php
