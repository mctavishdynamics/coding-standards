use ../lib/CodingRule

from ./PhilosophyOfSoftwareDesign import PhilosophyOfSoftwareDesign

export coding-rule AposdPrinciple6:
    standard: @{PhilosophyOfSoftwareDesign}
    ruleId: principle-6
    title: Prefer a simple interface over a simple implementation
    statement:
        When you must choose, accept a more involved implementation inside a
        module in order to keep its interface small and easy to use.
    rationale:
        A module is written once but used many times, so complexity in the
        interface is paid repeatedly while complexity in the implementation
        is paid once.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [principle, interfaces, modularity]
    source: https://web.stanford.edu/~ouster/cgi-bin/book.php
