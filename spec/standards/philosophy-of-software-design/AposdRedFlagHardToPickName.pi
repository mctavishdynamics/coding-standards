use ../lib/CodingRule

from ./PhilosophyOfSoftwareDesign import PhilosophyOfSoftwareDesign

export coding-rule AposdRedFlagHardToPickName:
    standard: @{PhilosophyOfSoftwareDesign}
    ruleId: red-flag-hard-to-pick-name
    title: Treat difficulty naming something as a design warning
    statement:
        When it is hard to find a precise, intuitive name for a variable or
        method, reconsider the design of the thing being named.
    rationale:
        A thing that resists a clear name often lacks a clean purpose or
        mixes several responsibilities.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [red-flag, naming, design-process]
    source: https://web.stanford.edu/~ouster/cgi-bin/book.php
