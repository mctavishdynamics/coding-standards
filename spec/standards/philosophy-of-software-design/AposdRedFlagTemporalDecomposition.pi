use ../lib/CodingRule

from ./PhilosophyOfSoftwareDesign import PhilosophyOfSoftwareDesign

export coding-rule AposdRedFlagTemporalDecomposition:
    standard: @{PhilosophyOfSoftwareDesign}
    ruleId: red-flag-temporal-decomposition
    title: Avoid structuring code by the order in which things happen
    statement:
        Avoid splitting a system into modules that mirror the sequence of
        operations at run time, such as read, then modify, then write.
        Divide it by the knowledge each module needs instead.
    rationale:
        Steps that happen at different times often depend on the same
        knowledge, so splitting by time spreads that knowledge across
        modules.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [red-flag, modularity, information-hiding]
    source: https://web.stanford.edu/~ouster/cgi-bin/book.php
