use ../lib/CodingRule

from ./PhilosophyOfSoftwareDesign import PhilosophyOfSoftwareDesign

export coding-rule AposdPrinciple8:
    standard: @{PhilosophyOfSoftwareDesign}
    ruleId: principle-8
    title: Keep general-purpose and special-purpose code apart
    statement:
        Put code that serves one particular use in the layer or module that
        has that use, and keep the general mechanism free of it.
    rationale:
        Mixing the two makes the general mechanism harder to understand and
        ties it to cases it should not know about.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [principle, generality, separation-of-concerns]
    source: https://web.stanford.edu/~ouster/cgi-bin/book.php
