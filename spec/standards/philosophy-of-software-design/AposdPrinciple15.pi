use ../lib/CodingRule

from ./PhilosophyOfSoftwareDesign import PhilosophyOfSoftwareDesign

export coding-rule AposdPrinciple15:
    standard: @{PhilosophyOfSoftwareDesign}
    ruleId: principle-15
    title: Grow software in units of abstractions rather than features
    statement:
        When developing incrementally, make each increment a complete,
        general abstraction rather than just enough code for the next
        feature.
    rationale:
        Building only for the next feature leads to tactical,
        special-purpose code. Finished abstractions give a cleaner base for
        later work.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [principle, abstraction, design-process]
    source: https://web.stanford.edu/~ouster/cgi-bin/book.php
