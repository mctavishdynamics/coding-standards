use ../lib/CodingRule

from ./PhilosophyOfSoftwareDesign import PhilosophyOfSoftwareDesign

export coding-rule AposdRedFlagHardToDescribe:
    standard: @{PhilosophyOfSoftwareDesign}
    ruleId: red-flag-hard-to-describe
    title: Treat a hard-to-describe interface as a design warning
    statement:
        When the comment for a method or variable has to be long to be
        complete, look for a simpler abstraction.
    rationale:
        A good abstraction can be described simply. A long, complicated
        description suggests a muddled design.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [red-flag, documentation, abstraction]
    source: https://web.stanford.edu/~ouster/cgi-bin/book.php
