use ../lib/CodingRule

from ./PhilosophyOfSoftwareDesign import PhilosophyOfSoftwareDesign

export coding-rule AposdPrinciple2:
    standard: @{PhilosophyOfSoftwareDesign}
    ruleId: principle-2
    title: Aim for a clean design, not just code that runs
    statement:
        Do not stop when the code works. Treat a good design as the main
        goal of each change and avoid the tactical habit of finishing a
        feature as fast as possible.
    rationale:
        Code that merely works tends to pile up hacks, and the cost of those
        hacks is paid by everyone who changes the system later.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [principle, strategic-programming]
    source: https://web.stanford.edu/~ouster/cgi-bin/book.php
