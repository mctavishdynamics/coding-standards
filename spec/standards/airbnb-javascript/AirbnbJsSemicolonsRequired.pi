use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsSemicolonsRequired:
    standard: @{AirbnbJavaScript}
    ruleId: 21.1
    title: Use semicolons
    statement:
        End every statement with an explicit semicolon. Enforced by the
        ESLint rule semi.
    rationale:
        Automatic semicolon insertion has odd edge cases, and code breaks
        when a line break is misinterpreted. Explicit semicolons and a
        linter that checks them avoid this.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const start = Date.now()
        [1, 2, 3].forEach((n) => console.log(n))
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const start = Date.now();
        [1, 2, 3].forEach((n) => console.log(n));
        \\\
        ```
    languages: [javascript]
    tags: [semicolons, formatting]
    source: https://github.com/airbnb/javascript#semicolons--required
