use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsTestingForReal:
    standard: @{AirbnbJavaScript}
    ruleId: 30.2
    title: Write tests seriously and add regression tests
    statement:
        Write tests whatever framework you use. Favour many small pure
        functions and keep mutation in few places, be cautious with stubs
        and mocks, aim for full coverage even when it is not always
        reachable, and add a regression test whenever you fix a bug.
    rationale:
        Small pure functions are simple to test and heavy mocking makes
        tests fragile. A fix that lands with no test guarding it tends to
        break again later.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```javascript
        \\\
        // Regression test for a bug where totals ignored discounts
        test('total applies the discount', () => {
          expect(total([{ price: 100 }], { discount: 0.1 })).toBe(90);
        });
        \\\
        ```
    languages: [javascript]
    tags: [testing, regression]
    source: https://github.com/airbnb/javascript#testing--for-real
