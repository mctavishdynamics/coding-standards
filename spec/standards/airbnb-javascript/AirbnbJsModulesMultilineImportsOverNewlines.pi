use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsModulesMultilineImportsOverNewlines:
    standard: @{AirbnbJavaScript}
    ruleId: 10.8
    title: Indent multiline imports like object literals
    statement:
        When an import lists names on several lines, put each name on its
        own line, indent them like a multiline object literal and add a
        trailing comma. Enforced by the ESLint rule object-curly-newline.
    rationale:
        The braces then follow the same rules as every other brace block in
        the guide.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        import { parseQuery, buildQuery, encodeValue, decodeValue } from './query';
        \\\
        ```
    compliant:
        ```javascript
        \\\
        import {
          parseQuery,
          buildQuery,
          encodeValue,
          decodeValue,
        } from './query';
        \\\
        ```
    languages: [javascript]
    tags: [modules, imports, formatting]
    source: https://github.com/airbnb/javascript#modules--multiline-imports-over-newlines
