use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsAccessorsNotRequired:
    standard: @{AirbnbJavaScript}
    ruleId: 24.1
    title: Do not require accessor functions for properties
    statement:
        Accessor functions for properties are optional. Plain property
        access is fine.
    rationale:
        Wrapping every property in an accessor adds code without benefit.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```javascript
        \\\
        class Point {
          constructor(x, y) {
            this.x = x;
            this.y = y;
          }
        }
        const origin = new Point(0, 0);
        console.log(origin.x);
        \\\
        ```
    languages: [javascript]
    tags: [accessors, classes]
    source: https://github.com/airbnb/javascript#accessors--not-required
