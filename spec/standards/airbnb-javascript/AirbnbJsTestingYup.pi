use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsTestingYup:
    standard: @{AirbnbJavaScript}
    ruleId: 30.1
    title: Write tests
    statement:
        Test your code.
    rationale:
        The guide answers the question of whether to test with a plain yes.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```javascript
        \\\
        test('slugify replaces spaces with dashes', () => {
          expect(slugify('Hello World')).toBe('hello-world');
        });
        \\\
        ```
    languages: [javascript]
    tags: [testing]
    source: https://github.com/airbnb/javascript#testing--yup
