use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsArraysBracketNewline:
    standard: @{AirbnbJavaScript}
    ruleId: 4.8
    title: Break lines inside brackets of multiline arrays
    statement:
        If an array literal does not fit on one line, start its elements on
        the line after the opening bracket and give the closing bracket a
        line of its own.
    rationale:
        Each element then sits on its own footing and the array's start and
        end are easy to see.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const routes = [{ path: '/' },
          { path: '/about' }];
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const routes = [
          { path: '/' },
          { path: '/about' },
        ];
        \\\
        ```
    languages: [javascript]
    tags: [arrays, formatting]
    source: https://github.com/airbnb/javascript#arrays--bracket-newline
