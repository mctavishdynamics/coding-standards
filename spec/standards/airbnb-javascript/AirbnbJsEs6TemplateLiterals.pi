use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsEs6TemplateLiterals:
    standard: @{AirbnbJavaScript}
    ruleId: 6.3
    title: Build strings with template literals
    statement:
        When building a string from values, use a template literal instead
        of concatenation, with no spaces inside the interpolation braces.
        Enforced by the ESLint rules prefer-template and
        template-curly-spacing.
    rationale:
        Template literals are shorter, read naturally and support
        interpolation and newlines directly.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const label = 'Order ' + order.id + ' for ' + order.customer;
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const label = `Order ${order.id} for ${order.customer}`;
        \\\
        ```
    languages: [javascript]
    tags: [strings, es6]
    source: https://github.com/airbnb/javascript#es6-template-literals
