use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsWhitespaceFuncCallSpacing:
    standard: @{AirbnbJavaScript}
    ruleId: 19.17
    title: Do not put spaces between a function and its call
    statement:
        Write no space or line break between a function name and the
        parentheses that call it. Enforced by the ESLint rule
        func-call-spacing.
    rationale:
        A gap makes the call harder to recognise and a line break can change
        the meaning.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        render ();
        \\\
        ```
    compliant:
        ```javascript
        \\\
        render();
        \\\
        ```
    languages: [javascript]
    tags: [whitespace, functions]
    source: https://github.com/airbnb/javascript#whitespace--func-call-spacing
