use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsNamingAcronymsAndInitialisms:
    standard: @{AirbnbJavaScript}
    ruleId: 23.9
    title: Keep acronyms entirely upper or lower case
    statement:
        Write acronyms and initialisms all in upper case or all in lower
        case within a name.
    rationale:
        Names are for people to read, not to satisfy a mechanical casing
        rule.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        import ApiClient from './net/ApiClient';
        const UrlParts = splitUrl(location);
        \\\
        ```
    compliant:
        ```javascript
        \\\
        import APIClient from './net/APIClient';
        const urlParts = splitUrl(location);
        \\\
        ```
    languages: [javascript]
    tags: [naming, readability]
    source: https://github.com/airbnb/javascript#naming--Acronyms-and-Initialisms
