use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsWhitespaceNewlineAtEnd:
    standard: @{AirbnbJavaScript}
    ruleId: 19.5
    title: End files with a single newline
    statement:
        End every file with exactly one newline character. Enforced by the
        ESLint rule eol-last.
    rationale:
        A final newline is expected by many tools, and extra blank lines at
        the end are noise.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        export default router;↵
        ↵
        \\\
        ```
    compliant:
        ```javascript
        \\\
        export default router;↵
        \\\
        ```
    languages: [javascript]
    tags: [whitespace, files]
    source: https://github.com/airbnb/javascript#whitespace--newline-at-end
