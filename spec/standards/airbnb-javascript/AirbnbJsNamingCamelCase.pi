use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsNamingCamelCase:
    standard: @{AirbnbJavaScript}
    ruleId: 23.2
    title: Use camelCase for objects, functions and instances
    statement:
        Name objects, functions and instances in camelCase. Enforced by the
        ESLint rule camelcase.
    rationale:
        A single convention makes names predictable.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const user_profile = {};
        function Load_Settings() {}
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const userProfile = {};
        function loadSettings() {}
        \\\
        ```
    languages: [javascript]
    tags: [naming]
    source: https://github.com/airbnb/javascript#naming--camelCase
