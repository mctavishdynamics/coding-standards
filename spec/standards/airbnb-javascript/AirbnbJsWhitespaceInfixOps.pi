use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsWhitespaceInfixOps:
    standard: @{AirbnbJavaScript}
    ruleId: 19.4
    title: Surround operators with spaces
    statement:
        Put spaces around infix operators. Enforced by the ESLint rule
        space-infix-ops.
    rationale:
        Spaced operators are easier to read.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const total=price*quantity+shipping;
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const total = price * quantity + shipping;
        \\\
        ```
    languages: [javascript]
    tags: [whitespace, operators]
    source: https://github.com/airbnb/javascript#whitespace--infix-ops
