use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsAccessorsConsistent:
    standard: @{AirbnbJavaScript}
    ruleId: 24.4
    title: Be consistent with generic get and set functions
    statement:
        Generic get() and set() methods are acceptable, but use them
        consistently once you choose them.
    rationale:
        Mixing generic accessors with direct property access makes it
        unclear which way to read or write a value.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        store.set('theme', 'dark');
        store.locale = 'en';
        \\\
        ```
    compliant:
        ```javascript
        \\\
        store.set('theme', 'dark');
        store.set('locale', 'en');
        \\\
        ```
    languages: [javascript]
    tags: [accessors, consistency]
    source: https://github.com/airbnb/javascript#accessors--consistent
