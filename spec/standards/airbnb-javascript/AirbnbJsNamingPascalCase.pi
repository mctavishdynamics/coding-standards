use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsNamingPascalCase:
    standard: @{AirbnbJavaScript}
    ruleId: 23.3
    title: Use PascalCase only for constructors and classes
    statement:
        Name constructors and classes in PascalCase, and use it for nothing
        else. Enforced by the ESLint rule new-cap.
    rationale:
        PascalCase signals that a function is meant to be called with new.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        class shoppingCart {}
        const cart = new shoppingCart();
        \\\
        ```
    compliant:
        ```javascript
        \\\
        class ShoppingCart {}
        const cart = new ShoppingCart();
        \\\
        ```
    languages: [javascript]
    tags: [naming, classes]
    source: https://github.com/airbnb/javascript#naming--PascalCase
