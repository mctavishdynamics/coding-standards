use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsDestructuringArray:
    standard: @{AirbnbJavaScript}
    ruleId: 5.2
    title: Use array destructuring
    statement:
        Take elements out of an array with array destructuring instead of
        reading indexes one by one. Enforced by the ESLint rule
        prefer-destructuring.
    rationale:
        Destructuring is shorter and names each element as it is extracted.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const width = size[0];
        const height = size[1];
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const [width, height] = size;
        \\\
        ```
    languages: [javascript]
    tags: [destructuring, arrays, es6]
    source: https://github.com/airbnb/javascript#destructuring--array
