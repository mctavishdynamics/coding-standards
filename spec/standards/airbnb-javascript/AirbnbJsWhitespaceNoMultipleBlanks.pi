use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsWhitespaceNoMultipleBlanks:
    standard: @{AirbnbJavaScript}
    ruleId: 19.9
    title: Do not pad code with multiple blank lines
    statement:
        Use at most one blank line to separate parts of the code. Enforced
        by the ESLint rule no-multiple-empty-lines.
    rationale:
        Runs of blank lines waste space and do not add structure.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const host = 'localhost';


        const port = 8080;
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const host = 'localhost';

        const port = 8080;
        \\\
        ```
    languages: [javascript]
    tags: [whitespace, formatting]
    source: https://github.com/airbnb/javascript#whitespace--no-multiple-blanks
