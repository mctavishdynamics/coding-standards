use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsBlocksNoElseReturn:
    standard: @{AirbnbJavaScript}
    ruleId: 16.3
    title: Do not use else after a returning if block
    statement:
        If an if block always returns, drop the else that follows it. Split
        an else if after a returning if into separate if statements.
        Enforced by the ESLint rule no-else-return.
    rationale:
        The else adds nesting without changing behaviour.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        function sign(value) {
          if (value > 0) {
            return 1;
          } else if (value < 0) {
            return -1;
          } else {
            return 0;
          }
        }
        \\\
        ```
    compliant:
        ```javascript
        \\\
        function sign(value) {
          if (value > 0) {
            return 1;
          }
          if (value < 0) {
            return -1;
          }
          return 0;
        }
        \\\
        ```
    languages: [javascript]
    tags: [blocks, control-flow]
    source: https://github.com/airbnb/javascript#blocks--no-else-return
