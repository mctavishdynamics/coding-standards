use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsWhitespaceInBraces:
    standard: @{AirbnbJavaScript}
    ruleId: 19.12
    title: Put spaces inside curly braces
    statement:
        Add a space just inside the braces of object literals and
        destructuring patterns. Enforced by the ESLint rule
        object-curly-spacing.
    rationale:
        The spaces make single-line objects easier to read.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const point = {x: 1, y: 2};
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const point = { x: 1, y: 2 };
        \\\
        ```
    languages: [javascript]
    tags: [whitespace, objects]
    source: https://github.com/airbnb/javascript#whitespace--in-braces
