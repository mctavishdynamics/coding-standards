use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsWhitespaceCommaSpacing:
    standard: @{AirbnbJavaScript}
    ruleId: 19.15
    title: Put a space after commas and none before
    statement:
        Do not put a space before a comma, and do put one after it. Enforced
        by the ESLint rule comma-spacing.
    rationale:
        This is the conventional spacing and keeps lists easy to scan.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const rgb = [255 ,128 ,0];
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const rgb = [255, 128, 0];
        \\\
        ```
    languages: [javascript]
    tags: [whitespace, commas]
    source: https://github.com/airbnb/javascript#whitespace--comma-spacing
