use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsFunctionsArgumentsShadow:
    standard: @{AirbnbJavaScript}
    ruleId: 7.5
    title: Never name a parameter arguments
    statement:
        Do not use arguments as a parameter name.
    rationale:
        The parameter would shadow the arguments object that every function
        scope receives.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        function run(name, options, arguments) {
          // ...
        }
        \\\
        ```
    compliant:
        ```javascript
        \\\
        function run(name, options, args) {
          // ...
        }
        \\\
        ```
    languages: [javascript]
    tags: [functions, naming]
    source: https://github.com/airbnb/javascript#functions--arguments-shadow
