export coding-standard AirbnbJavaScript:
    title: Airbnb JavaScript Style Guide
    publisher: Airbnb
    url: https://github.com/airbnb/javascript
    version: null
    license: MIT License, Copyright (c) 2012 Airbnb
    description:
        Airbnb's style guide for modern JavaScript, covering references,
        objects, functions, modules, naming and formatting. Most rules are
        enforced by the eslint-config-airbnb ESLint configuration.
    rules:
        - @{AirbnbJsTypesPrimitives}
        - @{AirbnbJsTypesComplex}
        - @{AirbnbJsReferencesPreferConst}
        - @{AirbnbJsReferencesDisallowVar}
        - @{AirbnbJsReferencesBlockScope}
        - @{AirbnbJsObjectsNoNew}
        - @{AirbnbJsEs6ComputedProperties}
        - @{AirbnbJsEs6ObjectShorthand}
        - @{AirbnbJsEs6ObjectConcise}
        - @{AirbnbJsObjectsGroupedShorthand}
        - @{AirbnbJsObjectsQuotedProps}
        - @{AirbnbJsObjectsPrototypeBuiltins}
        - @{AirbnbJsObjectsRestSpread}
        - @{AirbnbJsArraysLiterals}
        - @{AirbnbJsArraysPush}
        - @{AirbnbJsEs6ArraySpreads}
        - @{AirbnbJsArraysFromIterable}
        - @{AirbnbJsArraysFromArrayLike}
        - @{AirbnbJsArraysMapping}
        - @{AirbnbJsArraysCallbackReturn}
        - @{AirbnbJsArraysBracketNewline}
        - @{AirbnbJsDestructuringObject}
        - @{AirbnbJsDestructuringArray}
        - @{AirbnbJsDestructuringObjectOverArray}
        - @{AirbnbJsStringsQuotes}
        - @{AirbnbJsStringsLineLength}
        - @{AirbnbJsEs6TemplateLiterals}
        - @{AirbnbJsStringsEval}
        - @{AirbnbJsStringsEscaping}
        - @{AirbnbJsFunctionsDeclarations}
        - @{AirbnbJsFunctionsIife}
        - @{AirbnbJsFunctionsInBlocks}
        - @{AirbnbJsFunctionsNoteOnBlocks}
        - @{AirbnbJsFunctionsArgumentsShadow}
        - @{AirbnbJsEs6Rest}
        - @{AirbnbJsEs6DefaultParameters}
        - @{AirbnbJsFunctionsDefaultSideEffects}
        - @{AirbnbJsFunctionsDefaultsLast}
        - @{AirbnbJsFunctionsConstructor}
        - @{AirbnbJsFunctionsSignatureSpacing}
        - @{AirbnbJsFunctionsMutateParams}
        - @{AirbnbJsFunctionsReassignParams}
        - @{AirbnbJsFunctionsSpreadVsApply}
        - @{AirbnbJsFunctionsSignatureInvocationIndentation}
        - @{AirbnbJsArrowsUseThem}
        - @{AirbnbJsArrowsImplicitReturn}
        - @{AirbnbJsArrowsParenWrap}
        - @{AirbnbJsArrowsOneArgParens}
        - @{AirbnbJsArrowsConfusing}
        - @{AirbnbJsWhitespaceImplicitArrowLinebreak}
        - @{AirbnbJsConstructorsUseClass}
        - @{AirbnbJsConstructorsExtends}
        - @{AirbnbJsConstructorsChaining}
        - @{AirbnbJsConstructorsTostring}
        - @{AirbnbJsConstructorsNoUseless}
        - @{AirbnbJsClassesNoDuplicateMembers}
        - @{AirbnbJsClassesMethodsUseThis}
        - @{AirbnbJsModulesUseThem}
        - @{AirbnbJsModulesNoWildcard}
        - @{AirbnbJsModulesNoExportFromImport}
        - @{AirbnbJsModulesNoDuplicateImports}
        - @{AirbnbJsModulesNoMutableExports}
        - @{AirbnbJsModulesPreferDefaultExport}
        - @{AirbnbJsModulesImportsFirst}
        - @{AirbnbJsModulesMultilineImportsOverNewlines}
        - @{AirbnbJsModulesNoWebpackLoaderSyntax}
        - @{AirbnbJsModulesImportExtensions}
        - @{AirbnbJsIteratorsNope}
        - @{AirbnbJsGeneratorsNope}
        - @{AirbnbJsGeneratorsSpacing}
        - @{AirbnbJsPropertiesDot}
        - @{AirbnbJsPropertiesBracket}
        - @{AirbnbJsEs2016PropertiesExponentiationOperator}
        - @{AirbnbJsVariablesConst}
        - @{AirbnbJsVariablesOneConst}
        - @{AirbnbJsVariablesConstLetGroup}
        - @{AirbnbJsVariablesDefineWhereUsed}
        - @{AirbnbJsVariablesNoChainAssignment}
        - @{AirbnbJsVariablesUnaryIncrementDecrement}
        - @{AirbnbJsVariablesLinebreak}
        - @{AirbnbJsVariablesNoUnusedVars}
        - @{AirbnbJsHoistingAbout}
        - @{AirbnbJsHoistingAnonExpressions}
        - @{AirbnbJsHoistingNamedExpressions}
        - @{AirbnbJsHoistingDeclarations}
        - @{AirbnbJsNoUseBeforeDefine}
        - @{AirbnbJsComparisonEqeqeq}
        - @{AirbnbJsComparisonIf}
        - @{AirbnbJsComparisonShortcuts}
        - @{AirbnbJsComparisonSwitchBlocks}
        - @{AirbnbJsComparisonNestedTernaries}
        - @{AirbnbJsComparisonUnneededTernary}
        - @{AirbnbJsComparisonNoMixedOperators}
        - @{AirbnbJsNullishCoalescingOperator}
        - @{AirbnbJsBlocksBraces}
        - @{AirbnbJsBlocksCuddledElses}
        - @{AirbnbJsBlocksNoElseReturn}
        - @{AirbnbJsControlStatements}
        - @{AirbnbJsControlStatementsValueSelection}
        - @{AirbnbJsCommentsMultiline}
        - @{AirbnbJsCommentsSingleline}
        - @{AirbnbJsCommentsSpaces}
        - @{AirbnbJsCommentsActionitems}
        - @{AirbnbJsCommentsFixme}
        - @{AirbnbJsCommentsTodo}
        - @{AirbnbJsWhitespaceSpaces}
        - @{AirbnbJsWhitespaceBeforeBlocks}
        - @{AirbnbJsWhitespaceAroundKeywords}
        - @{AirbnbJsWhitespaceInfixOps}
        - @{AirbnbJsWhitespaceNewlineAtEnd}
        - @{AirbnbJsWhitespaceChains}
        - @{AirbnbJsWhitespaceAfterBlocks}
        - @{AirbnbJsWhitespacePaddedBlocks}
        - @{AirbnbJsWhitespaceNoMultipleBlanks}
        - @{AirbnbJsWhitespaceInParens}
        - @{AirbnbJsWhitespaceInBrackets}
        - @{AirbnbJsWhitespaceInBraces}
        - @{AirbnbJsWhitespaceMaxLen}
        - @{AirbnbJsWhitespaceBlockSpacing}
        - @{AirbnbJsWhitespaceCommaSpacing}
        - @{AirbnbJsWhitespaceComputedPropertySpacing}
        - @{AirbnbJsWhitespaceFuncCallSpacing}
        - @{AirbnbJsWhitespaceKeySpacing}
        - @{AirbnbJsWhitespaceNoTrailingSpaces}
        - @{AirbnbJsWhitespaceNoMultipleEmptyLines}
        - @{AirbnbJsCommasLeadingTrailing}
        - @{AirbnbJsCommasDangling}
        - @{AirbnbJsSemicolonsRequired}
        - @{AirbnbJsCoercionExplicit}
        - @{AirbnbJsCoercionStrings}
        - @{AirbnbJsCoercionNumbers}
        - @{AirbnbJsCoercionCommentDeviations}
        - @{AirbnbJsCoercionBitwise}
        - @{AirbnbJsCoercionBooleans}
        - @{AirbnbJsNamingDescriptive}
        - @{AirbnbJsNamingCamelCase}
        - @{AirbnbJsNamingPascalCase}
        - @{AirbnbJsNamingLeadingUnderscore}
        - @{AirbnbJsNamingSelfThis}
        - @{AirbnbJsNamingFilenameMatchesExport}
        - @{AirbnbJsNamingCamelCaseDefaultExport}
        - @{AirbnbJsNamingPascalCaseSingleton}
        - @{AirbnbJsNamingAcronymsAndInitialisms}
        - @{AirbnbJsNamingUppercase}
        - @{AirbnbJsAccessorsNotRequired}
        - @{AirbnbJsAccessorsNoGettersSetters}
        - @{AirbnbJsAccessorsBooleanPrefix}
        - @{AirbnbJsAccessorsConsistent}
        - @{AirbnbJsEventsHash}
        - @{AirbnbJsJqueryDollarPrefix}
        - @{AirbnbJsJqueryCache}
        - @{AirbnbJsJqueryQueries}
        - @{AirbnbJsJqueryFind}
        - @{AirbnbJsTc39Proposals}
        - @{AirbnbJsStandardLibraryIsnan}
        - @{AirbnbJsStandardLibraryIsfinite}
        - @{AirbnbJsTestingYup}
        - @{AirbnbJsTestingForReal}
