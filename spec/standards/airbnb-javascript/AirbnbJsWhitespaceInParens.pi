use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsWhitespaceInParens:
    standard: @{AirbnbJavaScript}
    ruleId: 19.10
    title: Do not put spaces inside parentheses
    statement:
        Do not add spaces just inside opening or closing parentheses.
        Enforced by the ESLint rule space-in-parens.
    rationale:
        Tight parentheses are the consistent, expected style.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        if ( isValid( input ) ) {
          submit( input );
        }
        \\\
        ```
    compliant:
        ```javascript
        \\\
        if (isValid(input)) {
          submit(input);
        }
        \\\
        ```
    languages: [javascript]
    tags: [whitespace, formatting]
    source: https://github.com/airbnb/javascript#whitespace--in-parens
