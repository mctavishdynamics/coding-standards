use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsComparisonEqeqeq:
    standard: @{AirbnbJavaScript}
    ruleId: 15.1
    title: Use strict equality operators
    statement:
        Compare with === and !== instead of == and !=. Enforced by the
        ESLint rule eqeqeq.
    rationale:
        The loose operators coerce their operands, which gives results that
        are hard to predict.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        if (quantity == '0') {
          removeLine();
        }
        \\\
        ```
    compliant:
        ```javascript
        \\\
        if (quantity === 0) {
          removeLine();
        }
        \\\
        ```
    languages: [javascript]
    tags: [comparison, equality]
    source: https://github.com/airbnb/javascript#comparison--eqeqeq
