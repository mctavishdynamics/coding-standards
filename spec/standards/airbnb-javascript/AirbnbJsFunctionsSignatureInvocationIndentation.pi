use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsFunctionsSignatureInvocationIndentation:
    standard: @{AirbnbJavaScript}
    ruleId: 7.15
    title: Indent multiline signatures and calls like other lists
    statement:
        When a function signature or call spans several lines, put each item
        on its own line and end the last item with a trailing comma.
        Enforced by the ESLint rule function-paren-newline.
    rationale:
        It matches every other multiline list in the guide and keeps diffs
        small.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        function createUser(name,
                            email,
                            role) {
          // ...
        }
        \\\
        ```
    compliant:
        ```javascript
        \\\
        function createUser(
          name,
          email,
          role,
        ) {
          // ...
        }
        \\\
        ```
    languages: [javascript]
    tags: [functions, formatting]
    source: https://github.com/airbnb/javascript#functions--signature-invocation-indentation
