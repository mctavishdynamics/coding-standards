use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsWhitespaceAroundKeywords:
    standard: @{AirbnbJavaScript}
    ruleId: 19.3
    title: Space keywords but not function calls
    statement:
        Put one space before the opening parenthesis of control statements
        such as if and while. Put no space between a function name and its
        argument list in calls and declarations. Enforced by the ESLint rule
        keyword-spacing.
    rationale:
        The spacing tells keywords apart from function calls at a glance.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        if(isReady) {
          start ();
        }
        \\\
        ```
    compliant:
        ```javascript
        \\\
        if (isReady) {
          start();
        }
        \\\
        ```
    languages: [javascript]
    tags: [whitespace, formatting]
    source: https://github.com/airbnb/javascript#whitespace--around-keywords
