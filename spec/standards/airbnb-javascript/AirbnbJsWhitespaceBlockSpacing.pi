use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsWhitespaceBlockSpacing:
    standard: @{AirbnbJavaScript}
    ruleId: 19.14
    title: Space the inside of single-line blocks consistently
    statement:
        In a block written on one line, put one space after the opening
        brace and one before the closing brace. Enforced by the ESLint rule
        block-spacing.
    rationale:
        Consistent spacing inside braces keeps one-line blocks readable.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        function noop() {return;}
        if (done) {stop();}
        \\\
        ```
    compliant:
        ```javascript
        \\\
        function noop() { return; }
        if (done) { stop(); }
        \\\
        ```
    languages: [javascript]
    tags: [whitespace, blocks]
    source: https://github.com/airbnb/javascript#whitespace--block-spacing
