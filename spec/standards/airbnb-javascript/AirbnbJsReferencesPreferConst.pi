use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsReferencesPreferConst:
    standard: @{AirbnbJavaScript}
    ruleId: 2.1
    title: Use const for all references
    statement:
        Declare every reference with const, and do not use var. Enforced by
        the ESLint rules prefer-const and no-const-assign.
    rationale:
        A const binding cannot be reassigned, which prevents a class of bugs
        and makes the code easier to follow.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        var maxRetries = 3;
        var endpoint = '/api/orders';
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const maxRetries = 3;
        const endpoint = '/api/orders';
        \\\
        ```
    languages: [javascript]
    tags: [variables, const]
    source: https://github.com/airbnb/javascript#references--prefer-const
