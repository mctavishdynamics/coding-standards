use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsEs2016PropertiesExponentiationOperator:
    standard: @{AirbnbJavaScript}
    ruleId: 12.3
    title: Use the exponentiation operator
    statement:
        Compute powers with the ** operator instead of Math.pow. Enforced by
        the ESLint rule prefer-exponentiation-operator.
    rationale:
        The operator is shorter and reads like the mathematics it expresses.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const area = Math.pow(radius, 2) * Math.PI;
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const area = radius ** 2 * Math.PI;
        \\\
        ```
    languages: [javascript]
    tags: [operators, es2016]
    source: https://github.com/airbnb/javascript#es2016-properties--exponentiation-operator
