use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsWhitespaceAfterBlocks:
    standard: @{AirbnbJavaScript}
    ruleId: 19.7
    title: Leave a blank line after a block
    statement:
        Put a blank line after a block and before the next statement.
    rationale:
        The blank line separates the block visually from what follows.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        if (cached) {
          return cached;
        }
        return fetchFresh();
        \\\
        ```
    compliant:
        ```javascript
        \\\
        if (cached) {
          return cached;
        }

        return fetchFresh();
        \\\
        ```
    languages: [javascript]
    tags: [whitespace, formatting]
    source: https://github.com/airbnb/javascript#whitespace--after-blocks
