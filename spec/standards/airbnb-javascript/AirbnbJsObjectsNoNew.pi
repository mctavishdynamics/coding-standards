use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsObjectsNoNew:
    standard: @{AirbnbJavaScript}
    ruleId: 3.1
    title: Create objects with literal syntax
    statement:
        Create objects with an object literal instead of new Object().
        Enforced by the ESLint rule no-new-object.
    rationale:
        The literal is shorter, clearer and cannot be affected by a shadowed
        Object constructor.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const settings = new Object();
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const settings = {};
        \\\
        ```
    languages: [javascript]
    tags: [objects, literals]
    source: https://github.com/airbnb/javascript#objects--no-new
