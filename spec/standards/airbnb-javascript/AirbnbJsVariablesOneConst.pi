use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsVariablesOneConst:
    standard: @{AirbnbJavaScript}
    ruleId: 13.2
    title: Use one declaration per variable
    statement:
        Write a separate const or let declaration for each variable.
        Enforced by the ESLint rule one-var.
    rationale:
        New declarations are easy to add without swapping semicolons and
        commas, diffs stay clean, and a debugger can step through each
        declaration.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const width = 640,
          height = 480,
          depth = 24;
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const width = 640;
        const height = 480;
        const depth = 24;
        \\\
        ```
    languages: [javascript]
    tags: [variables, formatting]
    source: https://github.com/airbnb/javascript#variables--one-const
