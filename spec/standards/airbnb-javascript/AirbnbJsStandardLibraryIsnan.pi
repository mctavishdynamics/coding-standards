use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsStandardLibraryIsnan:
    standard: @{AirbnbJavaScript}
    ruleId: 29.1
    title: Prefer Number.isNaN over the global isNaN function
    statement:
        Check for NaN with Number.isNaN, not the global isNaN. Enforced by
        the ESLint rule no-restricted-globals.
    rationale:
        The global version converts its argument to a number before testing
        it, so any value whose conversion fails counts as NaN. When that
        conversion is what you want, perform it yourself first.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        isNaN('hello'); // true
        \\\
        ```
    compliant:
        ```javascript
        \\\
        Number.isNaN('hello'); // false
        Number.isNaN(Number('hello')); // true
        \\\
        ```
    languages: [javascript]
    tags: [standard-library, numbers]
    source: https://github.com/airbnb/javascript#standard-library--isnan
