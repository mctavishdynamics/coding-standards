use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsWhitespaceInBrackets:
    standard: @{AirbnbJavaScript}
    ruleId: 19.11
    title: Do not put spaces inside brackets
    statement:
        Do not add spaces just inside array brackets. Enforced by the ESLint
        rule array-bracket-spacing.
    rationale:
        Tight brackets are the consistent, expected style.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const sizes = [ 'S', 'M', 'L' ];
        console.log(sizes[ 0 ]);
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const sizes = ['S', 'M', 'L'];
        console.log(sizes[0]);
        \\\
        ```
    languages: [javascript]
    tags: [whitespace, arrays]
    source: https://github.com/airbnb/javascript#whitespace--in-brackets
