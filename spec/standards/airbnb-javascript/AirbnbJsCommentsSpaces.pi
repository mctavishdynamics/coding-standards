use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsCommentsSpaces:
    standard: @{AirbnbJavaScript}
    ruleId: 18.3
    title: Start every comment with a space
    statement:
        Put a space after the comment marker of every comment. Enforced by
        the ESLint rule spaced-comment.
    rationale:
        The space makes comments easier to read.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        //validate before saving
        /**
         *returns the user id
         */
        \\\
        ```
    compliant:
        ```javascript
        \\\
        // validate before saving
        /**
         * returns the user id
         */
        \\\
        ```
    languages: [javascript]
    tags: [comments, whitespace]
    source: https://github.com/airbnb/javascript#comments--spaces
