use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsWhitespaceNoMultipleEmptyLines:
    standard: @{AirbnbJavaScript}
    ruleId: 19.20
    title: Avoid extra empty lines at the start, end and middle of files
    statement:
        Do not use several empty lines in a row, allow only one newline at
        the end of a file, and do not start a file with an empty line.
        Enforced by the ESLint rule no-multiple-empty-lines.
    rationale:
        Extra empty lines add length without adding structure.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        import api from './api';



        export default api;
        \\\
        ```
    compliant:
        ```javascript
        \\\
        import api from './api';

        export default api;
        \\\
        ```
    languages: [javascript]
    tags: [whitespace, files]
    source: https://github.com/airbnb/javascript#whitespace--no-multiple-empty-lines
