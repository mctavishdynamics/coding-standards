use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsWhitespaceNoMultipleEmptyLines:
    standard: @{AirbnbJavaScript}
    ruleId: 19.20
    title: Avoid extra empty lines at the start, end and middle of files
    statement:
        Never stack blank lines, end each file with exactly one newline, and
        begin files with content rather than a blank line. The ESLint rule
        no-multiple-empty-lines checks this.
    rationale:
        Extra empty lines add length without adding structure.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        import api from './api';



        export default api;
        \\\
        ```
    compliant:
        ```javascript
        \\\
        import api from './api';

        export default api;
        \\\
        ```
    languages: [javascript]
    tags: [whitespace, files]
    source: https://github.com/airbnb/javascript#whitespace--no-multiple-empty-lines
