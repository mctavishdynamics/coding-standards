use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsWhitespaceNoTrailingSpaces:
    standard: @{AirbnbJavaScript}
    ruleId: 19.19
    title: Do not leave trailing spaces
    statement:
        Remove whitespace at the end of lines. Enforced by the ESLint rule
        no-trailing-spaces.
    rationale:
        Trailing spaces are invisible noise that shows up in diffs.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const x = 1;··
        const y = 2;·
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const x = 1;
        const y = 2;
        \\\
        ```
    languages: [javascript]
    tags: [whitespace, formatting]
    source: https://github.com/airbnb/javascript#whitespace--no-trailing-spaces
