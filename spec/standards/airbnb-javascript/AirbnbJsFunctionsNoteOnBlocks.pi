use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsFunctionsNoteOnBlocks:
    standard: @{AirbnbJavaScript}
    ruleId: 7.4
    title: Treat function declarations as distinct from statements
    statement:
        The language specification treats a block as a sequence of statements,
        and a function declaration does not count as one. That grammar detail is
        the reason declarations should stay out of blocks.
    rationale:
        Knowing the grammar explains why declarations in blocks behave
        inconsistently.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        while (pending) {
          function step() {
            pending = advance();
          }
          step();
        }
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const step = () => {
          pending = advance();
        };
        while (pending) {
          step();
        }
        \\\
        ```
    languages: [javascript]
    tags: [functions, scope]
    source: https://github.com/airbnb/javascript#functions--note-on-blocks
