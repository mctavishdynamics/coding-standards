use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsBlocksCuddledElses:
    standard: @{AirbnbJavaScript}
    ruleId: 16.2
    title: Keep else beside the brace that ends the if block
    statement:
        When if and else blocks span several lines, write the else keyword
        right after the closing brace of the if block, on that same line.
        The ESLint rule brace-style checks this.
    rationale:
        It keeps the branches visibly connected and matches the common one
        true brace style.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        if (valid) {
          submit();
        }
        else {
          warn();
        }
        \\\
        ```
    compliant:
        ```javascript
        \\\
        if (valid) {
          submit();
        } else {
          warn();
        }
        \\\
        ```
    languages: [javascript]
    tags: [blocks, formatting]
    source: https://github.com/airbnb/javascript#blocks--cuddled-elses
