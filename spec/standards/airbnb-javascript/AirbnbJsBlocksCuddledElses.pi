use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsBlocksCuddledElses:
    standard: @{AirbnbJavaScript}
    ruleId: 16.2
    title: Put else on the same line as the closing brace
    statement:
        In multiline if and else blocks, put else on the same line as the
        closing brace of the if block. Enforced by the ESLint rule
        brace-style.
    rationale:
        It keeps the branches visibly connected and matches the common one
        true brace style.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        if (valid) {
          submit();
        }
        else {
          warn();
        }
        \\\
        ```
    compliant:
        ```javascript
        \\\
        if (valid) {
          submit();
        } else {
          warn();
        }
        \\\
        ```
    languages: [javascript]
    tags: [blocks, formatting]
    source: https://github.com/airbnb/javascript#blocks--cuddled-elses
