use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsPropertiesDot:
    standard: @{AirbnbJavaScript}
    ruleId: 12.1
    title: Use dot notation to access properties
    statement:
        Read properties with dot notation when the property name is a fixed
        identifier. Enforced by the ESLint rule dot-notation.
    rationale:
        Dot notation is shorter and easier to read than a quoted name in
        brackets.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const port = config['port'];
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const port = config.port;
        \\\
        ```
    languages: [javascript]
    tags: [properties, readability]
    source: https://github.com/airbnb/javascript#properties--dot
