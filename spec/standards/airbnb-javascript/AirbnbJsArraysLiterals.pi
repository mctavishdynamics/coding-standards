use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsArraysLiterals:
    standard: @{AirbnbJavaScript}
    ruleId: 4.1
    title: Create arrays with literal syntax
    statement:
        Create arrays with an array literal instead of new Array(). Enforced
        by the ESLint rule no-array-constructor.
    rationale:
        The Array constructor behaves differently depending on how many
        arguments it gets, while the literal always means the same thing.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const queue = new Array();
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const queue = [];
        \\\
        ```
    languages: [javascript]
    tags: [arrays, literals]
    source: https://github.com/airbnb/javascript#arrays--literals
