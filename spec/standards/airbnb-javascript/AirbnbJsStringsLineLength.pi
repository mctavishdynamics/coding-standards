use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsStringsLineLength:
    standard: @{AirbnbJavaScript}
    ruleId: 6.2
    title: Do not split long strings across lines
    statement:
        Do not break a string that pushes the line past 100 characters into
        pieces joined with concatenation or line continuations. Keep it
        whole.
    rationale:
        Broken strings are awkward to edit and cannot be found by searching
        for the text.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const message = 'The payment could not be processed because the card ' +
          'issuer declined the transaction.';
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const message = 'The payment could not be processed because the card issuer declined the transaction.';
        \\\
        ```
    languages: [javascript]
    tags: [strings, formatting, line-length]
    source: https://github.com/airbnb/javascript#strings--line-length
