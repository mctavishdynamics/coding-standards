use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsCommentsSingleline:
    standard: @{AirbnbJavaScript}
    ruleId: 18.2
    title: Put single-line comments on their own line above the code
    statement:
        Use line comments for single-line comments and place them on a line
        of their own above the code they describe. Put an empty line before
        the comment unless it is the first line of a block.
    rationale:
        Comments above their subject are easy to find, and the blank line
        separates them from earlier code.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const items = load();
        const limit = 10; // page size
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const items = load();

        // page size
        const limit = 10;
        \\\
        ```
    languages: [javascript]
    tags: [comments, formatting]
    source: https://github.com/airbnb/javascript#comments--singleline
