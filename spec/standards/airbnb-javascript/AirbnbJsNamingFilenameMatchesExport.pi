use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsNamingFilenameMatchesExport:
    standard: @{AirbnbJavaScript}
    ruleId: 23.6
    title: Match the file name to the default export
    statement:
        Name a file exactly after its default export.
    rationale:
        Imports, file names and exports then agree, which makes modules easy
        to find.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        // file: date-utils.js
        export default class DateRange {}
        \\\
        ```
    compliant:
        ```javascript
        \\\
        // file: DateRange.js
        export default class DateRange {}
        \\\
        ```
    languages: [javascript]
    tags: [naming, modules, files]
    source: https://github.com/airbnb/javascript#naming--filename-matches-export
