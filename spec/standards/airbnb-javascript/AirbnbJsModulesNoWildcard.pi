use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsModulesNoWildcard:
    standard: @{AirbnbJavaScript}
    ruleId: 10.2
    title: Do not use wildcard imports
    statement:
        Import the names you need, or the default export, instead of
        importing everything with an asterisk.
    rationale:
        This makes sure each module has a single default export to import.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        import * as validators from './validators';
        \\\
        ```
    compliant:
        ```javascript
        \\\
        import validators from './validators';
        \\\
        ```
    languages: [javascript]
    tags: [modules, imports]
    source: https://github.com/airbnb/javascript#modules--no-wildcard
