use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsCommentsFixme:
    standard: @{AirbnbJavaScript}
    ruleId: 18.5
    title: Use FIXME to annotate problems
    statement:
        Annotate a known problem with a FIXME comment.
    rationale:
        A consistent marker makes outstanding problems easy to search for.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        // shouldn't use a global here
        total = 0;
        \\\
        ```
    compliant:
        ```javascript
        \\\
        // FIXME: shouldn't use a global here
        total = 0;
        \\\
        ```
    languages: [javascript]
    tags: [comments, maintenance]
    source: https://github.com/airbnb/javascript#comments--fixme
