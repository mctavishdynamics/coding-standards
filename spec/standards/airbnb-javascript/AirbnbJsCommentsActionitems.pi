use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsCommentsActionitems:
    standard: @{AirbnbJavaScript}
    ruleId: 18.4
    title: Prefix actionable comments with FIXME or TODO
    statement:
        Mark comments that call for action with FIXME when they describe a
        problem to revisit, or TODO when they describe a solution to
        implement.
    rationale:
        These prefixes tell other developers at once that the comment is
        actionable and what kind of action it needs.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        // this breaks for negative amounts
        // should also handle refunds here
        \\\
        ```
    compliant:
        ```javascript
        \\\
        // FIXME: breaks for negative amounts
        // TODO: handle refunds here
        \\\
        ```
    languages: [javascript]
    tags: [comments, maintenance]
    source: https://github.com/airbnb/javascript#comments--actionitems
