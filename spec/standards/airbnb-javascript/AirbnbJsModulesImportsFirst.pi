use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsModulesImportsFirst:
    standard: @{AirbnbJavaScript}
    ruleId: 10.7
    title: Put imports before other statements
    statement:
        Place all import statements above any other statements in a module.
        Enforced by the ESLint rule import/first.
    rationale:
        Imports are hoisted anyway, so keeping them at the top avoids
        surprises.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        import api from './api';
        api.configure({ timeout: 5000 });
        import logger from './logger';
        \\\
        ```
    compliant:
        ```javascript
        \\\
        import api from './api';
        import logger from './logger';

        api.configure({ timeout: 5000 });
        \\\
        ```
    languages: [javascript]
    tags: [modules, imports, ordering]
    source: https://github.com/airbnb/javascript#modules--imports-first
