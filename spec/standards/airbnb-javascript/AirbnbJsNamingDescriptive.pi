use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsNamingDescriptive:
    standard: @{AirbnbJavaScript}
    ruleId: 23.1
    title: Avoid single-letter names
    statement:
        Give variables and functions descriptive names instead of single
        letters. Enforced by the ESLint rule id-length.
    rationale:
        Descriptive names tell the reader what a value is without making
        them work it out.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        function c(a, b) {
          return a * b;
        }
        \\\
        ```
    compliant:
        ```javascript
        \\\
        function calculateArea(width, height) {
          return width * height;
        }
        \\\
        ```
    languages: [javascript]
    tags: [naming, readability]
    source: https://github.com/airbnb/javascript#naming--descriptive
