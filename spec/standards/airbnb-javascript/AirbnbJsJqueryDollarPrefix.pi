use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsJqueryDollarPrefix:
    standard: @{AirbnbJavaScript}
    ruleId: 26.1
    title: Prefix jQuery object variables with a dollar sign
    statement:
        Start the names of variables that hold jQuery objects with a dollar
        sign.
    rationale:
        The prefix tells readers which values are jQuery objects and which
        are plain DOM nodes or data.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const menu = $('.menu');
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const $menu = $('.menu');
        \\\
        ```
    languages: [javascript]
    tags: [jquery, naming]
    source: https://github.com/airbnb/javascript#jquery--dollar-prefix
