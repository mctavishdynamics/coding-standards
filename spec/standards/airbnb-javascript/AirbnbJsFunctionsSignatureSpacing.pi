use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsFunctionsSignatureSpacing:
    standard: @{AirbnbJavaScript}
    ruleId: 7.11
    title: Space function signatures consistently
    statement:
        Leave one space between the keyword function and its parameters, and
        one before the brace that opens the body, but none between a named
        function and its parameter list. The ESLint rules
        space-before-function-paren and space-before-blocks check this.
    rationale:
        With uniform spacing, renaming or dropping a function name never
        forces a whitespace edit as well.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const load = function(){};
        const save = function persist (){};
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const load = function () {};
        const save = function persist() {};
        \\\
        ```
    languages: [javascript]
    tags: [functions, formatting, whitespace]
    source: https://github.com/airbnb/javascript#functions--signature-spacing
