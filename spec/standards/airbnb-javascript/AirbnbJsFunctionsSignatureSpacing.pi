use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsFunctionsSignatureSpacing:
    standard: @{AirbnbJavaScript}
    ruleId: 7.11
    title: Space function signatures consistently
    statement:
        Put a space after the function keyword and before the opening brace
        of the body, and no space between a function name and its parameter
        list. Enforced by the ESLint rules space-before-function-paren and
        space-before-blocks.
    rationale:
        Consistent spacing means you never have to add or remove a space
        when a name is added or removed.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const load = function(){};
        const save = function persist (){};
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const load = function () {};
        const save = function persist() {};
        \\\
        ```
    languages: [javascript]
    tags: [functions, formatting, whitespace]
    source: https://github.com/airbnb/javascript#functions--signature-spacing
