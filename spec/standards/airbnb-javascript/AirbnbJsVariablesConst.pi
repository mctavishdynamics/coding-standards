use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsVariablesConst:
    standard: @{AirbnbJavaScript}
    ruleId: 13.1
    title: Always declare variables with const or let
    statement:
        Declare every variable with const or let. Enforced by the ESLint
        rules no-undef and prefer-const.
    rationale:
        An undeclared assignment creates a global variable and pollutes the
        global namespace.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        counter = new Counter();
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const counter = new Counter();
        \\\
        ```
    languages: [javascript]
    tags: [variables, globals]
    source: https://github.com/airbnb/javascript#variables--const
