use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsArrowsOneArgParens:
    standard: @{AirbnbJavaScript}
    ruleId: 8.4
    title: Always parenthesise arrow function parameters
    statement:
        Put parentheses around arrow function parameters even when there is
        only one. Enforced by the ESLint rule arrow-parens.
    rationale:
        It is consistent and avoids diff churn when parameters are added or
        removed.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const names = users.map(user => user.name);
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const names = users.map((user) => user.name);
        \\\
        ```
    languages: [javascript]
    tags: [functions, arrow-functions, formatting]
    source: https://github.com/airbnb/javascript#arrows--one-arg-parens
