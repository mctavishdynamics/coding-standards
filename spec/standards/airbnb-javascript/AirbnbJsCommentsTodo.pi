use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsCommentsTodo:
    standard: @{AirbnbJavaScript}
    ruleId: 18.6
    title: Use TODO to annotate solutions to implement
    statement:
        Annotate work that still needs to be done with a TODO comment.
    rationale:
        A consistent marker makes planned work easy to search for.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        // make the timeout configurable
        const timeout = 3000;
        \\\
        ```
    compliant:
        ```javascript
        \\\
        // TODO: make the timeout configurable
        const timeout = 3000;
        \\\
        ```
    languages: [javascript]
    tags: [comments, maintenance]
    source: https://github.com/airbnb/javascript#comments--todo
