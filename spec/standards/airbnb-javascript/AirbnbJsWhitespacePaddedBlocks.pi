use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsWhitespacePaddedBlocks:
    standard: @{AirbnbJavaScript}
    ruleId: 19.8
    title: Do not pad blocks with blank lines
    statement:
        Do not start or end a block with a blank line. Enforced by the
        ESLint rule padded-blocks.
    rationale:
        Padding adds height without making the block easier to read.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        function close() {

          socket.end();

        }
        \\\
        ```
    compliant:
        ```javascript
        \\\
        function close() {
          socket.end();
        }
        \\\
        ```
    languages: [javascript]
    tags: [whitespace, formatting]
    source: https://github.com/airbnb/javascript#whitespace--padded-blocks
