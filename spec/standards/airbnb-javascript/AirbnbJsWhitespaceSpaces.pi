use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsWhitespaceSpaces:
    standard: @{AirbnbJavaScript}
    ruleId: 19.1
    title: Indent with two spaces
    statement:
        Indent with soft tabs of two space characters. Enforced by the
        ESLint rule indent.
    rationale:
        A single indentation width keeps code consistent across editors.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        function load() {
            return fetchAll();
        }
        \\\
        ```
    compliant:
        ```javascript
        \\\
        function load() {
          return fetchAll();
        }
        \\\
        ```
    languages: [javascript]
    tags: [whitespace, indentation]
    source: https://github.com/airbnb/javascript#whitespace--spaces
