use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsAccessorsBooleanPrefix:
    standard: @{AirbnbJavaScript}
    ruleId: 24.3
    title: Prefix boolean accessors with is or has
    statement:
        Name a method or property that returns a boolean with an is or has
        prefix, such as isActive() or hasChildren().
    rationale:
        The prefix makes it clear the value is a yes or no answer.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        if (!user.active()) {
          return;
        }
        \\\
        ```
    compliant:
        ```javascript
        \\\
        if (!user.isActive()) {
          return;
        }
        \\\
        ```
    languages: [javascript]
    tags: [accessors, naming, booleans]
    source: https://github.com/airbnb/javascript#accessors--boolean-prefix
