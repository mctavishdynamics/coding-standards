use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsCommasLeadingTrailing:
    standard: @{AirbnbJavaScript}
    ruleId: 20.1
    title: Do not use leading commas
    statement:
        Put commas at the end of lines, never at the start of the next line.
        Enforced by the ESLint rule comma-style.
    rationale:
        Leading commas are unusual and make lists harder to read.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const colors = [
          'red'
          , 'green'
          , 'blue'
        ];
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const colors = [
          'red',
          'green',
          'blue',
        ];
        \\\
        ```
    languages: [javascript]
    tags: [commas, formatting]
    source: https://github.com/airbnb/javascript#commas--leading-trailing
