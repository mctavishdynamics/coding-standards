use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsCoercionCommentDeviations:
    standard: @{AirbnbJavaScript}
    ruleId: 22.4
    title: Comment bit shifting used for performance
    statement:
        If parseInt is a measured bottleneck and you use bit shifting to
        convert numbers instead, leave a comment explaining what the code
        does and why.
    rationale:
        Bit tricks are not obvious, so readers need to know the intent and
        the reason.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const index = value >> 0;
        \\\
        ```
    compliant:
        ```javascript
        \\\
        // parseInt was the hot spot in profiling; shifting truncates
        // the string-coerced value to a 32-bit integer much faster.
        const index = value >> 0;
        \\\
        ```
    languages: [javascript]
    tags: [coercion, comments, performance]
    source: https://github.com/airbnb/javascript#coercion--comment-deviations
