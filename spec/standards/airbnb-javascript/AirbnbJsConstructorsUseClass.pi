use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsConstructorsUseClass:
    standard: @{AirbnbJavaScript}
    ruleId: 9.1
    title: Always use class syntax
    statement:
        Define types with class and do not manipulate prototype directly.
    rationale:
        Class syntax is shorter and easier to reason about.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        function Queue(items = []) {
          this.items = [...items];
        }
        Queue.prototype.next = function () {
          return this.items.shift();
        };
        \\\
        ```
    compliant:
        ```javascript
        \\\
        class Queue {
          constructor(items = []) {
            this.items = [...items];
          }

          next() {
            return this.items.shift();
          }
        }
        \\\
        ```
    languages: [javascript]
    tags: [classes, es6]
    source: https://github.com/airbnb/javascript#constructors--use-class
