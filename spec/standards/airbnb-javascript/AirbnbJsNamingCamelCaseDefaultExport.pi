use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsNamingCamelCaseDefaultExport:
    standard: @{AirbnbJavaScript}
    ruleId: 23.7
    title: Use camelCase for a default-exported function
    statement:
        When a module's default export is a function, name it in camelCase
        and give the file the same name.
    rationale:
        The function name and file name match, and the case shows it is a
        function rather than a class.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        // file: format-currency.js
        export default function FormatCurrency(amount) {}
        \\\
        ```
    compliant:
        ```javascript
        \\\
        // file: formatCurrency.js
        export default function formatCurrency(amount) {}
        \\\
        ```
    languages: [javascript]
    tags: [naming, modules]
    source: https://github.com/airbnb/javascript#naming--camelCase-default-export
