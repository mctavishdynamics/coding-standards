use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsPropertiesBracket:
    standard: @{AirbnbJavaScript}
    ruleId: 12.2
    title: Use bracket notation for variable property names
    statement:
        Use bracket notation when the property name is held in a variable.
    rationale:
        Brackets are the way to look up a property whose name is only known
        at run time.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        function getSetting(name) {
          return eval(`settings.${name}`);
        }
        \\\
        ```
    compliant:
        ```javascript
        \\\
        function getSetting(name) {
          return settings[name];
        }
        \\\
        ```
    languages: [javascript]
    tags: [properties]
    source: https://github.com/airbnb/javascript#properties--bracket
