use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsObjectsGroupedShorthand:
    standard: @{AirbnbJavaScript}
    ruleId: 3.5
    title: Group shorthand properties first
    statement:
        Put all shorthand properties at the start of an object literal,
        before the properties written in full.
    rationale:
        Grouping them makes it easy to see which properties use the
        shorthand.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const user = {
          id,
          role: 'admin',
          email,
          active: true,
        };
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const user = {
          id,
          email,
          role: 'admin',
          active: true,
        };
        \\\
        ```
    languages: [javascript]
    tags: [objects, es6, ordering]
    source: https://github.com/airbnb/javascript#objects--grouped-shorthand
