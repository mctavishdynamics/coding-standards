use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsEs6ObjectConcise:
    standard: @{AirbnbJavaScript}
    ruleId: 3.4
    title: Use property value shorthand
    statement:
        When a property has the same name as the variable that supplies its
        value, write only the name. Enforced by the ESLint rule
        object-shorthand.
    rationale:
        It is shorter and still says exactly what the property holds.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const city = 'Lisbon';
        const address = { city: city };
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const city = 'Lisbon';
        const address = { city };
        \\\
        ```
    languages: [javascript]
    tags: [objects, es6]
    source: https://github.com/airbnb/javascript#es6-object-concise
