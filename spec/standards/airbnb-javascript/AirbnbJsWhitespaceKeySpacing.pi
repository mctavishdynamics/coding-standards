use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsWhitespaceKeySpacing:
    standard: @{AirbnbJavaScript}
    ruleId: 19.18
    title: Space object keys and values consistently
    statement:
        In object literals, put no space between a key and its colon and one
        space after the colon. Enforced by the ESLint rule key-spacing.
    rationale:
        Consistent key spacing keeps object literals uniform.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const user = { name :'Ada', role:'admin' };
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const user = { name: 'Ada', role: 'admin' };
        \\\
        ```
    languages: [javascript]
    tags: [whitespace, objects]
    source: https://github.com/airbnb/javascript#whitespace--key-spacing
