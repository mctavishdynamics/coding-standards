use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsWhitespaceComputedPropertySpacing:
    standard: @{AirbnbJavaScript}
    ruleId: 19.16
    title: Do not put spaces inside computed property brackets
    statement:
        Write computed property access and computed keys without spaces
        inside the brackets. Enforced by the ESLint rule
        computed-property-spacing.
    rationale:
        Consistent bracket spacing keeps property access easy to read.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const value = row[ column ];
        const entry = { [ key ]: value };
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const value = row[column];
        const entry = { [key]: value };
        \\\
        ```
    languages: [javascript]
    tags: [whitespace, properties]
    source: https://github.com/airbnb/javascript#whitespace--computed-property-spacing
