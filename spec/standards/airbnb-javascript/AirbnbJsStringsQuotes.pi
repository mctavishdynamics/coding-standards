use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsStringsQuotes:
    standard: @{AirbnbJavaScript}
    ruleId: 6.1
    title: Use single quotes for strings
    statement:
        Write string literals with single quotes. Enforced by the ESLint
        rule quotes.
    rationale:
        One quote style keeps the code consistent.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const greeting = "Hello";
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const greeting = 'Hello';
        \\\
        ```
    languages: [javascript]
    tags: [strings, formatting]
    source: https://github.com/airbnb/javascript#strings--quotes
