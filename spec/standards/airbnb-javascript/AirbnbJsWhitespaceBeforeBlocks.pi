use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsWhitespaceBeforeBlocks:
    standard: @{AirbnbJavaScript}
    ruleId: 19.2
    title: Put one space before a leading brace
    statement:
        Place one space before the opening brace of a block or object
        argument. Enforced by the ESLint rule space-before-blocks.
    rationale:
        Consistent spacing keeps blocks easy to spot.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        function save(){
          store.write({ id });
        }
        \\\
        ```
    compliant:
        ```javascript
        \\\
        function save() {
          store.write({ id });
        }
        \\\
        ```
    languages: [javascript]
    tags: [whitespace, formatting]
    source: https://github.com/airbnb/javascript#whitespace--before-blocks
