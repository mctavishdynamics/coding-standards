use ../lib/CodingRule

from ./AirbnbJavaScript import AirbnbJavaScript

export coding-rule AirbnbJsCommasDangling:
    standard: @{AirbnbJavaScript}
    ruleId: 20.2
    title: Use trailing commas in multiline lists
    statement:
        Add a trailing comma after the last item of multiline arrays,
        objects, parameter lists and argument lists. Do not add one after a
        rest element. Enforced by the ESLint rule comma-dangle.
    rationale:
        Trailing commas give cleaner git diffs, and transpilers remove them
        so older browsers are not affected.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const user = {
          name: 'Ada',
          role: 'admin'
        };
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const user = {
          name: 'Ada',
          role: 'admin',
        };
        \\\
        ```
    languages: [javascript]
    tags: [commas, formatting]
    source: https://github.com/airbnb/javascript#commas--dangling
