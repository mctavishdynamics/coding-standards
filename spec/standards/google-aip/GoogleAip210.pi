use ../lib/CodingRule

from ./GoogleAip import GoogleAip

export coding-rule GoogleAip210:
    standard: @{GoogleAip}
    ruleId: AIP-210
    title: Count string limits in code points and normalize identifiers to NFC
    statement:
        Define a character as a Unicode code point and measure and enforce
        documented string limits in characters. Restrict identifiers to
        ASCII where possible, and always normalize unique identifiers to
        Normalization Form C before storing them or checking uniqueness.
    rationale:
        Characters, bytes and graphemes differ, so unclear limits confuse
        users and billing. Without normalization, two visually identical
        strings could name different resources.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [unicode, strings]
    source: https://google.aip.dev/210
