use ../lib/CodingRule

from ./GoogleAip import GoogleAip

export coding-rule GoogleAip233:
    standard: @{GoogleAip}
    ruleId: AIP-233
    title: Provide a BatchCreate method that is atomic when synchronous
    statement:
        A batch create method is named BatchCreate plus the plural resource,
        uses POST with a :batchCreate URI and takes a repeated field of
        create requests. A synchronous one must be atomic; a long-running
        one may allow partial success, reporting failures in a
        failed_requests map keyed by request index.
    rationale:
        A synchronous response cannot express partial failure clearly, since
        success implies everything worked. Operations can carry partial
        results, so only they may allow it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```protobuf
        \\\
        message BatchCreateRecipesRequest {
          string parent = 1;
          repeated CreateRecipeRequest requests = 2 [(google.api.field_behavior) = REQUIRED];
        }
        \\\
        ```
    languages: [any]
    tags: [batch-methods, methods]
    source: https://google.aip.dev/233
