use ../lib/CodingRule

from ./GoogleAip import GoogleAip

export coding-rule GoogleAip181:
    standard: @{GoogleAip}
    ruleId: AIP-181
    title: Mark components with a stability level and honour its promises
    statement:
        Label components as alpha, beta or stable. Alpha users must expect
        breaking changes, beta must be feature-complete but may still change
        with notice, and stable components must have no breaking changes for
        the life of the major version and a defined turndown process with a
        deprecation period.
    rationale:
        Clear stability levels tell users how much change to expect and let
        producers iterate early without breaking production users later.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [compatibility, versioning]
    source: https://google.aip.dev/181
