use ../lib/CodingRule

from ./GoogleAip import GoogleAip

export coding-rule GoogleAip111:
    standard: @{GoogleAip}
    ruleId: AIP-111
    title: Hold data plane resources to management plane rules when exposed as resources
    statement:
        An API may expose data plane resources and methods through a
        resource-oriented management interface. When it does, those
        resources and methods have to meet the same standard method
        requirements as any management plane resource.
    rationale:
        Management interfaces are consumed by uniform tooling such as
        declarative clients. A resource that looks like a management
        resource but behaves differently breaks that tooling and the user's
        expectations.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [resource-design, planes]
    source: https://google.aip.dev/111
