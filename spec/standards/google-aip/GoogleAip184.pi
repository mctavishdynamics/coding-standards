use ../lib/CodingRule

from ./GoogleAip import GoogleAip

export coding-rule GoogleAip184:
    standard: @{GoogleAip}
    ruleId: AIP-184
    title: Use date-based API version identifiers
    statement:
        Under interface-based versioning, identify versions by a date in
        YYYY-MM-DD form, with a -preview or -experimental suffix for pre-GA
        versions and decorators only on private versions. Dates must
        increase monotonically, identifiers must never change after release,
        and requests without a version must fail with 400 unless a default
        applies.
    rationale:
        A dated identifier orders versions unambiguously and signals
        stability. Treating identifiers as opaque and immutable lets each
        version evolve on its own.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [versioning]
    source: https://google.aip.dev/184
