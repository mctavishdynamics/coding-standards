use ../lib/CodingRule

from ./GoogleAip import GoogleAip

export coding-rule GoogleAip163:
    standard: @{GoogleAip}
    ruleId: AIP-163
    title: Support validate_only requests that run every live check
    statement:
        To let users preview a change, add a bool validate_only field to the
        mutating request. A validate-only request must perform the same
        permission and validation checks as a real one and fail when the
        real request would fail; declarative-friendly resources must offer
        it on all mutating methods.
    rationale:
        Users want to see the effect of risky changes, such as provisioning
        many machines, before committing to them. A dry run is only useful
        if it checks everything the real request would.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```protobuf
        \\\
        message CreateClusterRequest {
          string parent = 1;
          Cluster cluster = 2;
          bool validate_only = 3;
        }
        \\\
        ```
    languages: [any]
    tags: [validation, design-patterns]
    source: https://google.aip.dev/163
