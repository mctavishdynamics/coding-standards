use ../lib/CodingRule

from ./GoogleAip import GoogleAip

export coding-rule GoogleAip130:
    standard: @{GoogleAip}
    ruleId: AIP-130
    title: Prefer standard methods, then custom methods, over free-form operations
    statement:
        Express an operation as a standard method on a resource when
        possible. If none fits, use a custom method attached to a resource
        or collection, and fall back to an operation outside the resource
        model only when the API cannot be modelled with resources at all.
    rationale:
        Standard methods work in the widest range of clients and let users
        reuse knowledge across APIs. Resource-bound custom methods keep some
        of that consistency, while free-form operations usually need hand-
        written client support.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [methods, resource-design]
    source: https://google.aip.dev/130
