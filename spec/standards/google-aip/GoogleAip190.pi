use ../lib/CodingRule

from ./GoogleAip import GoogleAip

export coding-rule GoogleAip190:
    standard: @{GoogleAip}
    ruleId: AIP-190
    title: Use simple, consistent American English names
    statement:
        Choose names that are simple, intuitive and consistent, spelled in
        correct American English, using only common abbreviations.
        Definitions use UpperCamelCase, methods follow VerbNoun, and message
        names stay short without prepositions.
    rationale:
        Consistent naming keeps the developer experience the same across
        many APIs and over many years, and helps non-native speakers read
        the API.
    exceptions: null
    severity: null
    noncompliant:
        ```protobuf
        \\\
        message ColourSettingsForUserWithDefaults {}
        \\\
        ```
    compliant:
        ```protobuf
        \\\
        message ColorSettings {}
        \\\
        ```
    languages: [any]
    tags: [naming]
    source: https://google.aip.dev/190
