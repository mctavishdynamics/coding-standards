use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoRepetitiveInContext:
    standard: @{GoogleGo}
    ruleId: decisions/repetitive-in-context
    title: Do not repeat context in local names
    statement:
        Strip from a name whatever its package, type, method, function,
        import path or file already conveys. Decide what counts as
        repetitive by reading the name where callers use it.
    rationale:
        Context already qualifies every name inside it, so restating it adds
        noise without benefit.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        func (q *Queue) PendingJobs() (pendingJobList []Job, err error) {
            pendingJobRows, queueQueryErr := q.queryQueue("state = 'pending'")
            if queueQueryErr != nil {
                return nil, fmt.Errorf("pending jobs: %w", queueQueryErr)
            }
            return toJobs(pendingJobRows), nil
        }
        \\\
        ```
    compliant:
        ```go
        \\\
        func (q *Queue) PendingJobs() ([]Job, error) {
            rows, err := q.query("state = 'pending'")
            if err != nil {
                return nil, fmt.Errorf("pending jobs: %w", err)
            }
            return toJobs(rows), nil
        }
        \\\
        ```
    languages: [go]
    tags: [decisions, naming, repetition]
    source: https://google.github.io/styleguide/go/decisions#repetitive-in-context
