use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoLiteralMatchingBraces:
    standard: @{GoogleGo}
    ruleId: decisions/literal-matching-braces
    title: Put closing braces at the indentation of the opening line
    statement:
        In a multi-line literal, end the last value with a comma and put the
        closing brace on its own line, indented like the line with the
        opening brace.
    rationale:
        It keeps brace matching for literals the same as for functions and
        if statements.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        limits := Limits{
            MaxUsers: 100,
            MaxRooms: 10}
        \\\
        ```
    compliant:
        ```go
        \\\
        limits := Limits{
            MaxUsers: 100,
            MaxRooms: 10,
        }
        \\\
        ```
    languages: [go]
    tags: [decisions, literals, formatting]
    source: https://google.github.io/styleguide/go/decisions#literal-matching-braces
