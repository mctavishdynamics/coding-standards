use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoReturningErrors:
    standard: @{GoogleGo}
    ruleId: decisions/returning-errors
    title: Return errors as the last result using the error type
    statement:
        A function that may fail returns an error as its final result, nil
        when it succeeds. Unless documented otherwise, callers should ignore
        the other results whenever the error is non-nil. Exported functions
        declare the error interface as their result type, not a concrete
        error type.
    rationale:
        A nil pointer of a concrete error type becomes a non-nil error once
        stored in an interface, a classic subtle bug.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        func Parse(b []byte) *ParseError {
            var perr *ParseError
            // ...
            return perr // non-nil error interface even when perr is nil
        }
        \\\
        ```
    compliant:
        ```go
        \\\
        func Parse(b []byte) (*Config, error) {
            cfg, err := decode(b)
            if err != nil {
                return nil, err
            }
            return cfg, nil
        }
        \\\
        ```
    languages: [go]
    tags: [decisions, errors, functions]
    source: https://google.github.io/styleguide/go/decisions#returning-errors
