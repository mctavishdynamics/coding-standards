use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoStringConcatSimple:
    standard: @{GoogleGo}
    ruleId: best-practices/string-concat-simple
    title: Use + to join a few strings
    statement:
        Prefer the plus operator when concatenating a small number of
        strings.
    rationale:
        It is the simplest syntax and needs no import.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        key := fmt.Sprintf("%s%s", prefix, id)
        \\\
        ```
    compliant:
        ```go
        \\\
        key := prefix + id
        \\\
        ```
    languages: [go]
    tags: [best-practices, strings]
    source: https://google.github.io/styleguide/go/best-practices#string-concat-simple
