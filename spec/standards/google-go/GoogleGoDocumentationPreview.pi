use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoDocumentationPreview:
    standard: @{GoogleGo}
    ruleId: best-practices/documentation-preview
    title: Preview generated documentation
    statement:
        Preview the documentation your code produces, for example with
        pkgsite, before and during code review.
    rationale:
        It confirms that Godoc formatting and examples render the way you
        expect.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [go]
    tags: [best-practices, documentation, tooling]
    source: https://google.github.io/styleguide/go/best-practices#documentation-preview
