use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoLocalConsistency:
    standard: @{GoogleGo}
    ruleId: guide/local-consistency
    title: Follow the local style where the guide is silent
    statement:
        Where the style guide says nothing, choose freely unless nearby code
        in the same file or package has taken a consistent stance; then
        follow it. Local consistency does not justify making a deviation
        from the guide worse, spreading it to more files or APIs, or
        introducing a bug.
    rationale:
        Nearby consistency helps readers, but it must not become a reason to
        entrench style problems.
    exceptions:
        Some matters, such as line length limits and assertion libraries,
        are not valid local style choices at all.
    severity: null
    noncompliant: null
    compliant: null
    languages: [go]
    tags: [guide, consistency]
    source: https://google.github.io/styleguide/go/guide#local-consistency
