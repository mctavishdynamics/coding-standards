use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoErrorStructure:
    standard: @{GoogleGo}
    ruleId: best-practices/error-structure
    title: Give errors structure that callers can inspect
    statement:
        When callers need to tell error conditions apart, expose sentinel
        values, error types or fields they can check with ==, errors.Is or
        errors.As. Never make callers match on error strings.
    rationale:
        String matching is brittle and breaks when messages are reworded.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        if err != nil && strings.Contains(err.Error(), "duplicate") {
            return nil
        }
        \\\
        ```
    compliant:
        ```go
        \\\
        var ErrDuplicate = errors.New("duplicate entry")

        if errors.Is(err, ErrDuplicate) {
            return nil
        }
        \\\
        ```
    languages: [go]
    tags: [best-practices, errors, api-design]
    source: https://google.github.io/styleguide/go/best-practices#error-structure
