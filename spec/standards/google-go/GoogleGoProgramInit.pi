use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoProgramInit:
    standard: @{GoogleGo}
    ruleId: best-practices/program-init
    title: Report initialisation errors from main with log.Exit
    statement:
        Return setup failures, like invalid flags or config, back up the
        call chain to main. There, log.Exit with a message telling the user
        how to correct the problem, instead of log.Fatal.
    rationale:
        A human-readable, actionable message helps more than a stack trace
        pointing at the check.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        func loadConfig(path string) *Config {
            cfg, err := parse(path)
            if err != nil {
                log.Fatal(err)
            }
            return cfg
        }
        \\\
        ```
    compliant:
        ```go
        \\\
        func main() {
            cfg, err := loadConfig(*configPath)
            if err != nil {
                log.Exitf("Invalid --config %q: %v (see go/billing-config)", *configPath, err)
            }
            run(cfg)
        }
        \\\
        ```
    languages: [go]
    tags: [best-practices, errors, initialization]
    source: https://google.github.io/styleguide/go/best-practices#program-init
