use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoPackageSize:
    standard: @{GoogleGo}
    ruleId: best-practices/package-size
    title: Size packages and files around cohesive ideas
    statement:
        Keep tightly coupled types, and types clients use together, in one
        package, and give conceptually distinct things their own small
        package. Avoid files of many thousands of lines as well as many tiny
        files; a maintainer should be able to tell which file holds
        something.
    rationale:
        Godoc presents one package per page and package and type names read
        together, so cohesive packages are easier to use.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [go]
    tags: [best-practices, packages, organization]
    source: https://google.github.io/styleguide/go/best-practices#package-size
