use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoIdentifyTheFunction:
    standard: @{GoogleGo}
    ruleId: decisions/identify-the-function
    title: Name the function under test in failure messages
    statement:
        Name the failing function in the failure message, shaped like
        YourFunc(input) = got, want want, instead of printing only the got
        and want values.
    rationale:
        The test name alone does not always make clear which call failed.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        t.Errorf("got %d, want %d", got, want)
        \\\
        ```
    compliant:
        ```go
        \\\
        t.Errorf("Abs(%d) = %d, want %d", in, got, want)
        \\\
        ```
    languages: [go]
    tags: [decisions, testing, test-failures]
    source: https://google.github.io/styleguide/go/decisions#identify-the-function
