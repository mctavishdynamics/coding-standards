use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoLineLength:
    standard: @{GoogleGo}
    ruleId: guide/line-length
    title: Refactor long lines instead of splitting them
    statement:
        Go sets no maximum line length. When a line seems overly long, try
        restructuring the code, and if it cannot reasonably get shorter,
        keep it on one line. Avoid breaking right before a change in
        indentation or in the middle of a long string like a URL.
    rationale:
        Arbitrary wrapping can make code harder to read, blur the boundary
        between a signature and its body, and make long strings hard to
        search.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        const docsURL = "https://example.com/docs/" +
            "reference/billing/invoices"
        \\\
        ```
    compliant:
        ```go
        \\\
        const docsURL = "https://example.com/docs/reference/billing/invoices"
        \\\
        ```
    languages: [go]
    tags: [guide, formatting, line-length]
    source: https://google.github.io/styleguide/go/guide#line-length
