export coding-standard GoogleGo:
    title: Google Go Style Guide
    publisher: Google
    url: https://google.github.io/styleguide/go/
    version: null
    license: Creative Commons Attribution 3.0 (CC BY 3.0)
    description:
        Google's style guidance for readable, idiomatic Go. It has three
        parts, the canonical Style Guide, the normative Style Decisions and
        the advisory Best Practices.
    rules:
        - @{GoogleGoClarityPurpose}
        - @{GoogleGoClarityRationale}
        - @{GoogleGoSimplicity}
        - @{GoogleGoLeastMechanism}
        - @{GoogleGoConcision}
        - @{GoogleGoMaintainability}
        - @{GoogleGoConsistency}
        - @{GoogleGoFormatting}
        - @{GoogleGoMixedCaps}
        - @{GoogleGoLineLength}
        - @{GoogleGoNaming}
        - @{GoogleGoLocalConsistency}
        - @{GoogleGoUnderscores}
        - @{GoogleGoPackageNames}
        - @{GoogleGoReceiverNames}
        - @{GoogleGoConstantNames}
        - @{GoogleGoInitialisms}
        - @{GoogleGoGetters}
        - @{GoogleGoVariableNames}
        - @{GoogleGoSingleLetterVariableNames}
        - @{GoogleGoRepetitiveWithPackage}
        - @{GoogleGoRepetitiveWithType}
        - @{GoogleGoRepetitiveInContext}
        - @{GoogleGoCommentLineLength}
        - @{GoogleGoDocComments}
        - @{GoogleGoCommentSentences}
        - @{GoogleGoExamples}
        - @{GoogleGoNamedResultParameters}
        - @{GoogleGoPackageComments}
        - @{GoogleGoImportRenaming}
        - @{GoogleGoImportGrouping}
        - @{GoogleGoImportBlank}
        - @{GoogleGoImportDot}
        - @{GoogleGoReturningErrors}
        - @{GoogleGoErrorStrings}
        - @{GoogleGoHandleErrors}
        - @{GoogleGoInBandErrors}
        - @{GoogleGoIndentErrorFlow}
        - @{GoogleGoLiteralFormatting}
        - @{GoogleGoLiteralFieldNames}
        - @{GoogleGoLiteralMatchingBraces}
        - @{GoogleGoLiteralCuddledBraces}
        - @{GoogleGoLiteralRepeatedTypeNames}
        - @{GoogleGoLiteralZeroValueFields}
        - @{GoogleGoNilSlices}
        - @{GoogleGoIndentationConfusion}
        - @{GoogleGoFuncFormatting}
        - @{GoogleGoConditionalFormatting}
        - @{GoogleGoCopying}
        - @{GoogleGoDontPanic}
        - @{GoogleGoMustFunctions}
        - @{GoogleGoGoroutineLifetimes}
        - @{GoogleGoInterfaces}
        - @{GoogleGoGenerics}
        - @{GoogleGoPassValues}
        - @{GoogleGoReceiverType}
        - @{GoogleGoSwitchBreak}
        - @{GoogleGoSynchronousFunctions}
        - @{GoogleGoTypeAliases}
        - @{GoogleGoUsePercentQ}
        - @{GoogleGoUseAny}
        - @{GoogleGoFlags}
        - @{GoogleGoLogging}
        - @{GoogleGoContexts}
        - @{GoogleGoCustomContexts}
        - @{GoogleGoCryptoRand}
        - @{GoogleGoUsefulTestFailures}
        - @{GoogleGoAssert}
        - @{GoogleGoIdentifyTheFunction}
        - @{GoogleGoIdentifyTheInput}
        - @{GoogleGoGotBeforeWant}
        - @{GoogleGoCompareFullStructures}
        - @{GoogleGoCompareStableResults}
        - @{GoogleGoKeepGoing}
        - @{GoogleGoTypesOfEquality}
        - @{GoogleGoLevelOfDetail}
        - @{GoogleGoPrintDiffs}
        - @{GoogleGoTestErrorSemantics}
        - @{GoogleGoSubtests}
        - @{GoogleGoSubtestNames}
        - @{GoogleGoTableDrivenTests}
        - @{GoogleGoTableTestsDataDriven}
        - @{GoogleGoTableTestsIdentifyingTheRow}
        - @{GoogleGoMarkTestHelpers}
        - @{GoogleGoTestSamePackage}
        - @{GoogleGoTestDifferentPackage}
