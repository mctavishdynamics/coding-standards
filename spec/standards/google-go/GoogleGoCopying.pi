use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoCopying:
    standard: @{GoogleGo}
    ruleId: decisions/copying
    title: Do not copy values whose methods use pointer receivers
    statement:
        Take care when copying structs that come from other packages. Never
        copy sync.Mutex or other synchronisation types, and avoid copying a
        T value whose methods use a pointer receiver. If you write such a
        type, accept and return it by pointer.
    rationale:
        A copy may share internal buffers with the original, as bytes.Buffer
        does, or defeat a lock, and value receivers make that copying
        invisible at the call site.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        type Registry struct {
            mu    sync.Mutex
            items map[string]Item
        }

        func Snapshot(r Registry) Registry { return r }
        \\\
        ```
    compliant:
        ```go
        \\\
        type Registry struct {
            mu    sync.Mutex
            items map[string]Item
        }

        func Snapshot(r *Registry) map[string]Item { return r.copyItems() }
        \\\
        ```
    languages: [go]
    tags: [decisions, copying, concurrency]
    source: https://google.github.io/styleguide/go/decisions#copying
