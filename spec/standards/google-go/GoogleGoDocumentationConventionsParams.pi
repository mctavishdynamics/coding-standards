use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoDocumentationConventionsParams:
    standard: @{GoogleGo}
    ruleId: best-practices/documentation-conventions-params
    title: Document only the non-obvious parameters
    statement:
        Skip listing each parameter, field or option. Explain the ones that
        are surprising or easy to misuse, with the reason they matter,
        written for the readers you expect.
    rationale:
        Restating what names and types already say adds noise and hides the
        useful notes.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        // Resize resizes img.
        //
        // img is the image and width is the width.
        func Resize(img Image, width int) Image
        \\\
        ```
    compliant:
        ```go
        \\\
        // Resize scales img to the given width, keeping its aspect ratio.
        // A width of zero returns img unchanged.
        func Resize(img Image, width int) Image
        \\\
        ```
    languages: [go]
    tags: [best-practices, documentation, comments]
    source: https://google.github.io/styleguide/go/best-practices#documentation-conventions-params
