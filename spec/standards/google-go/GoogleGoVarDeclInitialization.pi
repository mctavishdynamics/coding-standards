use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoVarDeclInitialization:
    standard: @{GoogleGo}
    ruleId: best-practices/vardeclinitialization
    title: Use := to initialise variables with non-zero values
    statement:
        For consistency, declare a new variable with := rather than var when
        giving it a non-zero value.
    rationale:
        One form for initialised declarations keeps code uniform.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        var limit = 100
        var name string = "default"
        \\\
        ```
    compliant:
        ```go
        \\\
        limit := 100
        name := "default"
        \\\
        ```
    languages: [go]
    tags: [best-practices, variables, declarations]
    source: https://google.github.io/styleguide/go/best-practices#vardeclinitialization
