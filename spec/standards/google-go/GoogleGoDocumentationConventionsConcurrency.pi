use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoDocumentationConventionsConcurrency:
    standard: @{GoogleGo}
    ruleId: best-practices/documentation-conventions-concurrency
    title: Document concurrency safety when it is not obvious
    statement:
        Readers assume read-only operations are safe for concurrent use and
        mutating ones are not. Document concurrency when it is unclear
        whether an operation mutates, when the API provides its own
        synchronisation, or when an interface you consume has concurrency
        requirements.
    rationale:
        Concurrency safety is part of an API's contract.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        // Len returns the number of entries. It is safe to call concurrently.
        func (c *Cache) Len() int
        \\\
        ```
    compliant:
        ```go
        \\\
        // Lookup returns the cached value for key.
        //
        // Lookup updates recency information and is not safe for concurrent use.
        func (c *LRU) Lookup(key string) ([]byte, bool)
        \\\
        ```
    languages: [go]
    tags: [best-practices, documentation, concurrency]
    source: https://google.github.io/styleguide/go/best-practices#documentation-conventions-concurrency
