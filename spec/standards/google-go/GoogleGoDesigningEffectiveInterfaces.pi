use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoDesigningEffectiveInterfaces:
    standard: @{GoogleGo}
    ruleId: best-practices/designing-effective-interfaces
    title: Keep interfaces small, documented and returned rarely
    statement:
        Keep interfaces small, document their contract, edge cases and
        errors in proportion to their complexity, including unexported ones,
        and accept interfaces but return concrete types.
    rationale:
        Small interfaces are easy to implement and compose, and concrete
        results give callers full functionality.
    exceptions:
        Return an interface for encapsulation that protects integrity, such
        as error, when the concrete type is chosen at run time as in factory
        or strategy patterns, or to break an import cycle.
    severity: null
    noncompliant:
        ```go
        \\\
        type Inventory interface {
            Lookup(sku string) (Item, error)
            Reserve(sku string, qty int) error
            Restock(sku string, qty int) error
            Report() Summary
            Shutdown() error
        }

        func OpenInventory(dsn string) Inventory {
            return &sqlInventory{dsn: dsn}
        }
        \\\
        ```
    compliant:
        ```go
        \\\
        // An ItemFinder looks up stock items. Lookup returns ErrUnknownSKU
        // for codes it has never seen. Safe for use from many goroutines.
        type ItemFinder interface {
            Lookup(sku string) (Item, error)
        }

        func OpenInventory(dsn string) *SQLInventory {
            return &SQLInventory{dsn: dsn}
        }
        \\\
        ```
    languages: [go]
    tags: [best-practices, interfaces, documentation]
    source: https://google.github.io/styleguide/go/best-practices#designing-effective-interfaces
