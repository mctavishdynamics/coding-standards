use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoGotBeforeWant:
    standard: @{GoogleGo}
    ruleId: decisions/got-before-want
    title: Print got before want
    statement:
        Show the actual value before the expected value, and use the words
        got and want rather than actual and expected. For diffs, state the
        direction explicitly in the message.
    rationale:
        A consistent order and vocabulary make failures quick to read, and
        diff order varies across code.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        t.Errorf("expected %v, actual %v", want, got)
        \\\
        ```
    compliant:
        ```go
        \\\
        t.Errorf("Split(%q) = %v, want %v", in, got, want)
        \\\
        ```
    languages: [go]
    tags: [decisions, testing, test-failures]
    source: https://google.github.io/styleguide/go/decisions#got-before-want
