use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoMaintainability:
    standard: @{GoogleGo}
    ruleId: guide/maintainability
    title: Write code that is easy to change correctly
    statement:
        Make assumptions explicit, keep important details out of easily
        overlooked places, use predictable names, minimise dependencies,
        structure APIs so they can grow, and back the code with tests that
        give clear failures.
    rationale:
        Over its lifetime a piece of code is changed far more often than it
        is first written. Concealed details and tangled dependencies make
        each of those later edits riskier.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        if user, err = lookup(id); err != nil {
            return err
        }
        \\\
        ```
    compliant:
        ```go
        \\\
        // Assign to the outer user variable; it is used after this block.
        if user, err = lookup(id); err != nil {
            return err
        }
        \\\
        ```
    languages: [go]
    tags: [guide, maintainability, design]
    source: https://google.github.io/styleguide/go/guide#maintainability
