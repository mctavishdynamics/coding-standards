use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoTypesOfEquality:
    standard: @{GoogleGo}
    ruleId: decisions/types-of-equality
    title: Use cmp for equality and diffs, not reflect.DeepEqual
    statement:
        Compare complex values in tests with cmp.Equal and cmp.Diff, adding
        options such as protocmp.Transform where needed. Do not use
        reflect.DeepEqual, and do not use cmp in production code.
    rationale:
        reflect.DeepEqual depends on unexported implementation details,
        while cmp is configurable and stable. cmp may panic on misuse, which
        is unsafe in production.
    exceptions:
        Existing code may keep using older libraries such as pretty for
        consistency.
    severity: null
    noncompliant:
        ```go
        \\\
        if !reflect.DeepEqual(gotCfg, wantCfg) {
            t.Errorf("Parse(%q) = %+v, want %+v", input, gotCfg, wantCfg)
        }
        \\\
        ```
    compliant:
        ```go
        \\\
        opts := cmpopts.IgnoreFields(Config{}, "LoadedAt")
        if d := cmp.Diff(wantCfg, gotCfg, opts); d != "" {
            t.Errorf("Parse(%q) diff (-want +got):\n%s", input, d)
        }
        \\\
        ```
    languages: [go]
    tags: [decisions, testing, comparison]
    source: https://google.github.io/styleguide/go/decisions#types-of-equality
