use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoConcision:
    standard: @{GoogleGo}
    ruleId: guide/concision
    title: Keep a high signal-to-noise ratio
    statement:
        Avoid repetitive code, extraneous syntax, opaque names and needless
        abstraction so the important details stand out. Use common idioms,
        and when code deliberately departs from an idiom, call attention to
        the difference with a comment.
    rationale:
        Near-identical code hides its differences, and a subtle variation on
        a familiar pattern is easy for a reader to miss.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        if err := cache.Warm(ctx); err == nil {
            return err
        }
        \\\
        ```
    compliant:
        ```go
        \\\
        if err := cache.Warm(ctx); err == nil { // if NO error
            return errors.New("cache warmed twice")
        }
        \\\
        ```
    languages: [go]
    tags: [guide, concision, readability]
    source: https://google.github.io/styleguide/go/guide#concision
