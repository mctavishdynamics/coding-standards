use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoMixedCaps:
    standard: @{GoogleGo}
    ruleId: guide/mixed-caps
    title: Use MixedCaps for multi-word names
    statement:
        Write multi-word names in MixedCaps or mixedCaps, never with
        underscores, even where other languages would use snake case or
        upper case constants. Local variables count as unexported.
    rationale:
        Capitalisation of the first letter decides visibility in Go, and one
        naming scheme keeps code uniform.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        const MAX_RETRIES = 3
        var retry_delay = time.Second
        \\\
        ```
    compliant:
        ```go
        \\\
        const MaxRetries = 3
        var retryDelay = time.Second
        \\\
        ```
    languages: [go]
    tags: [guide, naming]
    source: https://google.github.io/styleguide/go/guide#mixed-caps
