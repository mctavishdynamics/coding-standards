use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoDocComments:
    standard: @{GoogleGo}
    ruleId: decisions/doc-comments
    title: Document every exported name
    statement:
        Every exported top-level name needs a doc comment, as do unexported
        types and functions with non-obvious behaviour. Write the comment in
        complete sentences, opening with the documented name, possibly after
        an article.
    rationale:
        Doc comments appear in Godoc and IDEs and are what users of the
        package read. Starting with the name makes later exporting a simple
        rename.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        // returns a cache that holds up to n entries
        func NewCache(n int) *Cache
        \\\
        ```
    compliant:
        ```go
        \\\
        // NewCache returns a cache that holds up to n entries, evicting the
        // least recently used entry when full.
        func NewCache(n int) *Cache
        \\\
        ```
    languages: [go]
    tags: [decisions, comments, documentation]
    source: https://google.github.io/styleguide/go/decisions#doc-comments
