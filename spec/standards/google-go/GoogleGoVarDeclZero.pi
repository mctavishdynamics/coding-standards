use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoVarDeclZero:
    standard: @{GoogleGo}
    ruleId: best-practices/vardeclzero
    title: Declare empty ready-to-use values with var
    statement:
        Declare with var and the zero value when you need an empty value
        that will be filled in later, such as a target for unmarshalling or
        a struct containing a mutex. Protobuf messages and composites that
        are returned or always used by address should be declared as
        pointers, and a map has to be initialised before any write.
    rationale:
        Zero-value declarations say the value starts empty without clunky
        empty literals.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        msg := Message{}
        if err := json.Unmarshal(data, &msg); err != nil {
            return err
        }
        \\\
        ```
    compliant:
        ```go
        \\\
        var msg Message
        if err := json.Unmarshal(data, &msg); err != nil {
            return err
        }
        \\\
        ```
    languages: [go]
    tags: [best-practices, variables, declarations]
    source: https://google.github.io/styleguide/go/best-practices#vardeclzero
