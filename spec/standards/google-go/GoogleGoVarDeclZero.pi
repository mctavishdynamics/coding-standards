use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoVarDeclZero:
    standard: @{GoogleGo}
    ruleId: best-practices/vardeclzero
    title: Declare empty ready-to-use values with var
    statement:
        Use a var declaration with the zero value for an empty value that is
        ready for later use, such as an unmarshal target or a struct holding
        a mutex. Declare protobuf messages and composites that are returned
        or always addressed as pointers, and remember maps must be
        initialised before writing.
    rationale:
        Zero-value declarations say the value starts empty without clunky
        empty literals.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        msg := Message{}
        if err := json.Unmarshal(data, &msg); err != nil {
            return err
        }
        \\\
        ```
    compliant:
        ```go
        \\\
        var msg Message
        if err := json.Unmarshal(data, &msg); err != nil {
            return err
        }
        \\\
        ```
    languages: [go]
    tags: [best-practices, variables, declarations]
    source: https://google.github.io/styleguide/go/best-practices#vardeclzero
