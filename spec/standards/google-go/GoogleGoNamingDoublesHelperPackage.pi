use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoNamingDoublesHelperPackage:
    standard: @{GoogleGo}
    ruleId: best-practices/naming-doubles-helper-package
    title: Name a test double package by appending test
    statement:
        Put test doubles for a package in a new package named after the
        production package with test appended, such as creditcardtest.
    rationale:
        The suffix is a safe, conventional choice that tells readers what
        the package is for.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        package creditcardmocks
        \\\
        ```
    compliant:
        ```go
        \\\
        // Package creditcardtest provides test doubles for package creditcard.
        package creditcardtest
        \\\
        ```
    languages: [go]
    tags: [best-practices, naming, testing, test-doubles]
    source: https://google.github.io/styleguide/go/best-practices#naming-doubles-helper-package
