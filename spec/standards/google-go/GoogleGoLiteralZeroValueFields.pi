use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoLiteralZeroValueFields:
    standard: @{GoogleGo}
    ruleId: decisions/literal-zero-value-fields
    title: Omit zero-value fields from struct literals
    statement:
        Omit fields holding the zero value from a struct literal as long as
        the meaning stays clear. In test tables, drop fields that do not
        matter to a case, but spell them out when the case depends on their
        zero value.
    rationale:
        Omitting zero fields draws attention to the options that are
        actually set.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        opts := DialOptions{
            Timeout:   10 * time.Second,
            Retries:   0,
            Proxy:     "",
            KeepAlive: false,
        }
        \\\
        ```
    compliant:
        ```go
        \\\
        opts := DialOptions{
            Timeout: 10 * time.Second,
        }
        \\\
        ```
    languages: [go]
    tags: [decisions, literals, structs]
    source: https://google.github.io/styleguide/go/decisions#literal-zero-value-fields
