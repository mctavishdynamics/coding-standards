use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoNaming:
    standard: @{GoogleGo}
    ruleId: guide/naming
    title: Choose names that fit their context without repetition
    statement:
        Choose names with their context in mind, so they read without
        redundancy at the call site and do not restate what the surroundings
        already make plain.
    rationale:
        Go names are read together with their package, type and scope, so
        the context already supplies much of the meaning.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        package invoice

        func ProcessInvoiceItems(invoiceItemList []InvoiceItem) error
        \\\
        ```
    compliant:
        ```go
        \\\
        package invoice

        func ProcessItems(items []Item) error
        \\\
        ```
    languages: [go]
    tags: [guide, naming]
    source: https://google.github.io/styleguide/go/guide#naming
