use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoSynchronousFunctions:
    standard: @{GoogleGo}
    ruleId: decisions/synchronous-functions
    title: Prefer synchronous functions
    statement:
        Write functions that return their results directly and finish any
        callbacks or channel work before returning. Let the caller add
        concurrency by calling the function in a goroutine if needed.
    rationale:
        Synchronous functions keep goroutines local, avoid leaks and races,
        and are easy to test. Removing unneeded concurrency at the call site
        is hard.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        func Resize(img Image, done chan<- Image) {
            go func() { done <- scale(img) }()
        }
        \\\
        ```
    compliant:
        ```go
        \\\
        func Resize(img Image) Image {
            return scale(img)
        }
        \\\
        ```
    languages: [go]
    tags: [decisions, concurrency, functions]
    source: https://google.github.io/styleguide/go/decisions#synchronous-functions
