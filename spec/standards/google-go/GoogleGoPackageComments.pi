use ../lib/CodingRule

from ./GoogleGo import GoogleGo

export coding-rule GoogleGoPackageComments:
    standard: @{GoogleGo}
    ruleId: decisions/package-comments
    title: Write one package comment directly above the package clause
    statement:
        Write one package comment per package, directly over the package
        clause with nothing in between. In a main package it opens with the
        binary's name as the build rule spells it. A lengthy comment can
        live in its own doc.go file.
    rationale:
        Godoc shows only a comment attached to the package clause, and
        several package comments conflict.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        // Package ratelimit provides token bucket rate limiters.

        package ratelimit
        \\\
        ```
    compliant:
        ```go
        \\\
        // Package ratelimit provides token bucket rate limiters.
        package ratelimit
        \\\
        ```
    languages: [go]
    tags: [decisions, comments, documentation, packages]
    source: https://google.github.io/styleguide/go/decisions#package-comments
