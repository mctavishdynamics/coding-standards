use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCApi00C:
    standard: @{CertC}
    ruleId: API00-C
    title: Functions should validate their parameters
    statement:
        Decide which side of each interface validates arguments, and for
        library and other externally callable functions, check the
        parameters in the callee. Report invalid arguments through the
        function's normal error mechanism.
    rationale:
        A function that trusts its arguments can be driven into an access
        violation or data corruption by a careless or malicious caller, and
        the library then becomes the vector for the caller's bug. CERT rates
        likelihood unlikely, detectable no, repairable no, priority P2,
        level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        int set_name(struct user *u, const char *name) {
            strcpy(u->name, name);
            return 0;
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        int set_name(struct user *u, const char *name) {
            if (u == NULL || name == NULL || strlen(name) >= sizeof u->name) {
                return EINVAL;
            }
            strcpy(u->name, name);
            return 0;
        }
        \\\
        ```
    languages: [c]
    tags: [recommendation, api-design, input-validation]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/recommendations/application-programming-interfaces-api/api00-c
