use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCStr09C:
    standard: @{CertC}
    ruleId: STR09-C
    title:
        Don't assume numeric values for expressions with type plain
        character
    statement:
        Use only assignment, equality and address-of on plain character
        values. The one guarantee is that the digits 0 to 9 are consecutive,
        so digit arithmetic relative to the zero character is allowed.
    rationale:
        Only the digits are guaranteed to have consecutive codes, so
        arithmetic on letters breaks on character sets such as EBCDIC. CERT
        rates likelihood unlikely, detectable yes, repairable no, priority
        P2, level L3.
    exceptions:
        Consecutive letter values may be assumed on platforms known to use
        ASCII or Unicode.
    severity: low
    noncompliant:
        ```c
        \\\
        int is_lower(char c) {
            return c >= 'a' && c <= 'z';
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        #include <ctype.h>

        int is_lower(char c) {
            return islower((unsigned char)c);
        }
        \\\
        ```
    languages: [c]
    tags: [recommendation, strings, characters, portability]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/recommendations/characters-and-strings-str/str09-c
