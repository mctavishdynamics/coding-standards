use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCStr06C:
    standard: @{CertC}
    ruleId: STR06-C
    title:
        Do not assume that strtok() leaves the parse string unchanged
    statement:
        Remember that strtok writes null characters into the string it
        parses. Pass it a copy when the original must be kept.
    rationale:
        Code that reuses the original string after tokenizing sees it cut
        short at the first delimiter. CERT rates likelihood likely,
        detectable no, repairable no, priority P6, level L2.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        char *field = strtok(line, ",");
        while (field != NULL) {
            field = strtok(NULL, ",");
        }
        log_line(line);   /* only the first field remains */
        \\\
        ```
    compliant:
        ```c
        \\\
        char *copy = strdup(line);
        if (copy != NULL) {
            for (char *f = strtok(copy, ","); f != NULL; f = strtok(NULL, ",")) {
                handle(f);
            }
            free(copy);
        }
        log_line(line);
        \\\
        ```
    languages: [c]
    tags: [recommendation, strings, library]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/recommendations/characters-and-strings-str/str06-c
