use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCMsc01C:
    standard: @{CertC}
    ruleId: MSC01-C
    title: Strive for logical completeness
    statement:
        Make sure every chain of if and else if ends with a final else, and
        every switch has a default label, so that unexpected values are
        handled on purpose.
    rationale:
        Values the programmer did not consider fall through silently and
        leave the program in an unintended state. CERT rates likelihood
        probable, detectable no, repairable no, priority P4, level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        if (mode == MODE_READ) {
            open_read();
        } else if (mode == MODE_WRITE) {
            open_write();
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        if (mode == MODE_READ) {
            open_read();
        } else if (mode == MODE_WRITE) {
            open_write();
        } else {
            report_bad_mode(mode);
        }
        \\\
        ```
    languages: [c]
    tags: [recommendation, control-flow, defensive-programming]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/recommendations/miscellaneous-msc/msc01-c
