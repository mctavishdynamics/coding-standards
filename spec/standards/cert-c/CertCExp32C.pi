use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCExp32C:
    standard: @{CertC}
    ruleId: EXP32-C
    title:
        Do not access a volatile object through a nonvolatile reference
    statement:
        Access an object defined as volatile only through volatile-qualified
        lvalues. Do not cast the qualifier away or keep a plain pointer to
        it.
    rationale:
        Undefined behavior results when a volatile object is accessed
        through an lvalue lacking the volatile qualifier, and the compiler
        is then free to cache or remove those accesses. CERT rates
        likelihood likely, detectable no, repairable yes, priority P6, level
        L2.
    exceptions: null
    severity: low
    noncompliant:
        ```c
        \\\
        volatile int ready;

        void wait_ready(void) {
            int *p = (int *)&ready;
            while (!*p) {
            }
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        volatile int ready;

        void wait_ready(void) {
            volatile int *p = &ready;
            while (!*p) {
            }
        }
        \\\
        ```
    languages: [c]
    tags: [expressions, volatile, qualifiers]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/rules/expressions-exp/exp32-c
