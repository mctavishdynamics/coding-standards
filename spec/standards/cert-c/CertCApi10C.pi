use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCApi10C:
    standard: @{CertC}
    ruleId: API10-C
    title: APIs should have security options enabled by default
    statement:
        Design an interface so that its default configuration is the secure
        one, for example with certificate checking on and only strong cipher
        suites enabled. Make callers opt in explicitly to weaker behavior.
    rationale:
        Many callers never change defaults, so an insecure default becomes
        an insecure deployment. CERT rates likelihood likely, detectable no,
        repairable no, priority P6, level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        struct tls_options {
            int verify_peer;      /* 0 by default: no verification */
            int allow_legacy;     /* 0 by default */
        };
        \\\
        ```
    compliant:
        ```c
        \\\
        struct tls_options {
            int skip_peer_verification;   /* 0 by default: verification on */
            int allow_legacy;             /* 0 by default */
        };
        \\\
        ```
    languages: [c]
    tags: [recommendation, api-design, secure-defaults]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/recommendations/application-programming-interfaces-api/api10-c
