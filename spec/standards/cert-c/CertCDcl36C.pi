use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCDcl36C:
    standard: @{CertC}
    ruleId: DCL36-C
    title:
        Do not declare an identifier with conflicting linkage
        classifications
    statement:
        Do not declare the same identifier in one translation unit with both
        internal and external linkage. Keep every declaration of a name
        consistently static or consistently extern.
    rationale:
        Declaring an identifier with both linkages is undefined behavior,
        and the linker may bind uses to different objects than intended.
        CERT rates likelihood probable, detectable yes, repairable no,
        priority P8, level L2.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        int count = 0;
        static int count;

        int next(void) {
            return ++count;
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        static int count = 0;

        int next(void) {
            return ++count;
        }
        \\\
        ```
    languages: [c]
    tags: [declarations, linkage]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/rules/declarations-and-initialization-dcl/dcl36-c
