use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCFio09C:
    standard: @{CertC}
    ruleId: FIO09-C
    title:
        Be careful with binary data when transferring data across systems
    statement:
        Do not write raw integers, floats or structures with fwrite and
        expect another system to read them back with fread. Define an
        explicit external format, such as text or a fixed byte order and
        width, and convert to and from it.
    rationale:
        Systems differ in byte order, structure padding, type sizes and
        floating-point formats, so raw binary data can be misread silently
        on the receiving side. CERT rates likelihood probable, detectable
        no, repairable no, priority P4, level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        struct record {
            int id;
            long balance;
        };

        int send_record(FILE *out, const struct record *r) {
            return fwrite(r, sizeof *r, 1, out) == 1 ? 0 : -1;
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        struct record {
            int id;
            long balance;
        };

        int send_record(FILE *out, const struct record *r) {
            return fprintf(out, "%d %ld\n", r->id, r->balance) < 0 ? -1 : 0;
        }
        \\\
        ```
    languages: [c]
    tags: [recommendation, io, portability, serialization]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/recommendations/input-output-fio/fio09-c
