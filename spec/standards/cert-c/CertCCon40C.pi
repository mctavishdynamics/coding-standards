use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCCon40C:
    standard: @{CertC}
    ruleId: CON40-C
    title: Do not refer to an atomic variable twice in an expression
    statement:
        Do not read and write the same atomic variable in one expression,
        such as x = x + n or flag = !flag. Use one atomic operation, such as
        atomic_fetch_add, or a compare-and-exchange loop.
    rationale:
        Each reference is a separate atomic access, so another thread can
        change the value between them and the update is lost. CERT rates
        likelihood probable, detectable yes, repairable no, priority P8,
        level L2.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        static atomic_long bytes_sent;

        void account(long n) {
            bytes_sent = bytes_sent + n;
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        static atomic_long bytes_sent;

        void account(long n) {
            atomic_fetch_add(&bytes_sent, n);
        }
        \\\
        ```
    languages: [c]
    tags: [concurrency, atomics, data-races]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/rules/concurrency-con/con40-c
