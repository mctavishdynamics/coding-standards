use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCStr01C:
    standard: @{CertC}
    ruleId: STR01-C
    title: Adopt and implement a consistent plan for managing strings
    statement:
        Pick one approach to managing strings across a project, either
        fixed-size static buffers or dynamic allocation, and apply it
        consistently.
    rationale:
        Mixing approaches leaves each programmer to guess the rules, which
        leads to truncation, overflow and leaks at the boundaries between
        them. CERT rates likelihood unlikely, detectable no, repairable no,
        priority P1, level L3.
    exceptions: null
    severity: low
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [recommendation, strings, memory, design]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/recommendations/characters-and-strings-str/str01-c
