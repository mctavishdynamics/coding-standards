use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCInt33C:
    standard: @{CertC}
    ruleId: INT33-C
    title:
        Ensure that division and remainder operations do not result in
        divide-by-zero errors
    statement:
        Check that the divisor is not zero before every integer division or
        remainder operation.
    rationale:
        Division or remainder by zero is undefined behavior and usually
        terminates the program, which an attacker can use for denial of
        service. CERT rates likelihood likely, detectable no, repairable
        yes, priority P6, level L2.
    exceptions: null
    severity: low
    noncompliant:
        ```c
        \\\
        int average(int total, int count) {
            return total / count;
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        int average(int total, int count, int *out) {
            if (count == 0) {
                return -1;
            }
            *out = total / count;
            return 0;
        }
        \\\
        ```
    languages: [c]
    tags: [integers, division]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/rules/integers-int/int33-c
