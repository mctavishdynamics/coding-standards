use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCPos01C:
    standard: @{CertC}
    ruleId: POS01-C
    title: Check for the existence of links when dealing with files
    statement:
        When opening a file whose path others could influence, make sure it
        is not a symbolic or hard link to something else. Open with
        O_NOFOLLOW where available, or compare lstat with fstat on the open
        descriptor and check the link count.
    rationale:
        A link lets an attacker redirect the program to a file of their
        choice, such as a system file the program has privileges to change.
        CERT rates likelihood likely, detectable no, repairable no, priority
        P6, level L2.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        int fd = open("/var/app/upload.dat", O_WRONLY | O_TRUNC);
        \\\
        ```
    compliant:
        ```c
        \\\
        int fd = open("/var/app/upload.dat", O_WRONLY | O_TRUNC | O_NOFOLLOW);
        struct stat st;
        if (fd != -1 && (fstat(fd, &st) == -1 || st.st_nlink > 1)) {
            close(fd);
            fd = -1;
        }
        \\\
        ```
    languages: [c]
    tags: [recommendation, posix, files, links]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/recommendations/posix-pos/pos01-c
