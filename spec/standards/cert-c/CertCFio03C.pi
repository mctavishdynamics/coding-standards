use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCFio03C:
    standard: @{CertC}
    ruleId: FIO03-C
    title: Do not make assumptions about fopen() and file creation
    statement:
        When a program means to create a new file, say so explicitly and
        fail if the file already exists. Use the C11 "x" mode flag, POSIX
        open with O_CREAT and O_EXCL, or the Windows CREATE_NEW disposition.
    rationale:
        Plain fopen with "w" silently truncates an existing file or follows
        a link planted by an attacker, so the program can overwrite or read
        a file it never meant to touch. CERT rates likelihood probable,
        detectable no, repairable no, priority P4, level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        FILE *create_lock_file(const char *path) {
            return fopen(path, "w");
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        FILE *create_lock_file(const char *path) {
            FILE *f = fopen(path, "wx");
            if (f == NULL) {
                perror("lock file already exists or cannot be created");
            }
            return f;
        }
        \\\
        ```
    languages: [c]
    tags: [recommendation, io, files, race-conditions]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/recommendations/input-output-fio/fio03-c
