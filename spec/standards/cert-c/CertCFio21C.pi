use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCFio21C:
    standard: @{CertC}
    ruleId: FIO21-C
    title: Do not create temporary files in shared directories
    statement:
        Create temporary files in a directory only the program's user can
        write to. When a shared directory cannot be avoided, use a function
        that makes a unique, unpredictable name and opens it exclusively,
        such as POSIX mkstemp, and remove the file before the program ends.
    rationale:
        Other users of a shared directory such as /tmp can guess names and
        plant files or links ahead of time, leading to data theft, tampering
        or denial of service. CERT rates likelihood probable, detectable no,
        repairable no, priority P4, level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        char name[L_tmpnam];
        if (tmpnam(name) != NULL) {
            FILE *f = fopen(name, "w");
            /* ... */
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        char name[] = "/home/app/tmp/job-XXXXXX";
        int fd = mkstemp(name);
        if (fd != -1) {
            unlink(name);
            /* use fd, then close it */
            close(fd);
        }
        \\\
        ```
    languages: [c]
    tags: [recommendation, io, files, race-conditions]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/recommendations/input-output-fio/fio21-c
