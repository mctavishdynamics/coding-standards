use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCInt30C:
    standard: @{CertC}
    ruleId: INT30-C
    title: Ensure that unsigned integer operations do not wrap
    statement:
        Check before an unsigned addition, subtraction, multiplication, left
        shift or negation that the result fits, especially when operands
        come from untrusted input or feed a size, index or allocation.
    rationale:
        Unsigned arithmetic silently wraps modulo 2 to the N. A wrapped size
        leads to undersized buffers and out-of-bounds writes. CERT rates
        likelihood likely, detectable no, repairable no, priority P9, level
        L2.
    exceptions:
        Wrapping is allowed where the program needs modulo behavior, ideally
        with a comment saying so. Checks can be skipped when wrapping is
        impossible at compile time, such as operations on constants.
        Unsigned left shift may wrap.
    severity: high
    noncompliant:
        ```c
        \\\
        #include <stdlib.h>

        void *alloc_items(size_t count, size_t size) {
            return malloc(count * size);
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        #include <stdint.h>
        #include <stdlib.h>

        void *alloc_items(size_t count, size_t size) {
            if (size != 0 && count > SIZE_MAX / size) {
                return NULL;
            }
            return malloc(count * size);
        }
        \\\
        ```
    languages: [c]
    tags: [integers, overflow, unsigned]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/rules/integers-int/int30-c
