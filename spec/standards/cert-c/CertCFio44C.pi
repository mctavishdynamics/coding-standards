use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCFio44C:
    standard: @{CertC}
    ruleId: FIO44-C
    title:
        Only use values for fsetpos() that are returned from fgetpos()
    statement:
        Pass fsetpos only an fpos_t that an earlier successful fgetpos call
        filled in for a stream on the same file. Do not build or zero an
        fpos_t by hand.
    rationale:
        Any other value is undefined behavior, because fpos_t may hold
        conversion state as well as an offset. CERT rates likelihood
        unlikely, detectable no, repairable no, priority P2, level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        int rewind_stream(FILE *f) {
            fpos_t start;
            memset(&start, 0, sizeof start);
            return fsetpos(f, &start);
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        int process_twice(FILE *f) {
            fpos_t start;
            if (fgetpos(f, &start) != 0) {
                return -1;
            }
            process(f);
            return fsetpos(f, &start);
        }
        \\\
        ```
    languages: [c]
    tags: [io, files]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/rules/input-output-fio/fio44-c
