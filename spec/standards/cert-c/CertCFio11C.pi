use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCFio11C:
    standard: @{CertC}
    ruleId: FIO11-C
    title: Take care when specifying the mode parameter of fopen()
    statement:
        Pass fopen and fopen_s one of the mode strings the C standard
        defines, such as "r", "wb", "a+" or "wx". Do not rely on extra or
        reordered characters that only some libraries accept.
    rationale:
        A mode string outside the standard list has undefined behavior, so
        the file may open in an unexpected mode or the call may fail on
        another implementation. CERT rates likelihood probable, detectable
        no, repairable no, priority P4, level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        FILE *open_config(const char *path) {
            return fopen(path, "rw");
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        FILE *open_config(const char *path) {
            return fopen(path, "r+");
        }
        \\\
        ```
    languages: [c]
    tags: [recommendation, io, files, portability]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/recommendations/input-output-fio/fio11-c
