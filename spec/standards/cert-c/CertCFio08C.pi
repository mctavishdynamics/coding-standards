use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCFio08C:
    standard: @{CertC}
    ruleId: FIO08-C
    title: Take care when calling remove() on an open file
    statement:
        Do not call remove on a file that is still open in portable code.
        Close it first, or, when the program wants an open file to have no
        name, use a function with defined semantics such as POSIX unlink.
    rationale:
        What remove does to an open file is implementation-defined. Some
        systems fail, others delete the name, so code that depends on either
        outcome is not portable. CERT rates likelihood probable, detectable
        no, repairable no, priority P4, level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        FILE *f = fopen(scratch_path, "w+");
        if (f != NULL) {
            remove(scratch_path);
            fputs("work data\n", f);
            fclose(f);
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        FILE *f = fopen(scratch_path, "w+");
        if (f != NULL) {
            fputs("work data\n", f);
            if (fclose(f) == 0) {
                remove(scratch_path);
            }
        }
        \\\
        ```
    languages: [c]
    tags: [recommendation, io, files, portability]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/recommendations/input-output-fio/fio08-c
