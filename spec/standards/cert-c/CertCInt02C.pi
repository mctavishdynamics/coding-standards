use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCInt02C:
    standard: @{CertC}
    ruleId: INT02-C
    title: Understand integer conversion rules
    statement:
        Learn the integer promotions, conversion ranks and usual arithmetic
        conversions, and keep them in mind when mixing types, especially
        signed and unsigned operands.
    rationale:
        Implicit conversions can change a value, for example turning a
        negative int into a large unsigned value, which leads to wrong
        comparisons and lost data. CERT rates likelihood probable,
        detectable no, repairable no, priority P4, level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        int delta = -1;
        unsigned int limit = 10;

        if (delta < limit) {   /* false: delta converts to UINT_MAX */
            adjust();
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        int delta = -1;
        unsigned int limit = 10;

        if (delta < 0 || (unsigned int)delta < limit) {
            adjust();
        }
        \\\
        ```
    languages: [c]
    tags: [recommendation, integers, conversions]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/recommendations/integers-int/int02-c
