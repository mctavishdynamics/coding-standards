use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCExp37C:
    standard: @{CertC}
    ruleId: EXP37-C
    title:
        Call functions with the correct number and type of arguments
    statement:
        Call every function through a declaration whose type matches its
        definition, and pass the number and types of arguments it expects.
        Do not call through a function pointer of a different type.
    rationale:
        A call through an incompatible type is undefined behavior. Arguments
        land in the wrong registers or stack slots, and some mismatches only
        produce warnings. CERT rates likelihood probable, detectable no,
        repairable no, priority P4, level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        #include <stdlib.h>

        typedef void (*handler)(int);

        void release(void *p) { free(p); }

        void run(void) {
            handler h = (handler)release;
            h(42);
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        #include <stdlib.h>

        typedef void (*handler)(void *);

        void release(void *p) { free(p); }

        void run(void *p) {
            handler h = release;
            h(p);
        }
        \\\
        ```
    languages: [c]
    tags: [functions, types]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/rules/expressions-exp/exp37-c
