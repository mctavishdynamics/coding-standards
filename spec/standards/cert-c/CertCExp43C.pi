use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCExp43C:
    standard: @{CertC}
    ruleId: EXP43-C
    title:
        Avoid undefined behavior when using restrict-qualified pointers
    statement:
        Do not pass overlapping objects to restrict-qualified parameters,
        such as those of memcpy, strcpy or sprintf, and do not assign one
        restrict pointer to another in the same block. Use memmove or
        separate buffers when regions can overlap.
    rationale:
        restrict promises the compiler that the object is reached only
        through that pointer. Breaking the promise is undefined behavior and
        lets the optimizer produce wrong results. CERT rates likelihood
        probable, detectable no, repairable no, priority P4, level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        #include <string.h>

        void drop_first(char *s) {
            memcpy(s, s + 1, strlen(s));
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        #include <string.h>

        void drop_first(char *s) {
            memmove(s, s + 1, strlen(s));
        }
        \\\
        ```
    languages: [c]
    tags: [pointers, restrict, aliasing]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/rules/expressions-exp/exp43-c
