use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCFlp30C:
    standard: @{CertC}
    ruleId: FLP30-C
    title: Do not use floating-point variables as loop counters
    statement:
        Use an integer as the loop counter and compute any floating-point
        value from it inside the loop.
    rationale:
        Floating-point values cannot represent many decimal fractions
        exactly, so the number of iterations can differ from what the code
        suggests and between platforms. CERT rates likelihood probable,
        detectable yes, repairable yes, priority P6, level L2.
    exceptions: null
    severity: low
    noncompliant:
        ```c
        \\\
        double total_dose(double rate) {
            double sum = 0.0;
            for (double t = 0.0; t != 2.0; t += 0.2) {
                sum += rate * t;
            }
            return sum;
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        double total_dose(double rate) {
            double sum = 0.0;
            for (int step = 0; step < 10; step++) {
                sum += rate * (step * 0.2);
            }
            return sum;
        }
        \\\
        ```
    languages: [c]
    tags: [floating-point, loops]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/rules/floating-point-flp/flp30-c
