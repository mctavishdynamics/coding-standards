use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCCon07C:
    standard: @{CertC}
    ruleId: CON07-C
    title:
        Ensure that compound operations on shared variables are atomic
    statement:
        Perform increments, decrements and compound assignments on shared
        variables atomically, either with atomic types and their operations
        or under a lock.
    rationale:
        An operation such as count++ is a read, a change and a write, so
        threads that interleave those steps lose updates. CERT rates
        likelihood probable, detectable yes, repairable no, priority P8,
        level L2.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        static int active_users;

        void on_login(void) {
            active_users++;
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        static atomic_int active_users;

        void on_login(void) {
            atomic_fetch_add(&active_users, 1);
        }
        \\\
        ```
    languages: [c]
    tags: [recommendation, concurrency, atomics]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/recommendations/concurrency-con/con07-c
