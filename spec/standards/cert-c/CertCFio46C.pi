use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCFio46C:
    standard: @{CertC}
    ruleId: FIO46-C
    title: Do not access a closed file
    statement:
        Do not use a FILE pointer after its stream has been closed. If the
        program closes stdout, stderr or stdin, also avoid functions that
        use them implicitly, such as printf, perror and getchar.
    rationale:
        Using a closed stream is undefined behavior and can write into a
        different file that has reused the resources. CERT rates likelihood
        unlikely, detectable no, repairable no, priority P2, level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        int main(void) {
            if (fclose(stdout) == EOF) {
                return 1;
            }
            printf("done\n");
            return 0;
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        int main(void) {
            printf("done\n");
            if (fclose(stdout) == EOF) {
                return 1;
            }
            return 0;
        }
        \\\
        ```
    languages: [c]
    tags: [io, files, lifetime]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/rules/input-output-fio/fio46-c
