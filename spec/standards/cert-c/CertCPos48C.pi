use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCPos48C:
    standard: @{CertC}
    ruleId: POS48-C
    title: Do not unlock or destroy another POSIX thread's mutex
    statement:
        Only the thread that locked a mutex may unlock it, and destroy a
        mutex only when no thread holds it.
    rationale:
        Unlocking another thread's mutex or destroying one in use lets
        threads enter the critical section together and is undefined
        behavior. CERT rates likelihood probable, detectable no, repairable
        no, priority P4, level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        void *reaper(void *arg) {
            pthread_mutex_unlock(&cache_lock);
            pthread_mutex_destroy(&cache_lock);
            return NULL;
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        void *reaper(void *arg) {
            pthread_mutex_lock(&cache_lock);
            evict_stale_entries();
            pthread_mutex_unlock(&cache_lock);
            return NULL;
        }
        \\\
        ```
    languages: [c]
    tags: [posix, concurrency, locking]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/rules/posix-pos/pos48-c
