use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCStr00C:
    standard: @{CertC}
    ruleId: STR00-C
    title: Represent characters using an appropriate type
    statement:
        Use char for narrow strings and characters, unsigned char when
        inspecting bytes, wchar_t for wide characters, and int for values
        returned by character I/O functions.
    rationale:
        The wrong character type causes sign-extension errors, compatibility
        warnings with library functions and confusion between characters and
        EOF. CERT rates likelihood probable, detectable no, repairable no,
        priority P4, level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        unsigned char name[32];
        size_t n = strlen(name);   /* incompatible pointer type */
        \\\
        ```
    compliant:
        ```c
        \\\
        char name[32];
        size_t n = strlen(name);
        \\\
        ```
    languages: [c]
    tags: [recommendation, strings, characters, types]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/recommendations/characters-and-strings-str/str00-c
