use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCInt05C:
    standard: @{CertC}
    ruleId: INT05-C
    title:
        Do not use input functions to convert character data if they cannot
        handle all possible inputs
    statement:
        Do not convert input text to integers with functions like scanf when
        they cannot report every bad input. Read the text as a string and
        convert it with strtol or a related function, checking for errors.
    rationale:
        scanf with %d has undefined behavior on overflow and gives poor
        diagnostics, so invalid input may yield arbitrary values. CERT rates
        likelihood probable, detectable yes, repairable no, priority P8,
        level L2.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        long port;
        if (scanf("%ld", &port) != 1) {
            return -1;
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        char text[32];
        char *end;

        if (fgets(text, sizeof(text), stdin) == NULL) {
            return -1;
        }
        errno = 0;
        long port = strtol(text, &end, 10);
        if (errno == ERANGE || end == text) {
            return -1;
        }
        \\\
        ```
    languages: [c]
    tags: [recommendation, integers, input-validation]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/recommendations/integers-int/int05-c
