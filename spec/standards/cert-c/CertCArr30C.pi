use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCArr30C:
    standard: @{CertC}
    ruleId: ARR30-C
    title:
        Do not form or use out-of-bounds pointers or array subscripts
    statement:
        Check every index and pointer offset against the array bounds before
        using it. A pointer may point one past the last element but must not
        be dereferenced there or move further.
    rationale:
        Forming or using an out-of-bounds pointer or subscript is undefined
        behavior and the classic cause of buffer overflows. CERT rates
        likelihood likely, detectable no, repairable no, priority P9, level
        L2.
    exceptions: null
    severity: high
    noncompliant:
        ```c
        \\\
        enum { TABLE_SIZE = 100 };
        static int table[TABLE_SIZE];

        int *entry(int index) {
            if (index < TABLE_SIZE) {
                return table + index;
            }
            return 0;
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        #include <stddef.h>

        enum { TABLE_SIZE = 100 };
        static int table[TABLE_SIZE];

        int *entry(size_t index) {
            if (index < TABLE_SIZE) {
                return table + index;
            }
            return NULL;
        }
        \\\
        ```
    languages: [c]
    tags: [arrays, bounds, memory]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/rules/arrays-arr/arr30-c
