use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCCon39C:
    standard: @{CertC}
    ruleId: CON39-C
    title:
        Do not join or detach a thread that was previously joined or
        detached
    statement:
        Join or detach each thread exactly once. Never join a detached
        thread, and never detach or join a thread a second time.
    rationale:
        Joining or detaching a thread that was already joined or detached is
        undefined behavior. CERT rates likelihood likely, detectable no,
        repairable no, priority P3, level L3.
    exceptions: null
    severity: low
    noncompliant:
        ```c
        \\\
        thrd_t t;
        if (thrd_create(&t, worker, NULL) == thrd_success) {
            thrd_detach(t);
            thrd_join(t, NULL);
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        thrd_t t;
        if (thrd_create(&t, worker, NULL) == thrd_success) {
            thrd_join(t, NULL);
        }
        \\\
        ```
    languages: [c]
    tags: [concurrency, threads]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/rules/concurrency-con/con39-c
