use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCFlp00C:
    standard: @{CertC}
    ruleId: FLP00-C
    title: Understand the limitations of floating-point numbers
    statement:
        Treat floating-point values as approximations with limited precision
        and range. Do not expect exact results or exact equality from
        floating-point arithmetic.
    rationale:
        Most decimal fractions cannot be represented exactly in binary, and
        every operation may round, so tests written as if the math were
        exact give wrong answers. CERT rates likelihood probable, detectable
        no, repairable no, priority P4, level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        double total = 0.0;
        for (int i = 0; i < 10; i++) {
            total += 0.1;
        }
        if (total == 1.0) {   /* false */
            finish();
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        #include <math.h>

        double total = 0.0;
        for (int i = 0; i < 10; i++) {
            total += 0.1;
        }
        if (fabs(total - 1.0) < 1e-9) {
            finish();
        }
        \\\
        ```
    languages: [c]
    tags: [recommendation, floating-point, precision]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/recommendations/floating-point-flp/flp00-c
