use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCMsc23C:
    standard: @{CertC}
    ruleId: MSC23-C
    title: Beware of vendor-specific library and language differences
    statement:
        Read the compiler and library documentation and learn where the
        vendor departs from the C standard. Avoid relying on those
        differences, or isolate the code that does.
    rationale:
        Vendors differ in conformance, so code that seems correct on one
        toolchain may behave differently or insecurely on another. CERT
        rates likelihood probable, detectable no, repairable no, priority
        P6, level L3.
    exceptions: null
    severity: high
    noncompliant:
        ```c
        \\\
        /* MSVC's _snprintf does not null-terminate on truncation. */
        char buf[16];
        _snprintf(buf, sizeof buf, "%s", name);
        \\\
        ```
    compliant:
        ```c
        \\\
        char buf[16];
        int n = snprintf(buf, sizeof buf, "%s", name);
        if (n < 0 || (size_t)n >= sizeof buf) {
            /* handle truncation */
        }
        \\\
        ```
    languages: [c]
    tags: [recommendation, portability, compilers]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/recommendations/miscellaneous-msc/msc23-c
