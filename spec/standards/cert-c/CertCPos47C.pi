use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCPos47C:
    standard: @{CertC}
    ruleId: POS47-C
    title: Do not use threads that can be canceled asynchronously
    statement:
        Leave threads in the deferred cancellation type. Do not set
        PTHREAD_CANCEL_ASYNCHRONOUS.
    rationale:
        Asynchronous cancellation can stop a thread in the middle of any
        operation, leaving locks held and shared data inconsistent; only
        cancel-safe functions may run in such a thread. CERT rates
        likelihood probable, detectable no, repairable no, priority P4,
        level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        void *worker(void *arg) {
            pthread_setcanceltype(PTHREAD_CANCEL_ASYNCHRONOUS, NULL);
            update_shared_table(arg);
            return NULL;
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        void *worker(void *arg) {
            pthread_setcanceltype(PTHREAD_CANCEL_DEFERRED, NULL);
            update_shared_table(arg);
            return NULL;
        }
        \\\
        ```
    languages: [c]
    tags: [posix, concurrency, threads]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/rules/posix-pos/pos47-c
