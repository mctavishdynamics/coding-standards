use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCApi03C:
    standard: @{CertC}
    ruleId: API03-C
    title:
        Create consistent interfaces and capabilities across related
        functions
    statement:
        Give related functions, such as those in one library, the same
        argument order, naming, error reporting and behavior. A caller who
        learns one function should be able to predict how the others work.
    rationale:
        Inconsistent interfaces are easy to misuse, for example by passing
        arguments in the wrong order, which leads to subtle bugs. CERT rates
        likelihood unlikely, detectable no, repairable no, priority P2,
        level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        int list_add(struct list *l, const void *item);
        int list_remove(const void *item, struct list *l);
        void *list_find(struct list *l, const void *key, int *err);
        \\\
        ```
    compliant:
        ```c
        \\\
        int list_add(struct list *l, const void *item);
        int list_remove(struct list *l, const void *item);
        int list_find(struct list *l, const void *key, void **found);
        \\\
        ```
    languages: [c]
    tags: [recommendation, api-design, consistency]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/recommendations/application-programming-interfaces-api/api03-c
