use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCCon30C:
    standard: @{CertC}
    ruleId: CON30-C
    title: Clean up thread-specific storage
    statement:
        Free memory stored through tss_set before the program loses track of
        it. Give tss_create a destructor that frees the value, or free it
        explicitly in each thread, and call tss_delete when the key is no
        longer needed.
    rationale:
        Thread-specific storage that is never freed leaks memory every time
        a thread ends. CERT rates likelihood unlikely, detectable no,
        repairable no, priority P2, level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        static tss_t scratch_key;

        int worker(void *arg) {
            tss_set(scratch_key, malloc(4096));
            do_work(arg);
            return 0;
        }

        int setup(void) {
            return tss_create(&scratch_key, NULL);
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        static tss_t scratch_key;

        int worker(void *arg) {
            tss_set(scratch_key, malloc(4096));
            do_work(arg);
            return 0;
        }

        int setup(void) {
            return tss_create(&scratch_key, free);
        }
        \\\
        ```
    languages: [c]
    tags: [concurrency, memory, resource-management]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/rules/concurrency-con/con30-c
