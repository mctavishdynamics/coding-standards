use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCMem05C:
    standard: @{CertC}
    ruleId: MEM05-C
    title: Avoid large stack allocations
    statement:
        Do not make large or attacker-controlled allocations on the stack,
        such as big local arrays, variable-length arrays or deep recursion.
        Use bounded sizes or the heap.
    rationale:
        Stack space is small and running out of it crashes the program or
        lets it overwrite other memory. CERT rates likelihood likely,
        detectable no, repairable no, priority P6, level L2.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        void echo(size_t n, const char *src) {
            char copy[n];   /* n comes from the client */
            memcpy(copy, src, n);
            send_back(copy, n);
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        int echo(size_t n, const char *src) {
            char *copy = malloc(n);
            if (copy == NULL) {
                return -1;
            }
            memcpy(copy, src, n);
            send_back(copy, n);
            free(copy);
            return 0;
        }
        \\\
        ```
    languages: [c]
    tags: [recommendation, memory, stack, denial-of-service]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/recommendations/memory-management-mem/mem05-c
