use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCPos38C:
    standard: @{CertC}
    ruleId: POS38-C
    title:
        Beware of race conditions when using fork and file descriptors
    statement:
        Do not let a parent and child created by fork operate on the same
        inherited file descriptor without coordination. Open the file
        separately in each process, or close the descriptor in the process
        that does not need it.
    rationale:
        Forked processes share the file offset, so concurrent reads and
        writes interleave unpredictably. CERT rates likelihood unlikely,
        detectable no, repairable no, priority P2, level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```c
        \\\
        int fd = open("data.log", O_RDONLY);
        pid_t pid = fork();
        read(fd, buf, sizeof buf);
        \\\
        ```
    compliant:
        ```c
        \\\
        pid_t pid = fork();
        if (pid == -1) {
            return -1;
        }
        int fd = open("data.log", O_RDONLY);
        read(fd, buf, sizeof buf);
        \\\
        ```
    languages: [c]
    tags: [posix, processes, race-conditions]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/rules/posix-pos/pos38-c
