use ../lib/CodingRule

from ./CertC import CertC

export coding-rule CertCDcl30C:
    standard: @{CertC}
    ruleId: DCL30-C
    title: Declare objects with appropriate storage durations
    statement:
        Do not let a pointer to an object outlive the object. In particular,
        never return or store the address of a local variable where it can
        be used after the function returns.
    rationale:
        Using an object after its lifetime has ended is undefined behavior.
        The dangling pointer may read garbage or be exploited to change
        program data. CERT rates likelihood probable, detectable no,
        repairable no, priority P6, level L2.
    exceptions: null
    severity: high
    noncompliant:
        ```c
        \\\
        const char *greeting(void) {
            char text[] = "hello";
            return text;
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        const char *greeting(void) {
            static const char text[] = "hello";
            return text;
        }
        \\\
        ```
    languages: [c]
    tags: [declarations, lifetime, memory]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-c-coding-standard/rules/declarations-and-initialization-dcl/dcl30-c
