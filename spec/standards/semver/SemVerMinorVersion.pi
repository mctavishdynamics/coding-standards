use ../lib/CodingRule

from ./SemVer import SemVer

export coding-rule SemVerMinorVersion:
    standard: @{SemVer}
    ruleId: 7
    title: Bump the minor version for compatible new functionality
    statement:
        Increase Y in x.Y.z, for x above zero, when the public API gains
        backward compatible functionality or when any public API is marked
        deprecated, and reset the patch number to 0. A minor bump may also
        include substantial private improvements and patch level fixes.
    rationale:
        Consumers can upgrade minor versions to get new features without
        changing their code.
    exceptions: null
    severity: null
    noncompliant:
        ```text
        \\\
        2.3.4 -> 2.4.4   adds a new option
        \\\
        ```
    compliant:
        ```text
        \\\
        2.3.4 -> 2.4.0   adds a new option
        2.4.0 -> 2.5.0   deprecates the old connect() call
        \\\
        ```
    languages: [any]
    tags: [versioning, deprecation]
    source: https://semver.org/#semantic-versioning-specification-semver
