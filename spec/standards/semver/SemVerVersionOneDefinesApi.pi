use ../lib/CodingRule

from ./SemVer import SemVer

export coding-rule SemVerVersionOneDefinesApi:
    standard: @{SemVer}
    ruleId: 5
    title: Let version 1.0.0 define the public API
    statement:
        Treat the 1.0.0 release as the point where the public API is fixed.
        From then on, how the version number moves depends on how that API
        changes.
    rationale:
        A clear starting point makes every later increment a meaningful
        statement about compatibility.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [versioning, api, stability]
    source: https://semver.org/#semantic-versioning-specification-semver
