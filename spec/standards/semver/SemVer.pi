use ../lib/CodingStandard

from ./SemVerBuildMetadata import SemVerBuildMetadata
from ./SemVerDeclarePublicApi import SemVerDeclarePublicApi
from ./SemVerImmutableReleases import SemVerImmutableReleases
from ./SemVerMajorVersion import SemVerMajorVersion
from ./SemVerMajorVersionZero import SemVerMajorVersionZero
from ./SemVerMinorVersion import SemVerMinorVersion
from ./SemVerNormalVersionForm import SemVerNormalVersionForm
from ./SemVerPatchVersion import SemVerPatchVersion
from ./SemVerPreReleaseVersion import SemVerPreReleaseVersion
from ./SemVerPrecedence import SemVerPrecedence
from ./SemVerVersionOneDefinesApi import SemVerVersionOneDefinesApi

export coding-standard SemVer:
    title: Semantic Versioning
    publisher: Tom Preston-Werner
    url: https://semver.org/
    version: 2.0.0
    license: Creative Commons CC BY 3.0
    description:
        A specification for MAJOR.MINOR.PATCH version numbers that tie each
        increment to how the public API changed, with rules for pre-release
        tags, build metadata and precedence.
    rules:
        - @{SemVerDeclarePublicApi}
        - @{SemVerNormalVersionForm}
        - @{SemVerImmutableReleases}
        - @{SemVerMajorVersionZero}
        - @{SemVerVersionOneDefinesApi}
        - @{SemVerPatchVersion}
        - @{SemVerMinorVersion}
        - @{SemVerMajorVersion}
        - @{SemVerPreReleaseVersion}
        - @{SemVerBuildMetadata}
        - @{SemVerPrecedence}
