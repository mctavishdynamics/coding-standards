use ../lib/CodingRule

from ./SemVer import SemVer

export coding-rule SemVerMajorVersionZero:
    standard: @{SemVer}
    ruleId: 4
    title: Treat major version zero as unstable
    statement:
        Use 0.y.z for initial development. Anything may change in any
        release, and consumers should not consider the public API stable.
    rationale:
        Zero signals to users that the project is still settling its
        interface and gives authors freedom to iterate.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [versioning, stability]
    source: https://semver.org/#semantic-versioning-specification-semver
