use ../lib/CodingRule

from ./SemVer import SemVer

export coding-rule SemVerDeclarePublicApi:
    standard: @{SemVer}
    ruleId: 1
    title: Declare a public API
    statement:
        Define the public API of any software versioned with SemVer, in code
        or in documentation, and make that definition precise and complete.
    rationale:
        Every version number change is judged against the public API, so
        without a clear API the numbers carry no meaning.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [versioning, api]
    source: https://semver.org/#semantic-versioning-specification-semver
