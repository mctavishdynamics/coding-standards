use ../lib/CodingRule

from ./SemVer import SemVer

export coding-rule SemVerImmutableReleases:
    standard: @{SemVer}
    ruleId: 3
    title: Never change the contents of a released version
    statement:
        Once a version is published, leave its contents as they are. Ship
        any change, however small, as a new version.
    rationale:
        Users depend on a version number meaning one fixed set of contents;
        republishing under the same number breaks reproducible builds.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [versioning, release]
    source: https://semver.org/#semantic-versioning-specification-semver
