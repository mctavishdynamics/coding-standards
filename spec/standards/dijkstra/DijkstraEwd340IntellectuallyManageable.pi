use ../lib/CodingRule

from ./Dijkstra import Dijkstra

export coding-rule DijkstraEwd340IntellectuallyManageable:
    standard: @{Dijkstra}
    ruleId: EWD340-intellectually-manageable
    title: Write only programs you can fully understand
    statement:
        Limit yourself to designing programs that are intellectually
        manageable, where you can grasp and reason about everything they do.
    rationale:
        This sharply narrows the choices to consider, and the manageable
        programs are still rich enough for real problems.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [simplicity, correctness]
    source: https://www.cs.utexas.edu/~EWD/transcriptions/EWD03xx/EWD340.html
