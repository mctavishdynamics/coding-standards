use ../lib/CodingRule

from ./Dijkstra import Dijkstra

export coding-rule DijkstraEwd340FactoredSolutions:
    standard: @{Dijkstra}
    ruleId: EWD340-factored-solutions
    title: Factor systems into parts and avoid interfaces that block it
    statement:
        Break a system into separately understandable parts, and avoid
        interfaces that make such factoring harder.
    rationale:
        Only factored solutions stay within intellectual grasp as systems
        grow.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [modularity, design, interfaces]
    source: https://www.cs.utexas.edu/~EWD/transcriptions/EWD03xx/EWD340.html
