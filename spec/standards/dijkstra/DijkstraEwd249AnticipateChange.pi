use ../lib/CodingRule

from ./Dijkstra import Dijkstra

export coding-rule DijkstraEwd249AnticipateChange:
    standard: @{Dijkstra}
    ruleId: EWD249-anticipate-change
    title: Structure a program to show which changes it can absorb
    statement:
        Think of each program as one of many possible variants, and arrange
        its structure to mirror what you understand about the problem, so it
        is obvious which modifications it can absorb cleanly.
    rationale:
        Programs are always modified, and changes that follow the structure
        are far safer than editing the text as a flat string.
    exceptions:
        This does not call for generality that makes the program
        unacceptably inefficient or that rests on ill-considered
        generalisations of the problem.
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [maintainability, design, modularity]
    source: https://www.cs.utexas.edu/~EWD/transcriptions/EWD02xx/EWD249/EWD249.html
