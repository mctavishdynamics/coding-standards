use ../lib/CodingRule

from ./Dijkstra import Dijkstra

export coding-rule DijkstraEwd340PreventBugs:
    standard: @{Dijkstra}
    ruleId: EWD340-prevent-bugs
    title: Aim to avoid introducing bugs rather than debugging them out
    statement:
        Put effort into methods that keep bugs out from the start, instead
        of spending time finding and removing them afterwards.
    rationale:
        Programmers who do not create bugs in the first place need not
        debug, which makes reliable software cheaper too.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [correctness, process]
    source: https://www.cs.utexas.edu/~EWD/transcriptions/EWD03xx/EWD340.html
