use ../lib/CodingRule

from ./Dijkstra import Dijkstra

export coding-rule DijkstraEwd249TestingIsNotProof:
    standard: @{Dijkstra}
    ruleId: EWD249-testing-shows-presence-not-absence
    title: Do not rely on testing to prove a program correct
    statement:
        Use tests to find bugs, but do not take passing tests as evidence
        that no bugs remain.
    rationale:
        Exhaustive testing is impossible for all but trivial programs, so
        testing can reveal errors but never establish their absence. The
        same point is repeated in EWD340.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [testing, correctness]
    source: https://www.cs.utexas.edu/~EWD/transcriptions/EWD02xx/EWD249/EWD249.html
