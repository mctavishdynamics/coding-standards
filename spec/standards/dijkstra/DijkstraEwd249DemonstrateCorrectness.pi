use ../lib/CodingRule

from ./Dijkstra import Dijkstra

export coding-rule DijkstraEwd249DemonstrateCorrectness:
    standard: @{Dijkstra}
    ruleId: EWD249-demonstrate-correctness
    title: Structure programs so their correctness can be shown
    statement:
        Treat a convincing argument for correctness as part of the
        programmer's job, and give the program a structure that keeps that
        argument manageable.
    rationale:
        Programs are far too large in their possible behaviour to check case
        by case, so confidence must come from reasoning that the structure
        supports.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [correctness, structured-programming]
    source: https://www.cs.utexas.edu/~EWD/transcriptions/EWD02xx/EWD249/EWD249.html
