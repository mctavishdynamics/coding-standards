use ../lib/CodingRule

from ./Dijkstra import Dijkstra

export coding-rule DijkstraEwd249SystematicSequencing:
    standard: @{Dijkstra}
    ruleId: EWD249-systematic-sequencing
    title: Sequence actions only with systematic control structures
    statement:
        Build the order of execution from concatenation, selection,
        repetition and procedure calls, so that progress through the
        computation maps simply onto the program text.
    rationale:
        When control flow is that disciplined, a reader can understand each
        part from its text and the conditions that hold around it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [control-flow, structured-programming]
    source: https://www.cs.utexas.edu/~EWD/transcriptions/EWD02xx/EWD249/EWD249.html
