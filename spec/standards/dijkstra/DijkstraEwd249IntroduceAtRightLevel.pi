use ../lib/CodingRule

from ./Dijkstra import Dijkstra

export coding-rule DijkstraEwd249IntroduceAtRightLevel:
    standard: @{Dijkstra}
    ruleId: EWD249-introduce-at-right-level
    title: Introduce each concept at the level where it matters
    statement:
        Bring a variable, function or representation decision into the
        program only at the level of refinement where it has a meaning, and
        deal with each concern at its proper moment rather than earlier.
    rationale:
        Details introduced too early clutter the higher levels and tie them
        to choices that should still be open.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [design, refinement, separation-of-concerns]
    source: https://www.cs.utexas.edu/~EWD/transcriptions/EWD02xx/EWD249/EWD249.html
