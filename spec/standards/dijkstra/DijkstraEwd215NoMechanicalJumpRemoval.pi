use ../lib/CodingRule

from ./Dijkstra import Dijkstra

export coding-rule DijkstraEwd215NoMechanicalJumpRemoval:
    standard: @{Dijkstra}
    ruleId: EWD215-no-mechanical-jump-removal
    title: Do not remove jumps by mechanical translation
    statement:
        Restructure jump-ridden code by rethinking it, not by mechanically
        converting its flow diagram into an equivalent one without jumps.
    rationale:
        A mechanical translation proves the jumps are not needed, but the
        result is no clearer than the original.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [control-flow, refactoring]
    source: https://www.cs.utexas.edu/~EWD/transcriptions/EWD02xx/EWD215.html
