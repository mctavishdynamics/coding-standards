use ../lib/CodingRule

from ./Dijkstra import Dijkstra

export coding-rule DijkstraEwd249PreferSimpleStructures:
    standard: @{Dijkstra}
    ruleId: EWD249-prefer-simple-structures
    title: Restrict yourself to simple program structures
    statement:
        Keep to simple structures whenever you can, and stay away from
        intricate constructions, out of honest recognition of how hard
        programs are to reason about.
    rationale:
        Even a short program can need a long correctness argument; simple
        structure keeps the argument within reach.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [simplicity, structured-programming]
    source: https://www.cs.utexas.edu/~EWD/transcriptions/EWD02xx/EWD249/EWD249.html
