use ../lib/CodingStandard

from ./DijkstraEwd215AvoidGoTo import DijkstraEwd215AvoidGoTo
from ./DijkstraEwd215NoMechanicalJumpRemoval import
    DijkstraEwd215NoMechanicalJumpRemoval
from ./DijkstraEwd215ProgramMirrorsProcess import
    DijkstraEwd215ProgramMirrorsProcess
from ./DijkstraEwd249AnticipateChange import DijkstraEwd249AnticipateChange
from ./DijkstraEwd249DemonstrateCorrectness import
    DijkstraEwd249DemonstrateCorrectness
from ./DijkstraEwd249IntroduceAtRightLevel import
    DijkstraEwd249IntroduceAtRightLevel
from ./DijkstraEwd249LocalScope import DijkstraEwd249LocalScope
from ./DijkstraEwd249MatchDataAndActions import
    DijkstraEwd249MatchDataAndActions
from ./DijkstraEwd249PreferSimpleStructures import
    DijkstraEwd249PreferSimpleStructures
from ./DijkstraEwd249StateAssumptions import DijkstraEwd249StateAssumptions
from ./DijkstraEwd249StepwiseRefinement import DijkstraEwd249StepwiseRefinement
from ./DijkstraEwd249SystematicSequencing import
    DijkstraEwd249SystematicSequencing
from ./DijkstraEwd249TestingIsNotProof import DijkstraEwd249TestingIsNotProof
from ./DijkstraEwd249UseAbstraction import DijkstraEwd249UseAbstraction
from ./DijkstraEwd340AvoidCleverTricks import DijkstraEwd340AvoidCleverTricks
from ./DijkstraEwd340ExploitAbstraction import DijkstraEwd340ExploitAbstraction
from ./DijkstraEwd340FactoredSolutions import DijkstraEwd340FactoredSolutions
from ./DijkstraEwd340IntellectuallyManageable import
    DijkstraEwd340IntellectuallyManageable
from ./DijkstraEwd340LoopInvariants import DijkstraEwd340LoopInvariants
from ./DijkstraEwd340ModestLanguages import DijkstraEwd340ModestLanguages
from ./DijkstraEwd340PreventBugs import DijkstraEwd340PreventBugs
from ./DijkstraEwd340ProofWithProgram import DijkstraEwd340ProofWithProgram

export coding-standard Dijkstra:
    title: Selected writings of Edsger W. Dijkstra
    publisher: Edsger W. Dijkstra
    url: https://www.cs.utexas.edu/~EWD/
    version: EWD215 1968, EWD249 1970, EWD340 1972
    license: Copyright the heirs of Edsger W. Dijkstra or the respective publishers, all rights reserved. Items are paraphrased.
    description:
        Programming advice drawn from three of Dijkstra's manuscripts: the
        case against go to, Notes on Structured Programming and The Humble
        Programmer.
    rules:
        - @{DijkstraEwd215ProgramMirrorsProcess}
        - @{DijkstraEwd215AvoidGoTo}
        - @{DijkstraEwd215NoMechanicalJumpRemoval}
        - @{DijkstraEwd249DemonstrateCorrectness}
        - @{DijkstraEwd249TestingIsNotProof}
        - @{DijkstraEwd249PreferSimpleStructures}
        - @{DijkstraEwd249UseAbstraction}
        - @{DijkstraEwd249StateAssumptions}
        - @{DijkstraEwd249SystematicSequencing}
        - @{DijkstraEwd249StepwiseRefinement}
        - @{DijkstraEwd249IntroduceAtRightLevel}
        - @{DijkstraEwd249MatchDataAndActions}
        - @{DijkstraEwd249AnticipateChange}
        - @{DijkstraEwd249LocalScope}
        - @{DijkstraEwd340PreventBugs}
        - @{DijkstraEwd340LoopInvariants}
        - @{DijkstraEwd340IntellectuallyManageable}
        - @{DijkstraEwd340ProofWithProgram}
        - @{DijkstraEwd340ExploitAbstraction}
        - @{DijkstraEwd340AvoidCleverTricks}
        - @{DijkstraEwd340ModestLanguages}
        - @{DijkstraEwd340FactoredSolutions}
