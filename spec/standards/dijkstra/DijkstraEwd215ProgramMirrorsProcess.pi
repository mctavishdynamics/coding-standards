use ../lib/CodingRule

from ./Dijkstra import Dijkstra

export coding-rule DijkstraEwd215ProgramMirrorsProcess:
    standard: @{Dijkstra}
    ruleId: EWD215-program-mirrors-process
    title: Keep the program text close to the computation it causes
    statement:
        Write programs so that the correspondence between the static text
        and the process it produces at run time is as simple as possible.
    rationale:
        People reason well about static relations but poorly about processes
        that unfold over time, so the program should make the process easy
        to picture.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [structured-programming, readability]
    source: https://www.cs.utexas.edu/~EWD/transcriptions/EWD02xx/EWD215.html
