use ../lib/CodingRule

from ./Dijkstra import Dijkstra

export coding-rule DijkstraEwd249MatchDataAndActions:
    standard: @{Dijkstra}
    ruleId: EWD249-match-data-and-actions
    title: Choose data and operations on it together
    statement:
        Design a data structure and the computations that use it as a
        matched pair, refining them together.
    rationale:
        An elegant program needs its data representation and its operations
        to fit each other; choosing one in isolation forces awkwardness in
        the other.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [data-structures, design]
    source: https://www.cs.utexas.edu/~EWD/transcriptions/EWD02xx/EWD249/EWD249.html
