use ../lib/CodingRule

from ./Dijkstra import Dijkstra

export coding-rule DijkstraEwd249UseAbstraction:
    standard: @{Dijkstra}
    ruleId: EWD249-use-abstraction
    title: Reason through abstraction, induction and enumeration
    statement:
        Understand and argue about a program by enumerating a few cases, by
        induction over loops and recursion, and above all by abstraction:
        naming an operation and using it for what it does, not how.
    rationale:
        Abstraction is the main means of cutting down the amount of
        case-by-case reasoning a program demands.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [abstraction, reasoning]
    source: https://www.cs.utexas.edu/~EWD/transcriptions/EWD02xx/EWD249/EWD249.html
