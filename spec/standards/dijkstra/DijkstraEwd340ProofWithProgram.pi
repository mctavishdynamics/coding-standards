use ../lib/CodingRule

from ./Dijkstra import Dijkstra

export coding-rule DijkstraEwd340ProofWithProgram:
    standard: @{Dijkstra}
    ruleId: EWD340-proof-with-program
    title: Develop the correctness argument alongside the program
    statement:
        Construct the program and its correctness argument at the same time,
        step by step, rather than proving finished code afterwards.
    rationale:
        Testing cannot show the absence of bugs, and a proof added after the
        fact only adds work; built together, the proof steers the design
        toward correct code.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [correctness, design]
    source: https://www.cs.utexas.edu/~EWD/transcriptions/EWD03xx/EWD340.html
