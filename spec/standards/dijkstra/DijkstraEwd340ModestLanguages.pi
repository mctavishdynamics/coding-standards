use ../lib/CodingRule

from ./Dijkstra import Dijkstra

export coding-rule DijkstraEwd340ModestLanguages:
    standard: @{Dijkstra}
    ruleId: EWD340-modest-languages
    title: Prefer modest, elegant languages and tools
    statement:
        Choose small, clean programming languages over large feature-laden
        ones, and prefer tools that help you express the abstractions of
        your design.
    rationale:
        Huge languages full of special features cannot be mastered
        mechanically or mentally, and they invite clever tricks.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [languages, simplicity]
    source: https://www.cs.utexas.edu/~EWD/transcriptions/EWD03xx/EWD340.html
