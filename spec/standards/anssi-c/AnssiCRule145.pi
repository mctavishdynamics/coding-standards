use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCRule145:
    standard: @{AnssiC}
    ruleId: rule-145
    title: Always check a function's return value
    statement:
        When a function returns a value, test it.
    rationale:
        Ignored return values hide failures and let the program continue in
        a bad state.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        fseek(fp, offset, SEEK_SET);
        fread(buf, 1, len, fp);
        \\\
        ```
    compliant:
        ```c
        \\\
        if (fseek(fp, offset, SEEK_SET) != 0) { return -1; }
        if (fread(buf, 1, len, fp) != len) { return -1; }
        \\\
        ```
    languages: [c]
    tags: [rule, error-handling, functions]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=116
