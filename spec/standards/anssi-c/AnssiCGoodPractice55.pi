use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCGoodPractice55:
    standard: @{AnssiC}
    ruleId: good-practice-55
    title: Declare constants together at the top of the file
    statement:
        Gather constant declarations at the start of the file.
    rationale:
        Readers find them in one place and changes apply everywhere.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [good-practice, constants, readability]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=43
