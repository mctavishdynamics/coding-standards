use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCRule21:
    standard: @{AnssiC}
    ruleId: rule-21
    title: Do not use macros that expand into function definitions
    statement:
        A developer-defined macro must not produce the definition of a
        function when expanded.
    rationale:
        Functions generated by macros are hard to read, search and debug,
        and errors in them are easy to miss.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        #define MAKE_GETTER(name) int get_##name(void) { return name; }
        MAKE_GETTER(speed)
        \\\
        ```
    compliant:
        ```c
        \\\
        static int speed;
        int get_speed(void) { return speed; }
        \\\
        ```
    languages: [c]
    tags: [rule, macros, functions]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=24
