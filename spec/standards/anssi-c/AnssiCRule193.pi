use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCRule193:
    standard: @{AnssiC}
    ruleId: rule-193
    title: End every file with a newline and close comments and directives
    statement:
        Finish each non-empty source file with a newline character, and make
        sure no comment or preprocessor directive is left open when the file
        stops.
    rationale:
        The C90 and C99 standards make a missing final newline undefined
        behaviour.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [rule, formatting, undefined-behavior]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=153
