use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCGoodPractice32:
    standard: @{AnssiC}
    ruleId: good-practice-32
    title: Use a build automation tool
    statement:
        Manage builds with a tool such as make, CMake or Meson.
    rationale:
        Options can then be defined once and applied consistently to every
        source file.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [good-practice, build, tooling]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=30
