use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCRecommendation175:
    standard: @{AnssiC}
    ruleId: recommendation-175
    title: Use floating-point libraries only when really needed
    statement:
        Use the floating-point headers, namely math.h, float.h, fenv.h and
        complex.h, only when the task truly needs them, such as numerical
        processing.
    rationale:
        These libraries carry the pitfalls of floating-point computation and
        domain or range errors.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [recommendation, standard-library, floating-point]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=143
