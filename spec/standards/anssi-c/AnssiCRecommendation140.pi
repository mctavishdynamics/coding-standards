use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCRecommendation140:
    standard: @{AnssiC}
    ruleId: recommendation-140
    title: State the calling conditions of each function
    statement:
        Specify, with the prototype, the conditions under which each
        function may be called correctly, especially for portable code.
    rationale:
        Unstated preconditions lead callers to misuse the function.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [recommendation, functions, documentation]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=111
