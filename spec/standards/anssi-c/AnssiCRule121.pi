use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCRule121:
    standard: @{AnssiC}
    ruleId: rule-121
    title: Write one statement per line
    statement:
        Put at most one statement on each line of code.
    rationale:
        Several statements on a line are hard to read and to step through in
        a debugger.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        count = 0; total = 0; ready = true;
        \\\
        ```
    compliant:
        ```c
        \\\
        count = 0;
        total = 0;
        ready = true;
        \\\
        ```
    languages: [c]
    tags: [rule, formatting, readability]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=95
