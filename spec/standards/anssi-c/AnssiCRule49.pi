use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCRule49:
    standard: @{AnssiC}
    ruleId: rule-49
    title: Build production code in release mode
    statement:
        Always compile software that goes into production in release mode.
    rationale:
        Debug builds behave differently with memory and optimisation and can
        expose a larger attack surface.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [rule, build, release]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=38
