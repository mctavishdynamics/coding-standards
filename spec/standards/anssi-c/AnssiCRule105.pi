use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCRule105:
    standard: @{AnssiC}
    ruleId: rule-105
    title: Prevent every possible signed integer overflow
    statement:
        Check operands before any signed arithmetic that could overflow so
        the overflow cannot happen.
    rationale:
        Signed overflow is undefined behaviour and the compiler may remove
        checks written after the fact.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        int32_t total = a + b;
        \\\
        ```
    compliant:
        ```c
        \\\
        if (((b > 0) && (a > INT32_MAX - b)) || ((b < 0) && (a < INT32_MIN - b))) {
            return ERR_OVERFLOW;
        }
        int32_t total = a + b;
        \\\
        ```
    languages: [c]
    tags: [rule, integer-overflow, arithmetic]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=84
