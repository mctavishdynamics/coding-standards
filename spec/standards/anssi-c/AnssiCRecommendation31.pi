use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCRecommendation31:
    standard: @{AnssiC}
    ruleId: recommendation-31
    title: Know and document what compiler and linker options do
    statement:
        Understand and write down the effects of every enabled compiler and
        linker option, including optimisation options.
    rationale:
        Options such as fwrapv or fno-strict-aliasing usually point to code
        that relies on risky language behaviour.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [recommendation, compilation, documentation]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=30
