use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCRule167:
    standard: @{AnssiC}
    ruleId: rule-167
    title: Document error codes and their priority
    statement:
        Document every error code a function can return; if several can
        apply at once, state which one takes priority.
    rationale:
        Callers need to know what each code means to react correctly.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [rule, error-handling, documentation]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=137
