use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCRule95:
    standard: @{AnssiC}
    ruleId: rule-95
    title: Do not do arithmetic on void pointers
    statement:
        Never apply arithmetic to a pointer of type void*.
    rationale:
        void has no size, so the operation is undefined in standard C.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        void *next = buffer + offset;
        \\\
        ```
    compliant:
        ```c
        \\\
        unsigned char *next = (unsigned char *)buffer + offset;
        \\\
        ```
    languages: [c]
    tags: [rule, pointers, pointer-arithmetic]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=76
