use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCRule56:
    standard: @{AnssiC}
    ruleId: rule-56
    title: Write constant names in upper case
    statement:
        Name constants with upper-case letters.
    rationale:
        Upper case shows at a glance that a name cannot change.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        static const uint32_t retry_limit = 5U;
        \\\
        ```
    compliant:
        ```c
        \\\
        static const uint32_t RETRY_LIMIT = 5U;
        \\\
        ```
    languages: [c]
    tags: [rule, constants, naming]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=43
