use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCRule1:
    standard: @{AnssiC}
    ruleId: rule-1
    title: Define and document project coding conventions
    statement:
        Each project must write down its coding conventions, covering at
        least source file encoding, layout and indentation, the standard
        types to use, naming of libraries, files, functions, types and
        variables, and the documentation format. Every developer must follow
        them.
    rationale:
        Mixed personal habits make a codebase uneven and harder to audit.
        The point is that an explicit choice exists, not which style is
        chosen.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [rule, conventions, process]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=10
