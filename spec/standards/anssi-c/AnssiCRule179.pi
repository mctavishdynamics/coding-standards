use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCRule179:
    standard: @{AnssiC}
    ruleId: rule-179
    title: Do not use obsolete or deprecated library functions
    statement:
        Avoid library functions that are obsolete or have been removed in
        later standards, such as gets.
    rationale:
        These functions were withdrawn because they cannot be used safely.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        char line[80];
        gets(line);
        \\\
        ```
    compliant:
        ```c
        \\\
        char line[80];
        if (NULL == fgets(line, sizeof line, stdin)) { return -1; }
        \\\
        ```
    languages: [c]
    tags: [rule, standard-library, deprecated]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=144
