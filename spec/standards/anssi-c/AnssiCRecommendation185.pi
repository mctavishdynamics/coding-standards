use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCRecommendation185:
    standard: @{AnssiC}
    ruleId: recommendation-185
    title: Analyse the code with static analysis tools
    statement:
        Run at least one code analysis tool over the sources, study its
        results and fix the problems found.
    rationale:
        Tools find run-time errors, such as overflows and null dereferences,
        that are easy to miss by hand.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [recommendation, static-analysis, tooling]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=148
