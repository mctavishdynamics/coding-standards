use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCRecommendation35:
    standard: @{AnssiC}
    ruleId: recommendation-35
    title: Use the strictest compilation options and justify any you drop
    statement:
        Enable the strictest available options. If one is too strict for the
        project and is turned off, write down why.
    rationale:
        Every disabled check is a class of bugs no longer reported, so the
        decision must be deliberate.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [recommendation, compilation, warnings]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=31
