export coding-standard AnssiC:
    title: ANSSI Programming Rules for Secure Software Development in C
    publisher: ANSSI, French National Cybersecurity Agency
    url: https://messervices.cyber.gouv.fr/guides/en-rules-secure-c-language-software-development
    version: 1.4, 2022-03-24 (ANSSI-PA-073, first English edition)
    license: Licence Ouverte / Open Licence 2.0 (Etalab)
    description:
        ANSSI rules, recommendations and good practices for writing secure
        C. They cover the preprocessor, compiler hardening, declarations,
        types, pointers, memory, error handling and the standard library.
