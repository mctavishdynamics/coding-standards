use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCRecommendation186:
    standard: @{AnssiC}
    ruleId: recommendation-186
    title: Keep cyclomatic complexity low
    statement:
        Limit the cyclomatic complexity of each function as far as possible.
    rationale:
        Functions with many paths are hard to understand, test and audit.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [recommendation, complexity, functions]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=149
