use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCRecommendation152:
    standard: @{AnssiC}
    ruleId: recommendation-152
    title: Do not use prefix increment and decrement
    statement:
        Avoid the prefix forms of the increment and decrement operators.
    rationale:
        Using only one form keeps the code uniform and easier to review.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        ++count;
        \\\
        ```
    compliant:
        ```c
        \\\
        count++;
        \\\
        ```
    languages: [c]
    tags: [recommendation, expressions, readability]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=124
