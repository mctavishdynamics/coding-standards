use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCRule80:
    standard: @{AnssiC}
    ruleId: rule-80
    title: Understand the integer conversion rules
    statement:
        Developers must know in detail how C converts integer types
        implicitly, including promotion and the usual arithmetic
        conversions.
    rationale:
        Unexpected conversions change values, signs and comparison results
        without any warning.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [rule, types, conversions]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=62
