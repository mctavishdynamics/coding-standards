use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCGoodPractice8:
    standard: @{AnssiC}
    ruleId: good-practice-8
    title: Sort includes alphabetically within each group
    statement:
        Within the system group and the project group, order include
        directives alphabetically.
    rationale:
        A deterministic order shows duplicates at a glance and makes reviews
        easier.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        #include <string.h>
        #include <stdio.h>
        #include <stdint.h>
        \\\
        ```
    compliant:
        ```c
        \\\
        #include <stdint.h>
        #include <stdio.h>
        #include <string.h>
        \\\
        ```
    languages: [c]
    tags: [good-practice, headers, readability]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=14
