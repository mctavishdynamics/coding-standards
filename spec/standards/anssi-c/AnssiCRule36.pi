use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCRule36:
    standard: @{AnssiC}
    ruleId: rule-36
    title: Use the security features offered by the compiler
    statement:
        Enable as far as possible the compiler options that harden the
        produced program.
    rationale:
        Hardening options make many memory-safety bugs harder to exploit at
        little cost.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [rule, compilation, hardening]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=32
