use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCRecommendation50:
    standard: @{AnssiC}
    ruleId: recommendation-50
    title: Know and document how debug and release builds differ
    statement:
        When using debug and release modes, be aware of every change they
        make to memory handling and optimisation, and document all
        differences.
    rationale:
        Code that is tested only in one mode can behave differently in the
        other.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [recommendation, build, documentation]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=39
