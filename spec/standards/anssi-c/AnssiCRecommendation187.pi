use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCRecommendation187:
    standard: @{AnssiC}
    ruleId: recommendation-187
    title: Keep functions short and focused on one task
    statement:
        Give each function a single purpose and a reasonable length.
    rationale:
        Functions that do several things are hard to read, update and
        maintain.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [recommendation, complexity, functions]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=149
