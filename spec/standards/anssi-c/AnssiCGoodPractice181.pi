use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCGoodPractice181:
    standard: @{AnssiC}
    ruleId: good-practice-181
    title: Have all code reviewed
    statement:
        Have every piece of code proofread by someone other than its author.
    rationale:
        Review catches errors and risky constructions that tools and authors
        miss.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [good-practice, code-review, process]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=146
