use ../lib/CodingRule

from ./AnssiC import AnssiC

export coding-rule AnssiCRecommendation170:
    standard: @{AnssiC}
    ruleId: recommendation-170
    title: Report errors through the return value of main
    statement:
        Keep main minimal and report errors by returning a dedicated,
        documented code from it.
    rationale:
        A single exit point makes the program's outcome clear.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [recommendation, error-handling, exit-codes]
    source: https://messervices.cyber.gouv.fr/documents-guides/anssi-guide-rules_for_secure_c_language_software_development-v1.4.pdf#page=139
