use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip60:
    standard: @{PragmaticProgrammer}
    ruleId: tip-60
    title: Coordinate workflow through a blackboard
    statement:
        Let independent agents post and react to facts in a shared store
        instead of calling each other directly.
    rationale:
        A blackboard decouples the participants and handles work that
        arrives in any order.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [concurrency, architecture]
    source: https://pragprog.com/tips/
