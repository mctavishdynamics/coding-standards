use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip99:
    standard: @{PragmaticProgrammer}
    ruleId: tip-99
    title: Do not help bad actors
    statement:
        Refuse to build software that helps people exploit or deceive
        others.
    rationale:
        Developers enable what their code makes possible.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, ethics]
    source: https://pragprog.com/tips/
