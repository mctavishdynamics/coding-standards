use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip27:
    standard: @{PragmaticProgrammer}
    ruleId: tip-27
    title: Become fluent with your editor
    statement:
        Learn your editor well enough that common edits need no conscious
        thought, and keep improving that fluency.
    rationale:
        Editor fluency removes friction and keeps your attention on the
        problem.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, tools]
    source: https://pragprog.com/tips/
