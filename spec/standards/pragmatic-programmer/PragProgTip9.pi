use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip9:
    standard: @{PragmaticProgrammer}
    ruleId: tip-9
    title: Keep learning on a regular schedule
    statement:
        Invest in your skills and knowledge regularly, as a habit, and
        spread the investment across different areas.
    rationale:
        Technical knowledge loses value over time, so it needs steady
        renewal.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, learning, career]
    source: https://pragprog.com/tips/
