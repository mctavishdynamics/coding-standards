use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip8:
    standard: @{PragmaticProgrammer}
    ruleId: tip-8
    title: Let users help decide how good is good enough
    statement:
        Treat the level of quality as part of the requirements and agree it
        with the people who will use the system.
    rationale:
        Shipping useful software sooner often matters more than polishing it
        indefinitely.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, requirements, quality]
    source: https://pragprog.com/tips/
