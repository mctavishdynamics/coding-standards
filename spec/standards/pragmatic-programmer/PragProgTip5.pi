use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip5:
    standard: @{PragmaticProgrammer}
    ruleId: tip-5
    title: Fix small signs of decay as soon as you see them
    statement:
        Repair bad designs, wrong decisions and poor code when you find
        them, or at least mark them clearly so the decay does not spread.
    rationale:
        Visible neglect invites more neglect, and quality drops quickly once
        people stop caring.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, technical-debt, code-quality]
    source: https://pragprog.com/tips/
