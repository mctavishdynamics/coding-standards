use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip87:
    standard: @{PragmaticProgrammer}
    ruleId: tip-87
    title: Choose practices that work over fashionable ones
    statement:
        Adopt and keep processes because they help your team deliver, not
        because they are popular.
    rationale:
        A practice that suits another organisation may not suit yours.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, process]
    source: https://pragprog.com/tips/
