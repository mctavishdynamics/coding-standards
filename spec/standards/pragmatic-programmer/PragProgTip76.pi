use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip76:
    standard: @{PragmaticProgrammer}
    ruleId: tip-76
    title: Help people work out what they want
    statement:
        See your role as helping users clarify their needs, by asking
        questions and exploring consequences.
    rationale:
        Programmers are well placed to spot gaps and implications that users
        miss.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, requirements]
    source: https://pragprog.com/tips/
