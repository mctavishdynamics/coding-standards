use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip10:
    standard: @{PragmaticProgrammer}
    ruleId: tip-10
    title: Question what you read and hear
    statement:
        Evaluate claims critically, considering who makes them and why,
        before accepting them.
    rationale:
        Vendors, media and hype can mislead, and decisions based on them can
        be costly.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, learning]
    source: https://pragprog.com/tips/
