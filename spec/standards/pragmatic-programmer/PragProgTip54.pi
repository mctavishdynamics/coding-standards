use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip54:
    standard: @{PragmaticProgrammer}
    ruleId: tip-54
    title: Share functionality through mixins or traits
    statement:
        Where a language supports mixins, traits or similar, use them to add
        shared behaviour to classes without building an inheritance
        hierarchy.
    rationale:
        Mixins let you combine small pieces of behaviour without the
        coupling of deep inheritance.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [composition, reuse]
    source: https://pragprog.com/tips/
