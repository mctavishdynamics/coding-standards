use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip95:
    standard: @{PragmaticProgrammer}
    ruleId: tip-95
    title: Automate repetitive procedures
    statement:
        Replace manual steps in building, testing and deploying with scripts
        and automation.
    rationale:
        Manual procedures are slow, error-prone and hard to repeat
        consistently.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, automation]
    source: https://pragprog.com/tips/
