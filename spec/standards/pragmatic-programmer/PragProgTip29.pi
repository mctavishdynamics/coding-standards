use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip29:
    standard: @{PragmaticProgrammer}
    ruleId: tip-29
    title: Focus on fixing the problem rather than blaming someone
    statement:
        When a bug appears, treat it as a problem to solve, regardless of
        who caused it.
    rationale:
        Blame wastes effort and discourages people from reporting issues.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, debugging]
    source: https://pragprog.com/tips/
