use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip68:
    standard: @{PragmaticProgrammer}
    ruleId: tip-68
    title: Build in small end-to-end slices
    statement:
        Develop thin slices of functionality that go through every layer
        rather than finishing one layer at a time.
    rationale:
        End-to-end slices give feedback on how the parts fit together early.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [testing, iterative-development]
    source: https://pragprog.com/tips/
