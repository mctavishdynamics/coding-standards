use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip88:
    standard: @{PragmaticProgrammer}
    ruleId: tip-88
    title: Deliver when users need it
    statement:
        Aim to deliver value to users as it is needed, rather than waiting
        for fixed release dates.
    rationale:
        Frequent delivery shortens the feedback loop and serves users
        sooner.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, delivery]
    source: https://pragprog.com/tips/
