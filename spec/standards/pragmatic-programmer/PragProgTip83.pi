use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip83:
    standard: @{PragmaticProgrammer}
    ruleId: tip-83
    title: Treat agility as a way of working, not a product
    statement:
        Respond to feedback and adapt continuously instead of following a
        fixed branded process.
    rationale:
        Agility is about adapting to what you learn, not about rituals.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, process]
    source: https://pragprog.com/tips/
