use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip21:
    standard: @{PragmaticProgrammer}
    ruleId: tip-21
    title: Use throwaway prototypes to learn
    statement:
        Build prototypes to explore risky or uncertain aspects, and treat
        them as disposable learning tools rather than production code.
    rationale:
        Prototypes answer questions cheaply, but shipping them carries their
        shortcuts into production.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, prototyping]
    source: https://pragprog.com/tips/
