use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip16:
    standard: @{PragmaticProgrammer}
    ruleId: tip-16
    title: Make existing code easy for others to find and reuse
    statement:
        Make reusable code discoverable and straightforward to use, and keep
        communication open so people know it exists.
    rationale:
        If reuse is harder than rewriting, people will rewrite and knowledge
        will be duplicated.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reuse, dry]
    source: https://pragprog.com/tips/
