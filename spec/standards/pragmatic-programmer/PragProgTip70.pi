use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip70:
    standard: @{PragmaticProgrammer}
    ruleId: tip-70
    title: Test thoroughly before users do it for you
    statement:
        Test your software deliberately and thoroughly, because untested
        defects will be found by users.
    rationale:
        Bugs found in production cost much more than bugs found in testing.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [testing]
    source: https://pragprog.com/tips/
