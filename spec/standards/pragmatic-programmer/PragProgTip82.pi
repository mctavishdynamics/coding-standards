use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip82:
    standard: @{PragmaticProgrammer}
    ruleId: tip-82
    title: Do not code in isolation
    statement:
        Work with others through pairing, mobbing or reviews rather than
        always programming alone.
    rationale:
        Collaboration catches mistakes and spreads knowledge across the
        team.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, collaboration]
    source: https://pragprog.com/tips/
