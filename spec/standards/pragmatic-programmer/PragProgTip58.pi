use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip58:
    standard: @{PragmaticProgrammer}
    ruleId: tip-58
    title: Suspect concurrency when failures are random
    statement:
        When a failure appears intermittently and cannot be reproduced
        reliably, look for a concurrency problem.
    rationale:
        Timing-dependent bugs show up inconsistently and are easily mistaken
        for flukes.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [concurrency, debugging]
    source: https://pragprog.com/tips/
