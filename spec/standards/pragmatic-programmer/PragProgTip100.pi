use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip100:
    standard: @{PragmaticProgrammer}
    ruleId: tip-100
    title: Enjoy and share your working life
    statement:
        Take ownership of your career, share it with others, celebrate it
        and have fun doing it.
    rationale:
        Caring about and enjoying the work sustains you over a long career.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, career]
    source: https://pragprog.com/tips/
