use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip64:
    standard: @{PragmaticProgrammer}
    ruleId: tip-64
    title: Measure to check performance estimates
    statement:
        Confirm your performance expectations by timing and profiling with
        realistic data.
    rationale:
        Theoretical estimates can be wrong because of constant factors and
        real-world conditions.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [performance, profiling]
    source: https://pragprog.com/tips/
