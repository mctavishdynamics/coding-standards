use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip90:
    standard: @{PragmaticProgrammer}
    ruleId: tip-90
    title: Test early, often and automatically
    statement:
        Run tests as soon as code is written and on every change, with
        automation doing the work.
    rationale:
        Tests that run automatically and frequently catch problems while
        they are cheap to fix.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, testing, automation]
    source: https://pragprog.com/tips/
