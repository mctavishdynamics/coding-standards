use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip92:
    standard: @{PragmaticProgrammer}
    ruleId: tip-92
    title: Introduce deliberate bugs to check your tests
    statement:
        Plant faults on purpose, by hand or with mutation testing, and
        confirm that the tests detect them.
    rationale:
        Tests that pass no matter what the code does give false confidence.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [testing, mutation-testing]
    source: https://pragprog.com/tips/
