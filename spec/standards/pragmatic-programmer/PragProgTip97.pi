use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip97:
    standard: @{PragmaticProgrammer}
    ruleId: tip-97
    title: Put your name to your work
    statement:
        Take ownership of your work and be proud to have your name
        associated with it.
    rationale:
        Ownership encourages quality and accountability.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, craftsmanship, responsibility]
    source: https://pragprog.com/tips/
