use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip81:
    standard: @{PragmaticProgrammer}
    ruleId: tip-81
    title: Identify the real constraints before solving a problem
    statement:
        When a problem seems impossible, find out which constraints are real
        and which are assumed.
    rationale:
        Many apparent limits turn out to be assumptions that can be dropped.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, problem-solving]
    source: https://pragprog.com/tips/
