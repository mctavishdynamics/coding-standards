use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip32:
    standard: @{PragmaticProgrammer}
    ruleId: tip-32
    title: Read the error message carefully
    statement:
        Read the full error message and stack trace before guessing at the
        cause.
    rationale:
        The message usually points straight at the problem.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, debugging]
    source: https://pragprog.com/tips/
