use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip3:
    standard: @{PragmaticProgrammer}
    ruleId: tip-3
    title: Act to change a situation you are unhappy with
    statement:
        If your work or environment is not right, take steps to improve it
        or move on.
    rationale:
        You have more control over your career and circumstances than it may
        seem.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, career]
    source: https://pragprog.com/tips/
