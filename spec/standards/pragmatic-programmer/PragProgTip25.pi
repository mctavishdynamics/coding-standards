use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip25:
    standard: @{PragmaticProgrammer}
    ruleId: tip-25
    title: Store knowledge in plain text
    statement:
        Prefer human-readable text formats for data, configuration and
        documentation.
    rationale:
        Plain text outlives the programs that created it and works with a
        wide range of tools.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        pickle.dump(settings, open("settings.bin", "wb"))
        \\\
        ```
    compliant:
        ```python
        \\\
        json.dump(settings, open("settings.json", "w"), indent=2)
        \\\
        ```
    languages: [any]
    tags: [data-formats, persistence]
    source: https://pragprog.com/tips/
