use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip42:
    standard: @{PragmaticProgrammer}
    ruleId: tip-42
    title: Always take small steps
    statement:
        Work in small increments and get feedback after each before going
        further.
    rationale:
        Small steps limit how far you can go wrong before you notice.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, iterative-development]
    source: https://pragprog.com/tips/
