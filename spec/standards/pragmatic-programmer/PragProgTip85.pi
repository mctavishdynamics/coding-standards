use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip85:
    standard: @{PragmaticProgrammer}
    ruleId: tip-85
    title: Schedule the things you want to happen
    statement:
        Put activities such as learning, improvement and cleanup on the
        schedule so they actually get done.
    rationale:
        Unscheduled work is easily crowded out by urgent tasks.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, planning]
    source: https://pragprog.com/tips/
