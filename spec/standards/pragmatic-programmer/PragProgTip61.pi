use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip61:
    standard: @{PragmaticProgrammer}
    ruleId: tip-61
    title: Pay attention to a nagging feeling
    statement:
        When something feels wrong while you code, stop and investigate
        rather than pushing on.
    rationale:
        That unease is often your experience recognising a problem before
        you can name it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, intuition]
    source: https://pragprog.com/tips/
