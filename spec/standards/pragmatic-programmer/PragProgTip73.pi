use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip73:
    standard: @{PragmaticProgrammer}
    ruleId: tip-73
    title: Apply security patches promptly
    statement:
        Keep operating systems, libraries and tools up to date, applying
        security fixes quickly.
    rationale:
        Known vulnerabilities in unpatched systems are among the most common
        ways in for attackers.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, security, dependencies]
    source: https://pragprog.com/tips/
