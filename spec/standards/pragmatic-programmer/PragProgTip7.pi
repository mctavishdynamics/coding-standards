use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip7:
    standard: @{PragmaticProgrammer}
    ruleId: tip-7
    title: Keep an eye on the overall situation
    statement:
        Watch what is happening around the project as a whole, not only the
        task at hand.
    rationale:
        Problems often build up slowly and go unnoticed until they are
        serious.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, awareness]
    source: https://pragprog.com/tips/
