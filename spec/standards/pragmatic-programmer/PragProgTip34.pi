use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip34:
    standard: @{PragmaticProgrammer}
    ruleId: tip-34
    title: Verify your assumptions instead of trusting them
    statement:
        When a bug surprises you, check every assumption with real data and
        boundary conditions rather than assuming they hold.
    rationale:
        Surprises mean that something you believed is false.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, debugging]
    source: https://pragprog.com/tips/
