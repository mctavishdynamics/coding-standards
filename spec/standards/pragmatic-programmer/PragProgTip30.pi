use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip30:
    standard: @{PragmaticProgrammer}
    ruleId: tip-30
    title: Stay calm when debugging
    statement:
        Step back and think about the actual cause of a failure instead of
        reacting in haste.
    rationale:
        Panic leads to guesses and patches that hide symptoms rather than
        fix causes.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, debugging]
    source: https://pragprog.com/tips/
