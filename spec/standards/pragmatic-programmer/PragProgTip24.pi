use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip24:
    standard: @{PragmaticProgrammer}
    ruleId: tip-24
    title: Refine the schedule as the work progresses
    statement:
        Update estimates repeatedly using what you learn from each iteration
        of the implementation.
    rationale:
        Real progress data gives far better estimates than early guesses.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, estimation]
    source: https://pragprog.com/tips/
