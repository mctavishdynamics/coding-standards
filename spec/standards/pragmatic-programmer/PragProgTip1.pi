use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip1:
    standard: @{PragmaticProgrammer}
    ruleId: tip-1
    title: Take pride in doing the work well
    statement:
        Care about the quality of what you build and how you build it.
    rationale:
        Good software comes from people who want to do the job well.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, craftsmanship]
    source: https://pragprog.com/tips/
