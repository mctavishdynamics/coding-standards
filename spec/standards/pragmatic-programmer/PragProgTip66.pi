use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip66:
    standard: @{PragmaticProgrammer}
    ruleId: tip-66
    title: Use testing to shape the code, not only to find bugs
    statement:
        Treat writing tests as a way to get feedback on design, interfaces
        and coupling.
    rationale:
        Thinking about tests reveals awkward interfaces and hidden
        dependencies early.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [testing, design]
    source: https://pragprog.com/tips/
