use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip19:
    standard: @{PragmaticProgrammer}
    ruleId: tip-19
    title: Do not chase fashionable architectures
    statement:
        Choose technology and architecture for the problem at hand, not
        because they are popular.
    rationale:
        Fads come and go, and the cost of following them falls on the
        project.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, technology-choice]
    source: https://pragprog.com/tips/
