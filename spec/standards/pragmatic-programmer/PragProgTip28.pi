use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip28:
    standard: @{PragmaticProgrammer}
    ruleId: tip-28
    title: Keep everything under version control
    statement:
        Put all your work, including code, documentation, configuration and
        scripts, under version control.
    rationale:
        Version control gives a safety net, a history and a basis for builds
        and collaboration.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, version-control]
    source: https://pragprog.com/tips/
