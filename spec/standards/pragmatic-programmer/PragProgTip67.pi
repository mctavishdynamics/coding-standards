use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip67:
    standard: @{PragmaticProgrammer}
    ruleId: tip-67
    title: Treat tests as the first users of your code
    statement:
        Use the experience of writing tests to judge how easy your code is
        to use.
    rationale:
        If code is awkward to test it is likely awkward for real callers
        too.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [testing, api-design]
    source: https://pragprog.com/tips/
