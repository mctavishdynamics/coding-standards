use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip11:
    standard: @{PragmaticProgrammer}
    ruleId: tip-11
    title: Treat written communication as a skill to practise
    statement:
        Put the same care into writing documents, emails and explanations as
        into writing code.
    rationale:
        Ideas only have value if they are communicated clearly to others.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, communication]
    source: https://pragprog.com/tips/
