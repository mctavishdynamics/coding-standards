use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip65:
    standard: @{PragmaticProgrammer}
    ruleId: tip-65
    title: Refactor early and often
    statement:
        Improve the structure of code as soon as you see the need, in small
        steps backed by tests.
    rationale:
        Small, frequent refactoring is cheap, while postponed refactoring
        grows expensive.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [refactoring, maintainability]
    source: https://pragprog.com/tips/
