use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip36:
    standard: @{PragmaticProgrammer}
    ruleId: tip-36
    title: Code defensively because no software is perfect
    statement:
        Accept that your code and others' code will contain mistakes, and
        write code that protects against them.
    rationale:
        Perfect software is not achievable, so guarding against errors
        limits the damage.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [defensive-programming]
    source: https://pragprog.com/tips/
