use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip33:
    standard: @{PragmaticProgrammer}
    ruleId: tip-33
    title: Suspect your own code before the platform
    statement:
        When something fails, assume the bug is in your code before blaming
        the compiler, operating system or well-used libraries.
    rationale:
        Mature platform code is rarely the cause, and blaming it wastes
        time.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, debugging]
    source: https://pragprog.com/tips/
