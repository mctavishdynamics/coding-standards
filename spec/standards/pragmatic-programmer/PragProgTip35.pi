use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip35:
    standard: @{PragmaticProgrammer}
    ruleId: tip-35
    title: Learn a text-processing language
    statement:
        Learn a scripting language suited to manipulating text so you can
        write quick tools and transformations.
    rationale:
        Small scripts can automate many tasks that would otherwise be
        tedious and error-prone.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, tools]
    source: https://pragprog.com/tips/
