use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip20:
    standard: @{PragmaticProgrammer}
    ruleId: tip-20
    title: Build a thin working path through the whole system first
    statement:
        Start with a minimal end-to-end implementation that connects all the
        main parts, then fill it in.
    rationale:
        A working skeleton gives quick feedback on whether you are heading
        in the right direction.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, iterative-development]
    source: https://pragprog.com/tips/
