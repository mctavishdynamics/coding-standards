use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip91:
    standard: @{PragmaticProgrammer}
    ruleId: tip-91
    title: Do not consider code finished until all tests pass
    statement:
        Treat a change as incomplete until the full test suite runs
        successfully.
    rationale:
        A passing build is the only reliable sign the change did not break
        something.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, testing]
    source: https://pragprog.com/tips/
