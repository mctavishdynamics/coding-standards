use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip77:
    standard: @{PragmaticProgrammer}
    ruleId: tip-77
    title: Discover requirements through feedback
    statement:
        Show users working software or mock-ups often and refine
        requirements from their reactions.
    rationale:
        Requirements are learned through iteration rather than gathered
        once.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, requirements]
    source: https://pragprog.com/tips/
