use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip75:
    standard: @{PragmaticProgrammer}
    ruleId: tip-75
    title: Expect that nobody knows exactly what they want
    statement:
        Assume requirements are incomplete and uncertain, and plan to
        discover them together with users.
    rationale:
        People rarely know precisely what they need until they see something
        working.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, requirements]
    source: https://pragprog.com/tips/
