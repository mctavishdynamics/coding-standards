use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip74:
    standard: @{PragmaticProgrammer}
    ruleId: tip-74
    title: Choose good names and rename when they stop fitting
    statement:
        Name things for what they mean to the reader, and change names when
        the meaning of the code changes.
    rationale:
        Names shape how code is understood, and a misleading name causes
        mistakes.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        def process(lst):
            return [x for x in lst if x.flag]
        \\\
        ```
    compliant:
        ```python
        \\\
        def overdue_invoices(invoices):
            return [inv for inv in invoices if inv.is_overdue]
        \\\
        ```
    languages: [any]
    tags: [naming]
    source: https://pragprog.com/tips/
