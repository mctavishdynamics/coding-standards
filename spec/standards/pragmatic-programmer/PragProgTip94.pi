use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip94:
    standard: @{PragmaticProgrammer}
    ruleId: tip-94
    title: Add a test for every bug found so it never returns
    statement:
        Once a human tester or user finds a bug, add an automated test that
        catches it from then on.
    rationale:
        A bug should only ever need to be found once.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [testing, regression]
    source: https://pragprog.com/tips/
