use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip59:
    standard: @{PragmaticProgrammer}
    ruleId: tip-59
    title: Use actors to avoid shared state
    statement:
        Structure concurrent code as independent actors that hold private
        state and communicate only by messages.
    rationale:
        Without shared state there is nothing to lock, which removes a whole
        class of concurrency bugs.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [concurrency, actors]
    source: https://pragprog.com/tips/
