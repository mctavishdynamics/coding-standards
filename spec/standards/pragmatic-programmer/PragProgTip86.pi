use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip86:
    standard: @{PragmaticProgrammer}
    ruleId: tip-86
    title: Build teams with all the skills needed to deliver
    statement:
        Organise teams around delivering functionality end to end, with all
        the skills required inside the team.
    rationale:
        Teams split by job function introduce hand-offs and delays.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, teams]
    source: https://pragprog.com/tips/
