use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip6:
    standard: @{PragmaticProgrammer}
    ruleId: tip-6
    title: Help others see the change you want to make
    statement:
        Show people a small working piece of an improvement so that they
        want to join in, rather than demanding agreement up front.
    rationale:
        People rally behind visible progress more readily than behind
        proposals.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, teams]
    source: https://pragprog.com/tips/
