use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip23:
    standard: @{PragmaticProgrammer}
    ruleId: tip-23
    title: Estimate before committing
    statement:
        Make an estimate before starting work, with units that reflect its
        precision.
    rationale:
        Estimating exposes risks and unknowns early and avoids surprises
        later.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, estimation]
    source: https://pragprog.com/tips/
