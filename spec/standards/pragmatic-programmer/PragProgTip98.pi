use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip98:
    standard: @{PragmaticProgrammer}
    ruleId: tip-98
    title: Avoid causing harm with your work
    statement:
        Consider the possible harm of what you build and avoid creating
        software that hurts people.
    rationale:
        Software can affect many lives, and developers share responsibility
        for its effects.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, ethics]
    source: https://pragprog.com/tips/
