use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip22:
    standard: @{PragmaticProgrammer}
    ruleId: tip-22
    title: Write code in the language of the problem domain
    statement:
        Use names and, where useful, small domain-specific languages that
        match how users describe the problem.
    rationale:
        Code that mirrors the domain is easier to check against requirements
        and to change when they change.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        if d[3] > 0 and d[5] == 2:
            d[7] = d[3] * 0.9
        \\\
        ```
    compliant:
        ```python
        \\\
        if order.quantity > 0 and customer.tier == Tier.GOLD:
            order.price = apply_gold_discount(order.subtotal)
        \\\
        ```
    languages: [any]
    tags: [domain-modeling, naming]
    source: https://pragprog.com/tips/
