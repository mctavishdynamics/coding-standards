use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip78:
    standard: @{PragmaticProgrammer}
    ruleId: tip-78
    title: Work alongside users to understand them
    statement:
        Spend time with users doing their work to understand how they think
        and what they need.
    rationale:
        First-hand experience reveals needs that interviews and documents
        miss.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, requirements]
    source: https://pragprog.com/tips/
