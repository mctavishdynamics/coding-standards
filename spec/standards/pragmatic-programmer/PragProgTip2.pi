use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip2:
    standard: @{PragmaticProgrammer}
    ruleId: tip-2
    title: Think about what you are doing while you do it
    statement:
        Keep evaluating your own work and decisions as you go instead of
        working on autopilot.
    rationale:
        Continuous critical attention catches mistakes early and keeps you
        improving.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, craftsmanship]
    source: https://pragprog.com/tips/
