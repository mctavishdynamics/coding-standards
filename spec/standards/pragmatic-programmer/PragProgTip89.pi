use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip89:
    standard: @{PragmaticProgrammer}
    ruleId: tip-89
    title: Let version control drive builds and releases
    statement:
        Use commits and tags in version control to trigger building, testing
        and releasing automatically.
    rationale:
        Automated pipelines tied to version control make releases repeatable
        and reliable.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, continuous-integration, version-control]
    source: https://pragprog.com/tips/
