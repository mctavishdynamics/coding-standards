use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip12:
    standard: @{PragmaticProgrammer}
    ruleId: tip-12
    title: Pay attention to how you deliver a message
    statement:
        Think about your audience, timing and style, not only the content of
        what you say.
    rationale:
        A good idea presented badly may still be rejected or misunderstood.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, communication]
    source: https://pragprog.com/tips/
