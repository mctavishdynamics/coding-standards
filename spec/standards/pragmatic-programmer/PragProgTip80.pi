use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip80:
    standard: @{PragmaticProgrammer}
    ruleId: tip-80
    title: Keep a shared project glossary
    statement:
        Maintain a glossary of the project's terms and use those terms
        consistently.
    rationale:
        A shared vocabulary avoids misunderstandings between users and
        developers.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, communication, domain-modeling]
    source: https://pragprog.com/tips/
