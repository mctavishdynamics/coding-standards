use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip13:
    standard: @{PragmaticProgrammer}
    ruleId: tip-13
    title: Write documentation together with the code
    statement:
        Keep documentation close to the code, in comments and generated
        docs, and write it as you go rather than adding it at the end.
    rationale:
        Documentation added afterwards tends to be incomplete and quickly
        drifts out of date.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        def rate(p, t):
            return p * t * 0.0125
        \\\
        ```
    compliant:
        ```python
        \\\
        def interest(principal, months):
            """Simple interest at the fixed 1.25% monthly rate."""
            return principal * months * MONTHLY_RATE
        \\\
        ```
    languages: [any]
    tags: [documentation, comments]
    source: https://pragprog.com/tips/
