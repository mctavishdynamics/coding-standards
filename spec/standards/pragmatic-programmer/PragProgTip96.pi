use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip96:
    standard: @{PragmaticProgrammer}
    ruleId: tip-96
    title: Aim to delight users, not only to ship code
    statement:
        Focus on delivering what users value and the outcomes they need, not
        just on completing features.
    rationale:
        Code is a means to an end, and users judge you by the value they
        get.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, users]
    source: https://pragprog.com/tips/
