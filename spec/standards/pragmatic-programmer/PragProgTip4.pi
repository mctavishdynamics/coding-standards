use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip4:
    standard: @{PragmaticProgrammer}
    ruleId: tip-4
    title: Offer solutions instead of excuses
    statement:
        When something goes wrong, take responsibility and present options
        for fixing it rather than reasons it is not your fault.
    rationale:
        Options move a project forward, while excuses only erode trust.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, responsibility]
    source: https://pragprog.com/tips/
