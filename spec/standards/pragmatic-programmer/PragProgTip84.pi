use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip84:
    standard: @{PragmaticProgrammer}
    ruleId: tip-84
    title: Keep teams small and stable
    statement:
        Organise work around small teams whose membership stays largely the
        same over time.
    rationale:
        Small stable teams build trust and communicate efficiently.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, teams]
    source: https://pragprog.com/tips/
