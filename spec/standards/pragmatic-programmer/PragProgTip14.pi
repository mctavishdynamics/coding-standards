use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip14:
    standard: @{PragmaticProgrammer}
    ruleId: tip-14
    title: Prefer designs that are easy to change
    statement:
        Judge design choices by whether they make future change easier.
    rationale:
        Requirements change constantly, so ease of change is the core
        measure of good design.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [design, maintainability]
    source: https://pragprog.com/tips/
