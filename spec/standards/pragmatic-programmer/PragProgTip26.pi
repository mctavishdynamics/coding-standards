use ../lib/CodingRule

from ./PragmaticProgrammer import PragmaticProgrammer

export coding-rule PragProgTip26:
    standard: @{PragmaticProgrammer}
    ruleId: tip-26
    title: Learn to use the command shell well
    statement:
        Use the shell to combine tools and automate tasks instead of relying
        only on graphical interfaces.
    rationale:
        The shell lets you automate and compose operations that graphical
        tools cannot.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, tools]
    source: https://pragprog.com/tips/
