use ../lib/CodingRule

from ./ZenOfPython import ZenOfPython

export coding-rule ZenAphorism8:
    standard: @{ZenOfPython}
    ruleId: aphorism-8
    title: Do not bend the rules for special cases
    statement:
        Resist making exceptions to established conventions for situations
        that only seem special.
    rationale:
        Every exception is one more thing to remember, and consistent rules
        keep code predictable.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [consistency]
    source: https://peps.python.org/pep-0020/#the-zen-of-python
