use ../lib/CodingRule

from ./ZenOfPython import ZenOfPython

export coding-rule ZenAphorism17:
    standard: @{ZenOfPython}
    ruleId: aphorism-17
    title: Reject designs you cannot explain simply
    statement:
        If you find an implementation hard to explain to someone else, treat
        that as a sign that it should be redesigned.
    rationale:
        Difficulty in explaining code usually means it is too complicated to
        maintain or to get right.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [simplicity, design]
    source: https://peps.python.org/pep-0020/#the-zen-of-python
