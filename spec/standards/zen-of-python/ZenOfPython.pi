use ../lib/CodingStandard

from ./ZenAphorism1 import ZenAphorism1
from ./ZenAphorism10 import ZenAphorism10
from ./ZenAphorism11 import ZenAphorism11
from ./ZenAphorism12 import ZenAphorism12
from ./ZenAphorism13 import ZenAphorism13
from ./ZenAphorism14 import ZenAphorism14
from ./ZenAphorism15 import ZenAphorism15
from ./ZenAphorism16 import ZenAphorism16
from ./ZenAphorism17 import ZenAphorism17
from ./ZenAphorism18 import ZenAphorism18
from ./ZenAphorism19 import ZenAphorism19
from ./ZenAphorism2 import ZenAphorism2
from ./ZenAphorism3 import ZenAphorism3
from ./ZenAphorism4 import ZenAphorism4
from ./ZenAphorism5 import ZenAphorism5
from ./ZenAphorism6 import ZenAphorism6
from ./ZenAphorism7 import ZenAphorism7
from ./ZenAphorism8 import ZenAphorism8
from ./ZenAphorism9 import ZenAphorism9

export coding-standard ZenOfPython:
    title: PEP 20 - The Zen of Python
    publisher: Tim Peters
    url: https://peps.python.org/pep-0020/
    version: Last modified 2025-02-01
    license: Public domain
    description:
        Tim Peters' nineteen aphorisms that summarise the guiding principles
        of Python's design.
    rules:
        - @{ZenAphorism1}
        - @{ZenAphorism2}
        - @{ZenAphorism3}
        - @{ZenAphorism4}
        - @{ZenAphorism5}
        - @{ZenAphorism6}
        - @{ZenAphorism7}
        - @{ZenAphorism8}
        - @{ZenAphorism9}
        - @{ZenAphorism10}
        - @{ZenAphorism11}
        - @{ZenAphorism12}
        - @{ZenAphorism13}
        - @{ZenAphorism14}
        - @{ZenAphorism15}
        - @{ZenAphorism16}
        - @{ZenAphorism17}
        - @{ZenAphorism18}
        - @{ZenAphorism19}
