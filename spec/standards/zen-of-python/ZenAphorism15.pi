use ../lib/CodingRule

from ./ZenOfPython import ZenOfPython

export coding-rule ZenAphorism15:
    standard: @{ZenOfPython}
    ruleId: aphorism-15
    title: Act now rather than postponing forever
    statement:
        Prefer doing the work today to deferring it indefinitely.
    rationale:
        Endless postponement means the task never gets done.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [pragmatism]
    source: https://peps.python.org/pep-0020/#the-zen-of-python
