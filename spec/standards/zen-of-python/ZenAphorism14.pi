use ../lib/CodingRule

from ./ZenOfPython import ZenOfPython

export coding-rule ZenAphorism14:
    standard: @{ZenOfPython}
    ruleId: aphorism-14
    title: Expect the obvious way to take some learning
    statement:
        Accept that the idiomatic approach may not be apparent at first and
        may need familiarity with the language to recognise.
    rationale:
        What seems obvious often depends on experience with the language and
        its idioms. This qualifies the previous aphorism.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [idioms]
    source: https://peps.python.org/pep-0020/#the-zen-of-python
