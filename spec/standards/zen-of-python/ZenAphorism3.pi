use ../lib/CodingRule

from ./ZenOfPython import ZenOfPython

export coding-rule ZenAphorism3:
    standard: @{ZenOfPython}
    ruleId: aphorism-3
    title: Choose the simpler solution
    statement:
        When two approaches both solve the problem, pick the one with fewer
        parts and fewer ideas.
    rationale:
        Simple code has fewer places for bugs and is quicker to understand
        and change.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        total = functools.reduce(lambda acc, x: acc + x, prices, 0)
        \\\
        ```
    compliant:
        ```python
        \\\
        total = sum(prices)
        \\\
        ```
    languages: [python]
    tags: [simplicity]
    source: https://peps.python.org/pep-0020/#the-zen-of-python
