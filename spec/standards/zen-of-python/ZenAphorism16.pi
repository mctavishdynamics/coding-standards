use ../lib/CodingRule

from ./ZenOfPython import ZenOfPython

export coding-rule ZenAphorism16:
    standard: @{ZenOfPython}
    ruleId: aphorism-16
    title: Do not rush into action without thought
    statement:
        Doing nothing can be better than acting hastily, so think a change
        through before making it right away.
    rationale:
        Hurried work often has to be undone. This qualifies the previous
        aphorism.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [pragmatism, design]
    source: https://peps.python.org/pep-0020/#the-zen-of-python
