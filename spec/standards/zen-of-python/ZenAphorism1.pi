use ../lib/CodingRule

from ./ZenOfPython import ZenOfPython

export coding-rule ZenAphorism1:
    standard: @{ZenOfPython}
    ruleId: aphorism-1
    title: Prefer code that is pleasant to read
    statement:
        Aim for code whose form is tidy and graceful rather than code that
        merely works. Beauty here means clean layout, good names and a clear
        shape.
    rationale:
        Attractive code is easier to read, review and trust, and ugliness is
        often a sign of muddled thinking.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        def f(l):return [x*x for x in l if x%2==0]
        \\\
        ```
    compliant:
        ```python
        \\\
        def squares_of_evens(numbers):
            return [n * n for n in numbers if n % 2 == 0]
        \\\
        ```
    languages: [python]
    tags: [readability, style]
    source: https://peps.python.org/pep-0020/#the-zen-of-python
