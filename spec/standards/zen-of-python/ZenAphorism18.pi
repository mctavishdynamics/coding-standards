use ../lib/CodingRule

from ./ZenOfPython import ZenOfPython

export coding-rule ZenAphorism18:
    standard: @{ZenOfPython}
    ruleId: aphorism-18
    title: Treat an easily explained design as a promising candidate
    statement:
        An implementation that is easy to explain may well be a good one,
        though being easy to explain does not prove it is right.
    rationale:
        Simple explanations point to simple designs, but a simple idea can
        still be wrong.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [simplicity, design]
    source: https://peps.python.org/pep-0020/#the-zen-of-python
