use ../lib/CodingRule

from ./ZenOfPython import ZenOfPython

export coding-rule ZenAphorism9:
    standard: @{ZenOfPython}
    ruleId: aphorism-9
    title: Let practical needs win over purity
    statement:
        When strict adherence to a principle makes the code worse in
        practice, the practical solution takes priority.
    rationale:
        Rules exist to serve working, maintainable programs, not the other
        way round. This qualifies the previous aphorism.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [pragmatism]
    source: https://peps.python.org/pep-0020/#the-zen-of-python
