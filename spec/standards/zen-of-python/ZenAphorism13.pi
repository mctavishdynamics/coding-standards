use ../lib/CodingRule

from ./ZenOfPython import ZenOfPython

export coding-rule ZenAphorism13:
    standard: @{ZenOfPython}
    ruleId: aphorism-13
    title: Offer one obvious way to do each task
    statement:
        Design code and APIs so that there is a single clear way to do a
        given thing, and use that way.
    rationale:
        When there is one obvious idiom, code written by different people
        looks alike and is easier to read.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [consistency, api-design]
    source: https://peps.python.org/pep-0020/#the-zen-of-python
