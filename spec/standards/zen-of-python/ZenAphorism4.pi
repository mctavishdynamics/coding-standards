use ../lib/CodingRule

from ./ZenOfPython import ZenOfPython

export coding-rule ZenAphorism4:
    standard: @{ZenOfPython}
    ruleId: aphorism-4
    title: Accept necessary complexity but avoid tangled code
    statement:
        If a problem really needs a complex solution, build it from parts
        that are each understandable, rather than letting it grow into an
        intricate knot.
    rationale:
        Complexity made of clear, separate pieces can be reasoned about;
        tangled interactions cannot.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [simplicity, design]
    source: https://peps.python.org/pep-0020/#the-zen-of-python
