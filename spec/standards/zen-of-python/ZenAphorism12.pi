use ../lib/CodingRule

from ./ZenOfPython import ZenOfPython

export coding-rule ZenAphorism12:
    standard: @{ZenOfPython}
    ruleId: aphorism-12
    title: Do not guess when input or intent is ambiguous
    statement:
        When it is unclear what the caller means, reject the input or ask
        for clarification rather than picking an interpretation.
    rationale:
        A wrong guess produces quietly incorrect results, which are worse
        than an early clear error.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        def parse_date(text):
            for fmt in ("%d/%m/%Y", "%m/%d/%Y"):
                try:
                    return datetime.strptime(text, fmt)
                except ValueError:
                    continue
        \\\
        ```
    compliant:
        ```python
        \\\
        def parse_date(text):
            return datetime.strptime(text, "%Y-%m-%d")
        \\\
        ```
    languages: [python]
    tags: [error-handling, api-design]
    source: https://peps.python.org/pep-0020/#the-zen-of-python
