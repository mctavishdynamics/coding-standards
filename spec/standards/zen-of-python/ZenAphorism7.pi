use ../lib/CodingRule

from ./ZenOfPython import ZenOfPython

export coding-rule ZenAphorism7:
    standard: @{ZenOfPython}
    ruleId: aphorism-7
    title: Write code with the reader in mind
    statement:
        Treat readability as a primary goal when writing code, not an
        afterthought.
    rationale:
        Code is read far more often than it is written, by others and by
        your future self.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [readability]
    source: https://peps.python.org/pep-0020/#the-zen-of-python
