use ../lib/CodingStandard

from ./SandiMetzClassLength import SandiMetzClassLength
from ./SandiMetzFourParameters import SandiMetzFourParameters
from ./SandiMetzMethodLength import SandiMetzMethodLength
from ./SandiMetzOneControllerObject import SandiMetzOneControllerObject

export coding-standard SandiMetzRules:
    title: Sandi Metz' Rules for Developers
    publisher: Sandi Metz
    url: https://thoughtbot.com/blog/sandi-metz-rules-for-developers
    version: 2013-05-17, updated 2025-05-22
    license: Copyright thoughtbot, inc., all rights reserved. Items are paraphrased.
    description:
        Sandi Metz' four size limits for Ruby classes, methods, parameters
        and controllers, as reported by thoughtbot, with her rule that a
        limit may be broken only with a good reason or a pair's agreement.
    rules:
        - @{SandiMetzClassLength}
        - @{SandiMetzMethodLength}
        - @{SandiMetzFourParameters}
        - @{SandiMetzOneControllerObject}
