export coding-standard CertCpp:
    title: SEI CERT C++ Coding Standard
    publisher: Carnegie Mellon University Software Engineering Institute
    url: https://cmu-sei.github.io/secure-coding-standards/sei-cert-cpp-coding-standard/
    version: null
    license:
        Text under Creative Commons Attribution 4.0, code examples under the
        MIT license, copyright Carnegie Mellon University
    description:
        Secure coding rules for C++ from the CERT Division of the SEI. It
        covers undefined behavior, resource management, exceptions,
        containers and concurrency, and relies on the CERT C standard for
        rules the two languages share.
    rules:
        - @{CertCppDcl50Cpp}
        - @{CertCppDcl51Cpp}
        - @{CertCppDcl52Cpp}
        - @{CertCppDcl53Cpp}
