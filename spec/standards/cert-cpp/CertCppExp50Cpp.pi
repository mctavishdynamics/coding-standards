use ../lib/CodingRule

from ./CertCpp import CertCpp

export coding-rule CertCppExp50Cpp:
    standard: @{CertCpp}
    ruleId: EXP50-CPP
    title: Do not depend on the order of evaluation for side effects
    statement:
        Do not write expressions whose result depends on the order in which
        side effects on the same object are evaluated. Split them into
        separate statements.
    rationale:
        Unsequenced side effects on one object are undefined behavior, and
        unspecified evaluation order makes results differ between compilers.
        CERT rates likelihood probable, detectable no, repairable yes,
        priority P8, level L2.
    exceptions: null
    severity: medium
    noncompliant:
        ```cpp
        \\\
        void fill(int* out, int i) {
            out[i] = i++;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void fill(int* out, int i) {
            out[i] = i;
            ++i;
        }
        \\\
        ```
    languages: [cpp]
    tags: [expressions, side-effects, evaluation-order]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-cpp-coding-standard/rules/expressions-exp/exp50-cpp
