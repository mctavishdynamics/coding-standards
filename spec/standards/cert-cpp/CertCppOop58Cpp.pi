use ../lib/CodingRule

from ./CertCpp import CertCpp

export coding-rule CertCppOop58Cpp:
    standard: @{CertCpp}
    ruleId: OOP58-CPP
    title: Copy operations must not mutate the source object
    statement:
        Do not change the source object in a copy constructor or copy
        assignment operator. Use move operations to transfer state.
    rationale:
        Code and standard algorithms assume copying leaves the source
        unchanged, so a mutating copy causes surprising behavior. CERT rates
        likelihood likely, detectable yes, repairable no, priority P6, level
        L2.
    exceptions:
        Reference counting, as in std::shared_ptr, may update the shared
        count during a copy, since the count is not a salient property of
        the object.
    severity: low
    noncompliant:
        ```cpp
        \\\
        class Handle {
        public:
            Handle(Handle& other) : fd_(other.fd_) {
                other.fd_ = -1;
            }
        private:
            int fd_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Handle {
        public:
            Handle(const Handle&) = delete;
            Handle(Handle&& other) noexcept : fd_(other.fd_) {
                other.fd_ = -1;
            }
        private:
            int fd_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [classes, copying, move-semantics]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-cpp-coding-standard/rules/object-oriented-programming-oop/oop58-cpp
