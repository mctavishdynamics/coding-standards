use ../lib/CodingRule

from ./CertCpp import CertCpp

export coding-rule CertCppExp55Cpp:
    standard: @{CertCpp}
    ruleId: EXP55-CPP
    title: Do not access a cv-qualified object through a cv-unqualified type
    statement:
        Do not cast away const or volatile to modify or access an object
        that was defined with that qualifier.
    rationale:
        Writing to a const object, or reading or writing a volatile object
        through an lvalue that lacks volatile, is undefined behavior,
        because the compiler may have put the object in read-only memory or
        kept it in a register. CERT rates likelihood probable, detectable
        no, repairable no, priority P4, level L3.
    exceptions:
        Casting away const is allowed to call a legacy API that takes a
        non-const argument but never modifies it, though fixing the API is
        preferred.
    severity: medium
    noncompliant:
        ```cpp
        \\\
        const int max_users = 100;

        void raise_limit() {
            int* p = const_cast<int*>(&max_users);
            *p = 200;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int max_users = 100;

        void raise_limit() {
            max_users = 200;
        }
        \\\
        ```
    languages: [cpp]
    tags: [const, casts, type-safety]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-cpp-coding-standard/rules/expressions-exp/exp55-cpp
