use ../lib/CodingRule

from ./CertCpp import CertCpp

export coding-rule CertCppCtr50Cpp:
    standard: @{CertCpp}
    ruleId: CTR50-CPP
    title: Guarantee that container indices and iterators are within the valid range
    statement:
        Check that every index and iterator used to access a container or
        array is within the valid range before using it, or use a checked
        accessor such as at.
    rationale:
        Out-of-range access through operator brackets or an iterator is
        undefined behavior and a classic source of buffer overflows. CERT
        rates likelihood likely, detectable no, repairable no, priority P9,
        level L2.
    exceptions: null
    severity: high
    noncompliant:
        ```cpp
        \\\
        int score_at(const std::vector<int>& scores, int index) {
            return scores[index];
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int score_at(const std::vector<int>& scores, std::size_t index) {
            if (index >= scores.size()) {
                throw std::out_of_range("score index");
            }
            return scores[index];
        }
        \\\
        ```
    languages: [cpp]
    tags: [containers, bounds-checking, memory]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-cpp-coding-standard/rules/containers-ctr/ctr50-cpp
