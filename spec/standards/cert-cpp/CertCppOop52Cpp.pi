use ../lib/CodingRule

from ./CertCpp import CertCpp

export coding-rule CertCppOop52Cpp:
    standard: @{CertCpp}
    ruleId: OOP52-CPP
    title: Do not delete a polymorphic object without a virtual destructor
    statement:
        Do not delete a derived object through a pointer to a base class
        unless the base class has a virtual destructor.
    rationale:
        Deleting through a base pointer without a virtual destructor is
        undefined behavior and normally skips the derived destructor. CERT
        rates likelihood likely, detectable no, repairable no, priority P3,
        level L3.
    exceptions:
        It is allowed when the object is deleted through a pointer to its
        own final class, or when the base class has a destroying operator
        delete that finds the right destructor.
    severity: low
    noncompliant:
        ```cpp
        \\\
        struct Base {
            ~Base() = default;
        };
        struct Derived : Base {
            std::vector<int> data;
        };

        void destroy(Base* b) { delete b; }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        struct Base {
            virtual ~Base() = default;
        };
        struct Derived : Base {
            std::vector<int> data;
        };

        void destroy(Base* b) { delete b; }
        \\\
        ```
    languages: [cpp]
    tags: [classes, inheritance, destructors]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-cpp-coding-standard/rules/object-oriented-programming-oop/oop52-cpp
