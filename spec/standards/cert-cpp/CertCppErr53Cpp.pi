use ../lib/CodingRule

from ./CertCpp import CertCpp

export coding-rule CertCppErr53Cpp:
    standard: @{CertCpp}
    ruleId: ERR53-CPP
    title: Do not reference bases or members in a constructor or destructor function-try-block handler
    statement:
        In the handler of a constructor or destructor function-try-block, do
        not refer to non-static data members or base classes of the object.
    rationale:
        By the time the handler runs, those members and bases are already
        destroyed, so referring to them is undefined behavior. CERT rates
        likelihood unlikely, detectable yes, repairable yes, priority P3,
        level L3.
    exceptions: null
    severity: low
    noncompliant:
        ```cpp
        \\\
        class Session {
        public:
            Session() try : socket_(connect()) {
            } catch (...) {
                if (socket_.is_open()) {  // socket_ is already destroyed
                    log("partial open");
                }
            }
        private:
            Socket socket_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Session {
        public:
            Session() try : socket_(connect()) {
            } catch (...) {
                log("session setup failed");
            }
        private:
            Socket socket_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [exceptions, constructors, lifetime]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-cpp-coding-standard/rules/exceptions-and-error-handling-err/err53-cpp
