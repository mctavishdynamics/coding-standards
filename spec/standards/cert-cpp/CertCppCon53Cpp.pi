use ../lib/CodingRule

from ./CertCpp import CertCpp

export coding-rule CertCppCon53Cpp:
    standard: @{CertCpp}
    ruleId: CON53-CPP
    title: Avoid deadlock by locking in a predefined order
    statement:
        When a thread must hold several mutexes, acquire them in one agreed
        order everywhere, or lock them together with std::lock
        or std::scoped_lock.
    rationale:
        Threads that take the same locks in different orders can each hold
        one and wait for the other, which deadlocks the program. CERT rates
        likelihood probable, detectable no, repairable no, priority P2,
        level L3.
    exceptions: null
    severity: low
    noncompliant:
        ```cpp
        \\\
        void transfer(Account& from, Account& to, int amount) {
            std::lock_guard<std::mutex> a(from.m);
            std::lock_guard<std::mutex> b(to.m);  // opposite order in other thread
            from.balance -= amount;
            to.balance += amount;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void transfer(Account& from, Account& to, int amount) {
            std::scoped_lock lock(from.m, to.m);
            from.balance -= amount;
            to.balance += amount;
        }
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, deadlock, mutexes]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-cpp-coding-standard/rules/concurrency-con/con53-cpp
