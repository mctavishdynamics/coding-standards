use ../lib/CodingRule

from ./CertCpp import CertCpp

export coding-rule CertCppExp61Cpp:
    standard: @{CertCpp}
    ruleId: EXP61-CPP
    title: Do not let a lambda outlive objects it captures by reference
    statement:
        Do not let a lambda object outlive any object it captured by
        reference. Capture by copy when the lambda may be stored, returned
        or run later.
    rationale:
        A reference capture dangles once the captured object is destroyed,
        and calling the lambda then is undefined behavior. CERT rates
        likelihood probable, detectable no, repairable no, priority P6,
        level L2.
    exceptions: null
    severity: high
    noncompliant:
        ```cpp
        \\\
        std::function<int()> make_counter() {
            int count = 0;
            return [&count] { return ++count; };
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::function<int()> make_counter() {
            int count = 0;
            return [count]() mutable { return ++count; };
        }
        \\\
        ```
    languages: [cpp]
    tags: [lambdas, lifetime, references]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-cpp-coding-standard/rules/expressions-exp/exp61-cpp
