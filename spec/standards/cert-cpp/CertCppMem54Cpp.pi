use ../lib/CodingRule

from ./CertCpp import CertCpp

export coding-rule CertCppMem54Cpp:
    standard: @{CertCpp}
    ruleId: MEM54-CPP
    title: Provide placement new with properly aligned pointers to sufficient storage capacity
    statement:
        Give placement new a pointer that is suitably aligned for the type
        and points to enough storage for the object, including any array
        overhead.
    rationale:
        Placement new does not check size or alignment, so a short or
        misaligned buffer causes overflow or misaligned access, both
        undefined behavior. CERT rates likelihood likely, detectable no,
        repairable no, priority P9, level L2.
    exceptions: null
    severity: high
    noncompliant:
        ```cpp
        \\\
        void build() {
            char buffer[sizeof(double)];
            double* d = new (buffer) double(1.5);
            use(*d);
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void build() {
            alignas(double) unsigned char buffer[sizeof(double)];
            double* d = new (buffer) double(1.5);
            use(*d);
        }
        \\\
        ```
    languages: [cpp]
    tags: [memory, alignment, placement-new]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-cpp-coding-standard/rules/memory-management-mem/mem54-cpp
