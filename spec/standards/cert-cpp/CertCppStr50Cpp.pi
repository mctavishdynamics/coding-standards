use ../lib/CodingRule

from ./CertCpp import CertCpp

export coding-rule CertCppStr50Cpp:
    standard: @{CertCpp}
    ruleId: STR50-CPP
    title: Guarantee that storage for strings has sufficient space for character data and the null terminator
    statement:
        Make sure the destination of a string copy or read has room for all
        the characters and, for C-style strings, the terminating null.
        Prefer std::string, which grows as needed.
    rationale:
        Writing past the end of a character buffer is a buffer overflow that
        attackers can exploit to run code. CERT rates likelihood likely,
        detectable no, repairable no, priority P9, level L2.
    exceptions: null
    severity: high
    noncompliant:
        ```cpp
        \\\
        void read_name() {
            char name[16];
            std::cin >> name;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void read_name() {
            std::string name;
            std::cin >> name;
        }
        \\\
        ```
    languages: [cpp]
    tags: [strings, buffer-overflow, input-validation]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-cpp-coding-standard/rules/characters-and-strings-str/str50-cpp
