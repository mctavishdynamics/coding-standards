use ../lib/CodingRule

from ./KotlinApiGuidelines import KotlinApiGuidelines

export coding-rule KotlinApiCreatePersonasForYourUsers:
    standard: @{KotlinApiGuidelines}
    ruleId: create-personas-for-your-users
    title: Write documentation for defined user personas
    statement:
        Define personas for the kinds of people who will read the
        documentation, including their constraints, and review the
        documentation through them. Lacking information, assume less
        expertise and keep examples simple, and refine the personas as you
        learn.
    rationale:
        Documentation is hard to judge without a clear picture of its
        audience.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [kotlin]
    tags: [documentation]
    source: https://kotlinlang.org/docs/api-guidelines-informative-documentation.html#create-personas-for-your-users
