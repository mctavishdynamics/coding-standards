use ../lib/CodingRule

from ./KotlinApiGuidelines import KotlinApiGuidelines

export coding-rule KotlinApiUseSimpleEnglish:
    standard: @{KotlinApiGuidelines}
    ruleId: use-simple-english
    title: Write documentation in simple English
    statement:
        Use plain words and short sentences; avoid jargon, Latin phrases and
        idioms.
    rationale:
        Simple English reaches readers whose first language is not English
        and is easier to translate.
    exceptions: null
    severity: null
    noncompliant:
        ```kotlin
        \\\
        /** Ergo, mutatis mutandis, this idempotently reifies the payload ad hoc. */
        public fun prepare(payload: Payload): Request
        \\\
        ```
    compliant:
        ```kotlin
        \\\
        /** Builds a request from [payload]. Calling it twice gives the same result. */
        public fun prepare(payload: Payload): Request
        \\\
        ```
    languages: [kotlin]
    tags: [documentation]
    source: https://kotlinlang.org/docs/api-guidelines-informative-documentation.html#use-simple-english
