export coding-standard KotlinApiGuidelines:
    title: Kotlin Library Authors' Guidelines
    publisher: JetBrains
    url: https://kotlinlang.org/docs/api-guidelines-introduction.html
    version: Pages last updated between June 2024 and September 2026
    license: Apache-2.0
    description:
        JetBrains' best practices for designing Kotlin libraries, covering
        simplicity, readability, consistency, predictability, debuggability,
        testability, backward compatibility and documentation.
    rules:
        - @{KotlinApiMinimizePublicApi}
        - @{KotlinApiUseExplicitApiMode}
        - @{KotlinApiReuseExistingConcepts}
        - @{KotlinApiDefineAndBuildOnTopOfCoreApi}
        - @{KotlinApiPreferExplicitComposability}
        - @{KotlinApiUseDsls}
        - @{KotlinApiDslRequiredValuesAsParameters}
        - @{KotlinApiUseExtensionFunctionsAndProperties}
        - @{KotlinApiAvoidUsingTheBooleanTypeAsAnArgument}
        - @{KotlinApiUseNumericTypesAppropriately}
        - @{KotlinApiAvoidArithmeticTypesForIdentifiers}
        - @{KotlinApiMemoryLayoutTypes}
        - @{KotlinApiUnsignedTypes}
        - @{KotlinApiPreserveParameterOrderNamingAndUsage}
        - @{KotlinApiOverloadsBehaveIdentically}
        - @{KotlinApiGeneralToSpecificParameters}
        - @{KotlinApiUseObjectOrientedDesignForDataAndState}
        - @{KotlinApiChooseTheAppropriateErrorHandlingMechanism}
        - @{KotlinApiCatchingSuffixForResultOverloads}
        - @{KotlinApiAvoidExceptionsForControlFlow}
        - @{KotlinApiMaintainConventionsAndQuality}
        - @{KotlinApiTestAllDocumentedBehaviour}
        - @{KotlinApiDoTheRightThingByDefault}
        - @{KotlinApiAllowOpportunitiesForExtension}
        - @{KotlinApiPreventUnwantedAndInvalidExtensions}
        - @{KotlinApiAvoidExposingMutableState}
        - @{KotlinApiValidateInputsAndState}
        - @{KotlinApiProvideATostringMethodForStatefulTypes}
        - @{KotlinApiAdoptAndDocumentAPolicyForHandlingExceptions}
        - @{KotlinApiSupportCoroutineStackTraceRecoveryForCustomExceptions}
        - @{KotlinApiAvoidGlobalStateAndStatefulTopLevelFunctions}
        - @{KotlinApiChooseCompatibleLanguageAndApiVersions}
        - @{KotlinApiUseTheBinaryCompatibilityValidator}
        - @{KotlinApiSpecifyReturnTypesExplicitly}
        - @{KotlinApiAvoidAddingArgumentsToExistingApiFunctions}
        - @{KotlinApiUseOverloadsToPreserveBinaryCompatibility}
        - @{KotlinApiAvoidWideningOrNarrowingReturnTypes}
        - @{KotlinApiAvoidUsingDataClassesInYourApi}
        - @{KotlinApiAvoidChangingAnnotationTargets}
        - @{KotlinApiConsiderationsForUsingThePublishedapiAnnotation}
        - @{KotlinApiEvolveApisPragmatically}
        - @{KotlinApiUseTheRequiresoptinMechanism}
        - @{KotlinApiUseDocumentationToGuideDesign}
        - @{KotlinApiProvideComprehensiveDocumentation}
        - @{KotlinApiCreatePersonasForYourUsers}
        - @{KotlinApiDocumentByExampleWheneverPossible}
        - @{KotlinApiThoroughlyDocumentYourApi}
        - @{KotlinApiDocumentInputsAndExceptions}
        - @{KotlinApiDocumentLambdaParameters}
        - @{KotlinApiUseExplicitLinksInDocumentation}
        - @{KotlinApiBeSelfContainedWherePossible}
        - @{KotlinApiUseSimpleEnglish}
