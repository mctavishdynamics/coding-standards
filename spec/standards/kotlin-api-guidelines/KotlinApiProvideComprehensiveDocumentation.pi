use ../lib/CodingRule

from ./KotlinApiGuidelines import KotlinApiGuidelines

export coding-rule KotlinApiProvideComprehensiveDocumentation:
    standard: @{KotlinApiGuidelines}
    ruleId: provide-comprehensive-documentation
    title: Provide a getting started guide, reference, recipes and resources
    statement:
        Ship a getting started guide covering build setup, the main entities
        and any environment configuration, an in-depth API description,
        longer recipes for common tasks, and links to further material. Keep
        documentation per supported version, or mark redesigned parts
        clearly.
    rationale:
        Complete documentation lets users adopt the library with the least
        effort and avoids outdated advice.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [kotlin]
    tags: [documentation]
    source: https://kotlinlang.org/docs/api-guidelines-informative-documentation.html#provide-comprehensive-documentation
