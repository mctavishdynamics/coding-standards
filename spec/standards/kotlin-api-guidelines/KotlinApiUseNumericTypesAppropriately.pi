use ../lib/CodingRule

from ./KotlinApiGuidelines import KotlinApiGuidelines

export coding-rule KotlinApiUseNumericTypesAppropriately:
    standard: @{KotlinApiGuidelines}
    ruleId: use-numeric-types-appropriately
    title: Use Int, Long and Double for arithmetic values
    statement:
        Use Int, Long and Double for values that take part in calculations.
    rationale:
        These are the arithmetic types, and using them for numbers you
        compute with matches what readers expect.
    exceptions: null
    severity: null
    noncompliant:
        ```kotlin
        \\\
        public fun averageSpeed(distance: Short, time: Byte): Float
        \\\
        ```
    compliant:
        ```kotlin
        \\\
        public fun averageSpeed(distanceKm: Double, hours: Double): Double
        \\\
        ```
    languages: [kotlin]
    tags: [types, numbers]
    source: https://kotlinlang.org/docs/api-guidelines-readability.html#use-numeric-types-appropriately
