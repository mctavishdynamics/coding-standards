use ../lib/CodingRule

from ./KotlinApiGuidelines import KotlinApiGuidelines

export coding-rule KotlinApiMaintainConventionsAndQuality:
    standard: @{KotlinApiGuidelines}
    ruleId: maintain-conventions-and-quality
    title: Enforce conventions with linters
    statement:
        Use static analysis to verify that the code obeys the Kotlin coding
        conventions as well as any rules specific to the project.
    rationale:
        Automated checks keep quality consistent as the library and its
        contributors change.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [kotlin]
    tags: [tooling, quality]
    source: https://kotlinlang.org/docs/api-guidelines-consistency.html#maintain-conventions-and-quality
