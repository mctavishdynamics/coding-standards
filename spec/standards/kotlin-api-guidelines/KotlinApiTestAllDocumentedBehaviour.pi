use ../lib/CodingRule

from ./KotlinApiGuidelines import KotlinApiGuidelines

export coding-rule KotlinApiTestAllDocumentedBehaviour:
    standard: @{KotlinApiGuidelines}
    ruleId: test-all-documented-behaviour
    title: Test every documented behaviour of the public API
    statement:
        Provide unit and integration tests for all documented behaviour of
        every entry point, including boundary and edge cases. Run them
        during development and on every release, and consider measuring
        coverage.
    rationale:
        Untested behaviour should be treated as unreliable, and a suite run
        on each release catches regressions.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [kotlin]
    tags: [testing, quality]
    source: https://kotlinlang.org/docs/api-guidelines-consistency.html#maintain-conventions-and-quality
