use ../lib/CodingRule

from ./KotlinApiGuidelines import KotlinApiGuidelines

export coding-rule KotlinApiUseDocumentationToGuideDesign:
    standard: @{KotlinApiGuidelines}
    ruleId: use-documentation-to-guide-design
    title: Write documentation early and use it to refine the design
    statement:
        Document the library from its first versions and treat the
        documentation as a design check. If you cannot explain its purpose
        briefly, write a quick start guide, show basic tasks simply or show
        how to test without real services, change the design.
    rationale:
        Documenting forces you to consider edge cases and exposes complexity
        while it is still cheap to fix.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [kotlin]
    tags: [documentation, api-design]
    source: https://kotlinlang.org/docs/api-guidelines-informative-documentation.html
