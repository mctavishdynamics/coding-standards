use ../lib/CodingRule

from ./GoCodeReviewComments import GoCodeReviewComments

export coding-rule GoCrcInitialisms:
    standard: @{GoCodeReviewComments}
    ruleId: initialisms
    title: Keep initialisms in a consistent case
    statement:
        Write initialisms and acronyms in names in one consistent case, such
        as URL or url, never Url. This includes ID when it means identifier,
        so write appID rather than appId.
    rationale:
        Mixed-case acronyms are harder to read and break the convention used
        throughout Go code, such as ServeHTTP.
    exceptions:
        Files that protoc emits automatically do not have to follow this.
    severity: null
    noncompliant:
        ```go
        \\\
        type ApiClient struct {
            BaseUrl string
            UserId  int64
        }

        func (c *ApiClient) ServeHttp(w http.ResponseWriter, r *http.Request)
        \\\
        ```
    compliant:
        ```go
        \\\
        type APIClient struct {
            BaseURL string
            UserID  int64
        }

        func (c *APIClient) ServeHTTP(w http.ResponseWriter, r *http.Request)
        \\\
        ```
    languages: [go]
    tags: [naming]
    source: https://go.dev/wiki/CodeReviewComments#initialisms
