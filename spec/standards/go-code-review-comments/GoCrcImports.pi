use ../lib/CodingRule

from ./GoCodeReviewComments import GoCodeReviewComments

export coding-rule GoCrcImports:
    standard: @{GoCodeReviewComments}
    ruleId: imports
    title: Group imports and avoid renaming them
    statement:
        Give an import a new name only when two package names clash, and in
        that case rename the one that is more local to your project. Group
        the imports into blocks split by blank lines, standard library
        packages in the first block.
    rationale:
        Good package names do not need renaming, and consistent grouping
        makes dependencies easy to scan. goimports produces this layout
        automatically.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        import (
            "github.com/acme/billing/invoice"
            str "strings"
            "fmt"
            "github.com/google/uuid"
        )
        \\\
        ```
    compliant:
        ```go
        \\\
        import (
            "fmt"
            "strings"

            "github.com/acme/billing/invoice"
            "github.com/google/uuid"
        )
        \\\
        ```
    languages: [go]
    tags: [imports, formatting]
    source: https://go.dev/wiki/CodeReviewComments#imports
