use ../lib/CodingRule

from ./GoCodeReviewComments import GoCodeReviewComments

export coding-rule GoCrcVariableNames:
    standard: @{GoCodeReviewComments}
    ruleId: variable-names
    title: Keep variable names short, longer as scope grows
    statement:
        Keep names short, above all for locals that live in a few lines. The
        farther a use is from where the name was declared, the more the name
        has to say: a loop index or reader can be one letter, but rare
        values and package-level variables deserve longer names.
    rationale:
        Short names keep tight code readable, while distant uses need names
        that carry their own meaning.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        for sliceIndex := 0; sliceIndex < len(lines); sliceIndex++ {
            lineCount++
        }
        \\\
        ```
    compliant:
        ```go
        \\\
        for i := 0; i < len(lines); i++ {
            n++
        }
        \\\
        ```
    languages: [go]
    tags: [naming]
    source: https://go.dev/wiki/CodeReviewComments#variable-names
