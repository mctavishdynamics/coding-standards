use ../lib/CodingStandard

from ./GoCrcCommentSentences import GoCrcCommentSentences
from ./GoCrcContexts import GoCrcContexts
from ./GoCrcCopying import GoCrcCopying
from ./GoCrcCryptoRand import GoCrcCryptoRand
from ./GoCrcDeclaringEmptySlices import GoCrcDeclaringEmptySlices
from ./GoCrcDocComments import GoCrcDocComments
from ./GoCrcDontPanic import GoCrcDontPanic
from ./GoCrcErrorStrings import GoCrcErrorStrings
from ./GoCrcExamples import GoCrcExamples
from ./GoCrcGofmt import GoCrcGofmt
from ./GoCrcGoroutineLifetimes import GoCrcGoroutineLifetimes
from ./GoCrcHandleErrors import GoCrcHandleErrors
from ./GoCrcImportBlank import GoCrcImportBlank
from ./GoCrcImportDot import GoCrcImportDot
from ./GoCrcImports import GoCrcImports
from ./GoCrcInBandErrors import GoCrcInBandErrors
from ./GoCrcIndentErrorFlow import GoCrcIndentErrorFlow
from ./GoCrcInitialisms import GoCrcInitialisms
from ./GoCrcInterfaces import GoCrcInterfaces
from ./GoCrcLineLength import GoCrcLineLength
from ./GoCrcMixedCaps import GoCrcMixedCaps
from ./GoCrcNakedReturns import GoCrcNakedReturns
from ./GoCrcNamedResultParameters import GoCrcNamedResultParameters
from ./GoCrcPackageComments import GoCrcPackageComments
from ./GoCrcPackageNames import GoCrcPackageNames
from ./GoCrcPassValues import GoCrcPassValues
from ./GoCrcReceiverNames import GoCrcReceiverNames
from ./GoCrcReceiverType import GoCrcReceiverType
from ./GoCrcSynchronousFunctions import GoCrcSynchronousFunctions
from ./GoCrcUsefulTestFailures import GoCrcUsefulTestFailures
from ./GoCrcVariableNames import GoCrcVariableNames

export coding-standard GoCodeReviewComments:
    title: Go Code Review Comments
    publisher: The Go Authors
    url: https://go.dev/wiki/CodeReviewComments
    version: 2026-09-01
    license:
        Creative Commons Attribution 4.0 for text, BSD license for code
    description:
        A list of common comments made in Go code reviews, each giving a
        short explanation of a style or correctness point. It supplements
        Effective Go.
    rules:
        - @{GoCrcGofmt}
        - @{GoCrcCommentSentences}
        - @{GoCrcContexts}
        - @{GoCrcCopying}
        - @{GoCrcCryptoRand}
        - @{GoCrcDeclaringEmptySlices}
        - @{GoCrcDocComments}
        - @{GoCrcDontPanic}
        - @{GoCrcErrorStrings}
        - @{GoCrcExamples}
        - @{GoCrcGoroutineLifetimes}
        - @{GoCrcHandleErrors}
        - @{GoCrcImports}
        - @{GoCrcImportBlank}
        - @{GoCrcImportDot}
        - @{GoCrcInBandErrors}
        - @{GoCrcIndentErrorFlow}
        - @{GoCrcInitialisms}
        - @{GoCrcInterfaces}
        - @{GoCrcLineLength}
        - @{GoCrcMixedCaps}
        - @{GoCrcNamedResultParameters}
        - @{GoCrcNakedReturns}
        - @{GoCrcPackageComments}
        - @{GoCrcPackageNames}
        - @{GoCrcPassValues}
        - @{GoCrcReceiverNames}
        - @{GoCrcReceiverType}
        - @{GoCrcSynchronousFunctions}
        - @{GoCrcUsefulTestFailures}
        - @{GoCrcVariableNames}
