use ../lib/CodingRule

from ./GoCodeReviewComments import GoCodeReviewComments

export coding-rule GoCrcCryptoRand:
    standard: @{GoCodeReviewComments}
    ruleId: crypto-rand
    title: Generate keys with crypto/rand, not math/rand
    statement:
        Keys, including short-lived ones, must come from crypto/rand, never from
        math/rand or its v2 variant. Read bytes from crypto/rand.Reader; when
        you need a string, call crypto/rand.Text or hex or base64 encode the
        bytes.
    rationale:
        A math/rand generator seeded from the clock has only a few bits of
        entropy, so its output is predictable.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        import "math/rand"

        func newSessionToken() string {
            return strconv.FormatInt(rand.Int63(), 36)
        }
        \\\
        ```
    compliant:
        ```go
        \\\
        import "crypto/rand"

        func newSessionToken() string {
            return rand.Text()
        }
        \\\
        ```
    languages: [go]
    tags: [security, randomness]
    source: https://go.dev/wiki/CodeReviewComments#crypto-rand
