use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleInstanceOfVsClassComparison:
    standard: @{RubyStyleGuide}
    ruleId: instance-of-vs-class-comparison
    title: Use instance_of? instead of comparing classes
    statement:
        When you need an exact class match, call instance_of? instead of
        comparing the object's class with double equals.
    rationale:
        The predicate states the intent directly and reads better than a
        class comparison.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        value.class == Hash
        \\\
        ```
    compliant:
        ```ruby
        \\\
        value.instance_of?(Hash)
        \\\
        ```
    languages: [ruby]
    tags: [comparison, types]
    source: https://rubystyle.guide/#instance-of-vs-class-comparison
