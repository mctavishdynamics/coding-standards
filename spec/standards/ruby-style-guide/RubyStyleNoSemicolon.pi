use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleNoSemicolon:
    standard: @{RubyStyleGuide}
    ruleId: no-semicolon
    title: Do not terminate statements with semicolons
    statement:
        Do not end statements or expressions with a semicolon.
    rationale:
        Ruby ends a statement at the end of the line, so a trailing
        semicolon is noise.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        puts "Starting";
        count = 0;
        \\\
        ```
    compliant:
        ```ruby
        \\\
        puts "Starting"
        count = 0
        \\\
        ```
    languages: [ruby]
    tags: [formatting, statements]
    source: https://rubystyle.guide/#no-semicolon
