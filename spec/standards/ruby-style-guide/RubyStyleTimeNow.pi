use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleTimeNow:
    standard: @{RubyStyleGuide}
    ruleId: time-now
    title: Get the current time with Time.now
    statement:
        Use Time.now rather than Time.new to read the current system time.
        RuboCop checks this with Style/TimeNow.
    rationale:
        Time.now says plainly that it returns the current moment.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        started_at = Time.new
        \\\
        ```
    compliant:
        ```ruby
        \\\
        started_at = Time.now
        \\\
        ```
    languages: [ruby]
    tags: [date-time]
    source: https://rubystyle.guide/#time-now
