use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleEnglishSyntax:
    standard: @{RubyStyleGuide}
    ruleId: english-syntax
    title: Write comments as proper sentences
    statement:
        Capitalise comments that are longer than one word and punctuate
        them, using a single space after each full stop.
    rationale:
        Comments written as ordinary sentences are easier to read and look
        consistent across a codebase.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        # fetch the user first.  then load the orders
        \\\
        ```
    compliant:
        ```ruby
        \\\
        # Fetch the user first. Then load the orders.
        \\\
        ```
    languages: [ruby]
    tags: [comments, formatting]
    source: https://rubystyle.guide/#english-syntax
