use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleAttr:
    standard: @{RubyStyleGuide}
    ruleId: attr
    title: Avoid attr
    statement:
        Do not use the plain attr method; use attr_reader or attr_accessor
        instead.
    rationale:
        The meaning of attr has varied between Ruby versions, while the
        explicit macros say exactly what they define.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        attr :status
        \\\
        ```
    compliant:
        ```ruby
        \\\
        attr_reader :status
        \\\
        ```
    languages: [ruby]
    tags: [classes, accessors]
    source: https://rubystyle.guide/#attr
