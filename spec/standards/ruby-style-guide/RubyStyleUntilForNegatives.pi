use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleUntilForNegatives:
    standard: @{RubyStyleGuide}
    ruleId: until-for-negatives
    title: Loop with until rather than a negated while
    statement:
        Use until instead of while with a negated condition.
    rationale:
        It removes a negation the reader would otherwise have to reverse.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        sleep 1 while !job.finished?
        \\\
        ```
    compliant:
        ```ruby
        \\\
        sleep 1 until job.finished?
        \\\
        ```
    languages: [ruby]
    tags: [control-flow, loops]
    source: https://rubystyle.guide/#until-for-negatives
