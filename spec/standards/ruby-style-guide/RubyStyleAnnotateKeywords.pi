use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleAnnotateKeywords:
    standard: @{RubyStyleGuide}
    ruleId: annotate-keywords
    title: Follow annotation keywords with a colon and a space
    statement:
        Write the annotation keyword, then a colon, then a space, then a
        note that describes the problem. RuboCop checks this with
        Style/CommentAnnotation.
    rationale:
        A fixed format lets people and tools find annotations reliably.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        # TODO handle a missing currency
        \\\
        ```
    compliant:
        ```ruby
        \\\
        # TODO: Handle a missing currency.
        \\\
        ```
    languages: [ruby]
    tags: [comments, annotations]
    source: https://rubystyle.guide/#annotate-keywords
