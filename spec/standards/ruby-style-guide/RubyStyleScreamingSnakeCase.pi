use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleScreamingSnakeCase:
    standard: @{RubyStyleGuide}
    ruleId: screaming-snake-case
    title: Write other constants in screaming snake case
    statement:
        Name constants that do not refer to classes or modules in uppercase
        with underscores between words.
    rationale:
        Uppercase names mark values that are meant to stay fixed and set
        them apart from classes.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        MaxRetries = 3
        Default_timeout = 30
        \\\
        ```
    compliant:
        ```ruby
        \\\
        MAX_RETRIES = 3
        DEFAULT_TIMEOUT = 30
        \\\
        ```
    languages: [ruby]
    tags: [naming, constants]
    source: https://rubystyle.guide/#screaming-snake-case
