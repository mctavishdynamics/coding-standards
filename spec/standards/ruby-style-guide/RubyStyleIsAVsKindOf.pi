use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleIsAVsKindOf:
    standard: @{RubyStyleGuide}
    ruleId: is-a-vs-kind-of
    title: Prefer is_a? to kind_of?
    statement:
        Use is_a? rather than its synonym kind_of?.
    rationale:
        The two methods are identical, and is_a? is far more common.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        amount.kind_of?(Numeric)
        \\\
        ```
    compliant:
        ```ruby
        \\\
        amount.is_a?(Numeric)
        \\\
        ```
    languages: [ruby]
    tags: [comparison, types]
    source: https://rubystyle.guide/#is-a-vs-kind-of
