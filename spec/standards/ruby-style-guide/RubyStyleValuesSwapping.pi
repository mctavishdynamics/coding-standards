use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleValuesSwapping:
    standard: @{RubyStyleGuide}
    ruleId: values-swapping
    title: Swap two values with parallel assignment
    statement:
        Exchange the values of two variables with a single parallel
        assignment.
    rationale:
        It is the clearest way to swap and needs no temporary variable.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        tmp = low
        low = high
        high = tmp
        \\\
        ```
    compliant:
        ```ruby
        \\\
        low, high = high, low
        \\\
        ```
    languages: [ruby]
    tags: [assignment]
    source: https://rubystyle.guide/#values-swapping
