use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleTwoOrMoreEmptyLines:
    standard: @{RubyStyleGuide}
    ruleId: two-or-more-empty-lines
    title: Never stack blank lines
    statement:
        Separate code with at most one empty line at a time.
    rationale:
        A single blank line is enough to mark a break; more only spreads the
        code out.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        load_settings


        start_server
        \\\
        ```
    compliant:
        ```ruby
        \\\
        load_settings

        start_server
        \\\
        ```
    languages: [ruby]
    tags: [formatting, whitespace]
    source: https://rubystyle.guide/#two-or-more-empty-lines
