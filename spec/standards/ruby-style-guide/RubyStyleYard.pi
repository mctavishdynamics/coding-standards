use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleYard:
    standard: @{RubyStyleGuide}
    ruleId: yard
    title: Document APIs with YARD
    statement:
        Write API documentation using YARD and follow its conventions.
    rationale:
        A single documentation tool and tag style makes API docs consistent
        and lets them be generated.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```ruby
        \\\
        # Converts an amount between currencies.
        #
        # @param amount [Numeric] the value to convert
        # @param to [Symbol] the target currency code
        # @return [BigDecimal] the converted amount
        def convert(amount, to:)
        \\\
        ```
    languages: [ruby]
    tags: [documentation, comments]
    source: https://rubystyle.guide/#yard
