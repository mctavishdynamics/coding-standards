use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleUnderscoresInNumerics:
    standard: @{RubyStyleGuide}
    ruleId: underscores-in-numerics
    title: Group digits of large numbers with underscores
    statement:
        Separate the digits of large numeric literals into groups with
        underscores. RuboCop checks this with Style/NumericLiterals.
    rationale:
        Grouped digits are much easier to read and count.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        MAX_UPLOAD = 52428800
        \\\
        ```
    compliant:
        ```ruby
        \\\
        MAX_UPLOAD = 52_428_800
        \\\
        ```
    languages: [ruby]
    tags: [numbers, readability]
    source: https://rubystyle.guide/#underscores-in-numerics
