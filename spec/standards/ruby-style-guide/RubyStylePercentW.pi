use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStylePercentW:
    standard: @{RubyStyleGuide}
    ruleId: percent-w
    title: Use %w for arrays of plain words
    statement:
        For an array of two or more words without spaces or special
        characters, prefer the %w literal over quoting each string. RuboCop
        checks this with Style/WordArray.
    rationale:
        It removes the quotes and commas and makes the list easier to read.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        SIZES = ['small', 'medium', 'large']
        \\\
        ```
    compliant:
        ```ruby
        \\\
        SIZES = %w[small medium large]
        \\\
        ```
    languages: [ruby]
    tags: [collections, literals]
    source: https://rubystyle.guide/#percent-w
