use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleOperatorMethodCall:
    standard: @{RubyStyleGuide}
    ruleId: operator-method-call
    title: Call operator methods without a dot
    statement:
        Avoid the dot when calling an operator method, and write the
        operator in its normal infix form.
    rationale:
        Operators read naturally in infix form, and the dotted form looks
        unusual for no benefit.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        total = subtotal.+(tax)
        same = a.==(b)
        \\\
        ```
    compliant:
        ```ruby
        \\\
        total = subtotal + tax
        same = a == b
        \\\
        ```
    languages: [ruby]
    tags: [operators, method-calls]
    source: https://rubystyle.guide/#operator-method-call
