use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleNoComments:
    standard: @{RubyStyleGuide}
    ruleId: no-comments
    title: Make code explain itself before adding comments
    statement:
        Aim for code whose names and structure make comments unnecessary,
        and reach for a comment only when that is not enough.
    rationale:
        Code that reads clearly needs no second description that can drift
        out of date.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [ruby]
    tags: [comments, readability]
    source: https://rubystyle.guide/#no-comments
