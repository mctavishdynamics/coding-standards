use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleSnakeCaseSymbolsMethodsVarsWithNumbers:
    standard: @{RubyStyleGuide}
    ruleId: snake-case-symbols-methods-vars-with-numbers
    title: Do not separate numbers from letters in names
    statement:
        In symbols, methods and variables, attach a trailing number directly
        to the word before it instead of putting an underscore in between.
    rationale:
        Names such as address1 are the established form; inserting an
        underscore before the digit is an inconsistent variant.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        line_1 = row[0]
        def sha_256(data) = Digest::SHA256.hexdigest(data)
        \\\
        ```
    compliant:
        ```ruby
        \\\
        line1 = row[0]
        def sha256(data) = Digest::SHA256.hexdigest(data)
        \\\
        ```
    languages: [ruby]
    tags: [naming]
    source: https://rubystyle.guide/#snake-case-symbols-methods-vars-with-numbers
