use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleOneClassPerFile:
    standard: @{RubyStyleGuide}
    ruleId: one-class-per-file
    title: Keep one class or module per file
    statement:
        Aim for a single class or module in each source file, and name the
        file after it in snake case.
    rationale:
        When file names follow class names, a reader can find any class
        without searching.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        # models.rb
        class Invoice
        end

        class Receipt
        end
        \\\
        ```
    compliant:
        ```ruby
        \\\
        # invoice.rb
        class Invoice
        end
        \\\
        ```
    languages: [ruby]
    tags: [naming, files, classes]
    source: https://rubystyle.guide/#one-class-per-file
