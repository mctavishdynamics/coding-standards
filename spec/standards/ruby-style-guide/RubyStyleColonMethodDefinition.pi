use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleColonMethodDefinition:
    standard: @{RubyStyleGuide}
    ruleId: colon-method-definition
    title: Do not define class methods with the double colon
    statement:
        Define class methods with def self.name, never by writing the class
        name and a double colon before the method name.
    rationale:
        The double colon form is uncommon and inconsistent with how the
        methods are called.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        class Token
          def Token::generate
            SecureRandom.hex(16)
          end
        end
        \\\
        ```
    compliant:
        ```ruby
        \\\
        class Token
          def self.generate
            SecureRandom.hex(16)
          end
        end
        \\\
        ```
    languages: [ruby]
    tags: [methods, classes]
    source: https://rubystyle.guide/#colon-method-definition
