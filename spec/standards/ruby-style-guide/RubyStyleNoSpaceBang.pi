use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleNoSpaceBang:
    standard: @{RubyStyleGuide}
    ruleId: no-space-bang
    title: Put no space after the bang operator
    statement:
        Write the negation operator directly against its operand, with no
        space after it.
    rationale:
        The operator binds to the value next to it, and a gap makes that
        harder to see.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        ! valid?
        \\\
        ```
    compliant:
        ```ruby
        \\\
        !valid?
        \\\
        ```
    languages: [ruby]
    tags: [formatting, operators]
    source: https://rubystyle.guide/#no-space-bang
