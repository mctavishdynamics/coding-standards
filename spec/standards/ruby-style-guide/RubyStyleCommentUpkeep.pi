use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleCommentUpkeep:
    standard: @{RubyStyleGuide}
    ruleId: comment-upkeep
    title: Update comments when the code changes
    statement:
        When you change code, change the comments that describe it in the
        same edit.
    rationale:
        A comment that no longer matches the code misleads readers and does
        more harm than having no comment.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        # Retries three times.
        MAX_RETRIES = 5
        \\\
        ```
    compliant:
        ```ruby
        \\\
        # Retries five times.
        MAX_RETRIES = 5
        \\\
        ```
    languages: [ruby]
    tags: [comments, maintainability]
    source: https://rubystyle.guide/#comment-upkeep
