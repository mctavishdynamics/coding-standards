use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStylePercentS:
    standard: @{RubyStyleGuide}
    ruleId: percent-s
    title: Avoid %s for symbols
    statement:
        Do not create symbols with %s; write a quoted symbol when the name
        contains spaces.
    rationale:
        The quoted symbol form is the one the community has settled on.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        key = %s(created at)
        \\\
        ```
    compliant:
        ```ruby
        \\\
        key = :"created at"
        \\\
        ```
    languages: [ruby]
    tags: [literals, symbols]
    source: https://rubystyle.guide/#percent-s
