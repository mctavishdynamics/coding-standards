use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleSnakeCaseSymbolsMethodsVars:
    standard: @{RubyStyleGuide}
    ruleId: snake-case-symbols-methods-vars
    title: Write symbols, methods and variables in snake case
    statement:
        Spell symbols, method names and local variables in lowercase with
        underscores between words.
    rationale:
        Snake case is the convention throughout Ruby and its standard
        library, so other spellings stand out as foreign.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        :shippingAddress
        def sendReminder
          retryCount = 0
        end
        \\\
        ```
    compliant:
        ```ruby
        \\\
        :shipping_address
        def send_reminder
          retry_count = 0
        end
        \\\
        ```
    languages: [ruby]
    tags: [naming]
    source: https://rubystyle.guide/#snake-case-symbols-methods-vars
