use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleOptimize:
    standard: @{RubyStyleGuide}
    ruleId: optimize
    title: Mark slow code with OPTIMIZE
    statement:
        Use the OPTIMIZE keyword to flag code that is slow or wasteful and
        may cause performance trouble.
    rationale:
        Tagging known hot spots lets people find them when performance work
        begins.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```ruby
        \\\
        # OPTIMIZE: Runs one query per customer.
        def customer_totals
        \\\
        ```
    languages: [ruby]
    tags: [comments, annotations, performance]
    source: https://rubystyle.guide/#optimize
