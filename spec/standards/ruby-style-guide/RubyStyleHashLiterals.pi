use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleHashLiterals:
    standard: @{RubyStyleGuide}
    ruleId: hash-literals
    title: Use the colon hash syntax for symbol keys
    statement:
        When every key in a hash literal is a symbol, write the keys with
        the Ruby 1.9 colon syntax rather than hash rockets. RuboCop checks
        this with Style/HashSyntax.
    rationale:
        The colon syntax is shorter and is the common style for symbol keys.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        point = { :x => 3, :y => 4 }
        \\\
        ```
    compliant:
        ```ruby
        \\\
        point = { x: 3, y: 4 }
        \\\
        ```
    languages: [ruby]
    tags: [collections, hashes, syntax]
    source: https://rubystyle.guide/#hash-literals
