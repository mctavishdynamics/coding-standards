use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleNoSuperfluousComments:
    standard: @{RubyStyleGuide}
    ruleId: no-superfluous-comments
    title: Leave out comments that repeat the code
    statement:
        Do not write a comment that only restates what the line plainly
        does.
    rationale:
        A comment that repeats the code adds noise and one more thing to
        keep in step.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        attempts -= 1 # Subtract one from attempts.
        \\\
        ```
    compliant:
        ```ruby
        \\\
        attempts -= 1
        \\\
        ```
    languages: [ruby]
    tags: [comments]
    source: https://rubystyle.guide/#no-superfluous-comments
