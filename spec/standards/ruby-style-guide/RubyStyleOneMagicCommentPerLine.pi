use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleOneMagicCommentPerLine:
    standard: @{RubyStyleGuide}
    ruleId: one-magic-comment-per-line
    title: Give each magic comment its own line
    statement:
        When a file needs several magic comments, write each one on a
        separate line instead of combining them.
    rationale:
        One comment per line is easier to read, edit and remove.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        # -*- encoding: utf-8; frozen_string_literal: true -*-
        \\\
        ```
    compliant:
        ```ruby
        \\\
        # encoding: utf-8
        # frozen_string_literal: true
        \\\
        ```
    languages: [ruby]
    tags: [comments, magic-comments]
    source: https://rubystyle.guide/#one-magic-comment-per-line
