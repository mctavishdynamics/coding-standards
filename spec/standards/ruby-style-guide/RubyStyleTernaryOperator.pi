use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleTernaryOperator:
    standard: @{RubyStyleGuide}
    ruleId: ternary-operator
    title: Prefer the ternary operator to a simple if then else
    statement:
        Use the ternary operator instead of an if, then, else, end construct
        for a short choice between two values.
    rationale:
        The ternary form is common and much more compact for a simple
        choice.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        label = if count == 1 then 'item' else 'items' end
        \\\
        ```
    compliant:
        ```ruby
        \\\
        label = count == 1 ? 'item' : 'items'
        \\\
        ```
    languages: [ruby]
    tags: [control-flow, conditionals]
    source: https://rubystyle.guide/#ternary-operator
