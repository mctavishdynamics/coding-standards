use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleSingleLineDoEndBlock:
    standard: @{RubyStyleGuide}
    ruleId: single-line-do-end-block
    title: Do not write do end blocks on one line
    statement:
        Spread a do and end block over several lines rather than squeezing
        it onto one.
    rationale:
        A one-line do end block is cramped, and braces are the form for
        one-line blocks.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        retries.times do attempt_upload end
        \\\
        ```
    compliant:
        ```ruby
        \\\
        retries.times do
          attempt_upload
        end
        \\\
        ```
    languages: [ruby]
    tags: [blocks, formatting]
    source: https://rubystyle.guide/#single-line-do-end-block
