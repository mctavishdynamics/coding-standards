use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleCamelcaseClasses:
    standard: @{RubyStyleGuide}
    ruleId: camelcase-classes
    title: Write class and module names in CapitalCase
    statement:
        Name classes and modules in CapitalCase, also called PascalCase, and
        keep acronyms such as HTTP or XML fully uppercase.
    rationale:
        This matches the core library and makes constants that hold classes
        easy to recognise.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        class Payment_gateway
        end

        class XmlParser
        end
        \\\
        ```
    compliant:
        ```ruby
        \\\
        class PaymentGateway
        end

        class XMLParser
        end
        \\\
        ```
    languages: [ruby]
    tags: [naming, classes]
    source: https://rubystyle.guide/#camelcase-classes
