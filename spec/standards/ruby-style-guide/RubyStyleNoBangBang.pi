use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleNoBangBang:
    standard: @{RubyStyleGuide}
    ruleId: no-bang-bang
    title: Avoid unnecessary double negation
    statement:
        Do not convert a value to a boolean with a double bang when the
        value is only used as a condition.
    rationale:
        Every object is already truthy or falsy in a condition, so the
        conversion only hides what the code means.
    exceptions:
        It can be justified where a real true or false is required, such as
        JSON output or a predicate method's return value; even then a nil
        check may say it better.
    severity: null
    noncompliant:
        ```ruby
        \\\
        send_receipt if !!customer.email
        \\\
        ```
    compliant:
        ```ruby
        \\\
        send_receipt if customer.email
        \\\
        ```
    languages: [ruby]
    tags: [control-flow, booleans]
    source: https://rubystyle.guide/#no-bang-bang
