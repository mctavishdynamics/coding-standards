use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleEmptyLinesAroundBodies:
    standard: @{RubyStyleGuide}
    ruleId: empty-lines-around-bodies
    title: Do not put empty lines around bodies
    statement:
        Do not start or end the body of a method, class, module or block
        with an empty line.
    rationale:
        Blank lines at the edges of a body add height without separating
        anything.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        class Invoice

          def total
            lines.sum
          end

        end
        \\\
        ```
    compliant:
        ```ruby
        \\\
        class Invoice
          def total
            lines.sum
          end
        end
        \\\
        ```
    languages: [ruby]
    tags: [formatting, whitespace]
    source: https://rubystyle.guide/#empty-lines-around-bodies
