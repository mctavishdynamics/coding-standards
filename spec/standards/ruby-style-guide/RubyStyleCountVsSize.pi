use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleCountVsSize:
    standard: @{RubyStyleGuide}
    ruleId: count-vs-size
    title: Use size rather than count for the number of elements
    statement:
        Do not call count when you only want the number of elements; call
        size.
    rationale:
        On Enumerable objects other than Array, count walks the whole
        collection to get its answer.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        settings.count
        \\\
        ```
    compliant:
        ```ruby
        \\\
        settings.size
        \\\
        ```
    languages: [ruby]
    tags: [collections, performance]
    source: https://rubystyle.guide/#count-vs-size
