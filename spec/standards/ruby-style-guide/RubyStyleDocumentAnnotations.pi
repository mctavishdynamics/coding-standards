use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleDocumentAnnotations:
    standard: @{RubyStyleGuide}
    ruleId: document-annotations
    title: Document any custom annotation keywords
    statement:
        You may add your own annotation keywords when they help, but list
        and explain them in the project README or a similar document.
    rationale:
        Readers can only act on a keyword they know the meaning of.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [ruby]
    tags: [comments, annotations, documentation]
    source: https://rubystyle.guide/#document-annotations
