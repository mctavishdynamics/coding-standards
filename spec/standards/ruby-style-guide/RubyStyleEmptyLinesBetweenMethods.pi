use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleEmptyLinesBetweenMethods:
    standard: @{RubyStyleGuide}
    ruleId: empty-lines-between-methods
    title: Separate methods and logical steps with empty lines
    statement:
        Separate one method definition from the next with a blank line, and
        group the steps inside a long method with blank lines as well.
    rationale:
        Blank lines show where one unit of work ends and the next begins.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        def open
          @open = true
        end
        def close
          @open = false
        end
        \\\
        ```
    compliant:
        ```ruby
        \\\
        def open
          @open = true
        end

        def close
          @open = false
        end
        \\\
        ```
    languages: [ruby]
    tags: [formatting, whitespace, methods]
    source: https://rubystyle.guide/#empty-lines-between-methods
