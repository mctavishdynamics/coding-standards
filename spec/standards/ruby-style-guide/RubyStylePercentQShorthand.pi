use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStylePercentQShorthand:
    standard: @{RubyStyleGuide}
    ruleId: percent-q-shorthand
    title:
        Use %() only for one-line strings needing interpolation and double
        quotes
    statement:
        Use the bare percent-parenthesis literal only for a single-line
        string that needs both interpolation and embedded double quotes.
        Prefer a heredoc for multi-line text. RuboCop checks this with
        Style/BarePercentLiterals.
    rationale:
        Ordinary quotes are clearer whenever they do not force escaping.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        title = %(Weekly report)
        \\\
        ```
    compliant:
        ```ruby
        \\\
        link = %(<a href="#{url}">#{label}</a>)
        \\\
        ```
    languages: [ruby]
    tags: [strings, literals]
    source: https://rubystyle.guide/#percent-q-shorthand
