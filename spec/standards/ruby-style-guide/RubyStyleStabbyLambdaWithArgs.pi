use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleStabbyLambdaWithArgs:
    standard: @{RubyStyleGuide}
    ruleId: stabby-lambda-with-args
    title: Keep parentheses around arrow lambda parameters
    statement:
        When an arrow lambda takes parameters, write them in parentheses.
    rationale:
        The parentheses make the parameter list clearly separate from the
        body.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        square = ->n { n * n }
        \\\
        ```
    compliant:
        ```ruby
        \\\
        square = ->(n) { n * n }
        \\\
        ```
    languages: [ruby]
    tags: [lambdas]
    source: https://rubystyle.guide/#stabby-lambda-with-args
