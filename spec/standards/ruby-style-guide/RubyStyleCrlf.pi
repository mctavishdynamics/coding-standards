use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleCrlf:
    standard: @{RubyStyleGuide}
    ruleId: crlf
    title: Use Unix-style line endings
    statement:
        End lines with a line feed only, not a carriage return and line
        feed. Windows users should configure their tools, for example Git's
        core.autocrlf setting, so that CRLF endings do not enter the
        repository.
    rationale:
        Mixed line endings make whole-file diffs and confuse tools that
        expect Unix endings.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [ruby]
    tags: [formatting, line-endings]
    source: https://rubystyle.guide/#crlf
