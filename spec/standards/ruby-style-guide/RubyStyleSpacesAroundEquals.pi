use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleSpacesAroundEquals:
    standard: @{RubyStyleGuide}
    ruleId: spaces-around-equals
    title: Use spaces around the equals sign of default parameters
    statement:
        Put a space on each side of the equals sign that gives a method
        parameter its default value.
    rationale:
        Although some books show the unspaced form, the spaced form is far
        more common in practice and slightly easier to read.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        def connect(host, port=443, timeout=5)
        end
        \\\
        ```
    compliant:
        ```ruby
        \\\
        def connect(host, port = 443, timeout = 5)
        end
        \\\
        ```
    languages: [ruby]
    tags: [formatting, whitespace, methods]
    source: https://rubystyle.guide/#spaces-around-equals
