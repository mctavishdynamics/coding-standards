use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleNewlineEof:
    standard: @{RubyStyleGuide}
    ruleId: newline-eof
    title: Finish every file with a line break
    statement:
        Finish every source file with a newline character. Let the editor
        configuration do this rather than doing it by hand.
    rationale:
        Many Unix tools expect a final newline, and a missing one shows up
        as a spurious change in diffs.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [ruby]
    tags: [formatting, files]
    source: https://rubystyle.guide/#newline-eof
