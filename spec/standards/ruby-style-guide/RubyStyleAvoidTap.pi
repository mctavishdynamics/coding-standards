use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleAvoidTap:
    standard: @{RubyStyleGuide}
    ruleId: avoid-tap
    title: Do not leave tap in production code
    statement:
        Use tap for debugging if it helps, but do not keep it in production
        code; use a local variable instead.
    rationale:
        A local variable is simpler to read and avoids the extra block.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        Client.new(token).tap do |client|
          client.connect if eager
        end
        \\\
        ```
    compliant:
        ```ruby
        \\\
        client = Client.new(token)
        client.connect if eager
        client
        \\\
        ```
    languages: [ruby]
    tags: [readability, simplicity]
    source: https://rubystyle.guide/#avoid-tap
