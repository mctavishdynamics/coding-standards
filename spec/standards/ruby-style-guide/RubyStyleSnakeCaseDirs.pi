use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleSnakeCaseDirs:
    standard: @{RubyStyleGuide}
    ruleId: snake-case-dirs
    title: Name directories in snake case
    statement:
        Give directories lowercase names with underscores between words,
        such as lib/payment_gateway.
    rationale:
        Directory names map to module namespaces, so they follow the same
        convention as file names.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [ruby]
    tags: [naming, files]
    source: https://rubystyle.guide/#snake-case-dirs
