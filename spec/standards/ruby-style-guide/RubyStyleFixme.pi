use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleFixme:
    standard: @{RubyStyleGuide}
    ruleId: fixme
    title: Mark broken code with FIXME
    statement:
        Use the FIXME keyword to flag code that is known to be broken and
        must be repaired.
    rationale:
        A distinct keyword for defects separates them from planned work and
        makes them easy to find.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```ruby
        \\\
        # FIXME: Returns the wrong total when a coupon is applied twice.
        def total
        \\\
        ```
    languages: [ruby]
    tags: [comments, annotations]
    source: https://rubystyle.guide/#fixme
