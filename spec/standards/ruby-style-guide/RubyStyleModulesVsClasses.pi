use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleModulesVsClasses:
    standard: @{RubyStyleGuide}
    ruleId: modules-vs-classes
    title: Turn method-only classes into modules
    statement:
        If a class only provides class methods, make it a module. Use a
        class only when creating instances makes sense.
    rationale:
        A module signals that there is nothing to instantiate.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        class Currency
          def self.display(cents) = '%.2f' % (cents / 100.0)
        end
        \\\
        ```
    compliant:
        ```ruby
        \\\
        module Currency
          def self.display(cents) = '%.2f' % (cents / 100.0)
        end
        \\\
        ```
    languages: [ruby]
    tags: [classes, modules]
    source: https://rubystyle.guide/#modules-vs-classes
