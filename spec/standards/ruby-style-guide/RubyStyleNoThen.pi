use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleNoThen:
    standard: @{RubyStyleGuide}
    ruleId: no-then
    title: Do not use then in multi-line conditionals
    statement:
        Leave out then when an if, unless, when or in branch spans several
        lines.
    rationale:
        The line break already ends the condition, so then is noise.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        if overdue? then
          send_reminder
        end
        \\\
        ```
    compliant:
        ```ruby
        \\\
        if overdue?
          send_reminder
        end
        \\\
        ```
    languages: [ruby]
    tags: [control-flow, conditionals]
    source: https://rubystyle.guide/#no-then
