use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleSpacesIndentation:
    standard: @{RubyStyleGuide}
    ruleId: spaces-indentation
    title: Indent by two spaces per level
    statement:
        Use two spaces for each level of indentation.
    rationale:
        Two spaces is the near-universal Ruby convention, and it keeps
        nested code readable without pushing it far to the right.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        def greet(name)
            puts "Hello, #{name}"
        end
        \\\
        ```
    compliant:
        ```ruby
        \\\
        def greet(name)
          puts "Hello, #{name}"
        end
        \\\
        ```
    languages: [ruby]
    tags: [formatting, indentation]
    source: https://rubystyle.guide/#spaces-indentation
