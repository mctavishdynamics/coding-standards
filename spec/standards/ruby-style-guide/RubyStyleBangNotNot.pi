use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleBangNotNot:
    standard: @{RubyStyleGuide}
    ruleId: bang-not-not
    title: Use the bang operator instead of not
    statement:
        Negate with the exclamation mark operator, not the not keyword.
    rationale:
        The not keyword has unusual precedence and is rarely seen, so it
        surprises readers.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        skip = not enabled?
        \\\
        ```
    compliant:
        ```ruby
        \\\
        skip = !enabled?
        \\\
        ```
    languages: [ruby]
    tags: [control-flow, operators]
    source: https://rubystyle.guide/#bang-not-not
