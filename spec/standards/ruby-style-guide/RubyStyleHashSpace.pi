use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleHashSpace:
    standard: @{RubyStyleGuide}
    ruleId: hash-space
    title: Put one space after the comment hash
    statement:
        Leave exactly one space between the hash sign that starts a comment
        and the comment text. RuboCop checks this with
        Layout/LeadingCommentSpace.
    rationale:
        The space separates the marker from the words and makes comments
        easier to read.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        #retry once before giving up
        \\\
        ```
    compliant:
        ```ruby
        \\\
        # retry once before giving up
        \\\
        ```
    languages: [ruby]
    tags: [comments, formatting]
    source: https://rubystyle.guide/#hash-space
