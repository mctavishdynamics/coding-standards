use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleEnglishIdentifiers:
    standard: @{RubyStyleGuide}
    ruleId: english-identifiers
    title: Choose English names
    statement:
        Choose English words for the names of variables, methods, classes
        and other identifiers.
    rationale:
        English is the shared language of Ruby code and its libraries, so
        English names are readable by the widest set of contributors.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        preco_total = itens.sum(&:preco)
        \\\
        ```
    compliant:
        ```ruby
        \\\
        total_price = items.sum(&:price)
        \\\
        ```
    languages: [ruby]
    tags: [naming]
    source: https://rubystyle.guide/#english-identifiers
