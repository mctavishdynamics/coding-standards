use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleProc:
    standard: @{RubyStyleGuide}
    ruleId: proc
    title: Prefer proc to Proc.new
    statement:
        Create procs with the proc method instead of Proc.new.
    rationale:
        The proc method is shorter and is the common idiom.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        log = Proc.new { |msg| puts msg }
        \\\
        ```
    compliant:
        ```ruby
        \\\
        log = proc { |msg| puts msg }
        \\\
        ```
    languages: [ruby]
    tags: [procs]
    source: https://rubystyle.guide/#proc
