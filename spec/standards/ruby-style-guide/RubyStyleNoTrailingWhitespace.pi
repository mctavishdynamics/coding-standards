use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleNoTrailingWhitespace:
    standard: @{RubyStyleGuide}
    ruleId: no-trailing-whitespace
    title: Strip whitespace from line ends
    statement:
        Do not leave spaces or tabs at the end of a line. Configure the
        editor to show and strip them.
    rationale:
        Trailing whitespace is invisible noise that produces meaningless
        diffs and merge conflicts.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        # the line below ends with two spaces
        total = price * quantity
        \\\
        ```
    compliant:
        ```ruby
        \\\
        total = price * quantity
        \\\
        ```
    languages: [ruby]
    tags: [formatting, whitespace]
    source: https://rubystyle.guide/#no-trailing-whitespace
