use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleSnakeCaseFiles:
    standard: @{RubyStyleGuide}
    ruleId: snake-case-files
    title: Name files in snake case
    statement:
        Give Ruby source files lowercase names with underscores between
        words, such as payment_gateway.rb.
    rationale:
        Snake case file names match what require expects and what
        autoloaders derive from class names.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [ruby]
    tags: [naming, files]
    source: https://rubystyle.guide/#snake-case-files
