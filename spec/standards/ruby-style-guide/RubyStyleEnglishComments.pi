use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleEnglishComments:
    standard: @{RubyStyleGuide}
    ruleId: english-comments
    title: Write comments in English
    statement:
        Write every comment in English. RuboCop checks this with
        Style/AsciiComments.
    rationale:
        English is the shared language of the Ruby community, so English
        comments can be read by any contributor.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        # Calcula el total con impuestos
        def total_with_tax
        \\\
        ```
    compliant:
        ```ruby
        \\\
        # Calculates the total including tax
        def total_with_tax
        \\\
        ```
    languages: [ruby]
    tags: [comments]
    source: https://rubystyle.guide/#english-comments
