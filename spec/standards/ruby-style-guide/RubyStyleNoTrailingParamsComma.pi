use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleNoTrailingParamsComma:
    standard: @{RubyStyleGuide}
    ruleId: no-trailing-params-comma
    title: Avoid a trailing comma after the last method call argument
    statement:
        End a method call's argument list without a dangling comma, above
        all when the whole call sits on a single line.
    rationale:
        A dangling comma on a single line looks like a missing argument.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        send_mail(recipient, subject, body,)
        \\\
        ```
    compliant:
        ```ruby
        \\\
        send_mail(recipient, subject, body)
        \\\
        ```
    languages: [ruby]
    tags: [formatting, method-calls]
    source: https://rubystyle.guide/#no-trailing-params-comma
