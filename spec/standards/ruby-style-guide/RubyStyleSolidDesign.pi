use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleSolidDesign:
    standard: @{RubyStyleGuide}
    ruleId: solid-design
    title: Make classes as SOLID as possible
    statement:
        Aim for classes that follow the SOLID design principles.
    rationale:
        These principles produce classes that are easier to change, extend
        and test.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [ruby]
    tags: [design]
    source: https://rubystyle.guide/#solid-design
