use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleDoNotMixNamedAndNumberedCaptures:
    standard: @{RubyStyleGuide}
    ruleId: do-not-mix-named-and-numbered-captures
    title: Keep each regexp to one capture style
    statement:
        Within one regexp literal, use either named captures or numbered
        captures, not both. RuboCop checks this with
        Lint/MixedRegexpCaptureTypes.
    rationale:
        When names are present, Ruby ignores the unnamed groups as captures,
        so their contents are silently lost.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        m = /(?<user>\w+)@(\w+)/.match(address)
        m[2] # => nil
        \\\
        ```
    compliant:
        ```ruby
        \\\
        m = /(?<user>\w+)@(?<domain>\w+)/.match(address)
        m[:domain]
        \\\
        ```
    languages: [ruby]
    tags: [regex, correctness]
    source: https://rubystyle.guide/#do-not-mix-named-and-numbered-captures
