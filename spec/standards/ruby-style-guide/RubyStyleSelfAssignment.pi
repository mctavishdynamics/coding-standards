use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleSelfAssignment:
    standard: @{RubyStyleGuide}
    ruleId: self-assignment
    title: Use shorthand self-assignment operators
    statement:
        Write an update of a variable from its own value with the combined
        operator, such as plus-equals, wherever one applies.
    rationale:
        The shorthand is shorter and names the variable only once.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        total = total + fee
        retries = retries - 1
        \\\
        ```
    compliant:
        ```ruby
        \\\
        total += fee
        retries -= 1
        \\\
        ```
    languages: [ruby]
    tags: [assignment, operators]
    source: https://rubystyle.guide/#self-assignment
