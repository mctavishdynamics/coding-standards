use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleSpacesOperators:
    standard: @{RubyStyleGuide}
    ruleId: spaces-operators
    title: Space out operators and punctuation
    statement:
        Surround binary operators with a space on each side, and follow
        every comma, colon and semicolon with a space. Leave no spaces
        around the exponent operator, the slash in rational literals or the
        safe navigation operator.
    rationale:
        Ruby mostly ignores whitespace, but consistent spacing is what makes
        expressions easy to read.
    exceptions:
        The exponent operator, the slash in rational literals and the safe
        navigation operator are written without surrounding spaces.
    severity: null
    noncompliant:
        ```ruby
        \\\
        area=width*height
        point = [x,y]
        ratio = 3 / 4r
        squared = n ** 2
        \\\
        ```
    compliant:
        ```ruby
        \\\
        area = width * height
        point = [x, y]
        ratio = 3/4r
        squared = n**2
        name = user&.name
        \\\
        ```
    languages: [ruby]
    tags: [formatting, whitespace, operators]
    source: https://rubystyle.guide/#spaces-operators
