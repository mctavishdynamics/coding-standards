use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleNoSpaceInsideRangeLiterals:
    standard: @{RubyStyleGuide}
    ruleId: no-space-inside-range-literals
    title: Write range literals without inner spaces
    statement:
        Write range literals without spaces around the two or three dots.
    rationale:
        A range is a single literal, and keeping it tight shows that its
        ends belong together.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        hours = 9 .. 17
        letters = 'a' ... 'z'
        \\\
        ```
    compliant:
        ```ruby
        \\\
        hours = 9..17
        letters = 'a'...'z'
        \\\
        ```
    languages: [ruby]
    tags: [formatting, ranges]
    source: https://rubystyle.guide/#no-space-inside-range-literals
