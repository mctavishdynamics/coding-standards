use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleSpaceInBracketsAccess:
    standard: @{RubyStyleGuide}
    ruleId: space-in-brackets-access
    title: Attach index brackets directly to the receiver
    statement:
        Write an index or element access with the opening square bracket
        directly after the receiver.
    rationale:
        A space makes the bracket look like the start of an array literal
        passed as an argument.
    exceptions: null
    severity: null
    noncompliant:
        ```ruby
        \\\
        first = rows [0]
        name = params [:name]
        \\\
        ```
    compliant:
        ```ruby
        \\\
        first = rows[0]
        name = params[:name]
        \\\
        ```
    languages: [ruby]
    tags: [formatting, collections]
    source: https://rubystyle.guide/#space-in-brackets-access
