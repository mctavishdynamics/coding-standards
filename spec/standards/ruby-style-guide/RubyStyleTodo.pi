use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleTodo:
    standard: @{RubyStyleGuide}
    ruleId: todo
    title: Mark missing features with TODO
    statement:
        Use the TODO keyword to flag a feature or piece of functionality
        that still has to be added.
    rationale:
        A common keyword for planned work makes it easy to search for and
        track.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```ruby
        \\\
        # TODO: Support refunds in more than one currency.
        def refund(payment)
        \\\
        ```
    languages: [ruby]
    tags: [comments, annotations]
    source: https://rubystyle.guide/#todo
