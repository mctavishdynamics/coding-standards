use ../lib/CodingRule

from ./RubyStyleGuide import RubyStyleGuide

export coding-rule RubyStyleReview:
    standard: @{RubyStyleGuide}
    ruleId: review
    title: Mark code that needs checking with REVIEW
    statement:
        Use the REVIEW keyword to flag code that someone should look at to
        confirm it behaves as intended.
    rationale:
        It records an open doubt so a reviewer can confirm or correct it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```ruby
        \\\
        # REVIEW: Does the tax office still round each line separately?
        line_tax = (price * rate).round(2)
        \\\
        ```
    languages: [ruby]
    tags: [comments, annotations]
    source: https://rubystyle.guide/#review
