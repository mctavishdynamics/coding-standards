use ../lib/CodingRule

from ./Solid import Solid

export coding-rule SolidOcp:
    standard: @{Solid}
    ruleId: OCP
    title: Keep modules open for extension but closed for modification
    statement:
        Design classes, modules and functions so that new behaviour is added
        by writing new code, such as a new implementation of an abstraction,
        rather than by editing code that already works.
    rationale:
        When one change cascades through dependent modules the program
        becomes rigid, fragile and hard to reuse. Depending on a fixed
        abstraction lets behaviour grow without touching tested code.
    exceptions:
        No significant program can be fully closed, so closure must be
        strategic. The designer chooses the kinds of change most likely to
        happen and closes the design against those.
    severity: null
    noncompliant:
        ```java
        \\\
        double totalArea(List<Object> shapes) {
            double sum = 0;
            for (Object s : shapes) {
                if (s instanceof Circle c) sum += Math.PI * c.r * c.r;
                else if (s instanceof Square q) sum += q.side * q.side;
            }
            return sum;
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        interface Shape {
            double area();
        }

        double totalArea(List<Shape> shapes) {
            double sum = 0;
            for (Shape s : shapes) sum += s.area();
            return sum;
        }
        \\\
        ```
    languages: [any]
    tags: [design, extensibility, abstraction]
    source: https://web.archive.org/web/20101223150909/http://www.objectmentor.com/resources/articles/ocp.pdf
