use ../lib/CodingRule

from ./Solid import Solid

export coding-rule SolidOcp:
    standard: @{Solid}
    ruleId: OCP
    title: Extend behavior by adding code rather than editing it
    statement:
        Structure classes, modules and functions so that new behavior
        arrives as new code, for example another implementation of an
        existing abstraction, while working code stays untouched.
    rationale:
        If a single change ripples through many dependent modules, the
        design becomes rigid, fragile and difficult to reuse. Code that
        depends on a stable abstraction can gain behavior without disturbing
        tested parts.
    exceptions:
        Complete closure is impossible in any real program, so it has to be
        applied strategically. The designer predicts which kinds of change
        are most likely and protects the design against those.
    severity: null
    noncompliant:
        ```java
        \\\
        double totalArea(List<Object> shapes) {
            double sum = 0;
            for (Object s : shapes) {
                if (s instanceof Circle c) sum += Math.PI * c.r * c.r;
                else if (s instanceof Square q) sum += q.side * q.side;
            }
            return sum;
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        interface Shape {
            double area();
        }

        double totalArea(List<Shape> shapes) {
            double sum = 0;
            for (Shape s : shapes) sum += s.area();
            return sum;
        }
        \\\
        ```
    languages: [any]
    tags: [design, extensibility, abstraction]
    source: https://web.archive.org/web/20101223150909/http://www.objectmentor.com/resources/articles/ocp.pdf
