use ../lib/CodingRule

from ./Solid import Solid

export coding-rule SolidSrp:
    standard: @{Solid}
    ruleId: SRP
    title: Give a class a single reason to change
    statement:
        Each class should have exactly one reason to change. Treat each
        responsibility as a separate axis of change, and split code that
        changes for unrelated reasons, like managing a connection and moving
        data over it, into separate classes or at minimum separate
        interfaces.
    rationale:
        Bundling responsibilities into one class couples them, so editing
        one can break another and the design becomes fragile in surprising
        ways.
    exceptions:
        An axis of change is only worth separating if changes along it
        really happen. When hardware or platform constraints force several
        responsibilities into one implementation class, keeping their
        interfaces separate still decouples the clients.
    severity: null
    noncompliant:
        ```java
        \\\
        class Invoice {
            Money total() { /* pricing rules */ }
            String toHtml() { /* page layout */ }
            void save(Connection db) { /* SQL */ }
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        class Invoice {
            Money total() { /* pricing rules */ }
        }

        class InvoiceHtmlView {
            String render(Invoice invoice) { /* page layout */ }
        }

        class InvoiceRepository {
            void save(Invoice invoice) { /* SQL */ }
        }
        \\\
        ```
    languages: [any]
    tags: [design, cohesion, classes]
    source: https://web.archive.org/web/20110104023258/http://www.objectmentor.com/resources/articles/srp.pdf
