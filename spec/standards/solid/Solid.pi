use ../lib/CodingStandard

from ./SolidDip import SolidDip
from ./SolidIsp import SolidIsp
from ./SolidLsp import SolidLsp
from ./SolidOcp import SolidOcp
from ./SolidSrp import SolidSrp

export coding-standard Solid:
    title: SOLID Principles of Object-Oriented Design
    publisher: Robert C. Martin
    url: https://web.archive.org/web/20151122035331/http://butunclebob.com/ArticleS.UncleBob.PrinciplesOfOod
    version: null
    license: Copyright Robert C. Martin, all rights reserved
    description:
        The five principles of object-oriented class design described by
        Robert C. Martin, which focus on managing dependencies so that code
        stays flexible, robust and reusable.
    rules:
        - @{SolidSrp}
        - @{SolidOcp}
        - @{SolidLsp}
        - @{SolidIsp}
        - @{SolidDip}
