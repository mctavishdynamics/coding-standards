use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamingParameters2:
    standard: @{DotnetDesignGuidelines}
    ruleId: naming-parameters-2
    title: Choose parameter names that describe the argument
    statement:
        Make parameter names descriptive enough that a caller knows what to
        pass from the name and type alone.
    rationale:
        In most cases the parameter name and its type are all the
        documentation a caller sees in the editor.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public void Resize(int a, int b) { }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public void Resize(int widthInPixels, int heightInPixels) { }
        \\\
        ```
    languages: [csharp]
    tags: [do, naming, parameters]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/naming-parameters
