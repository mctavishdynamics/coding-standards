use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgSerialization5:
    standard: @{DotnetDesignGuidelines}
    ruleId: serialization-5
    title: Prefer data contracts for ordinary persistence
    statement:
        For ordinary persistence, prefer data contract serialization to
        runtime or XML serialization.
    rationale:
        The other mechanisms are more specialized and carry more constraints
        and risks.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [avoid, usage, serialization]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/serialization#choosing-the-right-serialization-technology-to-support
