use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamingParameters3:
    standard: @{DotnetDesignGuidelines}
    ruleId: naming-parameters-3
    title: Consider naming parameters by meaning, not type
    statement:
        Base a parameter's name on what the argument means to the method
        rather than on its type.
    rationale:
        The type is visible in the signature already, while the role usually
        is not.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public void Send(string string1, TimeSpan timeSpan) { }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public void Send(string message, TimeSpan timeout) { }
        \\\
        ```
    languages: [csharp]
    tags: [consider, naming, parameters]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/naming-parameters
