use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgExtensionMethods5:
    standard: @{DotnetDesignGuidelines}
    ruleId: extension-methods-5
    title: Avoid duplicate extension method signatures
    statement:
        Two extension methods must not share the same signature, wherever
        they are declared.
    rationale:
        Importing both namespaces makes calls ambiguous and fails to
        compile.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [avoid, member-design, extension-methods, conflicts]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/extension-methods
