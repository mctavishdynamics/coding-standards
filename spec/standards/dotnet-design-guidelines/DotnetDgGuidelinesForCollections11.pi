use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGuidelinesForCollections11:
    standard: @{DotnetDesignGuidelines}
    ruleId: guidelines-for-collections-11
    title: Consider subclasses of generic collections over the bases
    statement:
        Think about deriving a named collection type rather than exposing
        Collection of T or ReadOnlyCollection of T directly, especially in
        high-level APIs.
    rationale:
        A subclass gets a domain name and room for helper members.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```csharp
        \\\
        public class PassengerCollection : Collection<Passenger>
        {
            public Passenger FindBySeat(string seat) => Items.FirstOrDefault(p => p.Seat == seat);
        }
        \\\
        ```
    languages: [csharp]
    tags: [consider, collections]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/guidelines-for-collections#collection-properties-and-return-values
