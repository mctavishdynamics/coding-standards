use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgEnum6:
    standard: @{DotnetDesignGuidelines}
    ruleId: enum-6
    title: Leave boundary markers out of enums
    statement:
        Do not add members such as LastValue or Count that mark a boundary
        rather than a real value.
    rationale:
        Sentinels help the implementer track ranges but confuse users, who
        see them as valid choices.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public enum Weekday { Monday, Tuesday, Wednesday, Thursday, Friday, MaxValue }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public enum Weekday { Monday, Tuesday, Wednesday, Thursday, Friday }
        \\\
        ```
    languages: [csharp]
    tags: [do-not, type-design, enums]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/enum
