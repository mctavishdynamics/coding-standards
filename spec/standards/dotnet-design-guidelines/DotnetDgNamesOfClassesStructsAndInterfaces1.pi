use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfClassesStructsAndInterfaces1:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-classes-structs-and-interfaces-1
    title: Name classes and structs as PascalCase nouns
    statement:
        A class or struct name should be a noun or noun phrase written in
        PascalCase.
    rationale:
        Types are things and methods are actions, so noun type names and
        verb method names keep the two easy to tell apart.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public class CalculateTax { }
        public struct paint_color { }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public class TaxCalculator { }
        public struct PaintColor { }
        \\\
        ```
    languages: [csharp]
    tags: [do, naming, types]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-classes-structs-and-interfaces
