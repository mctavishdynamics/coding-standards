use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGuidelinesForCollections29:
    standard: @{DotnetDesignGuidelines}
    ruleId: guidelines-for-collections-29
    title: Avoid implementation suffixes on collection abstractions
    statement:
        Name a collection abstraction for what it holds, not for the data
        structure behind it; words like LinkedList or Hashtable do not
        belong in such names.
    rationale:
        Those names tie the abstraction to a particular implementation that
        may change.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public class SessionHashtable : IDictionary<Guid, Session> { }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public class SessionDictionary : IDictionary<Guid, Session> { }
        \\\
        ```
    languages: [csharp]
    tags: [avoid, collections, naming]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/guidelines-for-collections#naming-custom-collections
