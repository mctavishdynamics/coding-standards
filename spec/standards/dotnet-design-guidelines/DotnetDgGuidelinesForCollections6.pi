use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGuidelinesForCollections6:
    standard: @{DotnetDesignGuidelines}
    ruleId: guidelines-for-collections-6
    title: Accept the least specialized collection type as a parameter
    statement:
        Type collection parameters as generally as possible, usually
        IEnumerable of T.
    rationale:
        Callers can then pass arrays, lists, query results or any other
        sequence.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public void Import(List<Contact> contacts) { }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public void Import(IEnumerable<Contact> contacts) { }
        \\\
        ```
    languages: [csharp]
    tags: [do, collections, parameters]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/guidelines-for-collections#collection-parameters
