use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgStruct1:
    standard: @{DotnetDesignGuidelines}
    ruleId: struct-1
    title: Do not give structs a parameterless constructor
    statement:
        Do not declare a default constructor on a struct.
    rationale:
        Without one, arrays and default values of the struct can be created
        without running code for each element, and default behaves as
        everyone expects.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public struct Counter
        {
            public Counter() { Value = 1; }
            public int Value { get; }
        }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public readonly struct Counter
        {
            public Counter(int value) { Value = value; }
            public int Value { get; }
        }
        \\\
        ```
    languages: [csharp]
    tags: [do-not, type-design, structs, constructors]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/struct
