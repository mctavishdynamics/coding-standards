use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgSerialization15:
    standard: @{DotnetDesignGuidelines}
    ruleId: serialization-15
    title: Consider ISerializable for complete control of runtime serialization
    statement:
        Implement ISerializable with a deserialization constructor when you
        need to transform data while it is serialized or deserialized.
    rationale:
        The pattern hands you the whole process instead of the default
        field-by-field copy.
    exceptions:
        Runtime serialization with BinaryFormatter is obsolete and insecure
        in modern .NET.
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [consider, usage, serialization]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/serialization#supporting-runtime-serialization
