use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgUsingStandardExceptionTypes1:
    standard: @{DotnetDesignGuidelines}
    ruleId: using-standard-exception-types-1
    title: Throw specific exception types, not the root types
    statement:
        Throw a specific exception type rather than the general Exception or
        SystemException base classes.
    rationale:
        Callers cannot tell a general exception apart from any other
        failure, so they cannot handle it selectively.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        throw new Exception("Configuration file is missing.");
        \\\
        ```
    compliant:
        ```csharp
        \\\
        throw new FileNotFoundException("Configuration file is missing.", configPath);
        \\\
        ```
    languages: [csharp]
    tags: [do-not, exceptions, exception-types]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/using-standard-exception-types#exception-and-systemexception
