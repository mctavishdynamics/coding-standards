use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfTypeMembers4:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-type-members-4
    title: Use plural names for collection properties
    statement:
        Name a property that holds a collection with a plural that describes
        its items, rather than a singular word plus List or Collection.
    rationale:
        The plural is shorter and describes the content instead of the
        container type.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public IList<Attachment> AttachmentList { get; }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public IList<Attachment> Attachments { get; }
        \\\
        ```
    languages: [csharp]
    tags: [do, naming, properties, collections]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-type-members#names-of-properties
