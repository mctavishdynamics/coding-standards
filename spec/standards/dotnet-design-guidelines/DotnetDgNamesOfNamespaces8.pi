use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfNamespaces8:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-namespaces-8
    title: Keep type names unique within one application model
    statement:
        Types spread across the namespaces of a single application model,
        such as one UI framework, should each have a distinct name.
    rationale:
        Code built on one application model imports its namespaces together,
        so duplicates force qualification.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do-not, naming, namespaces, conflicts]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-namespaces#namespaces-and-type-name-conflicts
