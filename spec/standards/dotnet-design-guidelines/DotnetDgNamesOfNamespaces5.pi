use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfNamespaces5:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-namespaces-5
    title: Consider plural namespace names for groups of similar types
    statement:
        Use a plural namespace name when it gathers many types of one kind.
        Acronyms and brand names are left as they are.
    rationale:
        The plural describes a namespace that is a collection of related
        types.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        namespace Fabrikam.Shipping.Carrier;
        \\\
        ```
    compliant:
        ```csharp
        \\\
        namespace Fabrikam.Shipping.Carriers;
        \\\
        ```
    languages: [csharp]
    tags: [consider, naming, namespaces]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-namespaces
