use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgSealing1:
    standard: @{DotnetDesignGuidelines}
    ruleId: sealing-1
    title: Seal classes only for a good reason
    statement:
        Do not seal a class just because you cannot think of a reason to
        extend it. Valid reasons include static classes, protected members
        holding secrets, many inherited virtual members whose cost you want
        to cut, and attributes that need fast lookup.
    rationale:
        Users inherit for reasons the author did not foresee, and sealing
        blocks them for no benefit.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do-not, extensibility, sealing]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/sealing
