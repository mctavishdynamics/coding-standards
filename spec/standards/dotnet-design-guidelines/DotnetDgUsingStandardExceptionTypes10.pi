use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgUsingStandardExceptionTypes10:
    standard: @{DotnetDesignGuidelines}
    ruleId: using-standard-exception-types-10
    title: Do not throw StackOverflowException
    statement:
        Never throw StackOverflowException yourself; only the runtime raises
        it.
    rationale:
        Throwing it misrepresents what happened and confuses diagnostics.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do-not, exceptions, exception-types]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/using-standard-exception-types#stackoverflowexception
