use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGeneralNamingConventions7:
    standard: @{DotnetDesignGuidelines}
    ruleId: general-naming-conventions-7
    title: Use only well-known acronyms, and only when needed
    statement:
        Put an acronym into a name only if most readers will recognize it,
        and only when the spelled-out form would be clumsy.
    rationale:
        An obscure acronym hides the meaning from anyone outside the
        author's team.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public decimal ComputeMRR(Account account) { /* ... */ }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public decimal ComputeMonthlyRecurringRevenue(Account account) { /* ... */ }
        \\\
        ```
    languages: [csharp]
    tags: [do-not, naming, abbreviations]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/general-naming-conventions#using-abbreviations-and-acronyms
