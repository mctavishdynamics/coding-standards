use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfNamespaces11:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-namespaces-11
    title: Avoid clashes between technology and application model types
    statement:
        Technology namespaces and application model namespaces should not
        both contain a type with the same name, unless the technology is
        never meant for use with that model.
    rationale:
        Technologies are often used from inside an application model, and a
        shared name would force qualification there.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do-not, naming, namespaces, conflicts]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-namespaces#namespaces-and-type-name-conflicts
