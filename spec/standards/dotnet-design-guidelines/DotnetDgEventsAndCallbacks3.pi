use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgEventsAndCallbacks3:
    standard: @{DotnetDesignGuidelines}
    ruleId: events-and-callbacks-3
    title: Favor events when either an event or a delegate would do
    statement:
        When either would work, expose an event rather than a raw delegate
        parameter or property.
    rationale:
        More developers know events, and tools such as IntelliSense support
        them directly.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public Action<Message> MessageCallback { get; set; }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public event EventHandler<MessageEventArgs> MessageReceived;
        \\\
        ```
    languages: [csharp]
    tags: [do, extensibility, events, callbacks]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/events-and-callbacks
