use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfAssembliesAndDlls2:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-assemblies-and-dlls-2
    title: Consider a company-then-component pattern for DLL names
    statement:
        Think about naming a DLL with the company first, followed by one or
        more dot-separated component parts, as in
        Fabrikam.Reporting.Charts.dll.
    rationale:
        Leading with the company avoids clashes with other vendors, and the
        component parts line up with the namespaces.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [consider, naming, assemblies]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-assemblies-and-dlls
