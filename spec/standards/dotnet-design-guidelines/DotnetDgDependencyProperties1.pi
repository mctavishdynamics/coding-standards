use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgDependencyProperties1:
    standard: @{DotnetDesignGuidelines}
    ruleId: dependency-properties-1
    title: Use dependency properties for properties that need WPF features
    statement:
        Implement a property as a dependency property when it must work with
        WPF styling, triggers, data binding, animation, dynamic resources or
        value inheritance.
    rationale:
        Those features operate only on dependency properties, not on
        ordinary CLR properties.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```csharp
        \\\
        public static readonly DependencyProperty AccentBrushProperty =
            DependencyProperty.Register(nameof(AccentBrush), typeof(Brush), typeof(Gauge));

        public Brush AccentBrush
        {
            get => (Brush)GetValue(AccentBrushProperty);
            set => SetValue(AccentBrushProperty, value);
        }
        \\\
        ```
    languages: [csharp]
    tags: [do, dependency-properties, wpf]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/dependency-properties
