use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGeneralNamingConventions11:
    standard: @{DotnetDesignGuidelines}
    ruleId: general-naming-conventions-11
    title: Keep a replacement API's name close to the original
    statement:
        When releasing a newer version of an existing API, give it a name
        that resembles the one it supersedes.
    rationale:
        The resemblance signals to readers that the two belong together.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do, naming, versioning]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/general-naming-conventions#naming-new-versions-of-existing-apis
