use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGuidelinesForCollections21:
    standard: @{DotnetDesignGuidelines}
    ruleId: guidelines-for-collections-21
    title: Consider deriving new collections from the generic base collections
    statement:
        When creating a new collection type, think about inheriting from
        Collection, ReadOnlyCollection or KeyedCollection.
    rationale:
        These bases supply the standard behavior and the right extension
        points.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```csharp
        \\\
        public class RouteCollection : Collection<Route> { }
        \\\
        ```
    languages: [csharp]
    tags: [consider, collections, inheritance]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/guidelines-for-collections#implementing-custom-collections
