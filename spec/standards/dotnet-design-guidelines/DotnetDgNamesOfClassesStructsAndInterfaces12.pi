use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfClassesStructsAndInterfaces12:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-classes-structs-and-interfaces-12
    title: Give ordinary enums singular names
    statement:
        Name an enum in the singular unless its values are bit flags.
    rationale:
        A variable of the enum type holds one of its values, so the singular
        reads correctly.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public enum Priorities { Low, Normal, High }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public enum Priority { Low, Normal, High }
        \\\
        ```
    languages: [csharp]
    tags: [do, naming, enums]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-classes-structs-and-interfaces#naming-enumerations
