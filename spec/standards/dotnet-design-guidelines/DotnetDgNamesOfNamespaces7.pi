use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfNamespaces7:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-namespaces-7
    title: Qualify very general type names
    statement:
        Avoid bare, all-purpose type names and add a qualifier that says
        what kind of thing it is.
    rationale:
        Generic names collide easily with types from other namespaces
        imported in the same file.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public class Item { }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public class CartItem { }
        \\\
        ```
    languages: [csharp]
    tags: [do-not, naming, namespaces, conflicts]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-namespaces#namespaces-and-type-name-conflicts
