use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGeneralNamingConventions1:
    standard: @{DotnetDesignGuidelines}
    ruleId: general-naming-conventions-1
    title: Pick names that read as natural English
    statement:
        Order the words of an identifier the way a person would say them, so
        the name reads like a phrase.
    rationale:
        A name that reads naturally is understood at a glance and is easier
        to recall later.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public Color ColorBackground { get; set; }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public Color BackgroundColor { get; set; }
        \\\
        ```
    languages: [csharp]
    tags: [do, naming, readability]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/general-naming-conventions#word-choice
