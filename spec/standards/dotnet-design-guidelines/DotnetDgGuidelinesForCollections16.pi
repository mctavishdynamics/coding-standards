use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGuidelinesForCollections16:
    standard: @{DotnetDesignGuidelines}
    ruleId: guidelines-for-collections-16
    title: Use a snapshot or live enumerable for volatile collections
    statement:
        For collections that can change on their own, such as files in a
        directory, return either a snapshot or a live forward-only
        IEnumerable.
    rationale:
        Such collections are very hard to expose as live indexable lists,
        because their content may change at any time.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```csharp
        \\\
        public IReadOnlyList<string> GetQueuedFiles() => Directory.GetFiles(_queuePath);   // snapshot
        public IEnumerable<string> EnumerateQueuedFiles() => Directory.EnumerateFiles(_queuePath);
        \\\
        ```
    languages: [csharp]
    tags: [do, collections, enumeration]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/guidelines-for-collections#snapshots-versus-live-collections
