use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGuidelinesForCollections1:
    standard: @{DotnetDesignGuidelines}
    ruleId: guidelines-for-collections-1
    title: Expose strongly typed collections
    statement:
        Public collection members should use the exact item type for items
        they accept or return, not object or another base type.
    rationale:
        Strong typing lets the compiler catch mistakes and spares callers
        from casting.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public ArrayList Recipients { get; }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public Collection<MailAddress> Recipients { get; }
        \\\
        ```
    languages: [csharp]
    tags: [do-not, collections, type-safety]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/guidelines-for-collections
