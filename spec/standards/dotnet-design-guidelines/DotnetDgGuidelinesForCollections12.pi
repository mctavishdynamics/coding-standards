use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGuidelinesForCollections12:
    standard: @{DotnetDesignGuidelines}
    ruleId: guidelines-for-collections-12
    title: Consider returning collection subclasses from heavily used members
    statement:
        For methods and properties used very often, think about returning a
        subclass of Collection of T or ReadOnlyCollection of T.
    rationale:
        You keep the freedom to add helpers or change the implementation
        later without breaking callers.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [consider, collections, versioning]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/guidelines-for-collections#collection-properties-and-return-values
