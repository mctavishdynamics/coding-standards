use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGeneralNamingConventions14:
    standard: @{DotnetDesignGuidelines}
    ruleId: general-naming-conventions-14
    title: Append a number when no better name for a new version exists
    statement:
        Use a numeric marker such as 2 for a new version when the existing
        name is the only reasonable one, for instance because it is a
        standard term, and neither a descriptive suffix nor a new name
        works.
    rationale:
        The number keeps the recognized name while still telling the
        versions apart.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public class OAuthTokenNew : OAuthToken { }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public class OAuthToken2 : OAuthToken { }
        \\\
        ```
    languages: [csharp]
    tags: [do, naming, versioning]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/general-naming-conventions#naming-new-versions-of-existing-apis
