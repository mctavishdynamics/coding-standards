use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgDependencyProperties9:
    standard: @{DotnetDesignGuidelines}
    ruleId: dependency-properties-9
    title: Validate dependency properties with a registration callback
    statement:
        Supply a validation callback when registering the dependency
        property, and do not check values inside the wrapper accessors.
    rationale:
        Validation in the wrapper is skipped whenever WPF sets the value
        directly.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        set
        {
            if (value < 0) throw new ArgumentOutOfRangeException(nameof(value));
            SetValue(MaximumProperty, value);
        }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        DependencyProperty.Register(nameof(Maximum), typeof(double), typeof(Gauge),
            new PropertyMetadata(100.0), v => (double)v >= 0);
        \\\
        ```
    languages: [csharp]
    tags: [do-not, dependency-properties, wpf, validation]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/dependency-properties#dependency-property-validation
