use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgConstructor1:
    standard: @{DotnetDesignGuidelines}
    ruleId: constructor-1
    title: Consider simple constructors, ideally parameterless
    statement:
        Offer constructors with few parameters, all of them primitives or
        enums, and ideally a parameterless one.
    rationale:
        Simple constructors make a type easy to start using.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```csharp
        \\\
        var client = new MailClient();
        var limited = new MailClient(maxRetries: 3);
        \\\
        ```
    languages: [csharp]
    tags: [consider, member-design, constructors, usability]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/constructor
