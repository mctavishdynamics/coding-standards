use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgDisposePattern18:
    standard: @{DotnetDesignGuidelines}
    ruleId: dispose-pattern-18
    title: Contain exceptions inside finalizers
    statement:
        Handle or prevent exceptions in code that runs during finalization,
        unless the failure is critical to the system.
    rationale:
        An unhandled exception in a finalizer terminates the whole process,
        so other finalizers never run.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```csharp
        \\\
        ~TempDirectory()
        {
            try { Directory.Delete(_path, recursive: true); }
            catch (IOException) { /* best effort during finalization */ }
        }
        \\\
        ```
    languages: [csharp]
    tags: [do-not, dispose, finalizers, exceptions]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/dispose-pattern#finalizable-types
