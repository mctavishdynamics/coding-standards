use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgExceptionsAndPerformance5:
    standard: @{DotnetDesignGuidelines}
    ruleId: exceptions-and-performance-5
    title: Pair every Try method with a throwing version
    statement:
        For each Try-Parse member, also offer a member that does the same
        work and throws on failure.
    rationale:
        Callers who expect success can then write simpler code and still get
        a detailed error when it fails.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```csharp
        \\\
        public static Coordinates Parse(string text) { /* throws FormatException */ }
        public static bool TryParse(string text, out Coordinates result) { /* ... */ }
        \\\
        ```
    languages: [csharp]
    tags: [do, exceptions, patterns]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/exceptions-and-performance#try-parse-pattern
