use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgProperty14:
    standard: @{DotnetDesignGuidelines}
    ruleId: property-14
    title: Do not use non-default indexed properties
    statement:
        Do not declare indexed properties other than the type's default
        indexer.
    rationale:
        Several languages cannot consume them, and C# does not allow
        declaring them.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do-not, member-design, indexers, interoperability]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/property#indexed-property-design
