use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGuidelinesForCollections24:
    standard: @{DotnetDesignGuidelines}
    ruleId: guidelines-for-collections-24
    title: Avoid collection interfaces on types that are not really collections
    statement:
        Do not implement collection interfaces on types whose main API has
        little to do with being a collection.
    rationale:
        Collection members clutter such types and confuse users about what
        the type is.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public class HttpServer : IEnumerable<Connection>
        {
            public void Start() { /* ... */ }
            public void Stop() { /* ... */ }
            public IEnumerator<Connection> GetEnumerator() { /* ... */ }
        }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public class HttpServer
        {
            public void Start() { /* ... */ }
            public void Stop() { /* ... */ }
            public IReadOnlyCollection<Connection> Connections { get; }
        }
        \\\
        ```
    languages: [csharp]
    tags: [avoid, collections, interfaces]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/guidelines-for-collections#implementing-custom-collections
