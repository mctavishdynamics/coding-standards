use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGuidelinesForCollections27:
    standard: @{DotnetDesignGuidelines}
    ruleId: guidelines-for-collections-27
    title: End list-like collection type names with Collection
    statement:
        Name types that implement IEnumerable and represent a list of items
        with a Collection suffix.
    rationale:
        Users recognize the suffix and know what to expect from the type.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public class ShipmentList : Collection<Shipment> { }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public class ShipmentCollection : Collection<Shipment> { }
        \\\
        ```
    languages: [csharp]
    tags: [do, collections, naming]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/guidelines-for-collections#naming-custom-collections
