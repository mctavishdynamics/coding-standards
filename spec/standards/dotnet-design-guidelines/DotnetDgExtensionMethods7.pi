use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgExtensionMethods7:
    standard: @{DotnetDesignGuidelines}
    ruleId: extension-methods-7
    title: Put feature extension methods in that feature's namespace
    statement:
        Place extension methods that implement a feature in the namespace of
        that feature, not in a namespace that belongs to something else.
    rationale:
        Callers find feature methods by importing the feature, and unrelated
        namespaces stay uncluttered.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do-not, member-design, extension-methods, namespaces]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/extension-methods
