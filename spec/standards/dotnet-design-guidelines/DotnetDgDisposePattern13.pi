use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgDisposePattern13:
    standard: @{DotnetDesignGuidelines}
    ruleId: dispose-pattern-13
    title: Do not give value types finalizers
    statement:
        Never try to make a struct finalizable.
    rationale:
        The runtime only finalizes reference types, so the finalizer would
        never run; C# rejects it anyway.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do-not, dispose, finalizers, structs]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/dispose-pattern#finalizable-types
