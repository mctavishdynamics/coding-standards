use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgProtectedMembers2:
    standard: @{DotnetDesignGuidelines}
    ruleId: protected-members-2
    title: Treat protected members of unsealed classes as public
    statement:
        Apply the same security review, documentation and compatibility care
        to protected members of unsealed classes as to public ones.
    rationale:
        Anyone can derive from the class and call them, so they are part of
        the public contract.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do, extensibility, accessibility, versioning]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/protected-members
