use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgAbstractionsAbstractTypesAndInterfaces1:
    standard: @{DotnetDesignGuidelines}
    ruleId: abstractions-abstract-types-and-interfaces-1
    title: Prove an abstraction with real implementations and consumers
    statement:
        Do not ship an abstraction until several concrete implementations
        and APIs that use it have been built against it.
    rationale:
        An untested abstraction is very likely to be missing members or to
        have the wrong shape.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do-not, extensibility, abstraction, validation]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/abstractions-abstract-types-and-interfaces
