use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfClassesStructsAndInterfaces5:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-classes-structs-and-interfaces-5
    title: Begin interface names with I
    statement:
        Put a capital I in front of every interface name so it is
        recognizable as an interface.
    rationale:
        The prefix is the long-standing .NET convention and lets readers
        tell interfaces from classes at a glance.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public interface Cacheable { TimeSpan Lifetime { get; } }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public interface ICacheable { TimeSpan Lifetime { get; } }
        \\\
        ```
    languages: [csharp]
    tags: [do, naming, interfaces]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-classes-structs-and-interfaces
