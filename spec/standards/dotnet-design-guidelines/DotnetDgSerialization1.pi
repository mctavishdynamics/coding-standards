use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgSerialization1:
    standard: @{DotnetDesignGuidelines}
    ruleId: serialization-1
    title: Plan for serialization when designing new types
    statement:
        Decide early whether and how a new type will be serialized.
    rationale:
        Retrofitting serialization later often forces awkward changes to the
        type's shape and compatibility.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do, usage, serialization]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/serialization
