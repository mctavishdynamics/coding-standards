use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGuidelinesForCollections26:
    standard: @{DotnetDesignGuidelines}
    ruleId: guidelines-for-collections-26
    title: End dictionary type names with Dictionary
    statement:
        Name abstractions that implement IDictionary with a Dictionary
        suffix.
    rationale:
        The suffix tells callers the type maps keys to values.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public class TranslationMap : IDictionary<string, string> { }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public class TranslationDictionary : IDictionary<string, string> { }
        \\\
        ```
    languages: [csharp]
    tags: [do, collections, naming, dictionaries]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/guidelines-for-collections#naming-custom-collections
