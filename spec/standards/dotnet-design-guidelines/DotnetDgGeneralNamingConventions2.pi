use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGeneralNamingConventions2:
    standard: @{DotnetDesignGuidelines}
    ruleId: general-naming-conventions-2
    title: Prefer a clear name to a short one
    statement:
        When brevity and clarity pull in different directions, choose the
        name that says plainly what the thing does, even if it is longer.
    rationale:
        Extra characters are cheap to type, while a cryptic name slows down
        everyone who reads the code.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public bool AutoRfsh { get; set; }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public bool RefreshesAutomatically { get; set; }
        \\\
        ```
    languages: [csharp]
    tags: [do, naming, readability]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/general-naming-conventions#word-choice
