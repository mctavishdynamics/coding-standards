use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfNamespaces4:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-namespaces-4
    title: Write namespace parts in PascalCase separated by dots
    statement:
        Capitalize each word of each namespace part and join the parts with
        periods. A brand with its own distinctive casing keeps that casing.
    rationale:
        This matches the framework's namespaces and keeps names predictable.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        namespace fabrikam.order_history;
        \\\
        ```
    compliant:
        ```csharp
        \\\
        namespace Fabrikam.OrderHistory;
        \\\
        ```
    languages: [csharp]
    tags: [do, naming, namespaces, capitalization]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-namespaces
