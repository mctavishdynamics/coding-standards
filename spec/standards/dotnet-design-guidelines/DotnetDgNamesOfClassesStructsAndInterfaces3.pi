use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfClassesStructsAndInterfaces3:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-classes-structs-and-interfaces-3
    title: Leave prefixes off class names
    statement:
        Do not start class names with a marker letter such as C or any other
        prefix.
    rationale:
        A prefix adds nothing the language does not already show and departs
        from framework naming.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public class CPrinterQueue { }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public class PrinterQueue { }
        \\\
        ```
    languages: [csharp]
    tags: [do-not, naming, types]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-classes-structs-and-interfaces
