use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgEnum4:
    standard: @{DotnetDesignGuidelines}
    ruleId: enum-4
    title: Do not add reserved enum values for future use
    statement:
        Do not include placeholder members meant to be used later; add real
        values when they are needed.
    rationale:
        Placeholder members mix fake choices in with real ones, and callers
        end up passing them by accident.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public enum Codec { H264, Vp9, Reserved1, Reserved2 }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public enum Codec { H264, Vp9 }
        \\\
        ```
    languages: [csharp]
    tags: [do-not, type-design, enums, versioning]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/enum
