use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgCapitalizationConventions2:
    standard: @{DotnetDesignGuidelines}
    ruleId: capitalization-conventions-2
    title: Start parameter names in lower case
    statement:
        Give parameters a lower-case first word, with each later word
        capitalized.
    rationale:
        Parameter names appear in signatures, tooltips and named arguments,
        and a distinct casing keeps them visibly separate from type members.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public void Schedule(DateTime StartTime, int retry_limit) { }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public void Schedule(DateTime startTime, int retryLimit) { }
        \\\
        ```
    languages: [csharp]
    tags: [do, naming, capitalization, parameters]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/capitalization-conventions#capitalization-rules-for-identifiers
