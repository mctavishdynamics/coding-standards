use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgInterface3:
    standard: @{DotnetDesignGuidelines}
    ruleId: interface-3
    title: Avoid interfaces with no members
    statement:
        Do not use empty marker interfaces to tag types with a
        characteristic; use a custom attribute for that in most cases.
    rationale:
        Attributes are made for metadata, while an empty interface clutters
        the type hierarchy without defining a contract.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public interface IExportable { }

        public class Report : IExportable { }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        [AttributeUsage(AttributeTargets.Class)]
        public sealed class ExportableAttribute : Attribute { }

        [Exportable]
        public class Report { }
        \\\
        ```
    languages: [csharp]
    tags: [avoid, type-design, interfaces, attributes]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/interface
