use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfAssembliesAndDlls1:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-assemblies-and-dlls-1
    title: Give assemblies broad functional names
    statement:
        Name an assembly for the wide area of functionality it provides. A
        sensible default is the namespace prefix shared by the types inside
        it.
    rationale:
        Assemblies are deployment units, and a broad name stays accurate as
        individual types move around.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do, naming, assemblies]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-assemblies-and-dlls
