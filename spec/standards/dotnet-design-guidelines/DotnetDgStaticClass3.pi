use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgStaticClass3:
    standard: @{DotnetDesignGuidelines}
    ruleId: static-class-3
    title: Keep static classes free of instance members
    statement:
        A static class must not declare or override instance members.
    rationale:
        No instance of the class can ever exist, so instance members could
        never be called.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do-not, type-design, static-classes]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/static-class
