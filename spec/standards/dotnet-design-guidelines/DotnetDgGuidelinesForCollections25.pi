use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGuidelinesForCollections25:
    standard: @{DotnetDesignGuidelines}
    ruleId: guidelines-for-collections-25
    title: Do not inherit from non-generic base collections
    statement:
        Use Collection, ReadOnlyCollection or KeyedCollection instead of
        CollectionBase and other non-generic bases.
    rationale:
        The non-generic bases are weakly typed and outdated.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public class InvoiceCollection : CollectionBase { }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public class InvoiceCollection : Collection<Invoice> { }
        \\\
        ```
    languages: [csharp]
    tags: [do-not, collections, inheritance]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/guidelines-for-collections#implementing-custom-collections
