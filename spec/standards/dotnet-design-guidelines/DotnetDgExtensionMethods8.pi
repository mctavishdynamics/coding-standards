use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgExtensionMethods8:
    standard: @{DotnetDesignGuidelines}
    ruleId: extension-methods-8
    title: Give extension namespaces descriptive names, not Extensions
    statement:
        Name a namespace that holds extension methods after what they do
        rather than calling it Extensions.
    rationale:
        A generic name says nothing about the functionality the import
        brings in.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        namespace Fabrikam.Extensions;
        \\\
        ```
    compliant:
        ```csharp
        \\\
        namespace Fabrikam.Caching;
        \\\
        ```
    languages: [csharp]
    tags: [avoid, member-design, extension-methods, naming]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/extension-methods
