use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfClassesStructsAndInterfaces14:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-classes-structs-and-interfaces-14
    title: Leave Enum out of enum type names
    statement:
        Do not add Enum to the end of an enum's name.
    rationale:
        The declaration already says it is an enum, and the suffix only
        lengthens every use.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public enum ShippingMethodEnum { Ground, Air }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public enum ShippingMethod { Ground, Air }
        \\\
        ```
    languages: [csharp]
    tags: [do-not, naming, enums]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-classes-structs-and-interfaces#naming-enumerations
