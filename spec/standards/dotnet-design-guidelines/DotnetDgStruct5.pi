use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgStruct5:
    standard: @{DotnetDesignGuidelines}
    ruleId: struct-5
    title: Do not derive from ValueType explicitly
    statement:
        Declare value types with the language's struct construct rather than
        inheriting from System.ValueType.
    rationale:
        Most languages forbid it anyway, and the struct keyword is the
        supported way to create a value type.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do-not, type-design, structs]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/struct
