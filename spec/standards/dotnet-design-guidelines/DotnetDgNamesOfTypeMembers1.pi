use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfTypeMembers1:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-type-members-1
    title: Name methods with verbs
    statement:
        Method names should be verbs or verb phrases that say what the
        method does.
    rationale:
        Methods perform actions, and a verb tells the caller which action.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public Receipt Payment(Order order) { /* ... */ }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public Receipt ProcessPayment(Order order) { /* ... */ }
        \\\
        ```
    languages: [csharp]
    tags: [do, naming, methods]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-type-members#names-of-methods
