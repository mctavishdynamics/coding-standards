use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgUsingStandardExceptionTypes13:
    standard: @{DotnetDesignGuidelines}
    ruleId: using-standard-exception-types-13
    title: Do not throw COMException, ExecutionEngineException or SEHException
    statement:
        Never throw these interop and engine exceptions yourself; only the
        runtime infrastructure should.
    rationale:
        They describe conditions inside the runtime that your code does not
        represent.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do-not, exceptions, exception-types, interoperability]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/using-standard-exception-types#comexception-sehexception-and-executionengineexception
