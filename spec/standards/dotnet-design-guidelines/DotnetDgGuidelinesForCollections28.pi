use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGuidelinesForCollections28:
    standard: @{DotnetDesignGuidelines}
    ruleId: guidelines-for-collections-28
    title: Name custom data structures for the structure they are
    statement:
        Give custom data structures the name of the data structure they
        implement, such as a stack, queue or tree.
    rationale:
        The standard name immediately conveys the behavior and complexity
        callers can expect.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```csharp
        \\\
        public class PriorityStack<T> { /* ... */ }
        public class IntervalTree<T> { /* ... */ }
        \\\
        ```
    languages: [csharp]
    tags: [do, collections, naming]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/guidelines-for-collections#naming-custom-collections
