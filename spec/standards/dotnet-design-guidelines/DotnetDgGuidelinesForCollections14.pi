use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGuidelinesForCollections14:
    standard: @{DotnetDesignGuidelines}
    ruleId: guidelines-for-collections-14
    title: Return empty collections, never null
    statement:
        Collection properties and methods that return collections or arrays
        should return an empty instance instead of null.
    rationale:
        Callers treat null and empty the same way and should not need null
        checks before iterating.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public IReadOnlyList<Warning> GetWarnings() => _warnings.Count == 0 ? null : _warnings;
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public IReadOnlyList<Warning> GetWarnings() => _warnings;   // possibly empty
        \\\
        ```
    languages: [csharp]
    tags: [do-not, collections, null-handling]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/guidelines-for-collections#collection-properties-and-return-values
