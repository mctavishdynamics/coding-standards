use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgOperatorOverloads5:
    standard: @{DotnetDesignGuidelines}
    ruleId: operator-overloads-5
    title: Overload operators only where the defining type is an operand
    statement:
        An operator overload must have at least one operand of the type that
        declares it.
    rationale:
        Otherwise the operator is hard to find and can change the meaning of
        expressions on unrelated types.
    exceptions:
        C# rejects such overloads, so this mainly concerns other languages.
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do-not, member-design, operators]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/operator-overloads
