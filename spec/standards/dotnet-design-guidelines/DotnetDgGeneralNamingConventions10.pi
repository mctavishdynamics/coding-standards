use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGeneralNamingConventions10:
    standard: @{DotnetDesignGuidelines}
    ruleId: general-naming-conventions-10
    title: Use a neutral name when a value has no particular meaning
    statement:
        When a parameter or variable has no specific role and its type is
        unimportant, call it value, item or something equally general
        instead of repeating its type.
    rationale:
        A type-derived name adds clutter and becomes misleading if the type
        is changed.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public void Enqueue(object anObject) { /* ... */ }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public void Enqueue(object item) { /* ... */ }
        \\\
        ```
    languages: [csharp]
    tags: [do, naming, parameters]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/general-naming-conventions#avoiding-language-specific-names
