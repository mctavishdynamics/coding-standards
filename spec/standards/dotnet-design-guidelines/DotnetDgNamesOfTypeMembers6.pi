use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfTypeMembers6:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-type-members-6
    title: Consider naming a property after its type
    statement:
        When a property holds a value of a type whose name already describes
        it, it is fine to give the property the same name as the type.
    rationale:
        The repeated name is natural and avoids inventing an artificial
        alternative.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```csharp
        \\\
        public enum Currency { Euro, Dollar, Yen }

        public class PriceTag
        {
            public Currency Currency { get; set; }
        }
        \\\
        ```
    languages: [csharp]
    tags: [consider, naming, properties]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-type-members#names-of-properties
