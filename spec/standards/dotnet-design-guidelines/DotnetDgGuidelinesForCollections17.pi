use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGuidelinesForCollections17:
    standard: @{DotnetDesignGuidelines}
    ruleId: guidelines-for-collections-17
    title: Prefer collections to arrays
    statement:
        Choose collections over arrays in most APIs; arrays fit low-level
        read-write APIs where memory and speed matter.
    rationale:
        Collections give more control over their contents, can evolve and
        are easier to use, while read-only arrays would have to be cloned.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public Section[] GetSections() => (Section[])_sections.Clone();
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public ReadOnlyCollection<Section> GetSections() => _sections.AsReadOnly();
        \\\
        ```
    languages: [csharp]
    tags: [do, collections, arrays]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/guidelines-for-collections#choosing-between-arrays-and-collections
