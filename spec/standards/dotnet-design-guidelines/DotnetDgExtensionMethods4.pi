use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgExtensionMethods4:
    standard: @{DotnetDesignGuidelines}
    ruleId: extension-methods-4
    title: Keep extension methods out of the extended type's namespace
    statement:
        Put extension methods in a separate namespace from the type they
        extend, except when they extend an interface or serve dependency
        management.
    rationale:
        Callers then opt in by importing the namespace, instead of having
        the methods forced on them.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do-not, member-design, extension-methods, namespaces]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/extension-methods
