use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgVirtualMembers1:
    standard: @{DotnetDesignGuidelines}
    ruleId: virtual-members-1
    title: Make members virtual only for a good reason
    statement:
        Do not make a member virtual unless you have a clear need and accept
        the costs of designing, testing and maintaining it as an extension
        point.
    rationale:
        Virtual members are harder to change compatibly and slower to call,
        since they are not inlined.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public class Invoice
        {
            public virtual decimal Total { get; }
            public virtual string Number { get; }
        }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public class Invoice
        {
            public decimal Total { get; }
            public string Number { get; }
        }
        \\\
        ```
    languages: [csharp]
    tags: [do-not, extensibility, virtual-members]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/virtual-members
