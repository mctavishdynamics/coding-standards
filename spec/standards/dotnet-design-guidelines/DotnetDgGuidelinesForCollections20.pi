use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGuidelinesForCollections20:
    standard: @{DotnetDesignGuidelines}
    ruleId: guidelines-for-collections-20
    title: Do not expose arrays from properties that must copy them
    statement:
        Do not make a property's type an array if each read would need to
        allocate a fresh copy; use a method or a read-only collection
        instead.
    rationale:
        Callers expect properties to be cheap and are surprised when code
        like a loop over an indexed property allocates each time.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public Point[] Vertices => (Point[])_vertices.Clone();

        for (int i = 0; i < shape.Vertices.Length; i++) Draw(shape.Vertices[i]);
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public Point[] GetVertices() => (Point[])_vertices.Clone();
        public ReadOnlyCollection<Point> Vertices => _verticesView;
        \\\
        ```
    languages: [csharp]
    tags: [do-not, collections, arrays, properties]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/guidelines-for-collections#choosing-between-arrays-and-collections
