use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgEvent12:
    standard: @{DotnetDesignGuidelines}
    ruleId: event-12
    title: Type the second handler parameter as EventArgs and name it e
    statement:
        Declare the second parameter of a custom event handler as EventArgs
        or a subclass, named e.
    rationale:
        This keeps handlers compatible with the standard pattern and with
        general-purpose handling code.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public delegate void SnapshotEventHandler(object sender, byte[] image);
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public delegate void SnapshotEventHandler(object sender, SnapshotEventArgs e);
        \\\
        ```
    languages: [csharp]
    tags: [do, member-design, events, parameters]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/event#custom-event-handler-design
