use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGuidelinesForCollections18:
    standard: @{DotnetDesignGuidelines}
    ruleId: guidelines-for-collections-18
    title: Consider arrays where memory and speed dominate
    statement:
        In low-level APIs, think about arrays to keep memory use down and
        performance up.
    rationale:
        Arrays have the smallest footprint and the runtime optimizes element
        access.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```csharp
        \\\
        public int Read(float[] buffer, int offset, int count) { /* ... */ }
        \\\
        ```
    languages: [csharp]
    tags: [consider, collections, arrays, performance]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/guidelines-for-collections#choosing-between-arrays-and-collections
