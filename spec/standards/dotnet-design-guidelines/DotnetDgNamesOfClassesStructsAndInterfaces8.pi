use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfClassesStructsAndInterfaces8:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-classes-structs-and-interfaces-8
    title: Consider T for a lone single-letter type parameter
    statement:
        If a type or method has just one type parameter and a single letter
        suffices, call it T.
    rationale:
        T is the established convention, so readers recognize it
        immediately.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public class Box<X> { public X Content { get; set; } }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public class Box<T> { public T Content { get; set; } }
        \\\
        ```
    languages: [csharp]
    tags: [consider, naming, generics]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-classes-structs-and-interfaces#names-of-generic-type-parameters
