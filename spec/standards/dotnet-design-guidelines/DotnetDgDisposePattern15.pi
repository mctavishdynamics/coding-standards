use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgDisposePattern15:
    standard: @{DotnetDesignGuidelines}
    ruleId: dispose-pattern-15
    title: Pair every finalizer with the dispose pattern
    statement:
        Any type with a finalizer must also implement the basic dispose
        pattern.
    rationale:
        Callers need a way to release the resource deterministically instead
        of waiting for the garbage collector.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do, dispose, resources, finalizers]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/dispose-pattern#finalizable-types
