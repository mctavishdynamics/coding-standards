use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGuidelinesForCollections5:
    standard: @{DotnetDesignGuidelines}
    ruleId: guidelines-for-collections-5
    title: Do not implement IEnumerator and IEnumerable on one type
    statement:
        Keep the enumerable and its enumerator as separate types, for both
        the generic and non-generic interfaces.
    rationale:
        A type that is its own enumerator cannot support several independent
        enumerations at once.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public class Countdown : IEnumerable<int>, IEnumerator<int> { /* ... */ }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public class Countdown : IEnumerable<int>
        {
            public IEnumerator<int> GetEnumerator()
            {
                for (int i = _start; i >= 0; i--) yield return i;
            }
            IEnumerator IEnumerable.GetEnumerator() => GetEnumerator();
        }
        \\\
        ```
    languages: [csharp]
    tags: [do-not, collections, enumeration]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/guidelines-for-collections
