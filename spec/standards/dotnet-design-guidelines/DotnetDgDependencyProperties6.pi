use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgDependencyProperties6:
    standard: @{DotnetDesignGuidelines}
    ruleId: dependency-properties-6
    title: Set dependency property defaults in metadata, not in code
    statement:
        Specify a dependency property's default in its PropertyMetadata
        rather than assigning it in a constructor.
    rationale:
        A value set in code takes precedence over styles and other implicit
        sources, blocking them.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public Gauge() { Maximum = 100.0; }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        DependencyProperty.Register(nameof(Maximum), typeof(double), typeof(Gauge),
            new PropertyMetadata(100.0));
        \\\
        ```
    languages: [csharp]
    tags: [do-not, dependency-properties, wpf, defaults]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/dependency-properties#dependency-property-design
