use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgSerialization9:
    standard: @{DotnetDesignGuidelines}
    ruleId: serialization-9
    title: Consider KnownType for concrete types in complex graphs
    statement:
        Use the KnownType attribute to name the concrete types that may
        appear when a data member is typed as a base class or interface.
    rationale:
        Without it the serializer does not know which types to create during
        deserialization.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```csharp
        \\\
        [DataContract]
        [KnownType(typeof(CardPayment))]
        [KnownType(typeof(BankPayment))]
        public class Payment { }
        \\\
        ```
    languages: [csharp]
    tags: [consider, usage, serialization, data-contracts]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/serialization#supporting-data-contract-serialization
