use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgAbstractionsAbstractTypesAndInterfaces2:
    standard: @{DotnetDesignGuidelines}
    ruleId: abstractions-abstract-types-and-interfaces-2
    title: Choose deliberately between abstract class and interface
    statement:
        Weigh the trade-offs carefully when deciding whether an abstraction
        should be an abstract class or an interface.
    rationale:
        Classes can evolve by adding members, while interfaces allow
        multiple inheritance and value types, and the choice is hard to
        undo.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do, extensibility, abstraction, interfaces]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/abstractions-abstract-types-and-interfaces
