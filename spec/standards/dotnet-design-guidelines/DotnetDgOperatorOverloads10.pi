use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgOperatorOverloads10:
    standard: @{DotnetDesignGuidelines}
    ruleId: operator-overloads-10
    title: Do not make lossy conversions implicit
    statement:
        If a conversion can lose information, make it explicit, never
        implicit.
    rationale:
        An implicit conversion happens silently, so callers would lose data
        without noticing.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public static implicit operator int(Measurement m) => (int)m.Value;
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public static explicit operator int(Measurement m) => (int)m.Value;
        public static implicit operator double(Measurement m) => m.Value;
        \\\
        ```
    languages: [csharp]
    tags: [do-not, member-design, operators, conversions]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/operator-overloads#conversion-operators
