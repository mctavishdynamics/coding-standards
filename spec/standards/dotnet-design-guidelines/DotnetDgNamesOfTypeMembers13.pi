use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfTypeMembers13:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-type-members-13
    title: Use PascalCase for field names
    statement:
        Write field names that are visible outside the type in PascalCase.
    rationale:
        Public and protected fields are part of the API and follow the same
        casing as other members.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public static readonly int maxConnections = 16;
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public static readonly int MaxConnections = 16;
        \\\
        ```
    languages: [csharp]
    tags: [do, naming, fields, capitalization]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-type-members#names-of-fields
