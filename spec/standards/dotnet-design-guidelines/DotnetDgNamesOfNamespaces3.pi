use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfNamespaces3:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-namespaces-3
    title: Group namespaces by technology, not by team
    statement:
        Shape the namespace tree around related technologies instead of
        copying the company's org chart.
    rationale:
        Team and department names are reorganized often, while the namespace
        has to stay the same.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        namespace Fabrikam.InfraGroup.Messaging;
        \\\
        ```
    compliant:
        ```csharp
        \\\
        namespace Fabrikam.Messaging;
        \\\
        ```
    languages: [csharp]
    tags: [do-not, naming, namespaces]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-namespaces
