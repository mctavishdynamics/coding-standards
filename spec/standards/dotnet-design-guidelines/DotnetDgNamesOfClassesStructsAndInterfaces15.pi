use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfClassesStructsAndInterfaces15:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-classes-structs-and-interfaces-15
    title: Leave Flag and Flags out of enum type names
    statement:
        Do not end an enum's name with Flag or Flags; use a plural name and
        the Flags attribute instead.
    rationale:
        The attribute and the plural already convey that values combine.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        [Flags]
        public enum DayFlags { None = 0, Monday = 1, Tuesday = 2 }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        [Flags]
        public enum Days { None = 0, Monday = 1, Tuesday = 2 }
        \\\
        ```
    languages: [csharp]
    tags: [do-not, naming, enums, flags]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-classes-structs-and-interfaces#naming-enumerations
