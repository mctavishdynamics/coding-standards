use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgUsingStandardExceptionTypes11:
    standard: @{DotnetDesignGuidelines}
    ruleId: using-standard-exception-types-11
    title: Do not handle stack overflow
    statement:
        Do not write handlers for StackOverflowException.
    rationale:
        Managed code cannot stay consistent after an arbitrary stack
        overflow, and modern runtimes terminate the process anyway.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do-not, exceptions, exception-handling]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/using-standard-exception-types#stackoverflowexception
