use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamingParameters1:
    standard: @{DotnetDesignGuidelines}
    ruleId: naming-parameters-1
    title: Write parameter names in camelCase
    statement:
        Use camelCase for every parameter name.
    rationale:
        Parameters then look the same throughout the library and stand apart
        from PascalCase members.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public void Transfer(Account Source, Account TARGET) { }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public void Transfer(Account source, Account target) { }
        \\\
        ```
    languages: [csharp]
    tags: [do, naming, parameters, capitalization]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/naming-parameters
