use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgDependencyProperties2:
    standard: @{DotnetDesignGuidelines}
    ruleId: dependency-properties-2
    title: Derive from DependencyObject to host dependency properties
    statement:
        Base any class that declares dependency properties on
        DependencyObject or a type derived from it.
    rationale:
        DependencyObject supplies an efficient property store and built-in
        binding support.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```csharp
        \\\
        public class Gauge : Control { /* Control derives from DependencyObject */ }
        \\\
        ```
    languages: [csharp]
    tags: [do, dependency-properties, wpf, inheritance]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/dependency-properties#dependency-property-design
