use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGeneralNamingConventions8:
    standard: @{DotnetDesignGuidelines}
    ruleId: general-naming-conventions-8
    title: Name members for their meaning, not their return type
    statement:
        Describe what a value represents rather than echoing a language type
        keyword in the name.
    rationale:
        A purpose-based name tells the caller something, while a type
        keyword repeats what the signature already shows.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public double GetDouble() => _readings.Average();
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public double GetAverageReading() => _readings.Average();
        \\\
        ```
    languages: [csharp]
    tags: [do, naming]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/general-naming-conventions#avoiding-language-specific-names
