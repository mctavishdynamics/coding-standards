use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGuidelinesForCollections22:
    standard: @{DotnetDesignGuidelines}
    ruleId: guidelines-for-collections-22
    title: Implement IEnumerable on new collections, and more where sensible
    statement:
        Every new collection should implement IEnumerable of T, and
        ICollection of T or IList of T when that makes sense. Follow the
        member and parameter naming of the standard collections.
    rationale:
        Implementing the standard interfaces makes the collection work with
        foreach, LINQ and other APIs.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```csharp
        \\\
        public sealed class RingBuffer<T> : IReadOnlyCollection<T>
        {
            public int Count => _count;
            public IEnumerator<T> GetEnumerator() { /* ... */ }
            IEnumerator IEnumerable.GetEnumerator() => GetEnumerator();
        }
        \\\
        ```
    languages: [csharp]
    tags: [do, collections, interfaces]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/guidelines-for-collections#implementing-custom-collections
