use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgEnum2:
    standard: @{DotnetDesignGuidelines}
    ruleId: enum-2
    title: Prefer an enum to a set of static constants
    statement:
        Represent a group of related named values with an enum rather than
        with constant fields.
    rationale:
        Constants give no type safety and do not show up as a group in
        tools.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public static class OrderState
        {
            public const int Pending = 0;
            public const int Shipped = 1;
        }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public enum OrderState { Pending, Shipped }
        \\\
        ```
    languages: [csharp]
    tags: [do, type-design, enums]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/enum
