use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgParameterDesign25:
    standard: @{DotnetDesignGuidelines}
    ruleId: parameter-design-25
    title: Avoid expensive validation of pointer arguments
    statement:
        Do not perform costly checks on pointer arguments.
    rationale:
        Pointer overloads exist for speed, and heavy validation would defeat
        their purpose.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [avoid, member-design, parameters, performance]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/parameter-design#pointer-parameters
