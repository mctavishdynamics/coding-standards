use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgEnum10:
    standard: @{DotnetDesignGuidelines}
    ruleId: enum-10
    title: Declare enumerations with the enum keyword, not by inheritance
    statement:
        Define enumerations with the language's enum construct, not by
        deriving from System.Enum.
    rationale:
        System.Enum is a special runtime type and languages expose it only
        through their enum keyword.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do-not, type-design, enums]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/enum
