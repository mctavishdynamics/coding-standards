use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfClassesStructsAndInterfaces4:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-classes-structs-and-interfaces-4
    title: Consider ending a derived class name with its base class name
    statement:
        Where it reads well, finish the name of a subclass with the name of
        the class it derives from. Apply judgment; not every subclass needs
        it.
    rationale:
        The suffix makes the inheritance relationship obvious from the name
        alone.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public class QuotaExceeded : Exception { }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public class QuotaExceededException : Exception { }
        \\\
        ```
    languages: [csharp]
    tags: [consider, naming, inheritance]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-classes-structs-and-interfaces
