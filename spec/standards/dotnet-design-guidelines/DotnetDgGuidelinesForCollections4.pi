use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGuidelinesForCollections4:
    standard: @{DotnetDesignGuidelines}
    ruleId: guidelines-for-collections-4
    title: Return enumerators only from GetEnumerator
    statement:
        Enumerator types belong only in the return type of GetEnumerator; do
        not use them as parameters, properties or other return values.
    rationale:
        foreach works only with enumerables, so a method that hands out an
        enumerator cannot be looped over directly.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public IEnumerator<LogEntry> GetEntries() { /* ... */ }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public IEnumerable<LogEntry> GetEntries() { /* ... */ }
        \\\
        ```
    languages: [csharp]
    tags: [do-not, collections, enumeration]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/guidelines-for-collections
