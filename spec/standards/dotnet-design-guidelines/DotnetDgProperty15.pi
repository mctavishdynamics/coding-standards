use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgProperty15:
    standard: @{DotnetDesignGuidelines}
    ruleId: property-15
    title: Consider change notification for high-level component properties
    statement:
        Raise change notification events when properties of high-level APIs,
        such as designer components, change and users have a reason to
        react. Low-level types such as collections need not do this.
    rationale:
        Notifications support data binding and UI updates where they matter,
        while skipping them avoids overhead in basic types.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```csharp
        \\\
        public class ProfileViewModel : INotifyPropertyChanged
        {
            private string _displayName;
            public event PropertyChangedEventHandler PropertyChanged;

            public string DisplayName
            {
                get => _displayName;
                set { _displayName = value; PropertyChanged?.Invoke(this, new(nameof(DisplayName))); }
            }
        }
        \\\
        ```
    languages: [csharp]
    tags: [consider, member-design, properties, events]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/property#property-change-notification-events
