use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGeneralNamingConventions13:
    standard: @{DotnetDesignGuidelines}
    ruleId: general-naming-conventions-13
    title: Consider a fresh descriptive name for a new API version
    statement:
        Instead of decorating the old name, think about giving the new API
        its own name that describes what it does.
    rationale:
        A meaningful name explains what is different, while a marker only
        says that something is.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [consider, naming, versioning]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/general-naming-conventions#naming-new-versions-of-existing-apis
