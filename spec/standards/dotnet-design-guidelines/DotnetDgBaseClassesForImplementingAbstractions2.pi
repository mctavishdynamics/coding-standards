use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgBaseClassesForImplementingAbstractions2:
    standard: @{DotnetDesignGuidelines}
    ruleId: base-classes-for-implementing-abstractions-2
    title: Consider a separate namespace for base classes
    statement:
        Place base classes meant for implementers in a different namespace
        from the types most users work with.
    rationale:
        Base classes serve advanced extension scenarios and would only
        distract the majority of users.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [consider, extensibility, namespaces]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/base-classes-for-implementing-abstractions
