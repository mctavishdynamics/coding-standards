use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGuidelinesForCollections13:
    standard: @{DotnetDesignGuidelines}
    ruleId: guidelines-for-collections-13
    title: Consider keyed collections for items with unique keys
    statement:
        When items have a unique key such as a name or id, think about a
        collection derived from KeyedCollection that can be indexed by
        position and by key.
    rationale:
        Lookup by key becomes natural, though at the cost of extra memory,
        which may not always pay off.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```csharp
        \\\
        public class ProductCatalog : KeyedCollection<string, Product>
        {
            protected override string GetKeyForItem(Product item) => item.Sku;
        }

        Product lamp = catalog["LMP-042"];
        \\\
        ```
    languages: [csharp]
    tags: [consider, collections, dictionaries]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/guidelines-for-collections#collection-properties-and-return-values
