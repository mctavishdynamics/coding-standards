use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgMemberOverloading2:
    standard: @{DotnetDesignGuidelines}
    ruleId: member-overloading-2
    title: Keep the same parameter names across overloads
    statement:
        When parameters in different overloads stand for the same input,
        give them the same name.
    rationale:
        Changing names between overloads suggests different meanings and
        breaks named arguments.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public void Log(string message);
        public void Log(string text, LogLevel level);
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public void Log(string message);
        public void Log(string message, LogLevel level);
        \\\
        ```
    languages: [csharp]
    tags: [avoid, member-design, overloading, parameters]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/member-overloading
