use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgDependencyProperties3:
    standard: @{DotnetDesignGuidelines}
    ruleId: dependency-properties-3
    title: Pair each dependency property with a CLR wrapper and a static field
    statement:
        For every dependency property, declare a public static readonly
        DependencyProperty field and a normal CLR property that wraps it.
    rationale:
        The field is the identifier WPF uses, while the wrapper gives
        ordinary code a familiar property.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```csharp
        \\\
        public static readonly DependencyProperty MaximumProperty =
            DependencyProperty.Register(nameof(Maximum), typeof(double), typeof(Gauge),
                new PropertyMetadata(100.0));

        public double Maximum
        {
            get => (double)GetValue(MaximumProperty);
            set => SetValue(MaximumProperty, value);
        }
        \\\
        ```
    languages: [csharp]
    tags: [do, dependency-properties, wpf, properties]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/dependency-properties#dependency-property-design
