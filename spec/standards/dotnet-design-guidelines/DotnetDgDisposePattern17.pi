use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgDisposePattern17:
    standard: @{DotnetDesignGuidelines}
    ruleId: dispose-pattern-17
    title: Keep Finalize protected
    statement:
        A Finalize method must be protected.
    rationale:
        Only the runtime should call it; C#, C++ and Visual Basic enforce
        this through their destructor syntax.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do, dispose, resources, finalizers]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/dispose-pattern#finalizable-types
