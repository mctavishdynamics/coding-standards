use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGuidelinesForCollections9:
    standard: @{DotnetDesignGuidelines}
    ruleId: guidelines-for-collections-9
    title: Use Collection of T for read-write collection results
    statement:
        Type read-write collection properties and return values as
        Collection of T or a subclass of it. If that does not fit, implement
        the collection interfaces on a custom type.
    rationale:
        Collection of T can be extended to validate or react to changes,
        which List of T cannot.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```csharp
        \\\
        public class LineItemCollection : Collection<LineItem>
        {
            protected override void InsertItem(int index, LineItem item)
            {
                ArgumentNullException.ThrowIfNull(item);
                base.InsertItem(index, item);
            }
        }
        \\\
        ```
    languages: [csharp]
    tags: [do, collections, properties]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/guidelines-for-collections#collection-properties-and-return-values
