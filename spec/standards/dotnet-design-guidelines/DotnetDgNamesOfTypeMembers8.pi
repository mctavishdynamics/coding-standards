use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfTypeMembers8:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-type-members-8
    title: Use present and past tense for pre- and post-events
    statement:
        Name an event raised before an action in the present participle and
        one raised after it in the past tense.
    rationale:
        Tense gives a consistent, natural way to say when the event fires
        relative to the action.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```csharp
        \\\
        public event EventHandler<CancelEventArgs> Saving;
        public event EventHandler Saved;
        \\\
        ```
    languages: [csharp]
    tags: [do, naming, events]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-type-members#names-of-events
