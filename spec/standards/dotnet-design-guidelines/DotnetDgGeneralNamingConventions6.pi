use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGeneralNamingConventions6:
    standard: @{DotnetDesignGuidelines}
    ruleId: general-naming-conventions-6
    title: Spell words out instead of abbreviating them
    statement:
        Write whole words in identifiers rather than shortened forms or
        contractions.
    rationale:
        Readers cannot know which abbreviation an author picked, and the
        same word ends up shortened several ways.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public Customer FindCust(string acctNo) { /* ... */ }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public Customer FindCustomer(string accountNumber) { /* ... */ }
        \\\
        ```
    languages: [csharp]
    tags: [do-not, naming, abbreviations]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/general-naming-conventions#using-abbreviations-and-acronyms
