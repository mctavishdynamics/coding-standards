use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGuidelinesForCollections23:
    standard: @{DotnetDesignGuidelines}
    ruleId: guidelines-for-collections-23
    title: Consider the non-generic IList and ICollection when consumers need them
    statement:
        Think about also implementing the non-generic IList and ICollection
        when the collection is frequently handed to older APIs that only
        accept those interfaces.
    rationale:
        Older APIs such as data binding only accept the non-generic
        interfaces.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [consider, collections, interfaces, interoperability]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/guidelines-for-collections#implementing-custom-collections
