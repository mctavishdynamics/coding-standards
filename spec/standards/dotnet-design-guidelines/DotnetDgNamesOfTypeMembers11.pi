use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfTypeMembers11:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-type-members-11
    title: Name event handler parameters sender and e
    statement:
        Give event handlers exactly two parameters, sender and e. The sender
        is usually typed as object even when a more specific type is
        possible.
    rationale:
        All handlers then share one recognizable signature that works with
        general handling code.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public delegate void AlarmEventHandler(AlarmClock clock, AlarmEventArgs args);
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public delegate void AlarmEventHandler(object sender, AlarmEventArgs e);
        \\\
        ```
    languages: [csharp]
    tags: [do, naming, events, parameters]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-type-members#names-of-events
