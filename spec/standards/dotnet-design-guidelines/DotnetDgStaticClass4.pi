use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgStaticClass4:
    standard: @{DotnetDesignGuidelines}
    ruleId: static-class-4
    title: Emulate static classes with sealed, abstract and a private constructor
    statement:
        In a language without built-in static classes, make the class sealed
        and abstract and give it a private instance constructor.
    rationale:
        This combination prevents both instantiation and inheritance, which
        is what a static class guarantees.
    exceptions:
        C# has the static modifier, which does all of this for you, so the
        guideline matters only for languages without it.
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do, type-design, static-classes, interoperability]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/static-class
