use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgSerialization4:
    standard: @{DotnetDesignGuidelines}
    ruleId: serialization-4
    title: Consider runtime serialization for .NET Remoting
    statement:
        Support runtime serialization if instances must cross .NET Remoting
        boundaries.
    rationale:
        Remoting relies on runtime serialization to move objects between
        application domains.
    exceptions:
        Remoting and binary runtime serialization are obsolete in modern
        .NET; this applies to .NET Framework code.
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [consider, usage, serialization, remoting]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/serialization#choosing-the-right-serialization-technology-to-support
