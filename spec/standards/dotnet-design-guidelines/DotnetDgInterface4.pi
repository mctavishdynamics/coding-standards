use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgInterface4:
    standard: @{DotnetDesignGuidelines}
    ruleId: interface-4
    title: Ship at least one implementation of every interface
    statement:
        Every interface you publish should come with a class or struct of
        yours that implements it.
    rationale:
        Implementing the interface yourself shows whether its design is
        complete and practical.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do, type-design, interfaces, validation]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/interface
