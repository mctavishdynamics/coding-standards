use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNestedTypes3:
    standard: @{DotnetDesignGuidelines}
    ruleId: nested-types-3
    title: Avoid exposing nested types publicly
    statement:
        Keep nested types non-public, except when callers need to declare
        variables of them only in rare, advanced cases such as subclassing.
    rationale:
        Public nested types are clumsy to reference and usually belong at
        namespace level.
    exceptions:
        Exposing a nested type is acceptable when callers only need to name
        it in unusual situations, for example when deriving from the outer
        type or customizing it deeply.
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [avoid, type-design, nested-types]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/nested-types
