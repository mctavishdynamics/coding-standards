use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgVirtualMembers2:
    standard: @{DotnetDesignGuidelines}
    ruleId: virtual-members-2
    title: Consider keeping extensibility to what is necessary
    statement:
        Expose only the extension points that real scenarios need.
    rationale:
        Every extension point is a commitment that limits how the type can
        change later.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [consider, extensibility, virtual-members]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/virtual-members
