use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGuidelinesForCollections30:
    standard: @{DotnetDesignGuidelines}
    ruleId: guidelines-for-collections-30
    title: Consider naming collections after their item type
    statement:
        Think about naming a collection after the items it holds. Drop the I
        of an interface item type.
    rationale:
        The name then tells readers what is inside the collection.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```csharp
        \\\
        public class InvoiceCollection : Collection<Invoice> { }
        public class ComparableCollection : Collection<IComparable> { }
        \\\
        ```
    languages: [csharp]
    tags: [consider, collections, naming]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/guidelines-for-collections#naming-custom-collections
