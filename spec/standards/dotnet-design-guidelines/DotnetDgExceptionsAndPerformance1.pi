use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgExceptionsAndPerformance1:
    standard: @{DotnetDesignGuidelines}
    ruleId: exceptions-and-performance-1
    title: Do not fall back to error codes for performance
    statement:
        Do not switch to error codes because you worry about exception cost;
        use the Tester-Doer or Try-Parse patterns instead.
    rationale:
        Those patterns remove the cost in common cases while keeping
        exceptions for real failures.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public int TryRemove(string key) { /* returns -1 when missing */ }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public bool TryRemove(string key, out Entry removed) { /* ... */ }
        \\\
        ```
    languages: [csharp]
    tags: [do-not, exceptions, performance]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/exceptions-and-performance
