use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgSerialization11:
    standard: @{DotnetDesignGuidelines}
    ruleId: serialization-11
    title: Consider IExtensibleDataObject for version round-tripping
    statement:
        Implement IExtensibleDataObject so that data from newer versions
        survives a pass through an older version.
    rationale:
        Unknown members are kept in ExtensionData and written back out
        instead of being lost.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```csharp
        \\\
        [DataContract]
        public class Profile : IExtensibleDataObject
        {
            [DataMember] public string Nickname { get; set; }
            public ExtensionDataObject ExtensionData { get; set; }
        }
        \\\
        ```
    languages: [csharp]
    tags: [consider, usage, serialization, versioning]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/serialization#supporting-data-contract-serialization
