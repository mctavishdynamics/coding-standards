use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamingResources2:
    standard: @{DotnetDesignGuidelines}
    ruleId: naming-resources-2
    title: Use descriptive resource identifiers
    statement:
        Give resources names that say what they contain rather than short
        codes.
    rationale:
        A descriptive key is self-documenting for whoever maintains or
        translates the resources.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        string text = Resources.ResourceManager.GetString("Msg17");
        \\\
        ```
    compliant:
        ```csharp
        \\\
        string text = Resources.ResourceManager.GetString("SessionExpiredMessage");
        \\\
        ```
    languages: [csharp]
    tags: [do, naming, resources]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/naming-resources
