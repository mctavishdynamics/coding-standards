use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfTypeMembers2:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-type-members-2
    title: Name properties with nouns or adjectives
    statement:
        A property name should be a noun, a noun phrase or an adjective.
    rationale:
        Properties look like data to the caller, so their names should
        describe a value rather than an action.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public int CountItems { get; }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public int ItemCount { get; }
        \\\
        ```
    languages: [csharp]
    tags: [do, naming, properties]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-type-members#names-of-properties
