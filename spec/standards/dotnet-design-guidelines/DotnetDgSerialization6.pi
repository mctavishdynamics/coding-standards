use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgSerialization6:
    standard: @{DotnetDesignGuidelines}
    ruleId: serialization-6
    title: Consider public data members for partial-trust types
    statement:
        If the type may be used in partial trust, think about making its
        data members public.
    rationale:
        In partial trust, data contract serializers can only read and write
        public members.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [consider, usage, serialization, security]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/serialization#supporting-data-contract-serialization
