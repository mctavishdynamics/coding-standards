use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfNamespaces10:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-namespaces-10
    title: Keep type names unique within one technology
    statement:
        Types in namespaces that share the same company and technology
        prefix should not have identical names.
    rationale:
        Namespaces belonging to one technology are typically used together,
        so clashes there hurt callers directly.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do-not, naming, namespaces, conflicts]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-namespaces#namespaces-and-type-name-conflicts
