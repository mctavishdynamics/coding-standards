use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfTypeMembers14:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-type-members-14
    title: Name fields with nouns or adjectives
    statement:
        A field name should be a noun, a noun phrase or an adjective.
    rationale:
        Fields store data, and their names should describe that data.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public static readonly TimeSpan WaitForRetry = TimeSpan.FromSeconds(5);
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public static readonly TimeSpan RetryDelay = TimeSpan.FromSeconds(5);
        \\\
        ```
    languages: [csharp]
    tags: [do, naming, fields]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-type-members#names-of-fields
