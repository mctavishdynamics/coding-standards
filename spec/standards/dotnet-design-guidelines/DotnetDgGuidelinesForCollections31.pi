use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGuidelinesForCollections31:
    standard: @{DotnetDesignGuidelines}
    ruleId: guidelines-for-collections-31
    title: Consider a ReadOnly prefix when a writable twin exists
    statement:
        If there is or may be a writable version of a collection, think
        about starting the read-only one's name with ReadOnly.
    rationale:
        The prefix distinguishes the two variants at a glance.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```csharp
        \\\
        public class SettingCollection : Collection<Setting> { }
        public class ReadOnlySettingCollection : ReadOnlyCollection<Setting> { /* ... */ }
        \\\
        ```
    languages: [csharp]
    tags: [consider, collections, naming, immutability]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/guidelines-for-collections#naming-custom-collections
