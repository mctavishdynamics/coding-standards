use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGuidelinesForCollections2:
    standard: @{DotnetDesignGuidelines}
    ruleId: guidelines-for-collections-2
    title: Keep ArrayList and List out of public APIs
    statement:
        Do not expose ArrayList or List of T from public members.
    rationale:
        These are implementation data structures: they offer many members
        callers do not need and give you no hook to react when callers
        change them.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public List<Attendee> Attendees { get; } = new();
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public Collection<Attendee> Attendees { get; } = new();
        \\\
        ```
    languages: [csharp]
    tags: [do-not, collections]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/guidelines-for-collections
