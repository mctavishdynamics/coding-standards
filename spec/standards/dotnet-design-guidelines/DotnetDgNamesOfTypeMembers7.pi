use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfTypeMembers7:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-type-members-7
    title: Name events with verbs
    statement:
        Event names should be verbs or verb phrases describing what happened
        or is happening.
    rationale:
        An event signals an action, and a verb states it.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public event EventHandler Selection;
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public event EventHandler SelectionChanged;
        \\\
        ```
    languages: [csharp]
    tags: [do, naming, events]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-type-members#names-of-events
