use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgProperty13:
    standard: @{DotnetDesignGuidelines}
    ruleId: property-13
    title: Declare at most one indexer family per type
    statement:
        A type should not declare more than one family of indexers with
        different names.
    rationale:
        Many languages, including C#, cannot express several indexer
        families.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do-not, member-design, indexers]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/property#indexed-property-design
