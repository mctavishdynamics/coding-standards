use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfClassesStructsAndInterfaces9:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-classes-structs-and-interfaces-9
    title: Begin descriptive generic parameter names with a capital T
    statement:
        Give descriptive type parameter names a leading T, as in TKey or
        TResult.
    rationale:
        The prefix marks the name as a type parameter rather than a concrete
        type.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public class Cache<Key, Entry> { }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public class Cache<TKey, TEntry> { }
        \\\
        ```
    languages: [csharp]
    tags: [do, naming, generics]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-classes-structs-and-interfaces#names-of-generic-type-parameters
