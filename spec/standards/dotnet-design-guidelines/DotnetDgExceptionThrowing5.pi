use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgExceptionThrowing5:
    standard: @{DotnetDesignGuidelines}
    ruleId: exception-throwing-5
    title: Consider the performance cost of throwing
    statement:
        Keep in mind that exceptions are expensive; rates above roughly 100
        per second noticeably slow most applications.
    rationale:
        Each throw captures a stack trace and unwinds frames, which adds up
        quickly.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [consider, exceptions, performance]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/exception-throwing
