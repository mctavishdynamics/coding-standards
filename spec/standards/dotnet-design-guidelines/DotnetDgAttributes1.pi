use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgAttributes1:
    standard: @{DotnetDesignGuidelines}
    ruleId: attributes-1
    title: End custom attribute class names with Attribute
    statement:
        Give every custom attribute class a name ending in Attribute.
    rationale:
        The suffix is the convention, and languages let users omit it when
        applying the attribute.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public sealed class Audited : Attribute { }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public sealed class AuditedAttribute : Attribute { }
        \\\
        ```
    languages: [csharp]
    tags: [do, usage, attributes, naming]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/attributes
