use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfNamespaces1:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-namespaces-1
    title: Start namespaces with the company name
    statement:
        Make the company name the first part of every namespace you publish.
    rationale:
        Without it, two vendors can easily ship namespaces with identical
        names.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        namespace Scheduling.Calendars;
        \\\
        ```
    compliant:
        ```csharp
        \\\
        namespace Fabrikam.Scheduling.Calendars;
        \\\
        ```
    languages: [csharp]
    tags: [do, naming, namespaces]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-namespaces
