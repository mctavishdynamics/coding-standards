use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamingResources1:
    standard: @{DotnetDesignGuidelines}
    ruleId: naming-resources-1
    title: Write resource keys in PascalCase
    statement:
        Use PascalCase for resource identifiers.
    rationale:
        Resource keys are often surfaced as generated properties, so they
        should follow member casing.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        string text = Resources.ResourceManager.GetString("welcome_banner");
        \\\
        ```
    compliant:
        ```csharp
        \\\
        string text = Resources.ResourceManager.GetString("WelcomeBanner");
        \\\
        ```
    languages: [csharp]
    tags: [do, naming, resources]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/naming-resources
