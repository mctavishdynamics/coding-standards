use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgSerialization12:
    standard: @{DotnetDesignGuidelines}
    ruleId: serialization-12
    title: Do not shape types around XML serialization without strong need
    statement:
        Do not shape types around XML serialization unless you truly need to
        control the XML; data contracts superseded it.
    rationale:
        XML serialization imposes constraints, such as public setters and
        parameterless constructors, that weaken a type's design.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [avoid, usage, serialization, xml]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/serialization#supporting-xml-serialization
