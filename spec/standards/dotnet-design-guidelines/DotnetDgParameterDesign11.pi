use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgParameterDesign11:
    standard: @{DotnetDesignGuidelines}
    ruleId: parameter-design-11
    title: Validate enum arguments
    statement:
        Check enum parameters against the values you support instead of
        assuming they are in range.
    rationale:
        Any integer can be cast to an enum type, so an argument may hold a
        value the enum never defined.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```csharp
        \\\
        public void SetMode(DisplayMode mode)
        {
            if (mode is not (DisplayMode.Windowed or DisplayMode.Fullscreen))
                throw new ArgumentOutOfRangeException(nameof(mode));
            _mode = mode;
        }
        \\\
        ```
    languages: [csharp]
    tags: [do, member-design, parameters, enums]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/parameter-design#validating-arguments
