use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgStaticClass1:
    standard: @{DotnetDesignGuidelines}
    ruleId: static-class-1
    title: Reserve static classes for supporting roles
    statement:
        Keep static classes for helpers that support the object-oriented
        core of a library rather than making them the main design.
    rationale:
        Static classes cannot be extended, substituted or passed around, so
        overusing them makes a library rigid.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do, type-design, static-classes]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/static-class
