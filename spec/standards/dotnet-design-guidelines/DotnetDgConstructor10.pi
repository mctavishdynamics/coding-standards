use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgConstructor10:
    standard: @{DotnetDesignGuidelines}
    ruleId: constructor-10
    title: Keep static constructors private
    statement:
        Static constructors must be private.
    rationale:
        Only the runtime should run type initialization; other callers
        invoking it could cause unexpected behavior. C# enforces this.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [do, member-design, constructors, static]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/constructor#type-constructor-guidelines
