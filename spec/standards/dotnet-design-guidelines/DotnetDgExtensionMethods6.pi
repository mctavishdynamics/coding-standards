use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgExtensionMethods6:
    standard: @{DotnetDesignGuidelines}
    ruleId: extension-methods-6
    title: Consider the interface's namespace for broadly used extensions
    statement:
        When extending an interface with methods that nearly every caller
        will need, put them in the interface's own namespace.
    rationale:
        The methods are then available wherever the interface is, without an
        extra import.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [consider, member-design, extension-methods, namespaces]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/extension-methods
