use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgNamesOfTypeMembers5:
    standard: @{DotnetDesignGuidelines}
    ruleId: names-of-type-members-5
    title: Phrase Boolean properties positively
    statement:
        Name Boolean properties as positive statements. An Is, Can or Has
        prefix may be added when it makes the meaning clearer.
    rationale:
        A negative name forces readers through double negatives such as not
        IsNotEnabled.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public bool IsNotEditable { get; }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public bool IsEditable { get; }
        \\\
        ```
    languages: [csharp]
    tags: [do, naming, properties, booleans]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-type-members#names-of-properties
