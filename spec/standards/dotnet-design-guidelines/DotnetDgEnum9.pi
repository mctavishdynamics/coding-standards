use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgEnum9:
    standard: @{DotnetDesignGuidelines}
    ruleId: enum-9
    title: Use plural names for flags enums and singular for simple ones
    statement:
        Give flags enums plural noun names and simple enums singular noun
        names.
    rationale:
        The grammatical number tells readers whether a value holds one
        choice or a combination.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```csharp
        \\\
        public enum Season { Spring, Summer, Autumn, Winter }

        [Flags]
        public enum Toppings { None = 0, Cheese = 1, Olives = 2, Peppers = 4 }
        \\\
        ```
    languages: [csharp]
    tags: [do, naming, enums, flags]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/enum
