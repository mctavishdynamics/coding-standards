use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgGeneralNamingConventions3:
    standard: @{DotnetDesignGuidelines}
    ruleId: general-naming-conventions-3
    title: Use only letters and digits in identifiers
    statement:
        Leave underscores, hyphens and other symbols out of names.
    rationale:
        Separator characters clash with the casing conventions and look
        foreign next to the framework's own names.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public TimeSpan Session_Timeout { get; set; }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public TimeSpan SessionTimeout { get; set; }
        \\\
        ```
    languages: [csharp]
    tags: [do-not, naming]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/general-naming-conventions#word-choice
