use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgOperatorOverloads11:
    standard: @{DotnetDesignGuidelines}
    ruleId: operator-overloads-11
    title: Do not throw from implicit conversions
    statement:
        Implicit conversion operators must not throw exceptions.
    rationale:
        Callers often do not realize a conversion is happening, so an
        exception from it is baffling.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public static implicit operator Email(string text)
            => IsValid(text) ? new Email(text) : throw new FormatException();
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public static explicit operator Email(string text)
            => IsValid(text) ? new Email(text) : throw new InvalidCastException("Not a valid address.");
        \\\
        ```
    languages: [csharp]
    tags: [do-not, member-design, operators, exceptions]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/operator-overloads#conversion-operators
