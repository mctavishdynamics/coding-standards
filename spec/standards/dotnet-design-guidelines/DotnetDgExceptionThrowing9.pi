use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgExceptionThrowing9:
    standard: @{DotnetDesignGuidelines}
    ruleId: exception-throwing-9
    title: Consider helper methods that build exceptions
    statement:
        When the same exception is thrown from several places, create it in
        a shared helper method.
    rationale:
        This avoids duplicated code, and moving the throw out of a member
        may let the runtime inline it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```csharp
        \\\
        public T this[int index]
        {
            get
            {
                if ((uint)index >= (uint)_count) ThrowIndexOutOfRange(index);
                return _items[index];
            }
        }

        [DoesNotReturn]
        private static void ThrowIndexOutOfRange(int index)
            => throw new ArgumentOutOfRangeException(nameof(index), index, "Index is outside the collection.");
        \\\
        ```
    languages: [csharp]
    tags: [consider, exceptions, performance, reuse]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/exception-throwing
