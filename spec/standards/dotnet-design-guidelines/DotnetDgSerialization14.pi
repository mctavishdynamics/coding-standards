use ../lib/CodingRule

from ./DotnetDesignGuidelines import DotnetDesignGuidelines

export coding-rule DotnetDgSerialization14:
    standard: @{DotnetDesignGuidelines}
    ruleId: serialization-14
    title: Consider runtime serialization for types used with Remoting
    statement:
        Support runtime serialization on types exchanged over .NET Remoting,
        such as types passed between add-ins.
    rationale:
        Remoting can only transport types that runtime serialization
        understands.
    exceptions:
        Remoting and BinaryFormatter are obsolete in modern .NET; this
        applies to legacy .NET Framework code.
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [consider, usage, serialization, remoting]
    source: https://learn.microsoft.com/dotnet/standard/design-guidelines/serialization#supporting-runtime-serialization
