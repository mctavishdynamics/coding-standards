use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8TabsOrSpaces:
    standard: @{Pep8}
    ruleId: tabs-or-spaces
    title: Indent with spaces rather than tabs
    statement:
        Use spaces for indentation. Use tabs only to stay consistent with
        code that is already indented with tabs, and never mix the two.
    rationale:
        Spaces look the same in every editor, and Python rejects indentation
        that mixes tabs and spaces.
    exceptions:
        Existing code indented with tabs may keep using tabs.
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [formatting, indentation]
    source: https://peps.python.org/pep-0008/#tabs-or-spaces
