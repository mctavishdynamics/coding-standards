use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8WhitespaceBeforeIndexBracket:
    standard: @{Pep8}
    ruleId: pet-peeves-index-bracket
    title: No space before the bracket of an index or slice
    statement:
        Do not put a space before the opening bracket that starts an
        indexing or slicing operation.
    rationale:
        The bracket is part of the subscript expression and should stay
        attached to it.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        settings ['timeout'] = defaults [0]
        \\\
        ```
    compliant:
        ```python
        \\\
        settings['timeout'] = defaults[0]
        \\\
        ```
    languages: [python]
    tags: [formatting, whitespace]
    source: https://peps.python.org/pep-0008/#pet-peeves
