use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8NamingConsistency:
    standard: @{Pep8}
    ruleId: naming-conventions
    title: Follow the naming conventions in new code
    statement:
        Write new modules and packages, including third-party frameworks, to
        these naming conventions. Where an existing library uses a different
        style, keep it internally consistent.
    rationale:
        Python's library naming is not fully consistent, so new code should
        converge on the recommended style without fragmenting existing code.
    exceptions:
        An existing library with its own established style should keep that
        style.
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [naming, consistency]
    source: https://peps.python.org/pep-0008/#naming-conventions
