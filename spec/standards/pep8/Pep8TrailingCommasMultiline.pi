use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8TrailingCommasMultiline:
    standard: @{Pep8}
    ruleId: when-to-use-trailing-commas
    title: Use trailing commas in lists that will grow
    statement:
        When a list of values, arguments or imports is expected to grow, put
        each item on its own line with a trailing comma and the closing
        bracket on the next line. Do not put a trailing comma on the same
        line as the closing delimiter, except for one-element tuples.
    rationale:
        Adding an item then changes only one line in version control.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        PLUGINS = ['auth', 'cache',]
        \\\
        ```
    compliant:
        ```python
        \\\
        PLUGINS = [
            'auth',
            'cache',
        ]
        \\\
        ```
    languages: [python]
    tags: [formatting, version-control]
    source: https://peps.python.org/pep-0008/#when-to-use-trailing-commas
