use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8TrailingCommasMultiline:
    standard: @{Pep8}
    ruleId: when-to-use-trailing-commas
    title: Use trailing commas in lists that will grow
    statement:
        For a collection of values, arguments or imports that is likely to get
        longer, write one item per line, end each with a comma, and close the
        bracket on its own line. A comma directly before a closing bracket on
        one line is redundant, apart from the single-item tuple.
    rationale:
        Adding an item then changes only one line in version control.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        PLUGINS = ['auth', 'cache',]
        \\\
        ```
    compliant:
        ```python
        \\\
        PLUGINS = [
            'auth',
            'cache',
        ]
        \\\
        ```
    languages: [python]
    tags: [formatting, version-control]
    source: https://peps.python.org/pep-0008/#when-to-use-trailing-commas
