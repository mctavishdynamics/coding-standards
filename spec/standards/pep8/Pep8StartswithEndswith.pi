use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8StartswithEndswith:
    standard: @{Pep8}
    ruleId: programming-recommendations-startswith
    title: Use startswith and endswith instead of slicing
    statement:
        Check prefixes and suffixes with str.startswith and str.endswith
        rather than string slicing.
    rationale:
        The methods are cleaner and avoid off-by-one slice lengths.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        if filename[-4:] == ".csv":
            import_csv(filename)
        \\\
        ```
    compliant:
        ```python
        \\\
        if filename.endswith(".csv"):
            import_csv(filename)
        \\\
        ```
    languages: [python]
    tags: [strings, readability]
    source: https://peps.python.org/pep-0008/#programming-recommendations
