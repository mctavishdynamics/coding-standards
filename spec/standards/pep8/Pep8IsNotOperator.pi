use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8IsNotOperator:
    standard: @{Pep8}
    ruleId: programming-recommendations-is-not
    title: Use is not rather than not ... is
    statement:
        Write x is not None instead of not x is None.
    rationale:
        Both mean the same, but is not reads more naturally.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        if not user is None:
            greet(user)
        \\\
        ```
    compliant:
        ```python
        \\\
        if user is not None:
            greet(user)
        \\\
        ```
    languages: [python]
    tags: [comparisons, readability]
    source: https://peps.python.org/pep-0008/#programming-recommendations
