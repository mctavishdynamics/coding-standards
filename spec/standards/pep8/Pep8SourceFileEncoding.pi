use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8SourceFileEncoding:
    standard: @{Pep8}
    ruleId: source-file-encoding
    title: Use UTF-8 without an encoding declaration
    statement:
        Code in the core Python distribution should be UTF-8 and should not
        carry an encoding declaration.
    rationale:
        UTF-8 is the default source encoding, so the declaration is noise.
    exceptions:
        In the standard library, other encodings may be used for test
        purposes only.
    severity: null
    noncompliant:
        ```python
        \\\
        # -*- coding: latin-1 -*-
        """Currency helpers."""
        \\\
        ```
    compliant:
        ```python
        \\\
        """Currency helpers."""
        \\\
        ```
    languages: [python]
    tags: [encoding, files]
    source: https://peps.python.org/pep-0008/#source-file-encoding
