use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8WhitespaceInsideBrackets:
    standard: @{Pep8}
    ruleId: pet-peeves-inside-brackets
    title: No whitespace just inside brackets
    statement:
        Do not put spaces immediately inside parentheses, brackets or
        braces.
    rationale:
        The extra space adds width without making the grouping clearer.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        notify( users[ 0 ], { "level": 2 } )
        \\\
        ```
    compliant:
        ```python
        \\\
        notify(users[0], {"level": 2})
        \\\
        ```
    languages: [python]
    tags: [formatting, whitespace]
    source: https://peps.python.org/pep-0008/#pet-peeves
