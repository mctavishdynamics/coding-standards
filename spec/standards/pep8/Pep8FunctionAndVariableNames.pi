use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8FunctionAndVariableNames:
    standard: @{Pep8}
    ruleId: function-and-variable-names
    title: Use lower_case_with_underscores for functions and variables
    statement:
        Name functions and variables in lower case, with words separated by
        underscores as needed for readability.
    rationale:
        A single convention for functions and variables makes code
        predictable to read.
    exceptions:
        mixedCase is allowed only where it is already the prevailing style,
        to keep backwards compatibility.
    severity: null
    noncompliant:
        ```python
        \\\
        def sendInvoice(customerId):
            invoiceTotal = compute_total(customerId)
        \\\
        ```
    compliant:
        ```python
        \\\
        def send_invoice(customer_id):
            invoice_total = compute_total(customer_id)
        \\\
        ```
    languages: [python]
    tags: [naming, functions]
    source: https://peps.python.org/pep-0008/#function-and-variable-names
