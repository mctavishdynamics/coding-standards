use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8UseIsinstance:
    standard: @{Pep8}
    ruleId: programming-recommendations-isinstance
    title: Use isinstance for type checks
    statement:
        Compare object types with isinstance rather than comparing types
        directly.
    rationale:
        isinstance also accepts subclasses, which a direct type comparison
        rejects.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        if type(value) == dict:
            value = flatten(value)
        \\\
        ```
    compliant:
        ```python
        \\\
        if isinstance(value, dict):
            value = flatten(value)
        \\\
        ```
    languages: [python]
    tags: [types, comparisons]
    source: https://peps.python.org/pep-0008/#programming-recommendations
