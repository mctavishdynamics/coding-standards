use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8WhitespaceBeforeCallParenthesis:
    standard: @{Pep8}
    ruleId: pet-peeves-call-parenthesis
    title: No space before the parenthesis of a function call
    statement:
        Do not put a space before the opening parenthesis of a call's
        argument list.
    rationale:
        The parenthesis belongs to the call, and a gap makes it look like a
        separate expression.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        total = sum (prices)
        \\\
        ```
    compliant:
        ```python
        \\\
        total = sum(prices)
        \\\
        ```
    languages: [python]
    tags: [formatting, whitespace]
    source: https://peps.python.org/pep-0008/#pet-peeves
