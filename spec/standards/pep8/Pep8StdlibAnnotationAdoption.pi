use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8StdlibAnnotationAdoption:
    standard: @{Pep8}
    ruleId: function-annotations-stdlib
    title: Adopt annotations conservatively in the standard library
    statement:
        The standard library should be conservative about adding
        annotations, using them for new code and big refactorings. Outside
        it, experimenting within the PEP 484 rules is encouraged.
    rationale:
        Large existing code bases change slowly, while new code and outside
        projects can show whether annotations aid understanding.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [type-hints, standard-library]
    source: https://peps.python.org/pep-0008/#function-annotations
