use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8FoolishConsistency:
    standard: @{Pep8}
    ruleId: a-foolish-consistency-is-the-hobgoblin-of-little-minds
    title: Favour local consistency and know when to break a guideline
    statement:
        Follow the guide, but consistency within a project matters more, and
        consistency within one module or function matters most. A project's
        own style guide wins over this one. Do not break backwards
        compatibility just to comply.
    rationale:
        Code is read far more often than it is written, and the aim of the
        guide is readable, consistent code, not mechanical conformance.
    exceptions:
        Ignore a guideline when it would make the code less readable, when
        surrounding code does otherwise, when the code predates the
        guideline and has no other reason to change, or when the code must
        run on Python versions without the recommended feature.
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [consistency, readability]
    source: https://peps.python.org/pep-0008/#a-foolish-consistency-is-the-hobgoblin-of-little-minds
