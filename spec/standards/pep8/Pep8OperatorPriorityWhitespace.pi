use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8OperatorPriorityWhitespace:
    standard: @{Pep8}
    ruleId: other-recommendations-operator-priority
    title: Space the lowest-priority operators in mixed expressions
    statement:
        In an expression that mixes operator priorities, you may put spaces
        only around the operators that bind least tightly. Use one space at
        most, and put the same spacing on each side of a binary operator.
    rationale:
        Tighter spacing on higher-priority operators shows how the
        expression groups.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        distance = dx * dx + dy * dy
        midpoint = (low+ high) // 2
        \\\
        ```
    compliant:
        ```python
        \\\
        distance = dx*dx + dy*dy
        midpoint = (low+high) // 2
        \\\
        ```
    languages: [python]
    tags: [formatting, whitespace, operators]
    source: https://peps.python.org/pep-0008/#other-recommendations
