use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8CommentsCompleteSentences:
    standard: @{Pep8}
    ruleId: comments-complete-sentences
    title: Write comments as complete sentences
    statement:
        Each comment should be one or more full sentences. Start with a capital
        letter, except when the first word is an identifier that begins in lower
        case, finish sentences in block comments with a period, and separate
        sentences with one or two spaces, with nothing after the final one.
    rationale:
        Full sentences are clearer than fragments, and changing an
        identifier's case would misname it.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        # check cache first
        # Parse_config returns none if missing
        \\\
        ```
    compliant:
        ```python
        \\\
        # Check the cache before hitting the database.
        # parse_config returns None when the file is missing.
        \\\
        ```
    languages: [python]
    tags: [comments, wording]
    source: https://peps.python.org/pep-0008/#comments
