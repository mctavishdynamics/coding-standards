use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8NamesToAvoid:
    standard: @{Pep8}
    ruleId: names-to-avoid
    title: Never use l, O or I as single-character names
    statement:
        Do not use lower-case l, upper-case O or upper-case I as a single-
        character variable name. Use L instead of l if tempted.
    rationale:
        In some fonts these letters cannot be told apart from the digits one
        and zero.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        l = [3, 1, 2]
        O = 0
        I = l[O]
        \\\
        ```
    compliant:
        ```python
        \\\
        scores = [3, 1, 2]
        first = scores[0]
        \\\
        ```
    languages: [python]
    tags: [naming, readability]
    source: https://peps.python.org/pep-0008/#names-to-avoid
