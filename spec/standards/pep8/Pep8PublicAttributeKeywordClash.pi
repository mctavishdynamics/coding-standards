use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8PublicAttributeKeywordClash:
    standard: @{Pep8}
    ruleId: designing-for-inheritance-keyword-clash
    title: Append an underscore to public attributes that clash with keywords
    statement:
        If a public attribute name collides with a reserved keyword, add a
        single trailing underscore instead of abbreviating or misspelling
        it.
    rationale:
        The intended word stays readable and searchable.
    exceptions:
        cls is the preferred spelling for any variable or argument known to
        be a class, especially the first argument of a class method.
    severity: null
    noncompliant:
        ```python
        \\\
        class Event:
            def __init__(self, kind):
                self.frm = kind.origin
        \\\
        ```
    compliant:
        ```python
        \\\
        class Event:
            def __init__(self, kind):
                self.from_ = kind.origin
        \\\
        ```
    languages: [python]
    tags: [naming, classes]
    source: https://peps.python.org/pep-0008/#designing-for-inheritance
