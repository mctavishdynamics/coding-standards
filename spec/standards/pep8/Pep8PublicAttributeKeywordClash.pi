use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8PublicAttributeKeywordClash:
    standard: @{Pep8}
    ruleId: designing-for-inheritance-keyword-clash
    title: Append an underscore to public attributes that clash with keywords
    statement:
        When the natural name for a public attribute is a Python keyword,
        append one underscore to it rather than shortening or misspelling
        the word.
    rationale:
        The intended word stays readable and searchable.
    exceptions:
        For a variable or parameter that holds a class, and above all for the
        first parameter of a classmethod, the conventional name is cls.
    severity: null
    noncompliant:
        ```python
        \\\
        class Event:
            def __init__(self, kind):
                self.frm = kind.origin
        \\\
        ```
    compliant:
        ```python
        \\\
        class Event:
            def __init__(self, kind):
                self.from_ = kind.origin
        \\\
        ```
    languages: [python]
    tags: [naming, classes]
    source: https://peps.python.org/pep-0008/#designing-for-inheritance
