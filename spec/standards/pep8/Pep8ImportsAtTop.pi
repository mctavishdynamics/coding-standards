use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8ImportsAtTop:
    standard: @{Pep8}
    ruleId: imports-at-top
    title: Place imports at the top of the file
    statement:
        Put imports at the top of the module, after any module comments and
        docstring and before module globals and constants.
    rationale:
        Readers see a module's dependencies in one place before the code
        that uses them.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        """Report generation."""
        MAX_ROWS = 500

        import csv
        \\\
        ```
    compliant:
        ```python
        \\\
        """Report generation."""
        import csv

        MAX_ROWS = 500
        \\\
        ```
    languages: [python]
    tags: [imports, modules]
    source: https://peps.python.org/pep-0008/#imports
