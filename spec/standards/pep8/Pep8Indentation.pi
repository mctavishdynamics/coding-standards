use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8Indentation:
    standard: @{Pep8}
    ruleId: indentation
    title: Use four spaces per indentation level
    statement:
        Indent each block level by four spaces.
    rationale:
        A single fixed width makes nesting easy to see and keeps code from
        different authors aligned the same way.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        def area(width, height):
          if width < 0 or height < 0:
                raise ValueError("negative size")
          return width * height
        \\\
        ```
    compliant:
        ```python
        \\\
        def area(width, height):
            if width < 0 or height < 0:
                raise ValueError("negative size")
            return width * height
        \\\
        ```
    languages: [python]
    tags: [formatting, indentation]
    source: https://peps.python.org/pep-0008/#indentation
