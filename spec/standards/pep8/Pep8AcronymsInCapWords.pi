use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8AcronymsInCapWords:
    standard: @{Pep8}
    ruleId: descriptive-naming-styles-acronyms
    title: Capitalise all letters of acronyms in CapWords
    statement:
        When an acronym appears in a CapWords name, capitalise every letter
        of it.
    rationale:
        The acronym stays recognisable, as in HTTPServerError rather than
        HttpServerError.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        class XmlHttpParser:
            pass
        \\\
        ```
    compliant:
        ```python
        \\\
        class XMLHTTPParser:
            pass
        \\\
        ```
    languages: [python]
    tags: [naming, classes]
    source: https://peps.python.org/pep-0008/#descriptive-naming-styles
