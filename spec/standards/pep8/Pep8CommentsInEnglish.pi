use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8CommentsInEnglish:
    standard: @{Pep8}
    ruleId: comments-english
    title: Write clear comments in English
    statement:
        Make comments clear to other speakers of the language they are
        written in, and write them in English unless you are certain the
        code will only be read by speakers of your language.
    rationale:
        English is the shared language of most Python projects, so English
        comments reach the widest set of readers.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        # Calcula el descuento del cliente.
        discount = rate * subtotal
        \\\
        ```
    compliant:
        ```python
        \\\
        # Calculate the customer's discount.
        discount = rate * subtotal
        \\\
        ```
    languages: [python]
    tags: [comments, wording]
    source: https://peps.python.org/pep-0008/#comments
