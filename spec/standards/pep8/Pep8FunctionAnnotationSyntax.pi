use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8FunctionAnnotationSyntax:
    standard: @{Pep8}
    ruleId: function-annotations
    title: Write function annotations in PEP 484 syntax
    statement:
        Use PEP 484 type hint syntax for function annotations. The older
        experimentation with other annotation styles is no longer
        encouraged.
    rationale:
        A single annotation style lets type checkers and readers interpret
        annotations the same way.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        def resize(image: "the picture", width: "pixels") -> "new picture":
            ...
        \\\
        ```
    compliant:
        ```python
        \\\
        def resize(image: Image, width: int) -> Image:
            ...
        \\\
        ```
    languages: [python]
    tags: [type-hints, functions]
    source: https://peps.python.org/pep-0008/#function-annotations
