use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8Constants:
    standard: @{Pep8}
    ruleId: constants
    title: Write constants in upper case with underscores
    statement:
        Define constants at module level, named in capital letters with
        underscores between words.
    rationale:
        The upper-case style signals that a value is not meant to change.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        maxRetries = 5
        default_timeout = 30
        \\\
        ```
    compliant:
        ```python
        \\\
        MAX_RETRIES = 5
        DEFAULT_TIMEOUT = 30
        \\\
        ```
    languages: [python]
    tags: [naming, constants]
    source: https://peps.python.org/pep-0008/#constants
