use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8DocumentedInterfacesArePublic:
    standard: @{Pep8}
    ruleId: public-and-internal-interfaces
    title: Treat only documented interfaces as public
    statement:
        Consider documented interfaces public unless their documentation
        says they are provisional or internal. Assume every undocumented
        interface is internal, as is anything inside an internal package,
        module or class.
    rationale:
        Backwards compatibility guarantees cover only public interfaces, so
        users must be able to tell the two apart.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [api-design, compatibility]
    source: https://peps.python.org/pep-0008/#public-and-internal-interfaces
