use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8SpacesAroundBinaryOperators:
    standard: @{Pep8}
    ruleId: other-recommendations-operator-spacing
    title: Surround assignment, comparison and Boolean operators with single spaces
    statement:
        Always put a single space on each side of assignment, augmented
        assignment, comparison operators including in, not in, is and is
        not, and the Boolean operators and, or and not.
    rationale:
        These low-priority operators separate the main parts of a statement,
        and spacing makes that structure visible.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        retries+=1
        if retries>=limit and not(quiet):
            status="failed"
        \\\
        ```
    compliant:
        ```python
        \\\
        retries += 1
        if retries >= limit and not quiet:
            status = "failed"
        \\\
        ```
    languages: [python]
    tags: [formatting, whitespace, operators]
    source: https://peps.python.org/pep-0008/#other-recommendations
