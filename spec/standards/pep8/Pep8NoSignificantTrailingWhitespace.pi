use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8NoSignificantTrailingWhitespace:
    standard: @{Pep8}
    ruleId: programming-recommendations-trailing-whitespace-literals
    title: Do not rely on trailing whitespace in string literals
    statement:
        Do not write string literals whose trailing whitespace is
        significant.
    rationale:
        The whitespace is invisible, and editors or tools may trim it.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        # The first line of this literal ends in three spaces you cannot see.
        PROMPT = """Enter name:
        """
        \\\
        ```
    compliant:
        ```python
        \\\
        PROMPT = "Enter name:" + " " * 3
        \\\
        ```
    languages: [python]
    tags: [strings, whitespace]
    source: https://peps.python.org/pep-0008/#programming-recommendations
