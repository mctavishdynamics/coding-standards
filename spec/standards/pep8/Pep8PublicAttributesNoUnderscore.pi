use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8PublicAttributesNoUnderscore:
    standard: @{Pep8}
    ruleId: designing-for-inheritance-public-attributes
    title: Give public attributes no leading underscore
    statement:
        Name public attributes without leading underscores.
    rationale:
        A leading underscore means non-public, so using it on public
        attributes misleads users.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        class Invoice:
            def __init__(self, number):
                self._number = number  # documented for callers
        \\\
        ```
    compliant:
        ```python
        \\\
        class Invoice:
            def __init__(self, number):
                self.number = number
        \\\
        ```
    languages: [python]
    tags: [naming, classes]
    source: https://peps.python.org/pep-0008/#designing-for-inheritance
