use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8TripleQuotedStrings:
    standard: @{Pep8}
    ruleId: string-quotes-triple
    title: Use double quotes for triple-quoted strings
    statement:
        Write triple-quoted strings with double quote characters.
    rationale:
        This matches the docstring convention of PEP 257.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        QUERY = '''
            SELECT id, name FROM users
        '''
        \\\
        ```
    compliant:
        ```python
        \\\
        QUERY = """
            SELECT id, name FROM users
        """
        \\\
        ```
    languages: [python]
    tags: [strings, docstrings]
    source: https://peps.python.org/pep-0008/#string-quotes
