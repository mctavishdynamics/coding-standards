use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8SingleElementTuple:
    standard: @{Pep8}
    ruleId: when-to-use-trailing-commas-singleton-tuple
    title: Parenthesise one-element tuples
    statement:
        A one-element tuple needs a trailing comma; also wrap it in
        parentheses.
    rationale:
        A bare trailing comma is easy to miss, while the parentheses make
        the tuple obvious.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        EXTENSIONS = '.csv',
        \\\
        ```
    compliant:
        ```python
        \\\
        EXTENSIONS = ('.csv',)
        \\\
        ```
    languages: [python]
    tags: [formatting, tuples]
    source: https://peps.python.org/pep-0008/#when-to-use-trailing-commas
