use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8TrailingWhitespace:
    standard: @{Pep8}
    ruleId: other-recommendations-trailing-whitespace
    title: Avoid trailing whitespace
    statement:
        Do not leave whitespace at the end of any line.
    rationale:
        It is invisible and confusing; for example a backslash followed by a
        space is not a line continuation. Many editors strip it and many
        projects reject it in pre-commit hooks.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [formatting, whitespace]
    source: https://peps.python.org/pep-0008/#other-recommendations
