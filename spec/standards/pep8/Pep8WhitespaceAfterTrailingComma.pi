use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8WhitespaceAfterTrailingComma:
    standard: @{Pep8}
    ruleId: pet-peeves-trailing-comma
    title: No space between a trailing comma and a closing parenthesis
    statement:
        A trailing comma is followed directly by the closing parenthesis,
        with nothing in between.
    rationale:
        The space makes a one-element tuple look like it is missing an item.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        origin = (0, )
        \\\
        ```
    compliant:
        ```python
        \\\
        origin = (0,)
        \\\
        ```
    languages: [python]
    tags: [formatting, whitespace]
    source: https://peps.python.org/pep-0008/#pet-peeves
