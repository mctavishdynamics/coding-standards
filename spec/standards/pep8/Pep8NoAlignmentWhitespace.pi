use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8NoAlignmentWhitespace:
    standard: @{Pep8}
    ruleId: pet-peeves-alignment
    title: Do not align assignments with extra spaces
    statement:
        Do not use more than one space around an assignment or other
        operator to line it up with neighbouring lines.
    rationale:
        Alignment has to be redone whenever a name changes, which creates
        noisy diffs.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        host       = "localhost"
        port       = 5432
        max_conns  = 20
        \\\
        ```
    compliant:
        ```python
        \\\
        host = "localhost"
        port = 5432
        max_conns = 20
        \\\
        ```
    languages: [python]
    tags: [formatting, whitespace]
    source: https://peps.python.org/pep-0008/#pet-peeves
