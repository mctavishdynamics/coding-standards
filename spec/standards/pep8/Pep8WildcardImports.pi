use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8WildcardImports:
    standard: @{Pep8}
    ruleId: imports-wildcard
    title: Avoid wildcard imports
    statement:
        Do not use from module import star.
    rationale:
        Wildcard imports hide which names are in the namespace, which
        confuses readers and automated tools.
    exceptions:
        It can be justified when a module republishes an internal interface
        as public API, for example a pure Python module that is replaced by
        an optional accelerated version. The usual public and internal
        interface rules continue to hold.
    severity: null
    noncompliant:
        ```python
        \\\
        from os.path import *

        print(join(base, "data"))
        \\\
        ```
    compliant:
        ```python
        \\\
        from os.path import join

        print(join(base, "data"))
        \\\
        ```
    languages: [python]
    tags: [imports, namespaces]
    source: https://peps.python.org/pep-0008/#imports
