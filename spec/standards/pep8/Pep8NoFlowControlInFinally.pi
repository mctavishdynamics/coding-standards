use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8NoFlowControlInFinally:
    standard: @{Pep8}
    ruleId: programming-recommendations-finally-flow-control
    title: Avoid return, break and continue that leave a finally block
    statement:
        Do not use return, break or continue inside a finally suite when
        they would jump out of it.
    rationale:
        Such a jump silently cancels any exception propagating through the
        finally suite.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        def save(record):
            try:
                db.write(record)
            finally:
                return True
        \\\
        ```
    compliant:
        ```python
        \\\
        def save(record):
            try:
                db.write(record)
            finally:
                db.flush()
            return True
        \\\
        ```
    languages: [python]
    tags: [exceptions, control-flow]
    source: https://peps.python.org/pep-0008/#programming-recommendations
