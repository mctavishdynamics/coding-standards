use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8AbsoluteImports:
    standard: @{Pep8}
    ruleId: imports-absolute
    title: Prefer absolute imports
    statement:
        Prefer absolute imports. In a complicated package where an absolute
        path would be needlessly long, an explicit relative import is also
        fine.
    rationale:
        Absolute imports are more readable and fail with clearer errors when
        the import system is misconfigured.
    exceptions:
        Standard library code should avoid complex layouts and always use
        absolute imports.
    severity: null
    noncompliant:
        ```python
        \\\
        # inside myapp/billing/invoice.py, relying on implicit path setup
        import tax
        \\\
        ```
    compliant:
        ```python
        \\\
        from myapp.billing import tax
        from . import tax
        \\\
        ```
    languages: [python]
    tags: [imports]
    source: https://peps.python.org/pep-0008/#imports
