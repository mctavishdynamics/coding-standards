use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8ImportGrouping:
    standard: @{Pep8}
    ruleId: imports-grouping
    title: Group imports by standard library, third party and local
    statement:
        Order imports in three groups, standard library first, then related
        third-party packages, then local application or library imports. Put
        a blank line between groups.
    rationale:
        Grouping shows at a glance where each dependency comes from.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        from myapp.models import Order
        import requests
        import os
        \\\
        ```
    compliant:
        ```python
        \\\
        import os

        import requests

        from myapp.models import Order
        \\\
        ```
    languages: [python]
    tags: [imports, formatting]
    source: https://peps.python.org/pep-0008/#imports
