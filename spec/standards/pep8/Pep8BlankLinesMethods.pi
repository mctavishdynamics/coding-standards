use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8BlankLinesMethods:
    standard: @{Pep8}
    ruleId: blank-lines-methods
    title: Separate method definitions with one blank line
    statement:
        Surround method definitions inside a class with a single blank line.
    rationale:
        One blank line separates methods clearly while keeping them visibly
        part of the same class.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        class Counter:
            def __init__(self):
                self.count = 0
            def increment(self):
                self.count += 1
        \\\
        ```
    compliant:
        ```python
        \\\
        class Counter:
            def __init__(self):
                self.count = 0

            def increment(self):
                self.count += 1
        \\\
        ```
    languages: [python]
    tags: [formatting, blank-lines]
    source: https://peps.python.org/pep-0008/#blank-lines
