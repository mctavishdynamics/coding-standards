use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8ImportsOnSeparateLines:
    standard: @{Pep8}
    ruleId: imports-separate-lines
    title: Put each import on its own line
    statement:
        Import one module per import statement. Importing several names from
        one module in a single from-import is fine.
    rationale:
        Separate lines are easier to scan, sort and change in diffs.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        import json, pathlib
        \\\
        ```
    compliant:
        ```python
        \\\
        import json
        import pathlib
        from collections import Counter, defaultdict
        \\\
        ```
    languages: [python]
    tags: [imports, formatting]
    source: https://peps.python.org/pep-0008/#imports
