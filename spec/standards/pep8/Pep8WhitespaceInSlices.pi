use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8WhitespaceInSlices:
    standard: @{Pep8}
    ruleId: pet-peeves-slices
    title: Space slice colons like a low-priority binary operator
    statement:
        Treat the colon in a slice as a binary operator with the lowest
        priority and give it equal space on both sides. In an extended slice
        both colons get the same spacing. When a slice parameter is omitted,
        omit the space too.
    rationale:
        Balanced spacing shows the bounds of the slice, especially when they
        are expressions.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        page = rows[start + offset:end + offset]
        head = rows[ :limit]
        step = rows[1: 9 :2]
        \\\
        ```
    compliant:
        ```python
        \\\
        page = rows[start + offset : end + offset]
        head = rows[:limit]
        step = rows[1:9:2]
        \\\
        ```
    languages: [python]
    tags: [formatting, whitespace, slicing]
    source: https://peps.python.org/pep-0008/#pet-peeves
