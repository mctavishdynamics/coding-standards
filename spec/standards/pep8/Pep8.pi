from ./Pep8WhitespaceInsideBrackets import Pep8WhitespaceInsideBrackets
from ./Pep8WildcardImports import Pep8WildcardImports
from ./Pep8WithForLocalResources import Pep8WithForLocalResources

export coding-standard Pep8:
    title: PEP 8 - Style Guide for Python Code
    publisher: Python Software Foundation
    url: https://peps.python.org/pep-0008/
    version: 2025-04-04
    license: Public domain
    description:
        Style conventions for Python code covering layout, imports,
        whitespace, comments, naming and programming recommendations.
        Written for the standard library and widely adopted across the
        Python ecosystem.
    rules:
        - @{Pep8FoolishConsistency}
        - @{Pep8Indentation}
        - @{Pep8ContinuationLines}
        - @{Pep8ClosingBracketPlacement}
        - @{Pep8TabsOrSpaces}
        - @{Pep8MaximumLineLength}
        - @{Pep8ImpliedLineContinuation}
        - @{Pep8LineBreakBeforeBinaryOperator}
        - @{Pep8BlankLinesTopLevel}
        - @{Pep8BlankLinesMethods}
        - @{Pep8BlankLinesSparingly}
        - @{Pep8SourceFileEncoding}
        - @{Pep8NonAsciiSparingly}
        - @{Pep8EnglishAsciiIdentifiers}
        - @{Pep8ImportsOnSeparateLines}
        - @{Pep8ImportsAtTop}
        - @{Pep8ImportGrouping}
        - @{Pep8AbsoluteImports}
        - @{Pep8ImportingClasses}
        - @{Pep8WildcardImports}
        - @{Pep8ModuleLevelDunderNames}
        - @{Pep8StringQuotes}
        - @{Pep8TripleQuotedStrings}
        - @{Pep8WhitespaceInsideBrackets}
        - @{Pep8WhitespaceAfterTrailingComma}
        - @{Pep8WhitespaceBeforePunctuation}
        - @{Pep8WhitespaceInSlices}
        - @{Pep8WhitespaceBeforeCallParenthesis}
        - @{Pep8WhitespaceBeforeIndexBracket}
        - @{Pep8NoAlignmentWhitespace}
        - @{Pep8TrailingWhitespace}
        - @{Pep8SpacesAroundBinaryOperators}
        - @{Pep8OperatorPriorityWhitespace}
        - @{Pep8AnnotationSpacing}
        - @{Pep8KeywordArgumentEquals}
        - @{Pep8AnnotatedDefaultEquals}
        - @{Pep8CompoundStatements}
        - @{Pep8MultiClauseStatements}
        - @{Pep8SingleElementTuple}
        - @{Pep8TrailingCommasMultiline}
        - @{Pep8CommentsUpToDate}
        - @{Pep8CommentsCompleteSentences}
        - @{Pep8CommentsInEnglish}
        - @{Pep8BlockComments}
        - @{Pep8InlineComments}
        - @{Pep8DocstringsForPublicApi}
        - @{Pep8DocstringClosingQuotes}
        - @{Pep8NamingConsistency}
        - @{Pep8OverridingPrinciple}
        - @{Pep8AcronymsInCapWords}
        - @{Pep8NoInventedDunderNames}
        - @{Pep8NamesToAvoid}
        - @{Pep8AsciiCompatibility}
        - @{Pep8PackageAndModuleNames}
        - @{Pep8ClassNames}
        - @{Pep8TypeVariableNames}
        - @{Pep8ExceptionNames}
        - @{Pep8GlobalVariableNames}
        - @{Pep8FunctionAndVariableNames}
        - @{Pep8SelfAndClsArguments}
        - @{Pep8ArgumentKeywordClash}
        - @{Pep8MethodAndInstanceVariableNames}
        - @{Pep8NameMangling}
        - @{Pep8Constants}
        - @{Pep8DecidePublicOrNonPublic}
        - @{Pep8PublicAttributesNoUnderscore}
        - @{Pep8PublicAttributeKeywordClash}
        - @{Pep8SimpleDataAttributes}
        - @{Pep8SubclassPrivateAttributes}
        - @{Pep8DocumentedInterfacesArePublic}
        - @{Pep8DeclarePublicApiWithAll}
        - @{Pep8PrefixInternalNames}
        - @{Pep8ImportedNamesAreInternal}
        - @{Pep8PortableAcrossImplementations}
        - @{Pep8CompareSingletonsWithIs}
        - @{Pep8ExplicitNoneTest}
        - @{Pep8IsNotOperator}
        - @{Pep8RichComparisons}
        - @{Pep8DefNotLambdaAssignment}
        - @{Pep8DeriveFromException}
        - @{Pep8ExceptionHierarchyDesign}
        - @{Pep8ExceptionChaining}
        - @{Pep8CatchSpecificExceptions}
        - @{Pep8OsErrorHierarchy}
        - @{Pep8MinimalTryClause}
        - @{Pep8WithForLocalResources}
        - @{Pep8ExplicitContextManagers}
        - @{Pep8ConsistentReturns}
        - @{Pep8StartswithEndswith}
        - @{Pep8UseIsinstance}
        - @{Pep8EmptySequencesAreFalse}
        - @{Pep8NoSignificantTrailingWhitespace}
        - @{Pep8NoBooleanComparison}
        - @{Pep8NoFlowControlInFinally}
        - @{Pep8FunctionAnnotationSyntax}
        - @{Pep8StdlibAnnotationAdoption}
        - @{Pep8TypeIgnoreComment}
        - @{Pep8VariableAnnotationSpacing}
        - @{Pep8VariableAnnotationsInStubs}
