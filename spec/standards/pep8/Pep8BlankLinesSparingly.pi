use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8BlankLinesSparingly:
    standard: @{Pep8}
    ruleId: blank-lines-sparingly
    title: Use extra blank lines sparingly
    statement:
        A few extra blank lines may divide clusters of related functions,
        and blank lines inside a function may mark its logical steps; do not
        overdo either. A sequence of related one-line definitions can go
        without blank lines between them.
    rationale:
        Blank lines carry meaning only when they are rare; too many spread
        code out without showing structure.
    exceptions:
        A form feed character may be used to separate pages of related
        sections, though some viewers show it as a glyph.
    severity: null
    noncompliant:
        ```python
        \\\
        def checkout(cart):

            total = cart.total()


            tax = total * TAX_RATE

            return total + tax
        \\\
        ```
    compliant:
        ```python
        \\\
        def checkout(cart):
            total = cart.total()
            tax = total * TAX_RATE

            return total + tax
        \\\
        ```
    languages: [python]
    tags: [formatting, blank-lines]
    source: https://peps.python.org/pep-0008/#blank-lines
