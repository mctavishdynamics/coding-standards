use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8AnnotationSpacing:
    standard: @{Pep8}
    ruleId: other-recommendations-annotations
    title: Space function annotation colons and arrows normally
    statement:
        In function annotations, follow the usual colon spacing and always
        put spaces around the return arrow.
    rationale:
        Annotations read like the rest of the code when they follow the same
        spacing rules.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        def parse(text:str)->int: ...
        \\\
        ```
    compliant:
        ```python
        \\\
        def parse(text: str) -> int: ...
        \\\
        ```
    languages: [python]
    tags: [formatting, whitespace, type-hints]
    source: https://peps.python.org/pep-0008/#other-recommendations
