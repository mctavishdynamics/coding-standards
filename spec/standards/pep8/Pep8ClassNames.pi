use ../lib/CodingRule

from ./Pep8 import Pep8

export coding-rule Pep8ClassNames:
    standard: @{Pep8}
    ruleId: class-names
    title: Use CapWords for class names
    statement:
        Name classes in CapWords.
    rationale:
        The capitalised style tells readers at a glance that a name is a
        class.
    exceptions:
        A class whose interface is documented and used mainly as a callable
        may use the function naming style. Built-in names have their own
        convention, mostly single lower-case words.
    severity: null
    noncompliant:
        ```python
        \\\
        class shopping_cart:
            pass
        \\\
        ```
    compliant:
        ```python
        \\\
        class ShoppingCart:
            pass
        \\\
        ```
    languages: [python]
    tags: [naming, classes]
    source: https://peps.python.org/pep-0008/#class-names
