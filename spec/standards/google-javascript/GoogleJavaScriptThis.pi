use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptThis:
    standard: @{GoogleJavaScript}
    ruleId: 5.9
    title: Use this only in class code or with an explicit @this
    statement:
        Restrict this to class constructors and methods, to arrow functions
        defined within them, and to functions whose JSDoc has an explicit
        @this. Never use this to reach the global object, an eval context or
        an event target, and do not use it needlessly with call or apply.
    rationale:
        Outside these places the value of this depends on how a function is
        called, which is a common source of bugs.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        function onClick() {
          this.classList.toggle('active');
        }
        \\\
        ```
    compliant:
        ```javascript
        \\\
        button.addEventListener('click', (event) => {
          event.currentTarget.classList.toggle('active');
        });
        \\\
        ```
    languages: [javascript]
    tags: [this, functions]
    source: https://google.github.io/styleguide/jsguide.html#59-this
