use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptAuthorTagNotRecommended:
    standard: @{GoogleJavaScript}
    ruleId: 9.1.2.1
    title: Do not use @author or @owner
    statement:
        Avoid the @author and @owner JSDoc tags.
    rationale:
        Ownership recorded in comments goes stale; version control already
        tracks authorship.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        /**
         * @fileoverview Helpers for form validation.
         * @author jdoe@example.com (Jane Doe)
         */
        \\\
        ```
    compliant:
        ```javascript
        \\\
        /**
         * @fileoverview Helpers for form validation.
         */
        \\\
        ```
    languages: [javascript]
    tags: [jsdoc, documentation]
    source: https://google.github.io/styleguide/jsguide.html#9121-author-or-owner---not-recommended
