use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptLocalStyleRules:
    standard: @{GoogleJavaScript}
    ruleId: 8.5
    title: Do not let local style rules block cleanups
    statement:
        A team can add its own style rules, but cleanup changes are not
        obliged to follow them, and the team must not block such changes for
        breaking them. Skip rules that have no purpose.
    rationale:
        Codebase-wide cleanups would stall if every local rule could block
        them.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [javascript]
    tags: [process, consistency]
    source: https://google.github.io/styleguide/jsguide.html#85-local-style-rules
