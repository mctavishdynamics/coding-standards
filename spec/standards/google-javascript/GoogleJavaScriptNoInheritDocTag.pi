use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptNoInheritDocTag:
    standard: @{GoogleJavaScript}
    ruleId: 9.1.4.2
    title: Use @override instead of @inheritDoc
    statement:
        Do not use the deprecated @inheritDoc annotation; mark overriding
        methods with @override.
    rationale:
        @override is the standard annotation the compiler checks.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        /** @inheritDoc */
        render() {}
        \\\
        ```
    compliant:
        ```javascript
        \\\
        /** @override */
        render() {}
        \\\
        ```
    languages: [javascript]
    tags: [jsdoc, deprecated, closure]
    source: https://google.github.io/styleguide/jsguide.html#9142-inheritdoc---deprecated-do-not-use
