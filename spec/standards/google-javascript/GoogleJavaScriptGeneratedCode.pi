use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptGeneratedCode:
    standard: @{GoogleJavaScript}
    ruleId: 8.6
    title: Name generated identifiers per the guide when hand-written code uses them
    statement:
        Build-generated code need not follow Google style, but any generated
        identifier referenced from hand-written code must follow the naming
        rules. Such identifiers may also contain underscores to avoid
        conflicts.
    rationale:
        Hand-written code should read the same whether a name was typed or
        generated.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [javascript]
    tags: [naming, generated-code]
    source: https://google.github.io/styleguide/jsguide.html#86-generated-code-mostly-exempt
