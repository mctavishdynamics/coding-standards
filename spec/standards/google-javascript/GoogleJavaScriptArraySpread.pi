use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptArraySpread:
    standard: @{GoogleJavaScript}
    ruleId: 5.2.5
    title: Use array spread instead of Array.prototype tricks
    statement:
        Use the spread operator to copy or combine iterables in array
        literals rather than awkward Array.prototype calls. Write no space
        after the three dots.
    rationale:
        Spread is shorter and clearer than slice.call or concat and works
        with any iterable.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const copy = Array.prototype.slice.call(nodes);
        const all = local.concat(remote);
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const copy = [...nodes];
        const all = [...local, ...remote];
        \\\
        ```
    languages: [javascript]
    tags: [arrays, spread]
    source: https://google.github.io/styleguide/jsguide.html#525-spread-operator
