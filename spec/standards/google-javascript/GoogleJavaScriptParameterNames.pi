use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptParameterNames:
    standard: @{GoogleJavaScript}
    ruleId: 6.2.7
    title: Write parameter names in lowerCamelCase
    statement:
        Write parameter names in lowerCamelCase, even when the parameter
        holds a constructor. Do not use one-character parameter names in
        public methods.
    rationale:
        Parameters are part of the API's documentation, so they should be
        readable and consistently cased.
    exceptions:
        A third-party framework may require parameter names that begin with
        a dollar sign.
    severity: null
    noncompliant:
        ```javascript
        \\\
        export function register(N, Ctor) {}
        \\\
        ```
    compliant:
        ```javascript
        \\\
        export function register(name, widgetCtor) {}
        \\\
        ```
    languages: [javascript]
    tags: [naming, parameters]
    source: https://google.github.io/styleguide/jsguide.html#627-parameter-names
