use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptFileImplementation:
    standard: @{GoogleJavaScript}
    ruleId: 3.7
    title: Put the implementation after all dependency declarations
    statement:
        The implementation, meaning exported symbols and module-local
        declarations, comes only after all dependency information, with one
        or more blank lines in between.
    rationale:
        Keeping dependencies above the code means a reader sees everything
        the file relies on before reading how it works.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const events = goog.require('goog.events');
        let clickCount = 0;
        const style = goog.require('goog.style');
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const events = goog.require('goog.events');
        const style = goog.require('goog.style');

        let clickCount = 0;
        \\\
        ```
    languages: [javascript]
    tags: [source-files, modules]
    source: https://google.github.io/styleguide/jsguide.html#37-the-files-implementation
