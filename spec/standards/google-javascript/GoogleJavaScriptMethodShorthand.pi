use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptMethodShorthand:
    standard: @{GoogleJavaScript}
    ruleId: 5.3.5
    title: Define object literal methods with method shorthand
    statement:
        On object literals, methods can be written in shorthand form rather
        than as a property holding a function or arrow function. Inside a
        shorthand method this refers to the object, whereas an arrow
        function takes this from the enclosing scope.
    rationale:
        Shorthand is concise and gives the method the expected this binding.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const counter = {
          count: 0,
          increment: function() {
            this.count++;
          },
        };
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const counter = {
          count: 0,
          increment() {
            this.count++;
          },
        };
        \\\
        ```
    languages: [javascript]
    tags: [objects, functions]
    source: https://google.github.io/styleguide/jsguide.html#535-method-shorthand
