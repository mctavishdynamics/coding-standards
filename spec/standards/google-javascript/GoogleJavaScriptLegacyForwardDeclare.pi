use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptLegacyForwardDeclare:
    standard: @{GoogleJavaScript}
    ruleId: 9.4.4.3
    title: Prefer goog.requireType over goog.forwardDeclare
    statement:
        Break circular dependencies within a library with goog.requireType
        rather than goog.forwardDeclare. Any goog.forwardDeclare follows the
        same style as requires and is sorted with them. Do not use it to
        break cycles across libraries; reorganise the libraries instead.
    rationale:
        Build tools handle goog.forwardDeclare badly, whereas requireType is
        allowed to load a namespace that has not been defined yet.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        goog.forwardDeclare('app.Editor');
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const Editor = goog.requireType('app.Editor');
        \\\
        ```
    languages: [javascript]
    tags: [legacy, closure, dependencies]
    source: https://google.github.io/styleguide/jsguide.html#9443-googforwarddeclare
