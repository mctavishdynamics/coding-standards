use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptReferencingGoog:
    standard: @{GoogleJavaScript}
    ruleId: 3.4.4.1
    title: Import goog.js to reference the goog namespace
    statement:
        In an ES module, reference the Closure goog namespace by importing
        Closure's goog.js rather than using the global.
    rationale:
        The import makes the dependency explicit and exposes only the subset
        of goog that is safe in ES modules.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        // relies on the global goog
        const {assert} = goog.require('goog.asserts');
        \\\
        ```
    compliant:
        ```javascript
        \\\
        import * as goog from '../closure/goog/goog.js';

        const {assert} = goog.require('goog.asserts');
        \\\
        ```
    languages: [javascript]
    tags: [modules, closure]
    source: https://google.github.io/styleguide/jsguide.html#3441-referencing-goog
