use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptLicenseOrCopyright:
    standard: @{GoogleJavaScript}
    ruleId: 3.1
    title: Put license or copyright information first
    statement:
        If a file needs license or copyright information, place it at the
        very top of the file, before everything else.
    rationale:
        Legal notices are easy to find and check when they always sit in the
        same place.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [javascript]
    tags: [source-files, licensing]
    source: https://google.github.io/styleguide/jsguide.html#31-license-or-copyright-information-if-present
