use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptReformattingExistingCode:
    standard: @{GoogleJavaScript}
    ruleId: 8.4.1
    title: Reformat existing code only when making significant changes
    statement:
        Existing code need not be updated to current style, but a file
        undergoing significant changes is expected to end up in Google
        style. Keep opportunistic style fixes out of unrelated changes,
        moving large ones to a separate change.
    rationale:
        Reformatting trades churn against consistency, and mixing it into
        functional changes makes review harder.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [javascript]
    tags: [process, consistency]
    source: https://google.github.io/styleguide/jsguide.html#841-reformatting-existing-code
