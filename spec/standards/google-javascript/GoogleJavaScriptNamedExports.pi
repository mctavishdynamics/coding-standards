use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptNamedExports:
    standard: @{GoogleJavaScript}
    ruleId: 3.4.2.1
    title: Use named exports, never default exports
    statement:
        Export with named exports, either by putting export on a declaration
        or with an export list. Do not use default exports.
    rationale:
        A default export makes every importer choose a name, which leads to
        the same value having different names in different modules.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        export default class Scheduler {}
        \\\
        ```
    compliant:
        ```javascript
        \\\
        export class Scheduler {}
        \\\
        ```
    languages: [javascript]
    tags: [modules, exports]
    source: https://google.github.io/styleguide/jsguide.html#3421-named-vs-default-exports
