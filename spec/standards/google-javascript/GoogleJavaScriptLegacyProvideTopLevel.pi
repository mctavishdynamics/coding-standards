use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptLegacyProvideTopLevel:
    standard: @{GoogleJavaScript}
    ruleId: 9.4.4.1
    title: Provide only top-level classes
    statement:
        Keep all members of a class in the same file and provide only the
        top-level class, not its enums, inner classes or static members.
        Members of plain namespaces may be provided.
    rationale:
        Providing sub-members of a class splits one type across many names
        and confuses dependency tracking.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        goog.provide('app.Toolbar');
        goog.provide('app.Toolbar.Mode');
        goog.provide('app.Toolbar.create');
        \\\
        ```
    compliant:
        ```javascript
        \\\
        goog.provide('app.Toolbar');
        \\\
        ```
    languages: [javascript]
    tags: [legacy, closure, dependencies]
    source: https://google.github.io/styleguide/jsguide.html#9441-summary
