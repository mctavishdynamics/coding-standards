use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptNewCodeGoogleStyle:
    standard: @{GoogleJavaScript}
    ruleId: 8.4.2
    title: Write new code in Google style
    statement:
        Brand-new files use Google style regardless of their neighbours.
        When adding to a non-conforming file, reformat it first if
        practical; otherwise keep the new code consistent with the file
        without violating the guide.
    rationale:
        New code is the cheapest place to apply the standard, and it should
        never add fresh violations.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [javascript]
    tags: [process, consistency]
    source: https://google.github.io/styleguide/jsguide.html#842-newly-added-code-use-google-style
