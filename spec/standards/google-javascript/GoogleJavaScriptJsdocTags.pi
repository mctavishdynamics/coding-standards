use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptJsdocTags:
    standard: @{GoogleJavaScript}
    ruleId: 7.3
    title: Give most JSDoc tags their own line
    statement:
        Use only the JSDoc tags Google style allows. Most tags occupy their
        own line, starting at the beginning of the line. Simple tags without
        extra data, such as @private, @const, @final or @export, may share a
        line. Combine and order tags consistently.
    rationale:
        One tag per line keeps annotations easy to read and parse.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        /**
         * @param {number} width @param {number} height
         */
        \\\
        ```
    compliant:
        ```javascript
        \\\
        /**
         * @param {number} width
         * @param {number} height
         * @export @final
         */
        \\\
        ```
    languages: [javascript]
    tags: [jsdoc, formatting]
    source: https://google.github.io/styleguide/jsguide.html#73-jsdoc-tags
