use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptBlockCommentStyle:
    standard: @{GoogleJavaScript}
    ruleId: 4.8.1
    title: Indent block comments with the code and align their asterisks
    statement:
        Align a block comment's indentation with the code around it, writing
        it in either slash-star or double-slash form. In a multi-line slash-
        star comment, begin every continuation line with an asterisk lined
        up under the previous one. Never enclose comments in drawn boxes,
        and keep JSDoc out of implementation comments.
    rationale:
        Aligned asterisks mark every line as a comment without extra
        context, and JSDoc syntax is reserved for documentation tools.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        /************************
         * Retry with backoff.   *
         ************************/
        /** Skip empty batches. */
        if (batch.length === 0) return;
        \\\
        ```
    compliant:
        ```javascript
        \\\
        /*
         * Retry with exponential backoff.
         * Give up after five attempts.
         */
        // Skip empty batches.
        if (batch.length === 0) return;
        \\\
        ```
    languages: [javascript]
    tags: [comments, formatting]
    source: https://google.github.io/styleguide/jsguide.html#481-block-comment-style
