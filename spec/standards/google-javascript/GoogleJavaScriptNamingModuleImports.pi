use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptNamingModuleImports:
    standard: @{GoogleJavaScript}
    ruleId: 3.4.1.3.1
    title: Name module imports after the imported file
    statement:
        Name a namespace import in lowerCamelCase, derived from the imported
        file's name.
    rationale:
        A name tied to the file tells the reader where each qualified
        reference comes from.
    exceptions:
        A library whose common prefix is overwhelmingly established,
        currently only threejs with THREE, may keep that prefix.
    severity: null
    noncompliant:
        ```javascript
        \\\
        import * as Util from './date-utils.js';
        import * as x from './geometry.js';
        \\\
        ```
    compliant:
        ```javascript
        \\\
        import * as dateUtils from './date-utils.js';
        import * as geometry from './geometry.js';
        \\\
        ```
    languages: [javascript]
    tags: [modules, imports, naming]
    source: https://google.github.io/styleguide/jsguide.html#34131-naming-module-imports
