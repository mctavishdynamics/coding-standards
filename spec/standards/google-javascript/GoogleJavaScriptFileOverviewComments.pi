use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptFileOverviewComments:
    standard: @{GoogleJavaScript}
    ruleId: 7.5
    title: Add a file overview when a file holds more than one class
    statement:
        A file may begin with a fileoverview comment describing its
        contents, dependencies or compatibility; it is recommended when the
        file contains more than a single class. Copyright, author and
        default visibility are optional, and wrapped lines are not indented.
    rationale:
        An overview orients readers who are unfamiliar with the file.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```javascript
        \\\
        /**
         * @fileoverview Date helpers shared by the calendar and booking views.
         * Depends on the locale data loaded at startup.
         */
        \\\
        ```
    languages: [javascript]
    tags: [jsdoc, documentation, source-files]
    source: https://google.github.io/styleguide/jsguide.html#75-topfile-level-comments
