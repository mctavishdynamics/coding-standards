use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptHorizontalWhitespace:
    standard: @{GoogleJavaScript}
    ruleId: 4.6.2
    title: Use single spaces only where the guide calls for them
    statement:
        Never leave trailing whitespace. Use one space between a keyword and
        a following parenthesis or a preceding closing brace, before an
        opening brace, around binary and ternary operators, after commas,
        semicolons and object-literal colons, and around the double slash of
        an end-of-line comment.
    rationale:
        Fixed spacing rules remove whitespace debates and keep diffs free of
        meaningless changes.
    exceptions:
        Omit the space before an object literal used as a function's first
        argument or an array's first element, and inside template
        expansions. Never put a space in front of a comma or semicolon.
    severity: null
    noncompliant:
        ```javascript
        \\\
        if(count>limit){
          notify (count,limit);
        }else{
          reset() ;//done
        }
        \\\
        ```
    compliant:
        ```javascript
        \\\
        if (count > limit) {
          notify(count, limit);
        } else {
          reset();  // done
        }
        \\\
        ```
    languages: [javascript]
    tags: [formatting, whitespace]
    source: https://google.github.io/styleguide/jsguide.html#462-horizontal-whitespace
