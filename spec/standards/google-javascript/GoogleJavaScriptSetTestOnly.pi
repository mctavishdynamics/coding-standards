use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptSetTestOnly:
    standard: @{GoogleJavaScript}
    ruleId: 3.5
    title: Place goog.setTestOnly right after the module declaration
    statement:
        If a file calls goog.setTestOnly, put the call directly after the
        goog.module statement and any declareLegacyNamespace call, or
        directly after the imports in an ES module.
    rationale:
        A fixed position makes test-only files recognisable at a glance.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        goog.module('cart.testing.fakes');

        const Cart = goog.require('cart.Cart');
        goog.setTestOnly();
        \\\
        ```
    compliant:
        ```javascript
        \\\
        goog.module('cart.testing.fakes');
        goog.setTestOnly();

        const Cart = goog.require('cart.Cart');
        \\\
        ```
    languages: [javascript]
    tags: [modules, testing, closure]
    source: https://google.github.io/styleguide/jsguide.html#35-googsettestonly
