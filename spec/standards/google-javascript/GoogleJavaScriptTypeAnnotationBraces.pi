use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptTypeAnnotationBraces:
    standard: @{GoogleJavaScript}
    ruleId: 7.10
    title: Enclose JSDoc type annotations in braces
    statement:
        Type annotations appear on @param, @return, @this and @type, and
        optionally on @const, @export and visibility tags. Always enclose
        the type in braces.
    rationale:
        The braces tell the compiler where the type ends and the description
        begins.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        /** @param string name */
        \\\
        ```
    compliant:
        ```javascript
        \\\
        /** @param {string} name */
        \\\
        ```
    languages: [javascript]
    tags: [jsdoc, types]
    source: https://google.github.io/styleguide/jsguide.html#710-type-annotations
