use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptArrayTrailingCommas:
    standard: @{GoogleJavaScript}
    ruleId: 5.2.1
    title: Use trailing commas in multi-line array literals
    statement:
        Add a trailing comma after the last element whenever a line break
        separates it from the closing bracket.
    rationale:
        Adding or moving elements then touches only the lines that change,
        giving cleaner diffs.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const colors = [
          'red',
          'green'
        ];
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const colors = [
          'red',
          'green',
        ];
        \\\
        ```
    languages: [javascript]
    tags: [formatting, arrays]
    source: https://google.github.io/styleguide/jsguide.html#521-use-trailing-commas
