use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptNoCodeTag:
    standard: @{GoogleJavaScript}
    ruleId: 9.1.2.3
    title: Use Markdown backticks instead of the code tag
    statement:
        Do not use the deprecated inline code JSDoc tag; mark code terms
        with Markdown backticks instead.
    rationale:
        JSDoc is written in Markdown, which already has a code span syntax.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```javascript
        \\\
        /** Returns the cached `Session`, creating one if needed. */
        function getSession() {}
        \\\
        ```
    languages: [javascript]
    tags: [jsdoc, deprecated]
    source: https://google.github.io/styleguide/jsguide.html#9123-code---deprecated-do-not-use
