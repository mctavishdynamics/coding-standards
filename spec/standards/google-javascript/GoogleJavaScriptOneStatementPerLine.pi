use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptOneStatementPerLine:
    standard: @{GoogleJavaScript}
    ruleId: 4.3.1
    title: Put one statement per line
    statement:
        End every statement with a line break; do not put several statements
        on one line.
    rationale:
        One statement per line makes code easier to read, debug and diff.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const x = point.x; const y = point.y;
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const x = point.x;
        const y = point.y;
        \\\
        ```
    languages: [javascript]
    tags: [formatting, statements]
    source: https://google.github.io/styleguide/jsguide.html#431-one-statement-per-line
