use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptObjectTrailingCommas:
    standard: @{GoogleJavaScript}
    ruleId: 5.3.1
    title: Use trailing commas in multi-line object literals
    statement:
        Add a trailing comma after the last property whenever a line break
        separates it from the closing brace.
    rationale:
        Each new property then changes only one line, keeping diffs small.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const point = {
          x: 1,
          y: 2
        };
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const point = {
          x: 1,
          y: 2,
        };
        \\\
        ```
    languages: [javascript]
    tags: [formatting, objects]
    source: https://google.github.io/styleguide/jsguide.html#531-use-trailing-commas
