use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptGroupingParentheses:
    standard: @{GoogleJavaScript}
    ruleId: 4.7
    title: Use grouping parentheses unless clearly unnecessary
    statement:
        Drop parentheses that are optional only if both the author and the
        reviewer are confident nobody will misread the expression. The operand
        that follows a keyword operator, like typeof, delete or void, or a
        statement keyword such as return, throw, case or yield, or the in and of
        of a loop, should not be wrapped as a whole. A type cast always takes
        parentheses.
    rationale:
        Readers do not all remember the full precedence table, but redundant
        parentheses around a whole operand only add clutter.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const ok = a && b || c;
        return (items.length);
        if (typeof (value) === 'string') {}
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const ok = (a && b) || c;
        return items.length;
        if (typeof value === 'string') {}
        \\\
        ```
    languages: [javascript]
    tags: [formatting, expressions, readability]
    source: https://google.github.io/styleguide/jsguide.html#47-grouping-parentheses-recommended
