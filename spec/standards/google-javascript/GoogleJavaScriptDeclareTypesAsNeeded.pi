use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptDeclareTypesAsNeeded:
    standard: @{GoogleJavaScript}
    ruleId: 5.1.4
    title: Annotate variable types above or inline, not both
    statement:
        A JSDoc type annotation may sit on the line before a declaration,
        or, when the declaration carries no other JSDoc, inline just ahead
        of the variable name. Use only one of these forms per declaration.
    rationale:
        The compiler reads only the first JSDoc, so an inline type next to a
        JSDoc block is silently lost.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        /** Pending upload ids. */
        const /** !Array<string> */ pending = [];
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const /** !Array<string> */ pending = [];

        /**
         * Pending upload ids.
         * @type {!Array<string>}
         */
        const queued = [];
        \\\
        ```
    languages: [javascript]
    tags: [jsdoc, types, variables]
    source: https://google.github.io/styleguide/jsguide.html#514-declare-types-as-needed
