use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptNoCircularDependencies:
    standard: @{GoogleJavaScript}
    ruleId: 3.4.3
    title: Do not create cycles between ES modules
    statement:
        Do not create import cycles between ES modules, even though the
        language allows them. Remember that export from statements can
        create cycles too.
    rationale:
        Cycles make initialization order fragile and can expose bindings
        before they are set.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        // user.js
        import {Team} from './team.js';
        // team.js
        import {User} from './user.js';
        \\\
        ```
    compliant:
        ```javascript
        \\\
        // user.js
        export class User {}
        // team.js
        import {User} from './user.js';
        \\\
        ```
    languages: [javascript]
    tags: [modules, dependencies]
    source: https://google.github.io/styleguide/jsguide.html#343-circular-dependencies-in-es-modules
