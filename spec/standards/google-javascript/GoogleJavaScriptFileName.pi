use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptFileName:
    standard: @{GoogleJavaScript}
    ruleId: 2.1
    title: Name files in lowercase with a .js extension
    statement:
        File names are all lowercase and may contain underscores or dashes
        but no other punctuation. Follow the convention your project already
        uses, and always end the name with .js.
    rationale:
        Lowercase names avoid trouble on case-insensitive file systems and
        keep imports predictable across a codebase.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        // File: OrderQueue.JS
        // File: order.queue.js
        \\\
        ```
    compliant:
        ```javascript
        \\\
        // File: order_queue.js
        // File: order-queue.js
        \\\
        ```
    languages: [javascript]
    tags: [source-files, naming]
    source: https://google.github.io/styleguide/jsguide.html#21-file-name
