use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptLegacyDeclareLegacyNamespace:
    standard: @{GoogleJavaScript}
    ruleId: 9.4.4.5
    title: Use declareLegacyNamespace only while migrating
    statement:
        goog.module.declareLegacyNamespace is a stopgap for the period when a
        file and the code that uses it are moving from goog.provide to
        goog.module. Take it out once that code has moved. Consumers that will
        not move any time soon should switch to goog.scope with goog.module.get.
    rationale:
        Declaring a global namespace undoes the isolation modules provide
        and is meant only as a transition aid.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```javascript
        \\\
        goog.module('app.charts');

        exports = {draw};
        \\\
        ```
    languages: [javascript]
    tags: [legacy, closure, migration]
    source: https://google.github.io/styleguide/jsguide.html#9445-googmoduledeclarelegacynamespace
