use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptColumnLimit:
    standard: @{GoogleJavaScript}
    ruleId: 4.4
    title: Limit lines to 80 columns
    statement:
        Keep lines to at most 80 characters and wrap any longer line as
        described in the line-wrapping rules.
    rationale:
        Short lines fit side-by-side diffs and narrow windows, and long
        lines are hard to read.
    exceptions:
        Exempt lines include goog.require, goog.requireType and goog.module
        statements, ES import and export-from statements, and lines that
        cannot be wrapped or would become harder to find if wrapped, for
        example long URLs, shell commands meant to be copied, or long string
        literals people search for.
    severity: null
    noncompliant:
        ```javascript
        \\\
        const message = buildMessage(currentUser.displayName, notification.subject, notification.body);
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const message = buildMessage(
            currentUser.displayName, notification.subject, notification.body);
        \\\
        ```
    languages: [javascript]
    tags: [formatting, line-length]
    source: https://google.github.io/styleguide/jsguide.html#44-column-limit-80
