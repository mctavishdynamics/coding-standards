use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptJsdocMarkdown:
    standard: @{GoogleJavaScript}
    ruleId: 7.2
    title: Write JSDoc text in Markdown
    statement:
        Write JSDoc descriptions in Markdown, using HTML only when
        necessary. Format lists and other structure with Markdown syntax
        rather than plain-text layout.
    rationale:
        Documentation extractors ignore plain-text layout, so indented lines
        run together unless written as Markdown.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        /**
         * Retries on these errors:
         *     timeout
         *     connection reset
         */
        \\\
        ```
    compliant:
        ```javascript
        \\\
        /**
         * Retries on these errors:
         *
         *  - timeout
         *  - connection reset
         */
        \\\
        ```
    languages: [javascript]
    tags: [jsdoc, documentation]
    source: https://google.github.io/styleguide/jsguide.html#72-markdown
