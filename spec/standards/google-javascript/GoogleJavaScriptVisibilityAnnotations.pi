use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptVisibilityAnnotations:
    standard: @{GoogleJavaScript}
    ruleId: 7.11
    title: Use visibility annotations only on exported symbols and properties
    statement:
        The @private, @package and @protected tags belong on a fileoverview
        block, on exported symbols, or on properties. Locals do not get them,
        whether they are declared inside a function or at module top level.
    rationale:
        Locals are already invisible outside their scope, so visibility
        annotations on them mean nothing.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        function load() {
          /** @private */
          const retries = 3;
        }
        \\\
        ```
    compliant:
        ```javascript
        \\\
        class Loader {
          constructor() {
            /** @private {number} */
            this.retries_ = 3;
          }
        }
        \\\
        ```
    languages: [javascript]
    tags: [jsdoc, visibility]
    source: https://google.github.io/styleguide/jsguide.html#711-visibility-annotations
