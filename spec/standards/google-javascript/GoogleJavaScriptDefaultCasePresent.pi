use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptDefaultCasePresent:
    standard: @{GoogleJavaScript}
    ruleId: 5.8.3.2
    title: Include a default case last in every switch
    statement:
        Give every switch statement a default group, placed last, even when
        that group contains no code.
    rationale:
        An explicit default shows that unexpected values were considered.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        switch (direction) {
          case 'up':
            moveUp();
            break;
          case 'down':
            moveDown();
            break;
        }
        \\\
        ```
    compliant:
        ```javascript
        \\\
        switch (direction) {
          case 'up':
            moveUp();
            break;
          case 'down':
            moveDown();
            break;
          default:
            throw new Error(`Unknown direction ${direction}`);
        }
        \\\
        ```
    languages: [javascript]
    tags: [control-flow, switch]
    source: https://google.github.io/styleguide/jsguide.html#5832-the-default-case-is-present
