use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptNumberLiterals:
    standard: @{GoogleJavaScript}
    ruleId: 5.7
    title: Use lowercase prefixes for hex, octal and binary literals
    statement:
        Write hex, octal and binary numbers with exactly the 0x, 0o and 0b
        prefixes in lowercase. Never use a leading zero unless it is
        followed by x, o or b.
    rationale:
        A bare leading zero was legacy octal syntax, so 010 reads as ten but
        may mean eight.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const mode = 0755;
        const mask = 0XFF;
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const mode = 0o755;
        const mask = 0xff;
        \\\
        ```
    languages: [javascript]
    tags: [literals, numbers]
    source: https://google.github.io/styleguide/jsguide.html#57-number-literals
