use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptGoogModuleStatement:
    standard: @{GoogleJavaScript}
    ruleId: 3.3
    title: Declare exactly one goog.module on one line
    statement:
        A goog.module file declares exactly one goog.module name, on a
        single line that is never wrapped, even past 80 columns. The name is
        the package path, optionally followed by the main type it defines in
        lowerCamelCase.
    rationale:
        One unwrapped declaration makes the namespace easy to grep for and
        tells tools exactly which namespace the file provides.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        goog.module(
            'payments.processing.cardValidator');
        \\\
        ```
    compliant:
        ```javascript
        \\\
        goog.module('payments.processing.cardValidator');
        \\\
        ```
    languages: [javascript]
    tags: [modules, closure]
    source: https://google.github.io/styleguide/jsguide.html#33-googmodule-statement
