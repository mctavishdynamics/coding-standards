use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptImportsNotWrapped:
    standard: @{GoogleJavaScript}
    ruleId: 3.4.1
    title: Do not wrap import statements
    statement:
        Keep each ES import statement on one line, even when it exceeds the
        80-column limit.
    rationale:
        Unwrapped imports are easy to search for and to sort, and tools can
        process them line by line.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        import {formatCurrency, formatPercent} from
            '../../shared/formatting/numbers.js';
        \\\
        ```
    compliant:
        ```javascript
        \\\
        import {formatCurrency, formatPercent} from '../../shared/formatting/numbers.js';
        \\\
        ```
    languages: [javascript]
    tags: [modules, imports, formatting]
    source: https://google.github.io/styleguide/jsguide.html#341-imports
