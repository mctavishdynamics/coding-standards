use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptObjectLiteralsBlockLike:
    standard: @{GoogleJavaScript}
    ruleId: 4.2.2
    title: Format object literals inline or as blocks
    statement:
        An object literal may be written on one line or formatted like a
        block with an indented property per line, following the same options
        as array literals.
    rationale:
        Allowing both layouts lets short objects stay compact while larger
        ones stay readable.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```javascript
        \\\
        const origin = {x: 0, y: 0};

        const config = {
          retries: 3,
          timeoutMs: 5000,
        };
        \\\
        ```
    languages: [javascript]
    tags: [formatting, objects]
    source: https://google.github.io/styleguide/jsguide.html#422-object-literals-optionally-block-like
