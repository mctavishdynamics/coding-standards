use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptComputedPropertyNames:
    standard: @{GoogleJavaScript}
    ruleId: 5.3.4
    title: Treat computed property names as quoted keys
    statement:
        Computed property names are allowed and count as dict-style keys, so
        do not mix them with unquoted keys, unless the key is a symbol. Enum
        values may be used as computed keys but not mixed with non-enum keys
        in one literal.
    rationale:
        A computed string key cannot be renamed by the compiler, just like a
        quoted key.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const cache = {size: 0, [`item-${id}`]: value};
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const cache = {[`item-${id}`]: value, [`item-${otherId}`]: other};
        const range = {start: 0, [Symbol.iterator]: iterate};
        \\\
        ```
    languages: [javascript]
    tags: [objects, closure]
    source: https://google.github.io/styleguide/jsguide.html#534-computed-property-names
