use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptCamelCaseDefined:
    standard: @{GoogleJavaScript}
    ruleId: 6.3
    title: Convert phrases to camel case with the deterministic scheme
    statement:
        Build a camel case name by first reducing the phrase to plain ASCII
        and removing apostrophes, then splitting it into words and
        lowercasing all of them, acronyms included. Uppercase the initial
        letter of every word, or of every word except the first for
        lowerCamelCase, and concatenate the result.
    rationale:
        A fixed procedure gives one predictable spelling for names
        containing acronyms such as XML, ID or IPv6.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const XMLHTTPRequest = null;
        let newCustomerID;
        function supportsIPv6OnIOS() {}
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const xmlHttpRequest = null;
        let newCustomerId;
        function supportsIpv6OnIos() {}
        \\\
        ```
    languages: [javascript]
    tags: [naming]
    source: https://google.github.io/styleguide/jsguide.html#63-camel-case-defined
