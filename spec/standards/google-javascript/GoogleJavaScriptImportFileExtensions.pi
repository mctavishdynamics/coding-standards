use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptImportFileExtensions:
    standard: @{GoogleJavaScript}
    ruleId: 3.4.1.1.1
    title: Include the .js extension in import paths
    statement:
        Always write the .js file extension in an import path; it is not
        optional.
    rationale:
        Explicit extensions resolve the same way in browsers and tools, with
        no guessing about which file is meant.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        import {Router} from './router';
        \\\
        ```
    compliant:
        ```javascript
        \\\
        import {Router} from './router.js';
        \\\
        ```
    languages: [javascript]
    tags: [modules, imports]
    source: https://google.github.io/styleguide/jsguide.html#34111-file-extensions-in-import-paths
