use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptSourceFileStructure:
    standard: @{GoogleJavaScript}
    ruleId: 3
    title: Order the sections of a source file
    statement:
        Every new file is either a goog.module file or an ES module. Its
        parts appear in this order, each only when present, namely a license
        or copyright notice, the fileoverview JSDoc, the goog.module
        statement or the ES imports, the goog.require and goog.requireType
        lines, and finally the implementation. Put exactly one blank line
        between neighbouring parts, though the implementation may be
        preceded by one or two.
    rationale:
        A fixed layout lets readers find a file's dependencies and entry
        point without hunting through it.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        goog.module('shop.cart');
        /** @fileoverview Shopping cart model. */
        const Item = goog.require('shop.Item');
        \\\
        ```
    compliant:
        ```javascript
        \\\
        /** @fileoverview Shopping cart model. */

        goog.module('shop.cart');

        const Item = goog.require('shop.Item');

        class Cart {}
        \\\
        ```
    languages: [javascript]
    tags: [source-files, modules, formatting]
    source: https://google.github.io/styleguide/jsguide.html#3-source-file-structure
