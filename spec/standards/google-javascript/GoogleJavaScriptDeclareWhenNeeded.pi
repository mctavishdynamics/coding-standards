use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptDeclareWhenNeeded:
    standard: @{GoogleJavaScript}
    ruleId: 5.1.3
    title: Declare variables close to first use and initialize them early
    statement:
        Do not habitually declare locals at the top of a block. Declare each
        one close to where it is first used, to keep its scope small, and
        initialize it as soon as possible.
    rationale:
        A small scope means fewer lines where the variable can be misused,
        and early initialization avoids reading undefined values.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        function summarize(rows) {
          let total;
          let header;
          header = rows[0];
          // ... many lines ...
          total = rows.length;
          return `${header}: ${total}`;
        }
        \\\
        ```
    compliant:
        ```javascript
        \\\
        function summarize(rows) {
          const header = rows[0];
          // ... many lines ...
          const total = rows.length;
          return `${header}: ${total}`;
        }
        \\\
        ```
    languages: [javascript]
    tags: [variables, scope]
    source: https://google.github.io/styleguide/jsguide.html#513-declared-when-needed-initialized-as-soon-as-possible
