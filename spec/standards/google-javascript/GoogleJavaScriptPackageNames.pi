use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptPackageNames:
    standard: @{GoogleJavaScript}
    ruleId: 6.2.1
    title: Write package names in lowerCamelCase
    statement:
        Package names are all lowerCamelCase.
    rationale:
        A single casing scheme for namespaces keeps them predictable to type
        and search.
    exceptions:
        A package name may follow TypeScript's path-based pattern, typically
        all lowercase with underscores matching file names.
    severity: null
    noncompliant:
        ```javascript
        \\\
        goog.module('my.order_history.OrderView');
        \\\
        ```
    compliant:
        ```javascript
        \\\
        goog.module('my.orderHistory.orderView');
        \\\
        ```
    languages: [javascript]
    tags: [naming, modules]
    source: https://google.github.io/styleguide/jsguide.html#621-package-names
