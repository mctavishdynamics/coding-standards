use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptShorthandProperties:
    standard: @{GoogleJavaScript}
    ruleId: 5.3.6
    title: Shorthand properties are allowed
    statement:
        Object literals may use shorthand properties when a property has the
        same name as the variable holding its value.
    rationale:
        Shorthand avoids repeating the same name twice.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const user = {name: name, email: email};
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const user = {name, email};
        \\\
        ```
    languages: [javascript]
    tags: [objects]
    source: https://google.github.io/styleguide/jsguide.html#536-shorthand-properties
