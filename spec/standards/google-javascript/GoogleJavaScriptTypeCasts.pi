use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptTypeCasts:
    standard: @{GoogleJavaScript}
    ruleId: 7.10.2
    title: Write type casts with a type comment and parentheses
    statement:
        When the compiler infers a type poorly and goog.asserts cannot fix
        it, cast by putting a type annotation comment before the expression
        and wrapping the expression in parentheses, which are required.
    rationale:
        Without the parentheses the compiler does not apply the cast.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const input = /** @type {!HTMLInputElement} */ document.getElementById('q');
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const input = /** @type {!HTMLInputElement} */ (document.getElementById('q'));
        \\\
        ```
    languages: [javascript]
    tags: [jsdoc, types]
    source: https://google.github.io/styleguide/jsguide.html#7102-type-casts
