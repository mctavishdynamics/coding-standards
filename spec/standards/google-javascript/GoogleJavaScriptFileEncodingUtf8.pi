use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptFileEncodingUtf8:
    standard: @{GoogleJavaScript}
    ruleId: 2.2
    title: Encode source files in UTF-8
    statement:
        Save every JavaScript source file in the UTF-8 encoding.
    rationale:
        A single known encoding means editors, compilers and review tools
        all read the same characters.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [javascript]
    tags: [source-files, encoding]
    source: https://google.github.io/styleguide/jsguide.html#22-file-encoding-utf-8
