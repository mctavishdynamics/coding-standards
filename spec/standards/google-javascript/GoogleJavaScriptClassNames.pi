use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptClassNames:
    standard: @{GoogleJavaScript}
    ruleId: 6.2.2
    title: Write class and type names in UpperCamelCase
    statement:
        Write class, interface, record and typedef names in UpperCamelCase,
        usually as nouns or noun phrases; interfaces may be adjectives.
        Unexported classes are plain locals and are not marked @private.
    rationale:
        Capitalized names signal a type at a glance and separate types from
        values.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        class shopping_cart {}
        /** @private */
        class helperThing {}
        \\\
        ```
    compliant:
        ```javascript
        \\\
        class ShoppingCart {}
        class CartFormatter {}
        \\\
        ```
    languages: [javascript]
    tags: [naming, classes]
    source: https://google.github.io/styleguide/jsguide.html#622-class-names
