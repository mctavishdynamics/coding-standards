use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptDefinitionOfConstant:
    standard: @{GoogleJavaScript}
    ruleId: 6.2.5.1
    title: Use constant case only for deeply immutable values
    statement:
        Only a module-level const or a @const static property holding a
        deeply immutable value counts as a constant. Verify that nothing
        observable about the value can change before naming it in
        CONSTANT_CASE, since an intention not to mutate it does not qualify.
    rationale:
        Constant case promises readers the value is fixed, so applying it to
        mutable objects misleads them.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const ACTIVE_SESSIONS = new Map();
        const LOGGER = log.getLogger('app');
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const activeSessions = new Map();
        const logger = log.getLogger('app');
        const SECONDS_PER_DAY = 86400;
        \\\
        ```
    languages: [javascript]
    tags: [naming, constants, mutability]
    source: https://google.github.io/styleguide/jsguide.html#6251-definition-of-constant
