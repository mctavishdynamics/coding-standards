use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptNoModifyingBuiltins:
    standard: @{GoogleJavaScript}
    ruleId: 5.11.6
    title: Do not modify built-in objects
    statement:
        Leave built-in constructors and their prototypes alone, and steer
        clear of libraries that modify them. Put symbols on the global
        object only when it is truly unavoidable, such as when a third-party
        API demands it.
    rationale:
        Changes to built-ins and globals affect all code in the page and
        clash with other libraries and future standards.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        Array.prototype.last = function() {
          return this[this.length - 1];
        };
        \\\
        ```
    compliant:
        ```javascript
        \\\
        function last(array) {
          return array[array.length - 1];
        }
        \\\
        ```
    languages: [javascript]
    tags: [disallowed, globals]
    source: https://google.github.io/styleguide/jsguide.html#5116-modifying-builtin-objects
