use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptTemplateParameterNames:
    standard: @{GoogleJavaScript}
    ruleId: 6.2.9
    title: Write template parameter names in all caps
    statement:
        Keep template parameter names short, a single word or letter, and
        write them in all caps, such as T or VALUE.
    rationale:
        All-caps names make type parameters stand out from concrete types.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        /** @template elementType */
        class Box {}
        \\\
        ```
    compliant:
        ```javascript
        \\\
        /** @template VALUE */
        class Box {}
        \\\
        ```
    languages: [javascript]
    tags: [naming, generics]
    source: https://google.github.io/styleguide/jsguide.html#629-template-parameter-names
