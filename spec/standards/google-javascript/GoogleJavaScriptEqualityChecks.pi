use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptEqualityChecks:
    standard: @{GoogleJavaScript}
    ruleId: 5.10
    title: Use strict equality operators
    statement:
        Compare with the identity operators triple-equals and not-double-
        equals, except in the documented cases where coercion is wanted.
    rationale:
        Loose equality applies coercion rules that make unrelated values
        compare equal.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        if (count == '0') {}
        \\\
        ```
    compliant:
        ```javascript
        \\\
        if (count === 0) {}
        \\\
        ```
    languages: [javascript]
    tags: [expressions, equality]
    source: https://google.github.io/styleguide/jsguide.html#510-equality-checks
