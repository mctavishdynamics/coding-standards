use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptObjectDestructuring:
    standard: @{GoogleJavaScript}
    ruleId: 5.3.7
    title: Keep destructured parameters to one level of shorthand
    statement:
        A destructured object parameter may contain only one level of
        unquoted shorthand properties, without nested patterns or computed
        property names. Place default values on the left side, and give an
        optional destructured object an empty object as its default. Never
        wrap a destructuring goog.require statement.
    rationale:
        Simple patterns stay readable and typeable, and left-hand defaults
        apply to each missing field individually.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        function connect({options: {host, port}}) {}
        function retry({count} = {count: 3}) {}
        \\\
        ```
    compliant:
        ```javascript
        \\\
        /** @param {{host: string, port: (number|undefined)}} options */
        function connect({host, port = 443}) {}
        function retry({count = 3} = {}) {}
        \\\
        ```
    languages: [javascript]
    tags: [destructuring, objects, functions]
    source: https://google.github.io/styleguide/jsguide.html#537-destructuring
