use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptWhitespaceCharacters:
    standard: @{GoogleJavaScript}
    ruleId: 2.3.1
    title: Use only the ASCII space as whitespace
    statement:
        Apart from line terminators, the ASCII space (0x20) is the only
        whitespace character in a source file. Escape every other whitespace
        character inside string literals, and never indent with tabs.
    rationale:
        Tabs and invisible Unicode spaces display differently from tool to
        tool and can hide inside literals where no reviewer will notice
        them.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        function total(items) {
        <TAB>return items.length;  // <TAB> marks a tab character
        }
        \\\
        ```
    compliant:
        ```javascript
        \\\
        function total(items) {
          return items.length;
        }
        const separator = '\u00a0';
        \\\
        ```
    languages: [javascript]
    tags: [formatting, whitespace, source-files]
    source: https://google.github.io/styleguide/jsguide.html#231-whitespace-characters
