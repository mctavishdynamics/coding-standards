use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptNoNonStandardFeatures:
    standard: @{GoogleJavaScript}
    ruleId: 5.11.4
    title: Use only standard language features
    statement:
        Stick to what the current ECMAScript and WHATWG specifications define.
        Features that were dropped from the language, proposals not yet
        finished, vendor extensions and syntax that only a transpiler
        understands are all off limits.
    rationale:
        Non-standard features break across environments and tools and may
        change or disappear.
    exceptions:
        Projects targeting a specific platform, such as Node.js or Chrome
        extensions, may use that platform's APIs.
    severity: null
    noncompliant:
        ```javascript
        \\\
        const cache = new WeakMap();
        cache.clear();
        \\\
        ```
    compliant:
        ```javascript
        \\\
        let cache = new WeakMap();
        cache = new WeakMap();
        \\\
        ```
    languages: [javascript]
    tags: [disallowed, portability]
    source: https://google.github.io/styleguide/jsguide.html#5114-non-standard-features
