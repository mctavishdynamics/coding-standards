use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptBracesForControlStructures:
    standard: @{GoogleJavaScript}
    ruleId: 4.1.1
    title: Use braces for all control structures
    statement:
        Control structures such as if, else, for, do and while always take a
        braced body, including when that body is one statement. Inside a block
        that has content, put its opening statement on a fresh line.
    rationale:
        Braces prevent bugs where a statement added later silently falls
        outside the intended body.
    exceptions:
        A simple if with no else that fits entirely on one line may omit
        braces when that reads better.
    severity: null
    noncompliant:
        ```javascript
        \\\
        if (queue.isEmpty())
          return null;

        for (const job of jobs) run(job);
        \\\
        ```
    compliant:
        ```javascript
        \\\
        if (queue.isEmpty()) {
          return null;
        }

        for (const job of jobs) {
          run(job);
        }

        if (!job) return;
        \\\
        ```
    languages: [javascript]
    tags: [formatting, braces, control-flow]
    source: https://google.github.io/styleguide/jsguide.html#411-braces-are-used-for-all-control-structures
