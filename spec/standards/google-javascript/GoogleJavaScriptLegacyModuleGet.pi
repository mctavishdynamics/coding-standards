use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptLegacyModuleGet:
    standard: @{GoogleJavaScript}
    ruleId: 9.4.4.4
    title: Use goog.module.get to reach module exports from provide files
    statement:
        If a file that uses goog.provide needs a goog.module, add a
        goog.require of that module for the build dependency, and read its
        exports through goog.module.get instead of a global name.
    rationale:
        A module's exports are not on the global object, and goog.module.get
        alone does not create the build dependency.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        goog.provide('app.legacyView');
        app.legacyView.render = function() {
          return app.charts.draw();
        };
        \\\
        ```
    compliant:
        ```javascript
        \\\
        goog.provide('app.legacyView');

        goog.require('app.charts');

        app.legacyView.render = function() {
          return goog.module.get('app.charts').draw();
        };
        \\\
        ```
    languages: [javascript]
    tags: [legacy, closure, dependencies]
    source: https://google.github.io/styleguide/jsguide.html#9444-googmodulegetname
