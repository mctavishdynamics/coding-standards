use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptSingleQuotes:
    standard: @{GoogleJavaScript}
    ruleId: 5.6.1
    title: Use single quotes for string literals
    statement:
        Delimit ordinary string literals with single quotes, not double
        quotes, and do not let them span multiple lines. Consider a template
        literal when the string contains a single quote.
    rationale:
        One quote style keeps code consistent and avoids escape noise.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const greeting = "Hello";
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const greeting = 'Hello';
        const note = `It's ready`;
        \\\
        ```
    languages: [javascript]
    tags: [strings, literals]
    source: https://google.github.io/styleguide/jsguide.html#561-use-single-quotes
