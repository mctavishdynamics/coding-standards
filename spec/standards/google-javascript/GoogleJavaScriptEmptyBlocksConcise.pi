use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptEmptyBlocksConcise:
    standard: @{GoogleJavaScript}
    ruleId: 4.1.3
    title: Close empty blocks immediately unless part of a multi-block statement
    statement:
        An empty block may be written as an opening brace followed directly
        by a closing brace. This shortcut is not allowed in a statement with
        several blocks, such as if/else or try/catch/finally.
    rationale:
        A concise empty body is clear on its own, but in multi-block
        statements it hides a branch and breaks the visual pattern.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        try {
          connect();
        } catch (e) {}
        \\\
        ```
    compliant:
        ```javascript
        \\\
        function noop() {}

        try {
          connect();
        } catch (e) {
          // Offline mode is acceptable here.
        }
        \\\
        ```
    languages: [javascript]
    tags: [formatting, braces]
    source: https://google.github.io/styleguide/jsguide.html#413-empty-blocks-may-be-concise
