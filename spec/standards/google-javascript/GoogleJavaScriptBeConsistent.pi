use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptBeConsistent:
    standard: @{GoogleJavaScript}
    ruleId: 8.1
    title: Follow surrounding code where the guide is silent
    statement:
        For any style question the guide does not settle, do what the rest
        of the same file does, and failing that, follow other files in the
        same package.
    rationale:
        Local consistency keeps code readable even where no rule applies.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [javascript]
    tags: [consistency, process]
    source: https://google.github.io/styleguide/jsguide.html#81-issues-unspecified-by-google-style-be-consistent
