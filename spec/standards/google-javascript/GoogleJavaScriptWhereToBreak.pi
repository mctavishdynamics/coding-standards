use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptWhereToBreak:
    standard: @{GoogleJavaScript}
    ruleId: 4.5.1
    title: Break lines at the highest syntactic level
    statement:
        When a line must wrap, favor breaking at the highest syntactic level
        available. Break after operators but before a dot, keep a method
        name joined to its opening parenthesis and a comma joined to the
        preceding token, never split return from its value, and break JSDoc
        type annotations right after the opening brace.
    rationale:
        Breaking at high levels keeps related parts of an expression
        together, and the return rule avoids a break that changes the
        program's meaning.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const average = sum(scores.map((s) => s.value) +
            bonus) / count;
        const label = firstName
            + ' ' + lastName;
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const average =
            sum(scores.map((s) => s.value) + bonus) /
                count;
        const label = firstName +
            ' ' + lastName;
        \\\
        ```
    languages: [javascript]
    tags: [formatting, line-wrapping]
    source: https://google.github.io/styleguide/jsguide.html#451-where-to-break
