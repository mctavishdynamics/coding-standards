use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptConstantNames:
    standard: @{GoogleJavaScript}
    ruleId: 6.2.5
    title: Write constant names in CONSTANT_CASE
    statement:
        Name constants in uppercase with words separated by underscores, and
        never give a constant a trailing underscore.
    rationale:
        CONSTANT_CASE marks values that never change, and module locals are
        already private, so the underscore adds nothing.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const maxUploadSize = 1024;
        const DEFAULT_TIMEOUT_ = 30;
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const MAX_UPLOAD_SIZE = 1024;
        const DEFAULT_TIMEOUT = 30;
        \\\
        ```
    languages: [javascript]
    tags: [naming, constants]
    source: https://google.github.io/styleguide/jsguide.html#625-constant-names
