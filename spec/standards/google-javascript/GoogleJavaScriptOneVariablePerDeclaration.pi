use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptOneVariablePerDeclaration:
    standard: @{GoogleJavaScript}
    ruleId: 5.1.2
    title: Declare one variable per declaration
    statement:
        Each local variable declaration declares exactly one variable.
    rationale:
        Separate declarations are easier to read, annotate, reorder and
        change one at a time.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        let width = 0, height = 0;
        \\\
        ```
    compliant:
        ```javascript
        \\\
        let width = 0;
        let height = 0;
        \\\
        ```
    languages: [javascript]
    tags: [variables, declarations]
    source: https://google.github.io/styleguide/jsguide.html#512-one-variable-per-declaration
