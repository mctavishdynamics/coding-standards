use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptStandardWarningSet:
    standard: @{GoogleJavaScript}
    ruleId: 8.2.1
    title: Use the verbose compiler warning level
    statement:
        Wherever possible, build projects with the Closure Compiler warning
        level set to VERBOSE.
    rationale:
        A standard, strict warning set catches more problems and keeps
        projects comparable.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [javascript]
    tags: [tooling, compiler-warnings]
    source: https://google.github.io/styleguide/jsguide.html#821-use-a-standard-warning-set
