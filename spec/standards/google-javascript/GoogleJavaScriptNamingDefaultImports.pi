use ../lib/CodingRule

from ./GoogleJavaScript import GoogleJavaScript

export coding-rule GoogleJavaScriptNamingDefaultImports:
    standard: @{GoogleJavaScript}
    ruleId: 3.4.1.3.2
    title: Name default imports after the imported file
    statement:
        Derive a default import's name from the imported file's name and
        follow the naming rules for its kind of identifier. Use default
        imports only for modules that do not follow this guide.
    rationale:
        Default imports let each importer invent a name, so tying the name
        to the file keeps it consistent across the codebase.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        import Thing from '../vendor/event-emitter.js';
        \\\
        ```
    compliant:
        ```javascript
        \\\
        import EventEmitter from '../vendor/event-emitter.js';
        \\\
        ```
    languages: [javascript]
    tags: [modules, imports, naming]
    source: https://google.github.io/styleguide/jsguide.html#34132-naming-default-imports
