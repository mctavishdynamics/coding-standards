export coding-standard GoogleJavaScript:
    title: Google JavaScript Style Guide
    publisher: Google
    url: https://google.github.io/styleguide/jsguide.html
    version: null
    license: CC BY 3.0 (code samples Apache 2.0), per the google/styleguide repository
    description:
        Google's complete definition of its coding standards for JavaScript
        source code, covering file structure, formatting, language features,
        naming, JSDoc and policies, with an appendix for legacy platforms.
