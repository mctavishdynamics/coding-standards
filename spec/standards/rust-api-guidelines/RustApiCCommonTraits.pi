use ../lib/CodingRule

from ./RustApiGuidelines import RustApiGuidelines

export coding-rule RustApiCCommonTraits:
    standard: @{RustApiGuidelines}
    ruleId: C-COMMON-TRAITS
    title: Implement the common standard traits eagerly
    statement:
        Implement every applicable trait among Copy, Clone, Eq, PartialEq,
        Ord, PartialOrd, Hash, Debug, Display and Default for each new
        public type. A type with a natural no-argument constructor should
        offer both new and Default.
    rationale:
        The orphan rule stops downstream crates from adding these impls to
        your types, so a missing impl can only be fixed by you.
    exceptions: null
    severity: null
    noncompliant:
        ```rust
        \\\
        pub struct Version {
            pub major: u32,
            pub minor: u32,
        }
        \\\
        ```
    compliant:
        ```rust
        \\\
        #[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord, Hash)]
        pub struct Version {
            pub major: u32,
            pub minor: u32,
        }
        \\\
        ```
    languages: [rust]
    tags: [traits, interoperability]
    source: https://rust-lang.github.io/api-guidelines/interoperability.html#c-common-traits
