use ../lib/CodingRule

from ./RustApiGuidelines import RustApiGuidelines

export coding-rule RustApiCPermissive:
    standard: @{RustApiGuidelines}
    ruleId: C-PERMISSIVE
    title: License the crate and its dependencies permissively
    statement:
        To fit the wider Rust ecosystem, license the crate under both MIT and
        Apache-2.0 (MIT OR Apache-2.0), or under one permissive license like
        MIT or BSD, and use only dependencies with permissive licenses. Do not
        license under Apache-2.0 by itself.
    rationale:
        Dependency licences constrain how the crate can be distributed, and
        Apache-only code cannot be used everywhere the Rust stack can.
    exceptions: null
    severity: null
    noncompliant:
        ```toml
        \\\
        [package]
        name = "geo-index"
        version = "1.2.0"
        license = "Apache-2.0"
        \\\
        ```
    compliant:
        ```toml
        \\\
        [package]
        name = "geo-index"
        version = "1.2.0"
        license = "MIT OR Apache-2.0"
        \\\
        ```
    languages: [rust]
    tags: [licensing, dependencies]
    source: https://rust-lang.github.io/api-guidelines/necessities.html#c-permissive
