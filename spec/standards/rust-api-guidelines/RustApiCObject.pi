use ../lib/CodingRule

from ./RustApiGuidelines import RustApiGuidelines

export coding-rule RustApiCObject:
    standard: @{RustApiGuidelines}
    ruleId: C-OBJECT
    title: Make traits object-safe if they may be used as trait objects
    statement:
        Settle at design time whether callers will use the trait as a dyn
        object, a generic constraint, or both. To keep the object option open,
        avoid generic methods, or mark any generic method with a where Self is
        Sized bound so it is left off the object.
    rationale:
        A trait that is not object-safe can never be used for dynamic
        dispatch or in heterogeneous collections.
    exceptions: null
    severity: null
    noncompliant:
        ```rust
        \\\
        pub trait Sink {
            fn write_all(&mut self, data: &[u8]);
            fn write_item<T: Serialize>(&mut self, item: &T);
        }
        \\\
        ```
    compliant:
        ```rust
        \\\
        pub trait Sink {
            fn write_all(&mut self, data: &[u8]);
            fn write_item<T: Serialize>(&mut self, item: &T)
            where
                Self: Sized;
        }
        \\\
        ```
    languages: [rust]
    tags: [traits, generics]
    source: https://rust-lang.github.io/api-guidelines/flexibility.html#c-object
