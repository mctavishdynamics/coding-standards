export coding-standard RustApiGuidelines:
    title: Rust API Guidelines
    publisher: The Rust Library Team
    url: https://rust-lang.github.io/api-guidelines/
    version: null
    license: MIT OR Apache-2.0
    description:
        Recommendations from the Rust library team on designing and
        presenting Rust library APIs, organised as a checklist of named
        guidelines covering naming, interoperability, documentation and
        future compatibility.
    rules:
        - @{RustApiCCase}
        - @{RustApiCConv}
        - @{RustApiCGetter}
        - @{RustApiCIter}
        - @{RustApiCIterTy}
        - @{RustApiCFeature}
        - @{RustApiCWordOrder}
        - @{RustApiCCommonTraits}
        - @{RustApiCConvTraits}
        - @{RustApiCCollect}
        - @{RustApiCSerde}
        - @{RustApiCSendSync}
        - @{RustApiCGoodErr}
        - @{RustApiCNumFmt}
        - @{RustApiCRwValue}
        - @{RustApiCEvocative}
        - @{RustApiCMacroAttr}
        - @{RustApiCAnywhere}
        - @{RustApiCMacroVis}
        - @{RustApiCMacroTy}
        - @{RustApiCCrateDoc}
        - @{RustApiCExample}
        - @{RustApiCQuestionMark}
        - @{RustApiCFailure}
        - @{RustApiCLink}
        - @{RustApiCMetadata}
        - @{RustApiCRelnotes}
        - @{RustApiCHidden}
        - @{RustApiCSmartPtr}
        - @{RustApiCConvSpecific}
        - @{RustApiCMethod}
        - @{RustApiCNoOut}
        - @{RustApiCOverload}
        - @{RustApiCDeref}
        - @{RustApiCCtor}
        - @{RustApiCIntermediate}
        - @{RustApiCCallerControl}
        - @{RustApiCGeneric}
        - @{RustApiCObject}
        - @{RustApiCNewtype}
        - @{RustApiCCustomType}
        - @{RustApiCBitflag}
        - @{RustApiCBuilder}
        - @{RustApiCValidate}
        - @{RustApiCDtorFail}
        - @{RustApiCDtorBlock}
        - @{RustApiCDebug}
        - @{RustApiCDebugNonempty}
        - @{RustApiCSealed}
        - @{RustApiCStructPrivate}
        - @{RustApiCNewtypeHide}
        - @{RustApiCStructBounds}
        - @{RustApiCStable}
        - @{RustApiCPermissive}
