use ../lib/CodingRule

from ./CppCodingStandards import CppCodingStandards

export coding-rule CppCsRule68:
    standard: @{CppCodingStandards}
    ruleId: rule-68
    title: Use assertions generously to state internal assumptions
    statement:
        Assert conditions that must hold if the code is correct, such as
        preconditions on internal functions and invariants. Never put side
        effects in an assertion, and do not use asserts for runtime errors.
    rationale:
        Assertions document intent and catch logic errors close to their
        cause during testing.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        assert(file.open("data.bin"));   // vanishes in release builds
        \\\
        ```
    compliant:
        ```cpp
        \\\
        const bool opened = file.open("data.bin");
        if (!opened) throw IoError("data.bin");
        assert(index < size_ && "caller checked bounds");
        \\\
        ```
    languages: [cpp]
    tags: [error-handling-and-exceptions, assertions, error-handling]
    source: https://www.informit.com/store/c-plus-plus-coding-standards-101-rules-guidelines-and-9780321113580
