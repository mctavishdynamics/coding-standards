use ../lib/CodingRule

from ./CppCodingStandards import CppCodingStandards

export coding-rule CppCsRule3:
    standard: @{CppCodingStandards}
    ruleId: rule-3
    title: Keep all code under version control
    statement:
        Store sources in a version control system, check in often in small
        coherent changes, and never break the shared build.
    rationale:
        Version control records history, allows teams to work in parallel
        and makes it possible to undo mistakes.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [organizational-and-policy-issues, process, version-control]
    source: https://www.informit.com/store/c-plus-plus-coding-standards-101-rules-guidelines-and-9780321113580
