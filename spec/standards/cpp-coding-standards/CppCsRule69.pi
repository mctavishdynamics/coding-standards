use ../lib/CodingRule

from ./CppCodingStandards import CppCodingStandards

export coding-rule CppCsRule69:
    standard: @{CppCodingStandards}
    ruleId: rule-69
    title: Set a clear error handling policy and apply it everywhere
    statement:
        Decide early how errors are identified, reported, propagated and
        handled across the project, and follow that policy consistently.
    rationale:
        An inconsistent mixture of codes, exceptions and logging leaves
        errors ignored or handled twice.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [error-handling-and-exceptions, error-handling, process]
    source: https://www.informit.com/store/c-plus-plus-coding-standards-101-rules-guidelines-and-9780321113580
