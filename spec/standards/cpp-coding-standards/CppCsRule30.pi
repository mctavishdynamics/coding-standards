use ../lib/CodingRule

from ./CppCodingStandards import CppCodingStandards

export coding-rule CppCsRule30:
    standard: @{CppCodingStandards}
    ruleId: rule-30
    title: Leave logical and comma operators with their built-in meaning
    statement:
        Never overload the logical and, logical or, or comma operators.
    rationale:
        Overloaded versions lose short-circuit evaluation and guaranteed
        ordering, so code that looks familiar behaves differently.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Expr operator&&(const Expr& a, const Expr& b);
        if (ptr && ptr->ok()) {}   // looks safe, may not be for Expr
        \\\
        ```
    compliant:
        ```cpp
        \\\
        Expr allOf(const Expr& a, const Expr& b);
        \\\
        ```
    languages: [cpp]
    tags: [functions-and-operators, operators]
    source: https://www.informit.com/store/c-plus-plus-coding-standards-101-rules-guidelines-and-9780321113580
