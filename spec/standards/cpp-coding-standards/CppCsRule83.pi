use ../lib/CodingRule

from ./CppCodingStandards import CppCodingStandards

export coding-rule CppCsRule83:
    standard: @{CppCodingStandards}
    ruleId: rule-83
    title: Develop with a checked standard library build
    statement:
        Use a debug or checked mode of the standard library during
        development and testing.
    rationale:
        It detects invalid iterators, out-of-range access and similar misuse
        that otherwise cause silent undefined behaviour.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [stl-algorithms, debugging, standard-library]
    source: https://www.informit.com/store/c-plus-plus-coding-standards-101-rules-guidelines-and-9780321113580
