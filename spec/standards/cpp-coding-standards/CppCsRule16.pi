use ../lib/CodingRule

from ./CppCodingStandards import CppCodingStandards

export coding-rule CppCsRule16:
    standard: @{CppCodingStandards}
    ruleId: rule-16
    title: Replace macros with language features
    statement:
        Use constants, inline functions, templates, enums and namespaces
        instead of macros. Keep macros for include guards and conditional
        compilation.
    rationale:
        Macros ignore scope and type rules and are invisible to debuggers
        and many tools.
    exceptions:
        Include guards, conditional compilation for portability, and assert
        are legitimate macro uses.
    severity: null
    noncompliant:
        ```cpp
        \\\
        #define MIN(a, b) ((a) < (b) ? (a) : (b))
        \\\
        ```
    compliant:
        ```cpp
        \\\
        using std::min;
        \\\
        ```
    languages: [cpp]
    tags: [coding-style, macros]
    source: https://www.informit.com/store/c-plus-plus-coding-standards-101-rules-guidelines-and-9780321113580
