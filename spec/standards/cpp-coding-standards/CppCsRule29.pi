use ../lib/CodingRule

from ./CppCodingStandards import CppCodingStandards

export coding-rule CppCsRule29:
    standard: @{CppCodingStandards}
    ruleId: rule-29
    title: Add overloads to avoid costly implicit conversions
    statement:
        When calls frequently pass a type that would be converted to the
        parameter type, add an overload taking that type directly.
    rationale:
        Implicit conversions can create temporaries on every call.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        bool equals(const std::string& a, const std::string& b);
        equals(name, "admin");   // builds a temporary string
        \\\
        ```
    compliant:
        ```cpp
        \\\
        bool equals(const std::string& a, const std::string& b);
        bool equals(const std::string& a, const char* b);
        \\\
        ```
    languages: [cpp]
    tags: [functions-and-operators, overloading, performance]
    source: https://www.informit.com/store/c-plus-plus-coding-standards-101-rules-guidelines-and-9780321113580
