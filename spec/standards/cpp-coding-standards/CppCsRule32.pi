use ../lib/CodingRule

from ./CppCodingStandards import CppCodingStandards

export coding-rule CppCsRule32:
    standard: @{CppCodingStandards}
    ruleId: rule-32
    title: Settle which category of class you are designing
    statement:
        Know whether a class is a value type, a polymorphic base, an
        exception, a traits or policy class, or another category, and follow
        the conventions of that kind.
    rationale:
        Each kind needs different copy, destructor and interface choices;
        mixing them produces classes that are awkward or unsafe.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [class-design-and-inheritance, design, classes]
    source: https://www.informit.com/store/c-plus-plus-coding-standards-101-rules-guidelines-and-9780321113580
