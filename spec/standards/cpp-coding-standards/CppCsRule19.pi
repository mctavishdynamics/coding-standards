use ../lib/CodingRule

from ./CppCodingStandards import CppCodingStandards

export coding-rule CppCsRule19:
    standard: @{CppCodingStandards}
    ruleId: rule-19
    title: Give each variable a value at its definition
    statement:
        Give every variable a value when you define it, using a helper
        function or lambda if computing it needs several steps.
    rationale:
        Reading an uninitialised variable is undefined behaviour and a
        common source of nondeterministic bugs.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int port;
        if (useTls) port = 443;
        connect(port);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        const int port = useTls ? 443 : 80;
        connect(port);
        \\\
        ```
    languages: [cpp]
    tags: [coding-style, initialization]
    source: https://www.informit.com/store/c-plus-plus-coding-standards-101-rules-guidelines-and-9780321113580
