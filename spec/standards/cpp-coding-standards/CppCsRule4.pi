use ../lib/CodingRule

from ./CppCodingStandards import CppCodingStandards

export coding-rule CppCsRule4:
    standard: @{CppCodingStandards}
    ruleId: rule-4
    title: Review code regularly
    statement:
        Have colleagues read code before or soon after it is committed, as a
        normal part of development.
    rationale:
        Reviews find defects early, spread knowledge and keep the code base
        consistent.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [organizational-and-policy-issues, process, code-review]
    source: https://www.informit.com/store/c-plus-plus-coding-standards-101-rules-guidelines-and-9780321113580
