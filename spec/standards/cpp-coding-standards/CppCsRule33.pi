use ../lib/CodingRule

from ./CppCodingStandards import CppCodingStandards

export coding-rule CppCsRule33:
    standard: @{CppCodingStandards}
    ruleId: rule-33
    title: Prefer small focused classes to large all-purpose ones
    statement:
        Split a class that does many things into smaller classes, each with
        a clear role.
    rationale:
        Small classes are easier to understand, test and reuse, and are less
        likely to be misused.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Application {   // window, network, parsing, persistence...
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Window {};
        class HttpClient {};
        class Store {};
        \\\
        ```
    languages: [cpp]
    tags: [class-design-and-inheritance, classes, cohesion]
    source: https://www.informit.com/store/c-plus-plus-coding-standards-101-rules-guidelines-and-9780321113580
