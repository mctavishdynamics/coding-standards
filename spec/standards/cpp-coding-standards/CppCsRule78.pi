use ../lib/CodingRule

from ./CppCodingStandards import CppCodingStandards

export coding-rule CppCsRule78:
    standard: @{CppCodingStandards}
    ruleId: rule-78
    title: Pass vector data or string c_str to C APIs
    statement:
        Use a vector's contiguous storage, or a string's c_str, when a
        C-style API needs a buffer or a string.
    rationale:
        These types are guaranteed compatible with C arrays, so no manual
        allocation is needed.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        char* buf = new char[n];
        readBytes(fd, buf, n);
        delete[] buf;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::vector<char> buf(n);
        readBytes(fd, buf.data(), buf.size());
        \\\
        ```
    languages: [cpp]
    tags: [stl-containers, containers, interop]
    source: https://www.informit.com/store/c-plus-plus-coding-standards-101-rules-guidelines-and-9780321113580
