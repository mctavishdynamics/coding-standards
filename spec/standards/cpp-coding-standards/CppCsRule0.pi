use ../lib/CodingRule

from ./CppCodingStandards import CppCodingStandards

export coding-rule CppCsRule0:
    standard: @{CppCodingStandards}
    ruleId: rule-0
    title: Leave matters of personal taste out of the coding standard
    statement:
        Standardise only what affects correctness, safety or
        maintainability. Leave brace placement, indentation width, naming
        case and similar taste issues to each team, asking only for
        consistency within a file.
    rationale:
        Arguing over style wastes time and makes people ignore the rules
        that matter.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [organizational-and-policy-issues, process, formatting]
    source: https://www.informit.com/store/c-plus-plus-coding-standards-101-rules-guidelines-and-9780321113580
