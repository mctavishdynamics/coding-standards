use ../lib/CodingRule

from ./CppCodingStandards import CppCodingStandards

export coding-rule CppCsRule67:
    standard: @{CppCodingStandards}
    ruleId: rule-67
    title: Do not make generic code depend on more than it needs
    statement:
        Write templates against the minimal operations they need: prefer !=
        to < for iterators, ++it to it++, and avoid assumptions about the
        concrete type.
    rationale:
        Every extra requirement narrows the set of types the template works
        with.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template <class It>
        int count(It b, It e) { int n = 0; for (; b < e; b++) ++n; return n; }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template <class It>
        int count(It b, It e) { int n = 0; for (; b != e; ++b) ++n; return n; }
        \\\
        ```
    languages: [cpp]
    tags: [templates-and-genericity, templates, genericity]
    source: https://www.informit.com/store/c-plus-plus-coding-standards-101-rules-guidelines-and-9780321113580
