use ../lib/CodingRule

from ./CppCodingStandards import CppCodingStandards

export coding-rule CppCsRule72:
    standard: @{CppCodingStandards}
    ruleId: rule-72
    title: Report errors with exceptions by default
    statement:
        Use exceptions rather than error codes to signal errors, unless
        there is a specific reason such as a boundary that cannot carry
        them.
    rationale:
        Exceptions cannot be silently ignored, separate error paths from
        normal logic and work for constructors and operators.
    exceptions:
        Error codes are appropriate where exceptions are unavailable, across
        module boundaries, or for failures that are part of normal flow.
    severity: null
    noncompliant:
        ```cpp
        \\\
        int parse(const std::string& s, Config* out);   // result often unchecked
        \\\
        ```
    compliant:
        ```cpp
        \\\
        Config parse(const std::string& s);   // throws ParseError
        \\\
        ```
    languages: [cpp]
    tags: [error-handling-and-exceptions, exceptions, error-handling]
    source: https://www.informit.com/store/c-plus-plus-coding-standards-101-rules-guidelines-and-9780321113580
