use ../lib/CodingRule

from ./CppCodingStandards import CppCodingStandards

export coding-rule CppCsRule64:
    standard: @{CppCodingStandards}
    ruleId: rule-64
    title: Choose templates or virtual functions by where the type is known
    statement:
        Use templates where types are known at compile time and performance
        or type safety matter, and virtual functions where the type varies
        at runtime; combine them when each covers what the other cannot.
    rationale:
        Each form has different costs and strengths, and they complement
        each other.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // virtual dispatch per pixel in a tight loop
        for (auto& px : image) filter->apply(px);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template <class Filter>
        void applyAll(Image& image, Filter f) { for (auto& px : image) f(px); }
        \\\
        ```
    languages: [cpp]
    tags: [templates-and-genericity, polymorphism, templates]
    source: https://www.informit.com/store/c-plus-plus-coding-standards-101-rules-guidelines-and-9780321113580
