use ../lib/CodingRule

from ./CppCodingStandards import CppCodingStandards

export coding-rule CppCsRule90:
    standard: @{CppCodingStandards}
    ruleId: rule-90
    title: Use virtual functions instead of switching on type codes
    statement:
        Replace code that branches on a type field with polymorphism, so
        each type supplies its own behaviour.
    rationale:
        Type switches must be updated everywhere when a type is added and
        are easy to get wrong.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        switch (shape.kind) {
        case Kind::circle: drawCircle(shape); break;
        case Kind::square: drawSquare(shape); break;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        shape.draw();   // virtual
        \\\
        ```
    languages: [cpp]
    tags: [type-safety, polymorphism, design]
    source: https://www.informit.com/store/c-plus-plus-coding-standards-101-rules-guidelines-and-9780321113580
