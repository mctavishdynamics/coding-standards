use ../lib/CodingRule

from ./CppCodingStandards import CppCodingStandards

export coding-rule CppCsRule66:
    standard: @{CppCodingStandards}
    ruleId: rule-66
    title: Overload function templates instead of specialising them
    statement:
        Customise a function template by overloading it, or forward to a
        class template you can specialise, rather than writing explicit
        function template specialisations.
    rationale:
        Specialisations do not take part in overload resolution and interact
        with it in surprising ways.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template <class T> void encode(const T& v);
        template <> void encode<Date>(const Date& d);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template <class T> void encode(const T& v);
        void encode(const Date& d);   // plain overload
        \\\
        ```
    languages: [cpp]
    tags: [templates-and-genericity, templates, overloading]
    source: https://www.informit.com/store/c-plus-plus-coding-standards-101-rules-guidelines-and-9780321113580
