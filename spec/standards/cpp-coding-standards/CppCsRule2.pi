use ../lib/CodingRule

from ./CppCodingStandards import CppCodingStandards

export coding-rule CppCsRule2:
    standard: @{CppCodingStandards}
    ruleId: rule-2
    title: Produce the whole build with one command
    statement:
        Use a build system that produces the full product in one step
        without manual intervention.
    rationale:
        Manual steps are forgotten or done differently each time, and a
        one-command build supports frequent integration and testing.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [organizational-and-policy-issues, build, process]
    source: https://www.informit.com/store/c-plus-plus-coding-standards-101-rules-guidelines-and-9780321113580
