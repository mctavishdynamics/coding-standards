use ../lib/CodingRule

from ./EffectiveGo import EffectiveGo

export coding-rule EffectiveGoIndentWithTabs:
    standard: @{EffectiveGo}
    ruleId: formatting-indentation
    title: Indent with tabs
    statement:
        Use tabs for indentation, which is what gofmt emits. Use spaces only
        when you must.
    rationale:
        Tabs are the standard Go indentation, so following gofmt keeps every
        file the same.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [go]
    tags: [formatting, indentation]
    source: https://go.dev/doc/effective_go#formatting
