use ../lib/CodingRule

from ./EffectiveGo import EffectiveGo

export coding-rule EffectiveGoNamedResults:
    standard: @{EffectiveGo}
    ruleId: named-results
    title: Name results when the names document them
    statement:
        Give result parameters names when that makes clear which returned
        value is which. Named results start at their zero values and are
        returned by a bare return.
    rationale:
        Result names serve as documentation, and used well they can make a
        function both shorter and clearer.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        func divmod(a, b int) (int, int)
        \\\
        ```
    compliant:
        ```go
        \\\
        func divmod(a, b int) (quotient, remainder int)
        \\\
        ```
    languages: [go]
    tags: [functions, documentation]
    source: https://go.dev/doc/effective_go#named-results
