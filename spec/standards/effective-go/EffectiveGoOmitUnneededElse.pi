use ../lib/CodingRule

from ./EffectiveGo import EffectiveGo

export coding-rule EffectiveGoOmitUnneededElse:
    standard: @{EffectiveGo}
    ruleId: if-omit-else
    title: Omit else when the if body does not fall through
    statement:
        Drop the else when the if body always exits with return, break,
        continue or goto. Handle each error case in turn and let the main flow
        continue down the left margin.
    rationale:
        Error cases usually return, so the else adds nesting without
        meaning, and a straight success path is easier to follow.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        f, err := os.Open(name)
        if err != nil {
            return err
        } else {
            defer f.Close()
            return parse(f)
        }
        \\\
        ```
    compliant:
        ```go
        \\\
        f, err := os.Open(name)
        if err != nil {
            return err
        }
        defer f.Close()
        return parse(f)
        \\\
        ```
    languages: [go]
    tags: [control-flow, error-handling, readability]
    source: https://go.dev/doc/effective_go#if
