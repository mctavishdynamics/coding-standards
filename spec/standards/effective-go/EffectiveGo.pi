from ./EffectiveGoUsefulZeroValue import EffectiveGoUsefulZeroValue

export coding-standard EffectiveGo:
    title: Effective Go
    publisher: The Go Authors
    url: https://go.dev/doc/effective_go
    version: null
    license:
        Creative Commons Attribution 4.0 for text, BSD license for code
    description:
        The Go project's guide to writing clear, idiomatic Go, covering
        formatting, naming, control structures, data, interfaces,
        concurrency and errors. Written for Go's 2009 release and not
        actively updated since.
    rules:
        - @{EffectiveGoFormatting}
        - @{EffectiveGoIndentWithTabs}
        - @{EffectiveGoLineLength}
        - @{EffectiveGoFewerParentheses}
        - @{EffectiveGoDocComments}
        - @{EffectiveGoLineComments}
        - @{EffectiveGoPackageNames}
        - @{EffectiveGoPackageNameMatchesDirectory}
        - @{EffectiveGoAvoidPackageStutter}
        - @{EffectiveGoAvoidImportDot}
        - @{EffectiveGoGetters}
        - @{EffectiveGoInterfaceNames}
        - @{EffectiveGoCanonicalMethodNames}
        - @{EffectiveGoMixedCaps}
        - @{EffectiveGoSemicolons}
        - @{EffectiveGoOpeningBraceSameLine}
        - @{EffectiveGoMultilineIf}
        - @{EffectiveGoOmitUnneededElse}
        - @{EffectiveGoRedeclaration}
        - @{EffectiveGoForRange}
        - @{EffectiveGoRangeDropUnused}
        - @{EffectiveGoParallelAssignmentInFor}
        - @{EffectiveGoSwitchForIfChains}
        - @{EffectiveGoSwitchCaseLists}
        - @{EffectiveGoLabeledBreak}
        - @{EffectiveGoTypeSwitch}
        - @{EffectiveGoMultipleReturnValues}
        - @{EffectiveGoNamedResults}
        - @{EffectiveGoDeferCleanup}
        - @{EffectiveGoDeferArgumentEvaluation}
        - @{EffectiveGoUsefulZeroValue}
        - @{EffectiveGoCompositeLiterals}
        - @{EffectiveGoLabelledLiteralFields}
        - @{EffectiveGoMakeVersusNew}
        - @{EffectiveGoPreferSlicesToArrays}
        - @{EffectiveGoSliceArguments}
        - @{EffectiveGoReturnGrownSlice}
        - @{EffectiveGoTwoDimensionalSlices}
        - @{EffectiveGoCommaOk}
        - @{EffectiveGoMapAsSet}
        - @{EffectiveGoStringMethod}
        - @{EffectiveGoStringRecursion}
        - @{EffectiveGoForwardVariadicArguments}
        - @{EffectiveGoUseAppendResult}
        - @{EffectiveGoAppendSlice}
        - @{EffectiveGoIotaConstants}
        - @{EffectiveGoInitFunction}
        - @{EffectiveGoPointerVersusValueReceivers}
        - @{EffectiveGoSmallInterfaces}
        - @{EffectiveGoConversions}
        - @{EffectiveGoCheckedTypeAssertion}
        - @{EffectiveGoGenerality}
        - @{EffectiveGoMethodsOnAnyType}
        - @{EffectiveGoBlankInAssignment}
        - @{EffectiveGoNeverDiscardErrors}
        - @{EffectiveGoUnusedDuringDevelopment}
        - @{EffectiveGoImportForSideEffect}
        - @{EffectiveGoInterfaceChecks}
        - @{EffectiveGoEmbedding}
        - @{EffectiveGoInterfaceEmbedding}
        - @{EffectiveGoShareByCommunicating}
        - @{EffectiveGoSignalGoroutineCompletion}
        - @{EffectiveGoBoundConcurrency}
        - @{EffectiveGoReplyChannels}
        - @{EffectiveGoParallelization}
        - @{EffectiveGoLeakyBuffer}
        - @{EffectiveGoDetailedErrors}
        - @{EffectiveGoErrorOrigin}
        - @{EffectiveGoAvoidPanic}
        - @{EffectiveGoRecover}
        - @{EffectiveGoPanicsStayInPackage}
