use ../lib/CodingRule

from ./EffectiveGo import EffectiveGo

export coding-rule EffectiveGoPackageNames:
    standard: @{EffectiveGo}
    ruleId: package-names
    title: Give packages short lower-case one-word names
    statement:
        Name a package with a short, concise, lower-case single word,
        without underscores or mixedCaps. Err toward brevity and do not
        worry in advance about collisions with other packages.
    rationale:
        Every user types the package name to reach its contents. Collisions
        are rare and the importer can rename locally when one occurs.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        package string_utils_helpers
        \\\
        ```
    compliant:
        ```go
        \\\
        package strutil
        \\\
        ```
    languages: [go]
    tags: [naming, packages]
    source: https://go.dev/doc/effective_go#package-names
