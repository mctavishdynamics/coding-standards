use ../lib/CodingRule

from ./Psr1 import Psr1

export coding-rule Psr1VendorPrefixLegacy:
    standard: @{Psr1}
    ruleId: 3d
    title: Prefix class names with the vendor in PHP 5.2 code
    statement:
        Code that must run on PHP 5.2 or older, which has no namespaces,
        should imitate them by prefixing class names with the vendor name
        and an underscore.
    rationale:
        The prefix keeps class names unique across packages and maps onto a
        directory path in the same way a namespace would.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        class Invoice
        {
        }
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        class Acme_Billing_Invoice
        {
        }
        \\\
        ```
    languages: [php]
    tags: [namespaces, legacy]
    source: https://www.php-fig.org/psr/psr-1/#3-namespace-and-class-names
