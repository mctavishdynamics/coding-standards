use ../lib/CodingRule

from ./Psr1 import Psr1

export coding-rule Psr1MethodNamesCamelCase:
    standard: @{Psr1}
    ruleId: 4.3
    title: Name methods in camelCase
    statement:
        Declare method names in camelCase, starting with a lower case letter
        and capitalising each later word.
    rationale:
        A shared casing for methods lets code from different projects read
        the same way and separates methods from class names.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        class Cart
        {
            public function add_item($item)
            {
            }
        }
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        class Cart
        {
            public function addItem($item)
            {
            }
        }
        \\\
        ```
    languages: [php]
    tags: [naming, methods]
    source: https://www.php-fig.org/psr/psr-1/#43-methods
