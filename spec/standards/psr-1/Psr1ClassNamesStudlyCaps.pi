use ../lib/CodingRule

from ./Psr1 import Psr1

export coding-rule Psr1ClassNamesStudlyCaps:
    standard: @{Psr1}
    ruleId: 3b
    title: Name classes in StudlyCaps
    statement:
        Declare class names in StudlyCaps, with the first letter of every
        word, including the first, in upper case.
    rationale:
        One casing style for classes makes them easy to tell apart from
        functions and variables, and keeps names consistent with the files
        that hold them.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        namespace Acme\Billing;

        class invoice_reminder
        {
        }
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        namespace Acme\Billing;

        class InvoiceReminder
        {
        }
        \\\
        ```
    languages: [php]
    tags: [naming, classes]
    source: https://www.php-fig.org/psr/psr-1/#3-namespace-and-class-names
