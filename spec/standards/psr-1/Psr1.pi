use ../lib/CodingStandard

from ./Psr1AutoloadingPsr import Psr1AutoloadingPsr
from ./Psr1ClassNamesStudlyCaps import Psr1ClassNamesStudlyCaps
from ./Psr1ConstantsUpperCase import Psr1ConstantsUpperCase
from ./Psr1FormalNamespaces import Psr1FormalNamespaces
from ./Psr1MethodNamesCamelCase import Psr1MethodNamesCamelCase
from ./Psr1PhpTags import Psr1PhpTags
from ./Psr1PropertyNamingConsistent import Psr1PropertyNamingConsistent
from ./Psr1SymbolsOrSideEffects import Psr1SymbolsOrSideEffects
from ./Psr1Utf8WithoutBom import Psr1Utf8WithoutBom
from ./Psr1VendorPrefixLegacy import Psr1VendorPrefixLegacy

export coding-standard Psr1:
    title: PSR-1 - Basic Coding Standard
    publisher: PHP Framework Interop Group
    url: https://www.php-fig.org/psr/psr-1/
    version: null
    license: Content CC BY 3.0 Unported; code MIT (php-fig/fig-standards LICENSE.md)
    description:
        The PHP-FIG basic coding standard for shared PHP code. It covers PHP
        tags, file encoding, side effects, autoloading and the naming of
        classes, constants and methods.
    rules:
        - @{Psr1PhpTags}
        - @{Psr1Utf8WithoutBom}
        - @{Psr1SymbolsOrSideEffects}
        - @{Psr1AutoloadingPsr}
        - @{Psr1ClassNamesStudlyCaps}
        - @{Psr1FormalNamespaces}
        - @{Psr1VendorPrefixLegacy}
        - @{Psr1ConstantsUpperCase}
        - @{Psr1PropertyNamingConsistent}
        - @{Psr1MethodNamesCamelCase}
