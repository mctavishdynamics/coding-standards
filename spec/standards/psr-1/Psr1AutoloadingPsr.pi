use ../lib/CodingRule

from ./Psr1 import Psr1

export coding-rule Psr1AutoloadingPsr:
    standard: @{Psr1}
    ruleId: 3a
    title: Lay out namespaces and classes for PSR-4 autoloading
    statement:
        Follow an autoloading PSR for namespaces and classes. Put each class
        in a file of its own, inside a namespace that has at least a
        top-level vendor name.
    rationale:
        A predictable mapping from class name to file path lets any
        compliant autoloader find the class without extra configuration.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        // src/helpers.php
        class Invoice
        {
        }

        class InvoiceLine
        {
        }
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        // src/Billing/Invoice.php
        namespace Acme\Billing;

        class Invoice
        {
        }
        \\\
        ```
    languages: [php]
    tags: [namespaces, autoloading]
    source: https://www.php-fig.org/psr/psr-1/#3-namespace-and-class-names
