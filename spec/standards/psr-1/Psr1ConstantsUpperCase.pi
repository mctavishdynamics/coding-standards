use ../lib/CodingRule

from ./Psr1 import Psr1

export coding-rule Psr1ConstantsUpperCase:
    standard: @{Psr1}
    ruleId: 4.1
    title: Write class constants in upper case with underscores
    statement:
        Declare class constants in upper case letters, separating words with
        underscores.
    rationale:
        The distinct casing makes a constant recognisable at a glance
        wherever it is used.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        class Order
        {
            const maxItems = 50;
            const defaultCurrency = 'EUR';
        }
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        class Order
        {
            const MAX_ITEMS = 50;
            const DEFAULT_CURRENCY = 'EUR';
        }
        \\\
        ```
    languages: [php]
    tags: [naming, constants]
    source: https://www.php-fig.org/psr/psr-1/#41-constants
