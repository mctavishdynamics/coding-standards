use ../lib/CodingRule

from ./Psr1 import Psr1

export coding-rule Psr1Utf8WithoutBom:
    standard: @{Psr1}
    ruleId: 2.2
    title: Encode PHP files as UTF-8 without a byte order mark
    statement:
        Save every file of PHP code as UTF-8, and leave out the byte order
        mark.
    rationale:
        A byte order mark is sent as output before the opening tag, which
        breaks headers and sessions, and a single encoding keeps shared code
        readable everywhere.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [php]
    tags: [files, encoding]
    source: https://www.php-fig.org/psr/psr-1/#22-character-encoding
