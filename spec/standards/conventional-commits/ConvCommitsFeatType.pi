use ../lib/CodingRule

from ./ConventionalCommits import ConventionalCommits

export coding-rule ConvCommitsFeatType:
    standard: @{ConventionalCommits}
    ruleId: 2
    title: Use the feat type for a new feature
    statement:
        Mark a commit that adds a new feature to the application or library
        with the type feat.
    rationale:
        The feat type maps to a minor release in Semantic Versioning, so
        tools rely on it to bump the version correctly.
    exceptions: null
    severity: null
    noncompliant:
        ```text
        \\\
        chore: add CSV export to the reports page
        \\\
        ```
    compliant:
        ```text
        \\\
        feat: add CSV export to the reports page
        \\\
        ```
    languages: [any]
    tags: [commit-messages, versioning]
    source: https://www.conventionalcommits.org/en/v1.0.0/#specification
