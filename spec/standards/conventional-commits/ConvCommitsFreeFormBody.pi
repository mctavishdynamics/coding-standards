use ../lib/CodingRule

from ./ConventionalCommits import ConventionalCommits

export coding-rule ConvCommitsFreeFormBody:
    standard: @{ConventionalCommits}
    ruleId: 7
    title: Write the body as free-form paragraphs
    statement:
        The body may hold any number of paragraphs separated by newlines,
        with no further structure required.
    rationale:
        Leaving the body free gives authors room to explain the change in
        whatever form suits it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [commit-messages, format]
    source: https://www.conventionalcommits.org/en/v1.0.0/#specification
