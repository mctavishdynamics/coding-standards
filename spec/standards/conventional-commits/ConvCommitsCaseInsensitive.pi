use ../lib/CodingRule

from ./ConventionalCommits import ConventionalCommits

export coding-rule ConvCommitsCaseInsensitive:
    standard: @{ConventionalCommits}
    ruleId: 15
    title: Treat commit units as case-insensitive except BREAKING CHANGE
    statement:
        Tools that implement the specification must not treat types, scopes
        or footer tokens as case-sensitive. The BREAKING CHANGE token is the
        exception and must be uppercase.
    rationale:
        Case-insensitive parsing tolerates small inconsistencies between
        authors, while the uppercase rule keeps breaking changes
        unmistakable.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [commit-messages, parsing, tooling]
    source: https://www.conventionalcommits.org/en/v1.0.0/#specification
