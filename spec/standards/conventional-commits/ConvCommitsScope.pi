use ../lib/CodingRule

from ./ConventionalCommits import ConventionalCommits

export coding-rule ConvCommitsScope:
    standard: @{ConventionalCommits}
    ruleId: 4
    title: Write an optional scope as a noun in parentheses
    statement:
        When a scope is given, place it right after the type as a noun
        naming a section of the codebase, wrapped in parentheses.
    rationale:
        A consistent scope tells readers and tools which part of the system
        a change touches.
    exceptions: null
    severity: null
    noncompliant:
        ```text
        \\\
        fix [parser]: handle trailing commas
        \\\
        ```
    compliant:
        ```text
        \\\
        fix(parser): handle trailing commas
        \\\
        ```
    languages: [any]
    tags: [commit-messages, format]
    source: https://www.conventionalcommits.org/en/v1.0.0/#specification
