use ../lib/CodingRule

from ./ConventionalCommits import ConventionalCommits

export coding-rule ConvCommitsFixType:
    standard: @{ConventionalCommits}
    ruleId: 3
    title: Use the fix type for a bug fix
    statement:
        Mark a commit that fixes a bug in the application with the type fix.
    rationale:
        The fix type maps to a patch release, and readers scanning the log
        can see at once which commits repair defects.
    exceptions: null
    severity: null
    noncompliant:
        ```text
        \\\
        feat: stop crash when the cart is empty
        \\\
        ```
    compliant:
        ```text
        \\\
        fix: stop crash when the cart is empty
        \\\
        ```
    languages: [any]
    tags: [commit-messages, versioning]
    source: https://www.conventionalcommits.org/en/v1.0.0/#specification
