use ../lib/CodingStandard

from ./ConvCommitsBodyAfterBlankLine import ConvCommitsBodyAfterBlankLine
from ./ConvCommitsBreakingChangeBang import ConvCommitsBreakingChangeBang
from ./ConvCommitsBreakingChangeFooter import ConvCommitsBreakingChangeFooter
from ./ConvCommitsBreakingChangeHyphen import ConvCommitsBreakingChangeHyphen
from ./ConvCommitsCaseInsensitive import ConvCommitsCaseInsensitive
from ./ConvCommitsDescription import ConvCommitsDescription
from ./ConvCommitsFeatType import ConvCommitsFeatType
from ./ConvCommitsFixType import ConvCommitsFixType
from ./ConvCommitsFooterTokenHyphens import ConvCommitsFooterTokenHyphens
from ./ConvCommitsFooterValue import ConvCommitsFooterValue
from ./ConvCommitsFooters import ConvCommitsFooters
from ./ConvCommitsFreeFormBody import ConvCommitsFreeFormBody
from ./ConvCommitsIndicateBreakingChanges import
    ConvCommitsIndicateBreakingChanges
from ./ConvCommitsOtherTypes import ConvCommitsOtherTypes
from ./ConvCommitsScope import ConvCommitsScope
from ./ConvCommitsTypePrefix import ConvCommitsTypePrefix

export coding-standard ConventionalCommits:
    title: Conventional Commits
    publisher: Conventional Commits contributors
    url: https://www.conventionalcommits.org/en/v1.0.0/
    version: 1.0.0
    license: Creative Commons CC BY 3.0
    description:
        A lightweight convention for structuring commit messages with a
        type, optional scope, description, body and footers, so tools can
        generate changelogs and choose semantic version bumps.
    rules:
        - @{ConvCommitsTypePrefix}
        - @{ConvCommitsFeatType}
        - @{ConvCommitsFixType}
        - @{ConvCommitsScope}
        - @{ConvCommitsDescription}
        - @{ConvCommitsBodyAfterBlankLine}
        - @{ConvCommitsFreeFormBody}
        - @{ConvCommitsFooters}
        - @{ConvCommitsFooterTokenHyphens}
        - @{ConvCommitsFooterValue}
        - @{ConvCommitsIndicateBreakingChanges}
        - @{ConvCommitsBreakingChangeFooter}
        - @{ConvCommitsBreakingChangeBang}
        - @{ConvCommitsOtherTypes}
        - @{ConvCommitsCaseInsensitive}
        - @{ConvCommitsBreakingChangeHyphen}
