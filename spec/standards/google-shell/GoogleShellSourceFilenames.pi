use ../lib/CodingRule

from ./GoogleShell import GoogleShell

export coding-rule GoogleShellSourceFilenames:
    standard: @{GoogleShell}
    ruleId: source-filenames
    title: Name source files in lower case
    statement:
        File names are lowercase. Underscores may join words, but hyphens
        may not.
    rationale:
        This is consistent with other code styles at Google.
    exceptions: null
    severity: null
    noncompliant:
        ```bash
        \\\
        source ./lib/Rotate-Logs.sh
        \\\
        ```
    compliant:
        ```bash
        \\\
        source ./lib/rotate_logs.sh
        \\\
        ```
    languages: [shell]
    tags: [naming, files]
    source: https://google.github.io/styleguide/shellguide.html#source-filenames
