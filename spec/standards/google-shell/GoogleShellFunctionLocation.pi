use ../lib/CodingRule

from ./GoogleShell import GoogleShell

export coding-rule GoogleShellFunctionLocation:
    standard: @{GoogleShell}
    ruleId: function-location
    title: Put all functions together below the constants
    statement:
        Group every function in one block close to the start of the script,
        right after the constants. Nothing but includes, set commands and
        constant definitions may precede that block, and no runnable code
        may sit between two functions.
    rationale:
        Code hidden between functions is hard to follow and causes surprises
        when debugging.
    exceptions: null
    severity: null
    noncompliant:
        ```bash
        \\\
        log() { echo "$*" >&2; }
        mkdir -p "${WORK_DIR}"
        cleanup() { rm -rf "${WORK_DIR}"; }
        \\\
        ```
    compliant:
        ```bash
        \\\
        readonly WORK_DIR='/tmp/build'

        log() { echo "$*" >&2; }
        cleanup() { rm -rf "${WORK_DIR}"; }

        mkdir -p "${WORK_DIR}"
        \\\
        ```
    languages: [shell]
    tags: [structure, functions]
    source: https://google.github.io/styleguide/shellguide.html#function-location
