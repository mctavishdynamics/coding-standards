use ../lib/CodingRule

from ./GoogleShell import GoogleShell

export coding-rule GoogleShellControlFlow:
    standard: @{GoogleShell}
    ruleId: control-flow
    title: Keep then and do on the line that opens the if, for or while
    statement:
        Keep ; then or ; do on the line that opens the if, for, while, until or
        select. Else gets a line to itself, and the closing fi or done lines up
        with the keyword that opened the block. A loop over the script arguments
        names them with in "$@" instead of leaving the list implicit.
    rationale:
        This mirrors how braces are placed for functions, and spelling out
        the word list keeps the loop clear.
    exceptions: null
    severity: null
    noncompliant:
        ```bash
        \\\
        for arg
        do
          if [[ -z "${arg}" ]]
          then
            echo "empty argument"
          else echo "${arg}"
          fi
        done
        \\\
        ```
    compliant:
        ```bash
        \\\
        for arg in "$@"; do
          if [[ -z "${arg}" ]]; then
            echo "empty argument"
          else
            echo "${arg}"
          fi
        done
        \\\
        ```
    languages: [shell]
    tags: [formatting, control-flow]
    source: https://google.github.io/styleguide/shellguide.html#control-flow
