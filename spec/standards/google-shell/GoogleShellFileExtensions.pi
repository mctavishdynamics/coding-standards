use ../lib/CodingRule

from ./GoogleShell import GoogleShell

export coding-rule GoogleShellFileExtensions:
    standard: @{GoogleShell}
    ruleId: file-extensions
    title: Give executables a .sh extension or none, and libraries .sh
    statement:
        Name an executable with a .sh extension when a build rule renames
        it, and with no extension when it goes directly on the user's PATH.
        Give libraries a .sh extension and do not make them executable.
    rationale:
        Users running a command need not know its language, while a .sh
        source file pairs cleanly with a build rule of the same base name.
    exceptions:
        When neither case applies, either choice is acceptable for an
        executable.
    severity: null
    noncompliant: null
    compliant: null
    languages: [shell]
    tags: [files, naming]
    source: https://google.github.io/styleguide/shellguide.html#file-extensions
