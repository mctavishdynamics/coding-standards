use ../lib/CodingRule

from ./GoogleShell import GoogleShell

export coding-rule GoogleShellTodoComments:
    standard: @{GoogleShell}
    ruleId: todo-comments
    title: Mark temporary code with TODO comments
    statement:
        Mark temporary, stopgap or not-quite-right code with a TODO comment.
        Spell TODO in upper case and follow it, in parentheses, with the
        name or handle of whoever knows most about the problem.
    rationale:
        A consistent format can be searched to find who can explain the
        problem. A TODO is not a promise that the named person will fix it.
    exceptions: null
    severity: null
    noncompliant:
        ```bash
        \\\
        # fixme: retry when the mirror is down
        \\\
        ```
    compliant:
        ```bash
        \\\
        # TODO(jdoe): Retry when the mirror is down (bug 4521).
        \\\
        ```
    languages: [shell]
    tags: [comments, todo]
    source: https://google.github.io/styleguide/shellguide.html#todo-comments
