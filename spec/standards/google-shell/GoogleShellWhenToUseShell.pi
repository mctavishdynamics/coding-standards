use ../lib/CodingRule

from ./GoogleShell import GoogleShell

export coding-rule GoogleShellWhenToUseShell:
    standard: @{GoogleShell}
    ruleId: when-to-use-shell
    title: Use shell only for small utilities and simple wrappers
    statement:
        Choose shell when the script mostly calls other programs and does
        little data manipulation. Rewrite in a more structured language once
        a script passes about 100 lines, uses non-straightforward control
        flow, or needs good performance.
    rationale:
        Scripts grow, and an early rewrite is cheaper than a late one. Shell
        code that only its author can maintain is a sign the task has
        outgrown shell.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [shell]
    tags: [shell-choice, maintainability]
    source: https://google.github.io/styleguide/shellguide.html#when-to-use-shell
