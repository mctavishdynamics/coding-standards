use ../lib/CodingRule

from ./GoogleShell import GoogleShell

export coding-rule GoogleShellShellCheck:
    standard: @{GoogleShell}
    ruleId: shellcheck
    title: Run ShellCheck on all scripts
    statement:
        Use ShellCheck on every shell script, large or small.
    rationale:
        ShellCheck finds common bugs and warns about risky constructs before
        they reach production.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [shell]
    tags: [tooling, linting]
    source: https://google.github.io/styleguide/shellguide.html#shellcheck
