use ../lib/CodingRule

from ./GoogleShell import GoogleShell

export coding-rule GoogleShellFileHeader:
    standard: @{GoogleShell}
    ruleId: file-header
    title: Open every file with a comment saying what it holds
    statement:
        Every script begins with a top comment that summarises its purpose
        in a few words. Adding copyright or authorship lines is up to you.
    rationale:
        A reader can tell what a file is for without reading its code.
    exceptions: null
    severity: null
    noncompliant:
        ```bash
        \\\
        #!/bin/bash
        set -e
        tar -czf "/backups/$(date +%F).tgz" /srv/data
        \\\
        ```
    compliant:
        ```bash
        \\\
        #!/bin/bash
        #
        # Archive the data directory into a dated backup file.
        set -e
        tar -czf "/backups/$(date +%F).tgz" /srv/data
        \\\
        ```
    languages: [shell]
    tags: [comments, documentation]
    source: https://google.github.io/styleguide/shellguide.html#file-header
