use ../lib/CodingStandard

from ./GoogleShellAliases import GoogleShellAliases
from ./GoogleShellArithmetic import GoogleShellArithmetic
from ./GoogleShellArrays import GoogleShellArrays
from ./GoogleShellBuiltinCommandsVsExternalCommands import
    GoogleShellBuiltinCommandsVsExternalCommands
from ./GoogleShellCaseStatement import GoogleShellCaseStatement
from ./GoogleShellCheckingReturnValues import GoogleShellCheckingReturnValues
from ./GoogleShellCommandSubstitution import GoogleShellCommandSubstitution
from ./GoogleShellConstantsAndEnvironmentVariableNames import
    GoogleShellConstantsAndEnvironmentVariableNames
from ./GoogleShellControlFlow import GoogleShellControlFlow
from ./GoogleShellEval import GoogleShellEval
from ./GoogleShellFileExtensions import GoogleShellFileExtensions
from ./GoogleShellFileHeader import GoogleShellFileHeader
from ./GoogleShellFunctionComments import GoogleShellFunctionComments
from ./GoogleShellFunctionLocation import GoogleShellFunctionLocation
from ./GoogleShellFunctionNames import GoogleShellFunctionNames
from ./GoogleShellImplementationComments import
    GoogleShellImplementationComments
from ./GoogleShellIndentation import GoogleShellIndentation
from ./GoogleShellLineLengthAndLongStrings import
    GoogleShellLineLengthAndLongStrings
from ./GoogleShellMain import GoogleShellMain
from ./GoogleShellPipelines import GoogleShellPipelines
from ./GoogleShellPipesToWhile import GoogleShellPipesToWhile
from ./GoogleShellQuoting import GoogleShellQuoting
from ./GoogleShellShellCheck import GoogleShellShellCheck
from ./GoogleShellSourceFilenames import GoogleShellSourceFilenames
from ./GoogleShellStdoutVsStderr import GoogleShellStdoutVsStderr
from ./GoogleShellSuidSgid import GoogleShellSuidSgid
from ./GoogleShellTestBrackets import GoogleShellTestBrackets
from ./GoogleShellTestingStrings import GoogleShellTestingStrings
from ./GoogleShellTodoComments import GoogleShellTodoComments
from ./GoogleShellUseLocalVariables import GoogleShellUseLocalVariables
from ./GoogleShellVariableExpansion import GoogleShellVariableExpansion
from ./GoogleShellVariableNames import GoogleShellVariableNames
from ./GoogleShellWhenInDoubtBeConsistent import
    GoogleShellWhenInDoubtBeConsistent
from ./GoogleShellWhenToUseShell import GoogleShellWhenToUseShell
from ./GoogleShellWhichShellToUse import GoogleShellWhichShellToUse
from ./GoogleShellWildcardExpansionOfFilenames import
    GoogleShellWildcardExpansionOfFilenames

export coding-standard GoogleShell:
    title: Google Shell Style Guide
    publisher: Google
    url: https://google.github.io/styleguide/shellguide.html
    version: null
    license: Creative Commons Attribution 3.0 Unported (CC BY 3.0)
    description:
        Google's rules for writing Bash scripts, covering when to use shell,
        file layout, comments, formatting, safe use of shell features,
        naming and checking commands.
    rules:
        - @{GoogleShellWhichShellToUse}
        - @{GoogleShellWhenToUseShell}
        - @{GoogleShellFileExtensions}
        - @{GoogleShellSuidSgid}
        - @{GoogleShellStdoutVsStderr}
        - @{GoogleShellFileHeader}
        - @{GoogleShellFunctionComments}
        - @{GoogleShellImplementationComments}
        - @{GoogleShellTodoComments}
        - @{GoogleShellIndentation}
        - @{GoogleShellLineLengthAndLongStrings}
        - @{GoogleShellPipelines}
        - @{GoogleShellControlFlow}
        - @{GoogleShellCaseStatement}
        - @{GoogleShellVariableExpansion}
        - @{GoogleShellQuoting}
        - @{GoogleShellShellCheck}
        - @{GoogleShellCommandSubstitution}
        - @{GoogleShellTestBrackets}
        - @{GoogleShellTestingStrings}
        - @{GoogleShellWildcardExpansionOfFilenames}
        - @{GoogleShellEval}
        - @{GoogleShellArrays}
        - @{GoogleShellPipesToWhile}
        - @{GoogleShellArithmetic}
        - @{GoogleShellAliases}
        - @{GoogleShellFunctionNames}
        - @{GoogleShellVariableNames}
        - @{GoogleShellConstantsAndEnvironmentVariableNames}
        - @{GoogleShellSourceFilenames}
        - @{GoogleShellUseLocalVariables}
        - @{GoogleShellFunctionLocation}
        - @{GoogleShellMain}
        - @{GoogleShellCheckingReturnValues}
        - @{GoogleShellBuiltinCommandsVsExternalCommands}
        - @{GoogleShellWhenInDoubtBeConsistent}
