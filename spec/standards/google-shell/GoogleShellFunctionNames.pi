use ../lib/CodingRule

from ./GoogleShell import GoogleShell

export coding-rule GoogleShellFunctionNames:
    standard: @{GoogleShell}
    ruleId: function-names
    title: Name functions in lower case with underscores
    statement:
        Function names are lowercase words joined by underscores, followed
        directly by parentheses and then the opening brace on that line. A
        library may prefix its functions with a package name and two colons.
        Writing the function keyword is a choice, but a project should make
        that choice once and apply it everywhere.
    rationale:
        This matches the naming used elsewhere at Google and keeps functions
        easy to spot.
    exceptions:
        Avoid :: namespacing where colons cause trouble, such as interactive
        shell completion.
    severity: null
    noncompliant:
        ```bash
        \\\
        RestartService ()
        {
          systemctl restart "$1"
        }
        \\\
        ```
    compliant:
        ```bash
        \\\
        restart_service() {
          systemctl restart "$1"
        }

        deploy::restart_service() {
          systemctl restart "$1"
        }
        \\\
        ```
    languages: [shell]
    tags: [naming, functions]
    source: https://google.github.io/styleguide/shellguide.html#function-names
