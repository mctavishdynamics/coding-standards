use ../lib/CodingRule

from ./GoogleShell import GoogleShell

export coding-rule GoogleShellWhenInDoubtBeConsistent:
    standard: @{GoogleShell}
    ruleId: when-in-doubt-be-consistent
    title: When in doubt, be consistent
    statement:
        Use one style consistently, and when there is no clear technical
        argument, pick one option and stick with it. Do not use consistency
        as a reason to keep an old style without weighing the new one.
    rationale:
        Consistency lets people focus on more important issues and makes
        automation possible, and arguing over small choices costs more than
        the flexibility is worth.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [shell]
    tags: [consistency]
    source: https://google.github.io/styleguide/shellguide.html#when-in-doubt-be-consistent
