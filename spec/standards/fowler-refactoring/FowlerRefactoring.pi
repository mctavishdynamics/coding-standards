use ../lib/CodingStandard

from ./FowlerSmellAlternativeClassesWithDifferentInterfaces import
    FowlerSmellAlternativeClassesWithDifferentInterfaces
from ./FowlerSmellComments import FowlerSmellComments
from ./FowlerSmellDataClass import FowlerSmellDataClass
from ./FowlerSmellDataClumps import FowlerSmellDataClumps
from ./FowlerSmellDivergentChange import FowlerSmellDivergentChange
from ./FowlerSmellDuplicatedCode import FowlerSmellDuplicatedCode
from ./FowlerSmellFeatureEnvy import FowlerSmellFeatureEnvy
from ./FowlerSmellGlobalData import FowlerSmellGlobalData
from ./FowlerSmellInsiderTrading import FowlerSmellInsiderTrading
from ./FowlerSmellLargeClass import FowlerSmellLargeClass
from ./FowlerSmellLazyElement import FowlerSmellLazyElement
from ./FowlerSmellLongFunction import FowlerSmellLongFunction
from ./FowlerSmellLongParameterList import FowlerSmellLongParameterList
from ./FowlerSmellLoops import FowlerSmellLoops
from ./FowlerSmellMessageChains import FowlerSmellMessageChains
from ./FowlerSmellMiddleMan import FowlerSmellMiddleMan
from ./FowlerSmellMutableData import FowlerSmellMutableData
from ./FowlerSmellMysteriousName import FowlerSmellMysteriousName
from ./FowlerSmellPrimitiveObsession import FowlerSmellPrimitiveObsession
from ./FowlerSmellRefusedBequest import FowlerSmellRefusedBequest
from ./FowlerSmellRepeatedSwitches import FowlerSmellRepeatedSwitches
from ./FowlerSmellShotgunSurgery import FowlerSmellShotgunSurgery
from ./FowlerSmellSpeculativeGenerality import FowlerSmellSpeculativeGenerality
from ./FowlerSmellTemporaryField import FowlerSmellTemporaryField

export coding-standard FowlerRefactoring:
    title: Refactoring - Improving the Design of Existing Code, Chapter 3 Bad Smells in Code
    publisher: Martin Fowler, Addison-Wesley
    url: https://martinfowler.com/books/refactoring.html
    version: 2nd edition, 2018
    license: Copyright Martin Fowler / Pearson Education, all rights reserved. Smells are paraphrased.
    description:
        The 24 bad smells from chapter 3 of the second edition of
        Refactoring, signs in code that suggest a refactoring, each paired
        with refactorings from the book's catalogue that usually remove it.
    rules:
        - @{FowlerSmellMysteriousName}
        - @{FowlerSmellDuplicatedCode}
        - @{FowlerSmellLongFunction}
        - @{FowlerSmellLongParameterList}
        - @{FowlerSmellGlobalData}
        - @{FowlerSmellMutableData}
        - @{FowlerSmellDivergentChange}
        - @{FowlerSmellShotgunSurgery}
        - @{FowlerSmellFeatureEnvy}
        - @{FowlerSmellDataClumps}
        - @{FowlerSmellPrimitiveObsession}
        - @{FowlerSmellRepeatedSwitches}
        - @{FowlerSmellLoops}
        - @{FowlerSmellLazyElement}
        - @{FowlerSmellSpeculativeGenerality}
        - @{FowlerSmellTemporaryField}
        - @{FowlerSmellMessageChains}
        - @{FowlerSmellMiddleMan}
        - @{FowlerSmellInsiderTrading}
        - @{FowlerSmellLargeClass}
        - @{FowlerSmellAlternativeClassesWithDifferentInterfaces}
        - @{FowlerSmellDataClass}
        - @{FowlerSmellRefusedBequest}
        - @{FowlerSmellComments}
