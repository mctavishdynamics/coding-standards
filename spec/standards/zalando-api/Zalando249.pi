use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando249:
    standard: @{ZalandoApi}
    ruleId: 249
    title: Use the common address fields
    statement:
        Name and structure every address-related attribute according to the
        shared address definition, grouping fields as the use case requires.
    rationale:
        A single address model avoids each API inventing its own names for
        the same data, which also varies between countries.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```json
        \\\
        {
          "street": "Lindenweg 4",
          "additional": "Rear building",
          "zip": "10115",
          "city": "Berlin",
          "country_code": "DE"
        }
        \\\
        ```
    languages: [any]
    tags: [must, json, address]
    source: https://opensource.zalando.com/restful-api-guidelines/#249
