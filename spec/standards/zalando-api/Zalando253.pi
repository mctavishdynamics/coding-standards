use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando253:
    standard: @{ZalandoApi}
    ruleId: 253
    title: Support asynchronous request processing when needed
    statement:
        For long-running work, model the processing as a separate job
        resource with a status. Starting a job returns 201 with its
        location, polling the job returns its status, and the result is read
        from its own resource.
    rationale:
        An explicit job resource lets clients track progress and keeps long
        work from blocking a synchronous request.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```http
        \\\
        POST /export-jobs
        HTTP/1.1 201 Created
        Location: /export-jobs/j-41

        GET /export-jobs/j-41
        HTTP/1.1 200 OK
        { "status": "FINISHED", "export_id": "x-9" }
        \\\
        ```
    languages: [any]
    tags: [may, http, async]
    source: https://opensource.zalando.com/restful-api-guidelines/#253
