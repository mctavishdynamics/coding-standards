use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando188:
    standard: @{ZalandoApi}
    ruleId: 188
    title: Monitor usage of deprecated APIs scheduled for sunset
    statement:
        Monitor how much a deprecated API, version or feature that is
        scheduled for sunset is still used.
    rationale:
        Usage data shows migration progress and prevents breaking consumers
        who have not moved yet.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [must, deprecation, monitoring]
    source: https://opensource.zalando.com/restful-api-guidelines/#188
