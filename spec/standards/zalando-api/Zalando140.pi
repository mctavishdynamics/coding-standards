use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando140:
    standard: @{ZalandoApi}
    ruleId: 140
    title: Define useful resources
    statement:
        Shape resources so they cover about nine out of ten client use
        cases, with as much data as needed and no more. Serve the remaining
        cases with field filtering and embedding.
    rationale:
        Well-sized resources avoid both chatty clients and oversized
        payloads.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [should, resources, api-design]
    source: https://opensource.zalando.com/restful-api-guidelines/#140
