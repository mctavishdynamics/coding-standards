use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando113:
    standard: @{ZalandoApi}
    ruleId: 113
    title: Avoid versioning
    statement:
        Change APIs compatibly instead of creating versions. If a change
        cannot be compatible, prefer a new resource variant or a new service
        over a parallel version in the same service.
    rationale:
        Multiple versions complicate understanding, testing, operating and
        evolving systems.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [should, versioning, compatibility]
    source: https://opensource.zalando.com/restful-api-guidelines/#113
