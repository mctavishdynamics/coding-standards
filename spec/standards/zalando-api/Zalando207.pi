use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando207:
    standard: @{ZalandoApi}
    ruleId: 207
    title: Indicate ownership of event types
    statement:
        Give every event type a clear owner through its owning_application
        field, normally the application that produces it.
    rationale:
        An owner is accountable for the definition and its evolution, as
        with a REST API.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [must, events, ownership]
    source: https://opensource.zalando.com/restful-api-guidelines/#207
