use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando133:
    standard: @{ZalandoApi}
    ruleId: 133
    title: Use standard headers
    statement:
        Use headers defined by current RFCs when they fit, and list every
        supported header in the specification.
    rationale:
        Standard headers are understood by clients and infrastructure, and
        listing them documents the contract.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [may, http, headers]
    source: https://opensource.zalando.com/restful-api-guidelines/#133
