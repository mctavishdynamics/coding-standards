use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando201:
    standard: @{ZalandoApi}
    ruleId: 201
    title: Use general events for business process steps
    statement:
        Model events for business process steps on the general event
        category. Each one carries a process identifier and ordering data,
        holds only what changed at that step, and must be published
        reliably.
    rationale:
        Process ids and ordering let consumers group and replay all events
        of one process run.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [must, events, business-process]
    source: https://opensource.zalando.com/restful-api-guidelines/#201
