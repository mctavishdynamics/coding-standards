use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando190:
    standard: @{ZalandoApi}
    ruleId: 190
    title: Monitor Deprecation and Sunset headers in clients
    statement:
        Have clients watch for Deprecation and Sunset headers in responses
        and raise alerts when they appear.
    rationale:
        Alerts give client owners time to plan the migration with the
        service owners.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [should, deprecation, monitoring]
    source: https://opensource.zalando.com/restful-api-guidelines/#190
