use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando127:
    standard: @{ZalandoApi}
    ruleId: 127
    title: Use standard formats for durations and intervals
    statement:
        Represent durations and time intervals as ISO 8601 strings following
        the RFC 3339 grammar, using the open-ended form for unbounded
        intervals. Name an interval query parameter with a between suffix
        and an interval property with an interval suffix.
    rationale:
        ISO 8601 durations and intervals are widely supported and remove the
        need for parameter pairs such as before and after.
    exceptions: null
    severity: null
    noncompliant:
        ```http
        \\\
        GET /orders?created_after=2024-01-01T00:00:00Z&created_before=2024-02-01T00:00:00Z
        \\\
        ```
    compliant:
        ```http
        \\\
        GET /orders?created_between=2024-01-01T00:00:00Z/2024-02-01T00:00:00Z
        GET /orders?created_between=2024-01-01T00:00:00Z/..
        \\\
        ```
    languages: [any]
    tags: [should, data-formats, date-time]
    source: https://opensource.zalando.com/restful-api-guidelines/#127
