use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando200:
    standard: @{ZalandoApi}
    ruleId: 200
    title: Avoid writing sensitive data to events
    statement:
        Do not put sensitive data such as personal details into events
        unless the business really needs it.
    rationale:
        Every copy of personal data in a stream must be protected and
        accounted for, so leaving it out is the cheapest safeguard.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [should, events, privacy]
    source: https://opensource.zalando.com/restful-api-guidelines/#200
