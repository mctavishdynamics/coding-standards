use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando108:
    standard: @{ZalandoApi}
    ruleId: 108
    title: Write clients that tolerate additive, compatible API changes
    statement:
        Write clients as tolerant readers. Ignore unknown fields but keep
        them for later PUT requests, handle new values of extensible enums,
        cope with unspecified status codes as their x00 class, and follow
        301 redirects.
    rationale:
        Providers can then add to responses without breaking clients.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [must, compatibility, clients]
    source: https://opensource.zalando.com/restful-api-guidelines/#108
