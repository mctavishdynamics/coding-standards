use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando162:
    standard: @{ZalandoApi}
    ruleId: 162
    title: Use REST maturity level 2
    statement:
        Build resource-oriented APIs that use HTTP methods and status codes
        properly, as described by REST maturity level 2.
    rationale:
        Level 2 gets the main benefits of REST and HTTP without the
        complexity of full hypermedia.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [must, rest, api-design]
    source: https://opensource.zalando.com/restful-api-guidelines/#162
