use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando215:
    standard: @{ZalandoApi}
    ruleId: 215
    title: Provide a unique API identifier
    statement:
        Give every API specification a globally unique and immutable
        identifier in info.x-api-id. A UUID generated when the API is first
        created is recommended, and a copied specification must get a new
        identifier at once.
    rationale:
        The identifier links all versions of one API together, which enables
        change history and automated backward compatibility checks.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```yaml
        \\\
        info:
          x-api-id: 7c2e91d4-5a0b-4f63-b8e1-2d94c0a6f357
          title: Parcel Tracking API
          version: 1.4.0
        \\\
        ```
    languages: [any]
    tags: [must, openapi, metadata]
    source: https://opensource.zalando.com/restful-api-guidelines/#215
