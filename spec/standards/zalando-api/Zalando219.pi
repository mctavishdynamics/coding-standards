use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando219:
    standard: @{ZalandoApi}
    ruleId: 219
    title: Declare the API audience
    statement:
        Record in info.x-audience who the API is built for, choosing one
        value from external-public, external-partner, company-internal,
        business-unit-internal and component-internal. If different parts
        target different groups, pick the broadest one.
    rationale:
        The audience decides how strict the standards for design,
        documentation, change and permissions must be, and makes the API
        discoverable to the right people.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```yaml
        \\\
        info:
          x-audience: external-partner
        \\\
        ```
    languages: [any]
    tags: [must, openapi, metadata]
    source: https://opensource.zalando.com/restful-api-guidelines/#219
