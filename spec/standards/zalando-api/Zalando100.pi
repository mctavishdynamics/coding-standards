use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando100:
    standard: @{ZalandoApi}
    ruleId: 100
    title: Follow the API first principle
    statement:
        Define the API in OpenAPI before writing the implementation, design
        it to match these guidelines, and ask peers and client developers
        for review early. APIs used outside their own component go through
        the lightweight API review process.
    rationale:
        Designing the contract first keeps the API focused on the domain and
        the consumers rather than on implementation details, and early
        review is far cheaper than changing a published interface.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [must, api-design, process, review]
    source: https://opensource.zalando.com/restful-api-guidelines/#100
