use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando106:
    standard: @{ZalandoApi}
    ruleId: 106
    title: Do not break backward compatibility
    statement:
        Evolve APIs without breaking existing consumers, preferably through
        compatible extensions, and otherwise by offering a new version while
        still supporting and deprecating the old one.
    rationale:
        Consumers ship on their own timelines and value stability, so the
        provider has no right to change the agreed interface under them.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [must, compatibility]
    source: https://opensource.zalando.com/restful-api-guidelines/#106
