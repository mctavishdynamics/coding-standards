use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando205:
    standard: @{ZalandoApi}
    ruleId: 205
    title: Match data change events to the API resources
    statement:
        Make the entity in a data change event correspond to its REST API
        representation, and publish only changes that matter in the domain.
    rationale:
        Fewer distinct representations are easier for consumers to use and
        for owners to maintain.
    exceptions:
        Differing representations can make sense for data integration from
        the datastore, for aggregated data, or for computed results that are
        not stored as entities.
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [should, events, data-change]
    source: https://opensource.zalando.com/restful-api-guidelines/#205
