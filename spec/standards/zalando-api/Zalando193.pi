use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando193:
    standard: @{ZalandoApi}
    ruleId: 193
    title: Monitor API usage
    statement:
        Monitor production APIs to learn which clients use them, for example
        by logging the client id from the OAuth token.
    rationale:
        Knowing the clients helps find reviewers for changes and assess the
        impact of deprecation.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [should, monitoring]
    source: https://opensource.zalando.com/restful-api-guidelines/#193
