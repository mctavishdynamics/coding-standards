use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando242:
    standard: @{ZalandoApi}
    ruleId: 242
    title: Provide explicit ordering for data change events
    statement:
        Always include ordering information in data change events, defining
        the order of changes per entity.
    rationale:
        Replicas can only stay in sync if changes are applied in the right
        order.
    exceptions:
        Append-only data, where entities are created but never changed or
        deleted, may omit the ordering.
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [must, events, ordering]
    source: https://opensource.zalando.com/restful-api-guidelines/#242
