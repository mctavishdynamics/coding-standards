use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando246:
    standard: @{ZalandoApi}
    ruleId: 246
    title: Use semantic versioning for event type schemas
    statement:
        Version event schemas as MAJOR.MINOR.PATCH. Text changes are PATCH,
        new optional fields are MINOR, and other changes are MAJOR, which
        compatible and forward modes do not allow.
    rationale:
        Version numbers tied to compatibility rules tell consumers what a
        schema change means for them.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [must, events, versioning]
    source: https://opensource.zalando.com/restful-api-guidelines/#246
