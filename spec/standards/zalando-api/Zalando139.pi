use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando139:
    standard: @{ZalandoApi}
    ruleId: 139
    title: Model complete business processes
    statement:
        Include in one API all the resources that make up a business
        process, rather than spreading one process over several thin APIs.
    rationale:
        Seeing the whole process in one place helps clients follow it and
        keeps its design coherent. Splitting it up tends to create hidden
        coupling between APIs and pushes domain logic out to the callers.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [should, api-design, resources]
    source: https://opensource.zalando.com/restful-api-guidelines/#139
