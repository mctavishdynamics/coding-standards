use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando102:
    standard: @{ZalandoApi}
    ruleId: 102
    title: Provide an API user manual
    statement:
        Publish an online user manual next to the specification that covers
        the scope and use cases, concrete usage examples, edge cases and
        error handling, and the architecture context. Link it from the
        specification through the externalDocs url property.
    rationale:
        A specification lists the operations but rarely explains how to
        combine them; a manual helps engineers who are new to the API get it
        right.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```yaml
        \\\
        externalDocs:
          description: Parcel Tracking API user manual
          url: https://docs.example.com/parcel-tracking/manual
        \\\
        ```
    languages: [any]
    tags: [should, documentation]
    source: https://opensource.zalando.com/restful-api-guidelines/#102
