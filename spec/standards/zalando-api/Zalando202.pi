use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando202:
    standard: @{ZalandoApi}
    ruleId: 202
    title: Use data change events for mutations
    statement:
        Publish data change events for every create, update and delete of
        stored entities, with the complete entity data and its id, explicit
        ordering, and reliable delivery.
    rationale:
        Change events let other systems replicate the data, for example for
        analytics, through change data capture.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [must, events, data-change]
    source: https://opensource.zalando.com/restful-api-guidelines/#202
