use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando192:
    standard: @{ZalandoApi}
    ruleId: 192
    title: Publish the OpenAPI specification
    statement:
        Publish the specification of every non-internal API with the
        deployment of its service, as self-contained YAML files in the
        reserved API directory.
    rationale:
        Published specifications give client developers one place to
        discover and review all running APIs.
    exceptions:
        Publishing is optional, though recommended, for component-internal
        APIs.
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [must, openapi, documentation]
    source: https://opensource.zalando.com/restful-api-guidelines/#192
