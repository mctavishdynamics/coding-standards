use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando209:
    standard: @{ZalandoApi}
    ruleId: 209
    title: Keep events backward compatible
    statement:
        Change event schemas only in additive, backward-compatible ways,
        such as adding optional fields or new extensible enum values. Never
        remove required fields, change types or change default values.
    rationale:
        Producers and consumers are decoupled in time and cannot negotiate
        versions, so consumers must be able to read every event.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [must, events, compatibility]
    source: https://opensource.zalando.com/restful-api-guidelines/#209
