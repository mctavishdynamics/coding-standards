use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando144:
    standard: @{ZalandoApi}
    ruleId: 144
    title: Use UUIDs only when necessary
    statement:
        Avoid UUIDs unless ids must be generated at large scale without
        coordination. Prefer server-side id generation, and especially avoid
        UUIDs as keys for low-volume master and configuration data.
    rationale:
        UUIDs are long, unordered, hard for people to read and debug, and
        carry no meaning, which costs usability without benefit when scale
        does not need them.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [should, identifiers, data-formats]
    source: https://opensource.zalando.com/restful-api-guidelines/#144
