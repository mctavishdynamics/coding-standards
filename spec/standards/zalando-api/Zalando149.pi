use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando149:
    standard: @{ZalandoApi}
    ruleId: 149
    title: Fulfill the common method properties
    statement:
        Implement each method with the safe, idempotent and cacheable
        properties that RFC 9110 assigns to it. GET and HEAD must not have
        intended side effects, and PUT and DELETE must be idempotent.
    rationale:
        Clients and infrastructure retry and cache requests based on these
        properties, so breaking them causes duplicate or lost changes.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [must, http, idempotency]
    source: https://opensource.zalando.com/restful-api-guidelines/#149
