use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando146:
    standard: @{ZalandoApi}
    ruleId: 146
    title: Limit the number of resource types
    statement:
        Keep the number of resource types in one API small, usually four to
        eight, where a type is a collection with its members and direct
        sub-resources. Split APIs that mix different business functions.
    rationale:
        Focused APIs follow separation of concerns and stay easier to
        maintain and evolve.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [should, api-design, resources]
    source: https://opensource.zalando.com/restful-api-guidelines/#146
