use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando155:
    standard: @{ZalandoApi}
    ruleId: 155
    title: Reduce bandwidth needs and improve responsiveness
    statement:
        For APIs with large payloads or heavy traffic, offer ways to cut
        bandwidth, such as compression, field filtering, conditional
        requests, the Prefer header, pagination and caching of rarely
        changing data.
    rationale:
        Clients on slow or mobile connections benefit most, and the service
        handles less load.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [should, performance]
    source: https://opensource.zalando.com/restful-api-guidelines/#155
