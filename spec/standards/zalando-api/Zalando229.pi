use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando229:
    standard: @{ZalandoApi}
    ruleId: 229
    title: Consider designing POST and PATCH to be idempotent
    statement:
        Where duplicates or lost updates are a risk, make POST and PATCH
        idempotent with one of three patterns, a conditional key in
        If-Match, a secondary key stored in the resource, or a client
        Idempotency-Key header.
    rationale:
        Idempotent writes let clients retry safely and expose concurrent
        changes instead of creating duplicate resources.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [should, http, idempotency]
    source: https://opensource.zalando.com/restful-api-guidelines/#229
