use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando185:
    standard: @{ZalandoApi}
    ruleId: 185
    title: Obtain client approval before shutting down an API
    statement:
        Before shutting down an API, version or feature, get every client's
        agreement on a sunset date, and help them migrate with a guide and a
        clear timeline.
    rationale:
        Shutting down an API that clients still use breaks them without
        warning.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [must, deprecation, process]
    source: https://opensource.zalando.com/restful-api-guidelines/#185
