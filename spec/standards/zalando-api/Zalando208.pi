use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando208:
    standard: @{ZalandoApi}
    ruleId: 208
    title: Define events in line with the API guidelines
    statement:
        Design events to match the rest of the API data and follow the
        general, data format, JSON and hypermedia guidelines wherever they
        apply.
    rationale:
        Events are a commitment just like APIs, and are often based on the
        same models, so the same quality rules hold.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [must, events, api-design]
    source: https://opensource.zalando.com/restful-api-guidelines/#208
