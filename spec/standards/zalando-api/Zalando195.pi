use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando195:
    standard: @{ZalandoApi}
    ruleId: 195
    title: Make event schemas available for review
    statement:
        Make the schema and the event type definition of every event
        published for others available for review.
    rationale:
        Review catches design problems before consumers depend on the event.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [must, events, review]
    source: https://opensource.zalando.com/restful-api-guidelines/#195
