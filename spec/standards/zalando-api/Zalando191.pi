use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando191:
    standard: @{ZalandoApi}
    ruleId: 191
    title: Do not start using deprecated APIs
    statement:
        Never build new client usage on a deprecated API, version or
        feature.
    rationale:
        New dependencies on something being retired create migration work
        and delay its shutdown.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [must, deprecation, clients]
    source: https://opensource.zalando.com/restful-api-guidelines/#191
