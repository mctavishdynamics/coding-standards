use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando184:
    standard: @{ZalandoApi}
    ruleId: 184
    title: Propagate proprietary headers
    statement:
        Pass the defined proprietary headers on unchanged to every
        downstream service in the call chain, even when their value is also
        copied into a request body.
    rationale:
        These headers are end-to-end context, such as the device type, that
        later services may need to produce the right result.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [must, http, headers]
    source: https://opensource.zalando.com/restful-api-guidelines/#184
