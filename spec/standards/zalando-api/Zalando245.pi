use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando245:
    standard: @{ZalandoApi}
    ruleId: 245
    title: Choose the compatibility mode carefully
    statement:
        Pick the event type compatibility mode deliberately, none, forward
        or compatible, knowing which schema changes each mode allows.
    rationale:
        The mode decides how the schema can evolve without breaking
        producers or consumers.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [must, events, compatibility]
    source: https://opensource.zalando.com/restful-api-guidelines/#245
