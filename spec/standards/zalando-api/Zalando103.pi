use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando103:
    standard: @{ZalandoApi}
    ruleId: 103
    title: Write APIs in U.S. English
    statement:
        Use U.S. English for every name, description and value in an API
        specification and its payloads.
    rationale:
        One shared language and spelling keeps names consistent across teams
        and avoids pairs such as colour and color meaning the same thing.
    exceptions: null
    severity: null
    noncompliant:
        ```yaml
        \\\
        properties:
          colour:
            type: string
          favourite_store_id:
            type: string
        \\\
        ```
    compliant:
        ```yaml
        \\\
        properties:
          color:
            type: string
          favorite_store_id:
            type: string
        \\\
        ```
    languages: [any]
    tags: [must, naming, language]
    source: https://opensource.zalando.com/restful-api-guidelines/#103
