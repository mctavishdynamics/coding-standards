use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando234:
    standard: @{ZalandoApi}
    ruleId: 234
    title: Use only durable and immutable remote references
    statement:
        Keep API specifications self-contained and avoid references to local
        files or arbitrary URLs. Remote references are allowed only to the
        internal API repository and to the guideline model fragments, whose
        content is durable and immutable.
    rationale:
        Content behind an ordinary link can move or change, which silently
        changes the meaning of the API that refers to it.
    exceptions: null
    severity: null
    noncompliant:
        ```yaml
        \\\
        components:
          schemas:
            Problem:
              $ref: 'https://github.com/some-team/shared/blob/main/problem.yaml#/Problem'
        \\\
        ```
    compliant:
        ```yaml
        \\\
        components:
          schemas:
            Problem:
              $ref: 'https://opensource.zalando.com/restful-api-guidelines/models/problem-1.0.1.yaml#/Problem'
        \\\
        ```
    languages: [any]
    tags: [must, openapi, references]
    source: https://opensource.zalando.com/restful-api-guidelines/#234
