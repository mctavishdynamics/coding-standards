use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando257:
    standard: @{ZalandoApi}
    ruleId: 257
    title: Interpret 404 status codes with care
    statement:
        Do not assume that a 404 always reflects the state of the resource
        in the backend. Rule out routers and proxies as its source before
        acting on it.
    rationale:
        Infrastructure in the network path may return 404 for missing routes
        even though the resource exists.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [should, http, status-codes]
    source: https://opensource.zalando.com/restful-api-guidelines/#257
