use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando211:
    standard: @{ZalandoApi}
    ruleId: 211
    title: Provide unique event identifiers
    statement:
        Every event carries an eid unique within its event type. A retry or
        any other republication of that event keeps its original eid.
    rationale:
        A stable id lets consumers recognise and drop duplicates.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [must, events, identifiers]
    source: https://opensource.zalando.com/restful-api-guidelines/#211
