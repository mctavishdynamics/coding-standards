use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando194:
    standard: @{ZalandoApi}
    ruleId: 194
    title: Count published events as part of a service's API
    statement:
        Treat published events as part of the service's public interface,
        equal to its REST API, and design them API first.
    rationale:
        Other services integrate on events as they do on APIs, so careless
        event design hurts them in the same way.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [must, events, api-design]
    source: https://opensource.zalando.com/restful-api-guidelines/#194
