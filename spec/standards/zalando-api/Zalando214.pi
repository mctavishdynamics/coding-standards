use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando214:
    standard: @{ZalandoApi}
    ruleId: 214
    title: Be robust against duplicate events
    statement:
        Write consumers so that receiving the same event more than once does
        no harm, deduplicating by eid where accuracy matters.
    rationale:
        Event delivery can repeat events, and some uses such as accounting
        cannot tolerate double counting.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [must, events, idempotency]
    source: https://opensource.zalando.com/restful-api-guidelines/#214
