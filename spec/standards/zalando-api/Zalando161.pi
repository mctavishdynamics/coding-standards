use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando161:
    standard: @{ZalandoApi}
    ruleId: 161
    title: Use pagination links
    statement:
        Provide pagination as simple hypertext links where possible. For GET
        requests with a body, the returned query object can be resent as the
        body with each link.
    rationale:
        Ready-made links spare clients from building page URLs themselves.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [should, pagination, hypermedia]
    source: https://opensource.zalando.com/restful-api-guidelines/#161
