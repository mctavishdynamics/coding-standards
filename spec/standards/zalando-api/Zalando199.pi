use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando199:
    standard: @{ZalandoApi}
    ruleId: 199
    title: Make events define useful business resources
    statement:
        Base events on the resources and business processes of the service
        domain and their life cycle. Prefer event types that serve many use
        cases, and do not publish events without a clear need.
    rationale:
        Every new event type has a cost, and generic, domain-based events
        are useful to more consumers.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [must, events, api-design]
    source: https://opensource.zalando.com/restful-api-guidelines/#199
