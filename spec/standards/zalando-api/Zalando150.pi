use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando150:
    standard: @{ZalandoApi}
    ruleId: 150
    title: Use only the most common HTTP status codes
    statement:
        Prefer the commonly used status codes and avoid rare ones with
        unfamiliar meanings. Describe a code in the specification only when
        it is unusual or needs extra information.
    rationale:
        Common codes are understood without explanation, while rare ones
        invite misinterpretation.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [should, http, status-codes]
    source: https://opensource.zalando.com/restful-api-guidelines/#150
