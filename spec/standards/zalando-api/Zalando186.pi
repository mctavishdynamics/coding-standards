use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando186:
    standard: @{ZalandoApi}
    ruleId: 186
    title: Collect external partner consent on the deprecation period
    statement:
        For APIs used by external partners, define the minimum time the API
        is kept after deprecation is announced, and have every partner
        accept it before they start using the API.
    rationale:
        Partners need a reliable period to migrate, and agreeing on it up
        front avoids disputes later.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [must, deprecation, process]
    source: https://opensource.zalando.com/restful-api-guidelines/#186
