use ../lib/CodingRule

from ./ZalandoApi import ZalandoApi

export coding-rule Zalando163:
    standard: @{ZalandoApi}
    ruleId: 163
    title: Use REST maturity level 3 only when it adds value
    statement:
        HATEOAS is allowed but not recommended in general. Links still
        belong in responses where they help, but clients should rely on the
        specification rather than on discovering the API at run time.
    rationale:
        With API first, the specification already documents the links, and
        generic hypermedia clients rarely work in practice.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [may, rest, hypermedia]
    source: https://opensource.zalando.com/restful-api-guidelines/#163
