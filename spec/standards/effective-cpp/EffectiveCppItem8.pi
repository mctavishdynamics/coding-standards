use ../lib/CodingRule

from ./EffectiveCpp import EffectiveCpp

export coding-rule EffectiveCppItem8:
    standard: @{EffectiveCpp}
    ruleId: item-8
    title: Handle failures inside destructors instead of throwing
    statement:
        A destructor should catch and handle any exception raised by the
        work it does. If callers need to react to a failure, give them a
        separate function to call first.
    rationale:
        A destructor that throws during stack unwinding terminates the
        program, and containers cannot cope with throwing destructors.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Connection::~Connection() {
            socket_.close();   // may throw
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void Connection::close() { socket_.close(); closed_ = true; }
        Connection::~Connection() {
            if (!closed_) {
                try { socket_.close(); } catch (...) { log("close failed"); }
            }
        }
        \\\
        ```
    languages: [cpp]
    tags: [constructors-destructors-assignment, destructors, exceptions]
    source: https://www.informit.com/store/effective-c-plus-plus-55-specific-ways-to-improve-your-9780321334879
