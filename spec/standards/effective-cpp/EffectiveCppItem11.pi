use ../lib/CodingRule

from ./EffectiveCpp import EffectiveCpp

export coding-rule EffectiveCppItem11:
    standard: @{EffectiveCpp}
    ruleId: item-11
    title: Make assignment safe when an object is assigned to itself
    statement:
        Write operator= so that it behaves correctly when the source and
        target are the same object, for example by copying before releasing
        or by copy and swap.
    rationale:
        Self assignment happens through aliases, and a naive implementation
        frees the data it is about to copy.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Image& Image::operator=(const Image& o) {
            delete pixels_;
            pixels_ = new Bitmap(*o.pixels_);
            return *this;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        Image& Image::operator=(const Image& o) {
            Bitmap* copy = new Bitmap(*o.pixels_);
            delete pixels_;
            pixels_ = copy;
            return *this;
        }
        \\\
        ```
    languages: [cpp]
    tags: [constructors-destructors-assignment, operators, aliasing]
    source: https://www.informit.com/store/effective-c-plus-plus-55-specific-ways-to-improve-your-9780321334879
