use ../lib/CodingRule

from ./EffectiveCpp import EffectiveCpp

export coding-rule EffectiveCppItem54:
    standard: @{EffectiveCpp}
    ruleId: item-54
    title: Learn what the standard library offers
    statement:
        Get to know the standard library, including the facilities that came
        from TR1 such as smart pointers, function wrappers, hash containers
        and regular expressions.
    rationale:
        Reusing well-tested standard components saves effort and avoids bugs
        in hand-written equivalents.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [miscellany, standard-library]
    source: https://www.informit.com/store/effective-c-plus-plus-55-specific-ways-to-improve-your-9780321334879
