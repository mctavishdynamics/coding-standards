use ../lib/CodingRule

from ./EffectiveCpp import EffectiveCpp

export coding-rule EffectiveCppItem5:
    standard: @{EffectiveCpp}
    ruleId: item-5
    title: Know which special members the compiler generates for you
    statement:
        Be aware that the compiler can declare a default constructor, copy
        constructor, copy assignment operator and destructor when you do
        not, and that they copy or destroy member by member.
    rationale:
        Generated members may do the wrong thing for classes holding
        references, const members or owned resources.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Buffer {
        public:
            explicit Buffer(std::size_t n) : data_(new char[n]) {}
            ~Buffer() { delete[] data_; }
        private:
            char* data_;   // generated copy shares the pointer
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Buffer {
        public:
            explicit Buffer(std::size_t n) : data_(n) {}
        private:
            std::vector<char> data_;   // generated copy is correct
        };
        \\\
        ```
    languages: [cpp]
    tags: [constructors-destructors-assignment, special-members]
    source: https://www.informit.com/store/effective-c-plus-plus-55-specific-ways-to-improve-your-9780321334879
