use ../lib/CodingRule

from ./EffectiveCpp import EffectiveCpp

export coding-rule EffectiveCppItem55:
    standard: @{EffectiveCpp}
    ruleId: item-55
    title: Learn what the Boost libraries offer
    statement:
        Become familiar with Boost, the peer-reviewed collection of open
        source C++ libraries, before writing general-purpose infrastructure
        yourself.
    rationale:
        Boost provides high-quality components, and many of them later
        became part of the standard.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [miscellany, libraries]
    source: https://www.informit.com/store/effective-c-plus-plus-55-specific-ways-to-improve-your-9780321334879
