use ../lib/CodingRule

from ./EffectiveCpp import EffectiveCpp

export coding-rule EffectiveCppItem30:
    standard: @{EffectiveCpp}
    ruleId: item-30
    title: Understand what inlining costs and gains
    statement:
        Inline only small, frequently called functions. Remember that inline
        is a request and that inline functions in headers force
        recompilation when they change.
    rationale:
        Excessive inlining bloats code and lowers cache performance, and
        makes binary upgrades and debugging harder.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [implementations, performance, inlining]
    source: https://www.informit.com/store/effective-c-plus-plus-55-specific-ways-to-improve-your-9780321334879
