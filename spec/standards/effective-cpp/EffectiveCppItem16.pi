use ../lib/CodingRule

from ./EffectiveCpp import EffectiveCpp

export coding-rule EffectiveCppItem16:
    standard: @{EffectiveCpp}
    ruleId: item-16
    title: Match array new with array delete
    statement:
        Free memory from new with delete and memory from new[] with
        delete[]. Avoid typedefs that hide an array type.
    rationale:
        Using the wrong form is undefined behaviour and usually corrupts the
        heap or skips destructors.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        auto* names = new std::string[10];
        delete names;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        auto* names = new std::string[10];
        delete[] names;
        // better: std::vector<std::string> names(10);
        \\\
        ```
    languages: [cpp]
    tags: [resource-management, memory]
    source: https://www.informit.com/store/effective-c-plus-plus-55-specific-ways-to-improve-your-9780321334879
