use ../lib/CodingRule

from ./EffectiveCpp import EffectiveCpp

export coding-rule EffectiveCppItem19:
    standard: @{EffectiveCpp}
    ruleId: item-19
    title: Design each class with the care of designing a new type
    statement:
        Before writing a class, settle how objects are created and
        destroyed, copied, converted, validated, and which operations and
        inheritance relationships make sense.
    rationale:
        A class defines a type that others will use like a built-in one, so
        its behaviour must be just as predictable.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [designs-and-declarations, design]
    source: https://www.informit.com/store/effective-c-plus-plus-55-specific-ways-to-improve-your-9780321334879
