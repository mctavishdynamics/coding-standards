use ../lib/CodingRule

from ./EffectiveCpp import EffectiveCpp

export coding-rule EffectiveCppItem42:
    standard: @{EffectiveCpp}
    ruleId: item-42
    title: Know both uses of typename
    statement:
        typename and class are interchangeable for template parameters, but
        use typename to mark a name that depends on a template parameter and
        names a type.
    rationale:
        Without it the compiler assumes the dependent name is a value and
        the code does not compile or means something else.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template <class C>
        void printFirst(const C& c) {
            C::const_iterator it = c.begin();
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template <class C>
        void printFirst(const C& c) {
            typename C::const_iterator it = c.begin();
        }
        \\\
        ```
    languages: [cpp]
    tags: [templates-and-generic-programming, templates]
    source: https://www.informit.com/store/effective-c-plus-plus-55-specific-ways-to-improve-your-9780321334879
