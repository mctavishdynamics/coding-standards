use ../lib/CodingRule

from ./EffectiveCpp import EffectiveCpp

export coding-rule EffectiveCppItem32:
    standard: @{EffectiveCpp}
    ruleId: item-32
    title: Use public inheritance only for genuine is-a relationships
    statement:
        Derive publicly only when every behaviour that holds for the base
        also holds for the derived class.
    rationale:
        Clients rely on base class guarantees; a derived class that cannot
        keep them breaks code written against the base.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Rectangle { public: virtual void setWidth(int); };
        class Square : public Rectangle {};   // setWidth breaks squares
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Shape { public: virtual double area() const = 0; };
        class Rectangle : public Shape {};
        class Square : public Shape {};
        \\\
        ```
    languages: [cpp]
    tags: [inheritance-and-oo-design, inheritance, substitutability]
    source: https://www.informit.com/store/effective-c-plus-plus-55-specific-ways-to-improve-your-9780321334879
