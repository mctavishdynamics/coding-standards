use ../lib/CodingRule

from ./EffectiveCpp import EffectiveCpp

export coding-rule EffectiveCppItem41:
    standard: @{EffectiveCpp}
    ruleId: item-41
    title: Learn how template requirements and dispatch differ from classes
    statement:
        Recognise that a template's requirements come from the expressions
        it uses, and that the choice of behaviour is made when the template
        is instantiated.
    rationale:
        Classes use explicit interfaces and runtime polymorphism; templates
        follow different rules that affect how you design and document them.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [templates-and-generic-programming, templates, polymorphism]
    source: https://www.informit.com/store/effective-c-plus-plus-55-specific-ways-to-improve-your-9780321334879
