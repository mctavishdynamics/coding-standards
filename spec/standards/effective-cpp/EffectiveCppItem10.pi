use ../lib/CodingRule

from ./EffectiveCpp import EffectiveCpp

export coding-rule EffectiveCppItem10:
    standard: @{EffectiveCpp}
    ruleId: item-10
    title: Return a reference to the left-hand object from assignment operators
    statement:
        Assignment and compound assignment operators should return a
        reference to the object assigned to.
    rationale:
        Built-in and standard library types already behave this way, and
        handing back the reference allows chains such as a = b = c.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void Vec2::operator+=(const Vec2& o) {
            x += o.x; y += o.y;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        Vec2& Vec2::operator+=(const Vec2& o) {
            x += o.x; y += o.y;
            return *this;
        }
        \\\
        ```
    languages: [cpp]
    tags: [constructors-destructors-assignment, operators]
    source: https://www.informit.com/store/effective-c-plus-plus-55-specific-ways-to-improve-your-9780321334879
