export coding-standard EffectiveCpp:
    title: Effective C++
    publisher: Scott Meyers, Addison-Wesley
    url: https://www.aristeia.com/books.html
    version: 3rd edition, 2005
    license: Copyright Pearson Education (Addison-Wesley), Scott Meyers, all rights reserved. Items are paraphrased.
    description:
        Scott Meyers' 55 numbered items on using C++ well, covering resource management, class and interface design, inheritance, templates and custom memory allocation.
