use ../lib/CodingRule

from ./EffectiveCpp import EffectiveCpp

export coding-rule EffectiveCppItem50:
    standard: @{EffectiveCpp}
    ruleId: item-50
    title: Replace new and delete only for a clear reason
    statement:
        Write custom allocation functions when you need to detect misuse,
        gather statistics, improve speed or memory use, or control alignment
        and placement.
    rationale:
        Replacing the global allocator is hard to do correctly, so it should
        be justified by a measured need.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [customizing-new-and-delete, memory, allocation]
    source: https://www.informit.com/store/effective-c-plus-plus-55-specific-ways-to-improve-your-9780321334879
