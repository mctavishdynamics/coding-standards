use ../lib/CodingRule

from ./EffectiveCpp import EffectiveCpp

export coding-rule EffectiveCppItem1:
    standard: @{EffectiveCpp}
    ruleId: item-1
    title: Treat C++ as several sub-languages with their own conventions
    statement:
        Recognise that C++ combines a C core, object-oriented classes,
        templates and the standard library. Switch idioms when you move
        between these parts.
    rationale:
        Good practice in one part can be poor practice in another; passing
        by value suits built-in types but not most class types.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [accustoming-yourself-to-cpp, design]
    source: https://www.informit.com/store/effective-c-plus-plus-55-specific-ways-to-improve-your-9780321334879
