use ../lib/CodingRule

from ./EffectiveCpp import EffectiveCpp

export coding-rule EffectiveCppItem26:
    standard: @{EffectiveCpp}
    ruleId: item-26
    title: Define variables only when you can give them their value
    statement:
        Delay a variable's definition until it is needed and you have its
        initial value.
    rationale:
        Early definitions pay for construction and destruction even on paths
        that never use the object and invite reading it uninitialised.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::string encrypt(const std::string& pw) {
            std::string result;
            if (pw.size() < 8) throw WeakPassword();
            result = cipher(pw);
            return result;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::string encrypt(const std::string& pw) {
            if (pw.size() < 8) throw WeakPassword();
            std::string result = cipher(pw);
            return result;
        }
        \\\
        ```
    languages: [cpp]
    tags: [implementations, initialization, scope]
    source: https://www.informit.com/store/effective-c-plus-plus-55-specific-ways-to-improve-your-9780321334879
