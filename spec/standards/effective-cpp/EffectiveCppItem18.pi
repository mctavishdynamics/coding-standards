use ../lib/CodingRule

from ./EffectiveCpp import EffectiveCpp

export coding-rule EffectiveCppItem18:
    standard: @{EffectiveCpp}
    ruleId: item-18
    title: Design interfaces that are hard to misuse
    statement:
        Shape an interface so the natural call is the correct one: use
        distinct types for distinct values, restrict operations, stay
        consistent with built-in types and return owning handles.
    rationale:
        Callers make mistakes; an interface that rejects the wrong usage at
        compile time prevents whole classes of bugs.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Date(int month, int day, int year);
        Date d(30, 3, 1995);   // compiles, wrong
        \\\
        ```
    compliant:
        ```cpp
        \\\
        Date(Month m, Day d, Year y);
        Date d(Month::march(), Day(30), Year(1995));
        \\\
        ```
    languages: [cpp]
    tags: [designs-and-declarations, interfaces, type-safety]
    source: https://www.informit.com/store/effective-c-plus-plus-55-specific-ways-to-improve-your-9780321334879
