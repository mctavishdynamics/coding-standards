use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopDebugging14:
    standard: @{PracticeOfProgramming}
    ruleId: debugging-14
    title: Visualize data to see what is wrong
    statement:
        Draw diagrams or plots of data structures and results to help
        understand a problem.
    rationale:
        Pictures expose patterns and anomalies that are invisible in columns
        of numbers.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [debugging, visualization]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
