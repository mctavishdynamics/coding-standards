use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopStyle3:
    standard: @{PracticeOfProgramming}
    ruleId: style-3
    title: Name functions after the action they perform
    statement:
        Give functions names built around a verb that says what they do. A
        function that returns a boolean should be named so its truth value
        is clear.
    rationale:
        An action name reads naturally at the call site and avoids doubts
        about what a call means.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        if (valid(port)) ...
        t = temperature();
        \\\
        ```
    compliant:
        ```c
        \\\
        if (is_port_open(port)) ...
        t = read_temperature();
        \\\
        ```
    languages: [any]
    tags: [style, naming, functions]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
