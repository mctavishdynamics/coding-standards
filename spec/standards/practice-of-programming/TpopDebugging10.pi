use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopDebugging10:
    standard: @{PracticeOfProgramming}
    ruleId: debugging-10
    title: Look for numeric patterns in failures
    statement:
        Note the sizes, counts and values involved when a program fails.
        Patterns such as powers of two or particular lengths are clues.
    rationale:
        A failure tied to a specific number often points at a buffer size,
        an off-by-one or a type limit.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [debugging]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
