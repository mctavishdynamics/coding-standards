use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopStyle4:
    standard: @{PracticeOfProgramming}
    ruleId: style-4
    title: Make names say exactly what the code does
    statement:
        Check that each name describes its object correctly. A name that
        suggests something else is worse than a vague one.
    rationale:
        Readers trust names. An inaccurate name sends them in the wrong
        direction.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        /* returns 1 when c is NOT a digit */
        int isdigit_char(char c) { return c < '0' || c > '9'; }
        \\\
        ```
    compliant:
        ```c
        \\\
        int is_non_digit(char c) { return c < '0' || c > '9'; }
        \\\
        ```
    languages: [any]
    tags: [style, naming]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
