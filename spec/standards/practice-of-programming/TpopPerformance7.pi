use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopPerformance7:
    standard: @{PracticeOfProgramming}
    ruleId: performance-7
    title: Make local improvements to the hot code
    statement:
        Once the algorithm is right, apply careful code-level tuning to the
        parts that profiling shows are expensive.
    rationale:
        Targeted changes in the hot spots can still yield real gains after
        the bigger choices are made.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [performance]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
