use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopPerformance8:
    standard: @{PracticeOfProgramming}
    ruleId: performance-8
    title: Leave fast-enough code alone
    statement:
        Do not optimize code whose speed does not affect the program's
        overall performance.
    rationale:
        Needless optimization adds complexity and bugs with no benefit to
        users.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [performance, simplicity]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
