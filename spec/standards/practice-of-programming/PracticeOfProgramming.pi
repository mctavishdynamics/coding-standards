export coding-standard PracticeOfProgramming:
    title: The Practice of Programming
    publisher: Brian W. Kernighan and Rob Pike, Addison-Wesley
    url: https://www.cs.princeton.edu/~bwk/tpop.webpage/
    version: 1st edition, 1999
    license: Copyright Lucent Technologies, all rights reserved. Items are paraphrased.
    description:
        The 95 collected rules from the appendix of Kernighan and Pike's book,
        covering style, interfaces, debugging, testing, performance and
        portability. Each rule is paraphrased with fresh examples, mostly in C.
