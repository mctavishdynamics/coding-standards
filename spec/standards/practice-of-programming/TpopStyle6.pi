use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopStyle6:
    standard: @{PracticeOfProgramming}
    ruleId: style-6
    title: Write conditions the way you would say them
    statement:
        Phrase expressions in their plain, positive form instead of a tangle
        of negations.
    rationale:
        A condition that reads like a sentence is quickly understood.
        Stacked negatives are easy to get backwards.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        if (!(temp <= LOW) && !(temp >= HIGH))
            in_range++;
        \\\
        ```
    compliant:
        ```c
        \\\
        if (temp > LOW && temp < HIGH)
            in_range++;
        \\\
        ```
    languages: [any]
    tags: [style, expressions, readability]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
