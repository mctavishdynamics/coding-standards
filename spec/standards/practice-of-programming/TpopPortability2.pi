use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopPortability2:
    standard: @{PracticeOfProgramming}
    ruleId: portability-2
    title: Use the well-established parts of the language
    statement:
        Stick to language features that are widely used and well understood,
        rather than obscure corners.
    rationale:
        Mainstream features are implemented consistently and correctly.
        Rarely used ones vary and break.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [portability]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
