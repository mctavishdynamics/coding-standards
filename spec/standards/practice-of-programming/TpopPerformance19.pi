use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopPerformance19:
    standard: @{PracticeOfProgramming}
    ruleId: performance-19
    title: Store data in the smallest type that fits
    statement:
        To save space, use the narrowest data type that can hold the values
        needed.
    rationale:
        Smaller types reduce memory use and can improve cache behavior for
        large data sets.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        struct pixel { int r, g, b; };
        \\\
        ```
    compliant:
        ```c
        \\\
        struct pixel { unsigned char r, g, b; };
        \\\
        ```
    languages: [any]
    tags: [performance, memory]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
