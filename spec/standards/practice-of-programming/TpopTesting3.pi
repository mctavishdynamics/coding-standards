use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopTesting3:
    standard: @{PracticeOfProgramming}
    ruleId: testing-3
    title: State assumptions with assertions
    statement:
        Use assert to record and check conditions that must be true at a
        point in the program.
    rationale:
        An assertion documents the assumption and stops the program at once
        when it is violated.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```c
        \\\
        #include <assert.h>

        void heap_push(Heap *h, int v)
        {
            assert(h->n < h->cap);
            h->a[h->n++] = v;
        }
        \\\
        ```
    languages: [any]
    tags: [testing, assertions]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
