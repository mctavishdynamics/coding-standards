use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopTesting9:
    standard: @{PracticeOfProgramming}
    ruleId: testing-9
    title: Check that quantities that should be preserved are
    statement:
        Test that properties which should not change, such as item counts or
        total sizes, are the same before and after processing.
    rationale:
        Conservation checks catch lost or duplicated data without needing to
        know every exact output value.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```sh
        \\\
        wc -c < input.txt
        ./compress < input.txt | ./expand | wc -c
        \\\
        ```
    languages: [any]
    tags: [testing, invariants]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
