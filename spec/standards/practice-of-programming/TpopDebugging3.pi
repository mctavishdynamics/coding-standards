use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopDebugging3:
    standard: @{PracticeOfProgramming}
    ruleId: debugging-3
    title: Learn from each bug so it does not recur
    statement:
        After fixing a bug, check whether you made the same mistake
        elsewhere, and take steps to avoid it in future.
    rationale:
        Programmers tend to repeat errors. Fixing all instances at once
        saves later debugging.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [debugging]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
