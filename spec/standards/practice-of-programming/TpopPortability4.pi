use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopPortability4:
    standard: @{PracticeOfProgramming}
    ruleId: portability-4
    title: Build with more than one compiler
    statement:
        Compile and test code with several compilers and on several systems.
    rationale:
        Each compiler catches different problems and exposes different
        assumptions.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```sh
        \\\
        gcc   -std=c11 -Wall -Wextra -c prog.c
        clang -std=c11 -Wall -Wextra -c prog.c
        \\\
        ```
    languages: [any]
    tags: [portability, tools]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
