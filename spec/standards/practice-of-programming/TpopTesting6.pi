use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopTesting6:
    standard: @{PracticeOfProgramming}
    ruleId: testing-6
    title: Test in small steps as code is built
    statement:
        Test each piece as it is written and before adding the next, rather
        than testing everything at the end.
    rationale:
        Problems found right after a small change are easy to locate.
        Testing late means sifting through many changes.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [testing, incremental]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
