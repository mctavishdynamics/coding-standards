use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopPortability6:
    standard: @{PracticeOfProgramming}
    ruleId: portability-6
    title: Limit yourself to features present everywhere
    statement:
        Use only the features that every target system provides.
    rationale:
        Writing to the common subset means the code runs everywhere without
        changes.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [portability]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
