use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopDebugging5:
    standard: @{PracticeOfProgramming}
    ruleId: debugging-5
    title: Use a stack trace to see where a crash happened
    statement:
        When a program crashes, get the call stack from a debugger or core
        dump to find where and how it failed.
    rationale:
        The trace shows the failing line and the arguments that led to it,
        which often identifies the bug at once.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```sh
        \\\
        gdb ./prog core
        (gdb) bt
        (gdb) print *p
        \\\
        ```
    languages: [any]
    tags: [debugging, tools]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
