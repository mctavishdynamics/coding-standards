use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopStyle18:
    standard: @{PracticeOfProgramming}
    ruleId: style-18
    title: Write characters as character literals
    statement:
        Compare and assign characters using quoted character constants or
        library tests, not their numeric codes.
    rationale:
        Character literals say what is meant and stay correct on systems
        with a different character set.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        if (ch == 32 || ch == 9)
            blanks++;
        \\\
        ```
    compliant:
        ```c
        \\\
        if (ch == ' ' || ch == '\t')
            blanks++;
        \\\
        ```
    languages: [any]
    tags: [style, constants, portability]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
