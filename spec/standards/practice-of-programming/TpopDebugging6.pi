use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopDebugging6:
    standard: @{PracticeOfProgramming}
    ruleId: debugging-6
    title: Study the code before changing it
    statement:
        Read the code carefully and think about what it does before you
        start editing to fix a bug.
    rationale:
        Hasty edits can introduce new bugs and hide the real cause. Thinking
        first is often faster.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [debugging]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
