use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopDebugging11:
    standard: @{PracticeOfProgramming}
    ruleId: debugging-11
    title: Print output to narrow down the location
    statement:
        Add output statements at key points to see how far the program gets
        and what values it has.
    rationale:
        Well-placed prints quickly show where behavior first goes wrong.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```c
        \\\
        fprintf(stderr, "parse: tok=%d line=%d depth=%d\n", tok, line, depth);
        \\\
        ```
    languages: [any]
    tags: [debugging, logging]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
