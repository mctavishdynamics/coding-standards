use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopTesting8:
    standard: @{PracticeOfProgramming}
    ruleId: testing-8
    title: Decide the expected output before testing
    statement:
        Know what the correct result is for each test, so you can tell
        whether the program passed.
    rationale:
        A test without a known right answer cannot detect a wrong one.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```sh
        \\\
        printf 'b\na\nc\n' | ./mysort > got
        printf 'a\nb\nc\n' > want
        cmp got want
        \\\
        ```
    languages: [any]
    tags: [testing, oracles]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
