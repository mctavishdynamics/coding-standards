use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopPortability13:
    standard: @{PracticeOfProgramming}
    ruleId: portability-13
    title: Keep existing programs and data working
    statement:
        When upgrading software, make sure older programs and data files
        still work with it.
    rationale:
        Users depend on what they already have. Breaking it makes upgrades
        costly and unpopular.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [portability, compatibility]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
