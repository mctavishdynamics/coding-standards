use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopTesting7:
    standard: @{PracticeOfProgramming}
    ruleId: testing-7
    title: Start testing with the simplest parts
    statement:
        Test the most basic features first, and move on to complicated ones
        only when the basics are known to work.
    rationale:
        Failures in simple parts would muddy every later test. Building
        confidence step by step localizes problems.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [testing]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
