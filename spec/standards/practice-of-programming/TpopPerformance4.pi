use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopPerformance4:
    standard: @{PracticeOfProgramming}
    ruleId: performance-4
    title: Chart performance to understand it
    statement:
        Plot measurements such as time against input size to reveal how the
        program behaves.
    rationale:
        A graph shows growth rates and anomalies much more clearly than a
        table of numbers.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [performance, visualization]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
