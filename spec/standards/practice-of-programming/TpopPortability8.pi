use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopPortability8:
    standard: @{PracticeOfProgramming}
    ruleId: portability-8
    title: Gather system-dependent code into its own files
    statement:
        Put code that depends on a particular system in separate source
        files, one per platform.
    rationale:
        Isolating the differences keeps the main code clean and shows
        exactly what must change for a new system.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```sh
        \\\
        src/core.c
        src/sys_unix.c
        src/sys_win.c
        \\\
        ```
    languages: [any]
    tags: [portability, modularity]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
