use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopDebugging16:
    standard: @{PracticeOfProgramming}
    ruleId: debugging-16
    title: Write down what you tried and found
    statement:
        Keep notes during debugging of what you tested, what happened and
        what you ruled out.
    rationale:
        Records stop you repeating experiments and help you recognize the
        bug if it comes back.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [debugging]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
