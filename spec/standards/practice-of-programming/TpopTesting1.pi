use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopTesting1:
    standard: @{PracticeOfProgramming}
    ruleId: testing-1
    title: Test the edges of every condition and loop
    statement:
        Exercise code at the boundaries of its loops and conditions, such as
        empty input, one item and exactly full.
    rationale:
        Most bugs live at boundaries. Checking them right after writing the
        code catches errors early.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```c
        \\\
        assert(count_words("") == 0);
        assert(count_words("a") == 1);
        assert(count_words("a b") == 2);
        assert(count_words("  ") == 0);
        \\\
        ```
    languages: [any]
    tags: [testing, edge-cases]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
