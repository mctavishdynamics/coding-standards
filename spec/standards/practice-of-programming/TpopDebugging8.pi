use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopDebugging8:
    standard: @{PracticeOfProgramming}
    ruleId: debugging-8
    title: Find a way to trigger the bug on demand
    statement:
        Before trying to fix a bug, work out a reliable way to make it
        happen.
    rationale:
        A reproducible failure can be studied and the fix can be confirmed.
        A random one cannot.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [debugging, reproducibility]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
