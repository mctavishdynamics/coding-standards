use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopStyle24:
    standard: @{PracticeOfProgramming}
    ruleId: style-24
    title: Make comments help, never mislead
    statement:
        Use comments to make hard parts easier to understand, and make sure
        they do not add confusion of their own.
    rationale:
        A comment is meant to help the reader. One that is longer or harder
        than the code it describes defeats its purpose.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [style, comments, clarity]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
