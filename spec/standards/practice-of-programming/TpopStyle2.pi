use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopStyle2:
    standard: @{PracticeOfProgramming}
    ruleId: style-2
    title: Follow one naming scheme throughout
    statement:
        Name related things in related ways, and use the same conventions
        across a program.
    rationale:
        Consistent names let readers predict what something is called and
        spot what belongs together.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        struct queue {
            int queue_capacity;
            int nItems;
            int *Q_data;
        };
        \\\
        ```
    compliant:
        ```c
        \\\
        struct queue {
            int capacity;
            int count;
            int *items;
        };
        \\\
        ```
    languages: [any]
    tags: [style, naming, consistency]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
