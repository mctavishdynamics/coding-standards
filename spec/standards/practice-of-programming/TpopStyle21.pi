use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopStyle21:
    standard: @{PracticeOfProgramming}
    ruleId: style-21
    title: Describe each function and global variable in a comment
    statement:
        Put a short comment on each function and each global variable saying
        what it is for and anything non-obvious about it.
    rationale:
        These are the entry points a reader meets first, and a brief note
        saves them from reading the whole body.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        int lookup(char *s, int create);
        \\\
        ```
    compliant:
        ```c
        \\\
        /* lookup: find s in the symbol table; add it if create is set.
           Returns the entry index, or -1 if absent and not created. */
        int lookup(char *s, int create);
        \\\
        ```
    languages: [any]
    tags: [style, comments, documentation]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
