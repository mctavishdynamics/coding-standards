use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopDebugging15:
    standard: @{PracticeOfProgramming}
    ruleId: debugging-15
    title: Put tools to work on the search
    statement:
        Use tools such as diff, grep, debuggers, memory checkers and small
        scripts to examine programs and output.
    rationale:
        Tools do mechanical comparison and searching faster and more
        reliably than people.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```sh
        \\\
        ./prog < case.in > got.out
        diff expected.out got.out
        valgrind --leak-check=full ./prog < case.in
        \\\
        ```
    languages: [any]
    tags: [debugging, tools]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
