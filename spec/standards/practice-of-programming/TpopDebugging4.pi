use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopDebugging4:
    standard: @{PracticeOfProgramming}
    ruleId: debugging-4
    title: Fix bugs as soon as you see them
    statement:
        Investigate a failure when it first appears instead of putting it
        off.
    rationale:
        A bug seen once and ignored tends to resurface later, at a worse
        time and with fewer clues.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [debugging]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
