use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopStyle20:
    standard: @{PracticeOfProgramming}
    ruleId: style-20
    title: Skip comments that restate the obvious
    statement:
        Do not comment on things any reader can see from the code itself.
    rationale:
        Comments that repeat the code waste the reader's time and become
        wrong as the code changes.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        /* close the file */
        fclose(fp);

        retries = 0;   /* set retries to zero */
        \\\
        ```
    compliant:
        ```c
        \\\
        fclose(fp);

        retries = 0;
        \\\
        ```
    languages: [any]
    tags: [style, comments]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
