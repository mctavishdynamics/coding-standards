use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopStyle11:
    standard: @{PracticeOfProgramming}
    ruleId: style-11
    title: Pick one indentation and brace style and keep it
    statement:
        Choose a layout for blocks and braces and apply it everywhere in a
        program. When editing someone else's code, keep their style.
    rationale:
        The particular style matters less than its steady use. Mixed styles
        make code look broken and distract from content.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        if (a) {
          f();
        }
        else
        {
                g();
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        if (a) {
            f();
        } else {
            g();
        }
        \\\
        ```
    languages: [any]
    tags: [style, formatting, consistency]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
