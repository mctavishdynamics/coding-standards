use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopPerformance18:
    standard: @{PracticeOfProgramming}
    ruleId: performance-18
    title: Drop to a lower-level language for critical code
    statement:
        As a last resort, rewrite a small, critical piece of code in a
        lower-level language.
    rationale:
        Lower-level code can be faster, though it costs portability and
        clarity, so keep it to the essential part.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [performance]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
