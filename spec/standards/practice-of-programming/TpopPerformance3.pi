use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopPerformance3:
    standard: @{PracticeOfProgramming}
    ruleId: performance-3
    title: Optimize only the code that dominates run time
    statement:
        Spend tuning effort on the small part of the program where most of
        the time goes.
    rationale:
        Speeding up code that runs rarely makes no visible difference. The
        hot spots are where gains come from.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [performance]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
