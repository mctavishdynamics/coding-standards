use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopDebugging13:
    standard: @{PracticeOfProgramming}
    ruleId: debugging-13
    title: Record program activity in a log
    statement:
        Have the program write a log of what it does, so the history leading
        up to a failure can be examined.
    rationale:
        Logs reveal what happened in long-running or remote programs where a
        debugger cannot be attached.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```c
        \\\
        fprintf(logfp, "%ld accept fd=%d from %s\n", (long)time(NULL), fd, addr);
        fflush(logfp);
        \\\
        ```
    languages: [any]
    tags: [debugging, logging]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
