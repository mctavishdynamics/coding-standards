use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopStyle5:
    standard: @{PracticeOfProgramming}
    ruleId: style-5
    title: Let indentation show how code is nested
    statement:
        Indent consistently so the shape of the code on the page matches its
        logical structure.
    rationale:
        Readers see structure from layout first. Indentation that disagrees
        with the code hides bugs.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        while (p != NULL) { total += p->size;
        p = p->next; } count_done = 1;
          return total;
        \\\
        ```
    compliant:
        ```c
        \\\
        while (p != NULL) {
            total += p->size;
            p = p->next;
        }
        count_done = 1;
        return total;
        \\\
        ```
    languages: [any]
    tags: [style, formatting, indentation]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
