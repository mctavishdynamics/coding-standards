use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopPerformance17:
    standard: @{PracticeOfProgramming}
    ruleId: performance-17
    title: Accept approximations when exact answers are not needed
    statement:
        If full precision is not required, use cheaper approximate
        computations or lower-precision types.
    rationale:
        Approximations can save a lot of time and space when the application
        tolerates them.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [performance, precision]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
