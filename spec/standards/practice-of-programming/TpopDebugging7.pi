use ../lib/CodingRule

from ./PracticeOfProgramming import PracticeOfProgramming

export coding-rule TpopDebugging7:
    standard: @{PracticeOfProgramming}
    ruleId: debugging-7
    title: Describe the code aloud to another person
    statement:
        Walk someone else through the code, line by line, and explain what
        it should do.
    rationale:
        Explaining forces you to state your assumptions, and the error often
        becomes obvious while you speak.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [debugging, code-review]
    source: https://www.cs.princeton.edu/~bwk/tpop.webpage/
