use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12EndWithSingleNewline:
    standard: @{Psr12}
    ruleId: 2.2b
    title: End each file with exactly one line feed
    statement:
        Make the last line of a PHP file a non-blank line followed by a
        single line feed, with no blank lines after it.
    rationale:
        A consistent file ending keeps diffs clean and avoids accidental
        output of trailing whitespace.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [php]
    tags: [files, whitespace]
    source: https://www.php-fig.org/psr/psr-12/#22-files
