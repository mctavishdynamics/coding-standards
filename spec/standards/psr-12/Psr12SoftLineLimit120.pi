use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12SoftLineLimit120:
    standard: @{Psr12}
    ruleId: 2.3b
    title: Set the soft line length limit at 120 characters
    statement:
        Use 120 characters as the soft limit. Style checkers may warn about
        lines beyond it, but must not treat them as errors.
    rationale:
        A shared warning threshold flags lines that have grown too long
        without blocking the rare justified case.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [php]
    tags: [formatting, line-length]
    source: https://www.php-fig.org/psr/psr-12/#23-lines
