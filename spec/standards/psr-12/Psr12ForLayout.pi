use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12ForLayout:
    standard: @{Psr12}
    ruleId: 5.4a
    title: Lay out for loops with the standard spacing
    statement:
        Write a for loop with one space after the keyword, a space after
        each semicolon inside the parentheses, and the opening brace on the
        same line after one space.
    rationale:
        Uniform spacing makes the three loop clauses easy to tell apart.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        for($i=0;$i<$count;$i++){
            echo $items[$i];
        }
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        for ($i = 0; $i < $count; $i++) {
            echo $items[$i];
        }
        \\\
        ```
    languages: [php]
    tags: [control-structures, loops]
    source: https://www.php-fig.org/psr/psr-12/#54-for
