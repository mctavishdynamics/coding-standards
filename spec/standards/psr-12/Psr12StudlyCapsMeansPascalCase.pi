use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12StudlyCapsMeansPascalCase:
    standard: @{Psr12}
    ruleId: 2.1b
    title: Read StudlyCaps as PascalCase
    statement:
        Interpret the PSR-1 term StudlyCaps as PascalCase, where every word
        starts with a capital letter, the first word included.
    rationale:
        StudlyCaps was loosely defined; pinning it to PascalCase removes
        doubt about names such as those with consecutive capitals.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        class paymentGateway
        {
        }
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        class PaymentGateway
        {
        }
        \\\
        ```
    languages: [php]
    tags: [naming, classes]
    source: https://www.php-fig.org/psr/psr-12/#21-basic-coding-standard
