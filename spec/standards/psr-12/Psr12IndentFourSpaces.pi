use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12IndentFourSpaces:
    standard: @{Psr12}
    ruleId: 2.4
    title: Indent with four spaces and never with tabs
    statement:
        Use four spaces for each level of indentation. Do not use tab
        characters to indent.
    rationale:
        Spaces render the same in every editor and diff, and avoid the
        alignment problems that come from mixing tabs and spaces.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        function isAdult(int $age): bool
        {
          return $age >= 18;
        }
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        function isAdult(int $age): bool
        {
            return $age >= 18;
        }
        \\\
        ```
    languages: [php]
    tags: [formatting, indentation]
    source: https://www.php-fig.org/psr/psr-12/#24-indenting
