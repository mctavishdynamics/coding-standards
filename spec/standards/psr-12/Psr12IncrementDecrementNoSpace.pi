use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12IncrementDecrementNoSpace:
    standard: @{Psr12}
    ruleId: 6.1a
    title:
        Write increment and decrement operators against their operand
    statement:
        Put no space between an increment or decrement operator and its
        operand.
    rationale:
        A space makes it unclear which variable the operator applies to.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        $retries ++;
        -- $remaining;
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        $retries++;
        --$remaining;
        \\\
        ```
    languages: [php]
    tags: [operators, whitespace]
    source: https://www.php-fig.org/psr/psr-12/#61-unary-operators
