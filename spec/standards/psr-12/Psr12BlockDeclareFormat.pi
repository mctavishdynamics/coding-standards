use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12BlockDeclareFormat:
    standard: @{Psr12}
    ruleId: 3h
    title: Format block declare statements like control structures
    statement:
        A declare statement with a block body is allowed. Put the opening
        brace on the declare line after one space, indent the body once and
        put the closing brace on its own line.
    rationale:
        Formatting block declares like other braced structures keeps the
        file layout consistent.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        declare(ticks=1)
        {
        runJobs();
        }
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        declare(ticks=1) {
            runJobs();
        }
        \\\
        ```
    languages: [php]
    tags: [declare, braces]
    source: https://www.php-fig.org/psr/psr-12/#3-declare-statements-namespace-and-import-statements
