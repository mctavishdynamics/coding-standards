use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12WhileLayout:
    standard: @{Psr12}
    ruleId: 5.3a
    title: Lay out while loops with the standard spacing
    statement:
        Write a while loop with one space after the keyword, no spaces just
        inside the parentheses, the opening brace on the same line after one
        space, and the body indented once.
    rationale:
        Loops then share the same shape as every other control structure.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        while($line = fgets($handle))
        {
            process($line);
        }
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        while ($line = fgets($handle)) {
            process($line);
        }
        \\\
        ```
    languages: [php]
    tags: [control-structures, loops]
    source: https://www.php-fig.org/psr/psr-12/#53-while-do-while
