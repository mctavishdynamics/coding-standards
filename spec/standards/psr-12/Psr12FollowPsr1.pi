use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12FollowPsr1:
    standard: @{Psr12}
    ruleId: 2.1a
    title: Follow every PSR-1 rule
    statement:
        Code that claims PSR-12 compliance must also meet all the rules of
        PSR-1, the basic coding standard.
    rationale:
        PSR-12 builds on PSR-1 rather than repeating it, so the two together
        form the full style.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [php]
    tags: [compliance]
    source: https://www.php-fig.org/psr/psr-12/#21-basic-coding-standard
