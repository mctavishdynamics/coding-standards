use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12NoTrailingWhitespace:
    standard: @{Psr12}
    ruleId: 2.3d
    title: Remove trailing whitespace
    statement:
        Strip any spaces or tabs that follow the last visible character of a
        line.
    rationale:
        Invisible trailing characters create meaningless diff changes and
        can upset tools.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [php]
    tags: [formatting, whitespace]
    source: https://www.php-fig.org/psr/psr-12/#23-lines
