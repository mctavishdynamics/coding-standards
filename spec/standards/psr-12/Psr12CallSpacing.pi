use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12CallSpacing:
    standard: @{Psr12}
    ruleId: 4.7a
    title: Space function calls without gaps around parentheses
    statement:
        In a function or method call put no space between the name and the
        opening parenthesis, none just inside the parentheses, none before a
        comma, and one space after each comma.
    rationale:
        Calls written the same way are quicker to read and to search for.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        $user = $repository->find ( $id,true );
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        $user = $repository->find($id, true);
        \\\
        ```
    languages: [php]
    tags: [functions, whitespace]
    source: https://www.php-fig.org/psr/psr-12/#47-method-and-function-calls
