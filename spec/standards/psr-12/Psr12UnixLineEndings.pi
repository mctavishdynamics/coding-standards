use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12UnixLineEndings:
    standard: @{Psr12}
    ruleId: 2.2a
    title: Use only LF line endings
    statement:
        End every line of a PHP file with a Unix line feed, never with a
        carriage return or a CRLF pair.
    rationale:
        Mixed line endings produce noisy diffs and can leak stray characters
        into output.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [php]
    tags: [files, line-endings]
    source: https://www.php-fig.org/psr/psr-12/#22-files
