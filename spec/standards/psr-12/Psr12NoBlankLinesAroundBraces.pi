use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12NoBlankLinesAroundBraces:
    standard: @{Psr12}
    ruleId: 4.1c
    title: Do not pad braces with blank lines
    statement:
        Opening braces sit on their own line with no blank line before or
        after them, and closing braces sit on their own line with no blank
        line before them.
    rationale:
        Blank lines next to braces waste space and add nothing to the
        structure.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        class Mailer

        {

            private $transport;

        }
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        class Mailer
        {
            private $transport;
        }
        \\\
        ```
    languages: [php]
    tags: [braces, whitespace]
    source: https://www.php-fig.org/psr/psr-12/#41-extends-and-implements
