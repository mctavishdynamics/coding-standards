use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12ExtendsImplementsSameLine:
    standard: @{Psr12}
    ruleId: 4.1a
    title: Keep extends and implements on the class name line
    statement:
        Keep the extends and implements clauses on the line that names the
        class, rather than moving them down.
    rationale:
        Having the full class signature on one line makes the inheritance
        visible at a glance.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        class AdminUser
            extends User
        {
        }
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        class AdminUser extends User
        {
        }
        \\\
        ```
    languages: [php]
    tags: [classes, formatting]
    source: https://www.php-fig.org/psr/psr-12/#41-extends-and-implements
