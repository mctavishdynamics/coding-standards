use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12BinaryOperatorSpacing:
    standard: @{Psr12}
    ruleId: 6.2
    title: Surround binary operators with spaces
    statement:
        Surround each binary or ternary operator with at least one space on
        both sides. That covers arithmetic, assignment, comparison, logical,
        bitwise, string concatenation and type operators alike.
    rationale:
        Spaces around operators separate the operands and make expressions
        easier to read.
    exceptions:
        More than one space may be used where spaces are allowed, for
        example to align assignments.
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        $total=$price*$quantity+$shipping;
        $label=$prefix.$name;
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        $total = $price * $quantity + $shipping;
        $label = $prefix . $name;
        \\\
        ```
    languages: [php]
    tags: [operators, whitespace]
    source: https://www.php-fig.org/psr/psr-12/#62-binary-operators
