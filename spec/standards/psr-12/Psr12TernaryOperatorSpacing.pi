use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12TernaryOperatorSpacing:
    standard: @{Psr12}
    ruleId: 6.3a
    title: Surround both parts of the ternary operator with spaces
    statement:
        Put at least one space before and after both the question mark and
        the colon of the conditional operator.
    rationale:
        Spacing makes the three operands of a ternary easy to tell apart.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        $label = $count===1?'item':'items';
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        $label = $count === 1 ? 'item' : 'items';
        \\\
        ```
    languages: [php]
    tags: [operators, whitespace]
    source: https://www.php-fig.org/psr/psr-12/#63-ternary-operators
