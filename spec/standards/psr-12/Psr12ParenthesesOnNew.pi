use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12ParenthesesOnNew:
    standard: @{Psr12}
    ruleId: 4b
    title: Always use parentheses when instantiating a class
    statement:
        Write parentheses after the class name in a new expression, even
        when the constructor takes no arguments.
    rationale:
        Consistent parentheses make every instantiation look the same and
        make it easy to add arguments later.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        $cart = new Cart;
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        $cart = new Cart();
        \\\
        ```
    languages: [php]
    tags: [classes, formatting]
    source: https://www.php-fig.org/psr/psr-12/#4-classes-properties-and-methods
