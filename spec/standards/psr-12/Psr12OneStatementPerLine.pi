use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12OneStatementPerLine:
    standard: @{Psr12}
    ruleId: 2.3e
    title: Put one statement on each line
    statement:
        End each line after its statement; do not chain several statements
        on one line.
    rationale:
        One statement per line makes code easier to read, to step through in
        a debugger and to change in a diff.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        $count = 0; $limit = 10; $offset = 5;
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        $count = 0;
        $limit = 10;
        $offset = 5;
        \\\
        ```
    languages: [php]
    tags: [formatting, statements]
    source: https://www.php-fig.org/psr/psr-12/#23-lines
