use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12NoHardLineLimit:
    standard: @{Psr12}
    ruleId: 2.3a
    title: Do not impose a hard line length limit
    statement:
        Never enforce a maximum line length that rejects code outright; a
        long line on its own is not a violation.
    rationale:
        Some lines, such as long strings or URLs, cannot be split sensibly,
        so a hard cap would force worse code.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [php]
    tags: [formatting, line-length]
    source: https://www.php-fig.org/psr/psr-12/#23-lines
