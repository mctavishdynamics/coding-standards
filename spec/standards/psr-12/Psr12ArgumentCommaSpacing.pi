use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12ArgumentCommaSpacing:
    standard: @{Psr12}
    ruleId: 4.5a
    title: Space parameter lists after commas only
    statement:
        In a parameter list put no space before a comma and exactly one
        space after it.
    rationale:
        Uniform comma spacing makes parameter lists easy to scan.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        function move(int $x ,int $y,  int $z)
        {
        }
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        function move(int $x, int $y, int $z)
        {
        }
        \\\
        ```
    languages: [php]
    tags: [functions, whitespace]
    source: https://www.php-fig.org/psr/psr-12/#45-method-and-function-arguments
