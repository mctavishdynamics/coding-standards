from ./Psr12ParenthesesOnNew import Psr12ParenthesesOnNew
from ./Psr12PreferEightyColumns import Psr12PreferEightyColumns
from ./Psr12PreferElseif import Psr12PreferElseif
from ./Psr12PropertyVisibility import Psr12PropertyVisibility
from ./Psr12ReferenceOperatorNoSpace import Psr12ReferenceOperatorNoSpace
from ./Psr12ReferenceVariadicNoSpace import Psr12ReferenceVariadicNoSpace
