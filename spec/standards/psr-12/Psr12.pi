from ./Psr12TryCatchLayout import Psr12TryCatchLayout
from ./Psr12UnixLineEndings import Psr12UnixLineEndings
from ./Psr12VariadicNoSpace import Psr12VariadicNoSpace
from ./Psr12WhileLayout import Psr12WhileLayout
from ./Psr12WhileSplitCondition import Psr12WhileSplitCondition
from ./Psr12WrappedSignatureClosing import Psr12WrappedSignatureClosing

export coding-standard Psr12:
    title: PSR-12 - Extended Coding Style
    publisher: PHP Framework Interop Group
    url: https://www.php-fig.org/psr/psr-12/
    version: null
    license: Content CC BY 3.0 Unported; code MIT (php-fig/fig-standards LICENSE.md)
    description:
        The PHP-FIG extended coding style, which replaces PSR-2 and builds
        on PSR-1. It fixes the layout of files, declarations, classes,
        functions, control structures, operators, closures and anonymous
        classes.
    rules:
        - @{Psr12FollowPsr1}
        - @{Psr12StudlyCapsMeansPascalCase}
        - @{Psr12UnixLineEndings}
        - @{Psr12EndWithSingleNewline}
        - @{Psr12OmitClosingTag}
        - @{Psr12NoHardLineLimit}
        - @{Psr12SoftLineLimit120}
        - @{Psr12PreferEightyColumns}
        - @{Psr12NoTrailingWhitespace}
        - @{Psr12OneStatementPerLine}
        - @{Psr12IndentFourSpaces}
        - @{Psr12KeywordsLowerCase}
        - @{Psr12ShortTypeKeywords}
        - @{Psr12FileHeaderBlocks}
        - @{Psr12HeaderAtTopInMixedFiles}
        - @{Psr12OpeningTagOwnLine}
        - @{Psr12NoLeadingBackslashImport}
        - @{Psr12CompoundNamespaceDepth}
        - @{Psr12StrictTypesInMarkupFiles}
        - @{Psr12DeclareStatementFormat}
        - @{Psr12BlockDeclareFormat}
        - @{Psr12NothingAfterClosingBrace}
        - @{Psr12ParenthesesOnNew}
        - @{Psr12ExtendsImplementsSameLine}
        - @{Psr12ClassBracePlacement}
        - @{Psr12NoBlankLinesAroundBraces}
        - @{Psr12MultilineImplementsList}
        - @{Psr12TraitUseAfterOpeningBrace}
        - @{Psr12OneTraitPerUse}
        - @{Psr12SpacingAfterTraitUse}
        - @{Psr12TraitConflictResolution}
        - @{Psr12PropertyVisibility}
        - @{Psr12ConstantVisibility}
        - @{Psr12NoVarKeyword}
        - @{Psr12OnePropertyPerStatement}
        - @{Psr12NoUnderscorePrefixProperty}
        - @{Psr12SpaceBetweenTypeAndProperty}
        - @{Psr12MethodVisibility}
        - @{Psr12NoUnderscorePrefixMethod}
        - @{Psr12FunctionDeclarationLayout}
        - @{Psr12ArgumentCommaSpacing}
        - @{Psr12DefaultArgumentsLast}
        - @{Psr12MultilineParameterList}
        - @{Psr12WrappedSignatureClosing}
        - @{Psr12ReturnTypeSpacing}
        - @{Psr12NullableTypeNoSpace}
        - @{Psr12ReferenceOperatorNoSpace}
        - @{Psr12VariadicNoSpace}
        - @{Psr12ReferenceVariadicNoSpace}
        - @{Psr12AbstractFinalBeforeVisibility}
        - @{Psr12StaticAfterVisibility}
        - @{Psr12CallSpacing}
        - @{Psr12MultilineCallArguments}
        - @{Psr12ControlStructureSpacing}
        - @{Psr12ControlStructureBraces}
        - @{Psr12IfElseLayout}
        - @{Psr12PreferElseif}
        - @{Psr12IfSplitCondition}
        - @{Psr12SwitchCaseIndentation}
        - @{Psr12SwitchFallThroughComment}
        - @{Psr12SwitchSplitCondition}
        - @{Psr12WhileLayout}
        - @{Psr12WhileSplitCondition}
        - @{Psr12DoWhileLayout}
        - @{Psr12DoWhileSplitCondition}
        - @{Psr12ForLayout}
        - @{Psr12ForSplitExpressions}
        - @{Psr12ForeachLayout}
        - @{Psr12TryCatchLayout}
        - @{Psr12IncrementDecrementNoSpace}
        - @{Psr12CastNoInnerSpace}
        - @{Psr12BinaryOperatorSpacing}
        - @{Psr12TernaryOperatorSpacing}
        - @{Psr12ShortTernarySpacing}
        - @{Psr12ClosureKeywordSpacing}
        - @{Psr12ClosureBracePlacement}
        - @{Psr12ClosureParenthesisSpacing}
        - @{Psr12ClosureCommaSpacing}
        - @{Psr12ClosureDefaultsLast}
        - @{Psr12ClosureReturnType}
        - @{Psr12ClosureMultilineLists}
        - @{Psr12ClosureWrappedClosing}
        - @{Psr12AnonymousClassFollowsClosures}
        - @{Psr12AnonymousClassBrace}
