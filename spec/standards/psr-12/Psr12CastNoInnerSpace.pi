use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12CastNoInnerSpace:
    standard: @{Psr12}
    ruleId: 6.1b
    title: Write type casts without spaces inside the parentheses
    statement:
        Put no spaces inside the parentheses of a type cast operator.
    rationale:
        A tight cast is easy to recognise as a single operator.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        $limit = ( int ) $query['limit'];
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        $limit = (int) $query['limit'];
        \\\
        ```
    languages: [php]
    tags: [operators, types, whitespace]
    source: https://www.php-fig.org/psr/psr-12/#61-unary-operators
