use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12ShortTypeKeywords:
    standard: @{Psr12}
    ruleId: 2.5b
    title: Use the short forms of type keywords
    statement:
        Write type keywords in their short form, such as bool rather than
        boolean and int rather than integer.
    rationale:
        The long forms are not valid type declarations in PHP and would be
        read as class names, so the short forms are both correct and
        consistent.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        $isActive = (boolean) $row['active'];
        $quantity = (integer) $row['quantity'];
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        $isActive = (bool) $row['active'];
        $quantity = (int) $row['quantity'];
        \\\
        ```
    languages: [php]
    tags: [types, keywords]
    source: https://www.php-fig.org/psr/psr-12/#25-keywords-and-types
