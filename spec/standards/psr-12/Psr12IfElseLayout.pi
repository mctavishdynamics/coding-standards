use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12IfElseLayout:
    standard: @{Psr12}
    ruleId: 5.1a
    title: Put else and elseif on the closing brace line
    statement:
        Use the usual control-structure spacing for if statements. The else
        and elseif keywords follow the brace that ends the preceding branch,
        on that brace's line.
    rationale:
        Keeping the branches joined to the braces shows the chain as one
        structure.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        if ($score > 90) {
            $grade = 'A';
        }
        else {
            $grade = 'B';
        }
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        if ($score > 90) {
            $grade = 'A';
        } else {
            $grade = 'B';
        }
        \\\
        ```
    languages: [php]
    tags: [control-structures, formatting]
    source: https://www.php-fig.org/psr/psr-12/#51-if-elseif-else
