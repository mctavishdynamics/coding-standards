use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12DeclareStatementFormat:
    standard: @{Psr12}
    ruleId: 3g
    title: Write the strict types declaration with no spaces
    statement:
        Write the declare statement exactly as declare(strict_types=1), with
        no spaces anywhere in it. A terminating semicolon is optional.
    rationale:
        One exact spelling makes the declaration easy to search for and to
        check by tools.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php

        declare( strict_types = 1 );
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php

        declare(strict_types=1);
        \\\
        ```
    languages: [php]
    tags: [declare, formatting]
    source: https://www.php-fig.org/psr/psr-12/#3-declare-statements-namespace-and-import-statements
