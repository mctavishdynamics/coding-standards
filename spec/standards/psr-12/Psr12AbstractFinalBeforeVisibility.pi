use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12AbstractFinalBeforeVisibility:
    standard: @{Psr12}
    ruleId: 4.6a
    title: Put abstract and final before the visibility keyword
    statement:
        When a declaration is abstract or final, write that keyword before
        its visibility keyword.
    rationale:
        A fixed modifier order makes declarations look the same everywhere.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        abstract class Shape
        {
            public abstract function area(): float;
        }
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        abstract class Shape
        {
            abstract public function area(): float;
        }
        \\\
        ```
    languages: [php]
    tags: [modifiers, visibility]
    source: https://www.php-fig.org/psr/psr-12/#46-abstract-final-and-static
