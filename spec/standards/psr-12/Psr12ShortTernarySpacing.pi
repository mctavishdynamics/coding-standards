use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12ShortTernarySpacing:
    standard: @{Psr12}
    ruleId: 6.3b
    title: Space the short ternary like a comparison operator
    statement:
        In the short ternary form, where the operand between the question
        mark and colon is omitted, space the joined operator as you would a
        binary comparison, with one space before and after it.
    rationale:
        The short form is a single operator, so it follows the binary
        operator rule.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        $name = $input['name']?:'guest';
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        $name = $input['name'] ?: 'guest';
        \\\
        ```
    languages: [php]
    tags: [operators, whitespace]
    source: https://www.php-fig.org/psr/psr-12/#63-ternary-operators
