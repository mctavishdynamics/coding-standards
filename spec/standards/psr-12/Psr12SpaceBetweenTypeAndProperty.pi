use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12SpaceBetweenTypeAndProperty:
    standard: @{Psr12}
    ruleId: 4.3f
    title: Separate a property type from its name with a space
    statement:
        Put a space between the type declaration of a property and the
        property name.
    rationale:
        The space keeps typed properties readable and consistent with
        parameter declarations.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        class Order
        {
            private int$quantity = 1;
        }
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        class Order
        {
            private int $quantity = 1;
        }
        \\\
        ```
    languages: [php]
    tags: [properties, types, whitespace]
    source: https://www.php-fig.org/psr/psr-12/#43-properties-and-constants
