use ../lib/CodingRule

from ./Psr12 import Psr12

export coding-rule Psr12ClassBracePlacement:
    standard: @{Psr12}
    ruleId: 4.1b
    title: Put class braces on their own lines
    statement:
        Put the opening brace of a class on its own line after the
        declaration, and the closing brace on its own line right after the
        body.
    rationale:
        Class braces on separate lines visually set the class body apart
        from its signature.
    exceptions: null
    severity: null
    noncompliant:
        ```php
        \\\
        <?php
        class Mailer {
            private $transport; }
        \\\
        ```
    compliant:
        ```php
        \\\
        <?php
        class Mailer
        {
            private $transport;
        }
        \\\
        ```
    languages: [php]
    tags: [classes, braces]
    source: https://www.php-fig.org/psr/psr-12/#41-extends-and-implements
