use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule40:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-40
    title: Use one consistent method for detecting end of input
    statement:
        Detect and respond to end of input in one consistent way throughout
        the program.
    rationale:
        If each read handles end of file differently, some paths will miss
        it and loop forever or read stale data.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [input-and-output, input]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
