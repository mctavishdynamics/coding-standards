use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule47:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-47
    title: Give each variable a value before first use
    statement:
        Give each variable a value before its first use.
    rationale:
        An uninitialized variable holds whatever was left in memory, so the
        program may work in tests and fail elsewhere.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        int sum;
        for (int i = 0; i < n; i++) {
            sum += a[i];
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        int sum = 0;
        for (int i = 0; i < n; i++) {
            sum += a[i];
        }
        \\\
        ```
    languages: [any]
    tags: [common-blunders, initialization]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
