use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule31:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-31
    title: Have every module conceal a design decision
    statement:
        Each module should keep some detail, such as a data format or an
        algorithm, private behind its interface.
    rationale:
        A module that hides nothing gives no protection. Hiding a decision
        lets it change without touching the callers.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [program-structure, modularity, information-hiding]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
