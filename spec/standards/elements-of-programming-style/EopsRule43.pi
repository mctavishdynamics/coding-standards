use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule43:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-43
    title: Design input that a person can check easily
    statement:
        Lay out input so that a human reading it can spot errors, for
        example by spacing fields and avoiding long runs of digits.
    rationale:
        Most input errors are made by people. A readable format lets them
        catch mistakes before the program runs.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [input-and-output, input, readability]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
