use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule26:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-26
    title: Pick data representations for the simplicity of the code using them
    statement:
        Pick the representation of your data with an eye to how simple it
        makes the code that uses it.
    rationale:
        A good representation often removes whole branches and special
        cases. A poor one forces awkward code everywhere.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [control-structure, data-structures, design]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
