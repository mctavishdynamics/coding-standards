use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule77:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-77
    title: Comment sparingly and where it helps
    statement:
        Comment where it helps understanding, but do not bury the code under
        comments.
    rationale:
        Too many comments hide the code they describe and are costly to keep
        accurate.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        /* declare counter */
        int count;  /* the count */
        /* set counter to zero */
        count = 0;  /* zero */
        \\\
        ```
    compliant:
        ```c
        \\\
        int count = 0;
        \\\
        ```
    languages: [any]
    tags: [documentation, comments]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
