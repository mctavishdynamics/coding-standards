use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule62:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-62
    title: Reject small speedups that cost readability
    statement:
        Reject optimizations that make code harder to understand for only a
        small gain.
    rationale:
        The time saved by the machine is usually less than the time lost by
        people reading and fixing the code.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [efficiency-and-instrumentation, clarity, performance]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
