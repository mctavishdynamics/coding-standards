use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule33:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-33
    title: Replace bad code with a clean version instead of mending it
    statement:
        When a piece of code is badly written, replace it with a clean
        version instead of adding fixes on top.
    rationale:
        Patches pile up and make bad code worse. A rewrite usually costs
        less than the time lost to fragile code.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [program-structure, refactoring]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
