use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule28:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-28
    title: Divide the work among separate routines
    statement:
        Divide a program into separate routines, each handling a part of the
        problem.
    rationale:
        Smaller pieces can be understood, tested and changed independently,
        and they can be reused.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [program-structure, modularity, functions]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
