use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule48:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-48
    title: Keep looking after finding a bug
    statement:
        When you find one error, do not assume it was the only one. Look for
        others nearby and of the same kind.
    rationale:
        Bugs cluster. The code that held one mistake often holds more, and
        the same misunderstanding may recur elsewhere.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [common-blunders, debugging]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
