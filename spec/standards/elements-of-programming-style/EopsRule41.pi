use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule41:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-41
    title: Ease input preparation and label all output
    statement:
        Design input so that people can write it without fuss, and label
        output so it can be understood without the program's source.
    rationale:
        A program is only useful if people can feed it and read its results.
        Unlabelled numbers and fussy formats lead to mistakes.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        printf("%d %d %.2f\n", n, bad, avg);
        \\\
        ```
    compliant:
        ```c
        \\\
        printf("records: %d  rejected: %d  mean: %.2f\n", n, bad, avg);
        \\\
        ```
    languages: [any]
    tags: [input-and-output, input, output]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
