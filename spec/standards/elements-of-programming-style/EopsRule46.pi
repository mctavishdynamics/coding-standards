use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule46:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-46
    title: Keep input and output in dedicated routines
    statement:
        Put reading and writing in a few routines of their own instead of
        scattering it through the program.
    rationale:
        Isolated I/O is easy to change when formats or devices change, and
        the rest of the code can work on clean data.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [input-and-output, input, output, modularity]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
