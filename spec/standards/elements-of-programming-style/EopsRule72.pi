use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule72:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-72
    title: Name variables after what they hold
    statement:
        Name variables after what they hold, so a reader can tell their role
        without hunting for it.
    rationale:
        Good names document the code at every point of use. Arbitrary names
        force the reader to rebuild their meaning.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        float x1 = h * w;
        \\\
        ```
    compliant:
        ```c
        \\\
        float area = height * width;
        \\\
        ```
    languages: [any]
    tags: [documentation, naming]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
