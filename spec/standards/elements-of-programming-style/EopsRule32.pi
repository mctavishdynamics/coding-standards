use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule32:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-32
    title: Shape the code around its data structures
    statement:
        Let the organization of the data guide the organization of the
        program.
    rationale:
        When the code follows the data, its structure is predictable and
        each part has an obvious home.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [program-structure, data-structures, design]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
