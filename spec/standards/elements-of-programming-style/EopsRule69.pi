use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule69:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-69
    title: Keep comments consistent with the code
    statement:
        When code changes, update the comments that describe it so they
        never disagree.
    rationale:
        A comment that contradicts the code misleads readers, who may then
        trust the wrong one.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        /* retry up to three times */
        for (int i = 0; i < 5; i++) {
            if (send(msg) == 0) break;
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        /* retry up to five times */
        for (int i = 0; i < 5; i++) {
            if (send(msg) == 0) break;
        }
        \\\
        ```
    languages: [any]
    tags: [documentation, comments]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
