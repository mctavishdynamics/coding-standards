use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule20:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-20
    title: Stick to sequence, selection and iteration
    statement:
        Build control flow from the basic structured forms such as statement
        sequences, conditionals and loops, rather than arbitrary jumps.
    rationale:
        Programs made of these forms can be read and reasoned about piece by
        piece, because each piece has one entry and one exit.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [control-structure, structured-programming, control-flow]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
