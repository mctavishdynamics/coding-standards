use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule61:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-61
    title: Tidy the code before optimizing it
    statement:
        Clean up the structure and readability of code before trying to make
        it faster.
    rationale:
        Clear code shows where the work really happens and is easier to
        optimize safely.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [efficiency-and-instrumentation, clarity, performance]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
