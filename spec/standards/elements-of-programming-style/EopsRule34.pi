use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule34:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-34
    title: Grow a large program in small tested steps
    statement:
        Write a large program in small parts and test each part as it is
        finished, before combining them.
    rationale:
        Errors are easiest to find in a small piece just written. Testing
        everything at the end makes failures hard to locate.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [program-structure, testing, incremental]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
