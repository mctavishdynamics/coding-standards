use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule18:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-18
    title: Arrange code to execute in reading order
    statement:
        Arrange code so that it executes in the order it is written, without
        jumps that send the reader back and forth.
    rationale:
        Code that flows downward can be understood in one pass. Jumps force
        the reader to keep several places in mind at once.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [control-structure, control-flow, readability]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
