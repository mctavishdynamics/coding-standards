use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule14:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-14
    title: Write code that still makes sense when read aloud
    statement:
        Judge readability by whether the code could be dictated to a
        listener and understood. Code that fails this needs reworking.
    rationale:
        Code that cannot be described in plain speech is usually too dense
        or too clever. The test is a quick check for readability.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [expression, readability]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
