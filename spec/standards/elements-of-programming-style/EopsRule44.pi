use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule44:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-44
    title: Avoid rigid column layouts for input
    statement:
        Where possible, do not require values in fixed columns or exact
        spacing; let the reader of the input separate fields itself.
    rationale:
        Strict layouts make input tedious to prepare and cause errors that
        have nothing to do with the data.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [input-and-output, input]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
