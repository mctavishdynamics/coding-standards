use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule65:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-65
    title: Confirm a special case is needed before adding it
    statement:
        Before writing separate code for a special case, check that the
        general code really cannot handle it.
    rationale:
        Special cases add branches and bugs. Often the general path already
        gives the right answer.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        if (n == 1) {
            return a[0];
        }
        return max_of(a, n);
        \\\
        ```
    compliant:
        ```c
        \\\
        return max_of(a, n);
        \\\
        ```
    languages: [any]
    tags: [efficiency-and-instrumentation, simplicity, edge-cases]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
