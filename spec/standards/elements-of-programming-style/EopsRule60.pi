use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule60:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-60
    title: Preserve correctness while optimizing
    statement:
        When you speed code up, check after each change that it still gives
        the same results.
    rationale:
        Optimizations are a common source of new bugs. Testing as you go
        catches them while the change is fresh.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [efficiency-and-instrumentation, correctness, performance, testing]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
