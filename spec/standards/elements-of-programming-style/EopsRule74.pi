use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule74:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-74
    title: Lay out code for the reader
    statement:
        Use spacing, blank lines and alignment to make a program's
        organization easy to see.
    rationale:
        Layout is the first thing a reader sees. Good formatting reveals
        structure and poor formatting hides it.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        int f(int a,int b){int t=a;a=b;b=t;return a-b;}
        \\\
        ```
    compliant:
        ```c
        \\\
        int f(int a, int b)
        {
            int t = a;
            a = b;
            b = t;
            return a - b;
        }
        \\\
        ```
    languages: [any]
    tags: [documentation, formatting]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
