use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule9:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-9
    title: Pick names that cannot be mistaken for each other
    statement:
        Avoid variable names that look or sound alike, or that differ only
        by a character that is easy to misread.
    rationale:
        Similar names invite typing one when you mean the other, and the
        mistake is hard to spot when reading.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        int l1 = 0, ll = 0, I1 = 0;
        \\\
        ```
    compliant:
        ```c
        \\\
        int line_count = 0, left_margin = 0, indent = 0;
        \\\
        ```
    languages: [any]
    tags: [expression, naming]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
