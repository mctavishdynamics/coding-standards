use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule66:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-66
    title: Seek speed through simplicity
    statement:
        Look for a simpler design as the route to a faster program.
    rationale:
        Simple code does less work and is easier for both people and
        compilers to optimize.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [efficiency-and-instrumentation, simplicity, performance]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
