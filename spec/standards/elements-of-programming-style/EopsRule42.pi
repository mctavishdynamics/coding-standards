use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule42:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-42
    title: Read every kind of record in one common layout
    statement:
        Use the same conventions for all the input a program reads, rather
        than a different layout for each kind of record.
    rationale:
        Uniform formats are easier to learn, to prepare and to parse, and
        they need less special-case code.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [input-and-output, input, consistency]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
