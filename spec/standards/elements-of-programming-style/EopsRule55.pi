use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule55:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-55
    title: Exercise the edges of each input range
    statement:
        Test programs with inputs at the edges of their ranges, such as
        zero, one, the maximum and just past it.
    rationale:
        Errors concentrate at boundaries, where loops start and stop and
        limits are reached.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```python
        \\\
        for n in (0, 1, CAPACITY - 1, CAPACITY, CAPACITY + 1):
            check_buffer(n)
        \\\
        ```
    languages: [any]
    tags: [common-blunders, testing, edge-cases]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
