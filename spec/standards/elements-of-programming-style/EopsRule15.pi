use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule15:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-15
    title: Group statements with block delimiters and indentation
    statement:
        Mark each group of statements with the language's block delimiters
        and indent the group so its extent is visible.
    rationale:
        Explicit blocks make it clear which statements belong to which
        condition or loop, and indentation lets the eye see it without
        counting.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        if (err)
            log_error(err);
            return err;
        \\\
        ```
    compliant:
        ```c
        \\\
        if (err) {
            log_error(err);
            return err;
        }
        \\\
        ```
    languages: [any]
    tags: [control-structure, blocks, formatting]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
