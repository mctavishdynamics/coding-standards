use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule27:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-27
    title: Revise code after the first working version
    statement:
        Treat the first version that works as a draft. Go back and improve
        its structure and clarity.
    rationale:
        First drafts carry the marks of how the problem was discovered. A
        second pass often finds a much simpler solution.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [control-structure, revision]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
