use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule59:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-59
    title: Achieve correct results before tuning speed
    statement:
        First make the program produce right answers. Only then think about
        speed.
    rationale:
        A fast program that is wrong is worthless, and a correct program
        gives a baseline against which to check optimizations.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [efficiency-and-instrumentation, correctness, performance]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
