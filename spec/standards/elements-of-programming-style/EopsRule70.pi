use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule70:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-70
    title: Write comments that add information
    statement:
        Do not restate in a comment what the code already says. Use comments
        for purpose, assumptions and reasons.
    rationale:
        Echoing comments double the reading without adding anything, and
        they drift out of date.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        i++;  /* add one to i */
        \\\
        ```
    compliant:
        ```c
        \\\
        i++;  /* skip the header row */
        \\\
        ```
    languages: [any]
    tags: [documentation, comments]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
