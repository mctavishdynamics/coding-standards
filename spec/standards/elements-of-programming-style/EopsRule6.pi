use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule6:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-6
    title: Let the computer do repetitive calculation
    statement:
        When values follow a pattern, have the program compute them instead
        of working them out by hand and typing them in.
    rationale:
        Hand-computed constants are easy to get wrong and hard to check. A
        loop or formula is shorter and correct for every entry.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        squares = [0, 1, 4, 9, 16, 25, 36, 49, 64, 81]
        \\\
        ```
    compliant:
        ```python
        \\\
        squares = [i * i for i in range(10)]
        \\\
        ```
    languages: [any]
    tags: [expression, automation]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
