use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule1:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-1
    title: Prefer plain code over clever tricks
    statement:
        Choose the obvious way of writing a piece of code. Ingenious
        shortcuts that save a line or two are rarely worth it.
    rationale:
        Code is read far more often than it is written. A trick that puzzles
        the next reader costs more time than it ever saved.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        /* set n to zero only when a is nonzero */
        n = n * !a;
        \\\
        ```
    compliant:
        ```c
        \\\
        if (a != 0) {
            n = 0;
        }
        \\\
        ```
    languages: [any]
    tags: [introduction, clarity]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
