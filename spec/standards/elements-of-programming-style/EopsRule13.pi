use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule13:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-13
    title: Compute a boolean directly instead of branching to set it
    statement:
        When a variable just records whether a condition holds, assign it
        the value of the condition rather than testing and assigning
        constants.
    rationale:
        The direct form is shorter, has no branches to get backwards, and
        states exactly what the flag means.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        if age >= 18:
            adult = True
        else:
            adult = False
        \\\
        ```
    compliant:
        ```python
        \\\
        adult = age >= 18
        \\\
        ```
    languages: [any]
    tags: [expression, booleans, control-flow]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
