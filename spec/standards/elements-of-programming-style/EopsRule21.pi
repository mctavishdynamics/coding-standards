use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule21:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-21
    title: Sketch the logic in pseudocode before coding
    statement:
        Work out the algorithm first in an informal, readable notation, then
        translate it into the language you must use.
    rationale:
        Thinking at a higher level keeps the design clean and stops the
        quirks of the target language from shaping the logic.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [control-structure, design]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
