export coding-standard ElementsOfProgrammingStyle:
    title: The Elements of Programming Style
    publisher: Brian W. Kernighan and P. J. Plauger, McGraw-Hill
    url: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
    version: 2nd edition, 1978
    license: Copyright McGraw-Hill, all rights reserved. Items are paraphrased.
    description:
        The 77 rules from the summary appendix of Kernighan and Plauger's
        book on programming style, grouped by chapter from expressions to
        documentation. Each rule is paraphrased with fresh C or Python examples.
