use ../lib/CodingRule

from ./ElementsOfProgrammingStyle import ElementsOfProgrammingStyle

export coding-rule EopsRule57:
    standard: @{ElementsOfProgrammingStyle}
    ruleId: rule-57
    title: Expect rounding error in floating point arithmetic
    statement:
        Remember that most decimal fractions are not exact in binary
        floating point, so results are usually slightly off.
    rationale:
        Code that assumes exact results, such as counting up by a fraction
        to an exact limit, can loop too few or too many times.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        for (double x = 0.0; x != 1.0; x += 0.1) {
            plot(x);
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        for (int i = 0; i <= 10; i++) {
            plot(i / 10.0);
        }
        \\\
        ```
    languages: [any]
    tags: [common-blunders, floating-point]
    source: https://en.wikipedia.org/wiki/The_Elements_of_Programming_Style
