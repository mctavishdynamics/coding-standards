use ../lib/CodingRule

from ./CweTop25 import CweTop25

export coding-rule CweTop25Cwe284:
    standard: @{CweTop25}
    ruleId: CWE-284
    title: Prevent improper access control
    statement:
        Manage how privileges are granted, held and checked with great care,
        and make the trust zones of the system explicit. Divide the system
        into compartments with clear trust boundaries, keep sensitive data
        inside them, and give each part only the privileges it needs.
    rationale:
        When access is not properly restricted, unauthorized actors can read
        data, change it or run functions they were never meant to reach. It
        is ranked 19 of 25 in the 2025 CWE Top 25.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [rank-19, access-control, least-privilege, design]
    source: https://cwe.mitre.org/data/definitions/284.html
