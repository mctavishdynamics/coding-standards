export coding-standard CweTop25:
    title: CWE Top 25 Most Dangerous Software Weaknesses
    publisher: MITRE and CISA
    url: https://cwe.mitre.org/top25/
    version: 2025
    license: Copyright The MITRE Corporation. Free to use under the CWE Terms of Use, which require copies to keep the MITRE copyright notice and license.
    description:
        The 25 most dangerous software weaknesses of 2025, ranked by MITRE
        and CISA from real vulnerability data, each written here as a rule
        for avoiding it.
    rules:
        - @{CweTop25Cwe79}
        - @{CweTop25Cwe89}
        - @{CweTop25Cwe352}
        - @{CweTop25Cwe862}
        - @{CweTop25Cwe787}
        - @{CweTop25Cwe22}
        - @{CweTop25Cwe416}
        - @{CweTop25Cwe125}
        - @{CweTop25Cwe78}
        - @{CweTop25Cwe94}
        - @{CweTop25Cwe120}
        - @{CweTop25Cwe434}
        - @{CweTop25Cwe476}
        - @{CweTop25Cwe121}
        - @{CweTop25Cwe502}
        - @{CweTop25Cwe122}
        - @{CweTop25Cwe863}
        - @{CweTop25Cwe20}
        - @{CweTop25Cwe284}
        - @{CweTop25Cwe200}
        - @{CweTop25Cwe306}
        - @{CweTop25Cwe918}
        - @{CweTop25Cwe77}
        - @{CweTop25Cwe639}
        - @{CweTop25Cwe770}
