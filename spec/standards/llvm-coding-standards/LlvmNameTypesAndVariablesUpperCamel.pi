use ../lib/CodingRule

from ./LlvmCodingStandards import LlvmCodingStandards

export coding-rule LlvmNameTypesAndVariablesUpperCamel:
    standard: @{LlvmCodingStandards}
    ruleId: name-types-functions-variables-and-enumerators-properly-types-variables
    title: Name types and variables as nouns in upper camel case
    statement:
        Type names, including classes, structs, enums and typedefs, are
        nouns starting with an upper-case letter. Variable names are also
        nouns in camel case starting with an upper-case letter.
    rationale:
        A uniform casing scheme lets readers tell kinds of names apart at a
        glance.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class symbol_table;
        unsigned maxDepth = 0;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class SymbolTable;
        unsigned MaxDepth = 0;
        \\\
        ```
    languages: [cpp]
    tags: [naming]
    source: https://llvm.org/docs/CodingStandards.html#name-types-functions-variables-and-enumerators-properly
