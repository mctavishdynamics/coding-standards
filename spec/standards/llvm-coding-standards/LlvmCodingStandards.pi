use ../lib/CodingStandard

from ./LlvmAssertWithMessages import LlvmAssertWithMessages
from ./LlvmAvoidAssertOnlyUnusedValues import LlvmAvoidAssertOnlyUnusedValues
from ./LlvmAvoidCopiesWithAuto import LlvmAvoidCopiesWithAuto
from ./LlvmAvoidPointerOrderNondeterminism import
    LlvmAvoidPointerOrderNondeterminism
from ./LlvmAvoidPointersInStaticConstants import
    LlvmAvoidPointersInStaticConstants
from ./LlvmAvoidRttiAndExceptions import LlvmAvoidRttiAndExceptions
from ./LlvmAvoidStaticConstructors import LlvmAvoidStaticConstructors
from ./LlvmAvoidStdEndl import LlvmAvoidStdEndl
from ./LlvmCommentIntentInProse import LlvmCommentIntentInProse
from ./LlvmDisableCodeWithIfZero import LlvmDisableCodeWithIfZero
from ./LlvmDoNotIncludeIostream import LlvmDoNotIncludeIostream
from ./LlvmDoNotIndentNamespaces import LlvmDoNotIndentNamespaces
from ./LlvmDoNotRepeatNameInComment import LlvmDoNotRepeatNameInComment
from ./LlvmDocumentEveryNonTrivialClass import LlvmDocumentEveryNonTrivialClass
from ./LlvmDocumentFunctionsAndEdgeCases import
    LlvmDocumentFunctionsAndEdgeCases
from ./LlvmDocumentPublicApisInHeaderOnce import
    LlvmDocumentPublicApisInHeaderOnce
from ./LlvmEvaluateEndOnce import LlvmEvaluateEndOnce
from ./LlvmExtractPredicateLoops import LlvmExtractPredicateLoops
from ./LlvmFitCodeIn80Columns import LlvmFitCodeIn80Columns
from ./LlvmFollowExistingStyle import LlvmFollowExistingStyle
from ./LlvmFormatBracesLikeCallParentheses import
    LlvmFormatBracesLikeCallParentheses
from ./LlvmFormatLambdasAsBlocks import LlvmFormatLambdasAsBlocks
from ./LlvmFormatPythonWithBlack import LlvmFormatPythonWithBlack
from ./LlvmIncludeAsLittleAsPossible import LlvmIncludeAsLittleAsPossible
from ./LlvmIndentWithSpacesNotTabs import LlvmIndentWithSpacesNotTabs
from ./LlvmIsolateNonPortableCode import LlvmIsolateNonPortableCode
from ./LlvmKeepAnonymousNamespacesSmall import LlvmKeepAnonymousNamespacesSmall
from ./LlvmKeepInternalHeadersPrivate import LlvmKeepInternalHeadersPrivate
from ./LlvmMakeHeadersSelfContained import LlvmMakeHeadersSelfContained
from ./LlvmNameEnumsAndEnumerators import LlvmNameEnumsAndEnumerators
from ./LlvmNameFunctionsAsVerbPhrases import LlvmNameFunctionsAsVerbPhrases
from ./LlvmNameHeaderGuardsAfterIncludePath import
    LlvmNameHeaderGuardsAfterIncludePath
from ./LlvmNameTypesAndVariablesUpperCamel import
    LlvmNameTypesAndVariablesUpperCamel
from ./LlvmNoDefaultInCoveredSwitch import LlvmNoDefaultInCoveredSwitch
from ./LlvmNoElseAfterReturn import LlvmNoElseAfterReturn
from ./LlvmNoInlineInClassBody import LlvmNoInlineInClassBody
from ./LlvmNoTrailingWhitespace import LlvmNoTrailingWhitespace
from ./LlvmNoUsingNamespaceStd import LlvmNoUsingNamespaceStd
from ./LlvmOmitBracesOnSimpleBodies import LlvmOmitBracesOnSimpleBodies
from ./LlvmOrderIncludesByCategory import LlvmOrderIncludesByCategory
from ./LlvmPreferCppStyleCasts import LlvmPreferCppStyleCasts
from ./LlvmPreferCppStyleComments import LlvmPreferCppStyleComments
from ./LlvmPreferPortableModernCpp import LlvmPreferPortableModernCpp
from ./LlvmPreferPreincrement import LlvmPreferPreincrement
from ./LlvmPreferStandardAndLlvmLibraries import
    LlvmPreferStandardAndLlvmLibraries
from ./LlvmProvideVirtualAnchor import LlvmProvideVirtualAnchor
from ./LlvmQualifyOutOfLineDefinitions import LlvmQualifyOutOfLineDefinitions
from ./LlvmRespectLibraryLayering import LlvmRespectLibraryLayering
from ./LlvmRestrictVisibility import LlvmRestrictVisibility
from ./LlvmSpaceOnlyBeforeControlParens import LlvmSpaceOnlyBeforeControlParens
from ./LlvmStartFilesWithStandardHeader import LlvmStartFilesWithStandardHeader
from ./LlvmTreatWarningsAsErrors import LlvmTreatWarningsAsErrors
from ./LlvmUseAutoOnlyWhenClearer import LlvmUseAutoOnlyWhenClearer
from ./LlvmUseCpp17WithoutVendorExtensions import
    LlvmUseCpp17WithoutVendorExtensions
from ./LlvmUseDescriptiveNames import LlvmUseDescriptiveNames
from ./LlvmUseDoxygenCommandsProperly import LlvmUseDoxygenCommandsProperly
from ./LlvmUseEarlyExits import LlvmUseEarlyExits
from ./LlvmUseLlvmSort import LlvmUseLlvmSort
from ./LlvmUseLlvmUnreachable import LlvmUseLlvmUnreachable
from ./LlvmUseOneClassKeyPerType import LlvmUseOneClassKeyPerType
from ./LlvmUseParenthesesForConstructors import
    LlvmUseParenthesesForConstructors
from ./LlvmUseRangeBasedFor import LlvmUseRangeBasedFor
from ./LlvmUseRawOstream import LlvmUseRawOstream
from ./LlvmUseStructOnlyForAllPublic import LlvmUseStructOnlyForAllPublic
from ./LlvmUseUnixLineEndings import LlvmUseUnixLineEndings
from ./LlvmWriteClearDiagnostics import LlvmWriteClearDiagnostics

export coding-standard LlvmCodingStandards:
    title: LLVM Coding Standards
    publisher: The LLVM Project
    url: https://llvm.org/docs/CodingStandards.html
    version: 2026-10-27
    license: Apache License 2.0 with LLVM Exceptions (llvm-project repository); page footer Copyright 2003-2026, LLVM Project
    description:
        The coding conventions of the LLVM compiler infrastructure project
        for C++ code, covering comments, headers, language features, naming
        and low-level formatting. Most guidance targets C++17 code in LLVM
        and its subprojects.
    rules:
        - @{LlvmFollowExistingStyle}
        - @{LlvmPreferPortableModernCpp}
        - @{LlvmUseCpp17WithoutVendorExtensions}
        - @{LlvmPreferStandardAndLlvmLibraries}
        - @{LlvmFormatPythonWithBlack}
        - @{LlvmCommentIntentInProse}
        - @{LlvmStartFilesWithStandardHeader}
        - @{LlvmNameHeaderGuardsAfterIncludePath}
        - @{LlvmDocumentEveryNonTrivialClass}
        - @{LlvmDocumentFunctionsAndEdgeCases}
        - @{LlvmPreferCppStyleComments}
        - @{LlvmDisableCodeWithIfZero}
        - @{LlvmUseDoxygenCommandsProperly}
        - @{LlvmDocumentPublicApisInHeaderOnce}
        - @{LlvmDoNotRepeatNameInComment}
        - @{LlvmWriteClearDiagnostics}
        - @{LlvmOrderIncludesByCategory}
        - @{LlvmFitCodeIn80Columns}
        - @{LlvmIndentWithSpacesNotTabs}
        - @{LlvmNoTrailingWhitespace}
        - @{LlvmFormatLambdasAsBlocks}
        - @{LlvmFormatBracesLikeCallParentheses}
        - @{LlvmTreatWarningsAsErrors}
        - @{LlvmIsolateNonPortableCode}
        - @{LlvmAvoidRttiAndExceptions}
        - @{LlvmPreferCppStyleCasts}
        - @{LlvmAvoidStaticConstructors}
        - @{LlvmAvoidPointersInStaticConstants}
        - @{LlvmUseOneClassKeyPerType}
        - @{LlvmUseStructOnlyForAllPublic}
        - @{LlvmUseParenthesesForConstructors}
        - @{LlvmUseAutoOnlyWhenClearer}
        - @{LlvmAvoidCopiesWithAuto}
        - @{LlvmAvoidPointerOrderNondeterminism}
        - @{LlvmUseLlvmSort}
        - @{LlvmMakeHeadersSelfContained}
        - @{LlvmRespectLibraryLayering}
        - @{LlvmIncludeAsLittleAsPossible}
        - @{LlvmKeepInternalHeadersPrivate}
        - @{LlvmQualifyOutOfLineDefinitions}
        - @{LlvmUseEarlyExits}
        - @{LlvmNoElseAfterReturn}
        - @{LlvmExtractPredicateLoops}
        - @{LlvmUseDescriptiveNames}
        - @{LlvmNameTypesAndVariablesUpperCamel}
        - @{LlvmNameFunctionsAsVerbPhrases}
        - @{LlvmNameEnumsAndEnumerators}
        - @{LlvmAssertWithMessages}
        - @{LlvmUseLlvmUnreachable}
        - @{LlvmAvoidAssertOnlyUnusedValues}
        - @{LlvmNoUsingNamespaceStd}
        - @{LlvmProvideVirtualAnchor}
        - @{LlvmNoDefaultInCoveredSwitch}
        - @{LlvmUseRangeBasedFor}
        - @{LlvmEvaluateEndOnce}
        - @{LlvmDoNotIncludeIostream}
        - @{LlvmUseRawOstream}
        - @{LlvmAvoidStdEndl}
        - @{LlvmNoInlineInClassBody}
        - @{LlvmSpaceOnlyBeforeControlParens}
        - @{LlvmPreferPreincrement}
        - @{LlvmDoNotIndentNamespaces}
        - @{LlvmRestrictVisibility}
        - @{LlvmKeepAnonymousNamespacesSmall}
        - @{LlvmOmitBracesOnSimpleBodies}
        - @{LlvmUseUnixLineEndings}
