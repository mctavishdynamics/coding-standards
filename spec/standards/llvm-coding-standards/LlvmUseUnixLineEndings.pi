use ../lib/CodingRule

from ./LlvmCodingStandards import LlvmCodingStandards

export coding-rule LlvmUseUnixLineEndings:
    standard: @{LlvmCodingStandards}
    ruleId: use-unix-line-endings-for-files
    title: Use Unix line endings
    statement:
        End lines with LF in all files.
    rationale:
        Mixed line endings produce noisy diffs and confuse tools.
    exceptions:
        CRLF is allowed in tests of CRLF handling and in formats that
        require it, such as .bat or .rc files.
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [formatting, files]
    source: https://llvm.org/docs/CodingStandards.html#use-unix-line-endings-for-files
