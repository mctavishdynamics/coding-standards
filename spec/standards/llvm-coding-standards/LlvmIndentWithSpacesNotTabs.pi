use ../lib/CodingRule

from ./LlvmCodingStandards import LlvmCodingStandards

export coding-rule LlvmIndentWithSpacesNotTabs:
    standard: @{LlvmCodingStandards}
    ruleId: whitespace
    title: Indent with spaces, not tabs
    statement:
        Use spaces instead of tab characters in source files.
    rationale:
        Editors expand tabs to different widths, so code indented with tabs
        can look scrambled to other readers.
    exceptions:
        Examples are omitted because this specification renders tabs as
        spaces, so they cannot show the difference.
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [formatting, indentation, whitespace]
    source: https://llvm.org/docs/CodingStandards.html#whitespace
