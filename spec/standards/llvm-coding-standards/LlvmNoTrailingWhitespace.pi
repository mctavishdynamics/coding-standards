use ../lib/CodingRule

from ./LlvmCodingStandards import LlvmCodingStandards

export coding-rule LlvmNoTrailingWhitespace:
    standard: @{LlvmCodingStandards}
    ruleId: whitespace-trailing
    title: Do not leave trailing whitespace
    statement:
        Do not leave spaces or tabs at the end of lines.
    rationale:
        Editors that strip trailing whitespace on save would otherwise add
        unrelated changes to diffs and commits.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [formatting, whitespace]
    source: https://llvm.org/docs/CodingStandards.html#whitespace
