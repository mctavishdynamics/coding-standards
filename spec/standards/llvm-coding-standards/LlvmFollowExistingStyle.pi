use ../lib/CodingRule

from ./LlvmCodingStandards import LlvmCodingStandards

export coding-rule LlvmFollowExistingStyle:
    standard: @{LlvmCodingStandards}
    ruleId: introduction
    title: Match the style of the code you are modifying
    statement:
        When you extend or fix existing code, write it in the style that
        file already uses so the source stays uniform. Do not send patches
        whose only purpose is to reformat large amounts of existing code;
        put renames or style cleanups in their own commit.
    rationale:
        Uniform code is easier to follow, and mass reformatting churns
        history and makes review harder without changing behavior.
    exceptions:
        Some subprojects, such as libc++, follow other conventions on
        purpose, for example because the C++ standard dictates their naming.
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [consistency, maintainability]
    source: https://llvm.org/docs/CodingStandards.html#introduction
