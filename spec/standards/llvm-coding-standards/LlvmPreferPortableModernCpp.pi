use ../lib/CodingRule

from ./LlvmCodingStandards import LlvmCodingStandards

export coding-rule LlvmPreferPortableModernCpp:
    standard: @{LlvmCodingStandards}
    ruleId: languages-libraries-and-standards
    title: Write portable, standards-conforming modern C++
    statement:
        Use standard, modern and portable C++ as the implementation
        language. Use C only where the environment or imported third-party
        code requires it, and use Python for build automation and utility
        scripts.
    rationale:
        A single, portable implementation language keeps the project
        buildable on every supported host and easy for contributors to read.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp, python]
    tags: [portability, language-choice]
    source: https://llvm.org/docs/CodingStandards.html#languages-libraries-and-standards
