use ../lib/CodingStandard

from ./UberGoAvoidEmbeddingTypesInPublicStructs import
    UberGoAvoidEmbeddingTypesInPublicStructs
from ./UberGoAvoidInit import UberGoAvoidInit
from ./UberGoAvoidMutableGlobals import UberGoAvoidMutableGlobals
from ./UberGoAvoidNakedParameters import UberGoAvoidNakedParameters
from ./UberGoAvoidOverlyLongLines import UberGoAvoidOverlyLongLines
from ./UberGoAvoidRepeatedStringToByteConversions import
    UberGoAvoidRepeatedStringToByteConversions
from ./UberGoAvoidUnnecessaryComplexityInTableTests import
    UberGoAvoidUnnecessaryComplexityInTableTests
from ./UberGoAvoidUsingBuiltInNames import UberGoAvoidUsingBuiltInNames
from ./UberGoBeConsistent import UberGoBeConsistent
from ./UberGoChannelSizeIsOneOrNone import UberGoChannelSizeIsOneOrNone
from ./UberGoDeferToCleanUp import UberGoDeferToCleanUp
from ./UberGoDontFireAndForgetGoroutines import
    UberGoDontFireAndForgetGoroutines
from ./UberGoDontPanic import UberGoDontPanic
from ./UberGoEmbeddingInStructs import UberGoEmbeddingInStructs
from ./UberGoErrorNaming import UberGoErrorNaming
from ./UberGoErrorTypes import UberGoErrorTypes
from ./UberGoErrorWrapping import UberGoErrorWrapping
from ./UberGoExitInMain import UberGoExitInMain
from ./UberGoExitOnce import UberGoExitOnce
from ./UberGoFormatStringsOutsidePrintf import UberGoFormatStringsOutsidePrintf
from ./UberGoFunctionGroupingAndOrdering import
    UberGoFunctionGroupingAndOrdering
from ./UberGoFunctionNames import UberGoFunctionNames
from ./UberGoFunctionalOptions import UberGoFunctionalOptions
from ./UberGoGroupSimilarDeclarations import UberGoGroupSimilarDeclarations
from ./UberGoHandleErrorsOnce import UberGoHandleErrorsOnce
from ./UberGoHandleTypeAssertionFailures import
    UberGoHandleTypeAssertionFailures
from ./UberGoImportAliasing import UberGoImportAliasing
from ./UberGoImportGroupOrdering import UberGoImportGroupOrdering
from ./UberGoInitializingMaps import UberGoInitializingMaps
from ./UberGoInitializingStructReferences import
    UberGoInitializingStructReferences
from ./UberGoLintRunners import UberGoLintRunners
from ./UberGoLinting import UberGoLinting
from ./UberGoLocalVariableDeclarations import UberGoLocalVariableDeclarations
from ./UberGoNamingPrintfStyleFunctions import UberGoNamingPrintfStyleFunctions
from ./UberGoNilIsAValidSlice import UberGoNilIsAValidSlice
from ./UberGoNoGoroutinesInInit import UberGoNoGoroutinesInInit
from ./UberGoOmitZeroValueFieldsInStructs import
    UberGoOmitZeroValueFieldsInStructs
from ./UberGoPackageNames import UberGoPackageNames
from ./UberGoParallelTests import UberGoParallelTests
from ./UberGoPointersToInterfaces import UberGoPointersToInterfaces
from ./UberGoPreferStrconvOverFmt import UberGoPreferStrconvOverFmt
from ./UberGoPrefixUnexportedGlobalsWithUnderscore import
    UberGoPrefixUnexportedGlobalsWithUnderscore
from ./UberGoReceiversAndInterfaces import UberGoReceiversAndInterfaces
from ./UberGoReceivingSlicesAndMaps import UberGoReceivingSlicesAndMaps
from ./UberGoReduceNesting import UberGoReduceNesting
from ./UberGoReduceScopeOfVariables import UberGoReduceScopeOfVariables
from ./UberGoReturningSlicesAndMaps import UberGoReturningSlicesAndMaps
from ./UberGoSpecifyingMapCapacityHints import UberGoSpecifyingMapCapacityHints
from ./UberGoSpecifyingSliceCapacity import UberGoSpecifyingSliceCapacity
from ./UberGoStartEnumsAtOne import UberGoStartEnumsAtOne
from ./UberGoTestTables import UberGoTestTables
from ./UberGoTopLevelVariableDeclarations import
    UberGoTopLevelVariableDeclarations
from ./UberGoUnnecessaryElse import UberGoUnnecessaryElse
from ./UberGoUseFieldNamesToInitializeStructs import
    UberGoUseFieldNamesToInitializeStructs
from ./UberGoUseFieldTagsInMarshaledStructs import
    UberGoUseFieldTagsInMarshaledStructs
from ./UberGoUseGoUberOrgAtomic import UberGoUseGoUberOrgAtomic
from ./UberGoUseRawStringLiterals import UberGoUseRawStringLiterals
from ./UberGoUseTimeDurationForPeriods import UberGoUseTimeDurationForPeriods
from ./UberGoUseTimeTimeForInstants import UberGoUseTimeTimeForInstants
from ./UberGoUseTimeToHandleTime import UberGoUseTimeToHandleTime
from ./UberGoUseTimeTypesWithExternalSystems import
    UberGoUseTimeTypesWithExternalSystems
from ./UberGoUseVarForZeroValueStructs import UberGoUseVarForZeroValueStructs
from ./UberGoVerifyInterfaceCompliance import UberGoVerifyInterfaceCompliance
from ./UberGoWaitForGoroutinesToExit import UberGoWaitForGoroutinesToExit
from ./UberGoZeroValueMutexesAreValid import UberGoZeroValueMutexesAreValid

export coding-standard UberGo:
    title: Uber Go Style Guide
    publisher: Uber Technologies
    url: https://github.com/uber-go/guide/blob/master/style.md
    version: 2026-04-15
    license: Apache License 2.0
    description:
        Uber's conventions for writing Go code. It covers correctness
        guidelines, performance, style, common patterns and linting.
    rules:
        - @{UberGoPointersToInterfaces}
        - @{UberGoVerifyInterfaceCompliance}
        - @{UberGoReceiversAndInterfaces}
        - @{UberGoZeroValueMutexesAreValid}
        - @{UberGoReceivingSlicesAndMaps}
        - @{UberGoReturningSlicesAndMaps}
        - @{UberGoDeferToCleanUp}
        - @{UberGoChannelSizeIsOneOrNone}
        - @{UberGoStartEnumsAtOne}
        - @{UberGoUseTimeToHandleTime}
        - @{UberGoUseTimeTimeForInstants}
        - @{UberGoUseTimeDurationForPeriods}
        - @{UberGoUseTimeTypesWithExternalSystems}
        - @{UberGoErrorTypes}
        - @{UberGoErrorWrapping}
        - @{UberGoErrorNaming}
        - @{UberGoHandleErrorsOnce}
        - @{UberGoHandleTypeAssertionFailures}
        - @{UberGoDontPanic}
        - @{UberGoUseGoUberOrgAtomic}
        - @{UberGoAvoidMutableGlobals}
        - @{UberGoAvoidEmbeddingTypesInPublicStructs}
        - @{UberGoAvoidUsingBuiltInNames}
        - @{UberGoAvoidInit}
        - @{UberGoExitInMain}
        - @{UberGoExitOnce}
        - @{UberGoUseFieldTagsInMarshaledStructs}
        - @{UberGoDontFireAndForgetGoroutines}
        - @{UberGoWaitForGoroutinesToExit}
        - @{UberGoNoGoroutinesInInit}
        - @{UberGoPreferStrconvOverFmt}
        - @{UberGoAvoidRepeatedStringToByteConversions}
        - @{UberGoSpecifyingMapCapacityHints}
        - @{UberGoSpecifyingSliceCapacity}
        - @{UberGoAvoidOverlyLongLines}
        - @{UberGoBeConsistent}
        - @{UberGoGroupSimilarDeclarations}
        - @{UberGoImportGroupOrdering}
        - @{UberGoPackageNames}
        - @{UberGoFunctionNames}
        - @{UberGoImportAliasing}
        - @{UberGoFunctionGroupingAndOrdering}
        - @{UberGoReduceNesting}
        - @{UberGoUnnecessaryElse}
        - @{UberGoTopLevelVariableDeclarations}
        - @{UberGoPrefixUnexportedGlobalsWithUnderscore}
        - @{UberGoEmbeddingInStructs}
        - @{UberGoLocalVariableDeclarations}
        - @{UberGoNilIsAValidSlice}
        - @{UberGoReduceScopeOfVariables}
        - @{UberGoAvoidNakedParameters}
        - @{UberGoUseRawStringLiterals}
        - @{UberGoUseFieldNamesToInitializeStructs}
        - @{UberGoOmitZeroValueFieldsInStructs}
        - @{UberGoUseVarForZeroValueStructs}
        - @{UberGoInitializingStructReferences}
        - @{UberGoInitializingMaps}
        - @{UberGoFormatStringsOutsidePrintf}
        - @{UberGoNamingPrintfStyleFunctions}
        - @{UberGoTestTables}
        - @{UberGoAvoidUnnecessaryComplexityInTableTests}
        - @{UberGoParallelTests}
        - @{UberGoFunctionalOptions}
        - @{UberGoLinting}
        - @{UberGoLintRunners}
