use ../lib/CodingRule

from ./UberGo import UberGo

export coding-rule UberGoReturningSlicesAndMaps:
    standard: @{UberGo}
    ruleId: returning-slices-and-maps
    title: Return copies of internal slices and maps
    statement:
        When a method returns a slice or map that is part of internal state,
        return a copy rather than the original.
    rationale:
        Callers can modify a returned map or slice, and with a shared
        reference those changes reach your internal data, often outside any
        lock that guards it.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        func (c *Config) Labels() map[string]string {
            c.mu.Lock()
            defer c.mu.Unlock()
            return c.labels
        }
        \\\
        ```
    compliant:
        ```go
        \\\
        func (c *Config) Labels() map[string]string {
            c.mu.Lock()
            defer c.mu.Unlock()
            out := make(map[string]string, len(c.labels))
            for k, v := range c.labels {
                out[k] = v
            }
            return out
        }
        \\\
        ```
    languages: [go]
    tags: [slices, maps, encapsulation]
    source: https://github.com/uber-go/guide/blob/master/style.md#returning-slices-and-maps
