use ../lib/CodingRule

from ./UberGo import UberGo

export coding-rule UberGoLintRunners:
    standard: @{UberGo}
    ruleId: lint-runners
    title: Run linters through golangci-lint
    statement:
        Use golangci-lint to run the linters, starting from the recommended
        base set and adding others that suit the project.
    rationale:
        It performs well on large codebases and configures many standard
        linters in one place.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [go]
    tags: [linting, tooling]
    source: https://github.com/uber-go/guide/blob/master/style.md#lint-runners
