use ../lib/CodingRule

from ./UberGo import UberGo

export coding-rule UberGoBeConsistent:
    standard: @{UberGo}
    ruleId: be-consistent
    title: Be consistent above all
    statement:
        Apply conventions consistently, and when adopting a guideline change
        a whole package or more at once rather than part of one.
    rationale:
        Consistent code is easier to maintain and migrate; conflicting
        styles in one codebase slow people down and breed bugs.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [go]
    tags: [consistency]
    source: https://github.com/uber-go/guide/blob/master/style.md#be-consistent
