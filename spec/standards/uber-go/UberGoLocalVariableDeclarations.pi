use ../lib/CodingRule

from ./UberGo import UberGo

export coding-rule UberGoLocalVariableDeclarations:
    standard: @{UberGo}
    ruleId: local-variable-declarations
    title: Use short variable declarations for explicit values
    statement:
        Declare local variables with := when giving them an explicit value.
        Use var where the zero value reads more clearly, such as for an
        empty slice.
    rationale:
        Short declarations are concise, and var signals that the zero value
        is intended.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        var greeting = "hello"
        \\\
        ```
    compliant:
        ```go
        \\\
        greeting := "hello"
        \\\
        ```
    languages: [go]
    tags: [declarations]
    source: https://github.com/uber-go/guide/blob/master/style.md#local-variable-declarations
