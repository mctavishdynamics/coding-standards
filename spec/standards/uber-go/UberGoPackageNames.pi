use ../lib/CodingRule

from ./UberGo import UberGo

export coding-rule UberGoPackageNames:
    standard: @{UberGo}
    ruleId: package-names
    title: Give packages short, lower-case, singular names
    statement:
        Name packages in lower case without capitals or underscores, short,
        singular and descriptive, so that most importers need no alias.
        Avoid vague names such as common, util, shared or lib.
    rationale:
        The package name appears at every call site, so it should be brief
        and say what the package provides.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        package string_utils
        \\\
        ```
    compliant:
        ```go
        \\\
        package stringconv
        \\\
        ```
    languages: [go]
    tags: [naming, packages]
    source: https://github.com/uber-go/guide/blob/master/style.md#package-names
