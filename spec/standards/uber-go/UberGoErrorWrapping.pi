use ../lib/CodingRule

from ./UberGo import UberGo

export coding-rule UberGoErrorWrapping:
    standard: @{UberGo}
    ruleId: error-wrapping
    title: Add brief context when passing errors up
    statement:
        Return an error unchanged when there is nothing to add; otherwise
        add context with fmt.Errorf. Use %w when callers should be able to
        reach the cause and %v to hide it. Keep the context short and leave
        out phrases like failed to.
    rationale:
        Context shows where an error came from, and dropping filler words
        keeps messages readable as they stack up through the call chain.
    exceptions: null
    severity: null
    noncompliant:
        ```go
        \\\
        user, err := repo.Find(id)
        if err != nil {
            return fmt.Errorf("failed to find user: %v", err)
        }
        \\\
        ```
    compliant:
        ```go
        \\\
        user, err := repo.Find(id)
        if err != nil {
            return fmt.Errorf("find user %d: %w", id, err)
        }
        \\\
        ```
    languages: [go]
    tags: [error-handling]
    source: https://github.com/uber-go/guide/blob/master/style.md#error-wrapping
