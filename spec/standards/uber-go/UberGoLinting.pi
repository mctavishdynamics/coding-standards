use ../lib/CodingRule

from ./UberGo import UberGo

export coding-rule UberGoLinting:
    standard: @{UberGo}
    ruleId: linting
    title: Run a consistent base set of linters
    statement:
        Lint the whole codebase consistently, with at least errcheck,
        goimports, revive, govet and staticcheck.
    rationale:
        Consistent linting catches common mistakes and keeps a uniform
        quality bar without being overly prescriptive.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [go]
    tags: [linting, tooling]
    source: https://github.com/uber-go/guide/blob/master/style.md#linting
