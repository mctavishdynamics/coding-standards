use ../lib/CodingRule

from ./SwiftApiDesign import SwiftApiDesign

export coding-rule SwiftApiEmbracePrecedent:
    standard: @{SwiftApiDesign}
    ruleId: embrace-precedent
    title: Follow established terminology
    statement:
        Do not simplify names for total beginners at the cost of breaking
        with familiar conventions. Use the term most programmers know, and
        in a domain such as mathematics prefer its long-standing notation
        even over the rule against abbreviations.
    rationale:
        Familiar terms reward readers' existing knowledge and their
        searches.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        let y = verticalPositionOnUnitCircle(forAngle: theta)
        var items: OrderedBag<Int>
        \\\
        ```
    compliant:
        ```swift
        \\\
        let y = sin(theta)
        var items: [Int]
        \\\
        ```
    languages: [swift]
    tags: [naming, terminology]
    source: https://www.swift.org/documentation/api-design-guidelines/#embrace-precedent
