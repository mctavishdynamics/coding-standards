use ../lib/CodingRule

from ./SwiftApiDesign import SwiftApiDesign

export coding-rule SwiftApiProtocolsDescribingWhatIsShouldReadAsNouns:
    standard: @{SwiftApiDesign}
    ruleId: protocols-describing-what-is-should-read-as-nouns
    title: Name protocols that describe a kind of thing as nouns
    statement:
        A protocol that says what something is should have a noun name.
    rationale:
        The protocol stands for a category of things, and a noun names a
        category.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        protocol Storing {
            func read(key: String) -> Data?
        }
        \\\
        ```
    compliant:
        ```swift
        \\\
        protocol Storage {
            func read(key: String) -> Data?
        }
        \\\
        ```
    languages: [swift]
    tags: [naming, protocols]
    source: https://www.swift.org/documentation/api-design-guidelines/#protocols-describing-what-is-should-read-as-nouns
