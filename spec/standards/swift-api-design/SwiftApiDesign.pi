from ./SwiftApiUseSwiftMarkdown import SwiftApiUseSwiftMarkdown
from ./SwiftApiUseSymbolCommandBullets import SwiftApiUseSymbolCommandBullets
from ./SwiftApiUseSymbolDocumentationMarkup import
    SwiftApiUseSymbolDocumentationMarkup
from ./SwiftApiWeakTypeInformation import SwiftApiWeakTypeInformation
from ./SwiftApiWriteDocComment import SwiftApiWriteDocComment

export coding-standard SwiftApiDesign:
    title: Swift API Design Guidelines
    publisher: The Swift Project
    url: https://www.swift.org/documentation/api-design-guidelines/
    version: null
    license: Apache-2.0 with Runtime Library Exception
    description:
        Guidelines from the Swift project for designing Swift APIs that read
        clearly at the point of use, covering documentation comments, naming,
        terminology, parameters and argument labels.
    rules:
        - @{SwiftApiClarityAtThePointOfUse}
        - @{SwiftApiClarityOverBrevity}
        - @{SwiftApiWriteDocComment}
        - @{SwiftApiUseSwiftMarkdown}
        - @{SwiftApiBeginWithSummary}
        - @{SwiftApiSummarySingleSentenceFragment}
        - @{SwiftApiDescribeWhatFunctionDoesAndReturns}
        - @{SwiftApiDescribeWhatSubscriptAccesses}
        - @{SwiftApiDescribeWhatInitializerCreates}
        - @{SwiftApiDescribeWhatEntityIs}
        - @{SwiftApiOptionallyContinueWithParagraphs}
        - @{SwiftApiUseSymbolDocumentationMarkup}
        - @{SwiftApiUseSymbolCommandBullets}
        - @{SwiftApiIncludeWordsToAvoidAmbiguity}
        - @{SwiftApiOmitNeedlessWords}
        - @{SwiftApiNameAccordingToRoles}
        - @{SwiftApiWeakTypeInformation}
        - @{SwiftApiMethodsAndFunctionsReadAsPhrases}
        - @{SwiftApiBeginFactoryNameWithMake}
        - @{SwiftApiInitFactoryPhraseEndsWithBasename}
        - @{SwiftApiNameAccordingToSideEffects}
        - @{SwiftApiNameMutatingPairsWithVerbs}
        - @{SwiftApiNameMutatingPairsWithNouns}
        - @{SwiftApiBooleanAssertions}
        - @{SwiftApiProtocolsDescribingWhatIsShouldReadAsNouns}
        - @{SwiftApiProtocolsDescribingCapabilityShouldUseSuffixes}
        - @{SwiftApiNameOfOthersShouldReadAsNouns}
        - @{SwiftApiAvoidObscureTerms}
        - @{SwiftApiStickToEstablishedMeaning}
        - @{SwiftApiDoNotSurpriseAnExpert}
        - @{SwiftApiDoNotConfuseABeginner}
        - @{SwiftApiAvoidAbbreviations}
        - @{SwiftApiEmbracePrecedent}
        - @{SwiftApiDocumentComputedPropertyComplexity}
        - @{SwiftApiPreferMethodAndPropertiesToFunctions}
        - @{SwiftApiFollowCaseConventions}
        - @{SwiftApiSimilarMethodsCanShareABaseName}
        - @{SwiftApiAvoidOverloadingOnReturnType}
        - @{SwiftApiChooseParameterNamesToServeDoc}
        - @{SwiftApiTakeAdvantageOfDefaultedParameters}
        - @{SwiftApiParameterWithDefaultsTowardsTheEnd}
        - @{SwiftApiPreferFileidInProduction}
        - @{SwiftApiNoLabelsForIndistinguishableArguments}
        - @{SwiftApiTypeConversion}
        - @{SwiftApiGivePrepositionalPhraseArgumentLabel}
        - @{SwiftApiOmitFirstArgumentIfPartialPhrase}
        - @{SwiftApiLabelAllOtherArguments}
        - @{SwiftApiLabelClosureParameters}
        - @{SwiftApiUnconstrainedPolymorphism}
