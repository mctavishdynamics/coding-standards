use ../lib/CodingRule

from ./SwiftApiDesign import SwiftApiDesign

export coding-rule SwiftApiAvoidObscureTerms:
    standard: @{SwiftApiDesign}
    ruleId: avoid-obscure-terms
    title: Prefer common words to obscure terms
    statement:
        Use an everyday word when it carries the meaning just as well.
        Reserve terms of art for meaning that would otherwise be lost.
    rationale:
        Specialised vocabulary shuts out readers who do not know it and
        gains nothing when a plain word works.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        func obviate(_ alert: Alert)
        \\\
        ```
    compliant:
        ```swift
        \\\
        func dismiss(_ alert: Alert)
        \\\
        ```
    languages: [swift]
    tags: [naming, terminology]
    source: https://www.swift.org/documentation/api-design-guidelines/#avoid-obscure-terms
