use ../lib/CodingRule

from ./SwiftApiDesign import SwiftApiDesign

export coding-rule SwiftApiNameMutatingPairsWithNouns:
    standard: @{SwiftApiDesign}
    ruleId: name-mutating-pairs-with-nouns
    title: Name noun-based mutating pairs with a form prefix
    statement:
        If an operation is best described by a noun, give that noun to the
        nonmutating version and name the mutating version with the form
        prefix, as in union and formUnion.
    rationale:
        The form prefix gives noun-named operations a clear in-place
        counterpart without inventing an awkward verb.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        func intersection(_ other: Region) -> Region
        mutating func intersectInPlace(_ other: Region)
        \\\
        ```
    compliant:
        ```swift
        \\\
        func intersection(_ other: Region) -> Region
        mutating func formIntersection(_ other: Region)
        \\\
        ```
    languages: [swift]
    tags: [naming, mutation]
    source: https://www.swift.org/documentation/api-design-guidelines/#name-according-to-side-effects
