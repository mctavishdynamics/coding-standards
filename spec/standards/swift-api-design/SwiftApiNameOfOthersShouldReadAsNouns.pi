use ../lib/CodingRule

from ./SwiftApiDesign import SwiftApiDesign

export coding-rule SwiftApiNameOfOthersShouldReadAsNouns:
    standard: @{SwiftApiDesign}
    ruleId: name-of-others-should-read-as-nouns
    title: Name types, properties, variables and constants as nouns
    statement:
        Give other types, properties, variables and constants names that
        read as nouns.
    rationale:
        These entities are things, and noun names keep code reading like
        prose.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        struct Validate { }
        var loadingNow: Int
        \\\
        ```
    compliant:
        ```swift
        \\\
        struct Validator { }
        var activeDownloads: Int
        \\\
        ```
    languages: [swift]
    tags: [naming]
    source: https://www.swift.org/documentation/api-design-guidelines/#name-of-others-should-read-as-nouns
