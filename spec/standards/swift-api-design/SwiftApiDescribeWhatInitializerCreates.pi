use ../lib/CodingRule

from ./SwiftApiDesign import SwiftApiDesign

export coding-rule SwiftApiDescribeWhatInitializerCreates:
    standard: @{SwiftApiDesign}
    ruleId: describe-what-initializer-creates
    title: Summarise what an initializer creates
    statement:
        Begin the summary of an initializer by saying what instance it
        creates.
    rationale:
        Stating the result of construction tells the reader how the
        arguments shape the new value.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        /// Initializer.
        init(width: Int, height: Int)
        \\\
        ```
    compliant:
        ```swift
        \\\
        /// Creates a blank canvas of the given size in pixels.
        init(width: Int, height: Int)
        \\\
        ```
    languages: [swift]
    tags: [documentation]
    source: https://www.swift.org/documentation/api-design-guidelines/#write-doc-comment
