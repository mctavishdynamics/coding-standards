use ../lib/CodingRule

from ./SwiftApiDesign import SwiftApiDesign

export coding-rule SwiftApiFollowCaseConventions:
    standard: @{SwiftApiDesign}
    ruleId: follow-case-conventions
    title: Follow Swift case conventions
    statement:
        Use UpperCamelCase for types and protocols and lowerCamelCase for
        everything else. Acronyms usually written in capitals in American
        English are all upper or all lower case as the position requires;
        other acronyms are treated as ordinary words.
    rationale:
        Uniform casing tells readers what kind of entity a name is and keeps
        acronyms predictable.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        struct http_request { }
        var JsonURLString: String
        var Laser_Range: Double
        \\\
        ```
    compliant:
        ```swift
        \\\
        struct HTTPRequest { }
        var jsonURLString: String
        var laserRange: Double
        \\\
        ```
    languages: [swift]
    tags: [naming, casing]
    source: https://www.swift.org/documentation/api-design-guidelines/#follow-case-conventions
