use ../lib/CodingRule

from ./SwiftApiDesign import SwiftApiDesign

export coding-rule SwiftApiAvoidAbbreviations:
    standard: @{SwiftApiDesign}
    ruleId: avoid-abbreviations
    title: Spell names out instead of abbreviating
    statement:
        Do not abbreviate, especially in non-standard ways. If you must use
        an abbreviation, its meaning should be easy to find with a web
        search.
    rationale:
        An abbreviation acts like a term of art: readers can only understand
        it if they can expand it correctly.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        var usrPrefs: UsrPrefs
        func calcTtlAmt() -> Decimal
        \\\
        ```
    compliant:
        ```swift
        \\\
        var userPreferences: UserPreferences
        func calculateTotalAmount() -> Decimal
        \\\
        ```
    languages: [swift]
    tags: [naming, terminology]
    source: https://www.swift.org/documentation/api-design-guidelines/#avoid-abbreviations
