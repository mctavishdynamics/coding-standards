use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssSemantics:
    standard: @{GoogleHtmlCss}
    ruleId: semantics
    title: Use HTML elements for their purpose
    statement:
        Choose elements for what they are meant for, such as headings for
        headings, p for paragraphs and a for links.
    rationale:
        Semantic markup matters for accessibility, reuse and efficient code.
    exceptions: null
    severity: null
    noncompliant:
        ```html
        \\\
        <span class="link" onclick="location.href='/pricing'">See pricing</span>
        \\\
        ```
    compliant:
        ```html
        \\\
        <a href="/pricing">See pricing</a>
        \\\
        ```
    languages: [html]
    tags: [semantics, accessibility]
    source: https://google.github.io/styleguide/htmlcssguide.html#semantics
