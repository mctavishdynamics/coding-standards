use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssClassNaming:
    standard: @{GoogleHtmlCss}
    ruleId: class-naming
    title: Use meaningful or generic class names
    statement:
        Name classes after the purpose of the element, or use a generic name
        when the element has no particular meaning. Avoid presentational and
        cryptic names.
    rationale:
        Purpose-based names are the easiest to understand and the least
        likely to change, which reduces needless edits to documents and
        templates.
    exceptions: null
    severity: null
    noncompliant:
        ```css
        \\\
        .blue-text {}
        .x9q {}
        \\\
        ```
    compliant:
        ```css
        \\\
        .warning {}
        .sidebar {}
        .aux {}
        \\\
        ```
    languages: [css]
    tags: [naming, selectors]
    source: https://google.github.io/styleguide/htmlcssguide.html#class-naming
