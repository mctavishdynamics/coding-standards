use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssActionItems:
    standard: @{GoogleHtmlCss}
    ruleId: action-items
    title: Mark todos with TODO
    statement:
        Mark todos and action items with the keyword TODO only, not other
        markers such as double at signs, and put the action item after a
        colon.
    rationale:
        A single keyword makes outstanding work easy to find.
    exceptions: null
    severity: null
    noncompliant:
        ```html
        \\\
        <!-- FIXME remove the legacy layout table -->
        \\\
        ```
    compliant:
        ```html
        \\\
        <!-- TODO: Remove the legacy layout table. -->
        \\\
        ```
    languages: [html, css]
    tags: [comments, todo]
    source: https://google.github.io/styleguide/htmlcssguide.html#action-items
