use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssPropertyNameStops:
    standard: @{GoogleHtmlCss}
    ruleId: property-name-stops
    title: Use a space after a property name's colon
    statement:
        Put a single space between a property's colon and its value, and no
        space between the property and the colon.
    rationale:
        The same spacing everywhere keeps code consistent.
    exceptions: null
    severity: null
    noncompliant:
        ```css
        \\\
        .title {
          font-size:2em;
          margin : 0;
        }
        \\\
        ```
    compliant:
        ```css
        \\\
        .title {
          font-size: 2em;
          margin: 0;
        }
        \\\
        ```
    languages: [css]
    tags: [formatting, whitespace]
    source: https://google.github.io/styleguide/htmlcssguide.html#property-name-stops
