use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssGeneralFormatting:
    standard: @{GoogleHtmlCss}
    ruleId: general-formatting
    title: Put every block, list and table element on a new line
    statement:
        Start a new line for every block, list or table element, whatever
        its CSS display, and indent it when it is the child of such an
        element.
    rationale:
        The layout of the source then reflects the structure of the
        document.
    exceptions:
        If whitespace between list items causes problems, all li elements
        may go on one line.
    severity: null
    noncompliant:
        ```html
        \\\
        <ul><li>Mercury</li><li>Venus</li></ul>
        \\\
        ```
    compliant:
        ```html
        \\\
        <ul>
          <li>Mercury
          <li>Venus
        </ul>
        \\\
        ```
    languages: [html]
    tags: [formatting, markup]
    source: https://google.github.io/styleguide/htmlcssguide.html#general-formatting
