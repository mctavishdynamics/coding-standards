use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssComments:
    standard: @{GoogleHtmlCss}
    ruleId: comments
    title: Explain code with comments where needed
    statement:
        Use comments to explain what code covers, what purpose it serves and
        why the chosen solution is used. This rule is optional.
    rationale:
        Comments help others understand the intent of markup and styles,
        though fully documented HTML and CSS is not always a realistic goal.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```html
        \\\
        <!-- Hidden until the cookie banner script decides whether to show it. -->
        <div class="cookie-banner" hidden>
          …
        </div>
        \\\
        ```
    languages: [html, css]
    tags: [comments, documentation]
    source: https://google.github.io/styleguide/htmlcssguide.html#comments
