use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssSectionComments:
    standard: @{GoogleHtmlCss}
    ruleId: section-comments
    title: Group style sheet sections with section comments
    statement:
        Where possible, group related rules into sections introduced by a
        comment, and separate the sections with new lines. This rule is
        optional.
    rationale:
        Section comments make a long style sheet easier to navigate.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```css
        \\\
        /* Navigation */
        .shop-nav {}

        /* Product grid */
        .shop-grid {}
        \\\
        ```
    languages: [css]
    tags: [comments, organization]
    source: https://google.github.io/styleguide/htmlcssguide.html#section-comments
