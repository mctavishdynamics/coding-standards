use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssDocumentType:
    standard: @{GoogleHtmlCss}
    ruleId: document-type
    title: Use the HTML5 doctype
    statement:
        Begin every HTML document with the HTML5 doctype so that it renders
        in no-quirks mode.
    rationale:
        Without a doctype a page renders in quirks mode, and other doctypes
        can trigger limited-quirks mode. Both depart from documented HTML
        and CSS behaviour and cause subtle failures.
    exceptions: null
    severity: null
    noncompliant:
        ```html
        \\\
        <html>
        <title>Order history</title>
        \\\
        ```
    compliant:
        ```html
        \\\
        <!doctype html>
        <title>Order history</title>
        \\\
        ```
    languages: [html]
    tags: [doctype, rendering]
    source: https://google.github.io/styleguide/htmlcssguide.html#document-type
