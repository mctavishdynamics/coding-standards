use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssSelectorAndDeclarationSeparation:
    standard: @{GoogleHtmlCss}
    ruleId: selector-and-declaration-separation
    title: Put each selector and declaration on its own line
    statement:
        Start a new line for every selector and every declaration.
    rationale:
        One item per line is easier to read and produces cleaner diffs.
    exceptions: null
    severity: null
    noncompliant:
        ```css
        \\\
        th, td {
          padding: 4px; text-align: left;
        }
        \\\
        ```
    compliant:
        ```css
        \\\
        th,
        td {
          padding: 4px;
          text-align: left;
        }
        \\\
        ```
    languages: [css]
    tags: [formatting, selectors]
    source: https://google.github.io/styleguide/htmlcssguide.html#selector-and-declaration-separation
