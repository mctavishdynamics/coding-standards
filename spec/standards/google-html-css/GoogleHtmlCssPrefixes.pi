use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssPrefixes:
    standard: @{GoogleHtmlCss}
    ruleId: prefixes
    title: Prefix selectors with an application-specific prefix
    statement:
        In large projects and in code embedded in other projects or sites,
        give class names a short, unique namespace prefix followed by a
        dash. This rule is optional.
    rationale:
        Prefixes prevent naming conflicts and make maintenance, such as
        search and replace, easier.
    exceptions: null
    severity: null
    noncompliant:
        ```css
        \\\
        .tooltip {}
        \\\
        ```
    compliant:
        ```css
        \\\
        .chk-tooltip {} /* Checkout widget */
        \\\
        ```
    languages: [css]
    tags: [naming, namespaces]
    source: https://google.github.io/styleguide/htmlcssguide.html#prefixes
