use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssRuleSeparation:
    standard: @{GoogleHtmlCss}
    ruleId: rule-separation
    title: Separate rules with a blank line
    statement:
        Always put a blank line between rules.
    rationale:
        Blank lines make each rule stand out as a unit.
    exceptions: null
    severity: null
    noncompliant:
        ```css
        \\\
        .header {
          margin: 0;
        }
        .content {
          margin: 1em;
        }
        \\\
        ```
    compliant:
        ```css
        \\\
        .header {
          margin: 0;
        }

        .content {
          margin: 1em;
        }
        \\\
        ```
    languages: [css]
    tags: [formatting, whitespace]
    source: https://google.github.io/styleguide/htmlcssguide.html#rule-separation
