use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssSeparationOfConcerns:
    standard: @{GoogleHtmlCss}
    ruleId: separation-of-concerns
    title: Separate structure, presentation and behaviour
    statement:
        Structure, presentation and behaviour live in separate places. HTML
        documents and templates contain only structure, styles go into style
        sheets, behaviour goes into scripts, and pages link to the smallest
        practical number of style sheets and scripts.
    rationale:
        Changing HTML documents and templates is always more expensive than
        updating style sheets and scripts.
    exceptions: null
    severity: null
    noncompliant:
        ```html
        \\\
        <h2 style="color: red;" onclick="toggle()">Alerts</h2>
        <center><font size="2">Updated hourly</font></center>
        \\\
        ```
    compliant:
        ```html
        \\\
        <link rel="stylesheet" href="alerts.css">
        <script src="alerts.js" defer></script>
        <h2 class="alerts-heading">Alerts</h2>
        <p class="alerts-note">Updated hourly
        \\\
        ```
    languages: [html]
    tags: [architecture, maintainability]
    source: https://google.github.io/styleguide/htmlcssguide.html#separation-of-concerns
