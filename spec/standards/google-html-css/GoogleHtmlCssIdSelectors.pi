use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssIdSelectors:
    standard: @{GoogleHtmlCss}
    ruleId: id-selectors
    title: Avoid ID selectors
    statement:
        Select elements by class rather than by ID in all situations.
    rationale:
        IDs must be unique on a page, which is hard to guarantee when many
        engineers work on many components.
    exceptions: null
    severity: null
    noncompliant:
        ```css
        \\\
        #checkout-button {}
        \\\
        ```
    compliant:
        ```css
        \\\
        .checkout-button {}
        \\\
        ```
    languages: [css]
    tags: [selectors]
    source: https://google.github.io/styleguide/htmlcssguide.html#id-selectors
