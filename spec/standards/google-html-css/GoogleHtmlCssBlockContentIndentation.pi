use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssBlockContentIndentation:
    standard: @{GoogleHtmlCss}
    ruleId: block-content-indentation
    title: Indent all block content
    statement:
        Indent everything inside a block, including rules nested inside
        rules and declarations.
    rationale:
        Indentation reflects the hierarchy and makes it easier to
        understand.
    exceptions: null
    severity: null
    noncompliant:
        ```css
        \\\
        @media print {
        .nav {
        display: none;
        }
        }
        \\\
        ```
    compliant:
        ```css
        \\\
        @media print {
          .nav {
            display: none;
          }
        }
        \\\
        ```
    languages: [css]
    tags: [formatting, indentation]
    source: https://google.github.io/styleguide/htmlcssguide.html#block-content-indentation
