use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssHtmlQuotationMarks:
    standard: @{GoogleHtmlCss}
    ruleId: html-quotation-marks
    title: Use double quotation marks for attribute values
    statement:
        Quote attribute values with double quotation marks rather than
        single ones.
    rationale:
        One quoting style keeps markup consistent.
    exceptions: null
    severity: null
    noncompliant:
        ```html
        \\\
        <a class='nav-link' href='/docs'>Docs</a>
        \\\
        ```
    compliant:
        ```html
        \\\
        <a class="nav-link" href="/docs">Docs</a>
        \\\
        ```
    languages: [html]
    tags: [formatting, quotes]
    source: https://google.github.io/styleguide/htmlcssguide.html#html-quotation-marks
