use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssPartingWords:
    standard: @{GoogleHtmlCss}
    ruleId: parting-words
    title: Be consistent with the surrounding code
    statement:
        When editing code, look at the style around it and follow it, such
        as its spacing and comment style.
    rationale:
        Style rules give a common vocabulary so readers can focus on what
        code says. Code that looks very different from its surroundings
        breaks the reader's rhythm.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [html, css]
    tags: [consistency]
    source: https://google.github.io/styleguide/htmlcssguide.html#parting-words
