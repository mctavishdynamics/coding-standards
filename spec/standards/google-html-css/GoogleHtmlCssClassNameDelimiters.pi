use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssClassNameDelimiters:
    standard: @{GoogleHtmlCss}
    ruleId: class-name-delimiters
    title: Separate words in class names with hyphens
    statement:
        Join words and abbreviations in class names only with hyphens, not
        with underscores, other characters or nothing at all.
    rationale:
        Hyphens make names easier to understand and to scan.
    exceptions: null
    severity: null
    noncompliant:
        ```css
        \\\
        .searchresults {}
        .search_result {}
        \\\
        ```
    compliant:
        ```css
        \\\
        .search-results {}
        .search-result {}
        \\\
        ```
    languages: [css]
    tags: [naming, selectors]
    source: https://google.github.io/styleguide/htmlcssguide.html#class-name-delimiters
