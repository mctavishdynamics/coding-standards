use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssCapitalization:
    standard: @{GoogleHtmlCss}
    ruleId: capitalization
    title: Use only lowercase
    statement:
        Write element names, attributes, attribute values, CSS selectors,
        properties and property values in lower case.
    rationale:
        A single case is easier to read and to search.
    exceptions:
        Text and CDATA attribute values and CSS strings keep their own case.
    severity: null
    noncompliant:
        ```html
        \\\
        <A HREF="/contact">Contact</A>
        <style>
          .banner { COLOR: #FFCC00; }
        </style>
        \\\
        ```
    compliant:
        ```html
        \\\
        <a href="/contact">Contact</a>
        <style>
          .banner { color: #ffcc00; }
        </style>
        \\\
        ```
    languages: [html, css]
    tags: [formatting, case]
    source: https://google.github.io/styleguide/htmlcssguide.html#capitalization
