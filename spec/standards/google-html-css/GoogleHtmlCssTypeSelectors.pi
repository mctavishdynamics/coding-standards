use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssTypeSelectors:
    standard: @{GoogleHtmlCss}
    ruleId: type-selectors
    title: Do not prefix class selectors with element names
    statement:
        Do not combine element names with class names in selectors unless it
        is necessary, as it can be for helper classes.
    rationale:
        Avoiding unnecessary qualifiers and ancestor selectors helps
        performance.
    exceptions: null
    severity: null
    noncompliant:
        ```css
        \\\
        div.alert {}
        ul.menu {}
        \\\
        ```
    compliant:
        ```css
        \\\
        .alert {}
        .menu {}
        \\\
        ```
    languages: [css]
    tags: [selectors, performance]
    source: https://google.github.io/styleguide/htmlcssguide.html#type-selectors
