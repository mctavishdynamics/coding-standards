use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssShorthandProperties:
    standard: @{GoogleHtmlCss}
    ruleId: shorthand-properties
    title: Use shorthand properties where possible
    statement:
        Use shorthand properties such as font, margin and padding wherever
        possible, even when only one value is set explicitly.
    rationale:
        Shorthands make code more efficient and easier to understand.
    exceptions: null
    severity: null
    noncompliant:
        ```css
        \\\
        margin-top: 0;
        margin-right: 1em;
        margin-bottom: 2em;
        margin-left: 1em;
        \\\
        ```
    compliant:
        ```css
        \\\
        margin: 0 1em 2em;
        \\\
        ```
    languages: [css]
    tags: [properties, efficiency]
    source: https://google.github.io/styleguide/htmlcssguide.html#shorthand-properties
