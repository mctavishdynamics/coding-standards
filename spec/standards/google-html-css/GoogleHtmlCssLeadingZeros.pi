use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssLeadingZeros:
    standard: @{GoogleHtmlCss}
    ruleId: leading-0s
    title: Always include leading zeros in values
    statement:
        Put a 0 in front of values and lengths between -1 and 1.
    rationale:
        The leading zero makes the decimal point and the value easier to
        read.
    exceptions: null
    severity: null
    noncompliant:
        ```css
        \\\
        opacity: .5;
        \\\
        ```
    compliant:
        ```css
        \\\
        opacity: 0.5;
        \\\
        ```
    languages: [css]
    tags: [values, formatting]
    source: https://google.github.io/styleguide/htmlcssguide.html#leading-0s
