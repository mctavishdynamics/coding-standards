use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssClassNameStyle:
    standard: @{GoogleHtmlCss}
    ruleId: class-name-style
    title: Make class names brief yet descriptive enough
    statement:
        Choose class names that convey what the class is about while staying
        brief.
    rationale:
        Brief but clear names balance understandability with code
        efficiency.
    exceptions: null
    severity: null
    noncompliant:
        ```css
        \\\
        .primary-navigation-container {}
        .pg {}
        \\\
        ```
    compliant:
        ```css
        \\\
        .nav {}
        .pager {}
        \\\
        ```
    languages: [css]
    tags: [naming, selectors]
    source: https://google.github.io/styleguide/htmlcssguide.html#class-name-style
