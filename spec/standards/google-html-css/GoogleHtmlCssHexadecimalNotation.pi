use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssHexadecimalNotation:
    standard: @{GoogleHtmlCss}
    ruleId: hexadecimal-notation
    title: Prefer the three-character hex form of a color when it exists
    statement:
        Write colour values in the three-character hexadecimal form when the
        colour allows it.
    rationale:
        The short form is shorter and more succinct.
    exceptions: null
    severity: null
    noncompliant:
        ```css
        \\\
        color: #ff0000;
        \\\
        ```
    compliant:
        ```css
        \\\
        color: #f00;
        \\\
        ```
    languages: [css]
    tags: [values, colors]
    source: https://google.github.io/styleguide/htmlcssguide.html#hexadecimal-notation
