use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssCssValidity:
    standard: @{GoogleHtmlCss}
    ruleId: css-validity
    title: Use valid CSS where possible
    statement:
        Write valid CSS and check it with a tool such as the W3C CSS
        validator.
    rationale:
        Valid CSS is a measurable baseline of quality that reveals code with
        no effect, which can be removed.
    exceptions:
        Invalid CSS is acceptable when working around validator bugs or when
        proprietary syntax is required.
    severity: null
    noncompliant:
        ```css
        \\\
        .card {
          padding: 8px 16px 8px 16px 4px;
        }
        \\\
        ```
    compliant:
        ```css
        \\\
        .card {
          padding: 8px 16px;
        }
        \\\
        ```
    languages: [css]
    tags: [validity, quality]
    source: https://google.github.io/styleguide/htmlcssguide.html#css-validity
