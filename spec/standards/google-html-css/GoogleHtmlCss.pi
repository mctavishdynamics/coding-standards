use ../lib/CodingStandard

from ./GoogleHtmlCssActionItems import GoogleHtmlCssActionItems
from ./GoogleHtmlCssBlockContentIndentation import
    GoogleHtmlCssBlockContentIndentation
from ./GoogleHtmlCssCapitalization import GoogleHtmlCssCapitalization
from ./GoogleHtmlCssClassNameDelimiters import GoogleHtmlCssClassNameDelimiters
from ./GoogleHtmlCssClassNameStyle import GoogleHtmlCssClassNameStyle
from ./GoogleHtmlCssClassNaming import GoogleHtmlCssClassNaming
from ./GoogleHtmlCssComments import GoogleHtmlCssComments
from ./GoogleHtmlCssCssQuotationMarks import GoogleHtmlCssCssQuotationMarks
from ./GoogleHtmlCssCssValidity import GoogleHtmlCssCssValidity
from ./GoogleHtmlCssDeclarationBlockSeparation import
    GoogleHtmlCssDeclarationBlockSeparation
from ./GoogleHtmlCssDeclarationOrder import GoogleHtmlCssDeclarationOrder
from ./GoogleHtmlCssDeclarationStops import GoogleHtmlCssDeclarationStops
from ./GoogleHtmlCssDocumentType import GoogleHtmlCssDocumentType
from ./GoogleHtmlCssEncoding import GoogleHtmlCssEncoding
from ./GoogleHtmlCssEntityReferences import GoogleHtmlCssEntityReferences
from ./GoogleHtmlCssGeneralFormatting import GoogleHtmlCssGeneralFormatting
from ./GoogleHtmlCssHacks import GoogleHtmlCssHacks
from ./GoogleHtmlCssHexadecimalNotation import GoogleHtmlCssHexadecimalNotation
from ./GoogleHtmlCssHtmlLineWrapping import GoogleHtmlCssHtmlLineWrapping
from ./GoogleHtmlCssHtmlQuotationMarks import GoogleHtmlCssHtmlQuotationMarks
from ./GoogleHtmlCssHtmlValidity import GoogleHtmlCssHtmlValidity
from ./GoogleHtmlCssIdAttributes import GoogleHtmlCssIdAttributes
from ./GoogleHtmlCssIdSelectors import GoogleHtmlCssIdSelectors
from ./GoogleHtmlCssImportantDeclarations import
    GoogleHtmlCssImportantDeclarations
from ./GoogleHtmlCssIndentation import GoogleHtmlCssIndentation
from ./GoogleHtmlCssLeadingZeros import GoogleHtmlCssLeadingZeros
from ./GoogleHtmlCssMultimediaFallback import GoogleHtmlCssMultimediaFallback
from ./GoogleHtmlCssOptionalTags import GoogleHtmlCssOptionalTags
from ./GoogleHtmlCssPartingWords import GoogleHtmlCssPartingWords
from ./GoogleHtmlCssPrefixes import GoogleHtmlCssPrefixes
from ./GoogleHtmlCssPropertyNameStops import GoogleHtmlCssPropertyNameStops
from ./GoogleHtmlCssProtocol import GoogleHtmlCssProtocol
from ./GoogleHtmlCssRuleSeparation import GoogleHtmlCssRuleSeparation
from ./GoogleHtmlCssSectionComments import GoogleHtmlCssSectionComments
from ./GoogleHtmlCssSelectorAndDeclarationSeparation import
    GoogleHtmlCssSelectorAndDeclarationSeparation
from ./GoogleHtmlCssSemantics import GoogleHtmlCssSemantics
from ./GoogleHtmlCssSeparationOfConcerns import
    GoogleHtmlCssSeparationOfConcerns
from ./GoogleHtmlCssShorthandProperties import GoogleHtmlCssShorthandProperties
from ./GoogleHtmlCssTrailingWhitespace import GoogleHtmlCssTrailingWhitespace
from ./GoogleHtmlCssTypeAttributes import GoogleHtmlCssTypeAttributes
from ./GoogleHtmlCssTypeSelectors import GoogleHtmlCssTypeSelectors
from ./GoogleHtmlCssZeroAndUnits import GoogleHtmlCssZeroAndUnits

export coding-standard GoogleHtmlCss:
    title: Google HTML/CSS Style Guide
    publisher: Google
    url: https://google.github.io/styleguide/htmlcssguide.html
    version: null
    license: Creative Commons Attribution 3.0 Unported (CC BY 3.0)
    description:
        Google's formatting and style rules for HTML and CSS, covering
        general conventions, markup semantics and validity, and CSS
        selectors, values and layout.
    rules:
        - @{GoogleHtmlCssProtocol}
        - @{GoogleHtmlCssIndentation}
        - @{GoogleHtmlCssCapitalization}
        - @{GoogleHtmlCssTrailingWhitespace}
        - @{GoogleHtmlCssEncoding}
        - @{GoogleHtmlCssComments}
        - @{GoogleHtmlCssActionItems}
        - @{GoogleHtmlCssDocumentType}
        - @{GoogleHtmlCssHtmlValidity}
        - @{GoogleHtmlCssSemantics}
        - @{GoogleHtmlCssMultimediaFallback}
        - @{GoogleHtmlCssSeparationOfConcerns}
        - @{GoogleHtmlCssEntityReferences}
        - @{GoogleHtmlCssOptionalTags}
        - @{GoogleHtmlCssTypeAttributes}
        - @{GoogleHtmlCssIdAttributes}
        - @{GoogleHtmlCssGeneralFormatting}
        - @{GoogleHtmlCssHtmlLineWrapping}
        - @{GoogleHtmlCssHtmlQuotationMarks}
        - @{GoogleHtmlCssCssValidity}
        - @{GoogleHtmlCssClassNaming}
        - @{GoogleHtmlCssClassNameStyle}
        - @{GoogleHtmlCssClassNameDelimiters}
        - @{GoogleHtmlCssPrefixes}
        - @{GoogleHtmlCssTypeSelectors}
        - @{GoogleHtmlCssIdSelectors}
        - @{GoogleHtmlCssShorthandProperties}
        - @{GoogleHtmlCssZeroAndUnits}
        - @{GoogleHtmlCssLeadingZeros}
        - @{GoogleHtmlCssHexadecimalNotation}
        - @{GoogleHtmlCssImportantDeclarations}
        - @{GoogleHtmlCssHacks}
        - @{GoogleHtmlCssDeclarationOrder}
        - @{GoogleHtmlCssBlockContentIndentation}
        - @{GoogleHtmlCssDeclarationStops}
        - @{GoogleHtmlCssPropertyNameStops}
        - @{GoogleHtmlCssDeclarationBlockSeparation}
        - @{GoogleHtmlCssSelectorAndDeclarationSeparation}
        - @{GoogleHtmlCssRuleSeparation}
        - @{GoogleHtmlCssCssQuotationMarks}
        - @{GoogleHtmlCssSectionComments}
        - @{GoogleHtmlCssPartingWords}
