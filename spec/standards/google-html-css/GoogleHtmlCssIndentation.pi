use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssIndentation:
    standard: @{GoogleHtmlCss}
    ruleId: indentation
    title: Indent by 2 spaces
    statement:
        Indent HTML and CSS by two spaces at a time. Do not use tabs, and do
        not mix tabs with spaces.
    rationale:
        One indentation unit keeps files consistent between editors and
        people.
    exceptions: null
    severity: null
    noncompliant:
        ```html
        \\\
        <nav>
            <a href="/">Home</a>
        </nav>
        \\\
        ```
    compliant:
        ```html
        \\\
        <nav>
          <a href="/">Home</a>
        </nav>
        \\\
        ```
    languages: [html, css]
    tags: [formatting, indentation]
    source: https://google.github.io/styleguide/htmlcssguide.html#indentation
