use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssDeclarationStops:
    standard: @{GoogleHtmlCss}
    ruleId: declaration-stops
    title: Use a semicolon after every declaration
    statement:
        End every declaration with a semicolon, including the last one in a
        block.
    rationale:
        The trailing semicolon keeps code consistent and makes adding
        declarations safe.
    exceptions: null
    severity: null
    noncompliant:
        ```css
        \\\
        .tag {
          display: inline-block;
          margin: 0 4px
        }
        \\\
        ```
    compliant:
        ```css
        \\\
        .tag {
          display: inline-block;
          margin: 0 4px;
        }
        \\\
        ```
    languages: [css]
    tags: [formatting, syntax]
    source: https://google.github.io/styleguide/htmlcssguide.html#declaration-stops
