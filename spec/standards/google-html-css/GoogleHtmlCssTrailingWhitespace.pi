use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssTrailingWhitespace:
    standard: @{GoogleHtmlCss}
    ruleId: trailing-whitespace
    title: Remove trailing whitespace
    statement:
        Do not leave spaces or tabs at the end of lines.
    rationale:
        Trailing whitespace serves no purpose and makes diffs harder to
        read.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [html, css]
    tags: [formatting, whitespace]
    source: https://google.github.io/styleguide/htmlcssguide.html#trailing-whitespace
