use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssDeclarationBlockSeparation:
    standard: @{GoogleHtmlCss}
    ruleId: declaration-block-separation
    title: Use a space between the last selector and the declaration block
    statement:
        Put one space between the last selector and the opening brace of the
        declaration block, and keep the brace on the same line as that
        selector.
    rationale:
        A single layout for block openings keeps style sheets consistent and
        easy to scan.
    exceptions: null
    severity: null
    noncompliant:
        ```css
        \\\
        .footer{
          padding: 1em;
        }
        .header
        {
          padding: 1em;
        }
        \\\
        ```
    compliant:
        ```css
        \\\
        .footer {
          padding: 1em;
        }
        \\\
        ```
    languages: [css]
    tags: [formatting, whitespace]
    source: https://google.github.io/styleguide/htmlcssguide.html#declaration-block-separation
