use ../lib/CodingRule

from ./GoogleHtmlCss import GoogleHtmlCss

export coding-rule GoogleHtmlCssDeclarationBlockSeparation:
    standard: @{GoogleHtmlCss}
    ruleId: declaration-block-separation
    title:
        Leave one space before the opening brace of a rule
    statement:
        Separate the final selector from the declaration block's opening brace
        with a single space, and keep that brace on the selector's line.
    rationale:
        A single layout for block openings keeps style sheets consistent and
        easy to scan.
    exceptions: null
    severity: null
    noncompliant:
        ```css
        \\\
        .footer{
          padding: 1em;
        }
        .header
        {
          padding: 1em;
        }
        \\\
        ```
    compliant:
        ```css
        \\\
        .footer {
          padding: 1em;
        }
        \\\
        ```
    languages: [css]
    tags: [formatting, whitespace]
    source: https://google.github.io/styleguide/htmlcssguide.html#declaration-block-separation
