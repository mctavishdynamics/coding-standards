use ../lib/CodingStandard

from ./BeckDesignFewestElements import BeckDesignFewestElements
from ./BeckDesignNoDuplication import BeckDesignNoDuplication
from ./BeckDesignPassesTheTests import BeckDesignPassesTheTests
from ./BeckDesignRevealsIntention import BeckDesignRevealsIntention

export coding-standard BeckSimpleDesign:
    title: Kent Beck's Four Rules of Simple Design
    publisher: Kent Beck
    url: https://martinfowler.com/bliki/BeckDesignRules.html
    version: 2 March 2015
    license: Copyright Martin Fowler, all rights reserved. Items are paraphrased.
    description:
        Kent Beck's four rules of simple design from Extreme Programming, in
        Martin Fowler's ranked formulation: passes the tests, reveals
        intention, no duplication and fewest elements.
    rules:
        - @{BeckDesignPassesTheTests}
        - @{BeckDesignRevealsIntention}
        - @{BeckDesignNoDuplication}
        - @{BeckDesignFewestElements}
