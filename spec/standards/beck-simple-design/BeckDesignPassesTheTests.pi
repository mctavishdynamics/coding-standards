use ../lib/CodingRule

from ./BeckSimpleDesign import BeckSimpleDesign

export coding-rule BeckDesignPassesTheTests:
    standard: @{BeckSimpleDesign}
    ruleId: rule-1
    title: Make sure the code passes all of its tests
    statement:
        Treat working software as the first test of a simple design. Every
        change should leave the whole test suite running and passing.
    rationale:
        Whatever else a design achieves, its main job is to behave as
        intended, and the tests are the evidence that it does. This is the
        highest-priority of the four rules.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [design, testing]
    source: https://martinfowler.com/bliki/BeckDesignRules.html
