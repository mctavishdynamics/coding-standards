use ../lib/CodingRule

from ./Carmack import Carmack

export coding-rule CarmackMoveTowardPurity:
    standard: @{Carmack}
    ruleId: move-toward-purity
    title: Move functions toward purity even when full purity is out of reach
    statement:
        Make a function as pure as practical even if some side effect
        remains, such as a debug flag check or a counter.
    rationale:
        Purity is a continuum, and moving from tangled state to mostly pure
        gains far more than the last step to completely pure.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [purity, refactoring]
    source: https://www.gamedeveloper.com/programming/in-depth-functional-programming-in-c-
