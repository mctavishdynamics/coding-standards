use ../lib/CodingRule

from ./Carmack import Carmack

export coding-rule CarmackLimitMidSizedHelperObjects:
    standard: @{Carmack}
    ruleId: limit-mid-sized-helper-objects
    title: Avoid medium-sized helper objects and keep small objects functional
    statement:
        Combine code at the level of large, heavyweight objects, use fewer
        medium-sized helper objects, and make any small objects as purely
        functional as you can, if they need to exist at all.
    rationale:
        Medium helpers spread state and hide what a method modifies, while
        large units and pure small values keep the effects of code visible.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [objects, design, state]
    source: http://number-none.com/blow/john_carmack_on_inlined_code.html
