use ../lib/CodingRule

from ./Carmack import Carmack

export coding-rule CarmackWatchForHiddenState:
    standard: @{Carmack}
    ruleId: watch-for-hidden-state
    title: Notice how hidden state obscures behaviour while debugging
    statement:
        While tracking down a bug, ask which mutable state and implicit
        inputs are making the behaviour hard to see.
    rationale:
        Awareness of these hidden inputs is the first step toward writing
        code that exposes its state explicitly.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [debugging, state]
    source: https://www.gamedeveloper.com/programming/in-depth-functional-programming-in-c-
