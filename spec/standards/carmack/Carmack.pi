use ../lib/CodingStandard

from ./CarmackConstEverything import CarmackConstEverything
from ./CarmackConstOnSharedFunctions import CarmackConstOnSharedFunctions
from ./CarmackDoSharedWorkInOnePlace import CarmackDoSharedWorkInOnePlace
from ./CarmackDocumentReachableState import CarmackDocumentReachableState
from ./CarmackExecuteAndInhibit import CarmackExecuteAndInhibit
from ./CarmackFunctionalStyleWhenConvenient import
    CarmackFunctionalStyleWhenConvenient
from ./CarmackGatherComputeApply import CarmackGatherComputeApply
from ./CarmackInlineSingleCallFunctions import CarmackInlineSingleCallFunctions
from ./CarmackInlineStateChangesThenExtractPureFunctions import
    CarmackInlineStateChangesThenExtractPureFunctions
from ./CarmackKeepSequentialCodeSequential import
    CarmackKeepSequentialCodeSequential
from ./CarmackLimitMidSizedHelperObjects import
    CarmackLimitMidSizedHelperObjects
from ./CarmackMakeNearPureFunctionsPure import CarmackMakeNearPureFunctionsPure
from ./CarmackMarkSectionsInLongFunctions import
    CarmackMarkSectionsInLongFunctions
from ./CarmackMergeFunctionVariants import CarmackMergeFunctionVariants
from ./CarmackMinimizeAreaUnderIfs import CarmackMinimizeAreaUnderIfs
from ./CarmackMoveTowardPurity import CarmackMoveTowardPurity
from ./CarmackPreferExplicitLoops import CarmackPreferExplicitLoops
from ./CarmackPureConstructors import CarmackPureConstructors
from ./CarmackReduceParameterComplexity import CarmackReduceParameterComplexity
from ./CarmackReturnCopiesInsteadOfMutating import
    CarmackReturnCopiesInsteadOfMutating
from ./CarmackRunPerFrameWorkAtTopLevel import CarmackRunPerFrameWorkAtTopLevel
from ./CarmackTameTheWorstStateFirst import CarmackTameTheWorstStateFirst
from ./CarmackTestFinickyCodeAsPureFunctions import
    CarmackTestFinickyCodeAsPureFunctions
from ./CarmackWatchForHiddenState import CarmackWatchForHiddenState
from ./CarmackWeighCopyingCosts import CarmackWeighCopyingCosts
from ./CarmackWritePureFunctions import CarmackWritePureFunctions

export coding-standard Carmack:
    title: John Carmack on inlined code and functional style
    publisher: John Carmack
    url: http://number-none.com/blow/john_carmack_on_inlined_code.html
    version: 2007 email with 2014 preface; 2012 essay
    license: Copyright John Carmack, all rights reserved. Items are paraphrased.
    description:
        John Carmack's recommendations from his 2007 email on inlining code,
        with its 2014 preface, and his 2012 essay Functional Programming in
        C++, on controlling state, control flow and side effects.
    rules:
        - @{CarmackInlineStateChangesThenExtractPureFunctions}
        - @{CarmackRunPerFrameWorkAtTopLevel}
        - @{CarmackExecuteAndInhibit}
        - @{CarmackPreferExplicitLoops}
        - @{CarmackMarkSectionsInLongFunctions}
        - @{CarmackKeepSequentialCodeSequential}
        - @{CarmackInlineSingleCallFunctions}
        - @{CarmackDoSharedWorkInOnePlace}
        - @{CarmackMergeFunctionVariants}
        - @{CarmackMakeNearPureFunctionsPure}
        - @{CarmackConstOnSharedFunctions}
        - @{CarmackMinimizeAreaUnderIfs}
        - @{CarmackLimitMidSizedHelperObjects}
        - @{CarmackFunctionalStyleWhenConvenient}
        - @{CarmackWritePureFunctions}
        - @{CarmackTestFinickyCodeAsPureFunctions}
        - @{CarmackMoveTowardPurity}
        - @{CarmackTameTheWorstStateFirst}
        - @{CarmackReduceParameterComplexity}
        - @{CarmackPureConstructors}
        - @{CarmackReturnCopiesInsteadOfMutating}
        - @{CarmackWeighCopyingCosts}
        - @{CarmackDocumentReachableState}
        - @{CarmackGatherComputeApply}
        - @{CarmackConstEverything}
        - @{CarmackWatchForHiddenState}
