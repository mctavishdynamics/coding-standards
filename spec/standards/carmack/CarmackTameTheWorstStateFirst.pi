use ../lib/CodingRule

from ./Carmack import Carmack

export coding-rule CarmackTameTheWorstStateFirst:
    standard: @{Carmack}
    ruleId: tame-the-worst-state-first
    title: Bring discipline to the most tangled stateful code first
    statement:
        Spend effort on the systems with the most complex webs of state and
        assumptions, and stop more code from becoming like them, before
        polishing small, already clean functions.
    rationale:
        Avoiding the worst across a codebase matters more than perfection in
        a few low-level spots.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [state, priorities]
    source: https://www.gamedeveloper.com/programming/in-depth-functional-programming-in-c-
