use ../lib/CodingRule

from ./Carmack import Carmack

export coding-rule CarmackFunctionalStyleWhenConvenient:
    standard: @{Carmack}
    ruleId: functional-style-when-convenient
    title: Write in a functional style wherever it is convenient
    statement:
        Use a functional style in whatever language you work in. Do it
        whenever it is easy, and think hard before choosing otherwise.
    rationale:
        Many flaws come from not understanding every state code can run in;
        explicit state is easier to reason about and, when fully pure,
        cannot race between threads.
    exceptions:
        For throwaway code, do whatever is quickest, even with global state.
        For code that will live on, weigh convenience against later pain.
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [purity, concurrency]
    source: https://www.gamedeveloper.com/programming/in-depth-functional-programming-in-c-
