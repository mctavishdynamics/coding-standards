use ../lib/CodingRule

from ./Carmack import Carmack

export coding-rule CarmackKeepSequentialCodeSequential:
    standard: @{Carmack}
    ruleId: keep-sequential-code-sequential
    title: Let steps that run in sequence appear in sequence
    statement:
        When many operations must happen one after another, write them in
        that order in one place, even if the function grows beyond a page or
        two.
    rationale:
        Carmack rejects page-length limits on functions here: reading the
        steps in order shows exactly what runs first and that later steps
        run before the frame ends.
    exceptions:
        Pages of code nested inside a condition or loop are harder to
        follow, so keeping that code in its own function can still be
        justified.
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [function-length, control-flow, readability]
    source: http://number-none.com/blow/john_carmack_on_inlined_code.html
