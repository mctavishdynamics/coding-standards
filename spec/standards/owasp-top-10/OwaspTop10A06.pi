use ../lib/CodingRule

from ./OwaspTop10 import OwaspTop10

export coding-rule OwaspTop10A06:
    standard: @{OwaspTop10}
    ruleId: A06:2025
    title: Prevent insecure design
    statement:
        Follow a secure development lifecycle with security specialists,
        reuse a library of secure design patterns, and threat-model critical
        flows such as login, access control and business logic. Put security
        requirements into user stories, add plausibility checks in every
        tier, test use and misuse cases against the threat model, and
        separate tiers and tenants by design.
    rationale:
        Flawless coding cannot rescue a design that lacks a needed control or
        gets one wrong, so the risk must be removed at design time, before
        coding starts. This is category six of the 2025 OWASP Top 10.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [rank-6, design, threat-modeling, sdlc]
    source: https://owasp.org/Top10/2025/A06_2025-Insecure_Design/
