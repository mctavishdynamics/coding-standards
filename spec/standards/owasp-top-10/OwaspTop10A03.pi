use ../lib/CodingRule

from ./OwaspTop10 import OwaspTop10

export coding-rule OwaspTop10A03:
    standard: @{OwaspTop10}
    ruleId: A03:2025
    title: Prevent software supply chain failures
    statement:
        Run a patch management process that keeps a software bill of
        materials, tracks direct and transitive dependencies, removes unused
        ones, monitors vulnerability feeds, and pulls components only from
        trusted sources, preferably signed. Choose dependency versions on
        purpose, replace unmaintained components, track changes to build and
        delivery systems, harden repositories, workstations and CI with MFA
        and tight access, and roll updates out in stages.
    rationale:
        A compromised or vulnerable component, build tool or pipeline passes
        its flaw straight into everything built with it. It is the third
        category in the OWASP Top 10 for 2025.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [rank-3, dependencies, supply-chain, patching]
    source: https://owasp.org/Top10/2025/A03_2025-Software_Supply_Chain_Failures/
