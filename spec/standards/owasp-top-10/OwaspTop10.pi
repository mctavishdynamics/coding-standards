use ../lib/CodingStandard

from ./OwaspTop10A01 import OwaspTop10A01
from ./OwaspTop10A02 import OwaspTop10A02
from ./OwaspTop10A03 import OwaspTop10A03
from ./OwaspTop10A04 import OwaspTop10A04
from ./OwaspTop10A05 import OwaspTop10A05
from ./OwaspTop10A06 import OwaspTop10A06
from ./OwaspTop10A07 import OwaspTop10A07
from ./OwaspTop10A08 import OwaspTop10A08
from ./OwaspTop10A09 import OwaspTop10A09
from ./OwaspTop10A10 import OwaspTop10A10

export coding-standard OwaspTop10:
    title: OWASP Top 10
    publisher: OWASP Foundation
    url: https://owasp.org/Top10/2025/
    version: 2025
    license: Copyright OWASP Foundation, released under Creative Commons Attribution-ShareAlike 4.0 (CC BY-SA 4.0).
    description:
        The ten most critical web application security risk categories of
        2025, each written here as a rule for preventing it.
    rules:
        - @{OwaspTop10A01}
        - @{OwaspTop10A02}
        - @{OwaspTop10A03}
        - @{OwaspTop10A04}
        - @{OwaspTop10A05}
        - @{OwaspTop10A06}
        - @{OwaspTop10A07}
        - @{OwaspTop10A08}
        - @{OwaspTop10A09}
        - @{OwaspTop10A10}
