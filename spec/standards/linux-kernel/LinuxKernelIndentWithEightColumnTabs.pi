use ../lib/CodingRule

from ./LinuxKernelStyle import LinuxKernelStyle

export coding-rule LinuxKernelIndentWithEightColumnTabs:
    standard: @{LinuxKernelStyle}
    ruleId: 1a
    title: Indent with tabs that are eight columns wide
    statement:
        Use one tab per indentation level and treat a tab as eight columns.
        Do not use four- or two-column indentation.
    rationale:
        Wide indentation makes it easy to see where each block starts and
        ends, even after hours at the screen, and it warns you when code is
        nested more than about three levels deep.
    exceptions:
        Examples are omitted because this specification renders tabs as
        spaces, so they cannot show the difference.
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [formatting, indentation]
    source: https://docs.kernel.org/process/coding-style.html#indentation
