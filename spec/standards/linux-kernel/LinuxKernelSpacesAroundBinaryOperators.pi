use ../lib/CodingRule

from ./LinuxKernelStyle import LinuxKernelStyle

export coding-rule LinuxKernelSpacesAroundBinaryOperators:
    standard: @{LinuxKernelStyle}
    ruleId: 3.1e
    title: Put spaces around binary and ternary operators
    statement:
        Surround most two-operand and three-operand operators with a single
        space. That covers assignment, arithmetic, comparisons, bitwise
        operators and the conditional operator.
    rationale:
        Spacing makes the operands and operators of an expression easy to
        pick out.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        mask=(flags&FLAG_MASK)?FLAG_MASK:0;
        \\\
        ```
    compliant:
        ```c
        \\\
        mask = (flags & FLAG_MASK) ? FLAG_MASK : 0;
        \\\
        ```
    languages: [c]
    tags: [formatting, whitespace, operators]
    source: https://docs.kernel.org/process/coding-style.html#spaces
