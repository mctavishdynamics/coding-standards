use ../lib/CodingRule

from ./LinuxKernelStyle import LinuxKernelStyle

export coding-rule LinuxKernelPointerStarNextToName:
    standard: @{LinuxKernelStyle}
    ruleId: 3.1d
    title: Attach the pointer star to the name, not the type
    statement:
        When declaring a pointer variable or a function that returns a
        pointer, put the asterisk next to the variable or function name.
    rationale:
        The star binds to the declarator, so writing it by the name shows
        what is actually a pointer.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        char* dev_name;
        struct page* alloc_buffer_page(gfp_t* flags);
        \\\
        ```
    compliant:
        ```c
        \\\
        char *dev_name;
        struct page *alloc_buffer_page(gfp_t *flags);
        \\\
        ```
    languages: [c]
    tags: [formatting, whitespace, pointers]
    source: https://docs.kernel.org/process/coding-style.html#spaces
