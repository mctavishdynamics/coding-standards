use ../lib/CodingRule

from ./LinuxKernelStyle import LinuxKernelStyle

export coding-rule LinuxKernelLimitLocalVariables:
    standard: @{LinuxKernelStyle}
    ruleId: 6b
    title: Limit a function to about five to ten local variables
    statement:
        If a function needs more than five to ten local variables, rethink
        it and split it into smaller functions.
    rationale:
        People can keep track of around seven things at once, and more than
        that leads to confusion.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [functions, complexity]
    source: https://docs.kernel.org/process/coding-style.html#functions
