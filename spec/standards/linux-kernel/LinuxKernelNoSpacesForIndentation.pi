use ../lib/CodingRule

from ./LinuxKernelStyle import LinuxKernelStyle

export coding-rule LinuxKernelNoSpacesForIndentation:
    standard: @{LinuxKernelStyle}
    ruleId: 1f
    title: Never indent with spaces
    statement:
        Indent code with tabs only. Spaces are used for indentation only in
        comments, documentation and Kconfig files.
    rationale:
        Mixing spaces into tab indentation gives inconsistent layout and
        defeats the eight-column rule.
    exceptions:
        Comments, documentation and Kconfig files may use spaces. Examples
        are omitted because this specification renders tabs as spaces.
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [formatting, indentation, whitespace]
    source: https://docs.kernel.org/process/coding-style.html#indentation
