export coding-standard LinuxKernelStyle:
    title: Linux kernel coding style
    publisher: The Linux kernel community
    url: https://docs.kernel.org/process/coding-style.html
    version: null
    license: GPL-2.0-only (part of the Linux kernel documentation, covered by the kernel's COPYING file)
    description:
        The coding style the Linux kernel community expects for kernel C
        code and Kconfig files, covering layout, naming, functions, macros,
        memory allocation, messages and error handling.
    rules:
        - @{LinuxKernelIndentWithEightColumnTabs}
        - @{LinuxKernelAlignSwitchAndCaseLabels}
        - @{LinuxKernelOneStatementPerLine}
        - @{LinuxKernelNoCommaToAvoidBraces}
        - @{LinuxKernelOneAssignmentPerLine}
        - @{LinuxKernelNoSpacesForIndentation}
        - @{LinuxKernelLineLimitEightyColumns}
        - @{LinuxKernelPlaceContinuationLinesRight}
        - @{LinuxKernelDoNotSplitUserVisibleStrings}
        - @{LinuxKernelOpeningBraceEndOfLine}
        - @{LinuxKernelFunctionBraceOnNextLine}
        - @{LinuxKernelClosingBraceOwnLine}
        - @{LinuxKernelNoBracesForSingleStatement}
        - @{LinuxKernelBracesOnAllBranches}
        - @{LinuxKernelBracesForCompoundLoopBody}
        - @{LinuxKernelSpaceAfterKeywords}
        - @{LinuxKernelNoSpaceAfterSizeof}
        - @{LinuxKernelNoSpacesInsideParentheses}
        - @{LinuxKernelPointerStarNextToName}
        - @{LinuxKernelSpacesAroundBinaryOperators}
        - @{LinuxKernelNoSpacesAroundUnaryOperators}
        - @{LinuxKernelNoTrailingWhitespace}
        - @{LinuxKernelDescriptiveGlobalNames}
        - @{LinuxKernelNoHungarianNotation}
        - @{LinuxKernelShortLocalNames}
        - @{LinuxKernelAvoidNonInclusiveTerms}
        - @{LinuxKernelNoTypedefForStructsAndPointers}
        - @{LinuxKernelTypedefOpaqueObjects}
        - @{LinuxKernelTypedefClearIntegerTypes}
        - @{LinuxKernelTypedefSparseTypes}
        - @{LinuxKernelLinuxStandardIntegerTypes}
        - @{LinuxKernelUserspaceSafeTypes}
        - @{LinuxKernelShortSingleTaskFunctions}
        - @{LinuxKernelLimitLocalVariables}
        - @{LinuxKernelSeparateFunctionsExportAfter}
        - @{LinuxKernelNamePrototypeParameters}
        - @{LinuxKernelNoExternOnFunctionDeclarations}
        - @{LinuxKernelPrototypeElementOrder}
        - @{LinuxKernelGotoForCommonCleanup}
        - @{LinuxKernelDescriptiveGotoLabels}
        - @{LinuxKernelSplitErrorLabels}
        - @{LinuxKernelCommentWhatNotHow}
        - @{LinuxKernelKernelDocForApiFunctions}
        - @{LinuxKernelMultiLineCommentStyle}
        - @{LinuxKernelOneDeclarationPerLine}
        - @{LinuxKernelUseFormattingTools}
        - @{LinuxKernelKconfigIndentation}
        - @{LinuxKernelKconfigMarkDangerousOptions}
        - @{LinuxKernelReferenceCountSharedData}
        - @{LinuxKernelLockingIsNotRefcounting}
        - @{LinuxKernelCapitalizeConstantMacros}
        - @{LinuxKernelPreferEnumsForRelatedConstants}
        - @{LinuxKernelPreferInlineOverMacros}
        - @{LinuxKernelWrapMultiStatementMacros}
        - @{LinuxKernelInlineStubsForUnusedParameters}
        - @{LinuxKernelNoControlFlowInMacros}
        - @{LinuxKernelNoMagicLocalNamesInMacros}
        - @{LinuxKernelNoMacroLvalues}
        - @{LinuxKernelParenthesizeMacroExpressions}
        - @{LinuxKernelUniqueMacroLocalNames}
        - @{LinuxKernelClearCorrectMessages}
        - @{LinuxKernelNoParenthesizedNumbers}
        - @{LinuxKernelUseDeviceAndPrMacros}
        - @{LinuxKernelDebugMessageMacros}
        - @{LinuxKernelAllocateBySizeOfPointee}
        - @{LinuxKernelNoCastOfAllocatorResult}
        - @{LinuxKernelUseArrayAllocators}
        - @{LinuxKernelNoAllocationFailureMessage}
        - @{LinuxKernelInlineOnlySmallFunctions}
        - @{LinuxKernelNoInlineOnSingleUseStatics}
        - @{LinuxKernelReturnValueMatchesName}
        - @{LinuxKernelUseBoolWithTrueFalse}
        - @{LinuxKernelNoBoolInLayoutSensitiveStructs}
        - @{LinuxKernelFlagsInsteadOfBoolArguments}
        - @{LinuxKernelUseExistingKernelMacros}
        - @{LinuxKernelNoEditorModelines}
        - @{LinuxKernelAvoidGratuitousInlineAsm}
        - @{LinuxKernelLargeAsmInSFiles}
        - @{LinuxKernelVolatileAsmOnlyWhenNeeded}
        - @{LinuxKernelOneInstructionPerAsmString}
        - @{LinuxKernelNoPreprocessorConditionalsInCFiles}
        - @{LinuxKernelCompileOutWholeFunctions}
        - @{LinuxKernelMaybeUnusedOverConditionals}
        - @{LinuxKernelUseIsEnabled}
        - @{LinuxKernelCommentEndif}
        - @{LinuxKernelAvoidPanic}
        - @{LinuxKernelWarnRatherThanBug}
        - @{LinuxKernelPreferWarnOnOnce}
        - @{LinuxKernelDoNotWarnLightly}
        - @{LinuxKernelDoNotAvoidWarnForPanicOnWarn}
        - @{LinuxKernelUseBuildBugOn}
