use ../lib/CodingRule

from ./LinuxKernelStyle import LinuxKernelStyle

export coding-rule LinuxKernelUseExistingKernelMacros:
    standard: @{LinuxKernelStyle}
    ruleId: 18
    title: Use the kernel's existing helper macros
    statement:
        Use the macros already provided in the kernel headers, such as
        ARRAY_SIZE, sizeof_field, min and max, rather than writing your own
        versions.
    rationale:
        The shared macros are tested and often do extra checks, such as the
        strict type checking in min and max.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        #define NUM_ENTRIES(a) (sizeof(a) / sizeof(a[0]))

        for (i = 0; i < NUM_ENTRIES(rates); i++)
        \\\
        ```
    compliant:
        ```c
        \\\
        for (i = 0; i < ARRAY_SIZE(rates); i++)
        \\\
        ```
    languages: [c]
    tags: [macros, reuse]
    source: https://docs.kernel.org/process/coding-style.html#don-t-re-invent-the-kernel-macros
