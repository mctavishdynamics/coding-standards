use ../lib/CodingRule

from ./LinuxKernelStyle import LinuxKernelStyle

export coding-rule LinuxKernelShortSingleTaskFunctions:
    standard: @{LinuxKernelStyle}
    ruleId: 6a
    title: Keep functions short and focused on one thing
    statement:
        Write functions that do one thing and fit on one or two screens of
        80 by 24 characters. The more complex and deeply indented a function
        is, the shorter it should be; move parts into well-named helper
        functions.
    rationale:
        Short, single-purpose functions are easier to understand, and the
        compiler can inline helpers when that matters for speed.
    exceptions:
        A simple function that is one long switch with many small cases may
        be longer.
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [functions, complexity]
    source: https://docs.kernel.org/process/coding-style.html#functions
