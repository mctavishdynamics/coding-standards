use ../lib/CodingRule

from ./LinuxKernelStyle import LinuxKernelStyle

export coding-rule LinuxKernelUseFormattingTools:
    standard: @{LinuxKernelStyle}
    ruleId: 9
    title: Configure editors and formatters for kernel style
    statement:
        If your editor or formatter does not produce kernel style, set it up
        to do so: configure emacs for the kernel, run indent with the K&R
        and eight-column options or scripts/Lindent, use clang-format with
        the kernel configuration, and rely on EditorConfig support for basic
        settings.
    rationale:
        Default settings of tools such as GNU emacs and indent do not match
        kernel style. A formatter still does not fix bad programming.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [tooling, formatting]
    source: https://docs.kernel.org/process/coding-style.html#you-ve-made-a-mess-of-it
