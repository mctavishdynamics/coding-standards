use ../lib/CodingRule

from ./LinuxKernelStyle import LinuxKernelStyle

export coding-rule LinuxKernelDoNotAvoidWarnForPanicOnWarn:
    standard: @{LinuxKernelStyle}
    ruleId: 22e
    title: Do not avoid justified WARNs because of panic_on_warn
    statement:
        Use WARN judiciously, but do not refuse to use it just because some
        users enable panic_on_warn.
    rationale:
        Users who enable panic_on_warn have asked for a crash when a WARN
        fires and must accept that their systems crash more often.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [error-handling, assertions]
    source: https://docs.kernel.org/process/coding-style.html#do-not-worry-about-panic-on-warn-users
