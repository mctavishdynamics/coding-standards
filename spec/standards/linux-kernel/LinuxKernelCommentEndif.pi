use ../lib/CodingRule

from ./LinuxKernelStyle import LinuxKernelStyle

export coding-rule LinuxKernelCommentEndif:
    standard: @{LinuxKernelStyle}
    ruleId: 21e
    title: Name the condition in a comment after a long block's endif
    statement:
        When a conditional block runs longer than a few lines and is not
        trivial, annotate its endif with a comment naming the condition.
    rationale:
        The comment shows which block is closing without scrolling back to
        find the opening directive.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        #ifdef CONFIG_ACPI
        /* ... many lines ... */
        #endif
        \\\
        ```
    compliant:
        ```c
        \\\
        #ifdef CONFIG_ACPI
        /* ... many lines ... */
        #endif /* CONFIG_ACPI */
        \\\
        ```
    languages: [c]
    tags: [preprocessor, comments]
    source: https://docs.kernel.org/process/coding-style.html#conditional-compilation
