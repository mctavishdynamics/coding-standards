use ../lib/CodingRule

from ./LinuxKernelStyle import LinuxKernelStyle

export coding-rule LinuxKernelKconfigIndentation:
    standard: @{LinuxKernelStyle}
    ruleId: 10a
    title: Indent Kconfig entries with a tab and help text two spaces more
    statement:
        In Kconfig files, indent the lines under a config entry with one
        tab, and indent help text with one tab plus two spaces.
    rationale:
        This is the layout used by every Kconfig file in the tree.
    exceptions:
        Examples are omitted because this specification renders tabs as
        spaces and cannot show the required mix of tabs and spaces.
    severity: null
    noncompliant: null
    compliant: null
    languages: [kconfig]
    tags: [kconfig, indentation, formatting]
    source: https://docs.kernel.org/process/coding-style.html#kconfig-configuration-files
