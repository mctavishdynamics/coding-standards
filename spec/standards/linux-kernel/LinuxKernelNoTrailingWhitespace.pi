use ../lib/CodingRule

from ./LinuxKernelStyle import LinuxKernelStyle

export coding-rule LinuxKernelNoTrailingWhitespace:
    standard: @{LinuxKernelStyle}
    ruleId: 3.1g
    title: Do not leave trailing whitespace
    statement:
        Remove spaces and tabs at the ends of lines, including blank lines
        that an editor left indented.
    rationale:
        Git complains when a patch introduces trailing whitespace, and if the
        whitespace is removed while a patch series is being applied, the
        patches that come afterwards may no longer apply.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [formatting, whitespace]
    source: https://docs.kernel.org/process/coding-style.html#spaces
