use ../lib/CodingRule

from ./LinuxKernelStyle import LinuxKernelStyle

export coding-rule LinuxKernelOpeningBraceEndOfLine:
    standard: @{LinuxKernelStyle}
    ruleId: 3a
    title: Put the opening brace of a block at the end of the line
    statement:
        Following Kernighan and Ritchie, a block opened by if, switch, for,
        while or do puts its opening brace as the last character of the line
        that starts it, and its closing brace begins a line of its own.
    rationale:
        This is the K&R convention, and it uses fewer nearly empty lines
        without hurting readability.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        for (i = 0; i < n; i++)
        {
                sum += values[i];
                count++;
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        for (i = 0; i < n; i++) {
                sum += values[i];
                count++;
        }
        \\\
        ```
    languages: [c]
    tags: [formatting, braces]
    source: https://docs.kernel.org/process/coding-style.html#placing-braces-and-spaces
