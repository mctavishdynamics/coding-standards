export coding-standard GoogleTypeScript:
    title: Google TypeScript Style Guide
    publisher: Google
    url: https://google.github.io/styleguide/tsguide.html
    version: null
    license: CC BY 3.0
    description:
        Google's style rules for TypeScript, covering source files, imports and
        exports, language features, naming, the type system, tooling and
        comments. Adapted from Google's internal guide for external use.
    rules:
        - @{GoogleTypeScriptFileEncodingUtf8}
        - @{GoogleTypeScriptWhitespaceCharacters}
        - @{GoogleTypeScriptSpecialEscapeSequences}
        - @{GoogleTypeScriptNonAsciiCharacters}
        - @{GoogleTypeScriptSourceFileStructure}
        - @{GoogleTypeScriptFileCopyright}
        - @{GoogleTypeScriptFileoverview}
        - @{GoogleTypeScriptImports}
        - @{GoogleTypeScriptImportPaths}
        - @{GoogleTypeScriptNamespaceVersusNamedImports}
        - @{GoogleTypeScriptJspbImportByPath}
        - @{GoogleTypeScriptRenamingImports}
        - @{GoogleTypeScriptExports}
        - @{GoogleTypeScriptExportVisibility}
        - @{GoogleTypeScriptMutableExports}
        - @{GoogleTypeScriptContainerClasses}
        - @{GoogleTypeScriptImportType}
        - @{GoogleTypeScriptExportType}
        - @{GoogleTypeScriptUseModulesNotNamespaces}
        - @{GoogleTypeScriptUseConstAndLet}
        - @{GoogleTypeScriptOneVariablePerDeclaration}
        - @{GoogleTypeScriptArrayConstructor}
        - @{GoogleTypeScriptDoNotDefinePropertiesOnArrays}
        - @{GoogleTypeScriptArraySpreadSyntax}
        - @{GoogleTypeScriptArrayDestructuring}
        - @{GoogleTypeScriptObjectConstructor}
        - @{GoogleTypeScriptIteratingObjects}
        - @{GoogleTypeScriptObjectSpreadSyntax}
        - @{GoogleTypeScriptComputedPropertyNames}
        - @{GoogleTypeScriptObjectDestructuring}
        - @{GoogleTypeScriptClassDeclarations}
        - @{GoogleTypeScriptClassMethodDeclarations}
        - @{GoogleTypeScriptOverridingTostring}
        - @{GoogleTypeScriptAvoidPrivateStaticMethods}
        - @{GoogleTypeScriptAvoidStaticMethodDynamicDispatch}
        - @{GoogleTypeScriptStaticThis}
        - @{GoogleTypeScriptConstructors}
        - @{GoogleTypeScriptPrivateFields}
        - @{GoogleTypeScriptUseReadonly}
        - @{GoogleTypeScriptParameterProperties}
        - @{GoogleTypeScriptFieldInitializers}
        - @{GoogleTypeScriptPropertiesUsedOutsideOfClassLexicalScope}
        - @{GoogleTypeScriptClassesGettersAndSetters}
        - @{GoogleTypeScriptClassComputedProperties}
        - @{GoogleTypeScriptVisibility}
        - @{GoogleTypeScriptClassPrototypes}
        - @{GoogleTypeScriptFunctionDeclarations}
        - @{GoogleTypeScriptNestedFunctions}
        - @{GoogleTypeScriptFunctionExpressions}
        - @{GoogleTypeScriptArrowFunctionBodies}
        - @{GoogleTypeScriptRebindingThis}
        - @{GoogleTypeScriptFunctionsAsCallbacks}
        - @{GoogleTypeScriptArrowFunctionsAsProperties}
        - @{GoogleTypeScriptEventHandlers}
        - @{GoogleTypeScriptParameterInitializers}
        - @{GoogleTypeScriptRestAndSpread}
        - @{GoogleTypeScriptFormattingFunctions}
        - @{GoogleTypeScriptFeaturesThis}
        - @{GoogleTypeScriptUseSingleQuotes}
        - @{GoogleTypeScriptNoLineContinuations}
        - @{GoogleTypeScriptTemplateLiterals}
        - @{GoogleTypeScriptNumberLiterals}
        - @{GoogleTypeScriptTypeCoercion}
        - @{GoogleTypeScriptImplicitCoercion}
        - @{GoogleTypeScriptControlFlowStatementsBlocks}
        - @{GoogleTypeScriptAssignmentInControlStatements}
        - @{GoogleTypeScriptIteratingContainers}
        - @{GoogleTypeScriptGroupingParentheses}
        - @{GoogleTypeScriptExceptionHandling}
        - @{GoogleTypeScriptInstantiateErrorsUsingNew}
        - @{GoogleTypeScriptOnlyThrowErrors}
        - @{GoogleTypeScriptCatchingAndRethrowing}
        - @{GoogleTypeScriptEmptyCatchBlocks}
        - @{GoogleTypeScriptSwitchStatements}
        - @{GoogleTypeScriptEqualityChecks}
        - @{GoogleTypeScriptTypeAndNonNullabilityAssertions}
