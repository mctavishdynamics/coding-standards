        - @{GoogleTypeScriptNonStandardFeatures}
        - @{GoogleTypeScriptModifyingBuiltinObjects}
        - @{GoogleTypeScriptIdentifiers}
        - @{GoogleTypeScriptNamingStyle}
        - @{GoogleTypeScriptDescriptiveNames}
        - @{GoogleTypeScriptCamelCase}
        - @{GoogleTypeScriptIdentifiersDollarSign}
        - @{GoogleTypeScriptNamingRulesByIdentifierType}
        - @{GoogleTypeScriptIdentifiersTypeParameters}
        - @{GoogleTypeScriptIdentifiersTestNames}
        - @{GoogleTypeScriptIdentifiersUnderscorePrefixSuffix}
        - @{GoogleTypeScriptIdentifiersImports}
        - @{GoogleTypeScriptIdentifiersConstants}
        - @{GoogleTypeScriptAliases}
        - @{GoogleTypeScriptTypeInference}
