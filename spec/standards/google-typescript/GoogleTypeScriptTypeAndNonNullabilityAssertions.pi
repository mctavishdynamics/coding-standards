use ../lib/CodingRule

from ./GoogleTypeScript import GoogleTypeScript

export coding-rule GoogleTypeScriptTypeAndNonNullabilityAssertions:
    standard: @{GoogleTypeScript}
    ruleId: type-and-non-nullability-assertions
    title: Avoid type and non-null assertions without a clear reason
    statement:
        Use as casts and non-null assertions only when a clear reason
        exists. A runtime check is preferable, and when an assertion is
        truly safe, leave a comment saying why unless it is self-evident.
    rationale:
        Assertions only silence the compiler and add no runtime check, so a
        wrong one crashes the program later.
    exceptions: null
    severity: null
    noncompliant:
        ```typescript
        \\\
        (shape as Circle).radius;
        user!.email.toLowerCase();
        \\\
        ```
    compliant:
        ```typescript
        \\\
        if (shape instanceof Circle) {
          shape.radius;
        }
        if (user) {
          user.email.toLowerCase();
        }
        \\\
        ```
    languages: [typescript]
    tags: [types, assertions, null-safety]
    source: https://google.github.io/styleguide/tsguide.html#type-and-non-nullability-assertions
