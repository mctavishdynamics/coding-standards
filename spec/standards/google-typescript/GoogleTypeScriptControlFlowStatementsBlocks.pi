use ../lib/CodingRule

from ./GoogleTypeScript import GoogleTypeScript

export coding-rule GoogleTypeScriptControlFlowStatementsBlocks:
    standard: @{GoogleTypeScript}
    ruleId: control-flow-statements-blocks
    title: Always use braces for control flow bodies
    statement:
        Control flow statements always use braced blocks, even for a single
        statement, and the first statement of a non-empty block starts on
        its own line.
    rationale:
        Braces prevent bugs when statements are added later and keep layout
        consistent.
    exceptions:
        An if statement that fits entirely on one line may omit the block.
    severity: null
    noncompliant:
        ```typescript
        \\\
        for (const file of files) upload(file);

        if (failed)
          retryEverythingThatFailedDuringTheLastUpload(files);
        \\\
        ```
    compliant:
        ```typescript
        \\\
        for (const file of files) {
          upload(file);
        }

        if (failed) retry(files);
        \\\
        ```
    languages: [typescript]
    tags: [control-flow, formatting, braces]
    source: https://google.github.io/styleguide/tsguide.html#control-flow-statements-blocks
