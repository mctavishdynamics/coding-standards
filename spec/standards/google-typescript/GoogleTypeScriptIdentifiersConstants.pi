use ../lib/CodingRule

from ./GoogleTypeScript import GoogleTypeScript

export coding-rule GoogleTypeScriptIdentifiersConstants:
    standard: @{GoogleTypeScript}
    ruleId: identifiers-constants
    title: Use CONSTANT_CASE only for module-level constants
    statement:
        CONSTANT_CASE marks a value that must not be changed, even if it is
        not deeply frozen. Use it only for module-level symbols, static
        fields of module-level classes and values of module-level enums;
        values that can be created more than once use lowerCamelCase.
    rationale:
        The casing signals a single, fixed value for the whole program,
        which is false for locals created on each call.
    exceptions:
        An arrow function that implements an interface may be declared in
        lowerCamelCase.
    severity: null
    noncompliant:
        ```typescript
        \\\
        function render() {
          const MAX_ROWS = 50;
          return rows.slice(0, MAX_ROWS);
        }
        \\\
        ```
    compliant:
        ```typescript
        \\\
        const MAX_ROWS = 50;

        function render() {
          const visibleRows = rows.slice(0, MAX_ROWS);
          return visibleRows;
        }
        \\\
        ```
    languages: [typescript]
    tags: [naming, constants]
    source: https://google.github.io/styleguide/tsguide.html#identifiers-constants
