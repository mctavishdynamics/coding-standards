use ../lib/CodingRule

from ./GoogleTypeScript import GoogleTypeScript

export coding-rule GoogleTypeScriptIdentifiersConstants:
    standard: @{GoogleTypeScript}
    ruleId: identifiers-constants
    title: Use CONSTANT_CASE only for module-level constants
    statement:
        CONSTANT_CASE says a value is fixed and must not be modified, whether or
        not it is deeply immutable. Reserve it for symbols declared at module
        scope, static fields on classes declared at module scope, and members of
        module scope enums. Anything that may be created more than once is
        lowerCamelCase.
    rationale:
        The casing signals a single, fixed value for the whole program,
        which is false for locals created on each call.
    exceptions:
        When an arrow function is the implementation of an interface,
        lowerCamelCase is acceptable for its name.
    severity: null
    noncompliant:
        ```typescript
        \\\
        function render() {
          const MAX_ROWS = 50;
          return rows.slice(0, MAX_ROWS);
        }
        \\\
        ```
    compliant:
        ```typescript
        \\\
        const MAX_ROWS = 50;

        function render() {
          const visibleRows = rows.slice(0, MAX_ROWS);
          return visibleRows;
        }
        \\\
        ```
    languages: [typescript]
    tags: [naming, constants]
    source: https://google.github.io/styleguide/tsguide.html#identifiers-constants
