use ../lib/CodingRule

from ./GoogleTypeScript import GoogleTypeScript

export coding-rule GoogleTypeScriptGroupingParentheses:
    standard: @{GoogleTypeScript}
    ruleId: grouping-parentheses
    title: Keep grouping parentheses that aid reading
    statement:
        Drop optional grouping parentheses only if both the writer and the
        code reviewer agree the expression is still clear. Do not wrap the
        whole operand of typeof, delete or void, the expression after
        return, throw, case or yield, or the right operand of in or of in
        parentheses.
    rationale:
        Readers should not need the full precedence table to understand an
        expression, but parentheses around a whole operand are just noise.
    exceptions: null
    severity: null
    noncompliant:
        ```typescript
        \\\
        const ok = a && b || c && !d;
        return (total);
        \\\
        ```
    compliant:
        ```typescript
        \\\
        const ok = (a && b) || (c && !d);
        return total;
        \\\
        ```
    languages: [typescript]
    tags: [formatting, expressions, readability]
    source: https://google.github.io/styleguide/tsguide.html#grouping-parentheses
