use ../lib/CodingRule

from ./GoogleTypeScript import GoogleTypeScript

export coding-rule GoogleTypeScriptTemplateLiterals:
    standard: @{GoogleTypeScript}
    ruleId: template-literals
    title: Use template literals instead of complex concatenation
    statement:
        Choose a template literal over string concatenation once it gets
        complicated, particularly with several fixed parts. Lines inside a
        template literal that spans lines can ignore the indentation of the
        code around them.
    rationale:
        Template literals show the final text in one piece and make
        interpolated values easy to see.
    exceptions: null
    severity: null
    noncompliant:
        ```typescript
        \\\
        const line = 'Order ' + order.id + ' for ' + order.customer + ' totals ' +
            order.total + ' EUR';
        \\\
        ```
    compliant:
        ```typescript
        \\\
        const line =
            `Order ${order.id} for ${order.customer} totals ${order.total} EUR`;
        \\\
        ```
    languages: [typescript]
    tags: [strings, readability]
    source: https://google.github.io/styleguide/tsguide.html#template-literals
