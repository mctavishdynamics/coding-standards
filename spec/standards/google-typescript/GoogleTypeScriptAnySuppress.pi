use ../lib/CodingRule

from ./GoogleTypeScript import GoogleTypeScript

export coding-rule GoogleTypeScriptAnySuppress:
    standard: @{GoogleTypeScript}
    ruleId: any-suppress
    title: Suppress and document legitimate uses of any
    statement:
        Where any is genuinely warranted, for instance in a partial test
        mock, disable the lint check with a comment and state why the
        exception is justified.
    rationale:
        The comment makes the unsafe spot visible and tells reviewers it was
        a deliberate choice.
    exceptions: null
    severity: null
    noncompliant:
        ```typescript
        \\\
        const mockClock = {now: () => 0} as any as Clock;
        \\\
        ```
    compliant:
        ```typescript
        \\\
        // Only now() is called by the code under test.
        // tslint:disable-next-line:no-any
        const mockClock = {now: () => 0} as any as Clock;
        \\\
        ```
    languages: [typescript]
    tags: [types, any, testing]
    source: https://google.github.io/styleguide/tsguide.html#any-suppress
