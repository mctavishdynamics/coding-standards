use ../lib/CodingRule

from ./GoogleTypeScript import GoogleTypeScript

export coding-rule GoogleTypeScriptNamingRulesByIdentifierType:
    standard: @{GoogleTypeScript}
    ruleId: naming-rules-by-identifier-type
    title: Case identifiers according to their kind
    statement:
        Use UpperCamelCase for classes, interfaces, types, enums,
        decorators, type parameters and TSX component functions. Use
        lowerCamelCase for variables, parameters, functions, methods,
        properties and module aliases. Use CONSTANT_CASE for global
        constants and enum values.
    rationale:
        Casing that follows the kind of identifier tells readers what a name
        is at a glance.
    exceptions: null
    severity: null
    noncompliant:
        ```typescript
        \\\
        class order_item {}
        enum Color { Red, Green }
        function FormatPrice(amount: number) {}
        \\\
        ```
    compliant:
        ```typescript
        \\\
        class OrderItem {}
        enum Color { RED, GREEN }
        function formatPrice(amount: number) {}
        \\\
        ```
    languages: [typescript]
    tags: [naming, casing]
    source: https://google.github.io/styleguide/tsguide.html#naming-rules-by-identifier-type
