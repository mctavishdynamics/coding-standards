use ../lib/CodingRule

from ./GoogleTypeScript import GoogleTypeScript

export coding-rule GoogleTypeScriptConsistency:
    standard: @{GoogleTypeScript}
    ruleId: consistency
    title: Follow the style of the surrounding code where the guide is silent
    statement:
        For questions the guide does not settle, match the rest of the file,
        then other files in the same directory. New files must use Google
        style; new code in a non-conforming file should match its
        surroundings but must not break the guide.
    rationale:
        Consistency makes code easier to read, and the guide still sets the
        floor for all new code.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [typescript]
    tags: [consistency, policy]
    source: https://google.github.io/styleguide/tsguide.html#consistency
