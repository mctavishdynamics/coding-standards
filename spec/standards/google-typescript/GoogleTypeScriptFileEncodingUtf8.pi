use ../lib/CodingRule

from ./GoogleTypeScript import GoogleTypeScript

export coding-rule GoogleTypeScriptFileEncodingUtf8:
    standard: @{GoogleTypeScript}
    ruleId: file-encoding-utf-8
    title: Encode source files in UTF-8
    statement:
        Save every TypeScript source file with UTF-8 encoding.
    rationale:
        One fixed encoding means every tool and editor reads the same
        characters from the file.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [typescript]
    tags: [encoding, source-files]
    source: https://google.github.io/styleguide/tsguide.html#file-encoding-utf-8
