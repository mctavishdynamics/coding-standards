use ../lib/CodingRule

from ./GoogleTypeScript import GoogleTypeScript

export coding-rule GoogleTypeScriptIdentifiersDollarSign:
    standard: @{GoogleTypeScript}
    ruleId: identifiers-dollar-sign
    title: Avoid the dollar sign in identifiers
    statement:
        Do not use the dollar sign in identifiers, except where a third-
        party framework's naming convention requires it.
    rationale:
        The dollar sign carries no standard meaning in TypeScript code and
        makes names harder to read.
    exceptions:
        A dollar suffix on Observables is a team decision, as described
        under naming style.
    severity: null
    noncompliant:
        ```typescript
        \\\
        const $total = computeTotal(items);
        \\\
        ```
    compliant:
        ```typescript
        \\\
        const total = computeTotal(items);
        \\\
        ```
    languages: [typescript]
    tags: [naming]
    source: https://google.github.io/styleguide/tsguide.html#identifiers-dollar-sign
