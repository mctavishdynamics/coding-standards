use ../lib/CodingRule

from ./GoogleTypeScript import GoogleTypeScript

export coding-rule GoogleTypeScriptOneVariablePerDeclaration:
    standard: @{GoogleTypeScript}
    ruleId: one-variable-per-declaration
    title: Declare one variable per declaration
    statement:
        Each local variable declaration declares exactly one variable.
    rationale:
        Separate declarations are easier to read, change and annotate, and
        avoid confusion about which initialiser belongs to which name.
    exceptions: null
    severity: null
    noncompliant:
        ```typescript
        \\\
        let width = 0, height = 0;
        \\\
        ```
    compliant:
        ```typescript
        \\\
        let width = 0;
        let height = 0;
        \\\
        ```
    languages: [typescript]
    tags: [variables, formatting]
    source: https://google.github.io/styleguide/tsguide.html#one-variable-per-declaration
