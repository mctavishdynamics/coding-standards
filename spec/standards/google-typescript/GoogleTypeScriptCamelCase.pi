use ../lib/CodingRule

from ./GoogleTypeScript import GoogleTypeScript

export coding-rule GoogleTypeScriptCamelCase:
    standard: @{GoogleTypeScript}
    ruleId: camel-case
    title: Treat acronyms as whole words in camel case
    statement:
        Capitalise acronyms and abbreviations in names as ordinary words, as
        in loadHttpUrl, unless a platform name requires otherwise.
    rationale:
        Consistent word boundaries keep names readable and predictable.
    exceptions:
        Platform names such as XMLHttpRequest keep their established
        spelling.
    severity: null
    noncompliant:
        ```typescript
        \\\
        function parseJSONResponse(rawHTML: string) {}
        \\\
        ```
    compliant:
        ```typescript
        \\\
        function parseJsonResponse(rawHtml: string) {}
        \\\
        ```
    languages: [typescript]
    tags: [naming, camel-case]
    source: https://google.github.io/styleguide/tsguide.html#camel-case
