use ../lib/CodingRule

from ./GoogleTypeScript import GoogleTypeScript

export coding-rule GoogleTypeScriptAny:
    standard: @{GoogleTypeScript}
    ruleId: any
    title: Avoid the any type
    statement:
        Avoid the any type. Reach for a narrower type or unknown, and if any
        really must stay, silence the linter with a comment that gives the
        reason.
    rationale:
        any is both a supertype and subtype of everything and allows any
        property access, so it hides serious errors and undermines static
        typing.
    exceptions: null
    severity: null
    noncompliant:
        ```typescript
        \\\
        function total(order: any) {
          return order.items.length * order.price;
        }
        \\\
        ```
    compliant:
        ```typescript
        \\\
        interface Order {
          items: Item[];
          price: number;
        }
        function total(order: Order) {
          return order.items.length * order.price;
        }
        \\\
        ```
    languages: [typescript]
    tags: [types, any, type-safety]
    source: https://google.github.io/styleguide/tsguide.html#any
