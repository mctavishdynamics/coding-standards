use ../lib/CodingRule

from ./GoogleTypeScript import GoogleTypeScript

export coding-rule GoogleTypeScriptReformattingExistingCode:
    standard: @{GoogleTypeScript}
    ruleId: reformatting-existing-code
    title: Reformat old code only when it makes sense
    statement:
        Existing code need not be updated to every current rule, but a file
        receiving significant changes is expected to end up in Google style.
        Put large unrelated style fixes in a separate change.
    rationale:
        Reformatting trades churn against consistency, and mixing style
        fixes into a change muddles its focus.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [typescript]
    tags: [consistency, policy, code-review]
    source: https://google.github.io/styleguide/tsguide.html#reformatting-existing-code
