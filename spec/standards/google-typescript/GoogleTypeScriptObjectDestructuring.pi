use ../lib/CodingRule

from ./GoogleTypeScript import GoogleTypeScript

export coding-rule GoogleTypeScriptObjectDestructuring:
    standard: @{GoogleTypeScript}
    ruleId: object-destructuring
    title: Keep destructured object parameters simple
    statement:
        In a destructured parameter, use only one flat layer of plain
        shorthand property names, without nested patterns or computed keys.
        Give defaults in the pattern itself, and default a whole optional
        destructured object to an empty literal.
    rationale:
        Simple patterns stay readable, and defaults inside the pattern apply
        even when the caller passes only some of the fields.
    exceptions: null
    severity: null
    noncompliant:
        ```typescript
        \\\
        function connect({server: {host, port}}: {server: Endpoint}) {}
        function retry({times, delay}: RetryOptions = {times: 3, delay: 100}) {}
        \\\
        ```
    compliant:
        ```typescript
        \\\
        function connect({host, port}: Endpoint) {}
        function retry({times = 3, delay = 100}: RetryOptions = {}) {}
        \\\
        ```
    languages: [typescript]
    tags: [destructuring, parameters, objects]
    source: https://google.github.io/styleguide/tsguide.html#object-destructuring
