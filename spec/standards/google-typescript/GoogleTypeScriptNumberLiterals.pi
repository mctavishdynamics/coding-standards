use ../lib/CodingRule

from ./GoogleTypeScript import GoogleTypeScript

export coding-rule GoogleTypeScriptNumberLiterals:
    standard: @{GoogleTypeScript}
    ruleId: number-literals
    title: Use lowercase 0x, 0o and 0b prefixes for number literals
    statement:
        Write numbers in base 10, 16, 8 or 2. For the non-decimal bases use
        the lowercase prefixes 0x, 0o and 0b, and do not start a number with
        0 unless one of those letters comes next.
    rationale:
        A bare leading zero once meant octal, and consistent lowercase
        prefixes make the base unambiguous.
    exceptions: null
    severity: null
    noncompliant:
        ```typescript
        \\\
        const mode = 0755;
        const mask = 0XFF;
        \\\
        ```
    compliant:
        ```typescript
        \\\
        const mode = 0o755;
        const mask = 0xff;
        \\\
        ```
    languages: [typescript]
    tags: [numbers, literals]
    source: https://google.github.io/styleguide/tsguide.html#number-literals
