use ../lib/CodingRule

from ./GoogleTypeScript import GoogleTypeScript

export coding-rule GoogleTypeScriptFormattingFunctions:
    standard: @{GoogleTypeScript}
    ruleId: formatting-functions
    title: Format function bodies, generators and spreads consistently
    statement:
        Keep blank lines away from the start and end of a function body, and
        use them only sparingly inside. Write the generator star against its
        keyword, as function* and yield*. The rest and spread dots sit
        directly against the operand that follows.
    rationale:
        Uniform formatting keeps functions compact and makes generator and
        spread syntax easy to recognise.
    exceptions:
        Parentheses around a single arrow function parameter are recommended
        but not required.
    severity: null
    noncompliant:
        ```typescript
        \\\
        function *pages(... urls: string[]) {

          yield *urls;
        }
        \\\
        ```
    compliant:
        ```typescript
        \\\
        function* pages(...urls: string[]) {
          yield* urls;
        }
        \\\
        ```
    languages: [typescript]
    tags: [formatting, functions]
    source: https://google.github.io/styleguide/tsguide.html#formatting-functions
