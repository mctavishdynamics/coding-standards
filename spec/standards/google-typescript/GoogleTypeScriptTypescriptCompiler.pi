use ../lib/CodingRule

from ./GoogleTypeScript import GoogleTypeScript

export coding-rule GoogleTypeScriptTypescriptCompiler:
    standard: @{GoogleTypeScript}
    ruleId: typescript-compiler
    title: Pass type checking with the standard toolchain
    statement:
        Every TypeScript file must pass type checking with the standard tool
        chain.
    rationale:
        A shared, passing type check is what makes the codebase's type
        guarantees trustworthy.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [typescript]
    tags: [tooling, type-checking]
    source: https://google.github.io/styleguide/tsguide.html#typescript-compiler
