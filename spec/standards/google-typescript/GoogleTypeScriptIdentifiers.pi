use ../lib/CodingRule

from ./GoogleTypeScript import GoogleTypeScript

export coding-rule GoogleTypeScriptIdentifiers:
    standard: @{GoogleTypeScript}
    ruleId: identifiers
    title: Use only ASCII letters, digits, underscores and rarely dollar in names
    statement:
        Identifiers contain only ASCII letters and digits, underscores for
        constants and structured test names, and, rarely, the dollar sign.
    rationale:
        A small character set keeps names easy to type, search and read.
    exceptions: null
    severity: null
    noncompliant:
        ```typescript
        \\\
        const préféré = 'tea';
        let user_name = 'ana';
        \\\
        ```
    compliant:
        ```typescript
        \\\
        const preferredDrink = 'tea';
        let userName = 'ana';
        \\\
        ```
    languages: [typescript]
    tags: [naming]
    source: https://google.github.io/styleguide/tsguide.html#identifiers
