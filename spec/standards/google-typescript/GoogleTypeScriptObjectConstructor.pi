use ../lib/CodingRule

from ./GoogleTypeScript import GoogleTypeScript

export coding-rule GoogleTypeScriptObjectConstructor:
    standard: @{GoogleTypeScript}
    ruleId: object-constructor
    title: Do not use the Object constructor
    statement:
        Do not call the Object constructor. Write an object literal instead.
    rationale:
        A literal is shorter, clearer and lets the type checker see the
        shape of the object.
    exceptions: null
    severity: null
    noncompliant:
        ```typescript
        \\\
        const settings = new Object();
        \\\
        ```
    compliant:
        ```typescript
        \\\
        const settings = {};
        const limits = {min: 0, max: 10};
        \\\
        ```
    languages: [typescript]
    tags: [objects, constructors]
    source: https://google.github.io/styleguide/tsguide.html#object-constructor
