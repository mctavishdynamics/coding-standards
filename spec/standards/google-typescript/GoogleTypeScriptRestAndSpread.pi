use ../lib/CodingRule

from ./GoogleTypeScript import GoogleTypeScript

export coding-rule GoogleTypeScriptRestAndSpread:
    standard: @{GoogleTypeScript}
    ruleId: rest-and-spread
    title: Use rest parameters and spread instead of arguments and apply
    statement:
        Use a rest parameter rather than the arguments object, and never
        name a variable or parameter arguments. Use spread syntax instead of
        Function.prototype.apply.
    rationale:
        Rest and spread are typed and explicit, while arguments and apply
        are untyped and an arguments variable shadows the built-in.
    exceptions: null
    severity: null
    noncompliant:
        ```typescript
        \\\
        function sum() {
          return Array.from(arguments).reduce((a, b) => a + b, 0);
        }
        const top = Math.max.apply(null, scores);
        \\\
        ```
    compliant:
        ```typescript
        \\\
        function sum(...values: number[]) {
          return values.reduce((a, b) => a + b, 0);
        }
        const top = Math.max(...scores);
        \\\
        ```
    languages: [typescript]
    tags: [functions, parameters, spread]
    source: https://google.github.io/styleguide/tsguide.html#rest-and-spread
