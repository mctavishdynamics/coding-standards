use ../lib/CodingRule

from ./GoogleTypeScript import GoogleTypeScript

export coding-rule GoogleTypeScriptUseSingleQuotes:
    standard: @{GoogleTypeScript}
    ruleId: use-single-quotes
    title: Delimit ordinary strings with single quotes
    statement:
        Delimit plain string literals with single quotes, not double quotes.
        When the text itself contains an apostrophe, a template literal is
        often cleaner than escaping it.
    rationale:
        One quote style keeps code consistent across the codebase.
    exceptions: null
    severity: null
    noncompliant:
        ```typescript
        \\\
        const greeting = "Welcome back";
        const note = 'It\'s ready';
        \\\
        ```
    compliant:
        ```typescript
        \\\
        const greeting = 'Welcome back';
        const note = `It's ready`;
        \\\
        ```
    languages: [typescript]
    tags: [strings, formatting]
    source: https://google.github.io/styleguide/tsguide.html#use-single-quotes
