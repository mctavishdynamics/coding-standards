use ../lib/CodingRule

from ./GoogleTypeScript import GoogleTypeScript

export coding-rule GoogleTypeScriptGeneratedCode:
    standard: @{GoogleTypeScript}
    ruleId: generated-code
    title: Name generated identifiers properly even though generated code is exempt
    statement:
        Code produced by the build does not have to follow the style guide,
        but generated identifiers referenced from hand-written code must
        follow the naming rules.
    rationale:
        Hand-written code that uses those names should still read as Google
        style.
    exceptions:
        Such generated identifiers may contain underscores, which helps
        avoid clashes with hand-written names.
    severity: null
    noncompliant: null
    compliant: null
    languages: [typescript]
    tags: [generated-code, naming, policy]
    source: https://google.github.io/styleguide/tsguide.html#generated-code
