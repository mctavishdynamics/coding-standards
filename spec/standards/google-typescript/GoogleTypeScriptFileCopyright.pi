use ../lib/CodingRule

from ./GoogleTypeScript import GoogleTypeScript

export coding-rule GoogleTypeScriptFileCopyright:
    standard: @{GoogleTypeScript}
    ruleId: file-copyright
    title: Put copyright information in a top-of-file JSDoc
    statement:
        When a file needs license or copyright text, place it in a JSDoc
        comment at the very top of the file.
    rationale:
        A single known location keeps legal notices consistent and easy for
        tools and readers to find.
    exceptions: null
    severity: null
    noncompliant:
        ```typescript
        \\\
        import {Cart} from './cart';

        // Copyright 2026 Example Corp.
        \\\
        ```
    compliant:
        ```typescript
        \\\
        /**
         * @license
         * Copyright 2026 Example Corp.
         */

        import {Cart} from './cart';
        \\\
        ```
    languages: [typescript]
    tags: [source-files, licensing, comments]
    source: https://google.github.io/styleguide/tsguide.html#file-copyright
