use ../lib/CodingRule

from ./CommitMessages import CommitMessages

export coding-rule CommitMsgCapitalizeSubject:
    standard: @{CommitMessages}
    ruleId: 3
    title: Start the summary line with a capital letter
    statement:
        Begin every commit summary with an uppercase letter.
    rationale:
        A consistent capital start makes the log look uniform and easier to
        scan.
    exceptions: null
    severity: null
    noncompliant:
        ```text
        \\\
        remove unused feature flags
        \\\
        ```
    compliant:
        ```text
        \\\
        Remove unused feature flags
        \\\
        ```
    languages: [any]
    tags: [commit-messages, capitalization]
    source: https://cbea.ms/git-commit/#capitalize
