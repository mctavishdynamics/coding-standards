use ../lib/CodingRule

from ./CommitMessages import CommitMessages

export coding-rule CommitMsgNoTrailingPeriod:
    standard: @{CommitMessages}
    ruleId: 4
    title: Leave the full stop off the summary line
    statement:
        Do not put a period or other closing punctuation at the end of the
        summary.
    rationale:
        The punctuation adds nothing to a title and spends a character from
        a tight length budget.
    exceptions: null
    severity: null
    noncompliant:
        ```text
        \\\
        Raise the upload size limit to 20 MB.
        \\\
        ```
    compliant:
        ```text
        \\\
        Raise the upload size limit to 20 MB
        \\\
        ```
    languages: [any]
    tags: [commit-messages, punctuation]
    source: https://cbea.ms/git-commit/#end
