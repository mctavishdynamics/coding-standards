use ../lib/CodingStandard

from ./CommitMsgBlankLineAfterSubject import CommitMsgBlankLineAfterSubject
from ./CommitMsgCapitalizeSubject import CommitMsgCapitalizeSubject
from ./CommitMsgExplainWhy import CommitMsgExplainWhy
from ./CommitMsgImperativeSubject import CommitMsgImperativeSubject
from ./CommitMsgNoTrailingPeriod import CommitMsgNoTrailingPeriod
from ./CommitMsgSubjectLength import CommitMsgSubjectLength
from ./CommitMsgWrapBody import CommitMsgWrapBody

export coding-standard CommitMessages:
    title: How to Write a Git Commit Message
    publisher: Chris Beams
    url: https://cbea.ms/git-commit/
    version: 2014-08-31
    license: Copyright Chris Beams, all rights reserved. Items are paraphrased.
    description:
        Chris Beams's seven rules for writing clear, conventional Git commit
        messages, covering the subject line, the body and what the message
        should explain.
    rules:
        - @{CommitMsgBlankLineAfterSubject}
        - @{CommitMsgSubjectLength}
        - @{CommitMsgCapitalizeSubject}
        - @{CommitMsgNoTrailingPeriod}
        - @{CommitMsgImperativeSubject}
        - @{CommitMsgWrapBody}
        - @{CommitMsgExplainWhy}
