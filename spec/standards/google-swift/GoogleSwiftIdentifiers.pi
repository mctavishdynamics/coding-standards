use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftIdentifiers:
    standard: @{GoogleSwift}
    ruleId: identifiers
    title: Use ASCII identifiers
    statement:
        Write identifiers in 7-bit ASCII.
    rationale:
        ASCII names are easy for everyone to type and read.
    exceptions:
        Unicode identifiers are allowed when they have a clear, legitimate
        meaning in the problem domain, such as Greek letters in maths, and
        the team understands them.
    severity: null
    noncompliant:
        ```swift
        \\\
        let 🚀 = Rocket()
        \\\
        ```
    compliant:
        ```swift
        \\\
        let rocket = Rocket()
        let θ = atan2(y, x)
        \\\
        ```
    languages: [swift]
    tags: [naming, unicode]
    source: https://google.github.io/swift/#identifiers
