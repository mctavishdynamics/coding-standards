use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftNoSpaceInsideLiteralBrackets:
    standard: @{GoogleSwift}
    ruleId: horizontal-whitespace-brackets
    title: Do not pad the inside of collection and tuple literals
    statement:
        Array and dictionary literals and tuple literals take spaces around
        their brackets or parentheses, never just within them.
    rationale:
        Inner padding adds width without improving readability.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        let origin = ( 0, 0 )
        let sizes = [ 8, 16, 32 ]
        \\\
        ```
    compliant:
        ```swift
        \\\
        let origin = (0, 0)
        let sizes = [8, 16, 32]
        \\\
        ```
    languages: [swift]
    tags: [formatting, whitespace]
    source: https://google.github.io/swift/#horizontal-whitespace
