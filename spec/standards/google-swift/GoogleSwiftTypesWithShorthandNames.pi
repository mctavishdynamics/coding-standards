use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftTypesWithShorthandNames:
    standard: @{GoogleSwift}
    ruleId: types-with-shorthand-names
    title: Use shorthand names for arrays, dictionaries and optionals
    statement:
        Write array, dictionary and optional types in their shorthand form.
        Use the long forms only when the compiler requires them, as in
        Array<Element>.Index.
    rationale:
        The shorthand is shorter and idiomatic.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        var scores: Dictionary<String, Array<Int>> = [:]
        var nickname: Optional<String>
        \\\
        ```
    compliant:
        ```swift
        \\\
        var scores: [String: [Int]] = [:]
        var nickname: String?
        \\\
        ```
    languages: [swift]
    tags: [types, syntax]
    source: https://google.github.io/swift/#types-with-shorthand-names
