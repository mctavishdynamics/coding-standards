use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftColumnLimit:
    standard: @{GoogleSwift}
    ruleId: column-limit
    title: Limit lines to 100 characters
    statement:
        Keep lines to at most 100 characters, wrapping longer lines as the
        line-wrapping rules describe.
    rationale:
        A fixed limit keeps code readable side by side and in review tools.
    exceptions:
        The limit is waived where shortening a line would split something
        that must stay whole, for example a URL inside a comment, an import
        line, or machine-generated source.
    severity: null
    noncompliant: null
    compliant: null
    languages: [swift]
    tags: [formatting, line-length]
    source: https://google.github.io/swift/#column-limit
