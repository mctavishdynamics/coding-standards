use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftFunctionCalls:
    standard: @{GoogleSwift}
    ruleId: function-calls
    title: Wrap function call arguments one per line
    statement:
        A wrapped call places every argument on a separate line with a
        two-space indent. Without a trailing closure, the closing
        parenthesis may follow the final argument or stand alone. When the
        signature of a trailing closure has to wrap, move it to a line of
        its own and put its parameters inside parentheses.
    rationale:
        Uniform indentation keeps each argument visible and separate from
        the closure body.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        let order = Order(customer: currentCustomer, items: selectedItems,
                          shipping: .express)
        \\\
        ```
    compliant:
        ```swift
        \\\
        let order = Order(
          customer: currentCustomer,
          items: selectedItems,
          shipping: .express)
        \\\
        ```
    languages: [swift]
    tags: [formatting, line-wrapping, functions]
    source: https://google.github.io/swift/#function-calls
