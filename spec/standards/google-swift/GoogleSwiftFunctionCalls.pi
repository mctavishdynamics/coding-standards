use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftFunctionCalls:
    standard: @{GoogleSwift}
    ruleId: function-calls
    title: Wrap function call arguments one per line
    statement:
        When a call is wrapped, put each argument on its own line indented
        two spaces. A call without a trailing closure may close its
        parenthesis on the last argument line or on its own line. If a
        trailing closure signature must wrap, put it on its own line and
        wrap the parameters in parentheses.
    rationale:
        Uniform indentation keeps each argument visible and separate from
        the closure body.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        let order = Order(customer: currentCustomer, items: selectedItems,
                          shipping: .express)
        \\\
        ```
    compliant:
        ```swift
        \\\
        let order = Order(
          customer: currentCustomer,
          items: selectedItems,
          shipping: .express)
        \\\
        ```
    languages: [swift]
    tags: [formatting, line-wrapping, functions]
    source: https://google.github.io/swift/#function-calls
