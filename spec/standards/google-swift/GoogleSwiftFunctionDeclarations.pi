use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftFunctionDeclarations:
    standard: @{GoogleSwift}
    ruleId: function-declarations
    title: Wrap function declarations one parameter per line
    statement:
        A wrapped declaration lists every parameter on a separate line with
        a two-space indent, and the closing parenthesis and return type go
        on the line below. Inside a protocol, a declaration that ends with
        the parenthesis may close it after the final parameter. Use
        typealiases to tame complicated signatures.
    rationale:
        Every declaration then has the same predictable shape.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        func upload(file: URL, to bucket: String, metadata: [String: String], retries: Int) -> UploadTask {
          // ...
        }
        \\\
        ```
    compliant:
        ```swift
        \\\
        func upload(
          file: URL,
          to bucket: String,
          metadata: [String: String],
          retries: Int
        ) -> UploadTask {
          // ...
        }
        \\\
        ```
    languages: [swift]
    tags: [formatting, line-wrapping, functions]
    source: https://google.github.io/swift/#function-declarations
