use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftSpaceAfterConditionalKeywords:
    standard: @{GoogleSwift}
    ruleId: horizontal-whitespace-keywords
    title: Separate a conditional keyword from a following parenthesis
    statement:
        When the expression following a control keyword like if, guard,
        while or switch begins with a parenthesis, separate the keyword and
        the parenthesis by one space.
    rationale:
        Without the space the statement reads like a function call.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        if(isAdmin || isOwner) && isActive {
          grantAccess()
        }
        \\\
        ```
    compliant:
        ```swift
        \\\
        if (isAdmin || isOwner) && isActive {
          grantAccess()
        }
        \\\
        ```
    languages: [swift]
    tags: [formatting, whitespace, control-flow]
    source: https://google.github.io/swift/#horizontal-whitespace
