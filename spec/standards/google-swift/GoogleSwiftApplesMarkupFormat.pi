use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftApplesMarkupFormat:
    standard: @{GoogleSwift}
    ruleId: apples-markup-format
    title: Use Apple's markup format in documentation
    statement:
        Use Apple's markup format for rich documentation: blank comment
        lines between paragraphs, asterisks or underscores for emphasis,
        backticks for symbols and code, and fenced blocks for multi-line
        code.
    rationale:
        Markup separates symbols from prose and is rendered by Xcode and doc
        tools.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```swift
        \\\
        /// Formats a duration for display.
        ///
        /// Uses `unitsStyle` to choose between *short* and *full* names.
        ///
        /// ```
        /// format(90)  // "1 min, 30 sec"
        /// ```
        func format(_ seconds: Int) -> String
        \\\
        ```
    languages: [swift]
    tags: [comments, documentation]
    source: https://google.github.io/swift/#apples-markup-format
