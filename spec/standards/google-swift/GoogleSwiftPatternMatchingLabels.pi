use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftPatternMatchingLabels:
    standard: @{GoogleSwift}
    ruleId: pattern-matching-labels
    title: Omit labels that match the bound names
    statement:
        When binding an associated value or tuple element to a variable with
        the same name as its label, leave the label out.
    rationale:
        Repeating the label adds noise without information.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        case .resize(width: let width, height: let height):
          apply(width, height)
        \\\
        ```
    compliant:
        ```swift
        \\\
        case .resize(let width, let height):
          apply(width, height)
        \\\
        ```
    languages: [swift]
    tags: [pattern-matching, readability]
    source: https://google.github.io/swift/#pattern-matching
