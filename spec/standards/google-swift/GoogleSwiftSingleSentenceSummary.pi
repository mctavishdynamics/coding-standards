use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftSingleSentenceSummary:
    standard: @{GoogleSwift}
    ruleId: single-sentence-summary
    title: Start doc comments with a one-sentence summary
    statement:
        Begin each documentation comment with a brief one-sentence summary
        ending in a period, followed by further paragraphs if needed. Write
        method summaries as verb phrases and property summaries as noun
        phrases, without This method or This property.
    rationale:
        A short summary is what readers and tools show first.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        /// This property is the date the order was placed
        var placedAt: Date
        \\\
        ```
    compliant:
        ```swift
        \\\
        /// The date the order was placed.
        var placedAt: Date
        \\\
        ```
    languages: [swift]
    tags: [comments, documentation]
    source: https://google.github.io/swift/#single-sentence-summary
