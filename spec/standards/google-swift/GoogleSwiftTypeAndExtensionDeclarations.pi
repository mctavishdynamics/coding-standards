use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftTypeAndExtensionDeclarations:
    standard: @{GoogleSwift}
    ruleId: type-and-extension-declarations
    title: Wrap type inheritance lists vertically
    statement:
        Wrap class, struct, enum, extension and protocol declarations with
        the same rules as functions, putting each inherited type or
        constraint on its own line indented two spaces.
    rationale:
        Long conformance lists stay readable and diff cleanly.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```swift
        \\\
        final class ProfileViewController:
          UIViewController,
          UITableViewDataSource,
          UITableViewDelegate
        {
          // ...
        }
        \\\
        ```
    languages: [swift]
    tags: [formatting, line-wrapping, types]
    source: https://google.github.io/swift/#type-and-extension-declarations
