use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftExtensions:
    standard: @{GoogleSwift}
    ruleId: extensions
    title: Organize extensions in a logical structure
    statement:
        If you spread a type across several extensions, organize them by a
        principle you could justify when someone reviews the code.
    rationale:
        A consistent structure keeps related functionality easy to find.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```swift
        \\\
        struct Playlist {
          var tracks: [Track]
        }

        extension Playlist: Collection {
          // ...
        }

        extension Playlist: CustomStringConvertible {
          // ...
        }
        \\\
        ```
    languages: [swift]
    tags: [organization, extensions]
    source: https://google.github.io/swift/#extensions
