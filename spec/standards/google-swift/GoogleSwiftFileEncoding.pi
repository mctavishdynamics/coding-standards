use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftFileEncoding:
    standard: @{GoogleSwift}
    ruleId: file-encoding
    title: Encode source files in UTF-8
    statement:
        Save every source file in UTF-8.
    rationale:
        One encoding avoids garbled text across editors and tools.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [swift]
    tags: [files, encoding]
    source: https://google.github.io/swift/#file-encoding
