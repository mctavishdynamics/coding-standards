use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftApplesAPIStyleGuidelines:
    standard: @{GoogleSwift}
    ruleId: apples-api-style-guidelines
    title: Follow Apple's Swift API Design Guidelines
    statement:
        Treat Apple's Swift API Design Guidelines published at swift.org as
        part of this guide and apply them to all naming and API choices.
    rationale:
        Code then reads like the standard library and Apple frameworks.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        func removeObjectAtIndex(index: Int)
        \\\
        ```
    compliant:
        ```swift
        \\\
        func remove(at index: Int)
        \\\
        ```
    languages: [swift]
    tags: [naming, api-design]
    source: https://google.github.io/swift/#apples-api-style-guidelines
