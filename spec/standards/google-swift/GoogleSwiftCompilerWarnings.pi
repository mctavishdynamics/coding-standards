use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftCompilerWarnings:
    standard: @{GoogleSwift}
    ruleId: compiler-warnings
    title: Compile without warnings
    statement:
        Make code compile without warnings when feasible, and remove any
        warning that can be fixed easily.
    rationale:
        Ignored warnings hide new and important ones.
    exceptions:
        Deprecation warnings may remain when migration is not yet possible
        or a library must still support a deprecated API.
    severity: null
    noncompliant: null
    compliant: null
    languages: [swift]
    tags: [tooling, warnings]
    source: https://google.github.io/swift/#compiler-warnings
