use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftNumericAndStringLiterals:
    standard: @{GoogleSwift}
    ruleId: numeric-and-string-literals
    title: Coerce literals with a type annotation or as
    statement:
        If a literal must become some type other than the one Swift picks by
        default and the context does not settle it, annotate the declaration
        with that type or use an as coercion. Do not call an initializer to
        get there.
    rationale:
        Initializer syntax converts at run time and can give misleading
        errors or crash, while coercion is checked at compile time.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        let mask = UInt64(0xFFFF_FFFF_FFFF_FFFF)
        let initial = Character("A")
        \\\
        ```
    compliant:
        ```swift
        \\\
        let mask: UInt64 = 0xFFFF_FFFF_FFFF_FFFF
        let initial = "A" as Character
        \\\
        ```
    languages: [swift]
    tags: [literals, types]
    source: https://google.github.io/swift/#numeric-and-string-literals
