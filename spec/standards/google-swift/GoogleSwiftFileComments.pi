use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftFileComments:
    standard: @{GoogleSwift}
    ruleId: file-comments
    title: Add file comments only for files with several abstractions
    statement:
        File comments are optional. Avoid them in files holding a single
        abstraction, where its documentation comment is enough, and use them
        to describe the grouping in files holding several.
    rationale:
        A file comment that repeats the type documentation adds nothing.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [swift]
    tags: [comments, files]
    source: https://google.github.io/swift/#file-comments
