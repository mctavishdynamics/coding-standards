export coding-standard GoogleSwift:
    title: Google Swift Style Guide
    publisher: Google
    url: https://google.github.io/swift/
    version: null
    license: Apache License 2.0
    description:
        Google's style guide for Swift, based on Apple's standard library
        style, covering source files, formatting, naming, programming
        practices and documentation comments.
    rules:
        - @{GoogleSwiftFileNames}
        - @{GoogleSwiftFileEncoding}
        - @{GoogleSwiftWhitespaceCharacters}
        - @{GoogleSwiftSpecialEscapeSequences}
        - @{GoogleSwiftInvisibleCharactersAndModifiers}
        - @{GoogleSwiftStringLiterals}
        - @{GoogleSwiftFileComments}
        - @{GoogleSwiftImportStatements}
        - @{GoogleSwiftImportStatementsOrder}
        - @{GoogleSwiftTypeVariableAndFunctionDeclarations}
        - @{GoogleSwiftOverloadedDeclarations}
        - @{GoogleSwiftExtensions}
        - @{GoogleSwiftColumnLimit}
        - @{GoogleSwiftBraces}
        - @{GoogleSwiftSemicolons}
        - @{GoogleSwiftOneStatementPerLine}
        - @{GoogleSwiftLineWrapping}
        - @{GoogleSwiftLineWrappingWhereClauses}
        - @{GoogleSwiftFunctionDeclarations}
        - @{GoogleSwiftTypeAndExtensionDeclarations}
        - @{GoogleSwiftFunctionCalls}
        - @{GoogleSwiftControlFlowStatements}
        - @{GoogleSwiftOtherExpressions}
        - @{GoogleSwiftSpaceAfterConditionalKeywords}
        - @{GoogleSwiftSpaceAroundBraces}
        - @{GoogleSwiftSpaceAroundOperators}
        - @{GoogleSwiftSpaceAfterCommas}
        - @{GoogleSwiftSpaceAfterColons}
        - @{GoogleSwiftSpaceBeforeEndOfLineComments}
        - @{GoogleSwiftNoSpaceInsideLiteralBrackets}
        - @{GoogleSwiftHorizontalAlignment}
        - @{GoogleSwiftVerticalWhitespace}
        - @{GoogleSwiftParentheses}
        - @{GoogleSwiftNonDocumentationComments}
        - @{GoogleSwiftProperties}
        - @{GoogleSwiftSwitchStatements}
        - @{GoogleSwiftEnumCases}
        - @{GoogleSwiftIndirectEnums}
        - @{GoogleSwiftEnumCasesWithoutParentheses}
        - @{GoogleSwiftEnumCaseOrder}
        - @{GoogleSwiftTrailingClosureOverloads}
        - @{GoogleSwiftMultipleClosureArguments}
        - @{GoogleSwiftUseTrailingClosureSyntax}
        - @{GoogleSwiftNoEmptyParenthesesBeforeTrailingClosure}
        - @{GoogleSwiftTrailingCommas}
        - @{GoogleSwiftNumericLiterals}
        - @{GoogleSwiftAttributes}
        - @{GoogleSwiftApplesAPIStyleGuidelines}
        - @{GoogleSwiftNamingConventionsAreNotAccessControl}
        - @{GoogleSwiftIdentifiers}
        - @{GoogleSwiftNamingInitializers}
        - @{GoogleSwiftStaticAndClassProperties}
        - @{GoogleSwiftGlobalConstants}
        - @{GoogleSwiftDelegateMethods}
        - @{GoogleSwiftCompilerWarnings}
        - @{GoogleSwiftMemberwiseInitializers}
        - @{GoogleSwiftLiteralInitializers}
        - @{GoogleSwiftExplicitInitCalls}
        - @{GoogleSwiftComputedProperties}
        - @{GoogleSwiftTypesWithShorthandNames}
        - @{GoogleSwiftVoidAndEmptyTuple}
        - @{GoogleSwiftOptionalTypes}
        - @{GoogleSwiftOptionalNilComparison}
        - @{GoogleSwiftErrorTypes}
        - @{GoogleSwiftForceTry}
        - @{GoogleSwiftForceUnwrappingAndForceCasts}
        - @{GoogleSwiftImplicitlyUnwrappedOptionals}
        - @{GoogleSwiftAccessLevels}
        - @{GoogleSwiftNestingAndNamespacing}
        - @{GoogleSwiftCaselessEnumNamespaces}
        - @{GoogleSwiftGuardsForEarlyExits}
        - @{GoogleSwiftForWhereLoops}
        - @{GoogleSwiftFallthroughInSwitchStatements}
        - @{GoogleSwiftPatternMatching}
        - @{GoogleSwiftPatternMatchingLabels}
        - @{GoogleSwiftTuplePatterns}
        - @{GoogleSwiftNumericAndStringLiterals}
        - @{GoogleSwiftPlaygroundLiterals}
        - @{GoogleSwiftTrappingVsOverflowingArithmetic}
        - @{GoogleSwiftDefiningNewOperators}
        - @{GoogleSwiftOverloadingExistingOperators}
        - @{GoogleSwiftDocumentationGeneralFormat}
        - @{GoogleSwiftSingleSentenceSummary}
        - @{GoogleSwiftParameterReturnsAndThrowsTags}
        - @{GoogleSwiftApplesMarkupFormat}
        - @{GoogleSwiftWhereToDocument}
