use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftSpaceAfterCommas:
    standard: @{GoogleSwift}
    ruleId: horizontal-whitespace-commas
    title: Put a space after but not before commas
    statement:
        In parameter lists and tuple, array and dictionary literals, put a
        space after each comma and none before it.
    rationale:
        This is the conventional way to separate list items.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        let primes = [2 ,3,5 , 7]
        \\\
        ```
    compliant:
        ```swift
        \\\
        let primes = [2, 3, 5, 7]
        \\\
        ```
    languages: [swift]
    tags: [formatting, whitespace]
    source: https://google.github.io/swift/#horizontal-whitespace
