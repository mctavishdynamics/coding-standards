use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftSemicolons:
    standard: @{GoogleSwift}
    ruleId: semicolons
    title: Do not use semicolons
    statement:
        Do not use semicolons to end or separate statements.
    rationale:
        Swift does not need them, and they only add noise.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        let total = price * quantity;
        print(total);
        \\\
        ```
    compliant:
        ```swift
        \\\
        let total = price * quantity
        print(total)
        \\\
        ```
    languages: [swift]
    tags: [formatting, statements]
    source: https://google.github.io/swift/#semicolons
