use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftSpaceBeforeEndOfLineComments:
    standard: @{GoogleSwift}
    ruleId: horizontal-whitespace-comments
    title: Put two spaces before and one after an end-of-line comment slash
    statement:
        Put at least two spaces before the double slash of an end-of-line
        comment and exactly one space after it.
    rationale:
        The comment stands apart from the code it annotates.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        let timeout = 30 //seconds
        \\\
        ```
    compliant:
        ```swift
        \\\
        let timeout = 30  // In seconds.
        \\\
        ```
    languages: [swift]
    tags: [formatting, whitespace, comments]
    source: https://google.github.io/swift/#horizontal-whitespace
