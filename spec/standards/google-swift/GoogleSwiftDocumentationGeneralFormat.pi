use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftDocumentationGeneralFormat:
    standard: @{GoogleSwift}
    ruleId: general-format
    title: Write doc comments with triple slashes
    statement:
        Write documentation comments with a triple slash on each line, not
        with Javadoc-style block comments.
    rationale:
        One format is consistent and works well with Xcode.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        /**
         * Returns the number of unread messages.
         */
        func unreadCount() -> Int
        \\\
        ```
    compliant:
        ```swift
        \\\
        /// Returns the number of unread messages.
        func unreadCount() -> Int
        \\\
        ```
    languages: [swift]
    tags: [comments, documentation]
    source: https://google.github.io/swift/#general-format
