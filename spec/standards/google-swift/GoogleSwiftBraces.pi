use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftBraces:
    standard: @{GoogleSwift}
    ruleId: braces
    title: Use K&R style braces
    statement:
        Do not break the line before an opening brace unless line-wrapping
        requires it, and break after it except for closure signatures, short
        one-statement blocks and empty blocks. Break before a closing brace,
        and after it only when it ends a statement or declaration body, so
        else stays on the same line.
    rationale:
        K&R braces are compact and familiar.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        if isValid
        {
          save()
        }
        else
        {
          reject()
        }
        \\\
        ```
    compliant:
        ```swift
        \\\
        if isValid {
          save()
        } else {
          reject()
        }
        \\\
        ```
    languages: [swift]
    tags: [formatting, braces]
    source: https://google.github.io/swift/#braces
