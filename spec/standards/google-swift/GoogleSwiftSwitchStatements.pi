use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftSwitchStatements:
    standard: @{GoogleSwift}
    ruleId: switch-statements
    title: Indent case labels at the level of the switch
    statement:
        Indent case statements at the same level as their switch, and the
        statements inside each case two spaces further.
    rationale:
        This is the Swift convention and avoids a wasted indentation level.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        switch status {
          case .active:
            showDashboard()
          case .suspended:
            showNotice()
        }
        \\\
        ```
    compliant:
        ```swift
        \\\
        switch status {
        case .active:
          showDashboard()
        case .suspended:
          showNotice()
        }
        \\\
        ```
    languages: [swift]
    tags: [formatting, indentation, control-flow]
    source: https://google.github.io/swift/#switch-statements
