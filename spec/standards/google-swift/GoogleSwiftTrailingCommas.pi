use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftTrailingCommas:
    standard: @{GoogleSwift}
    ruleId: trailing-commas
    title: Use trailing commas in vertical collection literals
    statement:
        When each element of an array or dictionary literal is on its own
        line, end the last element with a comma.
    rationale:
        Adding an item later then changes only one line in the diff.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        let supportedLocales = [
          "en_US",
          "fr_FR",
          "ja_JP"
        ]
        \\\
        ```
    compliant:
        ```swift
        \\\
        let supportedLocales = [
          "en_US",
          "fr_FR",
          "ja_JP",
        ]
        \\\
        ```
    languages: [swift]
    tags: [formatting, literals]
    source: https://google.github.io/swift/#trailing-commas
