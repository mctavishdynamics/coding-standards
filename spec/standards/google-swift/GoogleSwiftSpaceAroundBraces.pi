use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftSpaceAroundBraces:
    standard: @{GoogleSwift}
    ruleId: horizontal-whitespace-braces
    title: Put spaces around braces on a shared line
    statement:
        Every opening brace has a space in front of it. When code continues
        on the same line after an opening brace, add a space after it, and
        when code on the same line comes before a closing brace, add a space
        in front of that brace too.
    rationale:
        Spacing makes one-line closures and blocks easy to read.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        let names = users.map{$0.name}.filter{!$0.isEmpty}
        \\\
        ```
    compliant:
        ```swift
        \\\
        let names = users.map { $0.name }.filter { !$0.isEmpty }
        \\\
        ```
    languages: [swift]
    tags: [formatting, whitespace, braces]
    source: https://google.github.io/swift/#horizontal-whitespace
