use ../lib/CodingRule

from ./GoogleSwift import GoogleSwift

export coding-rule GoogleSwiftGlobalConstants:
    standard: @{GoogleSwift}
    ruleId: global-constants
    title: Name global constants in lowerCamelCase
    statement:
        Name global constants in lowerCamelCase like other variables,
        without Hungarian prefixes such as g or k.
    rationale:
        Constants need no special marking in Swift.
    exceptions: null
    severity: null
    noncompliant:
        ```swift
        \\\
        let kMaxRetryCount = 3
        let DEFAULT_TIMEOUT = 30.0
        \\\
        ```
    compliant:
        ```swift
        \\\
        let maxRetryCount = 3
        let defaultTimeout = 30.0
        \\\
        ```
    languages: [swift]
    tags: [naming, constants]
    source: https://google.github.io/swift/#global-constants
