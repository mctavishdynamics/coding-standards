use ../lib/CodingRule

from ./EffectiveDart import EffectiveDart

export coding-rule EffectiveDartOmitVerbInNamedBoolParam:
    standard: @{EffectiveDart}
    ruleId: consider-omitting-the-verb-for-a-named-boolean-parameter
    title: Consider dropping the verb from named boolean parameters
    statement:
        For a named boolean parameter, a bare adjective or noun often reads
        better at the call site than an is- or has- form.
    rationale:
        The parameter name sits next to its value at the call, so the verb
        adds little.
    exceptions: null
    severity: null
    noncompliant:
        ```dart
        \\\
        Dialog(isModal: true, hasCloseButton: false);
        \\\
        ```
    compliant:
        ```dart
        \\\
        Dialog(modal: true, closeButton: false);
        \\\
        ```
    languages: [dart]
    tags: [consider, naming, parameters]
    source: https://dart.dev/effective-dart/design#consider-omitting-the-verb-for-a-named-boolean-parameter
