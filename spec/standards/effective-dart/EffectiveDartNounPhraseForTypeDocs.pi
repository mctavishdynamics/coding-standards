use ../lib/CodingRule

from ./EffectiveDart import EffectiveDart

export coding-rule EffectiveDartNounPhraseForTypeDocs:
    standard: @{EffectiveDart}
    ruleId: prefer-starting-library-or-type-comments-with-noun-phrases
    title: Start library and type docs with a noun phrase
    statement:
        Open the doc comment of a library or type with a noun phrase that
        describes an instance of it.
    rationale:
        Type docs set the vocabulary and invariants that every member doc
        relies on, so describing what an instance is pays off across the
        class.
    exceptions: null
    severity: null
    noncompliant:
        ```dart
        \\\
        /// This class handles keeping track of user sessions.
        class Session {}
        \\\
        ```
    compliant:
        ```dart
        \\\
        /// A signed-in user's connection, valid until it expires or logs out.
        class Session {}
        \\\
        ```
    languages: [dart]
    tags: [prefer, documentation, types]
    source: https://dart.dev/effective-dart/documentation#prefer-starting-library-or-type-comments-with-noun-phrases
