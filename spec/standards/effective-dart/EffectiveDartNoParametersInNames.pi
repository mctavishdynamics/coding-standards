use ../lib/CodingRule

from ./EffectiveDart import EffectiveDart

export coding-rule EffectiveDartNoParametersInNames:
    standard: @{EffectiveDart}
    ruleId: avoid-describing-the-parameters-in-the-functions-or-methods-name
    title: Do not repeat parameters in the function name
    statement:
        Leave the parameter out of the method name, since the argument is
        visible at the call site.
    rationale:
        Repeating it adds length without clarity.
    exceptions:
        Naming the parameter type can be useful to tell apart similar
        methods that take different types, such as two add methods.
    severity: null
    noncompliant:
        ```dart
        \\\
        list.addItem(item);
        cache.removeKey(key);
        \\\
        ```
    compliant:
        ```dart
        \\\
        list.add(item);
        cache.remove(key);
        \\\
        ```
    languages: [dart]
    tags: [avoid, naming, functions]
    source: https://dart.dev/effective-dart/design#avoid-describing-the-parameters-in-the-functions-or-methods-name
