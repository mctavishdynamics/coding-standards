use ../lib/CodingRule

from ./EffectiveDart import EffectiveDart

export coding-rule EffectiveDartUseIsEmpty:
    standard: @{EffectiveDart}
    ruleId: dont-use-length-to-see-if-a-collection-is-empty
    title: Check emptiness with isEmpty and isNotEmpty
    statement:
        Use `isEmpty` or `isNotEmpty`, whichever needs no negation, rather
        than comparing `length` with zero. The prefer_is_empty and
        prefer_is_not_empty lints check this.
    rationale:
        An Iterable may have to walk every element to compute its length,
        while the emptiness getters are fast and read better.
    exceptions: null
    severity: null
    noncompliant:
        ```dart
        \\\
        if (results.length == 0) return;
        if (!pending.isEmpty) flush();
        \\\
        ```
    compliant:
        ```dart
        \\\
        if (results.isEmpty) return;
        if (pending.isNotEmpty) flush();
        \\\
        ```
    languages: [dart]
    tags: [dont, collections, performance]
    source: https://dart.dev/effective-dart/usage#dont-use-length-to-see-if-a-collection-is-empty
