use ../lib/CodingRule

from ./EffectiveDart import EffectiveDart

export coding-rule EffectiveDartSortDirectiveSections:
    standard: @{EffectiveDart}
    ruleId: do-sort-sections-alphabetically
    title: Sort each directive section alphabetically
    statement:
        Within each section of imports or exports, order the directives
        alphabetically by URI. The directives_ordering lint checks this.
    rationale:
        Sorted lists are quick to scan, show duplicates and give smaller
        merge conflicts.
    exceptions: null
    severity: null
    noncompliant:
        ```dart
        \\\
        import 'package:shop/pricing.dart';
        import 'package:shop/cart.dart';
        \\\
        ```
    compliant:
        ```dart
        \\\
        import 'package:shop/cart.dart';
        import 'package:shop/pricing.dart';
        \\\
        ```
    languages: [dart]
    tags: [do, imports, ordering]
    source: https://dart.dev/effective-dart/style#do-sort-sections-alphabetically
