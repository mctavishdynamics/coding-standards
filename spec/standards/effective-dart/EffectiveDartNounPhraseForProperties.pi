use ../lib/CodingRule

from ./EffectiveDart import EffectiveDart

export coding-rule EffectiveDartNounPhraseForProperties:
    standard: @{EffectiveDart}
    ruleId: prefer-a-noun-phrase-for-a-non-boolean-property-or-variable
    title: Name non-boolean properties with noun phrases
    statement:
        Name a variable or property that is not boolean after what it holds,
        using a noun phrase.
    rationale:
        Readers care what the property is. If how it is computed matters
        more, it should be a method with a verb name.
    exceptions: null
    severity: null
    noncompliant:
        ```dart
        \\\
        int get calculateTotal => _items.length * unitPrice;
        \\\
        ```
    compliant:
        ```dart
        \\\
        int get total => _items.length * unitPrice;
        \\\
        ```
    languages: [dart]
    tags: [prefer, naming, properties]
    source: https://dart.dev/effective-dart/design#prefer-a-noun-phrase-for-a-non-boolean-property-or-variable
