use ../lib/CodingRule

from ./EffectiveDart import EffectiveDart

export coding-rule EffectiveDartDocValueReturningFunctionsAsProperties:
    standard: @{EffectiveDart}
    ruleId: prefer-a-noun-phrase-or-non-imperative-verb-phrase-for-a-function-or-method-if-returning-a-value-is-its-primary-purpose
    title: Document value-returning methods the way you document properties
    statement:
        If a method is conceptually a property, document it with a noun
        phrase, or with "Whether" for a boolean result. Do this even when
        the method itself has a verb name.
    rationale:
        The documentation should match how callers think of the member,
        which is by the value it returns.
    exceptions: null
    severity: null
    noncompliant:
        ```dart
        \\\
        /// Gets items from the list until [count] is reached.
        Iterable<Item> firstItems(int count) => _items.take(count);
        \\\
        ```
    compliant:
        ```dart
        \\\
        /// The first [count] items in this cart.
        Iterable<Item> firstItems(int count) => _items.take(count);
        \\\
        ```
    languages: [dart]
    tags: [prefer, documentation, functions]
    source: https://dart.dev/effective-dart/documentation#prefer-a-noun-phrase-or-non-imperative-verb-phrase-for-a-function-or-method-if-returning-a-value-is-its-primary-purpose
