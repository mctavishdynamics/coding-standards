use ../lib/CodingRule

from ./EffectiveDart import EffectiveDart

export coding-rule EffectiveDartCommentsAsSentences:
    standard: @{EffectiveDart}
    ruleId: do-format-comments-like-sentences
    title: Write comments as capitalized sentences ending in punctuation
    statement:
        Start every comment, including doc comments and TODOs, with a
        capital letter unless it opens with a case-sensitive identifier, and
        end it with a period or other closing punctuation, even when it is a
        fragment.
    rationale:
        Comments written as sentences read consistently and look deliberate
        rather than hurried.
    exceptions: null
    severity: null
    noncompliant:
        ```dart
        \\\
        // retry once because the cache may be cold
        final user = await fetchUser(id);
        \\\
        ```
    compliant:
        ```dart
        \\\
        // Retry once because the cache may be cold.
        final user = await fetchUser(id);
        \\\
        ```
    languages: [dart]
    tags: [do, comments]
    source: https://dart.dev/effective-dart/documentation#do-format-comments-like-sentences
