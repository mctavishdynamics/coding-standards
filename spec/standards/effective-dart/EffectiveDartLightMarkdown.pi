use ../lib/CodingRule

from ./EffectiveDart import EffectiveDart

export coding-rule EffectiveDartLightMarkdown:
    standard: @{EffectiveDart}
    ruleId: avoid-using-markdown-excessively
    title: Use Markdown sparingly in doc comments
    statement:
        Keep Markdown formatting in doc comments to a minimum; when unsure,
        use less of it.
    rationale:
        Heavy markup distracts from the explanation, and plain wording is
        what readers actually need.
    exceptions: null
    severity: null
    noncompliant:
        ```dart
        \\\
        /// **Returns** the *current* `user`, or **_null_** if ***nobody***
        /// is signed in!!
        User? get currentUser => _user;
        \\\
        ```
    compliant:
        ```dart
        \\\
        /// The signed-in user, or `null` if nobody is signed in.
        User? get currentUser => _user;
        \\\
        ```
    languages: [dart]
    tags: [avoid, documentation, markdown]
    source: https://dart.dev/effective-dart/documentation#avoid-using-markdown-excessively
