use ../lib/CodingRule

from ./EffectiveDart import EffectiveDart

export coding-rule EffectiveDartCodeSamplesInDocs:
    standard: @{EffectiveDart}
    ruleId: consider-including-code-samples-in-doc-comments
    title: Consider adding code samples to doc comments
    statement:
        Include a short usage example in doc comments where it helps readers
        see how to call the API.
    rationale:
        People learn quickly from examples, so even one sample makes an API
        easier to pick up.
    exceptions: null
    severity: null
    noncompliant:
        ```dart
        \\\
        /// Splits [text] into lines no wider than [width].
        List<String> wrapText(String text, int width) => [];
        \\\
        ```
    compliant:
        ```dart
        \\\
        /// Splits [text] into lines no wider than [width].
        ///
        /// ```dart
        /// wrapText('one two three', 7); // ['one two', 'three']
        /// ```
        List<String> wrapText(String text, int width) => [];
        \\\
        ```
    languages: [dart]
    tags: [consider, documentation, examples]
    source: https://dart.dev/effective-dart/documentation#consider-including-code-samples-in-doc-comments
