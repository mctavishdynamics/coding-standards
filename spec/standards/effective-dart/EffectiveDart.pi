export coding-standard EffectiveDart:
    title: Effective Dart
    publisher: The Dart Team, Google
    url: https://dart.dev/effective-dart
    version: 2026-09-02
    license:
        Text under the Creative Commons Attribution 4.0 License, code
        samples under the BSD-3-Clause License, copyright the Dart project
        authors.
    description:
        The Dart team's guidelines for idiomatic Dart, covering style,
        documentation, language usage and API design.
    rules:
        - @{EffectiveDartUpperCamelCaseTypes}
        - @{EffectiveDartUpperCamelCaseExtensions}
        - @{EffectiveDartLowercaseFileNames}
        - @{EffectiveDartLowercaseImportPrefixes}
        - @{EffectiveDartLowerCamelCaseIdentifiers}
        - @{EffectiveDartLowerCamelCaseConstants}
        - @{EffectiveDartCapitalizeAcronymsAsWords}
        - @{EffectiveDartWildcardUnusedCallbackParameters}
        - @{EffectiveDartNoUnderscoreForNonPrivate}
        - @{EffectiveDartNoPrefixLetters}
        - @{EffectiveDartNoLibraryNames}
        - @{EffectiveDartDartImportsFirst}
        - @{EffectiveDartPackageImportsBeforeRelative}
        - @{EffectiveDartExportsAfterImports}
        - @{EffectiveDartSortDirectiveSections}
        - @{EffectiveDartUseDartFormat}
        - @{EffectiveDartFormatterFriendlyCode}
        - @{EffectiveDartLinesOf80OrFewer}
        - @{EffectiveDartBracesForFlowControl}
        - @{EffectiveDartCommentsAsSentences}
        - @{EffectiveDartNoBlockComments}
        - @{EffectiveDartTripleSlashDocComments}
        - @{EffectiveDartDocumentPublicApis}
        - @{EffectiveDartLibraryDocComment}
        - @{EffectiveDartDocumentPrivateApis}
        - @{EffectiveDartSingleSentenceSummary}
        - @{EffectiveDartSummaryOwnParagraph}
        - @{EffectiveDartNoRedundantDocs}
        - @{EffectiveDartThirdPersonVerbsForSideEffects}
        - @{EffectiveDartNounPhraseForPropertyDocs}
        - @{EffectiveDartWhetherForBooleanDocs}
        - @{EffectiveDartDocValueReturningFunctionsAsProperties}
        - @{EffectiveDartDocGetterOrSetterNotBoth}
        - @{EffectiveDartNounPhraseForTypeDocs}
        - @{EffectiveDartCodeSamplesInDocs}
        - @{EffectiveDartSquareBracketReferences}
        - @{EffectiveDartProseForParameters}
        - @{EffectiveDartDocsBeforeAnnotations}
        - @{EffectiveDartLightMarkdown}
        - @{EffectiveDartNoHtmlInDocs}
        - @{EffectiveDartBacktickCodeFences}
        - @{EffectiveDartBriefDocs}
        - @{EffectiveDartNoObscureAbbreviationsInDocs}
        - @{EffectiveDartThisForInstance}
        - @{EffectiveDartPartOfUsesUri}
        - @{EffectiveDartNoImportsFromOtherSrc}
        - @{EffectiveDartNoRelativeImportsAcrossLib}
        - @{EffectiveDartPreferRelativeImports}
        - @{EffectiveDartNoInitToNull}
        - @{EffectiveDartNoNullDefault}
        - @{EffectiveDartNoBooleanLiteralComparison}
        - @{EffectiveDartNoLateWhenCheckingInit}
        - @{EffectiveDartPromoteNullableFields}
        - @{EffectiveDartAdjacentStringLiterals}
        - @{EffectiveDartStringInterpolation}
        - @{EffectiveDartNoUnneededInterpolationBraces}
        - @{EffectiveDartCollectionLiterals}
        - @{EffectiveDartUseIsEmpty}
        - @{EffectiveDartNoForEachWithLiteral}
        - @{EffectiveDartToListOverListFrom}
        - @{EffectiveDartWhereType}
        - @{EffectiveDartNoCastWhenNearbyOpWorks}
        - @{EffectiveDartAvoidCast}
        - @{EffectiveDartFunctionDeclarationsForNames}
        - @{EffectiveDartTearOffsOverLambdas}
        - @{EffectiveDartConsistentVarFinal}
        - @{EffectiveDartComputeInsteadOfStore}
        - @{EffectiveDartNoTrivialGettersSetters}
        - @{EffectiveDartFinalForReadOnly}
        - @{EffectiveDartArrowForSimpleMembers}
        - @{EffectiveDartNoUnneededThis}
        - @{EffectiveDartInitializeAtDeclaration}
        - @{EffectiveDartInitializingFormals}
        - @{EffectiveDartInitializerListOverLate}
        - @{EffectiveDartSemicolonForEmptyConstructor}
        - @{EffectiveDartConciseConstructorSyntax}
        - @{EffectiveDartNoNewKeyword}
        - @{EffectiveDartNoRedundantConst}
        - @{EffectiveDartCatchWithOn}
        - @{EffectiveDartNoSilentCatchAll}
        - @{EffectiveDartErrorOnlyForBugs}
        - @{EffectiveDartNoCatchingErrors}
        - @{EffectiveDartUseRethrow}
        - @{EffectiveDartAsyncAwait}
        - @{EffectiveDartNoUselessAsync}
        - @{EffectiveDartStreamTransforms}
        - @{EffectiveDartAvoidCompleter}
        - @{EffectiveDartTestForFutureInFutureOr}
        - @{EffectiveDartConsistentTerms}
        - @{EffectiveDartAvoidAbbreviations}
        - @{EffectiveDartDescriptiveNounLast}
        - @{EffectiveDartReadLikeASentence}
        - @{EffectiveDartNounPhraseForProperties}
        - @{EffectiveDartVerbPhraseForBooleans}
        - @{EffectiveDartOmitVerbInNamedBoolParam}
        - @{EffectiveDartPositiveBooleanNames}
