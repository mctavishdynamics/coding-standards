        - @{EffectiveDartAsMethodsForViews}
        - @{EffectiveDartNoParametersInNames}
        - @{EffectiveDartTypeParameterMnemonics}
        - @{EffectiveDartPreferPrivate}
        - @{EffectiveDartMultipleClassesPerLibrary}
        - @{EffectiveDartFunctionOverOneMemberClass}
        - @{EffectiveDartNoStaticOnlyClasses}
        - @{EffectiveDartNoExtendingClosedClasses}
        - @{EffectiveDartModifiersForExtension}
        - @{EffectiveDartNoImplementingClosedClasses}
        - @{EffectiveDartModifiersForInterfaces}
        - @{EffectiveDartPureMixinOrClass}
        - @{EffectiveDartConstConstructors}
        - @{EffectiveDartFinalFields}
        - @{EffectiveDartGettersForProperties}
        - @{EffectiveDartSettersForProperties}
        - @{EffectiveDartNoSetterWithoutGetter}
        - @{EffectiveDartNoFakeOverloading}
        - @{EffectiveDartNoPublicLateFinalWithoutInit}
        - @{EffectiveDartNoNullableContainers}
        - @{EffectiveDartCascadesOverFluentThis}
        - @{EffectiveDartAnnotateUninitializedVariables}
        - @{EffectiveDartAnnotateNonObviousFields}
        - @{EffectiveDartNoLocalTypeAnnotations}
        - @{EffectiveDartAnnotateReturnTypes}
        - @{EffectiveDartAnnotateParameterTypes}
        - @{EffectiveDartNoClosureParameterTypes}
        - @{EffectiveDartNoTypesOnInitializingFormals}
        - @{EffectiveDartWriteUninferredTypeArguments}
        - @{EffectiveDartNoInferredTypeArguments}
        - @{EffectiveDartCompleteGenericTypes}
        - @{EffectiveDartExplicitDynamic}
        - @{EffectiveDartFullFunctionSignatures}
        - @{EffectiveDartNoSetterReturnType}
        - @{EffectiveDartNoLegacyTypedef}
        - @{EffectiveDartInlineFunctionTypes}
        - @{EffectiveDartFunctionTypeSyntaxForParameters}
        - @{EffectiveDartObjectOverDynamic}
        - @{EffectiveDartFutureVoid}
        - @{EffectiveDartNoFutureOrReturn}
        - @{EffectiveDartNoPositionalBooleans}
        - @{EffectiveDartNamedOverSkippablePositional}
        - @{EffectiveDartOptionalOverSentinel}
