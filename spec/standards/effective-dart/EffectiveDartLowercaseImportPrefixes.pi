use ../lib/CodingRule

from ./EffectiveDart import EffectiveDart

export coding-rule EffectiveDartLowercaseImportPrefixes:
    standard: @{EffectiveDart}
    ruleId: do-name-import-prefixes-using-lowercase_with_underscores
    title: Use lowercase_with_underscores for import prefixes
    statement:
        Write the name after `as` in an import in lowercase letters with
        underscores between words. The library_prefixes lint checks this.
    rationale:
        Prefixes then match the file and package names they usually come
        from, and are not mistaken for types.
    exceptions: null
    severity: null
    noncompliant:
        ```dart
        \\\
        import 'dart:collection' as Collection;
        import 'package:shop/price_rules.dart' as priceRules;
        \\\
        ```
    compliant:
        ```dart
        \\\
        import 'dart:collection' as collection;
        import 'package:shop/price_rules.dart' as price_rules;
        \\\
        ```
    languages: [dart]
    tags: [do, naming, imports]
    source: https://dart.dev/effective-dart/style#do-name-import-prefixes-using-lowercase_with_underscores
