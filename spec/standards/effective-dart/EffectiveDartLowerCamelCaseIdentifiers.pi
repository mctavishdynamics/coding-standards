use ../lib/CodingRule

from ./EffectiveDart import EffectiveDart

export coding-rule EffectiveDartLowerCamelCaseIdentifiers:
    standard: @{EffectiveDart}
    ruleId: do-name-other-identifiers-using-lowercamelcase
    title: Write other identifiers in lowerCamelCase
    statement:
        Name members, top-level declarations, variables and parameters with
        a lowercase first word and a capital at the start of each later
        word, without separators. The non_constant_identifier_names lint
        checks this.
    rationale:
        A single convention for everything that is not a type keeps values
        easy to tell apart from types.
    exceptions: null
    severity: null
    noncompliant:
        ```dart
        \\\
        int Item_count = 0;
        void Reset_counter() {
          Item_count = 0;
        }
        \\\
        ```
    compliant:
        ```dart
        \\\
        int itemCount = 0;
        void resetCounter() {
          itemCount = 0;
        }
        \\\
        ```
    languages: [dart]
    tags: [do, naming]
    source: https://dart.dev/effective-dart/style#do-name-other-identifiers-using-lowercamelcase
