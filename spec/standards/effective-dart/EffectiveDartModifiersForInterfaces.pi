use ../lib/CodingRule

from ./EffectiveDart import EffectiveDart

export coding-rule EffectiveDartModifiersForInterfaces:
    standard: @{EffectiveDart}
    ruleId: do-use-class-modifiers-to-control-if-your-class-can-be-an-interface
    title: Mark whether a class may be implemented with class modifiers
    statement:
        Use modifiers such as `final`, `base` or `sealed` to prevent
        implementation outside the library. When using a library that lacks
        them, stay alert to unintended implementation.
    rationale:
        Enforced modifiers state the design intent and let authors change
        classes safely.
    exceptions: null
    severity: null
    noncompliant:
        ```dart
        \\\
        /// Not meant to be implemented.
        class Session {
          void close() {}
        }
        \\\
        ```
    compliant:
        ```dart
        \\\
        base class Session {
          void close() {}
        }
        \\\
        ```
    languages: [dart]
    tags: [do, classes, class-modifiers]
    source: https://dart.dev/effective-dart/design#do-use-class-modifiers-to-control-if-your-class-can-be-an-interface
