use ../lib/CodingRule

from ./EffectiveDart import EffectiveDart

export coding-rule EffectiveDartDescriptiveNounLast:
    standard: @{EffectiveDart}
    ruleId: prefer-putting-the-most-descriptive-noun-last
    title: End a name with the noun that says what it is
    statement:
        Make the last word of a name the noun that best describes the thing,
        and put qualifying words such as adjectives before it.
    rationale:
        English puts the head noun last, so names read naturally and group
        by kind.
    exceptions: null
    severity: null
    noncompliant:
        ```dart
        \\\
        class ButtonPrimary {}
        final countRetryMax = 5;
        \\\
        ```
    compliant:
        ```dart
        \\\
        class PrimaryButton {}
        final maxRetryCount = 5;
        \\\
        ```
    languages: [dart]
    tags: [prefer, naming]
    source: https://dart.dev/effective-dart/design#prefer-putting-the-most-descriptive-noun-last
