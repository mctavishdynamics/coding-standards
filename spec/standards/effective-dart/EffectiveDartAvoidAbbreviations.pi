use ../lib/CodingRule

from ./EffectiveDart import EffectiveDart

export coding-rule EffectiveDartAvoidAbbreviations:
    standard: @{EffectiveDart}
    ruleId: avoid-abbreviations
    title: Spell names out instead of abbreviating
    statement:
        Spell words out in names, except where the short form is better
        known than the full one. When you do keep an abbreviation,
        capitalize it according to the identifier casing rules.
    rationale:
        Abbreviations make readers guess, while common ones such as http or
        id are clearer than their expansions.
    exceptions: null
    severity: null
    noncompliant:
        ```dart
        \\\
        int numCustRecs = 0;
        Duration calcAvgRespTm() => Duration.zero;
        \\\
        ```
    compliant:
        ```dart
        \\\
        int customerRecordCount = 0;
        Duration averageResponseTime() => Duration.zero;
        \\\
        ```
    languages: [dart]
    tags: [avoid, naming]
    source: https://dart.dev/effective-dart/design#avoid-abbreviations
