use ../lib/CodingRule

from ./EffectiveDart import EffectiveDart

export coding-rule EffectiveDartFunctionOverOneMemberClass:
    standard: @{EffectiveDart}
    ruleId: avoid-defining-a-one-member-abstract-class-when-a-simple-function-will-do
    title: Use a function type instead of a single-method abstract class
    statement:
        When all you need is a callback, accept a function rather than an
        abstract class with one member such as call or invoke. The
        one_member_abstracts lint checks this.
    rationale:
        Dart has first-class functions and closures, so a one-method
        interface is extra ceremony.
    exceptions: null
    severity: null
    noncompliant:
        ```dart
        \\\
        abstract class Validator {
          bool call(String input);
        }
        \\\
        ```
    compliant:
        ```dart
        \\\
        typedef Validator = bool Function(String input);
        \\\
        ```
    languages: [dart]
    tags: [avoid, classes, functions]
    source: https://dart.dev/effective-dart/design#avoid-defining-a-one-member-abstract-class-when-a-simple-function-will-do
