use ../lib/CodingRule

from ./EffectiveDart import EffectiveDart

export coding-rule EffectiveDartNoFakeOverloading:
    standard: @{EffectiveDart}
    ruleId: avoid-using-runtime-type-tests-to-fake-overloading
    title: Write separate methods instead of type-testing to fake overloads
    statement:
        When callers know which type they have, give each operation its own
        method name instead of one method that branches on `is` checks.
    rationale:
        Separate methods keep the choice at compile time, with better type
        checking and no runtime tests.
    exceptions:
        One method that accepts a shared supertype makes sense when callers
        may not know a value's concrete type and expect the API to pick the
        right behaviour.
    severity: null
    noncompliant:
        ```dart
        \\\
        void draw(Object shape) {
          if (shape is Circle) _drawCircle(shape);
          if (shape is Polygon) _drawPolygon(shape);
        }
        \\\
        ```
    compliant:
        ```dart
        \\\
        void drawCircle(Circle circle) {}
        void drawPolygon(Polygon polygon) {}
        \\\
        ```
    languages: [dart]
    tags: [avoid, api-design, types]
    source: https://dart.dev/effective-dart/design#avoid-using-runtime-type-tests-to-fake-overloading
