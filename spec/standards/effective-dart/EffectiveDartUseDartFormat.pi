use ../lib/CodingRule

from ./EffectiveDart import EffectiveDart

export coding-rule EffectiveDartUseDartFormat:
    standard: @{EffectiveDart}
    ruleId: do-format-your-code-using-dart-format
    title: Format code with dart format
    statement:
        Run `dart format` on your code and accept its output as the official
        whitespace style.
    rationale:
        Hand formatting is slow, especially while refactoring, and an
        automatic formatter gives every Dart project the same layout.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [dart]
    tags: [do, formatting, tooling]
    source: https://dart.dev/effective-dart/style#do-format-your-code-using-dart-format
