use ../lib/CodingRule

from ./EffectiveDart import EffectiveDart

export coding-rule EffectiveDartBriefDocs:
    standard: @{EffectiveDart}
    ruleId: prefer-brevity
    title: Keep documentation short
    statement:
        Write documentation that is clear and exact, and as terse as that
        allows.
    rationale:
        Readers absorb short, precise text faster than long explanations.
    exceptions: null
    severity: null
    noncompliant:
        ```dart
        \\\
        /// This getter is what you would use in order to be able to find out
        /// what the total number of items that are in the cart happens to be.
        int get itemCount => _items.length;
        \\\
        ```
    compliant:
        ```dart
        \\\
        /// The number of items in this cart.
        int get itemCount => _items.length;
        \\\
        ```
    languages: [dart]
    tags: [prefer, documentation, writing]
    source: https://dart.dev/effective-dart/documentation#prefer-brevity
