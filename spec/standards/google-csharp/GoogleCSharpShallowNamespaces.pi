use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpShallowNamespaces:
    standard: @{GoogleCSharp}
    ruleId: shallow-namespaces
    title: Keep namespaces at most two levels deep
    statement:
        In general, nest namespaces no more than two levels deep.
    rationale:
        Shallow namespaces are easier to remember and type.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        namespace Acme.Store.Billing.Invoices.Pdf {
        }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        namespace Acme.Billing {
        }
        \\\
        ```
    languages: [csharp]
    tags: [naming, namespaces]
    source: https://google.github.io/styleguide/csharpguide.html#namespace-naming
