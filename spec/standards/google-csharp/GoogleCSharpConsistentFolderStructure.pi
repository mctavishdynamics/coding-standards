use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpConsistentFolderStructure:
    standard: @{GoogleCSharp}
    ruleId: consistent-folder-structure
    title: Keep folder layout consistent with the project
    statement:
        Place files and folders consistently with the rest of the project.
    rationale:
        A predictable layout makes code easy to find.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [files, organization]
    source: https://google.github.io/styleguide/csharpguide.html#folders-and-file-locations
