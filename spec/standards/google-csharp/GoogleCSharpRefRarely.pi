use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpRefRarely:
    standard: @{GoogleCSharp}
    ruleId: ref-rarely
    title: Use ref only when an input must be mutated
    statement:
        Use ref rarely, only where mutating a caller's variable is
        necessary.
    rationale:
        ref lets a method change the caller's variable, which is surprising
        and hard to follow.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [parameters, methods]
    source: https://google.github.io/styleguide/csharpguide.html#ref-and-out
