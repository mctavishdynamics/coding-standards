export coding-standard GoogleCSharp:
    title: Google C# Style Guide
    publisher: Google
    url: https://google.github.io/styleguide/csharpguide.html
    version: null
    license: Creative Commons Attribution 3.0 Unported (CC BY 3.0)
    description:
        Google's default style for C# code, covering naming, file
        organization, whitespace and practical coding guidelines. It follows
        Microsoft's naming guidelines and aligns with Google's C++ and Java
        styles.
    rules:
        - @{GoogleCSharpPascalCaseForTypesAndPublicMembers}
        - @{GoogleCSharpCamelCaseForLocalsAndParameters}
        - @{GoogleCSharpUnderscoreCamelCaseForNonPublicFields}
        - @{GoogleCSharpModifiersDoNotAffectNaming}
        - @{GoogleCSharpAcronymsAreWords}
        - @{GoogleCSharpInterfacesStartWithI}
        - @{GoogleCSharpPascalCaseFileAndDirectoryNames}
        - @{GoogleCSharpFileNamedAfterMainClass}
        - @{GoogleCSharpOneCoreClassPerFile}
        - @{GoogleCSharpModifierOrder}
        - @{GoogleCSharpUsingDeclarationsAtTop}
        - @{GoogleCSharpClassMemberOrdering}
        - @{GoogleCSharpGroupInterfaceImplementations}
        - @{GoogleCSharpOneStatementPerLine}
        - @{GoogleCSharpOneAssignmentPerStatement}
        - @{GoogleCSharpTwoSpaceIndentation}
        - @{GoogleCSharpColumnLimit100}
        - @{GoogleCSharpNoLineBreakBeforeOpeningBrace}
        - @{GoogleCSharpNoLineBreakBeforeElse}
        - @{GoogleCSharpBracesEvenWhenOptional}
        - @{GoogleCSharpSpaceAfterKeywordsAndCommas}
        - @{GoogleCSharpNoSpaceInsideParentheses}
        - @{GoogleCSharpOperatorSpacing}
        - @{GoogleCSharpLineContinuationIndent}
        - @{GoogleCSharpArgumentWrapping}
        - @{GoogleCSharpUseConstWhenPossible}
        - @{GoogleCSharpReadonlyWhenConstImpossible}
        - @{GoogleCSharpNamedConstantsOverMagicNumbers}
        - @{GoogleCSharpLeastCapableInputTypes}
        - @{GoogleCSharpOutputContainerTypes}
        - @{GoogleCSharpGeneratorsVsContainers}
        - @{GoogleCSharpPropertyStyles}
        - @{GoogleCSharpJudiciousExpressionBodies}
        - @{GoogleCSharpExpressionBodyMethodsSingleStatement}
        - @{GoogleCSharpClosingBraceAlignment}
        - @{GoogleCSharpPreferClassesOverStructs}
        - @{GoogleCSharpNamedMethodsForNontrivialLambdas}
        - @{GoogleCSharpFieldInitializersEncouraged}
        - @{GoogleCSharpExtensionMethodsOnlyWithoutSource}
        - @{GoogleCSharpExtensionMethodsCoreFeaturesOnly}
        - @{GoogleCSharpExtensionMethodsInCoreLibraries}
        - @{GoogleCSharpErrAgainstExtensionMethods}
        - @{GoogleCSharpOutForExtraReturns}
        - @{GoogleCSharpOutParametersLast}
        - @{GoogleCSharpRefRarely}
        - @{GoogleCSharpNoRefForStructOptimisation}
        - @{GoogleCSharpNoRefForContainers}
        - @{GoogleCSharpAvoidLongLinqChains}
        - @{GoogleCSharpPreferLinqExtensionMethods}
        - @{GoogleCSharpAvoidForeachMethodForMultipleStatements}
        - @{GoogleCSharpListForPublicApi}
        - @{GoogleCSharpListForVariableSize}
        - @{GoogleCSharpArraysForFixedSize}
        - @{GoogleCSharpArraysForMultidimensional}
        - @{GoogleCSharpConsistentFolderStructure}
        - @{GoogleCSharpFlatFolderStructure}
        - @{GoogleCSharpNamedClassOverTuple}
        - @{GoogleCSharpReadableStringFormatting}
        - @{GoogleCSharpAvoidChainedStringConcatenation}
        - @{GoogleCSharpNoUsingAliasesForLongTypes}
        - @{GoogleCSharpObjectInitializersForPlainData}
        - @{GoogleCSharpNoObjectInitializersWithConstructors}
        - @{GoogleCSharpIndentMultilineObjectInitializers}
        - @{GoogleCSharpShallowNamespaces}
        - @{GoogleCSharpNamespacesNeedNotMatchFolders}
        - @{GoogleCSharpNamespacesForSharedCode}
        - @{GoogleCSharpUniqueTopLevelNamespaces}
        - @{GoogleCSharpSuccessBoolAndOutStruct}
        - @{GoogleCSharpRemoveAllForConditionalRemoval}
        - @{GoogleCSharpBuildNewContainerWhenRemoving}
        - @{GoogleCSharpInvokeDelegatesWithNullConditional}
        - @{GoogleCSharpVarWhenItAidsReadability}
        - @{GoogleCSharpAttributesOnOwnLine}
        - @{GoogleCSharpOneAttributePerLine}
        - @{GoogleCSharpNamedConstantsForSharedLiterals}
        - @{GoogleCSharpEnumInsteadOfBoolArgument}
        - @{GoogleCSharpNamedVariablesForComplexExpressions}
        - @{GoogleCSharpNamedArgumentsForClarity}
        - @{GoogleCSharpOptionsObjectForManySettings}
        - @{GoogleCSharpClassComments}
        - @{GoogleCSharpMethodComments}
        - @{GoogleCSharpClassMemberComments}
        - @{GoogleCSharpVariableComments}
        - @{GoogleCSharpExplanatoryComments}
