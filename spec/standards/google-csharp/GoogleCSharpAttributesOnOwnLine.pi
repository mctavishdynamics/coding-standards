use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpAttributesOnOwnLine:
    standard: @{GoogleCSharp}
    ruleId: attributes-on-own-line
    title: Put attributes on the line above the member
    statement:
        Place an attribute on its own line directly above the field,
        property or method it applies to.
    rationale:
        The member declaration stays easy to read.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        [Obsolete] public void Sync() { }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        [Obsolete]
        public void Sync() { }
        \\\
        ```
    languages: [csharp]
    tags: [formatting, attributes]
    source: https://google.github.io/styleguide/csharpguide.html#attributes
