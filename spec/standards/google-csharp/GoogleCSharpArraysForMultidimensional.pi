use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpArraysForMultidimensional:
    standard: @{GoogleCSharp}
    ruleId: arrays-for-multidimensional
    title: Use arrays for multidimensional data
    statement:
        Prefer arrays for multidimensional collections.
    rationale:
        Multidimensional arrays model grids directly, unlike nested lists.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        var board = new List<List<char>>();
        \\\
        ```
    compliant:
        ```csharp
        \\\
        var board = new char[8, 8];
        \\\
        ```
    languages: [csharp]
    tags: [collections]
    source: https://google.github.io/styleguide/csharpguide.html#array-vs-list
