use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpPascalCaseForTypesAndPublicMembers:
    standard: @{GoogleCSharp}
    ruleId: pascal-case-for-types-and-public-members
    title: Use PascalCase for types, methods and public members
    statement:
        Use PascalCase for namespaces, classes, enums and methods, and for
        any field or property that is public.
    rationale:
        The convention follows Microsoft's C# naming guidelines, so code
        matches the framework it uses.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public class order_summary {
          public int itemCount;
          public decimal totalPrice() { return 0m; }
        }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public class OrderSummary {
          public int ItemCount;
          public decimal TotalPrice() { return 0m; }
        }
        \\\
        ```
    languages: [csharp]
    tags: [naming]
    source: https://google.github.io/styleguide/csharpguide.html#code
