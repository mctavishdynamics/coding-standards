use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpIndentMultilineObjectInitializers:
    standard: @{GoogleCSharp}
    ruleId: indent-multiline-object-initializers
    title: Indent multi-line object initializers one block level
    statement:
        When an object initializer spans several lines, indent its members
        one block level.
    rationale:
        It matches the indentation of other blocks.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        var size = new Size {
            Width = 640,
            Height = 480,
        };
        \\\
        ```
    compliant:
        ```csharp
        \\\
        var size = new Size {
          Width = 640,
          Height = 480,
        };
        \\\
        ```
    languages: [csharp]
    tags: [formatting, initialization, indentation]
    source: https://google.github.io/styleguide/csharpguide.html#object-initializer-syntax
