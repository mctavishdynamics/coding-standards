use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpOneStatementPerLine:
    standard: @{GoogleCSharp}
    ruleId: one-statement-per-line
    title: Write at most one statement per line
    statement:
        Put no more than one statement on a line.
    rationale:
        Separate lines make each statement easy to read, debug and diff.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        count++; total += price;
        \\\
        ```
    compliant:
        ```csharp
        \\\
        count++;
        total += price;
        \\\
        ```
    languages: [csharp]
    tags: [formatting, statements]
    source: https://google.github.io/styleguide/csharpguide.html#whitespace-rules
