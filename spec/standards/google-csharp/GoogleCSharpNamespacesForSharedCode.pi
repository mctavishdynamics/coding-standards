use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpNamespacesForSharedCode:
    standard: @{GoogleCSharp}
    ruleId: namespaces-for-shared-code
    title: Use namespaces for shared library code
    statement:
        Put shared library and module code in namespaces. Leaf application
        code does not need a namespace.
    rationale:
        Namespaces prevent collisions where code is reused, and add nothing
        for a standalone application.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [namespaces, organization]
    source: https://google.github.io/styleguide/csharpguide.html#namespace-naming
