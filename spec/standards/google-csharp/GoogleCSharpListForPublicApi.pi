use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpListForPublicApi:
    standard: @{GoogleCSharp}
    ruleId: list-for-public-api
    title: Prefer List over arrays in public members
    statement:
        As a default, expose List rather than an array from public fields,
        properties and method results. Inputs and outputs still follow the
        guidance on choosing interface types.
    rationale:
        List is more flexible than a fixed-capacity array.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public string[] Tags { get; set; }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public List<string> Tags { get; set; }
        \\\
        ```
    languages: [csharp]
    tags: [collections, api-design]
    source: https://google.github.io/styleguide/csharpguide.html#array-vs-list
