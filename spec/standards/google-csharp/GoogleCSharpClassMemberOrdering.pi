use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpClassMemberOrdering:
    standard: @{GoogleCSharp}
    ruleId: class-member-ordering
    title: Order class members by kind and then by access
    statement:
        Lay a class out by kind of member. Begin with nested types,
        delegates and events, continue with the static, const and readonly
        fields, and then put ordinary fields and properties. Constructors
        and finalizers follow, with methods at the end. Inside every group,
        order by access, starting at public and ending at private, with
        internal, protected internal and protected in between.
    rationale:
        A fixed layout lets readers find members quickly and puts the public
        surface first.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public class Cart {
          private void Recalculate() { }
          public Cart() { }
          private readonly List<Item> _items = new List<Item>();
          public decimal Total { get; private set; }
        }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public class Cart {
          private readonly List<Item> _items = new List<Item>();
          public decimal Total { get; private set; }
          public Cart() { }
          private void Recalculate() { }
        }
        \\\
        ```
    languages: [csharp]
    tags: [organization, classes, ordering]
    source: https://google.github.io/styleguide/csharpguide.html#organization
