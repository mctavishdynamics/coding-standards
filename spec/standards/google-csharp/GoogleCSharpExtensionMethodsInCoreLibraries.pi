use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpExtensionMethodsInCoreLibraries:
    standard: @{GoogleCSharp}
    ruleId: extension-methods-in-core-libraries
    title: Put extension methods only in widely available core libraries
    statement:
        Only place extension methods in core libraries that are available
        everywhere.
    rationale:
        Extensions visible in only some code make the same type appear to
        have different members in different places.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [extension-methods, organization]
    source: https://google.github.io/styleguide/csharpguide.html#extension-methods
