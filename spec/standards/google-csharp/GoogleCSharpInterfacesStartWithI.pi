use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpInterfacesStartWithI:
    standard: @{GoogleCSharp}
    ruleId: interfaces-start-with-i
    title: Start interface names with I
    statement:
        Prefix every interface name with a capital I.
    rationale:
        Readers can tell interfaces from classes at a glance.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public interface Repository {
          void Save(Order order);
        }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public interface IRepository {
          void Save(Order order);
        }
        \\\
        ```
    languages: [csharp]
    tags: [naming, interfaces]
    source: https://google.github.io/styleguide/csharpguide.html#code
