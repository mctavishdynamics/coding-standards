use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpEnumInsteadOfBoolArgument:
    standard: @{GoogleCSharp}
    ruleId: enum-instead-of-bool-argument
    title: Consider an enum instead of a bool parameter
    statement:
        Consider replacing a bool parameter with an enum so that argument
        values describe themselves.
    rationale:
        A bare true or false at a call site says nothing about its meaning.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        Export(report, true);
        \\\
        ```
    compliant:
        ```csharp
        \\\
        Export(report, ExportFormat.Compressed);
        \\\
        ```
    languages: [csharp]
    tags: [readability, parameters, enums]
    source: https://google.github.io/styleguide/csharpguide.html#argument-naming
