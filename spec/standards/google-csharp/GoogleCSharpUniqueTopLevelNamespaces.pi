use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpUniqueTopLevelNamespaces:
    standard: @{GoogleCSharp}
    ruleId: unique-top-level-namespaces
    title: Make new top-level namespaces unique
    statement:
        Give a new top-level namespace a name that is globally unique and
        recognizable.
    rationale:
        Unique roots avoid clashes with other libraries.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        namespace Utils {
        }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        namespace AcmeTelemetry {
        }
        \\\
        ```
    languages: [csharp]
    tags: [naming, namespaces]
    source: https://google.github.io/styleguide/csharpguide.html#namespace-naming
