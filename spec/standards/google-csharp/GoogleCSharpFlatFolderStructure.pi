use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpFlatFolderStructure:
    standard: @{GoogleCSharp}
    ruleId: flat-folder-structure
    title: Prefer a flat folder structure
    statement:
        Keep the folder hierarchy flat where possible.
    rationale:
        Deep trees make files harder to find and paths longer.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [files, organization]
    source: https://google.github.io/styleguide/csharpguide.html#folders-and-file-locations
