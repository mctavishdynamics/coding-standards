use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpJudiciousExpressionBodies:
    standard: @{GoogleCSharp}
    ruleId: judicious-expression-bodies
    title: Use expression body syntax judiciously
    statement:
        Use expression body syntax in lambdas and properties with judgement,
        where it keeps the code clear.
    rationale:
        Expression bodies are concise but become hard to read when stretched
        over complex logic.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [syntax, lambdas]
    source: https://google.github.io/styleguide/csharpguide.html#expression-body-syntax
