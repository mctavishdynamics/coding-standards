use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpCamelCaseForLocalsAndParameters:
    standard: @{GoogleCSharp}
    ruleId: camel-case-for-locals-and-parameters
    title: Use camelCase for locals and parameters
    statement:
        Name local variables and parameters in camelCase.
    rationale:
        Lowercase initial letters separate locals from types and public
        members.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        void Ship(int OrderId) {
          var DeliveryDate = DateTime.Today;
        }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        void Ship(int orderId) {
          var deliveryDate = DateTime.Today;
        }
        \\\
        ```
    languages: [csharp]
    tags: [naming, variables]
    source: https://google.github.io/styleguide/csharpguide.html#code
