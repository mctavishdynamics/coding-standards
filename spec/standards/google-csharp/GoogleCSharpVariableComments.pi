use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpVariableComments:
    standard: @{GoogleCSharp}
    ruleId: variable-comments
    title: Let variable names explain variables
    statement:
        Choose variable names that describe what the variable is for, and
        add a comment only when the name cannot say enough.
    rationale:
        A good name documents the variable everywhere it is used.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        int d;  // Days until the trial ends.
        \\\
        ```
    compliant:
        ```csharp
        \\\
        int daysUntilTrialEnds;
        \\\
        ```
    languages: [csharp]
    tags: [comments, naming]
    source: https://google.github.io/styleguide/csharpguide.html#variable-comments
