use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpModifierOrder:
    standard: @{GoogleCSharp}
    ruleId: modifier-order
    title: Write modifiers in the standard order
    statement:
        Access keywords lead, in the order public, protected, internal,
        private. Next comes new, then the inheritance keywords abstract,
        virtual, override and sealed. After those come static and readonly,
        and the sequence closes with extern, unsafe, volatile and finally
        async.
    rationale:
        A fixed order makes declarations easy to scan and compare.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        static public readonly int Limit = 10;
        override protected async Task RunAsync() { }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public static readonly int Limit = 10;
        protected override async Task RunAsync() { }
        \\\
        ```
    languages: [csharp]
    tags: [organization, modifiers]
    source: https://google.github.io/styleguide/csharpguide.html#organization
