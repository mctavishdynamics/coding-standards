use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpFileNamedAfterMainClass:
    standard: @{GoogleCSharp}
    ruleId: file-named-after-main-class
    title: Name the file after its main class
    statement:
        Where possible, give a file the same name as the main class it
        contains.
    rationale:
        Readers can find a class by its file name.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        // File: Helpers.cs
        public class InvoiceFormatter { }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        // File: InvoiceFormatter.cs
        public class InvoiceFormatter { }
        \\\
        ```
    languages: [csharp]
    tags: [naming, files]
    source: https://google.github.io/styleguide/csharpguide.html#files
