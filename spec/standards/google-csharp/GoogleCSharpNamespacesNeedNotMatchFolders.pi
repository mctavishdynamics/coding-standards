use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpNamespacesNeedNotMatchFolders:
    standard: @{GoogleCSharp}
    ruleId: namespaces-need-not-match-folders
    title: Do not force folders to match namespaces
    statement:
        Do not force the file and folder layout to mirror the namespaces.
    rationale:
        Folders and namespaces serve different purposes and can be organized
        independently.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [namespaces, files]
    source: https://google.github.io/styleguide/csharpguide.html#namespace-naming
