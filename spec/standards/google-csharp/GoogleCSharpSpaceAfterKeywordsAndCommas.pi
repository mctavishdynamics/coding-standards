use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpSpaceAfterKeywordsAndCommas:
    standard: @{GoogleCSharp}
    ruleId: space-after-keywords-and-commas
    title: Put a space after control keywords and commas
    statement:
        Put a space after if, for, while and similar keywords, and after
        every comma.
    rationale:
        The spacing separates keywords from calls and arguments from each
        other.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        for(int i = 0; i < n; i++) {
          Draw(x,y);
        }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        for (int i = 0; i < n; i++) {
          Draw(x, y);
        }
        \\\
        ```
    languages: [csharp]
    tags: [formatting, whitespace]
    source: https://google.github.io/styleguide/csharpguide.html#whitespace-rules
