use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpNoLineBreakBeforeOpeningBrace:
    standard: @{GoogleCSharp}
    ruleId: no-line-break-before-opening-brace
    title: Do not break the line before an opening brace
    statement:
        Keep the opening brace on the line that introduces the block instead
        of moving it down to a separate line.
    rationale:
        This matches Google style in other languages and saves vertical
        space.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public void Save()
        {
          _store.Write(this);
        }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public void Save() {
          _store.Write(this);
        }
        \\\
        ```
    languages: [csharp]
    tags: [formatting, braces]
    source: https://google.github.io/styleguide/csharpguide.html#whitespace-rules
