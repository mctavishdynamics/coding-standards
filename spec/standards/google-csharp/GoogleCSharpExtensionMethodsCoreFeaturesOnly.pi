use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpExtensionMethodsCoreFeaturesOnly:
    standard: @{GoogleCSharp}
    ruleId: extension-methods-core-features-only
    title: Add only core general features as extension methods
    statement:
        Use an extension method only for core, general functionality that
        would be suitable to add to the original class itself.
    rationale:
        Narrow helpers disguised as members confuse readers about what the
        type offers.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [extension-methods, api-design]
    source: https://google.github.io/styleguide/csharpguide.html#extension-methods
