use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpNoSpaceInsideParentheses:
    standard: @{GoogleCSharp}
    ruleId: no-space-inside-parentheses
    title: Do not pad the inside of parentheses
    statement:
        Parentheses sit directly against what they enclose, with no blank
        padding on the inner side of either the opening or the closing one.
    rationale:
        Consistent tight parentheses make expressions easier to scan.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        Send( message, retries );
        \\\
        ```
    compliant:
        ```csharp
        \\\
        Send(message, retries);
        \\\
        ```
    languages: [csharp]
    tags: [formatting, whitespace]
    source: https://google.github.io/styleguide/csharpguide.html#whitespace-rules
