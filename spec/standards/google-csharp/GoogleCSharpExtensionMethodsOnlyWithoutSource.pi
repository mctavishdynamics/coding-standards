use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpExtensionMethodsOnlyWithoutSource:
    standard: @{GoogleCSharp}
    ruleId: extension-methods-only-without-source
    title: Use extension methods only when the class source cannot change
    statement:
        Reach for an extension method only if you cannot get at the type's
        own code or changing it is not practical. When the code is yours and
        whoever maintains it rejects the method, that rejection covers an
        extension method too.
    rationale:
        A method that belongs on a class should live in that class.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [extension-methods, api-design]
    source: https://google.github.io/styleguide/csharpguide.html#extension-methods
