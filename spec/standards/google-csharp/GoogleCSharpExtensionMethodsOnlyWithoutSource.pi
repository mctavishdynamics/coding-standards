use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpExtensionMethodsOnlyWithoutSource:
    standard: @{GoogleCSharp}
    ruleId: extension-methods-only-without-source
    title: Use extension methods only when the class source cannot change
    statement:
        Write an extension method only when the source of the original class
        is unavailable or cannot reasonably be changed. If you own the
        source and its maintainer declines the method, do not add it as an
        extension either.
    rationale:
        A method that belongs on a class should live in that class.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [extension-methods, api-design]
    source: https://google.github.io/styleguide/csharpguide.html#extension-methods
