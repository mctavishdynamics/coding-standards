use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpTwoSpaceIndentation:
    standard: @{GoogleCSharp}
    ruleId: two-space-indentation
    title: Indent with two spaces and no tabs
    statement:
        Indent each block level with two spaces, never tabs.
    rationale:
        The style follows Google Java and C++ style, keeping code consistent
        across languages.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        public void Reset() {
            _count = 0;
        }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        public void Reset() {
          _count = 0;
        }
        \\\
        ```
    languages: [csharp]
    tags: [formatting, indentation]
    source: https://google.github.io/styleguide/csharpguide.html#whitespace-rules
