use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpPascalCaseFileAndDirectoryNames:
    standard: @{GoogleCSharp}
    ruleId: pascal-case-file-and-directory-names
    title: Use PascalCase file and directory names
    statement:
        Name files and directories in PascalCase, such as MyFile.cs.
    rationale:
        File names then match the type names they contain.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        src/payment_gateway/stripe_client.cs
        \\\
        ```
    compliant:
        ```csharp
        \\\
        src/PaymentGateway/StripeClient.cs
        \\\
        ```
    languages: [csharp]
    tags: [naming, files]
    source: https://google.github.io/styleguide/csharpguide.html#files
