use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpObjectInitializersForPlainData:
    standard: @{GoogleCSharp}
    ruleId: object-initializers-for-plain-data
    title: Use object initializers for plain data types
    statement:
        When a type is a simple data holder, it is acceptable to set its
        members with an object initializer.
    rationale:
        It sets several fields of a simple record in one readable
        expression.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```csharp
        \\\
        var point = new Point {
          X = 3,
          Y = 4,
        };
        \\\
        ```
    languages: [csharp]
    tags: [initialization, syntax]
    source: https://google.github.io/styleguide/csharpguide.html#object-initializer-syntax
