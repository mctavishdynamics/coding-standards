use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpErrAgainstExtensionMethods:
    standard: @{GoogleCSharp}
    ruleId: err-against-extension-methods
    title: Err on the side of not adding extension methods
    statement:
        When in doubt, do not add an extension method.
    rationale:
        Extension methods always obscure where behaviour comes from.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [extension-methods, readability]
    source: https://google.github.io/styleguide/csharpguide.html#extension-methods
