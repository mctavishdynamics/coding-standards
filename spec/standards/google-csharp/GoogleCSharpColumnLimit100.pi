use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpColumnLimit100:
    standard: @{GoogleCSharp}
    ruleId: column-limit-100
    title: Limit lines to 100 columns
    statement:
        Keep each line at or under 100 characters.
    rationale:
        A fixed limit keeps code readable side by side and in review tools.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [csharp]
    tags: [formatting, line-length]
    source: https://google.github.io/styleguide/csharpguide.html#whitespace-rules
