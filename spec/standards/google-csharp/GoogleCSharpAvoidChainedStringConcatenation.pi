use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpAvoidChainedStringConcatenation:
    standard: @{GoogleCSharp}
    ruleId: avoid-chained-string-concatenation
    title: Use StringBuilder instead of repeated concatenation when speed matters
    statement:
        Be aware that chained plus concatenation is slow and creates a lot
        of garbage. When performance matters, use StringBuilder for many
        concatenations.
    rationale:
        Each concatenation allocates a new string.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        string csv = "";
        foreach (var row in rows) {
          csv += row.Name + "," + row.Value + "\n";
        }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        var csv = new StringBuilder();
        foreach (var row in rows) {
          csv.Append(row.Name).Append(',').Append(row.Value).Append('\n');
        }
        \\\
        ```
    languages: [csharp]
    tags: [strings, performance]
    source: https://google.github.io/styleguide/csharpguide.html#string-interpolation-vs-stringformat-vs-stringconcat-vs-operator
