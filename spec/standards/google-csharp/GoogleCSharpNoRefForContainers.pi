use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpNoRefForContainers:
    standard: @{GoogleCSharp}
    ruleId: no-ref-for-containers
    title: Do not use ref to pass a modifiable container
    statement:
        Do not pass a container by ref so that a method can modify it. ref
        is only needed when the caller's container must be replaced by a
        different instance.
    rationale:
        Containers are reference types, so the method can already change
        their contents.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        void AddDefaults(ref List<string> names) {
          names.Add("admin");
        }
        \\\
        ```
    compliant:
        ```csharp
        \\\
        void AddDefaults(List<string> names) {
          names.Add("admin");
        }
        \\\
        ```
    languages: [csharp]
    tags: [parameters, collections]
    source: https://google.github.io/styleguide/csharpguide.html#ref-and-out
