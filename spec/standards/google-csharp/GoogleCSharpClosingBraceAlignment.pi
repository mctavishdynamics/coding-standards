use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpClosingBraceAlignment:
    standard: @{GoogleCSharp}
    ruleId: closing-brace-alignment
    title: Align closing braces with the opening line
    statement:
        A closing brace lines up with the start of the line where its
        opening brace appears. This holds for lambdas and every other braced
        scope.
    rationale:
        The block's extent is clear at a glance.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        Func<int, int> square = x => {
                                  return x * x;
                                };
        \\\
        ```
    compliant:
        ```csharp
        \\\
        Func<int, int> square = x => {
          return x * x;
        };
        \\\
        ```
    languages: [csharp]
    tags: [formatting, braces, lambdas]
    source: https://google.github.io/styleguide/csharpguide.html#expression-body-syntax
