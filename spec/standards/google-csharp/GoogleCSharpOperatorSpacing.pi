use ../lib/CodingRule

from ./GoogleCSharp import GoogleCSharp

export coding-rule GoogleCSharpOperatorSpacing:
    standard: @{GoogleCSharp}
    ruleId: operator-spacing
    title: Space binary operators but not unary ones
    statement:
        Put no space between a unary operator and its operand, and one space
        between every other operator and each of its operands.
    rationale:
        Uniform spacing shows the structure of an expression.
    exceptions: null
    severity: null
    noncompliant:
        ```csharp
        \\\
        var total=price*quantity+ shipping;
        var flag = ! isReady;
        \\\
        ```
    compliant:
        ```csharp
        \\\
        var total = price * quantity + shipping;
        var flag = !isReady;
        \\\
        ```
    languages: [csharp]
    tags: [formatting, whitespace, operators]
    source: https://google.github.io/styleguide/csharpguide.html#whitespace-rules
