use ../lib/CodingStandard

from ./PowerOfTenRule1 import PowerOfTenRule1
from ./PowerOfTenRule10 import PowerOfTenRule10
from ./PowerOfTenRule2 import PowerOfTenRule2
from ./PowerOfTenRule3 import PowerOfTenRule3
from ./PowerOfTenRule4 import PowerOfTenRule4
from ./PowerOfTenRule5 import PowerOfTenRule5
from ./PowerOfTenRule6 import PowerOfTenRule6
from ./PowerOfTenRule7 import PowerOfTenRule7
from ./PowerOfTenRule8 import PowerOfTenRule8
from ./PowerOfTenRule9 import PowerOfTenRule9

export coding-standard PowerOfTen:
    title: The Power of 10 - Rules for Developing Safety-Critical Code
    publisher: Gerard J. Holzmann, NASA/JPL Laboratory for Reliable Software
    url: https://spinroot.com/gerard/pdf/P10.pdf
    version: IEEE Computer, June 2006
    license: Copyright Gerard J. Holzmann, all rights reserved. Rules are paraphrased.
    description:
        Ten strict, tool-checkable rules for safety-critical C code, written
        at the NASA/JPL Laboratory for Reliable Software. They cover control
        flow, loop bounds, memory, function size, assertions and tooling.
    rules:
        - @{PowerOfTenRule1}
        - @{PowerOfTenRule2}
        - @{PowerOfTenRule3}
        - @{PowerOfTenRule4}
        - @{PowerOfTenRule5}
        - @{PowerOfTenRule6}
        - @{PowerOfTenRule7}
        - @{PowerOfTenRule8}
        - @{PowerOfTenRule9}
        - @{PowerOfTenRule10}
