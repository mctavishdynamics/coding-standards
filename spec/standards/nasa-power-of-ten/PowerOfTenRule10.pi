use ../lib/CodingRule

from ./PowerOfTen import PowerOfTen

export coding-rule PowerOfTenRule10:
    standard: @{PowerOfTen}
    ruleId: rule-10
    title: Build and analyze with zero warnings from day one
    statement:
        From the first day, compile all code with every warning enabled at
        the most pedantic setting, with no warnings left. Check the code
        daily with at least one, preferably several, static analyzers and
        aim for zero warnings.
    rationale:
        Capable analysis tools are cheap and quick, so every project can use
        them. If a tool misreads some code, reshape that code until the tool
        is satisfied, since a warning that seems wrong frequently points at
        a real fault.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [tooling, static-analysis, warnings]
    source: https://spinroot.com/gerard/pdf/P10.pdf
