use ../lib/CodingRule

from ./PowerOfTen import PowerOfTen

export coding-rule PowerOfTenRule4:
    standard: @{PowerOfTen}
    ruleId: rule-4
    title: Keep functions to about one page
    statement:
        Size each function so that, written one statement or declaration per
        line, it fits on a page. Roughly 60 lines is the practical ceiling.
    rationale:
        A short function can be read, reviewed and checked in one sitting.
        Once a body runs over several screens it gets hard to grasp, and the
        length usually hints that the design needs splitting.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [function-size, readability]
    source: https://spinroot.com/gerard/pdf/P10.pdf
