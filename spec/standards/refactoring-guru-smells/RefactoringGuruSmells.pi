use ../lib/CodingStandard

from ./GuruSmellAlternativeClassesWithDifferentInterfaces import
    GuruSmellAlternativeClassesWithDifferentInterfaces
from ./GuruSmellComments import GuruSmellComments
from ./GuruSmellDataClass import GuruSmellDataClass
from ./GuruSmellDataClumps import GuruSmellDataClumps
from ./GuruSmellDeadCode import GuruSmellDeadCode
from ./GuruSmellDivergentChange import GuruSmellDivergentChange
from ./GuruSmellDuplicateCode import GuruSmellDuplicateCode
from ./GuruSmellFeatureEnvy import GuruSmellFeatureEnvy
from ./GuruSmellInappropriateIntimacy import GuruSmellInappropriateIntimacy
from ./GuruSmellIncompleteLibraryClass import GuruSmellIncompleteLibraryClass
from ./GuruSmellLargeClass import GuruSmellLargeClass
from ./GuruSmellLazyClass import GuruSmellLazyClass
from ./GuruSmellLongMethod import GuruSmellLongMethod
from ./GuruSmellLongParameterList import GuruSmellLongParameterList
from ./GuruSmellMessageChains import GuruSmellMessageChains
from ./GuruSmellMiddleMan import GuruSmellMiddleMan
from ./GuruSmellParallelInheritanceHierarchies import
    GuruSmellParallelInheritanceHierarchies
from ./GuruSmellPrimitiveObsession import GuruSmellPrimitiveObsession
from ./GuruSmellRefusedBequest import GuruSmellRefusedBequest
from ./GuruSmellShotgunSurgery import GuruSmellShotgunSurgery
from ./GuruSmellSpeculativeGenerality import GuruSmellSpeculativeGenerality
from ./GuruSmellSwitchStatements import GuruSmellSwitchStatements
from ./GuruSmellTemporaryField import GuruSmellTemporaryField

export coding-standard RefactoringGuruSmells:
    title: Refactoring.Guru - Code Smells
    publisher: Refactoring.Guru
    url: https://refactoring.guru/refactoring/smells
    version: null
    license: Copyright Refactoring.Guru, all rights reserved
    description:
        A catalogue of 23 code smells in five groups, Bloaters, Object-
        Orientation Abusers, Change Preventers, Dispensables and Couplers,
        each with the refactorings that usually remove it.
    rules:
        - @{GuruSmellLongMethod}
        - @{GuruSmellLargeClass}
        - @{GuruSmellPrimitiveObsession}
        - @{GuruSmellLongParameterList}
        - @{GuruSmellDataClumps}
        - @{GuruSmellAlternativeClassesWithDifferentInterfaces}
        - @{GuruSmellRefusedBequest}
        - @{GuruSmellSwitchStatements}
        - @{GuruSmellTemporaryField}
        - @{GuruSmellDivergentChange}
        - @{GuruSmellParallelInheritanceHierarchies}
        - @{GuruSmellShotgunSurgery}
        - @{GuruSmellComments}
        - @{GuruSmellDuplicateCode}
        - @{GuruSmellDataClass}
        - @{GuruSmellDeadCode}
        - @{GuruSmellLazyClass}
        - @{GuruSmellSpeculativeGenerality}
        - @{GuruSmellFeatureEnvy}
        - @{GuruSmellInappropriateIntimacy}
        - @{GuruSmellIncompleteLibraryClass}
        - @{GuruSmellMessageChains}
        - @{GuruSmellMiddleMan}
