use ../lib/CodingRule

from ./TwelveFactor import TwelveFactor

export coding-rule TwelveFactorCodebase:
    standard: @{TwelveFactor}
    ruleId: I
    title: Keep one codebase in version control with many deploys
    statement:
        Track each app in a single repository, or a set of repositories
        sharing a root commit, and run every deploy, from a developer laptop
        to production, from that one codebase. Deploys may run different
        versions of it.
    rationale:
        A one-to-one link between codebase and app makes deploys
        identifiable as the same app. Several codebases make a distributed
        system, and several apps sharing code should move that code into
        libraries.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [version-control, deployment]
    source: https://12factor.net/codebase
