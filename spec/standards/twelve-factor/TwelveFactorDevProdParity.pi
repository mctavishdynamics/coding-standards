use ../lib/CodingRule

from ./TwelveFactor import TwelveFactor

export coding-rule TwelveFactorDevProdParity:
    standard: @{TwelveFactor}
    ruleId: X
    title: Keep development, staging and production as similar as possible
    statement:
        Keep the time, personnel and tools gaps small: deploy within hours
        of writing code, have the authors deploy and watch it, and use the
        same type and version of every backing service in all environments.
    rationale:
        Differences between backing services cause small incompatibilities
        that let code pass in development and fail in production, which
        discourages continuous deployment.
    exceptions:
        Adapters to different backing services are still useful for porting,
        as long as every deploy uses the same service.
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [deployment, environments, testing]
    source: https://12factor.net/dev-prod-parity
