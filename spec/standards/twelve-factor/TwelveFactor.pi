use ../lib/CodingStandard

from ./TwelveFactorAdminProcesses import TwelveFactorAdminProcesses
from ./TwelveFactorBackingServices import TwelveFactorBackingServices
from ./TwelveFactorBuildReleaseRun import TwelveFactorBuildReleaseRun
from ./TwelveFactorCodebase import TwelveFactorCodebase
from ./TwelveFactorConcurrency import TwelveFactorConcurrency
from ./TwelveFactorConfig import TwelveFactorConfig
from ./TwelveFactorDependencies import TwelveFactorDependencies
from ./TwelveFactorDevProdParity import TwelveFactorDevProdParity
from ./TwelveFactorDisposability import TwelveFactorDisposability
from ./TwelveFactorLogs import TwelveFactorLogs
from ./TwelveFactorPortBinding import TwelveFactorPortBinding
from ./TwelveFactorProcesses import TwelveFactorProcesses

export coding-standard TwelveFactor:
    title: The Twelve-Factor App
    publisher: Adam Wiggins and contributors
    url: https://12factor.net/
    version: null
    license: MIT
    description:
        A methodology for building software-as-a-service apps that are
        portable, configured through the environment and easy to deploy and
        scale, expressed as twelve factors.
    rules:
        - @{TwelveFactorCodebase}
        - @{TwelveFactorDependencies}
        - @{TwelveFactorConfig}
        - @{TwelveFactorBackingServices}
        - @{TwelveFactorBuildReleaseRun}
        - @{TwelveFactorProcesses}
        - @{TwelveFactorPortBinding}
        - @{TwelveFactorConcurrency}
        - @{TwelveFactorDisposability}
        - @{TwelveFactorDevProdParity}
        - @{TwelveFactorLogs}
        - @{TwelveFactorAdminProcesses}
