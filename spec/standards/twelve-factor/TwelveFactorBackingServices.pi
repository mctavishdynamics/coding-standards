use ../lib/CodingRule

from ./TwelveFactor import TwelveFactor

export coding-rule TwelveFactorBackingServices:
    standard: @{TwelveFactor}
    ruleId: IV
    title: Treat backing services as attached resources
    statement:
        Access every service the app uses over the network, such as
        databases, queues, caches and mail servers, through a URL or
        credentials held in config, with no distinction in code between
        local and third-party services.
    rationale:
        Resources can then be attached, detached or swapped, for example
        replacing a failing database with a restored copy, without any code
        change.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [architecture, services, configuration]
    source: https://12factor.net/backing-services
