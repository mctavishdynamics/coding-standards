use ../lib/CodingRule

from ./TwelveFactor import TwelveFactor

export coding-rule TwelveFactorAdminProcesses:
    standard: @{TwelveFactor}
    ruleId: XII
    title: Run admin and management tasks as one-off processes
    statement:
        Run migrations, consoles and one-time scripts as one-off processes
        against a release, with the same codebase, config and dependency
        isolation as the regular processes. Ship admin code with the
        application code.
    rationale:
        Running admin tasks in an identical environment avoids
        synchronisation problems between the admin code and the app it
        operates on.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [operations, processes]
    source: https://12factor.net/admin-processes
