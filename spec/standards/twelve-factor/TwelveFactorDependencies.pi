use ../lib/CodingRule

from ./TwelveFactor import TwelveFactor

export coding-rule TwelveFactorDependencies:
    standard: @{TwelveFactor}
    ruleId: II
    title: Explicitly declare and isolate dependencies
    statement:
        Declare every dependency completely and exactly in a manifest, and
        use an isolation tool at run time so nothing leaks in from the
        surrounding system. Do not rely on system-wide packages or tools
        such as curl being present; vendor any tool the app shells out to.
    rationale:
        Explicit declaration gives new developers a deterministic build from
        just the language runtime and the dependency manager, and it applies
        the same dependencies to development and production.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [dependencies, build]
    source: https://12factor.net/dependencies
