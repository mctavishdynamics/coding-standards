use ../lib/CodingRule

from ./TwelveFactor import TwelveFactor

export coding-rule TwelveFactorBuildReleaseRun:
    standard: @{TwelveFactor}
    ruleId: V
    title: Strictly separate build, release and run stages
    statement:
        Turn code into a build, combine the build with config into an
        immutable release that has a unique id, and run processes against a
        selected release. Never change code at run time; every change
        creates a new release.
    rationale:
        Separate stages make releases reproducible and easy to roll back,
        and keeping the run stage simple reduces failures when processes
        restart unattended.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [deployment, release-management]
    source: https://12factor.net/build-release-run
