use ../lib/CodingRule

from ./AnssiRust import AnssiRust

export coding-rule AnssiRustLangDrop:
    standard: @{AnssiRust}
    ruleId: LANG-DROP
    title: Justify and document every Drop implementation
    statement:
        Implement Drop only with a stated reason, and document what the
        destructor does.
    rationale:
        Destructors run implicitly and are easy to overlook in review, so
        their purpose must be visible.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [rust]
    tags: [rule, destructors, documentation]
    source: https://anssi-fr.github.io/rust-guide/standard.html#LANG-DROP
