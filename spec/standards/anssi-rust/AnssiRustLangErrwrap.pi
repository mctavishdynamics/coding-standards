use ../lib/CodingRule

from ./AnssiRust import AnssiRust

export coding-rule AnssiRustLangErrwrap:
    standard: @{AnssiRust}
    ruleId: LANG-ERRWRAP
    title: Define a crate error type that wraps all errors
    statement:
        A crate may define its own error type covering every error it can
        produce. Make it exception-safe as described in RFC 1236, and have
        it implement Display and Error while being Send, Sync and 'static.
    rationale:
        One error type gives callers a single thing to match on, and the
        trait bounds let errors cross threads and be boxed or reported
        uniformly.
    exceptions: null
    severity: null
    noncompliant:
        ```rust
        \\\
        pub fn load(path: &str) -> Result<Config, String> {
            let text = std::fs::read_to_string(path).map_err(|e| e.to_string())?;
            parse(&text).map_err(|e| format!("{e:?}"))
        }
        \\\
        ```
    compliant:
        ```rust
        \\\
        #[derive(Debug)]
        pub enum ConfigError {
            Io(std::io::Error),
            Parse(ParseError),
        }

        impl std::fmt::Display for ConfigError {
            fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
                match self {
                    ConfigError::Io(e) => write!(f, "cannot read config: {e}"),
                    ConfigError::Parse(e) => write!(f, "invalid config: {e}"),
                }
            }
        }

        impl std::error::Error for ConfigError {}
        \\\
        ```
    languages: [rust]
    tags: [recommendation, error-handling]
    source: https://anssi-fr.github.io/rust-guide/errors.html#LANG-ERRWRAP
