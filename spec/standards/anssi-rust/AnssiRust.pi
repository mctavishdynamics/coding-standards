from ./AnssiRustMemUninit import AnssiRustMemUninit
from ./AnssiRustUnsafeNoub import AnssiRustUnsafeNoub

export coding-standard AnssiRust:
    title: ANSSI Secure Rust Guidelines
    publisher: ANSSI, French National Cybersecurity Agency
    url: https://anssi-fr.github.io/rust-guide/
    version: Online edition, repository state of 2026-05-18
    license: Licence Ouverte / Open Licence 2.0 (Etalab)
    description:
        ANSSI guidance for developing secure applications in Rust. It
        covers the toolchain and dependencies, error handling, unsafe code,
        memory management, FFI and the standard library traits.
    rules:
        - @{AnssiRustDenvStable}
        - @{AnssiRustDenvTiers}
        - @{AnssiRustDenvCargoLock}
        - @{AnssiRustDenvCargoOpts}
        - @{AnssiRustDenvCargoEnvvars}
        - @{AnssiRustDenvFormat}
        - @{AnssiRustDenvLinter}
        - @{AnssiRustDenvAutofix}
        - @{AnssiRustLibsVettingDirect}
        - @{AnssiRustLibsVettingTransitive}
        - @{AnssiRustLibsOutdated}
        - @{AnssiRustLibsAudit}
        - @{AnssiRustLibsUnsafe}
        - @{AnssiRustLangNaming}
        - @{AnssiRustLangArith}
        - @{AnssiRustLangErrwrap}
        - @{AnssiRustLangLimitPanic}
        - @{AnssiRustLangLimitPanicSrc}
        - @{AnssiRustLangArrindexing}
        - @{AnssiRustUnsafeNoub}
        - @{AnssiRustLangUnsafe}
        - @{AnssiRustLangUnsafeEncp}
        - @{AnssiRustMemNoLeak}
        - @{AnssiRustMemForget}
        - @{AnssiRustMemForgetLint}
        - @{AnssiRustMemLeak}
        - @{AnssiRustMemManuallydrop}
        - @{AnssiRustMemNorawpointer}
        - @{AnssiRustMemIntofromrawalways}
        - @{AnssiRustMemIntofromrawonly}
        - @{AnssiRustMemUninit}
        - @{AnssiRustFfiSafewrapping}
        - @{AnssiRustFfiCtype}
        - @{AnssiRustFfiTcons}
        - @{AnssiRustFfiAutomate}
        - @{AnssiRustFfiPftype}
        - @{AnssiRustFfiCknonrobust}
        - @{AnssiRustFfiCkinrust}
        - @{AnssiRustFfiCkPtrValid}
        - @{AnssiRustFfiInputPtr}
        - @{AnssiRustFfiCkInputRefValid}
        - @{AnssiRustFfiMarkedfunptr}
        - @{AnssiRustFfiCkfunptr}
        - @{AnssiRustFfiNoenum}
        - @{AnssiRustFfiROpaque}
        - @{AnssiRustFfiCOpaque}
        - @{AnssiRustFfiCkRefModel}
        - @{AnssiRustFfiMemNodrop}
        - @{AnssiRustFfiMemOwner}
        - @{AnssiRustFfiMemWrapping}
        - @{AnssiRustFfiNopanic}
        - @{AnssiRustFfiCapi}
        - @{AnssiRustLangSyncTraits}
        - @{AnssiRustLangCmpInv}
        - @{AnssiRustLangCmpDefaults}
        - @{AnssiRustLangCmpDerive}
        - @{AnssiRustLangDrop}
        - @{AnssiRustLangDropNoPanic}
        - @{AnssiRustLangDropNoCycle}
        - @{AnssiRustLangDropSec}
        - @{AnssiRustMemMutRecRc}
