use ../lib/CodingRule

from ./AnssiRust import AnssiRust

export coding-rule AnssiRustLibsVettingTransitive:
    standard: @{AnssiRust}
    ruleId: LIBS-VETTING-TRANSITIVE
    title: Vet transitive dependencies and record the review
    statement:
        Also review the crates pulled in indirectly by direct dependencies,
        and keep a record of those reviews.
    rationale:
        Transitive crates end up in the binary just like direct ones, and
        they are a common route for supply-chain attacks.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [rust]
    tags: [recommendation, dependencies, supply-chain]
    source: https://anssi-fr.github.io/rust-guide/libraries.html#LIBS-VETTING-TRANSITIVE
