use ../lib/CodingRule

from ./AnssiRust import AnssiRust

export coding-rule AnssiRustFfiCkinrust:
    standard: @{AnssiRust}
    ruleId: FFI-CKINRUST
    title: Validate foreign values on the Rust side
    statement:
        When possible, perform validity checks of values coming from foreign
        code in Rust rather than relying on the foreign side.
    rationale:
        Checks written in Rust benefit from its type system and stay next to
        the code that depends on them.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [rust]
    tags: [recommendation, ffi, input-validation]
    source: https://anssi-fr.github.io/rust-guide/unsafe/ffi.html#FFI-CKINRUST
