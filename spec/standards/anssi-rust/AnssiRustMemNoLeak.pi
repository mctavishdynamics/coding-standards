use ../lib/CodingRule

from ./AnssiRust import AnssiRust

export coding-rule AnssiRustMemNoLeak:
    standard: @{AnssiRust}
    ruleId: MEM-NO-LEAK
    title: Do not leak memory
    statement:
        Secure Rust code must not leak memory: every allocation has to be
        released when it is no longer used.
    rationale:
        Leaks are safe in Rust's sense but exhaust memory over time, which
        can be used for denial of service and keeps sensitive data alive.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [rust]
    tags: [rule, memory, resource-management]
    source: https://anssi-fr.github.io/rust-guide/unsafe/memory.html#MEM-NO-LEAK
