use ../lib/CodingRule

from ./AnssiRust import AnssiRust

export coding-rule AnssiRustDenvAutofix:
    standard: @{AnssiRust}
    ruleId: DENV-AUTOFIX
    title: Review every automatic fix by hand
    statement:
        A developer must check each change applied by tools such as rustfix
        or cargo clippy --fix before it is accepted.
    rationale:
        Automatic fixes can change behaviour in subtle ways that the tool
        cannot judge, so they need the same review as hand-written changes.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [rust]
    tags: [rule, tooling, code-review]
    source: https://anssi-fr.github.io/rust-guide/devenv.html#DENV-AUTOFIX
