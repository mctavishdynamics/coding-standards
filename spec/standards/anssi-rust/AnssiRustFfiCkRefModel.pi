use ../lib/CodingRule

from ./AnssiRust import AnssiRust

export coding-rule AnssiRustFfiCkRefModel:
    standard: @{AnssiRust}
    ruleId: FFI-CK-REF-MODEL
    title: Preserve Rust's memory model across the boundary
    statement:
        Pointers and references that cross the FFI boundary must respect
        Rust's memory model, including its aliasing, lifetime and mutability
        rules.
    rationale:
        Rust optimises on the assumption that, for example, a mutable
        reference is unique; foreign code that breaks this causes undefined
        behaviour.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [rust]
    tags: [rule, ffi, memory, aliasing]
    source: https://anssi-fr.github.io/rust-guide/unsafe/ffi.html#FFI-CK-REF-MODEL
