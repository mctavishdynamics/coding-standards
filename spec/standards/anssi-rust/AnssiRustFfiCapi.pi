use ../lib/CodingRule

from ./AnssiRust import AnssiRust

export coding-rule AnssiRustFfiCapi:
    standard: @{AnssiRust}
    ruleId: FFI-CAPI
    title: Expose Rust libraries through a dedicated C API only
    statement:
        Expose a Rust library to other languages only through a C-compatible
        API written for that purpose.
    rationale:
        A dedicated layer keeps Rust-only types and invariants off the
        boundary and gives one place to check inputs.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [rust]
    tags: [rule, ffi, api-design]
    source: https://anssi-fr.github.io/rust-guide/unsafe/ffi.html#FFI-CAPI
