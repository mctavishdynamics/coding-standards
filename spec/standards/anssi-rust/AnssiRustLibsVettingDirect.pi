use ../lib/CodingRule

from ./AnssiRust import AnssiRust

export coding-rule AnssiRustLibsVettingDirect:
    standard: @{AnssiRust}
    ruleId: LIBS-VETTING-DIRECT
    title: Vet each direct dependency and record the review
    statement:
        Review every third-party crate the project depends on directly, and
        keep a record of each review.
    rationale:
        A dependency runs with the same rights as the project, so an
        unreviewed crate can bring in bugs, vulnerabilities or malicious
        code.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [rust]
    tags: [rule, dependencies, supply-chain]
    source: https://anssi-fr.github.io/rust-guide/libraries.html#LIBS-VETTING-DIRECT
