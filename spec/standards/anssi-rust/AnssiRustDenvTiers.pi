use ../lib/CodingRule

from ./AnssiRust import AnssiRust

export coding-rule AnssiRustDenvTiers:
    standard: @{AnssiRust}
    ruleId: DENV-TIERS
    title: Target only tier 1 platforms for safety-critical software
    statement:
        For safety-critical systems, build only for rustc tier 1 targets and
        use a certified toolchain.
    rationale:
        Only tier 1 targets are guaranteed to build and pass the full test
        suite on every release; lower tiers get weaker or no testing.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [rust]
    tags: [rule, toolchain, portability]
    source: https://anssi-fr.github.io/rust-guide/devenv.html#DENV-TIERS
