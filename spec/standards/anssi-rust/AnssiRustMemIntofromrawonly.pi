use ../lib/CodingRule

from ./AnssiRust import AnssiRust

export coding-rule AnssiRustMemIntofromrawonly:
    standard: @{AnssiRust}
    ruleId: MEM-INTOFROMRAWONLY
    title: Call from_raw only on pointers from into_raw
    statement:
        Pass to from_raw only pointers that came from the matching into_raw
        of the same type.
    rationale:
        from_raw assumes the pointer was allocated with that type's layout
        and allocator; any other pointer leads to a double free or heap
        corruption.
    exceptions: null
    severity: null
    noncompliant:
        ```rust
        \\\
        let mut value = 7u32;
        let b = unsafe { Box::from_raw(&mut value as *mut u32) };
        \\\
        ```
    compliant:
        ```rust
        \\\
        let raw = Box::into_raw(Box::new(7u32));
        let b = unsafe { Box::from_raw(raw) };
        \\\
        ```
    languages: [rust]
    tags: [rule, memory, pointers]
    source: https://anssi-fr.github.io/rust-guide/unsafe/memory.html#MEM-INTOFROMRAWONLY
