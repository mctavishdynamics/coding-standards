use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuNameArgumentsInUpperCase:
    standard: @{GnuCodingStandards}
    ruleId: comments-argument-names
    title: Refer to argument values by name in upper case in comments
    statement:
        When a function comment talks about an argument's value, use the
        argument name written in upper case.
    rationale:
        It ties the description precisely to the parameter, which is clearer
        than a vague noun.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        /* Copy a string into the buffer.  */
        void store (char *dest, const char *src);
        \\\
        ```
    compliant:
        ```c
        \\\
        /* Copy the string SRC into the buffer DEST.  */
        void store (char *dest, const char *src);
        \\\
        ```
    languages: [c]
    tags: [comments, functions]
    source: https://www.gnu.org/prep/standards/standards.html#Comments
