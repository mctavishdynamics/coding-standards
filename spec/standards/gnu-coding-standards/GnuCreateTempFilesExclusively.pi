use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuCreateTempFilesExclusively:
    standard: @{GnuCodingStandards}
    ruleId: semantics-safe-temp-files
    title: Create temporary files safely in shared directories
    statement:
        In world-writable directories, create temporary files so the call
        fails if the name already exists, using O_CREAT with O_EXCL and
        private permissions, or mkstemps. In shell scripts use mktemp or set
        -C.
    rationale:
        Otherwise an attacker can plant a file or symlink under the
        predicted name.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        fd = open (path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
        \\\
        ```
    compliant:
        ```c
        \\\
        fd = open (path, O_WRONLY | O_CREAT | O_EXCL, 0600);
        \\\
        ```
    languages: [c]
    tags: [security, files]
    source: https://www.gnu.org/prep/standards/standards.html#Semantics
