export coding-standard GnuCodingStandards:
    title: GNU Coding Standards
    publisher: Free Software Foundation
    url: https://www.gnu.org/prep/standards/
    version: last updated April 27, 2026
    license: GNU Free Documentation License 1.3 or later, no Invariant Sections; Copyright Free Software Foundation, Inc.
    description:
        The Free Software Foundation's conventions for writing GNU programs,
        covering program design, robust behavior, command-line interfaces, C
        formatting, comments and portability. Rules here come from the
        chapters on design, program behavior, writing C and doc strings.
    rules:
        - @{GnuPreferCForCompiledPrograms}
        - @{GnuStayUpwardCompatible}
        - @{GnuHonorPosixlyCorrect}
        - @{GnuUseGnuExtensionsSparingly}
        - @{GnuNeverUseTrigraphs}
        - @{GnuGuardNewerCFeatures}
        - @{GnuWritePrototypeDefinitions}
        - @{GnuPreferIfOverIfdef}
        - @{GnuTreatStandardsAsSuggestions}
        - @{GnuAvoidArbitraryLimits}
        - @{GnuPreserveNulAndMultibyte}
        - @{GnuCheckSystemCallErrors}
        - @{GnuCheckAllocationResults}
        - @{GnuReadBeforeFree}
        - @{GnuHandleOutOfMemoryByContext}
        - @{GnuParseArgumentsWithGetoptLong}
        - @{GnuInitializeWritableStaticsAtRunTime}
        - @{GnuUseHighLevelSystemInterfaces}
        - @{GnuUseSigaction}
        - @{GnuAbortOnImpossibleConditions}
        - @{GnuDoNotExitWithErrorCount}
        - @{GnuHonorTmpdir}
        - @{GnuCreateTempFilesExclusively}
        - @{GnuMakeLibraryFunctionsReentrant}
        - @{GnuPrefixLibraryExternalNames}
        - @{GnuUnderscorePrefixInternalSymbols}
        - @{GnuFormatSourceLocationMessages}
        - @{GnuPrefixMessagesWithProgramName}
        - @{GnuLowercaseMessagesWithoutPeriod}
        - @{GnuDoNotDependOnInvocationName}
        - @{GnuDoNotDependOnOutputDevice}
        - @{GnuLocateFilesFromArgvZero}
        - @{GnuNoPrivilegeWithHeuristicSearch}
        - @{GnuPairGuiWithCommandLine}
        - @{GnuFollowPosixOptionConventions}
        - @{GnuSpecifyOutputFilesWithOption}
        - @{GnuSupportVersionAndHelp}
        - @{GnuFormatVersionOutput}
        - @{GnuFormatHelpOutput}
        - @{GnuRequirePluginLicenseSymbol}
        - @{GnuStreamLargeInputs}
        - @{GnuDoNotFreeJustForTools}
        - @{GnuDoNotWriteUnderUsrOrEtc}
        - @{GnuKeepLinesUnder80}
        - @{GnuPutFunctionBraceInColumnOne}
        - @{GnuStartFunctionNameInColumnOne}
        - @{GnuPutStructBracesInColumnOne}
        - @{GnuUseOneFormattingStyleConsistently}
        - @{GnuIndentBlocksGnuStyle}
        - @{GnuSpaceBeforeParenAndAfterComma}
        - @{GnuBreakBeforeOperators}
        - @{GnuParenthesizeMixedPrecedence}
        - @{GnuFormatDoWhileGnuStyle}
        - @{GnuSeparatePagesWithFormfeeds}
        - @{GnuDescribeProgramAtTop}
        - @{GnuDescribeEachFileAtTop}
        - @{GnuWriteCommentsInEnglish}
        - @{GnuCommentEveryFunction}
        - @{GnuWriteCommentSentencesProperly}
        - @{GnuNameArgumentsInUpperCase}
        - @{GnuDoNotRestateFunctionName}
        - @{GnuCommentStaticVariables}
        - @{GnuCommentConditionalEnds}
        - @{GnuDeclareAllTypesExplicitly}
        - @{GnuDoNotContortCodeForLint}
        - @{GnuGroupExternDeclarations}
        - @{GnuUseSeparateVariablesPerPurpose}
        - @{GnuDoNotShadowGlobals}
        - @{GnuNoMultiLineDeclarations}
        - @{GnuBraceNestedIfElse}
        - @{GnuWriteElseIfOnOneLine}
        - @{GnuDeclareStructTagSeparately}
        - @{GnuAvoidAssignmentInIf}
        - @{GnuUseInformativeGlobalNames}
        - @{GnuUseLowercaseWithUnderscores}
        - @{GnuNameOptionFlagsByMeaning}
        - @{GnuUseEnumForIntegerConstants}
        - @{GnuAvoidConflictingShortFileNames}
        - @{GnuUseAutoconfForPortability}
        - @{GnuDoNotAbbreviateWindowsAsWin}
        - @{GnuDefineGnuSource}
        - @{GnuHandleByteOrderAndAlignment}
        - @{GnuDoNotTreatIntAddressAsByte}
        - @{GnuAvoidPointerToIntegerCasts}
        - @{GnuPrintOffTPortably}
        - @{GnuDoNotDeclareSystemFunctions}
        - @{GnuUseGnulibForPortability}
        - @{GnuTranslateMessagesWithGettext}
        - @{GnuTranslateWholeSentences}
        - @{GnuUseNgettextForPlurals}
        - @{GnuPreferAsciiInSource}
        - @{GnuUseAsciiQuotesInCLocale}
        - @{GnuOfferMachineReadableQuoting}
        - @{GnuFallBackWhenMmapFails}
        - @{GnuDoNotBuildManualsFromDocStrings}
