use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuPreferCForCompiledPrograms:
    standard: @{GnuCodingStandards}
    ruleId: source-language
    title: Prefer C for fast compiled programs and Guile for extension
    statement:
        For a compiled program where speed matters, write it in C; C++ is
        acceptable without heavy template use. Where speed is less
        important, other free-software languages are fine, and Guile Scheme
        is the preferred language for making C programs extensible.
    rationale:
        A common choice of languages keeps GNU components consistent and
        lets users extend and combine them.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [language-choice, extensibility]
    source: https://www.gnu.org/prep/standards/standards.html#Source-Language
