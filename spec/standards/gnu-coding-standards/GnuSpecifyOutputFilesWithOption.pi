use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuSpecifyOutputFilesWithOption:
    standard: @{GnuCodingStandards}
    ruleId: command-line-output-files
    title: Take output file names from an option, not a plain argument
    statement:
        Treat ordinary file-name arguments as inputs only, and name output
        files with an option, preferably -o or --output. Where compatibility
        requires a positional output name, also offer the option.
    rationale:
        A uniform rule across utilities spares users from remembering which
        argument is overwritten.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [command-line, options, files]
    source: https://www.gnu.org/prep/standards/standards.html#Command_002dLine-Interfaces
