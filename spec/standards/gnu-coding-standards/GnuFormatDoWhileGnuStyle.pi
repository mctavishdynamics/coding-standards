use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuFormatDoWhileGnuStyle:
    standard: @{GnuCodingStandards}
    ruleId: formatting-do-while
    title: Format do-while loops with the while on its own line
    statement:
        Write do on its own line, the braced body indented beneath it, and
        the while condition on a line after the closing brace.
    rationale:
        It keeps do-while consistent with the GNU layout of other compound
        statements.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        do {
          c = next_char (in);
        } while (c == ' ');
        \\\
        ```
    compliant:
        ```c
        \\\
        do
          {
            c = next_char (in);
          }
        while (c == ' ');
        \\\
        ```
    languages: [c]
    tags: [formatting, loops]
    source: https://www.gnu.org/prep/standards/standards.html#Formatting
