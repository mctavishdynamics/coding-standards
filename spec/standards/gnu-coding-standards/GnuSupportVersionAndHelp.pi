use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuSupportVersionAndHelp:
    standard: @{GnuCodingStandards}
    ruleId: command-line-standard-options
    title: Support the --version and --help options
    statement:
        Every program accepts --version and --help. CGI programs also accept
        them as the path info of the request.
    rationale:
        Users and tools can always find out what a program is and how to run
        it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [command-line, options]
    source: https://www.gnu.org/prep/standards/standards.html#Command_002dLine-Interfaces
