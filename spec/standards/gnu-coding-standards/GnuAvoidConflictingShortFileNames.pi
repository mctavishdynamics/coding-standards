use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuAvoidConflictingShortFileNames:
    standard: @{GnuCodingStandards}
    ruleId: names-file-names
    title: Keep file names distinct on file systems that shorten names
    statement:
        Consider checking, for example with doschk, that file names do not
        collide on file systems that truncate them. Existing programs that
        keep names to 14 characters should continue to do so, but new
        programs need not.
    rationale:
        Truncated names can collide and overwrite each other when the source
        is unpacked.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [files, portability, naming]
    source: https://www.gnu.org/prep/standards/standards.html#Names
