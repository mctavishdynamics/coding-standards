use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuOfferMachineReadableQuoting:
    standard: @{GnuCodingStandards}
    ruleId: quote-characters-parsable-output
    title: Offer a reliable quoting option for output other programs parse
    statement:
        If other programs are likely to parse your output, provide an option
        that escapes special characters, for example using C or shell
        conventions.
    rationale:
        Unescaped names with spaces, quotes or newlines break parsers.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [command-line, output]
    source: https://www.gnu.org/prep/standards/standards.html#Quote-Characters
