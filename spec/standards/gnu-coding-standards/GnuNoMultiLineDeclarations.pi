use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuNoMultiLineDeclarations:
    standard: @{GnuCodingStandards}
    ruleId: syntactic-multi-line-declarations
    title: Do not spread one multi-variable declaration over several lines
    statement:
        Either declare several variables together on a single line, or start
        a new declaration for each on its own line.
    rationale:
        A declaration continued across lines is easy to misread and awkward
        to edit.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        size_t used,
               capacity;
        \\\
        ```
    compliant:
        ```c
        \\\
        size_t used;
        size_t capacity;
        \\\
        ```
    languages: [c]
    tags: [declarations, formatting]
    source: https://www.gnu.org/prep/standards/standards.html#Syntactic-Conventions
