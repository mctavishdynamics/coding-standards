use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuTreatStandardsAsSuggestions:
    standard: @{GnuCodingStandards}
    ruleId: non-gnu-standards
    title: Follow outside standards only where they make the system better
    statement:
        Implement other organizations' standards where doing so objectively
        helps users, but do not follow them rigidly. Do not reject a
        feature, or remove one, only because a standard calls it forbidden
        or deprecated.
    rationale:
        Following standards usually aids portability, but some requirements
        make programs worse for users.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [standards, design]
    source: https://www.gnu.org/prep/standards/standards.html#Non_002dGNU-Standards
