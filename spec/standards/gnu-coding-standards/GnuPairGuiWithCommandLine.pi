use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuPairGuiWithCommandLine:
    standard: @{GnuCodingStandards}
    ruleId: graphical-interfaces
    title: Build GUIs with GTK+ or GNUstep and also offer a command-line interface
    statement:
        Write graphical interfaces for X using GTK+ or GNUstep unless the
        job needs something else, and make them accessible to screen
        readers. Also provide a command-line interface for the same
        functions, and consider D-Bus or a C library interface.
    rationale:
        A command-line interface makes the work scriptable, and a shared
        toolkit keeps programs consistent and accessible.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [interface-design, gui, accessibility]
    source: https://www.gnu.org/prep/standards/standards.html#Graphical-Interfaces
