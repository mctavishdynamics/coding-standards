use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuWriteCommentsInEnglish:
    standard: @{GnuCodingStandards}
    ruleId: comments-english
    title: Write comments in English
    statement:
        Write the comments of a GNU program in English, asking others for
        help with wording or translation if needed.
    rationale:
        Programmers around the world share English as a common reading
        language, so English comments reach the widest audience.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [comments, language]
    source: https://www.gnu.org/prep/standards/standards.html#Comments
