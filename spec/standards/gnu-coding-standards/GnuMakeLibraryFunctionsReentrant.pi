use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuMakeLibraryFunctionsReentrant:
    standard: @{GnuCodingStandards}
    ruleId: libraries-reentrant
    title: Make library functions reentrant
    statement:
        Write library functions so they can be re-entered safely. Dynamic
        allocation is acceptable, but malloc should be the only
        non-reentrant part.
    rationale:
        Callers may use the library from signal handlers, threads or nested
        calls.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        const char *
        fmt_size (size_t n)
        {
          static char buf[32];
          snprintf (buf, sizeof buf, "%zu bytes", n);
          return buf;
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        char *
        fmt_size (size_t n, char *buf, size_t len)
        {
          snprintf (buf, len, "%zu bytes", n);
          return buf;
        }
        \\\
        ```
    languages: [c]
    tags: [libraries, reentrancy, concurrency]
    source: https://www.gnu.org/prep/standards/standards.html#Libraries
