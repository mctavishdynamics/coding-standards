use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuUseInformativeGlobalNames:
    standard: @{GnuCodingStandards}
    ruleId: names-descriptive
    title: Give globals informative English names and limit abbreviations
    statement:
        Name global variables and functions so the name explains their
        meaning, in English. Local names may be shorter. Use only a few
        abbreviations, explain them, and use them consistently.
    rationale:
        Names of widely used entities serve as documentation, and obscure
        abbreviations defeat that.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        int nfc;
        void prc_ln (char *b);
        \\\
        ```
    compliant:
        ```c
        \\\
        int open_file_count;
        void process_line (char *buffer);
        \\\
        ```
    languages: [c]
    tags: [naming, readability]
    source: https://www.gnu.org/prep/standards/standards.html#Names
