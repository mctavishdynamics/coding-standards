use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuPreferAsciiInSource:
    standard: @{GnuCodingStandards}
    ruleId: character-set
    title: Prefer plain ASCII in source and documents, otherwise UTF-8
    statement:
        Keep comments, strings and text files to 7-bit ASCII unless the
        application domain needs other characters. When you need them, use
        one encoding per file, preferably UTF-8.
    rationale:
        ASCII displays correctly everywhere, and mixed encodings in one file
        cannot be read correctly.
    exceptions:
        Contributor names in change logs, and domain data such as accented
        month names, may contain non-ASCII characters.
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [encoding, files]
    source: https://www.gnu.org/prep/standards/standards.html#Character-Set
