use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuDescribeEachFileAtTop:
    standard: @{GnuCodingStandards}
    ruleId: comments-file-purpose
    title: Begin every source file with its name and purpose
    statement:
        Open each source file with a comment that names the file and briefly
        states what it is for.
    rationale:
        It orients readers who open the file without other context.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```c
        \\\
        /* hash.c -- open-addressing hash table used by the symbol reader.  */
        \\\
        ```
    languages: [c]
    tags: [comments, file-structure]
    source: https://www.gnu.org/prep/standards/standards.html#Comments
