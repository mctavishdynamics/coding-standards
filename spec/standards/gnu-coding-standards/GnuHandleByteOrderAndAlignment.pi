use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuHandleByteOrderAndAlignment:
    standard: @{GnuCodingStandards}
    ruleId: cpu-portability-byte-order
    title: Handle differences in byte order and alignment
    statement:
        Write code that works regardless of the CPU's byte order and
        alignment rules. You need not support ints narrower than 32 bits, or
        longs narrower than pointers unless you target 64-bit Windows.
    rationale:
        GNU runs on many CPUs that differ in these respects, while 16-bit
        machines are not supported.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        uint32_t len = *(uint32_t *) (packet + 1);
        \\\
        ```
    compliant:
        ```c
        \\\
        const unsigned char *p = packet + 1;
        uint32_t len = (uint32_t) p[0] << 24 | (uint32_t) p[1] << 16
                       | (uint32_t) p[2] << 8 | p[3];
        \\\
        ```
    languages: [c]
    tags: [portability, endianness]
    source: https://www.gnu.org/prep/standards/standards.html#CPU-Portability
