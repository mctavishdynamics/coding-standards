use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuSpaceBeforeParenAndAfterComma:
    standard: @{GnuCodingStandards}
    ruleId: formatting-spaces
    title: Put a space before open parentheses and after commas
    statement:
        Write a space between a function or keyword and its opening
        parenthesis, and after every comma.
    rationale:
        The spacing makes expressions easier to read, especially argument
        lists.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        total=add(a,b)+scale(c,2);
        \\\
        ```
    compliant:
        ```c
        \\\
        total = add (a, b) + scale (c, 2);
        \\\
        ```
    languages: [c]
    tags: [formatting, whitespace]
    source: https://www.gnu.org/prep/standards/standards.html#Formatting
