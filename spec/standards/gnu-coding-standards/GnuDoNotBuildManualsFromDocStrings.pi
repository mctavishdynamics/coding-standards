use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuDoNotBuildManualsFromDocStrings:
    standard: @{GnuCodingStandards}
    ruleId: doc-strings-and-manuals
    title: Do not assemble a manual from documentation strings
    statement:
        Write documentation strings to stand alone and in an informal style,
        and write the manual as separate connected text; use the doc strings
        only as source material for it.
    rationale:
        A manual needs context and continuity, so standalone doc strings
        strung together read badly as a manual.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [documentation]
    source: https://www.gnu.org/prep/standards/standards.html#Doc-Strings-and-Manuals
