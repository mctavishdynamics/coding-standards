use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuUseLowercaseWithUnderscores:
    standard: @{GnuCodingStandards}
    ruleId: names-underscores
    title: Separate words with underscores and use lower case
    statement:
        Join words in names with underscores and write them in lower case;
        upper case is only for macros, enum constants and systematic name
        prefixes.
    rationale:
        Emacs word commands then work inside names, and case tells macros
        apart from ordinary identifiers.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        int maxLineWidth;
        \\\
        ```
    compliant:
        ```c
        \\\
        int max_line_width;
        \\\
        ```
    languages: [c]
    tags: [naming]
    source: https://www.gnu.org/prep/standards/standards.html#Names
