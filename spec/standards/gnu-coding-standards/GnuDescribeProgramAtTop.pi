use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuDescribeProgramAtTop:
    standard: @{GnuCodingStandards}
    ruleId: comments-program-purpose
    title: Start the main source file with a comment saying what the program is for
    statement:
        Begin the source file that contains main with a short comment
        stating the program's purpose.
    rationale:
        A reader opening the source learns immediately what the program
        does.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        #include <stdio.h>

        int
        main (int argc, char **argv)
        \\\
        ```
    compliant:
        ```c
        \\\
        /* tally - count lines, words and bytes in files.  */
        #include <stdio.h>

        int
        main (int argc, char **argv)
        \\\
        ```
    languages: [c]
    tags: [comments, file-structure]
    source: https://www.gnu.org/prep/standards/standards.html#Comments
