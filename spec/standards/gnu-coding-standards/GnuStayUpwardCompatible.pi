use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuStayUpwardCompatible:
    standard: @{GnuCodingStandards}
    ruleId: compatibility-upward
    title: Stay upward compatible with Unix, Standard C and POSIX
    statement:
        Make utilities and libraries upward compatible with Berkeley Unix
        and with Standard C and POSIX where those define the behavior.
        Extensions the standards forbid are allowed, but provide an option
        such as --posix or --ansi to turn them off, and redesign any
        extension that could break existing programs or scripts.
    rationale:
        Users' existing programs and scripts must keep working when they
        move to GNU tools.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [compatibility, standards]
    source: https://www.gnu.org/prep/standards/standards.html#Compatibility
