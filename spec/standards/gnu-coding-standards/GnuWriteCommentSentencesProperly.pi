use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuWriteCommentSentencesProperly:
    standard: @{GnuCodingStandards}
    ruleId: comments-sentences
    title: Write full sentences with two spaces after each period
    statement:
        Write comments as complete sentences that start with a capital
        letter and put two spaces after each sentence. Do not capitalize an
        identifier that begins a sentence; rephrase instead.
    rationale:
        Emacs sentence commands depend on the double space, and changing an
        identifier's case makes it a different name.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        /* buffer is resized here. it never shrinks. */
        \\\
        ```
    compliant:
        ```c
        \\\
        /* The buffer grows here.  It never shrinks.  */
        \\\
        ```
    languages: [c]
    tags: [comments, style]
    source: https://www.gnu.org/prep/standards/standards.html#Comments
