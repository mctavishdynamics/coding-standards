use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuKeepLinesUnder80:
    standard: @{GnuCodingStandards}
    ruleId: formatting-line-length
    title: Keep lines no longer than 79 characters
    statement:
        Limit each line of source code to at most 79 characters.
    rationale:
        Short lines read well in the widest range of editors, terminals and
        printouts.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        result = combine_fragments (first_fragment, second_fragment, options, &error_count);
        \\\
        ```
    compliant:
        ```c
        \\\
        result = combine_fragments (first_fragment, second_fragment, options,
                                    &error_count);
        \\\
        ```
    languages: [c]
    tags: [formatting, line-length]
    source: https://www.gnu.org/prep/standards/standards.html#Formatting
