use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuNameOptionFlagsByMeaning:
    standard: @{GnuCodingStandards}
    ruleId: names-option-variables
    title: Name option variables after their meaning, not their letter
    statement:
        A variable recording whether an option was given is named for what
        the option does, with a comment stating its meaning and its letter.
    rationale:
        Letters are arbitrary and change, while a meaningful name explains
        the code that tests it.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        int bflag;
        \\\
        ```
    compliant:
        ```c
        \\\
        /* Ignore blank lines when comparing (-B).  */
        int ignore_blank_lines;
        \\\
        ```
    languages: [c]
    tags: [naming, command-line]
    source: https://www.gnu.org/prep/standards/standards.html#Names
