use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuCommentStaticVariables:
    standard: @{GnuCodingStandards}
    ruleId: comments-static-variables
    title: Comment every static variable
    statement:
        Document every static variable with a comment on what it holds and
        what its values mean.
    rationale:
        File-scope state is shared by many functions, so its meaning must be
        documented in one place.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        static int wrap;
        \\\
        ```
    compliant:
        ```c
        \\\
        /* Column at which to wrap output; zero disables wrapping.  */
        static int wrap;
        \\\
        ```
    languages: [c]
    tags: [comments, globals]
    source: https://www.gnu.org/prep/standards/standards.html#Comments
