use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuUseOneFormattingStyleConsistently:
    standard: @{GnuCodingStandards}
    ruleId: formatting-consistency
    title: Use one formatting style consistently and follow existing style
    statement:
        Whatever formatting style you choose, apply it throughout a program.
        When changing an existing program, use its style. The GNU style is
        also the default of GNU indent.
    rationale:
        Mixed styles in one program look messy, while different programs
        using different styles causes no harm.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [formatting, consistency]
    source: https://www.gnu.org/prep/standards/standards.html#Formatting
