use ../lib/CodingRule

from ./GnuCodingStandards import GnuCodingStandards

export coding-rule GnuSeparatePagesWithFormfeeds:
    standard: @{GnuCodingStandards}
    ruleId: formatting-formfeeds
    title: Divide source files into pages with formfeeds
    statement:
        Put formfeed characters, alone on their lines, between logical parts
        of a file, but never inside a function.
    rationale:
        Editors can then move by page between the program's sections.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [formatting, file-structure]
    source: https://www.gnu.org/prep/standards/standards.html#Formatting
