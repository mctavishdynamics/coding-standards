use ../lib/CodingRule

from ./OpenBsdStyle import OpenBsdStyle

export coding-rule OpenBsdNoTrailingOrMixedWhitespace:
    standard: @{OpenBsdStyle}
    ruleId: whitespace
    title: Do not leave trailing whitespace or put spaces before tabs
    statement:
        Do not add whitespace at line ends. Form indentation only from tabs
        followed by spaces, never with more spaces than a tab would produce
        and never with spaces before tabs.
    rationale:
        Stray or mixed whitespace creates noisy diffs and renders
        inconsistently.
    exceptions:
        Examples are omitted because this specification renders tabs as
        spaces, so they cannot show the difference.
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [formatting, whitespace, indentation]
    source: https://man.openbsd.org/style.9#DESCRIPTION
