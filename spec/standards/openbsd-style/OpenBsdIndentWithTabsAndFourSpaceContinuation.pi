use ../lib/CodingRule

from ./OpenBsdStyle import OpenBsdStyle

export coding-rule OpenBsdIndentWithTabsAndFourSpaceContinuation:
    standard: @{OpenBsdStyle}
    ruleId: indentation
    title: Indent with 8-column tabs and four-space second-level indents
    statement:
        Indent each level with an eight-character tab and indent
        continuation lines by four spaces.
    rationale:
        Wide indents make structure clear, and the smaller continuation
        indent separates wrapped lines from new blocks.
    exceptions:
        Examples are omitted because this specification renders tabs as
        spaces, so they cannot show the difference.
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [formatting, indentation]
    source: https://man.openbsd.org/style.9#DESCRIPTION
