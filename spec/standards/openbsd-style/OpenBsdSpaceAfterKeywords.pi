use ../lib/CodingRule

from ./OpenBsdStyle import OpenBsdStyle

export coding-rule OpenBsdSpaceAfterKeywords:
    standard: @{OpenBsdStyle}
    ruleId: keyword-spacing
    title: Put a space after control keywords
    statement:
        Write a space after if, while, for, return and switch.
    rationale:
        It distinguishes keywords from function calls.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        while(n--)
                step();
        \\\
        ```
    compliant:
        ```c
        \\\
        while (n--)
                step();
        \\\
        ```
    languages: [c]
    tags: [formatting, whitespace]
    source: https://man.openbsd.org/style.9#DESCRIPTION
