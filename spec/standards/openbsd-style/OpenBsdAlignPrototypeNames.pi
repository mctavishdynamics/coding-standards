use ../lib/CodingRule

from ./OpenBsdStyle import OpenBsdStyle

export coding-rule OpenBsdAlignPrototypeNames:
    standard: @{OpenBsdStyle}
    ruleId: prototype-alignment
    title: Line up prototype names with a tab and an optional extra space
    statement:
        Separate the type from the function name with a tab, and add one
        space after the tab where needed so that the names line up.
    rationale:
        Aligned names make lists of prototypes easy to scan.
    exceptions:
        Examples are omitted because this specification renders tabs as
        spaces, so they cannot show the difference.
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [formatting, functions, alignment]
    source: https://man.openbsd.org/style.9#DESCRIPTION
