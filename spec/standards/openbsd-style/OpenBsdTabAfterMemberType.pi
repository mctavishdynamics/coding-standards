use ../lib/CodingRule

from ./OpenBsdStyle import OpenBsdStyle

export coding-rule OpenBsdTabAfterMemberType:
    standard: @{OpenBsdStyle}
    ruleId: struct-member-tab
    title: Separate the leading type word of a struct member from the rest with a tab
    statement:
        Within a structure, follow the first word of each member's type with
        a tab rather than a space.
    rationale:
        It aligns member names into a column.
    exceptions:
        Examples are omitted because this specification renders tabs as
        spaces, so they cannot show the difference.
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [formatting, structs, alignment]
    source: https://man.openbsd.org/style.9#DESCRIPTION
