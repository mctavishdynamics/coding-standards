use ../lib/CodingRule

from ./OpenBsdStyle import OpenBsdStyle

export coding-rule OpenBsdFollowStyleInNewCoreCode:
    standard: @{OpenBsdStyle}
    ruleId: compliance
    title: Keep new core kernel code compliant and drivers self-consistent
    statement:
        New core kernel code should comply reasonably with the style guide.
        Third-party modules and device drivers may be more relaxed but must
        at least be consistent with their own style.
    rationale:
        The core stays uniform while external code keeps its own
        conventions.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [consistency, maintainability]
    source: https://man.openbsd.org/style.9#DESCRIPTION
