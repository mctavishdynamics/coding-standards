use ../lib/CodingRule

from ./OpenBsdStyle import OpenBsdStyle

export coding-rule OpenBsdApplyStyleToNewCode:
    standard: @{OpenBsdStyle}
    ruleId: new-code
    title: Follow the style guide in all new code
    statement:
        Write all new code in this style. Code counts as new when it makes
        up roughly half or more of the files involved, which is enough to
        set aside the existing file's precedents.
    rationale:
        A clear threshold says when to adopt the current style instead of
        matching older surrounding code.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [consistency, maintainability]
    source: https://man.openbsd.org/style.9#DESCRIPTION
