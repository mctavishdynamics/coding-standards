use ../lib/CodingRule

from ./OpenBsdStyle import OpenBsdStyle

export coding-rule OpenBsdUppercaseEnumValues:
    standard: @{OpenBsdStyle}
    ruleId: enum-values
    title: Write enumeration values in upper case
    statement:
        Spell enumeration constants entirely in upper case.
    rationale:
        Constants should look like constants.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        enum color { red, green };
        \\\
        ```
    compliant:
        ```c
        \\\
        enum color { RED, GREEN };
        \\\
        ```
    languages: [c]
    tags: [naming, enums]
    source: https://man.openbsd.org/style.9#DESCRIPTION
