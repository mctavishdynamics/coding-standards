use ../lib/CodingRule

from ./OpenBsdStyle import OpenBsdStyle

export coding-rule OpenBsdSpellOutUnsignedInt:
    standard: @{OpenBsdStyle}
    ruleId: unsigned-int
    title: Write unsigned int rather than bare unsigned
    statement:
        Declare unsigned integers as unsigned int, not just unsigned.
    rationale:
        The bare form has caused confusion in the past.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        unsigned nslots;
        \\\
        ```
    compliant:
        ```c
        \\\
        unsigned int nslots;
        \\\
        ```
    languages: [c]
    tags: [types, readability]
    source: https://man.openbsd.org/style.9#DESCRIPTION
