use ../lib/CodingStandard

from ./OpenBsdAlignCaseWithSwitch import OpenBsdAlignCaseWithSwitch
from ./OpenBsdAlignPrototypeNames import OpenBsdAlignPrototypeNames
from ./OpenBsdApplyStyleToNewCode import OpenBsdApplyStyleToNewCode
from ./OpenBsdAvoidCallsInInitializers import OpenBsdAvoidCallsInInitializers
from ./OpenBsdAvoidNeedlessParentheses import OpenBsdAvoidNeedlessParentheses
from ./OpenBsdAvoidObviousComments import OpenBsdAvoidObviousComments
from ./OpenBsdAvoidRegisterKeyword import OpenBsdAvoidRegisterKeyword
from ./OpenBsdAvoidStructTypedefs import OpenBsdAvoidStructTypedefs
from ./OpenBsdCapitalizeAndParenthesizeMacros import
    OpenBsdCapitalizeAndParenthesizeMacros
from ./OpenBsdCommentMajorRoutines import OpenBsdCommentMajorRoutines
from ./OpenBsdCuddleElse import OpenBsdCuddleElse
from ./OpenBsdDeclareMajorStructsAtTop import OpenBsdDeclareMajorStructsAtTop
from ./OpenBsdDoNotCastVoidPointerReturns import
    OpenBsdDoNotCastVoidPointerReturns
from ./OpenBsdExitZeroOnSuccess import OpenBsdExitZeroOnSuccess
from ./OpenBsdFitCodeIn80Columns import OpenBsdFitCodeIn80Columns
from ./OpenBsdFollowStyleInNewCoreCode import OpenBsdFollowStyleInNewCoreCode
from ./OpenBsdFormatUsageLikeSynopsis import OpenBsdFormatUsageLikeSynopsis
from ./OpenBsdIncludeKernelHeadersFirst import OpenBsdIncludeKernelHeadersFirst
from ./OpenBsdIndentWithTabsAndFourSpaceContinuation import
    OpenBsdIndentWithTabsAndFourSpaceContinuation
from ./OpenBsdLeaveForPartsEmpty import OpenBsdLeaveForPartsEmpty
from ./OpenBsdMarkClobberedVariablesVolatile import
    OpenBsdMarkClobberedVariablesVolatile
from ./OpenBsdMarkNonReturningFunctionsDead import
    OpenBsdMarkNonReturningFunctionsDead
from ./OpenBsdNoBracesForSingleStatements import
    OpenBsdNoBracesForSingleStatements
from ./OpenBsdNoFunctionDeclarationsInFunctions import
    OpenBsdNoFunctionDeclarationsInFunctions
from ./OpenBsdNoSpaceAfterCastsOrSizeof import OpenBsdNoSpaceAfterCastsOrSizeof
from ./OpenBsdNoSpaceAfterFunctionNames import OpenBsdNoSpaceAfterFunctionNames
from ./OpenBsdNoTrailingOrMixedWhitespace import
    OpenBsdNoTrailingOrMixedWhitespace
from ./OpenBsdOmitPrototypeParameterNames import
    OpenBsdOmitPrototypeParameterNames
from ./OpenBsdOrderStructMembers import OpenBsdOrderStructMembers
from ./OpenBsdParseOptionsWithGetopt import OpenBsdParseOptionsWithGetopt
from ./OpenBsdPlaceNetworkIncludesNext import OpenBsdPlaceNetworkIncludesNext
from ./OpenBsdPlaceQualifiersDeliberately import
    OpenBsdPlaceQualifiersDeliberately
from ./OpenBsdPrefixMacroLocalsWithUnderscores import
    OpenBsdPrefixMacroLocalsWithUnderscores
from ./OpenBsdPrototypeNonStaticFunctions import
    OpenBsdPrototypeNonStaticFunctions
from ./OpenBsdPrototypeSharedFunctionsInHeaders import
    OpenBsdPrototypeSharedFunctionsInHeaders
from ./OpenBsdPutFunctionTypeOnOwnLine import OpenBsdPutFunctionTypeOnOwnLine
from ./OpenBsdPutUserIncludesLast import OpenBsdPutUserIncludesLast
from ./OpenBsdRunCodeCheckers import OpenBsdRunCodeCheckers
from ./OpenBsdSortLocalDeclarations import OpenBsdSortLocalDeclarations
from ./OpenBsdSortUsrIncludeHeaders import OpenBsdSortUsrIncludeHeaders
from ./OpenBsdSpaceAfterKeywords import OpenBsdSpaceAfterKeywords
from ./OpenBsdSpaceBinaryOperatorsOnly import OpenBsdSpaceBinaryOperatorsOnly
from ./OpenBsdSpellOutUnsignedInt import OpenBsdSpellOutUnsignedInt
from ./OpenBsdTabAfterMemberType import OpenBsdTabAfterMemberType
from ./OpenBsdUppercaseEnumValues import OpenBsdUppercaseEnumValues
from ./OpenBsdUseAnsiDefinitions import OpenBsdUseAnsiDefinitions
from ./OpenBsdUseErrAndWarn import OpenBsdUseErrAndWarn
from ./OpenBsdUseGetprogname import OpenBsdUseGetprogname
from ./OpenBsdUseNotOnlyForBooleans import OpenBsdUseNotOnlyForBooleans
from ./OpenBsdUseNullConstant import OpenBsdUseNullConstant
from ./OpenBsdUseQueueMacros import OpenBsdUseQueueMacros
from ./OpenBsdUseSigAtomicForSignalFlags import
    OpenBsdUseSigAtomicForSignalFlags
from ./OpenBsdWrapCompoundMacrosInDoWhile import
    OpenBsdWrapCompoundMacrosInDoWhile
from ./OpenBsdWrapHeaderPrototypesForCpp import
    OpenBsdWrapHeaderPrototypesForCpp
from ./OpenBsdWriteKnfComments import OpenBsdWriteKnfComments
from ./OpenBsdWriteVariadicFunctionsWithStdarg import
    OpenBsdWriteVariadicFunctionsWithStdarg

export coding-standard OpenBsdStyle:
    title: OpenBSD Kernel Source File Style Guide, style(9)
    publisher: The OpenBSD Project
    url: https://man.openbsd.org/style.9
    version: style.9 revision 1.79, September 11, 2022
    license: BSD 2-Clause License; Copyright (c) 1995 FreeBSD Inc., all rights reserved
    description:
        The OpenBSD kernel and userspace source style, Kernel Normal Form,
        from the style(9) manual page. It covers includes, prototypes,
        macros, declarations, formatting and error reporting.
    rules:
        - @{OpenBsdApplyStyleToNewCode}
        - @{OpenBsdWriteKnfComments}
        - @{OpenBsdIncludeKernelHeadersFirst}
        - @{OpenBsdPlaceNetworkIncludesNext}
        - @{OpenBsdSortUsrIncludeHeaders}
        - @{OpenBsdPutUserIncludesLast}
        - @{OpenBsdPrototypeNonStaticFunctions}
        - @{OpenBsdPrototypeSharedFunctionsInHeaders}
        - @{OpenBsdOmitPrototypeParameterNames}
        - @{OpenBsdAlignPrototypeNames}
        - @{OpenBsdMarkNonReturningFunctionsDead}
        - @{OpenBsdWrapHeaderPrototypesForCpp}
        - @{OpenBsdCapitalizeAndParenthesizeMacros}
        - @{OpenBsdWrapCompoundMacrosInDoWhile}
        - @{OpenBsdPrefixMacroLocalsWithUnderscores}
        - @{OpenBsdUppercaseEnumValues}
        - @{OpenBsdSpellOutUnsignedInt}
        - @{OpenBsdOrderStructMembers}
        - @{OpenBsdTabAfterMemberType}
        - @{OpenBsdDeclareMajorStructsAtTop}
        - @{OpenBsdUseQueueMacros}
        - @{OpenBsdAvoidStructTypedefs}
        - @{OpenBsdParseOptionsWithGetopt}
        - @{OpenBsdAlignCaseWithSwitch}
        - @{OpenBsdSpaceAfterKeywords}
        - @{OpenBsdNoBracesForSingleStatements}
        - @{OpenBsdLeaveForPartsEmpty}
        - @{OpenBsdIndentWithTabsAndFourSpaceContinuation}
        - @{OpenBsdFitCodeIn80Columns}
        - @{OpenBsdNoTrailingOrMixedWhitespace}
        - @{OpenBsdCuddleElse}
        - @{OpenBsdNoSpaceAfterFunctionNames}
        - @{OpenBsdSpaceBinaryOperatorsOnly}
        - @{OpenBsdAvoidNeedlessParentheses}
        - @{OpenBsdExitZeroOnSuccess}
        - @{OpenBsdAvoidObviousComments}
        - @{OpenBsdCommentMajorRoutines}
        - @{OpenBsdPutFunctionTypeOnOwnLine}
        - @{OpenBsdSortLocalDeclarations}
        - @{OpenBsdAvoidCallsInInitializers}
        - @{OpenBsdNoFunctionDeclarationsInFunctions}
        - @{OpenBsdNoSpaceAfterCastsOrSizeof}
        - @{OpenBsdAvoidRegisterKeyword}
        - @{OpenBsdMarkClobberedVariablesVolatile}
        - @{OpenBsdPlaceQualifiersDeliberately}
        - @{OpenBsdUseSigAtomicForSignalFlags}
        - @{OpenBsdUseNullConstant}
        - @{OpenBsdUseNotOnlyForBooleans}
        - @{OpenBsdDoNotCastVoidPointerReturns}
        - @{OpenBsdUseErrAndWarn}
        - @{OpenBsdUseAnsiDefinitions}
        - @{OpenBsdWriteVariadicFunctionsWithStdarg}
        - @{OpenBsdFormatUsageLikeSynopsis}
        - @{OpenBsdUseGetprogname}
        - @{OpenBsdFollowStyleInNewCoreCode}
        - @{OpenBsdRunCodeCheckers}
