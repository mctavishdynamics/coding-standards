use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x8x1:
    standard: @{OwaspAsvs}
    ruleId: V6.8.1
    title: Prevent identity spoofing across identity providers
    statement:
        When several identity providers are supported, identify users by the
        provider ID together with the user's ID at that provider, so one
        provider cannot claim another provider's user.
    rationale:
        Matching only on a user identifier lets an account at a weak
        provider impersonate a user from another.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, identity-provider, federation]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v68-authentication-with-an-identity-provider
