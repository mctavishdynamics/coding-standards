use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x1x3:
    standard: @{OwaspAsvs}
    ruleId: V6.1.3
    title: Document every authentication pathway and its controls
    statement:
        When there are several ways to authenticate, document all of them
        with the controls and authentication strength each must enforce
        consistently.
    rationale:
        An attacker will pick the weakest path, so every pathway must be
        known and held to the same bar.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, documentation, authentication]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v61-authentication-documentation
