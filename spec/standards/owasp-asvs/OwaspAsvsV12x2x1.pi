use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV12x2x1:
    standard: @{OwaspAsvs}
    ruleId: V12.2.1
    title: Use TLS for all external HTTP services without fallback
    statement:
        Use TLS for every connection between clients and external-facing
        HTTP services, never falling back to unencrypted traffic.
    rationale:
        Plain HTTP exposes data and sessions to anyone on the network.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, tls, transport]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x21-V12-Secure-Communication.md#v122-https-communication-with-external-facing-services
