use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV14x1x2:
    standard: @{OwaspAsvs}
    ruleId: V14.1.2
    title: Define protection requirements for each sensitivity level
    statement:
        Document for each protection level the required encryption,
        integrity checks, retention, logging rules, access to logs, database
        encryption, privacy technologies and other confidentiality needs.
    rationale:
        Each sensitivity level needs its own controls, and only written
        requirements get implemented consistently.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, data-classification, documentation]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x23-V14-Data-Protection.md#v141-data-protection-documentation
