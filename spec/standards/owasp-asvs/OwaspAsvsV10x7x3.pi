use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x7x3:
    standard: @{OwaspAsvs}
    ruleId: V10.7.3
    title: Let users review, change and revoke consents
    statement:
        Provide a way through the authorization server for users to see,
        modify and withdraw the consents they have given.
    rationale:
        Users need to undo grants they no longer want or that were obtained
        by deception.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, oauth, consent]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v107-consent-management
