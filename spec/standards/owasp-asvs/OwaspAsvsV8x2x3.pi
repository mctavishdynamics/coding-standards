use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV8x2x3:
    standard: @{OwaspAsvs}
    ruleId: V8.2.3
    title: Restrict field access to explicitly permitted consumers
    statement:
        Allow reading and writing of each field only for consumers with
        permission for that field.
    rationale:
        Unchecked fields let users read hidden properties or set ones such
        as roles, called broken object property level authorization.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, authorization, mass-assignment]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x17-V8-Authorization.md#v82-general-authorization-design
