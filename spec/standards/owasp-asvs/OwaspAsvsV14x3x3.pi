use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV14x3x3:
    standard: @{OwaspAsvs}
    ruleId: V14.3.3
    title: Keep sensitive data out of browser storage
    statement:
        Do not keep sensitive data in localStorage, sessionStorage,
        IndexedDB or cookies, apart from session tokens.
    rationale:
        Browser storage is readable by any script on the page, so a single
        XSS flaw exposes everything in it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, client-side, browser-storage]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x23-V14-Data-Protection.md#v143-client-side-data-protection
