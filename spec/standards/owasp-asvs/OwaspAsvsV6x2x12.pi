use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x2x12:
    standard: @{OwaspAsvs}
    ruleId: V6.2.12
    title: Reject passwords found in breaches
    statement:
        Check passwords at registration and change time against a set of
        passwords known from breaches.
    rationale:
        Breached passwords are loaded into credential stuffing tools and are
        tried early in any attack.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, passwords, breached-passwords]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v62-password-security
