use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV3x4x5:
    standard: @{OwaspAsvs}
    ruleId: V3.4.5
    title: Set a referrer policy that avoids leaking sensitive URLs
    statement:
        Apply a referrer policy, through the Referrer-Policy header or HTML
        attributes, so third parties do not receive sensitive path, query
        or, for internal sites, host information.
    rationale:
        The Referer header otherwise passes full URLs, including tokens or
        internal names, to every external resource and link.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, headers, privacy]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x12-V3-Web-Frontend-Security.md#v34-browser-security-mechanism-headers
