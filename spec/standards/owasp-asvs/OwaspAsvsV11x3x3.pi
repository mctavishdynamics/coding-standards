use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV11x3x3:
    standard: @{OwaspAsvs}
    ruleId: V11.3.3
    title: Protect encrypted data against modification
    statement:
        Detect tampering with ciphertext, preferably by using approved
        authenticated encryption or else approved encryption combined with
        an approved MAC.
    rationale:
        Encryption alone does not stop an attacker from altering ciphertext
        in ways that change the decrypted result.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, cryptography, integrity]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x20-V11-Cryptography.md#v113-encryption-algorithms
