use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV1x5x1:
    standard: @{OwaspAsvs}
    ruleId: V1.5.1
    title: Configure XML parsers restrictively to prevent XXE
    statement:
        Set up XML parsers with a restrictive configuration that turns off
        risky features such as external entity resolution and DTD
        processing.
    rationale:
        External entities let a document read local files, reach internal
        hosts or exhaust resources when it is parsed.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, xml, xxe, parsing]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x10-V1-Encoding-and-Sanitization.md#v15-safe-deserialization
