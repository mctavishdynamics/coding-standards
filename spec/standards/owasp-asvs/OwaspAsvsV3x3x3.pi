use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV3x3x3:
    standard: @{OwaspAsvs}
    ruleId: V3.3.3
    title: Use the __Host- prefix unless a cookie must be shared
    statement:
        Name cookies with the __Host- prefix except when they are
        deliberately meant to be shared with other hosts.
    rationale:
        The prefix pins a cookie to a single host and path, so sibling
        subdomains cannot overwrite or inject it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, cookies]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x12-V3-Web-Frontend-Security.md#v33-cookie-setup
