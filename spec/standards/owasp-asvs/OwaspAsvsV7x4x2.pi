use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV7x4x2:
    standard: @{OwaspAsvs}
    ruleId: V7.4.2
    title: End all sessions when an account is disabled or deleted
    statement:
        Terminate every active session of an account at the moment it is
        disabled or removed.
    rationale:
        Open sessions would otherwise let a departed user keep access.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, session, account-lifecycle]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x16-V7-Session-Management.md#v74-session-termination
