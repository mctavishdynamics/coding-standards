use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV12x1x5:
    standard: @{OwaspAsvs}
    ruleId: V12.1.5
    title: Enable Encrypted Client Hello
    statement:
        Turn on Encrypted Client Hello in the TLS settings.
    rationale:
        ECH hides metadata such as the server name from observers during the
        handshake.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, tls, privacy]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x21-V12-Secure-Communication.md#v121-general-tls-security-guidance
