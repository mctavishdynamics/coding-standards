use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV15x2x1:
    standard: @{OwaspAsvs}
    ruleId: V15.2.1
    title: Keep components within their documented update deadlines
    statement:
        Make sure no component in the application is past its documented
        update or remediation deadline.
    rationale:
        Outdated components with known vulnerabilities are among the easiest
        ways into an application.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, dependencies, patching]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x24-V15-Secure-Coding-and-Architecture.md#v152-security-architecture-and-dependencies
