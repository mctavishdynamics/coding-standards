use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV1x2x1:
    standard: @{OwaspAsvs}
    ruleId: V1.2.1
    title: Encode output for the exact HTML, XML or HTTP context
    statement:
        Choose the encoding that fits where the value lands, whether an HTML
        element, an attribute, a comment, CSS or a response header field, so
        that the value cannot alter the structure of the document or
        message.
    rationale:
        Each context has its own special characters, and encoding meant for
        one context does not neutralize the characters that matter in
        another.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, injection, output-encoding, html]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x10-V1-Encoding-and-Sanitization.md#v12-injection-prevention
