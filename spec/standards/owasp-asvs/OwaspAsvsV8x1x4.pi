use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV8x1x4:
    standard: @{OwaspAsvs}
    ruleId: V8.1.4
    title: Document how context drives access decisions
    statement:
        Describe how contextual factors are combined with function, data and
        field rules, including the attributes checked, risk thresholds and
        resulting actions such as allow, challenge, deny or step-up.
    rationale:
        Clear thresholds and actions make adaptive controls predictable and
        auditable.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, documentation, adaptive-security]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x17-V8-Authorization.md#v81-authorization-documentation
