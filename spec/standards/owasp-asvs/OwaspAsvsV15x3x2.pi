use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV15x3x2:
    standard: @{OwaspAsvs}
    ruleId: V15.3.2
    title: Do not follow redirects on backend outbound calls by default
    statement:
        Configure backend calls to external URLs not to follow redirects
        unless that is intended.
    rationale:
        A redirect can send a request that passed URL checks on to an
        internal or forbidden destination.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, ssrf, redirects]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x24-V15-Secure-Coding-and-Architecture.md#v153-defensive-coding
