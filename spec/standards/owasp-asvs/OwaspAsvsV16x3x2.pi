use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV16x3x2:
    standard: @{OwaspAsvs}
    ruleId: V16.3.2
    title: Log failed authorization attempts
    statement:
        Log authorization failures. At level 3, log every authorization
        decision, including access to sensitive data, without logging that
        data itself.
    rationale:
        Denied requests often show an attacker probing for access they
        should not have.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, logging, authorization]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x25-V16-Security-Logging-and-Error-Handling.md#v163-security-events
