use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV16x4x2:
    standard: @{OwaspAsvs}
    ruleId: V16.4.2
    title: Protect logs from unauthorized access and modification
    statement:
        Restrict who can read logs and make sure they cannot be altered.
    rationale:
        Logs lose their value as evidence if they can be changed, and they
        may reveal sensitive details to readers.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, logging, integrity, access-control]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x25-V16-Security-Logging-and-Error-Handling.md#v164-log-protection
