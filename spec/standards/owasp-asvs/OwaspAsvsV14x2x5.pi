use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV14x2x5:
    standard: @{OwaspAsvs}
    ruleId: V14.2.5
    title: Cache only expected content types and never sensitive responses
    statement:
        Configure caches to store only responses with the expected content
        type and without sensitive dynamic content, and have the server
        answer requests for missing files with 404 or 302 rather than
        another valid page.
    rationale:
        Otherwise an attacker can trick a cache into storing a victim's
        private page under a public-looking path, web cache deception.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, caching, web-cache-deception]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x23-V14-Data-Protection.md#v142-general-data-protection
