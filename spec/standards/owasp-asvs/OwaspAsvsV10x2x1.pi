use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x2x1:
    standard: @{OwaspAsvs}
    ruleId: V10.2.1
    title: Protect the OAuth code flow against CSRF
    statement:
        In a client using the code flow, defend against forged token
        requests with PKCE or by checking the state parameter sent in the
        authorization request.
    rationale:
        Without this, an attacker can push their authorization code into the
        victim's client and link the victim to the attacker's account.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, oauth, csrf, pkce]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v102-oauth-client
