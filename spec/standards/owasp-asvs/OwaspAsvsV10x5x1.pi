use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x5x1:
    standard: @{OwaspAsvs}
    ruleId: V10.5.1
    title: Prevent ID token replay with the nonce
    statement:
        As the relying party, defend against replayed ID tokens, for example
        by checking that the nonce claim matches the value sent in the
        authentication request.
    rationale:
        Without the binding, a captured ID token can log an attacker in to a
        different session.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, oidc, replay, id-token]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v105-oidc-client
