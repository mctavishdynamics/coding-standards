use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x1x2:
    standard: @{OwaspAsvs}
    ruleId: V6.1.2
    title: Document context-specific words banned from passwords
    statement:
        Keep a list of words specific to the organization, such as company
        and product names, system names, project codenames and role names,
        plus their variations, that passwords must not use.
    rationale:
        Passwords built from such words are among the first an attacker
        tries against a given organization.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, documentation, passwords]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v61-authentication-documentation
