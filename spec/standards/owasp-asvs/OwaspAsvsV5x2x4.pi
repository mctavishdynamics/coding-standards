use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV5x2x4:
    standard: @{OwaspAsvs}
    ruleId: V5.2.4
    title: Enforce per-user file size and count quotas
    statement:
        Limit the total size and number of files each user may store.
    rationale:
        Without quotas, one user can fill the shared storage with many or
        very large files.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, file-upload, quotas]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x14-V5-File-Handling.md#v52-file-upload-and-content
