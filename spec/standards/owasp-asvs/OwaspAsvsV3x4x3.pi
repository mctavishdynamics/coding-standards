use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV3x4x3:
    standard: @{OwaspAsvs}
    ruleId: V3.4.3
    title: Send a Content Security Policy that limits scripts
    statement:
        Send a Content-Security-Policy that loads and runs only trusted
        resources. At minimum use a global policy with object-src none and
        base-uri none plus an allowlist, nonces or hashes. At level 3,
        generate the policy for each response, based on nonces or hashes.
    rationale:
        A strong policy keeps injected script from running even when an
        encoding mistake lets markup through.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, headers, csp, xss]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x12-V3-Web-Frontend-Security.md#v34-browser-security-mechanism-headers
