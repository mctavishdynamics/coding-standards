use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x2x3:
    standard: @{OwaspAsvs}
    ruleId: V6.2.3
    title: Require the current password to set a new one
    statement:
        Ask for both the current password and the new one when a user
        changes their password.
    rationale:
        This stops someone with brief access to a logged-in session from
        taking over the account by changing its password.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, passwords]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v62-password-security
