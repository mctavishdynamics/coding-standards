use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV11x5x2:
    standard: @{OwaspAsvs}
    ruleId: V11.5.2
    title: Keep random generation secure under heavy load
    statement:
        Use a random number mechanism designed to stay secure even under
        high demand.
    rationale:
        Entropy sources can be drained when overused, and fallback to weaker
        randomness produces predictable secrets.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, randomness, availability]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x20-V11-Cryptography.md#v115-random-values
