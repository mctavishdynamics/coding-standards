use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV7x5x1:
    standard: @{OwaspAsvs}
    ruleId: V7.5.1
    title: Re-authenticate before changing sensitive account attributes
    statement:
        Require full re-authentication before changes to attributes that
        affect authentication or recovery, such as email, phone number or
        MFA settings.
    rationale:
        A hijacked session could otherwise change recovery details and take
        over the account permanently.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, session, reauthentication]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x16-V7-Session-Management.md#v75-defenses-against-session-abuse
