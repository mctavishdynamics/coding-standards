use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV11x3x2:
    standard: @{OwaspAsvs}
    ruleId: V11.3.2
    title: Use only approved ciphers and modes
    statement:
        Use only vetted encryption algorithms in vetted modes of operation,
        for example AES with GCM.
    rationale:
        Modern authenticated ciphers built on AES or ChaCha20 are the
        accepted baseline, and older ones have known flaws.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, cryptography, encryption]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x20-V11-Cryptography.md#v113-encryption-algorithms
