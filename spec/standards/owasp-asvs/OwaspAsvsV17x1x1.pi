use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV17x1x1:
    standard: @{OwaspAsvs}
    ruleId: V17.1.1
    title: Block relaying to special-purpose IP addresses on TURN servers
    statement:
        Let the TURN service relay only to ordinary public addresses,
        excluding internal, loopback and broadcast ranges, for both IPv4 and
        IPv6.
    rationale:
        A misconfigured TURN server can be used to reach internal networks
        that should not be exposed.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, webrtc, turn, ssrf]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x26-V17-WebRTC.md#v171-turn-server
