use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV7x5x2:
    standard: @{OwaspAsvs}
    ruleId: V7.5.2
    title: Let users view and terminate their active sessions
    statement:
        Show users their active sessions and let them end any or all of them
        after confirming with at least one factor.
    rationale:
        Users can spot and shut down sessions they do not recognize.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, session, user-control]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x16-V7-Session-Management.md#v75-defenses-against-session-abuse
