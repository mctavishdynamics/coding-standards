use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV13x4x4:
    standard: @{OwaspAsvs}
    ruleId: V13.4.4
    title: Do not support HTTP TRACE in production
    statement:
        Disable the TRACE method in production.
    rationale:
        TRACE echoes requests back, which can leak headers such as cookies.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, http-methods, information-disclosure]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x22-V13-Configuration.md#v134-unintended-information-leakage
