use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV4x3x1:
    standard: @{OwaspAsvs}
    ruleId: V4.3.1
    title: Limit the cost of GraphQL queries
    statement:
        Protect GraphQL with a query allowlist, depth limits, amount limits
        or query cost analysis.
    rationale:
        Deeply nested or very broad queries can exhaust the server and the
        data layer behind it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, graphql, denial-of-service]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x13-V4-API-and-Web-Service.md#v43-graphql
