use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV1x4x2:
    standard: @{OwaspAsvs}
    ruleId: V1.4.2
    title: Prevent integer overflows
    statement:
        Check sign and range, and validate input, before arithmetic that
        could overflow or wrap.
    rationale:
        An overflowed size or index produces undersized buffers and
        out-of-bounds access later in the code.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, memory, integer-overflow]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x10-V1-Encoding-and-Sanitization.md#v14-memory-string-and-unmanaged-code
