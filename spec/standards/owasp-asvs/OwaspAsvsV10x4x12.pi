use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x4x12:
    standard: @{OwaspAsvs}
    ruleId: V10.4.12
    title: Allow only the response mode each client needs
    statement:
        Accept only the response_mode values a client is expected to use, by
        validating them or by using PAR or JAR.
    rationale:
        Switching the response mode can expose codes or tokens through
        channels the client did not plan to use.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, oauth, response-mode]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v104-oauth-authorization-server
