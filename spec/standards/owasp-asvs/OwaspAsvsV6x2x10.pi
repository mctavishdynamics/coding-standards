use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x2x10:
    standard: @{OwaspAsvs}
    ruleId: V6.2.10
    title: Do not force periodic password changes
    statement:
        Keep a password valid until it is found to be compromised or the
        user chooses to change it. Never require scheduled rotation.
    rationale:
        Forced rotation leads to small predictable changes and weaker
        passwords rather than better security.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, passwords, password-policy]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v62-password-security
