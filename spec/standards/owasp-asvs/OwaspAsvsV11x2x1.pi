use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV11x2x1:
    standard: @{OwaspAsvs}
    ruleId: V11.2.1
    title: Use industry-validated cryptographic implementations
    statement:
        Perform cryptographic operations with validated libraries or
        hardware implementations, not home-made code.
    rationale:
        Cryptography is easy to get subtly wrong, and vetted implementations
        have had the testing and review that custom code lacks.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, cryptography, libraries]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x20-V11-Cryptography.md#v112-secure-cryptography-implementation
