use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x3x4:
    standard: @{OwaspAsvs}
    ruleId: V10.3.4
    title: Check token authentication strength where it matters
    statement:
        When a resource requires a certain authentication strength, method
        or recency, confirm the access token meets it, using acr, amr and
        auth_time when present.
    rationale:
        Without the check, a weakly authenticated token can reach resources
        meant for strongly authenticated users.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, oauth, authentication-strength]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v103-oauth-resource-server
