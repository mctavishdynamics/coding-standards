use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV8x4x2:
    standard: @{OwaspAsvs}
    ruleId: V8.4.2
    title: Protect administrative interfaces with several layers
    statement:
        Guard admin interfaces with continuous identity verification, device
        posture checks and contextual risk analysis, not with network
        location or trusted endpoints alone.
    rationale:
        Network position is easily gained by an attacker inside the network,
        so it cannot be the only gate to administrative power.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, authorization, administration, zero-trust]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x17-V8-Authorization.md#v84-other-authorization-considerations
