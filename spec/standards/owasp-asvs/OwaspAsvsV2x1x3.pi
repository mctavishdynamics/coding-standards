use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV2x1x3:
    standard: @{OwaspAsvs}
    ruleId: V2.1.3
    title: Document business logic limits per user and globally
    statement:
        Write down the expected limits and checks for business logic, both
        for a single user and for the application as a whole.
    rationale:
        Undocumented limits are rarely implemented, which leaves the logic
        open to abuse at scale.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, documentation, business-logic]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x11-V2-Validation-and-Business-Logic.md#v21-validation-and-business-logic-documentation
