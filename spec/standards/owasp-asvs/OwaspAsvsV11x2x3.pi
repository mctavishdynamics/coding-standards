use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV11x2x3:
    standard: @{OwaspAsvs}
    ruleId: V11.2.3
    title: Use at least 128 bits of security in all primitives
    statement:
        Choose algorithms, key sizes and settings that give at least 128
        bits of security, for example 256-bit elliptic curve keys or
        3072-bit RSA keys.
    rationale:
        Weaker parameters are within reach of well-resourced attackers now
        or in the near future.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, cryptography, key-length]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x20-V11-Cryptography.md#v112-secure-cryptography-implementation
