use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV4x1x3:
    standard: @{OwaspAsvs}
    ruleId: V4.1.3
    title: Stop users overriding headers set by intermediaries
    statement:
        Make sure header fields that a load balancer, proxy or
        backend-for-frontend adds, such as X-Forwarded-For, X-Real-IP or a
        user id header, cannot be supplied or replaced by the end user.
    rationale:
        If clients can forge these headers, they can spoof their address or
        identity to the application behind the proxy.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, headers, proxies, trust-boundary]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x13-V4-API-and-Web-Service.md#v41-generic-web-service-security
