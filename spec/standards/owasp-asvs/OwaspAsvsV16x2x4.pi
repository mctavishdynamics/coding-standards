use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV16x2x4:
    standard: @{OwaspAsvs}
    ruleId: V16.2.4
    title: Use a log format the log processor can read
    statement:
        Make sure the log processor in use can parse and correlate the logs,
        ideally through a common format.
    rationale:
        Logs that tools cannot parse do not support detection or
        investigation.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, logging, format]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x25-V16-Security-Logging-and-Error-Handling.md#v162-general-logging
