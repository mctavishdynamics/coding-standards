use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV17x2x4:
    standard: @{OwaspAsvs}
    ruleId: V17.2.4
    title: Keep media processing running despite malformed SRTP packets
    statement:
        Make the media server continue handling traffic when it receives
        malformed SRTP packets.
    rationale:
        Malformed packets that crash or stall the server are an easy way to
        deny service, so input must be validated and errors handled
        robustly.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, webrtc, robustness]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x26-V17-WebRTC.md#v172-media
