use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV12x1x3:
    standard: @{OwaspAsvs}
    ruleId: V12.1.3
    title: Validate mTLS client certificates before trusting them
    statement:
        Confirm that a client certificate is trusted before using its
        identity for authentication or authorization.
    rationale:
        An untrusted certificate can claim any identity.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, tls, mtls, certificates]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x21-V12-Secure-Communication.md#v121-general-tls-security-guidance
