use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x5x1:
    standard: @{OwaspAsvs}
    ruleId: V6.5.1
    title: Make one-time codes usable only once
    statement:
        Make lookup secrets, out-of-band codes and requests, and TOTP values
        succeed only a single time.
    rationale:
        A code that works twice can be replayed by anyone who captures it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, mfa, one-time-codes]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v65-general-multi-factor-authentication-requirements
