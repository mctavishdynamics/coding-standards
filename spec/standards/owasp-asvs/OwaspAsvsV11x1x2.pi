use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV11x1x2:
    standard: @{OwaspAsvs}
    ruleId: V11.1.2
    title: Maintain an inventory of keys, algorithms and certificates
    statement:
        Build and regularly update an inventory of every key, algorithm and
        certificate the application uses, recording where each key may be
        used and what data it may protect.
    rationale:
        Cryptographic assets that are not known cannot be assessed, rotated
        or replaced when a weakness appears.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, cryptography, inventory]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x20-V11-Cryptography.md#v111-cryptographic-inventory-and-documentation
