use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV3x5x6:
    standard: @{OwaspAsvs}
    ruleId: V3.5.6
    title: Disable JSONP everywhere
    statement:
        Do not enable JSONP endpoints anywhere in the application.
    rationale:
        JSONP serves data as executable script, which other sites can
        include to read it, a form of cross-site script inclusion.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, xssi, jsonp]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x12-V3-Web-Frontend-Security.md#v35-browser-origin-separation
