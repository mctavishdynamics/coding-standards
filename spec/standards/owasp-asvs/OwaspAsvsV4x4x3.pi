use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV4x4x3:
    standard: @{OwaspAsvs}
    ruleId: V4.4.3
    title: Use compliant dedicated tokens when sessions do not fit WebSockets
    statement:
        If the normal session mechanism cannot be used for WebSockets, use
        dedicated tokens that meet the session management requirements.
    rationale:
        A separate token that skips session rules would become the weakest
        way into the application.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, websocket, session]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x13-V4-API-and-Web-Service.md#v44-websocket
