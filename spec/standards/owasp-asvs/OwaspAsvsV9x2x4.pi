use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV9x2x4:
    standard: @{OwaspAsvs}
    ruleId: V9.2.4
    title: Restrict audiences when one key signs tokens for many
    statement:
        When an issuer uses one private key for tokens sent to different
        audiences, include an audience restriction that uniquely names the
        intended ones. Validate dynamically provisioned audience ids so they
        cannot impersonate others.
    rationale:
        Without a unique audience, a token meant for one service is accepted
        by every service that trusts the key.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, tokens, audience, issuer]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x18-V9-Self-contained-Tokens.md#v92-token-content
