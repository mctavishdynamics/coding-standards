use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV14x3x1:
    standard: @{OwaspAsvs}
    ruleId: V14.3.1
    title: Clear authenticated data from the client when the session ends
    statement:
        Remove authenticated data from client storage, including the DOM,
        when the session or client terminates. The Clear-Site-Data header
        can help, but client code should also clean up when the server is
        unreachable.
    rationale:
        Data left in the browser can be read by the next user of a shared
        device.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, client-side, session, data-cleanup]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x23-V14-Data-Protection.md#v143-client-side-data-protection
