use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV3x2x3:
    standard: @{OwaspAsvs}
    ruleId: V3.2.3
    title: Prevent DOM clobbering in client-side code
    statement:
        Declare variables explicitly, check types strictly, keep globals off
        the document object and isolate code in namespaces.
    rationale:
        Injected HTML elements with chosen ids or names can overwrite
        globals that scripts rely on and redirect their behavior.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, dom, javascript]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x12-V3-Web-Frontend-Security.md#v32-unintended-content-interpretation
