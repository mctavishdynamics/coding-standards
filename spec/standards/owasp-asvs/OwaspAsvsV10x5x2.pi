use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x5x2:
    standard: @{OwaspAsvs}
    ruleId: V10.5.2
    title: Identify users by a non-reassignable ID token claim
    statement:
        Recognize users by ID token claims that are never reassigned within
        the provider, usually sub.
    rationale:
        Mutable attributes such as email may later belong to someone else
        and grant them the original user's account.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, oidc, identity, id-token]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v105-oidc-client
