use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV17x3x1:
    standard: @{OwaspAsvs}
    ruleId: V17.3.1
    title: Keep signaling working during floods with rate limiting
    statement:
        Rate limit signaling messages so the signaling server keeps handling
        legitimate traffic during a flood.
    rationale:
        Signaling is needed to set up every session, so a flooded server
        blocks all communication.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, webrtc, signaling, rate-limiting]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x26-V17-WebRTC.md#v173-signaling
