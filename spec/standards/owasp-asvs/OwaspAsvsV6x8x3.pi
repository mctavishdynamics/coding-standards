use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x8x3:
    standard: @{OwaspAsvs}
    ruleId: V6.8.3
    title: Accept each SAML assertion only once
    statement:
        Process every SAML assertion a single time within its validity
        period.
    rationale:
        A captured assertion could otherwise be replayed to start new
        sessions.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, saml, replay]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v68-authentication-with-an-identity-provider
