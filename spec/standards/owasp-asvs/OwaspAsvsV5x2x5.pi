use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV5x2x5:
    standard: @{OwaspAsvs}
    ruleId: V5.2.5
    title: Reject uploaded archives that contain symlinks
    statement:
        Refuse compressed uploads with symbolic links unless they are truly
        needed, and then allow links only to an allowlist of targets.
    rationale:
        A symlink inside an archive can point outside the extraction folder
        and expose or overwrite sensitive files.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, file-upload, archives, symlinks]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x14-V5-File-Handling.md#v52-file-upload-and-content
