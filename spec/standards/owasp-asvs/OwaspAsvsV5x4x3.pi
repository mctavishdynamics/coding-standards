use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV5x4x3:
    standard: @{OwaspAsvs}
    ruleId: V5.4.3
    title: Scan untrusted files for malware before serving them
    statement:
        Run files from untrusted sources through antivirus scanning so known
        malicious content is not served.
    rationale:
        The application would otherwise become a distribution point for
        malware uploaded by attackers.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, file-download, malware]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x14-V5-File-Handling.md#v54-file-download
