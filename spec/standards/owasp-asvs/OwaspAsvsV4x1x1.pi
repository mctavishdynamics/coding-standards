use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV4x1x1:
    standard: @{OwaspAsvs}
    ruleId: V4.1.1
    title: Send an accurate Content-Type with a charset
    statement:
        Give every response that has a body a Content-Type matching what the
        body really is, with a charset parameter naming a safe encoding such
        as UTF-8 for text and XML types.
    rationale:
        A missing or wrong type or charset lets the client guess, which can
        turn data into executable content or garble its meaning.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, headers, content-type, api]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x13-V4-API-and-Web-Service.md#v41-generic-web-service-security
