use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV17x1x2:
    standard: @{OwaspAsvs}
    ruleId: V17.1.2
    title: Protect TURN servers from port exhaustion
    statement:
        Make sure the TURN service holds up when users try to open very many
        ports on it.
    rationale:
        Allocating unlimited relay ports exhausts server resources and
        denies service to others.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, webrtc, turn, denial-of-service]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x26-V17-WebRTC.md#v171-turn-server
