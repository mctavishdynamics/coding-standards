use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV3x4x7:
    standard: @{OwaspAsvs}
    ruleId: V3.4.7
    title: Configure a CSP violation report location
    statement:
        Give the Content-Security-Policy a destination for violation
        reports.
    rationale:
        Reports reveal injection attempts and policy mistakes that would
        otherwise go unnoticed.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, headers, csp, monitoring]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x12-V3-Web-Frontend-Security.md#v34-browser-security-mechanism-headers
