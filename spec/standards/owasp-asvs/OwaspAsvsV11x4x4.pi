use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV11x4x4:
    standard: @{OwaspAsvs}
    ruleId: V11.4.4
    title: Derive keys from passwords with key stretching
    statement:
        When turning a password into a key, use an approved key derivation
        function with stretching parameters that make brute force
        impractical.
    rationale:
        Passwords are low in entropy, so without stretching the derived key
        can be found by guessing passwords quickly.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, cryptography, key-derivation]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x20-V11-Cryptography.md#v114-hashing-and-hash-based-functions
