use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV15x1x2:
    standard: @{OwaspAsvs}
    ruleId: V15.1.2
    title: Keep an inventory of third-party libraries
    statement:
        Maintain a catalog, such as a software bill of materials, of all
        third-party libraries, and confirm they come from predefined,
        trusted and maintained repositories.
    rationale:
        A complete inventory is needed to know which components are affected
        when a vulnerability is announced.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, dependencies, sbom, supply-chain]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x24-V15-Secure-Coding-and-Architecture.md#v151-secure-coding-and-architecture-documentation
