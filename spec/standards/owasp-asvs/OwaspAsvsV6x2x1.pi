use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x2x1:
    standard: @{OwaspAsvs}
    ruleId: V6.2.1
    title: Require passwords of at least 8 characters
    statement:
        Set the minimum length of user-chosen passwords to 8 characters, and
        preferably 15.
    rationale:
        Length is the main factor in how hard a password is to guess.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, passwords]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v62-password-security
