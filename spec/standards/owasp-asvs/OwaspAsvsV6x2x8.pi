use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x2x8:
    standard: @{OwaspAsvs}
    ruleId: V6.2.8
    title: Check passwords exactly as entered
    statement:
        Verify the password exactly as the user typed it, without truncating
        it or changing its case.
    rationale:
        Altering the password before checking quietly lowers its strength
        and makes more guesses succeed.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, passwords]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v62-password-security
