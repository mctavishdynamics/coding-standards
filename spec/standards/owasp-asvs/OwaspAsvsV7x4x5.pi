use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV7x4x5:
    standard: @{OwaspAsvs}
    ruleId: V7.4.5
    title: Let administrators terminate user sessions
    statement:
        Allow administrators to end active sessions for one user or for all
        users.
    rationale:
        During an incident, responders need to cut off an attacker's access
        quickly.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, session, administration]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x16-V7-Session-Management.md#v74-session-termination
