use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV16x4x1:
    standard: @{OwaspAsvs}
    ruleId: V16.4.1
    title: Encode logged data to prevent log injection
    statement:
        Have every logging component encode data so that it cannot forge or
        break log entries.
    rationale:
        Line breaks or control characters in input can fake entries or
        attack the tools that read the logs.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, logging, log-injection]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x25-V16-Security-Logging-and-Error-Handling.md#v164-log-protection
