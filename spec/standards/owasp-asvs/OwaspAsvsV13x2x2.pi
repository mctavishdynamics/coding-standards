use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV13x2x2:
    standard: @{OwaspAsvs}
    ruleId: V13.2.2
    title: Use least-privileged accounts between backend components
    statement:
        Run communication between backend parts, including OS services,
        APIs, middleware and databases, under accounts with only the
        privileges they need.
    rationale:
        Minimal privileges limit how far an attacker can move after
        compromising one component.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, least-privilege, service-accounts]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x22-V13-Configuration.md#v132-backend-communication-configuration
