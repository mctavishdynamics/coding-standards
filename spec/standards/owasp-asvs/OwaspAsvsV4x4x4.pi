use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV4x4x4:
    standard: @{OwaspAsvs}
    ruleId: V4.4.4
    title: Issue WebSocket tokens through the authenticated HTTPS session
    statement:
        When moving an existing HTTPS session onto a WebSocket, obtain or
        validate the dedicated WebSocket token through that already
        authenticated session.
    rationale:
        Tying the token to the authenticated session prevents an
        unauthenticated party from opening a channel as the user.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, websocket, session]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x13-V4-API-and-Web-Service.md#v44-websocket
