use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV1x3x3:
    standard: @{OwaspAsvs}
    ruleId: V1.3.3
    title: Sanitize data before it enters a dangerous context
    statement:
        Before handing data to a context that could misuse it, restrict it
        to characters that are safe there and cut it to a sensible length.
    rationale:
        When context-specific encoding is not available, removing unsafe
        characters and oversized input is what keeps the context safe.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, sanitization]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x10-V1-Encoding-and-Sanitization.md#v13-sanitization
