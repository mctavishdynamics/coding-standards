use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV3x7x2:
    standard: @{OwaspAsvs}
    ruleId: V3.7.2
    title: Auto-redirect to external hosts only from an allowlist
    statement:
        Redirect users automatically to a domain the application does not
        control only when that destination is on an allowlist.
    rationale:
        Open redirects let attackers borrow the application's reputation to
        send users to phishing or malware sites.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, redirects]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x12-V3-Web-Frontend-Security.md#v37-other-browser-security-considerations
