use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x5x7:
    standard: @{OwaspAsvs}
    ruleId: V6.5.7
    title: Use biometrics only as a secondary factor
    statement:
        Use biometric authentication only alongside something the user has
        or knows, never on its own.
    rationale:
        Biometrics are probabilistic and cannot be changed if compromised,
        so they are not strong enough alone.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, mfa, biometrics]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v65-general-multi-factor-authentication-requirements
