use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV2x1x2:
    standard: @{OwaspAsvs}
    ruleId: V2.1.2
    title: Document checks for consistency between related data items
    statement:
        Record how combinations of data items are checked for logical and
        contextual consistency, such as a postal code matching its town.
    rationale:
        Fields that are each valid can still form an impossible combination,
        and only documented rules get implemented consistently.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, documentation, input-validation]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x11-V2-Validation-and-Business-Logic.md#v21-validation-and-business-logic-documentation
