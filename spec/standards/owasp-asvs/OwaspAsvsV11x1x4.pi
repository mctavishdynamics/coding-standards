use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV11x1x4:
    standard: @{OwaspAsvs}
    ruleId: V11.1.4
    title: Plan migration to new standards such as post-quantum
    statement:
        Keep the cryptographic inventory together with a documented plan for
        moving to new standards, including post-quantum algorithms.
    rationale:
        Quantum computers are expected to break RSA and elliptic curve
        schemes, so the move has to be prepared in advance.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, cryptography, post-quantum, migration]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x20-V11-Cryptography.md#v111-cryptographic-inventory-and-documentation
