use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV11x6x2:
    standard: @{OwaspAsvs}
    ruleId: V11.6.2
    title: Use approved key exchange with secure parameters
    statement:
        Use approved key exchange methods such as Diffie-Hellman or ECDH
        with secure parameters.
    rationale:
        Weak parameters let attackers break key establishment and sit in the
        middle of the connection.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, cryptography, key-exchange]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x20-V11-Cryptography.md#v116-public-key-cryptography
