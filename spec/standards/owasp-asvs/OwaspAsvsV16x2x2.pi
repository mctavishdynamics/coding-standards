use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV16x2x2:
    standard: @{OwaspAsvs}
    ruleId: V16.2.2
    title: Synchronize log clocks and record time zones
    statement:
        Synchronize time across all logging components and write security
        event timestamps in UTC or with an explicit offset, UTC being
        preferred.
    rationale:
        Mismatched clocks and ambiguous times make it impossible to order
        events across systems, especially around daylight saving changes.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, logging, time]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x25-V16-Security-Logging-and-Error-Handling.md#v162-general-logging
