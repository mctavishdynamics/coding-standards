use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV15x1x4:
    standard: @{OwaspAsvs}
    ruleId: V15.1.4
    title: Flag risky third-party components in the documentation
    statement:
        Identify third-party libraries that count as risky, such as those
        that are poorly maintained, unsupported, end of life or have a
        history of serious flaws.
    rationale:
        Knowing which components are risky lets the team isolate and watch
        them more closely.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, dependencies, documentation, risk]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x24-V15-Secure-Coding-and-Architecture.md#v151-secure-coding-and-architecture-documentation
