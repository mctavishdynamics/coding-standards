use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV5x2x1:
    standard: @{OwaspAsvs}
    ruleId: V5.2.1
    title: Accept only files small enough to process safely
    statement:
        Reject uploads larger than the application can handle without
        slowing down or failing.
    rationale:
        Oversized files can exhaust memory, disk or processing time and deny
        service to other users.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, file-upload, denial-of-service]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x14-V5-File-Handling.md#v52-file-upload-and-content
