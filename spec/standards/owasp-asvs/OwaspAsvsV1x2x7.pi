use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV1x2x7:
    standard: @{OwaspAsvs}
    ruleId: V1.2.7
    title: Prevent XPath injection with parameterized queries
    statement:
        Run XPath expressions with variables bound through the API or as
        precompiled expressions rather than splicing untrusted text into
        them.
    rationale:
        Untrusted text inside an XPath string can rewrite the predicate and
        expose nodes the query was never meant to return.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, injection, xpath]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x10-V1-Encoding-and-Sanitization.md#v12-injection-prevention
