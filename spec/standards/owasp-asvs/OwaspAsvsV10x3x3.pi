use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x3x3:
    standard: @{OwaspAsvs}
    ruleId: V10.3.3
    title: Identify users from claims that cannot be reassigned
    statement:
        When a decision needs a unique user, identify them by claims that
        are never reused for another user, normally iss together with sub.
    rationale:
        Claims such as email can change hands, letting one user be mistaken
        for another.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, oauth, identity, resource-server]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v103-oauth-resource-server
