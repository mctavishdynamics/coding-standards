use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x4x15:
    standard: @{OwaspAsvs}
    ruleId: V10.4.15
    title: Protect authorization_details from user tampering
    statement:
        For server-side clients, make sure the authorization_details value
        comes from the client backend unchanged, for example by requiring
        PAR or JAR.
    rationale:
        If a user can edit these details in the browser, they can grant
        themselves authorizations the backend never requested.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, oauth, rich-authorization-requests]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v104-oauth-authorization-server
