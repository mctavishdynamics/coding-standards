use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV14x2x4:
    standard: @{OwaspAsvs}
    ruleId: V14.2.4
    title: Implement the protections defined for each data level
    statement:
        Apply the encryption, integrity, retention, logging, log access and
        privacy controls that the documentation sets for each data's
        protection level.
    rationale:
        Defined protection levels only matter if the controls behind them
        are actually in place.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, sensitive-data, data-classification]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x23-V14-Data-Protection.md#v142-general-data-protection
