use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV13x4x7:
    standard: @{OwaspAsvs}
    ruleId: V13.4.7
    title: Serve only files with expected extensions
    statement:
        Configure the web tier to serve only specific file extensions.
    rationale:
        This keeps configuration files, backups and source code from being
        downloaded by accident.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, information-disclosure, server-configuration]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x22-V13-Configuration.md#v134-unintended-information-leakage
