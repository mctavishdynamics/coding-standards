use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV9x2x1:
    standard: @{OwaspAsvs}
    ruleId: V9.2.1
    title: Accept tokens only within their validity period
    statement:
        When a token carries validity times, reject it outside that window.
        For JWTs, check nbf and exp.
    rationale:
        Expired tokens that are still accepted extend the life of any stolen
        token.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, tokens, expiry]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x18-V9-Self-contained-Tokens.md#v92-token-content
