use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV14x2x6:
    standard: @{OwaspAsvs}
    ruleId: V14.2.6
    title: Return only the minimum sensitive data required
    statement:
        Send back only the sensitive data the function needs, such as the
        last digits of a card number, and mask full values in the interface
        unless the user chooses to view them.
    rationale:
        Less data returned means less data exposed when something goes
        wrong.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, data-minimization, sensitive-data]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x23-V14-Data-Protection.md#v142-general-data-protection
