use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV1x3x10:
    standard: @{OwaspAsvs}
    ruleId: V1.3.10
    title: Sanitize format strings before use
    statement:
        Do not let untrusted data act as a format string. Sanitize any
        format string that could resolve in an unexpected way before it is
        processed.
    rationale:
        Format specifiers in attacker input can read memory, crash the
        program or reveal internal object data.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        message = user_template.format(user=current_user)
        \\\
        ```
    compliant:
        ```python
        \\\
        message = "Welcome, {name}".format(name=current_user.display_name)
        \\\
        ```
    languages: [any]
    tags: [level-2, injection, format-string]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x10-V1-Encoding-and-Sanitization.md#v13-sanitization
