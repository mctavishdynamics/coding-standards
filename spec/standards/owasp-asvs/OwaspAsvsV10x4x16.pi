use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x4x16:
    standard: @{OwaspAsvs}
    ruleId: V10.4.16
    title: Require strong client authentication
    statement:
        Use confidential clients with strong, replay-resistant public key
        authentication such as mutual TLS or private_key_jwt.
    rationale:
        Shared client secrets can leak and be replayed, while key-based
        methods resist both.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, oauth, client-authentication]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v104-oauth-authorization-server
