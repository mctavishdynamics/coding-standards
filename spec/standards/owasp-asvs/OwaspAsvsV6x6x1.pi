use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x6x1:
    standard: @{OwaspAsvs}
    ruleId: V6.6.1
    title: Restrict phone and SMS one-time passwords
    statement:
        Offer OTPs by phone or SMS only for previously validated numbers,
        alongside stronger options such as TOTP, and explain the risks to
        users. At level 3, do not offer phone or SMS at all.
    rationale:
        Telephone channels are exposed to SIM swaps, number porting and
        interception, which NIST treats as a restricted method.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, mfa, sms]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v66-out-of-band-authentication-mechanisms
