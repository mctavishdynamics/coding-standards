use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV7x2x2:
    standard: @{OwaspAsvs}
    ruleId: V7.2.2
    title: Use dynamically generated session tokens, not static keys
    statement:
        Manage sessions with dynamically issued self-contained or reference
        tokens rather than static API secrets or keys.
    rationale:
        Static secrets never expire per session and are hard to revoke once
        leaked.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, session, tokens]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x16-V7-Session-Management.md#v72-fundamental-session-management-security
