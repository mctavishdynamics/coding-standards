use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x6x1:
    standard: @{OwaspAsvs}
    ruleId: V10.6.1
    title: Allow only safe OIDC response types
    statement:
        Have the OpenID Provider accept only code, ciba, id_token or
        id_token code, preferring code over the hybrid flow, and never any
        implicit flow using token.
    rationale:
        Implicit flows expose tokens in the browser where they can leak.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, oidc, response-type]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v106-openid-provider
