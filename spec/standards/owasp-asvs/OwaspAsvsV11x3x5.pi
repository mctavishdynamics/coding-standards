use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV11x3x5:
    standard: @{OwaspAsvs}
    ruleId: V11.3.5
    title: Combine encryption and MAC as encrypt-then-MAC
    statement:
        When pairing a cipher with a separate MAC, encrypt first and then
        compute the MAC over the ciphertext.
    rationale:
        Other orderings have led to practical attacks because the receiver
        decrypts unauthenticated data.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, cryptography, mac]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x20-V11-Cryptography.md#v113-encryption-algorithms
