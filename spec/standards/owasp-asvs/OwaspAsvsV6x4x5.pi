use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x4x5:
    standard: @{OwaspAsvs}
    ruleId: V6.4.5
    title: Send renewal reminders before authenticators expire
    statement:
        For authentication mechanisms that expire, send renewal instructions
        early enough for users to act before the old one stops working,
        using automated reminders if needed.
    rationale:
        Late notice causes lockouts and pushes users and support staff
        toward insecure workarounds.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, credentials, expiry]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v64-authentication-factor-lifecycle-and-recovery
