use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x2x2:
    standard: @{OwaspAsvs}
    ruleId: V10.2.2
    title: Defend OAuth clients against mix-up attacks
    statement:
        When a client works with more than one authorization server, guard
        against mix-up attacks, for example by requiring and validating the
        iss parameter in authorization and token responses.
    rationale:
        A malicious server could otherwise trick the client into sending a
        code or token meant for an honest server to the attacker.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, oauth, mix-up]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v102-oauth-client
