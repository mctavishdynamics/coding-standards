use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV5x4x1:
    standard: @{OwaspAsvs}
    ruleId: V5.4.1
    title: Set the download filename instead of trusting the user's
    statement:
        Validate or ignore filenames that users submit, whether in JSON,
        JSONP or URL parameters, and set the filename in the
        Content-Disposition response header yourself.
    rationale:
        A user-chosen download name can trick the browser into treating the
        file as something it is not, such as an executable.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, file-download, headers]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x14-V5-File-Handling.md#v54-file-download
