use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV3x3x2:
    standard: @{OwaspAsvs}
    ruleId: V3.3.2
    title: Set the SameSite attribute to suit each cookie
    statement:
        Give every cookie a SameSite value chosen for how that cookie is
        used.
    rationale:
        A suitable SameSite value limits cross-site request forgery and user
        interface redress attacks by holding cookies back on cross-site
        requests.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, cookies, csrf]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x12-V3-Web-Frontend-Security.md#v33-cookie-setup
