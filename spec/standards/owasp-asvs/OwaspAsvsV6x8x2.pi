use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x8x2:
    standard: @{OwaspAsvs}
    ruleId: V6.8.2
    title: Always validate signatures on authentication assertions
    statement:
        Check that assertions such as JWTs or SAML assertions are signed and
        that the signature is valid, rejecting any that are not.
    rationale:
        Unsigned or improperly checked assertions can be forged to log in as
        any user.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, identity-provider, signatures]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v68-authentication-with-an-identity-provider
