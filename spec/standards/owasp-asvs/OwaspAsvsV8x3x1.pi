use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV8x3x1:
    standard: @{OwaspAsvs}
    ruleId: V8.3.1
    title: Enforce authorization in a trusted service layer
    statement:
        Make access decisions on the server side, never relying on controls
        the consumer can alter, such as client-side JavaScript.
    rationale:
        Client-side checks can be bypassed by calling the backend directly.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, authorization, trust-boundary]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x17-V8-Authorization.md#v83-operation-level-authorization
