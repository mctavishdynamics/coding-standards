use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV3x7x1:
    standard: @{OwaspAsvs}
    ruleId: V3.7.1
    title: Use only supported client-side technologies
    statement:
        Build the client only on technologies that are still supported and
        considered secure, not on plugins such as Flash, ActiveX,
        Silverlight or Java applets.
    rationale:
        Unsupported technologies receive no security fixes and carry known
        weaknesses.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, browser-security, deprecated-technology]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x12-V3-Web-Frontend-Security.md#v37-other-browser-security-considerations
