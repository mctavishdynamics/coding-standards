use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV7x5x3:
    standard: @{OwaspAsvs}
    ruleId: V7.5.3
    title: Require extra verification for highly sensitive operations
    statement:
        Ask for at least one more authentication factor or a secondary check
        before carrying out highly sensitive transactions.
    rationale:
        This blocks an attacker who rides an existing session, for example
        through injected content, from completing critical actions.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, session, step-up]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x16-V7-Session-Management.md#v75-defenses-against-session-abuse
