use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV12x1x1:
    standard: @{OwaspAsvs}
    ruleId: V12.1.1
    title: Enable only current TLS versions and prefer the newest
    statement:
        Allow only recommended TLS versions such as 1.2 and 1.3, with the
        latest version preferred.
    rationale:
        Older protocol versions have known weaknesses that allow decryption
        or downgrade.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, tls, transport]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x21-V12-Secure-Communication.md#v121-general-tls-security-guidance
