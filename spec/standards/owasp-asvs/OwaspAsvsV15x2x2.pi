use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV15x2x2:
    standard: @{OwaspAsvs}
    ruleId: V15.2.2
    title: Protect availability around resource-heavy functionality
    statement:
        Implement the documented defenses that keep slow or
        resource-demanding functions from exhausting the application.
    rationale:
        Without them, a few heavy requests can take the service down.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, availability, denial-of-service]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x24-V15-Secure-Coding-and-Architecture.md#v152-security-architecture-and-dependencies
