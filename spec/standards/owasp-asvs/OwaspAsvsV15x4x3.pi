use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV15x4x3:
    standard: @{OwaspAsvs}
    ruleId: V15.4.3
    title: Use locks consistently and keep them encapsulated
    statement:
        Use locks in a consistent way so threads do not block each other or
        retry forever, and keep the locking logic inside the code that owns
        the resource.
    rationale:
        Inconsistent locking causes deadlocks and livelocks, and exposed
        locks can be misused by outside code.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, concurrency, locking]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x24-V15-Secure-Coding-and-Architecture.md#v154-safe-concurrency
