use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV14x2x8:
    standard: @{OwaspAsvs}
    ruleId: V14.2.8
    title: Strip sensitive metadata from uploaded files
    statement:
        Strip sensitive details such as location from the metadata of files
        users upload, unless the user has agreed to keep them.
    rationale:
        File metadata can quietly reveal where and by whom a file was made.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, privacy, file-metadata]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x23-V14-Data-Protection.md#v142-general-data-protection
