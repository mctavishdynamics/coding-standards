use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV9x2x3:
    standard: @{OwaspAsvs}
    ruleId: V9.2.3
    title: Accept only tokens intended for this service
    statement:
        Check that each token names this service as its audience, for JWTs
        by matching the aud claim against an allowlist.
    rationale:
        A token issued for another service could otherwise be replayed here.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, tokens, audience]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x18-V9-Self-contained-Tokens.md#v92-token-content
