use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x4x14:
    standard: @{OwaspAsvs}
    ruleId: V10.4.14
    title: Issue only sender-constrained access tokens
    statement:
        Have the authorization server issue only proof-of-possession access
        tokens, bound with mutual TLS or DPoP.
    rationale:
        Bound tokens cannot be replayed by a party that steals them.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, oauth, sender-constrained]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v104-oauth-authorization-server
