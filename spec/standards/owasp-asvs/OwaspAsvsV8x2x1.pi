use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV8x2x1:
    standard: @{OwaspAsvs}
    ruleId: V8.2.1
    title: Restrict functions to consumers with explicit permission
    statement:
        Allow each function to be used only by consumers explicitly granted
        that permission.
    rationale:
        Default-allow function access is how ordinary users reach
        administrative features.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, authorization, access-control]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x17-V8-Authorization.md#v82-general-authorization-design
