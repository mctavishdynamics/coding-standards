use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV7x2x4:
    standard: @{OwaspAsvs}
    ruleId: V7.2.4
    title: Issue a new session token at every authentication
    statement:
        Create a fresh session token whenever a user authenticates or
        re-authenticates, and end the previous one.
    rationale:
        Keeping the pre-login token allows session fixation, where an
        attacker plants a token and waits for the victim to log in with it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, session, session-fixation]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x16-V7-Session-Management.md#v72-fundamental-session-management-security
