use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV2x2x2:
    standard: @{OwaspAsvs}
    ruleId: V2.2.2
    title: Validate input on the trusted server side
    statement:
        Do the validation that matters for security in a trusted server-side
        layer. Client-side checks are welcome for usability but are never
        the control.
    rationale:
        Code that runs on the client is under the attacker's control and can
        be skipped entirely.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, input-validation, trust-boundary]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x11-V2-Validation-and-Business-Logic.md#v22-input-validation
