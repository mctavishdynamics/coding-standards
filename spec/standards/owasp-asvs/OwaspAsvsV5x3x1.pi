use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV5x3x1:
    standard: @{OwaspAsvs}
    ruleId: V5.3.1
    title: Never execute uploaded files stored in public folders
    statement:
        Make sure files that come from or are generated from untrusted input
        and live in a public directory are served as data and never run as
        server-side code when requested.
    rationale:
        An uploaded script that the server executes gives the attacker
        remote code execution.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, file-storage, code-execution]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x14-V5-File-Handling.md#v53-file-storage
