use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV16x3x4:
    standard: @{OwaspAsvs}
    ruleId: V16.3.4
    title: Log unexpected errors and security control failures
    statement:
        Record unexpected errors and failures of security controls, such as
        failed TLS connections to backends.
    rationale:
        These failures can mean an attack in progress or a control silently
        not working.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, logging, errors]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x25-V16-Security-Logging-and-Error-Handling.md#v163-security-events
