use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV16x5x2:
    standard: @{OwaspAsvs}
    ruleId: V16.5.2
    title: Stay secure when external resources fail
    statement:
        Keep operating securely when access to external resources fails, for
        example with circuit breakers or graceful degradation.
    rationale:
        Failures of dependencies should not turn into security failures or
        cascading outages.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, error-handling, resilience]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x25-V16-Security-Logging-and-Error-Handling.md#v165-error-handling
