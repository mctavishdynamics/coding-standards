use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x2x9:
    standard: @{OwaspAsvs}
    ruleId: V6.2.9
    title: Allow passwords of at least 64 characters
    statement:
        Accept passwords up to at least 64 characters long.
    rationale:
        Long passphrases are strong and easy to remember, and a low maximum
        rules them out.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, passwords]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v62-password-security
