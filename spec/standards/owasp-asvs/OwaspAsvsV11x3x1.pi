use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV11x3x1:
    standard: @{OwaspAsvs}
    ruleId: V11.3.1
    title: Avoid insecure block modes and weak padding
    statement:
        Do not use insecure modes such as ECB or weak padding schemes such
        as PKCS#1 v1.5.
    rationale:
        ECB reveals patterns in the plaintext, and weak padding enables
        oracle attacks.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, cryptography, encryption]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x20-V11-Cryptography.md#v113-encryption-algorithms
