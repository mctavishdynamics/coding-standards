use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV8x1x1:
    standard: @{OwaspAsvs}
    ruleId: V8.1.1
    title: Document function-level and data-level access rules
    statement:
        Define in the documentation which consumers may use each function
        and each piece of data, based on their permissions and resource
        attributes.
    rationale:
        Written rules let developers and testers apply and check access
        decisions consistently.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, documentation, authorization]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x17-V8-Authorization.md#v81-authorization-documentation
