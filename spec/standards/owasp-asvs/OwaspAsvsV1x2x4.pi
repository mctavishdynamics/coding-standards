use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV1x2x4:
    standard: @{OwaspAsvs}
    ruleId: V1.2.4
    title: Use parameterized queries for every database query
    statement:
        Build SQL, HQL, NoSQL, Cypher and similar queries with bound
        parameters, an ORM or an entity framework, or protect them in an
        equivalent way. Stored procedures need the same care. Identifiers
        such as table names or sort columns cannot be escaped and need an
        allowlist.
    rationale:
        Concatenating untrusted data into a query lets the data be read as
        query syntax, which is the classic path to database injection.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        cursor.execute(
            "SELECT id, total FROM orders WHERE customer = '" + customer + "'"
        )
        \\\
        ```
    compliant:
        ```python
        \\\
        cursor.execute(
            "SELECT id, total FROM orders WHERE customer = %s",
            (customer,),
        )
        \\\
        ```
    languages: [any]
    tags: [level-1, injection, sql, database]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x10-V1-Encoding-and-Sanitization.md#v12-injection-prevention
