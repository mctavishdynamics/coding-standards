use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV3x4x8:
    standard: @{OwaspAsvs}
    ruleId: V3.4.8
    title: Send Cross-Origin-Opener-Policy on document responses
    statement:
        Add Cross-Origin-Opener-Policy with same-origin, or
        same-origin-allow-popups when needed, to every response that renders
        a document.
    rationale:
        Isolating the browsing context stops other windows from abusing a
        shared window reference for tabnabbing or frame counting.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, headers, browser-isolation]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x12-V3-Web-Frontend-Security.md#v34-browser-security-mechanism-headers
