use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV3x4x4:
    standard: @{OwaspAsvs}
    ruleId: V3.4.4
    title: Send X-Content-Type-Options nosniff on every response
    statement:
        Add X-Content-Type-Options set to nosniff on all responses so the
        browser trusts the declared Content-Type instead of guessing.
    rationale:
        Content sniffing can turn an uploaded or mislabeled file into script
        or a stylesheet, and the header also enables cross-origin read
        blocking.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, headers, content-type]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x12-V3-Web-Frontend-Security.md#v34-browser-security-mechanism-headers
