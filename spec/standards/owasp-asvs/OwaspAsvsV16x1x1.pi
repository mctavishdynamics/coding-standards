use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV16x1x1:
    standard: @{OwaspAsvs}
    ruleId: V16.1.1
    title: Keep an inventory of logging across the stack
    statement:
        Document for each layer of the technology stack what is logged, in
        what format, where it is stored, how it is used, who may access it
        and how long it is kept.
    rationale:
        A complete picture of logging is needed for effective monitoring,
        incident response and compliance.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, logging, documentation]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x25-V16-Security-Logging-and-Error-Handling.md#v161-security-logging-documentation
