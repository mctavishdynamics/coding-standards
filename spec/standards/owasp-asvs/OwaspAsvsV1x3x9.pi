use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV1x3x9:
    standard: @{OwaspAsvs}
    ruleId: V1.3.9
    title: Sanitize data sent to memcache
    statement:
        Clean values and keys before sending them to memcache.
    rationale:
        Control characters such as line breaks inside a value can inject
        extra cache commands into the text protocol.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, injection, memcache]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x10-V1-Encoding-and-Sanitization.md#v13-sanitization
