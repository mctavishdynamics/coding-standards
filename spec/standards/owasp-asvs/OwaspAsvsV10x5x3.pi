use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x5x3:
    standard: @{OwaspAsvs}
    ruleId: V10.5.3
    title: Reject authorization server metadata with the wrong issuer
    statement:
        Refuse authorization server metadata whose issuer URL does not
        exactly match the issuer URL configured in the client.
    rationale:
        A malicious server could otherwise impersonate another one through
        crafted metadata.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, oidc, metadata, issuer]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v105-oidc-client
