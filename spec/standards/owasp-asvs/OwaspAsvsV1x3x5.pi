use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV1x3x5:
    standard: @{OwaspAsvs}
    ruleId: V1.3.5
    title: Sanitize or disable user-supplied scriptable markup
    statement:
        Content that users supply in rich formats, for example Markdown,
        BBCode, CSS or XSL, must be sanitized or not processed at all.
    rationale:
        These formats can embed links, scripts or expressions that carry
        attacks past filters aimed only at plain HTML.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, sanitization, templates]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x10-V1-Encoding-and-Sanitization.md#v13-sanitization
