use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x4x4:
    standard: @{OwaspAsvs}
    ruleId: V6.4.4
    title: Re-prove identity when an MFA factor is lost
    statement:
        When a user loses a multi-factor authenticator, confirm their
        identity with the same level of proofing used at enrollment.
    rationale:
        Weaker recovery than enrollment lets attackers replace a victim's
        factor with their own.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, recovery, identity-proofing]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v64-authentication-factor-lifecycle-and-recovery
