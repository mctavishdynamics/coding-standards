use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV12x3x3:
    standard: @{OwaspAsvs}
    ruleId: V12.3.3
    title: Encrypt traffic between internal HTTP services
    statement:
        Use TLS or another suitable transport encryption between internal
        HTTP-based services, with no fallback to plain text.
    rationale:
        Attackers who gain a foothold inside the network can otherwise read
        internal traffic.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, tls, internal]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x21-V12-Secure-Communication.md#v123-general-service-to-service-communication-security
