use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x7x2:
    standard: @{OwaspAsvs}
    ruleId: V6.7.2
    title: Use challenge nonces of at least 64 bits that do not repeat
    statement:
        Make challenge nonces at least 64 bits long and unique,
        statistically or over the lifetime of the device.
    rationale:
        Short or repeated challenges allow responses to be predicted or
        replayed.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, cryptographic-authentication, nonce]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v67-cryptographic-authentication-mechanism
