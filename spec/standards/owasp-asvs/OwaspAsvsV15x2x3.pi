use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV15x2x3:
    standard: @{OwaspAsvs}
    ruleId: V15.2.3
    title: Ship only required functionality to production
    statement:
        Exclude test code, sample snippets and development features from the
        production environment.
    rationale:
        Extra functionality adds attack surface and often lacks the security
        controls of production code.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, deployment, attack-surface]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x24-V15-Secure-Coding-and-Architecture.md#v152-security-architecture-and-dependencies
