use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV15x1x3:
    standard: @{OwaspAsvs}
    ruleId: V15.1.3
    title: Document resource-heavy functionality and how it is protected
    statement:
        Identify functions that are slow or resource-hungry, and document
        how to keep their overuse from hurting availability and how to keep
        responses within the consumer's timeout, for example with
        asynchronous work, queues and per-user or global concurrency limits.
    rationale:
        Expensive features are a natural target for denial of service and
        need planned defenses.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, documentation, availability, performance]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x24-V15-Secure-Coding-and-Architecture.md#v151-secure-coding-and-architecture-documentation
