use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV17x2x3:
    standard: @{OwaspAsvs}
    ruleId: V17.2.3
    title: Check SRTP authentication at the media server
    statement:
        Verify SRTP authentication on the media server to block injected RTP
        packets.
    rationale:
        Unauthenticated packets can disrupt the service or insert audio and
        video into a stream.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, webrtc, srtp, authentication]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x26-V17-WebRTC.md#v172-media
