use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x3x1:
    standard: @{OwaspAsvs}
    ruleId: V10.3.1
    title: Accept only access tokens meant for this resource server
    statement:
        Have the resource server check the audience of each access token,
        through the aud claim or token introspection, and reject tokens for
        other services.
    rationale:
        A token issued for another API could otherwise be replayed against
        this one.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, oauth, audience, resource-server]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v103-oauth-resource-server
