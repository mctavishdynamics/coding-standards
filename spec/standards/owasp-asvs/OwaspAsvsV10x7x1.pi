use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x7x1:
    standard: @{OwaspAsvs}
    ruleId: V10.7.1
    title: Obtain user consent for each authorization request
    statement:
        Make sure the user consents to every authorization request, and
        always prompt explicitly when the client's identity cannot be
        assured.
    rationale:
        Without consent checks, attackers can gain permissions in the user's
        name through spoofing or social engineering.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, oauth, consent]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v107-consent-management
