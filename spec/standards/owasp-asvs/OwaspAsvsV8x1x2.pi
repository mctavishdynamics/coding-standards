use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV8x1x2:
    standard: @{OwaspAsvs}
    ruleId: V8.1.2
    title: Document field-level read and write access rules
    statement:
        Define which consumers may read or write each field, based on
        permissions and resource attributes, which may include the object's
        state.
    rationale:
        Field rules are easy to overlook, and objects often mix public and
        restricted properties.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, documentation, authorization]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x17-V8-Authorization.md#v81-authorization-documentation
