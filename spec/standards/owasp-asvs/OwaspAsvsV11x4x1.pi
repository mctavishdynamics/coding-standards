use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV11x4x1:
    standard: @{OwaspAsvs}
    ruleId: V11.4.1
    title: Use only approved hash functions for cryptography
    statement:
        Use approved hash functions for signatures, HMAC, key derivation and
        random bit generation, and never use disallowed ones such as MD5 for
        any cryptographic purpose.
    rationale:
        Weak or broken hash functions undermine every construction built on
        them, letting attackers produce collisions and forge data.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, cryptography, hashing]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x20-V11-Cryptography.md#v114-hashing-and-hash-based-functions
