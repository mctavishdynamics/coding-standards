use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV3x2x1:
    standard: @{OwaspAsvs}
    ruleId: V3.2.1
    title: Stop browsers rendering responses in the wrong context
    statement:
        Prevent responses such as API output or uploaded files from being
        rendered as pages when requested directly. Options include checking
        Sec-Fetch request headers, a CSP sandbox directive or serving the
        content as an attachment.
    rationale:
        Content rendered in a context it was not meant for can execute
        attacker-controlled script or display misleading material.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, browser-security, content-type]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x12-V3-Web-Frontend-Security.md#v32-unintended-content-interpretation
