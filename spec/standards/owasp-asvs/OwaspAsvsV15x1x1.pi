use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV15x1x1:
    standard: @{OwaspAsvs}
    ruleId: V15.1.1
    title: Document remediation deadlines for third-party components
    statement:
        Set risk-based deadlines in the documentation for fixing vulnerable
        third-party component versions and for updating libraries in
        general.
    rationale:
        Agreed time frames turn dependency updates from an afterthought into
        a tracked obligation.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, dependencies, patching, documentation]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x24-V15-Secure-Coding-and-Architecture.md#v151-secure-coding-and-architecture-documentation
