use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x4x11:
    standard: @{OwaspAsvs}
    ruleId: V10.4.11
    title: Assign clients only the scopes they require
    statement:
        Configure the authorization server to grant each client only the
        scopes it needs.
    rationale:
        Excess scopes turn any compromise of the client into wider access.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, oauth, least-privilege, scopes]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v104-oauth-authorization-server
