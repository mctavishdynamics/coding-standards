use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV13x1x1:
    standard: @{OwaspAsvs}
    ruleId: V13.1.1
    title: Document all of the application's communication needs
    statement:
        List every connection the application needs, including the external
        services it depends on and any case where a user can supply a
        location the application will connect to.
    rationale:
        Unknown connections cannot be secured, and user-chosen destinations
        are a common source of SSRF.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, documentation, configuration, network]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x22-V13-Configuration.md#v131-configuration-documentation
