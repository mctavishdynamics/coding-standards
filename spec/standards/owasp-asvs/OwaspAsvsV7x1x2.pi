use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV7x1x2:
    standard: @{OwaspAsvs}
    ruleId: V7.1.2
    title: Document the limit on concurrent sessions per account
    statement:
        State how many parallel sessions one account may hold and what
        happens when that limit is reached.
    rationale:
        A defined limit and response makes shared or stolen sessions easier
        to spot and control.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, documentation, session]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x16-V7-Session-Management.md#v71-session-management-documentation
