use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV7x2x1:
    standard: @{OwaspAsvs}
    ruleId: V7.2.1
    title: Verify session tokens in a trusted backend
    statement:
        Perform every session token check in a trusted backend service.
    rationale:
        Checks done on the client can be bypassed by anyone who controls the
        client.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, session, trust-boundary]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x16-V7-Session-Management.md#v72-fundamental-session-management-security
