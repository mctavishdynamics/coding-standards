use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV4x1x5:
    standard: @{OwaspAsvs}
    ruleId: V4.1.5
    title: Sign highly sensitive messages individually
    statement:
        Add per-message digital signatures to requests or transactions that
        are highly sensitive or pass through several systems, on top of
        transport security.
    rationale:
        Transport encryption ends at each hop, while a message signature
        keeps integrity and origin provable from end to end.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, signatures, integrity, api]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x13-V4-API-and-Web-Service.md#v41-generic-web-service-security
