use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV7x4x4:
    standard: @{OwaspAsvs}
    ruleId: V7.4.4
    title: Make logout easy to find on every authenticated page
    statement:
        Give every page that needs authentication a visible and easy way to
        log out.
    rationale:
        Users who cannot find logout leave sessions open, especially on
        shared devices.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, session, logout, user-interface]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x16-V7-Session-Management.md#v74-session-termination
