use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV1x2x3:
    standard: @{OwaspAsvs}
    ruleId: V1.2.3
    title: Encode untrusted data placed into JavaScript or JSON
    statement:
        Escape or encode any value that is inserted into generated
        JavaScript or JSON so it remains a data value and cannot change the
        code or the document structure.
    rationale:
        Without encoding, a quote or bracket in the value ends the literal
        and lets the attacker write code or reshape the JSON.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, injection, javascript, json]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x10-V1-Encoding-and-Sanitization.md#v12-injection-prevention
