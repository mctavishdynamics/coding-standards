use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV7x6x2:
    standard: @{OwaspAsvs}
    ruleId: V7.6.2
    title: Create sessions only with user consent or action
    statement:
        Require user consent or an explicit action before creating a new
        application session.
    rationale:
        Silent session creation through federation can log users into
        applications, possibly attacker-chosen ones, without their
        knowledge.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, federation, session, consent]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x16-V7-Session-Management.md#v76-federated-re-authentication
