use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV3x3x5:
    standard: @{OwaspAsvs}
    ruleId: V3.3.5
    title: Keep each cookie within 4096 bytes
    statement:
        Make sure the name and value of every cookie the application sets
        add up to no more than 4096 bytes.
    rationale:
        Browsers drop oversized cookies, which silently breaks any feature
        that depends on them.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, cookies, availability]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x12-V3-Web-Frontend-Security.md#v33-cookie-setup
