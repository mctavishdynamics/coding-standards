use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV5x1x1:
    standard: @{OwaspAsvs}
    ruleId: V5.1.1
    title: Document accepted file types, sizes and handling for uploads
    statement:
        For each upload feature, document the allowed file types and
        extensions, the maximum size including unpacked size, and how files
        are made safe for download, including what happens when a malicious
        file is found.
    rationale:
        Security checks on files can only be built and tested against clear,
        written expectations.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, documentation, file-upload]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x14-V5-File-Handling.md#v51-file-handling-documentation
