use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x4x1:
    standard: @{OwaspAsvs}
    ruleId: V10.4.1
    title: Match redirect URIs exactly against registered values
    statement:
        Check redirect URIs against a per-client allowlist of preregistered
        values using exact string comparison.
    rationale:
        Loose matching lets attackers redirect authorization codes or tokens
        to a URL they control.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, oauth, redirect-uri]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v104-oauth-authorization-server
