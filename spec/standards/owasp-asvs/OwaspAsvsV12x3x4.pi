use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV12x3x4:
    standard: @{OwaspAsvs}
    ruleId: V12.3.4
    title: Use trusted certificates between internal services
    statement:
        Use trusted certificates for internal TLS. When internal or
        self-signed certificates are used, configure consumers to trust only
        the specific internal CAs and certificates involved.
    rationale:
        Trusting any certificate internally allows interception by anyone
        who can mint one.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, tls, certificates, internal]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x21-V12-Secure-Communication.md#v123-general-service-to-service-communication-security
