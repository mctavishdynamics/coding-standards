use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x2x11:
    standard: @{OwaspAsvs}
    ruleId: V6.2.11
    title: Block passwords made from context-specific words
    statement:
        Reject passwords that are easy to guess because they contain words
        from the application's documented list of terms tied to its context.
    rationale:
        Organization-specific words are obvious guesses for an attacker
        targeting that organization.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, passwords, password-policy]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v62-password-security
