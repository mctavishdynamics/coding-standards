use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV5x3x3:
    standard: @{OwaspAsvs}
    ruleId: V5.3.3
    title: Ignore user-supplied paths when processing files
    statement:
        When decompressing or otherwise processing files on the server,
        ignore path information supplied inside the file or by the user.
    rationale:
        Archive entries with paths such as ../ can write outside the target
        folder, the zip slip flaw.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, archives, path-traversal]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x14-V5-File-Handling.md#v53-file-storage
