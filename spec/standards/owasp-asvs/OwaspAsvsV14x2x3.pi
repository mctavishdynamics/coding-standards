use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV14x2x3:
    standard: @{OwaspAsvs}
    ruleId: V14.2.3
    title: Do not send sensitive data to untrusted parties
    statement:
        Keep defined sensitive data away from untrusted parties such as user
        tracking services.
    rationale:
        Data sent to third parties is collected and kept outside the
        application's control.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, sensitive-data, privacy, third-parties]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x23-V14-Data-Protection.md#v142-general-data-protection
