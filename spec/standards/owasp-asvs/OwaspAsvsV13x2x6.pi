use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV13x2x6:
    standard: @{OwaspAsvs}
    ruleId: V13.2.6
    title: Follow the documented settings for each service connection
    statement:
        Configure each connection to other services as documented, including
        parallel connection limits, behavior at the limit, timeouts and
        retry strategy.
    rationale:
        Documentation only protects availability when the configuration
        actually matches it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, configuration, connections, resilience]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x22-V13-Configuration.md#v132-backend-communication-configuration
