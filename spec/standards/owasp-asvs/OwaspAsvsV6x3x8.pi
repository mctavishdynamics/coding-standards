use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x3x8:
    standard: @{OwaspAsvs}
    ruleId: V6.3.8
    title: Prevent user enumeration through authentication responses
    statement:
        Make failed login, registration and forgotten password responses
        look the same whether or not the account exists, in messages, status
        codes and timing.
    rationale:
        Distinguishable responses let attackers build lists of valid
        accounts to target.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, enumeration, information-disclosure]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v63-general-authentication-security
