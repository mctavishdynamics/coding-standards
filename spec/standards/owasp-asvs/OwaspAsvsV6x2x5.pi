use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x2x5:
    standard: @{OwaspAsvs}
    ruleId: V6.2.5
    title: Allow any characters in passwords without composition rules
    statement:
        Accept passwords made of any characters, and do not require minimum
        counts of upper or lower case letters, digits or symbols.
    rationale:
        Composition rules make passwords harder to remember without making
        them much harder to guess, and push users toward predictable
        patterns.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, passwords, password-policy]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v62-password-security
