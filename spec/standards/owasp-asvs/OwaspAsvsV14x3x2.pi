use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV14x3x2:
    standard: @{OwaspAsvs}
    ruleId: V14.3.2
    title: Send anti-caching headers for sensitive responses
    statement:
        Send headers that stop browsers from caching sensitive data, such as
        Cache-Control with the no-store directive.
    rationale:
        Cached pages remain on disk and can be viewed later by others using
        the same device.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, caching, headers, client-side]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x23-V14-Data-Protection.md#v143-client-side-data-protection
