use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x6x3:
    standard: @{OwaspAsvs}
    ruleId: V6.6.3
    title: Rate limit out-of-band code verification
    statement:
        Limit the rate of attempts on code-based out-of-band authentication
        so codes cannot be guessed, and think about issuing codes that carry
        64 or more bits of entropy.
    rationale:
        Short codes fall quickly to automated guessing if attempts are
        unlimited.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, mfa, brute-force]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v66-out-of-band-authentication-mechanisms
