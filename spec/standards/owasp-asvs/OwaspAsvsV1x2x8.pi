use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV1x2x8:
    standard: @{OwaspAsvs}
    ruleId: V1.2.8
    title: Run LaTeX processors locked down with an allowlist of commands
    statement:
        Configure any LaTeX engine so that it cannot execute shell commands,
        for example by never passing the shell escape option, and limit
        documents to an allowlist of permitted commands.
    rationale:
        LaTeX can read files and run programs, so untrusted markup handed to
        a permissive engine becomes code execution on the server.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, injection, latex]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x10-V1-Encoding-and-Sanitization.md#v12-injection-prevention
