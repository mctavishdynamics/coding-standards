use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV15x3x4:
    standard: @{OwaspAsvs}
    ruleId: V15.3.4
    title: Pass the client IP through proxies in a trusted way
    statement:
        Have proxies and middleware forward the user's original IP address
        in fields the user cannot tamper with, and use that value for
        logging and decisions such as rate limiting, remembering that even
        the true IP can be unreliable.
    rationale:
        Spoofable client addresses let attackers evade rate limits and
        corrupt audit logs.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, proxies, ip-address, logging]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x24-V15-Secure-Coding-and-Architecture.md#v153-defensive-coding
