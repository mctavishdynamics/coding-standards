use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x4x3:
    standard: @{OwaspAsvs}
    ruleId: V6.4.3
    title: Provide a secure password reset that keeps MFA in force
    statement:
        Implement a safe forgotten-password process that never bypasses
        multi-factor authentication the user has enabled.
    rationale:
        A reset flow that skips MFA becomes the easiest way to take over a
        protected account.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, recovery, mfa]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v64-authentication-factor-lifecycle-and-recovery
