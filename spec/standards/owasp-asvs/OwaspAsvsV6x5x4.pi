use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x5x4:
    standard: @{OwaspAsvs}
    ruleId: V6.5.4
    title: Give lookup secrets and out-of-band codes at least 20 bits of entropy
    statement:
        Lookup secrets and out-of-band codes must carry at least twenty bits
        of randomness, which a random six-digit number or four random
        letters and digits provide.
    rationale:
        Shorter codes can be guessed within the attempts that rate limits
        allow.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, mfa, entropy]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v65-general-multi-factor-authentication-requirements
