use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x3x6:
    standard: @{OwaspAsvs}
    ruleId: V6.3.6
    title: Do not use email as an authentication factor
    statement:
        Do not accept email as an authentication factor, whether alone or as
        part of MFA.
    rationale:
        Email is not considered an acceptable authenticator by NIST because
        accounts and messages are too easily compromised or intercepted.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, email, mfa]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v63-general-authentication-security
