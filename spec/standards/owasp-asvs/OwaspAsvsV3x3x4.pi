use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV3x3x4:
    standard: @{OwaspAsvs}
    ruleId: V3.3.4
    title: Set HttpOnly on cookies scripts should not read
    statement:
        Mark cookies that client script does not need, such as session
        tokens, as HttpOnly, and send those values to the browser only
        through the Set-Cookie header.
    rationale:
        Keeping the value away from script means a cross-site scripting flaw
        cannot simply read and steal it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, cookies, session]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x12-V3-Web-Frontend-Security.md#v33-cookie-setup
