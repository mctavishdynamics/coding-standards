use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x4x8:
    standard: @{OwaspAsvs}
    ruleId: V10.4.8
    title: Give refresh tokens an absolute expiry
    statement:
        Set an absolute expiration on refresh tokens, even when sliding
        expiration is used.
    rationale:
        Sliding expiry alone lets a stolen refresh token live forever as
        long as it keeps being used.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, oauth, refresh-token, expiry]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v104-oauth-authorization-server
