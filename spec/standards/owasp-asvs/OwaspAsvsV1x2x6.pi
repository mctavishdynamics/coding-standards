use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV1x2x6:
    standard: @{OwaspAsvs}
    ruleId: V1.2.6
    title: Prevent LDAP injection
    statement:
        Protect LDAP queries built from untrusted data, using escaping for
        LDAP filters and distinguished names or another control designed for
        the purpose.
    rationale:
        Characters such as parentheses and asterisks change the meaning of
        an LDAP filter and can widen a search or bypass a login check.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, injection, ldap]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x10-V1-Encoding-and-Sanitization.md#v12-injection-prevention
