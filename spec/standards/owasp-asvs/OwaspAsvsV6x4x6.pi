use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x4x6:
    standard: @{OwaspAsvs}
    ruleId: V6.4.6
    title: Let administrators start resets without setting passwords
    statement:
        Allow administrators to trigger a password reset for a user, but not
        to set or choose the new password.
    rationale:
        If an administrator chooses the password, they know it, which breaks
        accountability for the account.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, recovery, administration]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v64-authentication-factor-lifecycle-and-recovery
