use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV1x3x11:
    standard: @{OwaspAsvs}
    ruleId: V1.3.11
    title: Sanitize user input sent to mail systems
    statement:
        Clean user-supplied values, especially header values, before passing
        them to SMTP or IMAP.
    rationale:
        Line breaks in a header value let an attacker add recipients or
        inject whole commands into the mail protocol.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, injection, email]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x10-V1-Encoding-and-Sanitization.md#v13-sanitization
