use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV3x4x2:
    standard: @{OwaspAsvs}
    ruleId: V3.4.2
    title: Restrict the CORS allowed origin
    statement:
        Set Access-Control-Allow-Origin to a fixed value, or echo the
        request Origin only when it is on an allowlist. Use the wildcard
        only for responses that hold nothing sensitive.
    rationale:
        Reflecting any origin lets every website read responses using the
        victim's browser and credentials.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, headers, cors]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x12-V3-Web-Frontend-Security.md#v34-browser-security-mechanism-headers
