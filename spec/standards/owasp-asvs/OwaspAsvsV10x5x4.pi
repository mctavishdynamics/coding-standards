use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x5x4:
    standard: @{OwaspAsvs}
    ruleId: V10.5.4
    title: Check that the ID token audience is this client
    statement:
        Confirm that the aud claim of each ID token equals the client's own
        client_id.
    rationale:
        An ID token issued to another client should not log users in here.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, oidc, audience, id-token]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v105-oidc-client
