use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV13x4x6:
    standard: @{OwaspAsvs}
    ruleId: V13.4.6
    title: Hide detailed version information of backend components
    statement:
        Do not reveal detailed version numbers of backend components.
    rationale:
        Version details let attackers quickly match known vulnerabilities,
        even though hiding them never replaces patching.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, information-disclosure, versions]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x22-V13-Configuration.md#v134-unintended-information-leakage
