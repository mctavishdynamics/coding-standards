use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV15x1x5:
    standard: @{OwaspAsvs}
    ruleId: V15.1.5
    title: Flag where dangerous functionality is used
    statement:
        Point out in the documentation the parts of the application that
        perform dangerous operations, such as deserializing untrusted data,
        parsing raw files, running dynamic code or manipulating memory
        directly.
    rationale:
        A defect in one of these operations can expose both the application
        and the systems beneath it, so they warrant closer review.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, documentation, dangerous-functionality]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x24-V15-Secure-Coding-and-Architecture.md#v151-secure-coding-and-architecture-documentation
