use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV17x2x8:
    standard: @{OwaspAsvs}
    ruleId: V17.2.8
    title: Match the DTLS certificate to the SDP fingerprint
    statement:
        Compare the DTLS certificate with the fingerprint in the session
        description and end the media stream if they differ.
    rationale:
        The fingerprint check is what proves the stream comes from the
        expected peer and not an interceptor.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, webrtc, dtls, authenticity]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x26-V17-WebRTC.md#v172-media
