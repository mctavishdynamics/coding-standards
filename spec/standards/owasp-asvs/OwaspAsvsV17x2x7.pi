use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV17x2x7:
    standard: @{OwaspAsvs}
    ruleId: V17.2.7
    title: Keep recording running during SRTP floods
    statement:
        Make sure recording mechanisms tied to the media server keep working
        through floods of SRTP packets from legitimate users.
    rationale:
        Recordings that fail under load lose data that may be needed later.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, webrtc, recording, denial-of-service]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x26-V17-WebRTC.md#v172-media
