use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV14x2x2:
    standard: @{OwaspAsvs}
    ruleId: V14.2.2
    title: Prevent server-side caching of sensitive data
    statement:
        Stop load balancers, application caches and other server components
        from caching sensitive data, or purge it securely after use.
    rationale:
        Cached sensitive data can be served to the wrong user or read by
        anyone with access to the cache.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, sensitive-data, caching]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x23-V14-Data-Protection.md#v142-general-data-protection
