use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV3x4x6:
    standard: @{OwaspAsvs}
    ruleId: V3.4.6
    title: Control framing with CSP frame-ancestors
    statement:
        Use the frame-ancestors directive on every response so pages cannot
        be embedded by default and only chosen resources allow framing. Do
        not rely on the obsolete X-Frame-Options header.
    rationale:
        Pages that can be framed by any site are open to clickjacking and
        other user interface redress attacks.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, headers, clickjacking, csp]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x12-V3-Web-Frontend-Security.md#v34-browser-security-mechanism-headers
