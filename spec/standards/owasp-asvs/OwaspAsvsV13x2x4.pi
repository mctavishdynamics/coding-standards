use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV13x2x4:
    standard: @{OwaspAsvs}
    ruleId: V13.2.4
    title: Allowlist the external systems the application may contact
    statement:
        Define an allowlist of external resources the application may reach
        when it sends requests, loads data or opens files, enforced at the
        application, web server, firewall or several layers.
    rationale:
        An allowlist confines what an attacker can reach through the
        application, limiting SSRF and data exfiltration.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, allowlist, network, ssrf]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x22-V13-Configuration.md#v132-backend-communication-configuration
