use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV13x1x2:
    standard: @{OwaspAsvs}
    ruleId: V13.1.2
    title: Document connection limits and behavior at the limit
    statement:
        For each service used, record the maximum concurrent connections,
        such as pool sizes, and what the application does and how it
        recovers when the limit is hit.
    rationale:
        Planned limits and fallbacks keep a busy dependency from turning
        into a denial of service.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, documentation, availability, connections]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x22-V13-Configuration.md#v131-configuration-documentation
