use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV15x4x1:
    standard: @{OwaspAsvs}
    ruleId: V15.4.1
    title: Access shared objects in a thread-safe way
    statement:
        Protect caches, files and in-memory objects shared by threads with
        thread-safe types and synchronization such as locks or semaphores.
    rationale:
        Unsynchronized access causes race conditions and data corruption
        that attackers can sometimes provoke.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, concurrency, thread-safety]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x24-V15-Secure-Coding-and-Architecture.md#v154-safe-concurrency
