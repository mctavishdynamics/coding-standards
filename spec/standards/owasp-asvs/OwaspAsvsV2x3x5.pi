use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV2x3x5:
    standard: @{OwaspAsvs}
    ruleId: V2.3.5
    title: Require multi-user approval for high-value flows
    statement:
        Require approval from more than one person for high-value actions,
        such as large payments, contract approvals, access to classified
        data or safety overrides.
    rationale:
        A second approver stops a single compromised or careless account
        from causing serious harm.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, business-logic, approval]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x11-V2-Validation-and-Business-Logic.md#v23-business-logic-security
