use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV12x1x2:
    standard: @{OwaspAsvs}
    ruleId: V12.1.2
    title: Enable only recommended cipher suites
    statement:
        Turn on only recommended cipher suites with the strongest preferred,
        and at level 3 allow only suites with forward secrecy.
    rationale:
        Weak suites can be broken, and without forward secrecy one stolen
        key decrypts all recorded traffic.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, tls, cipher-suites]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x21-V12-Secure-Communication.md#v121-general-tls-security-guidance
