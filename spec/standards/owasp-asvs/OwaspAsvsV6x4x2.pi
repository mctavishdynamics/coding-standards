use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x4x2:
    standard: @{OwaspAsvs}
    ruleId: V6.4.2
    title: Do not use password hints or secret questions
    statement:
        Do not offer password hints or knowledge-based questions.
    rationale:
        The answers are often public or easily guessed, so they weaken the
        account rather than protect it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, credentials, recovery]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v64-authentication-factor-lifecycle-and-recovery
