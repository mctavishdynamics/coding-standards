use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV13x4x2:
    standard: @{OwaspAsvs}
    ruleId: V13.4.2
    title: Disable debug modes in production
    statement:
        Turn off debug modes of every component in production.
    rationale:
        Debug features expose internal details and sometimes allow code
        execution.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, debug, information-disclosure]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x22-V13-Configuration.md#v134-unintended-information-leakage
