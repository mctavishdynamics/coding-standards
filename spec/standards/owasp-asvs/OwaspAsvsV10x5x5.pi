use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x5x5:
    standard: @{OwaspAsvs}
    ruleId: V10.5.5
    title: Validate OIDC back-channel logout tokens
    statement:
        For back-channel logout, check that the logout token has the type
        logout+jwt, carries the event claim with the correct member, and has
        no nonce claim. A short expiry, such as two minutes, is advised.
    rationale:
        Loose checks allow forced logouts as a denial of service and let
        other JWTs be confused with logout tokens.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, oidc, logout]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v105-oidc-client
