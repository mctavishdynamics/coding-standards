use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x3x4:
    standard: @{OwaspAsvs}
    ruleId: V6.3.4
    title: Enforce the same strength on every authentication path
    statement:
        Make sure no undocumented way to authenticate exists, and that all
        pathways apply the same controls and strength.
    rationale:
        A forgotten or weaker login path, such as a legacy API, undoes the
        protection of the main one.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, authentication, consistency]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v63-general-authentication-security
