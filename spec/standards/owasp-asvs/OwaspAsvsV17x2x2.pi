use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV17x2x2:
    standard: @{OwaspAsvs}
    ruleId: V17.2.2
    title: Use approved DTLS cipher suites and a secure SRTP profile
    statement:
        Set up the media server to use approved DTLS ciphers and a safe
        DTLS-SRTP protection profile when keys are negotiated.
    rationale:
        Weak suites or profiles undermine the encryption protecting media
        streams.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, webrtc, dtls, srtp]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x26-V17-WebRTC.md#v172-media
