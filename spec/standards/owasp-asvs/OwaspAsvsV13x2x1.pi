use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV13x2x1:
    standard: @{OwaspAsvs}
    ruleId: V13.2.1
    title: Authenticate backend component communication without static secrets
    statement:
        Authenticate calls between backend components that do not use the
        user session, such as APIs, middleware and data layers, using
        individual service accounts, short-lived tokens or certificates
        rather than fixed passwords, API keys or shared privileged accounts.
    rationale:
        Static, shared credentials are hard to rotate and give broad access
        to anyone who obtains them.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, authentication, service-accounts, backend]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x22-V13-Configuration.md#v132-backend-communication-configuration
