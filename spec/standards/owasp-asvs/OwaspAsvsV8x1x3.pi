use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV8x1x3:
    standard: @{OwaspAsvs}
    ruleId: V8.1.3
    title: Document the contextual attributes used in security decisions
    statement:
        Document which attributes of the environment and context, for
        example the time, location, IP address or device, are used when
        deciding on authentication and authorization.
    rationale:
        Contextual decisions can only be reviewed and tested once their
        inputs are known.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, documentation, adaptive-security]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x17-V8-Authorization.md#v81-authorization-documentation
