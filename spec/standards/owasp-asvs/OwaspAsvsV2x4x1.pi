use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV2x4x1:
    standard: @{OwaspAsvs}
    ruleId: V2.4.1
    title: Limit excessive automated calls to application functions
    statement:
        Add anti-automation controls so that functions cannot be called
        often enough to exfiltrate data, create junk data, exhaust quotas,
        deny service or burn costly resources.
    rationale:
        Automated abuse turns ordinary features into tools for scraping,
        flooding and running up costs.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, anti-automation, rate-limiting]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x11-V2-Validation-and-Business-Logic.md#v24-anti-automation
