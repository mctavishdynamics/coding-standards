use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV12x1x4:
    standard: @{OwaspAsvs}
    ruleId: V12.1.4
    title: Enable certificate revocation checking
    statement:
        Enable and configure revocation checking, for example with OCSP
        stapling.
    rationale:
        Without it, revoked certificates, perhaps with stolen keys, keep
        being accepted.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, tls, certificates, revocation]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x21-V12-Secure-Communication.md#v121-general-tls-security-guidance
