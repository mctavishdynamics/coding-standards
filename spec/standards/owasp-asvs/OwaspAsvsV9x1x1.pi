use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV9x1x1:
    standard: @{OwaspAsvs}
    ruleId: V9.1.1
    title: Validate token signatures before trusting their contents
    statement:
        Check the digital signature or MAC of a self-contained token before
        using any of its data.
    rationale:
        An unchecked token can be edited by anyone to claim any identity or
        permission.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, tokens, jwt, integrity]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x18-V9-Self-contained-Tokens.md#v91-token-source-and-integrity
