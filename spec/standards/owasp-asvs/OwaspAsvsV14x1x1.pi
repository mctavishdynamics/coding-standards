use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV14x1x1:
    standard: @{OwaspAsvs}
    ruleId: V14.1.1
    title: Identify and classify all sensitive data
    statement:
        Find all sensitive data the application creates and handles and
        assign each kind a protection level, including data that is only
        encoded, such as Base64 strings or JWT payloads, and taking
        applicable privacy regulations into account.
    rationale:
        Data cannot be protected appropriately until it is known which data
        is sensitive and how sensitive it is.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, data-classification, documentation]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x23-V14-Data-Protection.md#v141-data-protection-documentation
