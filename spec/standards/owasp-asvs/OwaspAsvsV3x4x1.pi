use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV3x4x1:
    standard: @{OwaspAsvs}
    ruleId: V3.4.1
    title: Send an HSTS header on every response
    statement:
        Include Strict-Transport-Security on all responses with a max-age of
        at least a year, and from level 2 cover all subdomains too.
    rationale:
        HSTS tells the browser to use only HTTPS for the site, which blocks
        downgrade and stripping attacks after the first visit.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, headers, hsts, transport]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x12-V3-Web-Frontend-Security.md#v34-browser-security-mechanism-headers
