use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV2x3x4:
    standard: @{OwaspAsvs}
    ruleId: V2.3.4
    title: Lock limited resources to prevent double booking
    statement:
        Use locking in the business logic so scarce resources, such as seats
        or delivery slots, cannot be claimed twice.
    rationale:
        Concurrent or replayed requests can otherwise race through the
        checks and book the same resource more than once.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, business-logic, concurrency]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x11-V2-Validation-and-Business-Logic.md#v23-business-logic-security
