use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV17x2x6:
    standard: @{OwaspAsvs}
    ruleId: V17.2.6
    title: Protect the media server from the DTLS ClientHello race
    statement:
        Confirm the media server is not affected by the DTLS ClientHello
        race condition, by checking public vulnerability information or
        testing.
    rationale:
        This known flaw lets an attacker disrupt the DTLS handshake and
        break media sessions.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, webrtc, dtls, race-condition]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x26-V17-WebRTC.md#v172-media
