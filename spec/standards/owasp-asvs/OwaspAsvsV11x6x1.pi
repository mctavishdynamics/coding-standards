use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV11x6x1:
    standard: @{OwaspAsvs}
    ruleId: V11.6.1
    title: Use approved algorithms for key generation and signatures
    statement:
        Generate keys, seed generators and create and verify signatures only
        with approved algorithms and modes, and make sure generated keys are
        not weak, such as RSA keys open to Fermat factorization.
    rationale:
        Weak algorithms or flawed key generation let attackers recover
        private keys or forge signatures.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, cryptography, signatures, key-generation]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x20-V11-Cryptography.md#v116-public-key-cryptography
