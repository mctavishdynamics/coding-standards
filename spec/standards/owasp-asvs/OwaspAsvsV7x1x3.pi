use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV7x1x3:
    standard: @{OwaspAsvs}
    ruleId: V7.1.3
    title: Document every system that manages sessions in a federation
    statement:
        List all systems, such as SSO services, that create and manage
        sessions in a federated setup, with the controls that coordinate
        lifetimes, termination and re-authentication between them.
    rationale:
        Sessions spread across several systems can outlive a logout or
        timeout unless their coordination is understood.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, documentation, federation, sso]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x16-V7-Session-Management.md#v71-session-management-documentation
