use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x3x2:
    standard: @{OwaspAsvs}
    ruleId: V6.3.2
    title: Remove or disable default accounts
    statement:
        Make sure default accounts such as root, admin or sa do not exist or
        are disabled.
    rationale:
        Default account names, and often their passwords, are publicly known
        and tried first.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, accounts, default-credentials]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v63-general-authentication-security
