use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV3x5x4:
    standard: @{OwaspAsvs}
    ruleId: V3.5.4
    title: Host separate applications on separate hostnames
    statement:
        Give each application its own hostname rather than sharing one.
    rationale:
        Same-origin policy and cookie scoping work by hostname, so shared
        hosts let one application's flaw reach another's data.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, origin-separation]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x12-V3-Web-Frontend-Security.md#v35-browser-origin-separation
