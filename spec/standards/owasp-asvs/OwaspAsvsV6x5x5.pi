use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x5x5:
    standard: @{OwaspAsvs}
    ruleId: V6.5.5
    title: Limit the lifetime of out-of-band codes and TOTPs
    statement:
        Give out-of-band requests, codes and tokens a lifetime of at most 10
        minutes, and TOTP values at most 30 seconds.
    rationale:
        Short lifetimes shrink the window in which a stolen or guessed code
        can be used.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, mfa, expiry]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v65-general-multi-factor-authentication-requirements
