use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV9x1x3:
    standard: @{OwaspAsvs}
    ruleId: V9.1.3
    title: Take token verification keys only from trusted sources
    statement:
        Use key material preconfigured for the issuer, and check headers
        such as jku, x5u and jwk against an allowlist of trusted sources.
    rationale:
        If the token can name its own key, an attacker signs it with their
        key and points to it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, tokens, jwt, keys]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x18-V9-Self-contained-Tokens.md#v91-token-source-and-integrity
