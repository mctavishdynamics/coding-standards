use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV8x2x4:
    standard: @{OwaspAsvs}
    ruleId: V8.2.4
    title: Apply adaptive controls based on context
    statement:
        Implement the documented controls that react to time, location, IP
        address or device for authentication and authorization, both at
        session start and during the session.
    rationale:
        Context such as an unusual location can signal a takeover that
        credentials alone do not reveal.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, authorization, adaptive-security]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x17-V8-Authorization.md#v82-general-authorization-design
