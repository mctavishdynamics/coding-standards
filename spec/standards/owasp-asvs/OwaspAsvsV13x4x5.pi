use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV13x4x5:
    standard: @{OwaspAsvs}
    ruleId: V13.4.5
    title: Do not expose internal documentation or monitoring endpoints
    statement:
        Keep internal API documentation and monitoring endpoints unreachable
        unless they are explicitly meant to be public.
    rationale:
        These endpoints give attackers a map of the system and sometimes
        sensitive data.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, information-disclosure, documentation]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x22-V13-Configuration.md#v134-unintended-information-leakage
