use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x2x7:
    standard: @{OwaspAsvs}
    ruleId: V6.2.7
    title: Allow paste and password managers
    statement:
        Permit pasting into password fields and the use of browser and
        external password managers.
    rationale:
        Password managers make long, unique passwords practical, and
        blocking them pushes users to weak, reused ones.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, passwords, password-managers]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v62-password-security
