use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV12x2x2:
    standard: @{OwaspAsvs}
    ruleId: V12.2.2
    title: Use publicly trusted certificates for external services
    statement:
        Serve external-facing services with publicly trusted TLS
        certificates.
    rationale:
        Users cannot tell an untrusted certificate from an attacker's, and
        training them to click through warnings defeats TLS.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, tls, certificates]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x21-V12-Secure-Communication.md#v122-https-communication-with-external-facing-services
