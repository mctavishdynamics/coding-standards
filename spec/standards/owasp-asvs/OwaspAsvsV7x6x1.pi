use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV7x6x1:
    standard: @{OwaspAsvs}
    ruleId: V7.6.1
    title: Coordinate session lifetimes between relying parties and IdPs
    statement:
        Make relying parties and identity providers agree, as documented, on
        how long sessions last and when they end, forcing re-authentication
        when needed, such as after the maximum time between IdP logins.
    rationale:
        Mismatched lifetimes let a session continue after the identity
        provider expects it to be over.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, federation, session, sso]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x16-V7-Session-Management.md#v76-federated-re-authentication
