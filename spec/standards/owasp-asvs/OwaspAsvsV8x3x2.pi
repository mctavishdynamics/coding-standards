use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV8x3x2:
    standard: @{OwaspAsvs}
    ruleId: V8.3.2
    title: Apply changes to authorization data immediately
    statement:
        Make changes to the values behind access decisions take effect at
        once. Where that cannot happen, as with self-contained tokens,
        detect and alert on actions by consumers who are no longer
        authorized and reverse them.
    rationale:
        A delay lets revoked users keep acting. Alerting reduces harm but
        does not stop information already leaked.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, authorization, tokens]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x17-V8-Authorization.md#v83-operation-level-authorization
