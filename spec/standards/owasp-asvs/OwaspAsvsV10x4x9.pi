use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x4x9:
    standard: @{OwaspAsvs}
    ruleId: V10.4.9
    title: Let users revoke refresh and reference tokens
    statement:
        Allow authorized users to revoke refresh tokens and reference access
        tokens through the authorization server's user interface.
    rationale:
        Users need to cut off malicious clients or stolen tokens themselves.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, oauth, revocation]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v104-oauth-authorization-server
