use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x4x6:
    standard: @{OwaspAsvs}
    ruleId: V10.4.6
    title: Require PKCE for the authorization code grant
    statement:
        Demand a valid code_challenge on authorization requests, refuse the
        plain challenge method, and verify the code_verifier on token
        requests.
    rationale:
        PKCE ensures that only the client that started the flow can redeem
        the code, even if the code is intercepted.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, oauth, pkce]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v104-oauth-authorization-server
