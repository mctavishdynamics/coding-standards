use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV2x3x1:
    standard: @{OwaspAsvs}
    ruleId: V2.3.1
    title: Process business flows in order without skipped steps
    statement:
        Run multi-step business flows for a user only in the expected order
        and refuse requests that skip or repeat steps.
    rationale:
        Attackers call later steps directly to bypass checks such as payment
        or approval that earlier steps enforce.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, business-logic, workflow]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x11-V2-Validation-and-Business-Logic.md#v23-business-logic-security
