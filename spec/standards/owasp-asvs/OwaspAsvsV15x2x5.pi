use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV15x2x5:
    standard: @{OwaspAsvs}
    ruleId: V15.2.5
    title: Isolate dangerous functionality and risky components
    statement:
        Add protections such as sandboxing, encapsulation, containers or
        network isolation around code that is dangerous or uses risky
        libraries.
    rationale:
        Isolation slows and contains an attacker who compromises that part,
        stopping them from pivoting to the rest of the application.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, isolation, sandboxing, dangerous-functionality]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x24-V15-Secure-Coding-and-Architecture.md#v152-security-architecture-and-dependencies
