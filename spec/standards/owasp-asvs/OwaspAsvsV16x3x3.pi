use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV16x3x3:
    standard: @{OwaspAsvs}
    ruleId: V16.3.3
    title: Log documented security events and bypass attempts
    statement:
        Record the security events listed in the documentation and any
        attempt to evade controls, for example validation, business rules or
        anti-automation limits.
    rationale:
        Attempts to bypass controls are strong signals of an active attack.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, logging, security-events]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x25-V16-Security-Logging-and-Error-Handling.md#v163-security-events
