use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV7x3x2:
    standard: @{OwaspAsvs}
    ruleId: V7.3.2
    title: Enforce an absolute maximum session lifetime
    statement:
        Require re-authentication once a session reaches the maximum
        lifetime set by the risk analysis, however active it is.
    rationale:
        An absolute limit caps the usefulness of a stolen session even if
        the attacker keeps it busy.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, session, timeout]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x16-V7-Session-Management.md#v73-session-timeout
