use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV2x2x1:
    standard: @{OwaspAsvs}
    ruleId: V2.2.1
    title: Validate input against business and functional expectations
    statement:
        Check input with positive validation, using allowlists of values,
        patterns and ranges or comparison against an expected structure and
        limits. At level 1 cover input that drives business or security
        decisions, and at level 2 and above cover all input.
    rationale:
        Validation keeps data quality high and shrinks the attack surface,
        for example by stopping a huge number from driving an expensive
        loop.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, input-validation]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x11-V2-Validation-and-Business-Logic.md#v22-input-validation
