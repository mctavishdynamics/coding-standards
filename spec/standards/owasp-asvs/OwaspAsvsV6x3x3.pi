use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x3x3:
    standard: @{OwaspAsvs}
    ruleId: V6.3.3
    title: Require multi-factor authentication
    statement:
        Require multi-factor authentication, or a combination of
        single-factor methods, to access the application. At level 3, one
        factor must be hardware based, resist phishing and require a
        deliberate user action. Any relaxation needs documented reasons and
        compensating controls.
    rationale:
        A single stolen password is otherwise enough to take over an
        account, and only hardware-backed factors stand up to phishing.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, mfa]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v63-general-authentication-security
