use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV4x3x2:
    standard: @{OwaspAsvs}
    ruleId: V4.3.2
    title: Disable GraphQL introspection in production
    statement:
        Turn off introspection queries in production unless the API is meant
        for use by other parties.
    rationale:
        Introspection hands attackers a full map of the schema, including
        fields not meant for general use.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, graphql, information-disclosure]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x13-V4-API-and-Web-Service.md#v43-graphql
