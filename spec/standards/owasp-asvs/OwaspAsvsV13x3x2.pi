use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV13x3x2:
    standard: @{OwaspAsvs}
    ruleId: V13.3.2
    title: Grant access to secrets on a least-privilege basis
    statement:
        Give each person and component access only to the secrets it needs.
    rationale:
        Narrow access limits the impact of any one compromised account or
        service.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, secrets, least-privilege]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x22-V13-Configuration.md#v133-secret-management
