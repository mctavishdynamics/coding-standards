use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x4x7:
    standard: @{OwaspAsvs}
    ruleId: V10.4.7
    title: Guard against malicious dynamically registered clients
    statement:
        If clients can register without authentication, validate their
        metadata such as redirect URIs, obtain user consent, and warn users
        before authorizing an untrusted client.
    rationale:
        Open registration lets attackers create convincing clients to phish
        for user authorization.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, oauth, client-registration]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v104-oauth-authorization-server
