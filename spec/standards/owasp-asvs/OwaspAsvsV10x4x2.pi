use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x4x2:
    standard: @{OwaspAsvs}
    ruleId: V10.4.2
    title: Allow each authorization code to be used only once
    statement:
        Accept an authorization code for a single token request. On a second
        attempt with an already used code, reject it and revoke all tokens
        issued from that code.
    rationale:
        Reuse signals that the code was intercepted, and revoking limits
        what the attacker gains.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, oauth, authorization-code, replay]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v104-oauth-authorization-server
