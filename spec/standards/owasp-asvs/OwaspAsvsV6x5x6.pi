use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x5x6:
    standard: @{OwaspAsvs}
    ruleId: V6.5.6
    title: Allow any authentication factor to be revoked
    statement:
        Provide a way to revoke any factor, including physical devices, if
        it is stolen or lost.
    rationale:
        A lost factor that cannot be revoked remains usable by whoever finds
        it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, mfa, revocation]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v65-general-multi-factor-authentication-requirements
