use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV5x2x2:
    standard: @{OwaspAsvs}
    ruleId: V5.2.2
    title: Check file extensions and that content matches them
    statement:
        For each accepted file, including files inside archives, confirm the
        extension is expected and that the content really is that type,
        using magic bytes, image rewriting or dedicated validation
        libraries. Level 1 covers files used for business or security
        decisions, level 2 and up covers all files.
    rationale:
        A file whose name and content disagree can slip past type-based
        defenses and be executed or parsed in a dangerous way.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, file-upload, input-validation]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x14-V5-File-Handling.md#v52-file-upload-and-content
