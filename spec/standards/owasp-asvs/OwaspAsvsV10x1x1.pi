use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x1x1:
    standard: @{OwaspAsvs}
    ruleId: V10.1.1
    title: Send tokens only to components that need them
    statement:
        Give OAuth tokens only to the parts of the system that strictly
        require them. With a backend-for-frontend, keep access and refresh
        tokens in the backend and out of the browser.
    rationale:
        Every extra place a token travels is another place it can be stolen,
        and browser code is exposed to script injection.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, oauth, tokens, bff]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v101-generic-oauth-and-oidc-security
