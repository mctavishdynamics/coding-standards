use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x6x2:
    standard: @{OwaspAsvs}
    ruleId: V6.6.2
    title: Bind out-of-band codes to their authentication request
    statement:
        Tie each out-of-band request, code or token to the authentication
        attempt it was generated for, so it cannot be used for an earlier or
        later one.
    rationale:
        Unbound codes can be captured from one attempt and replayed in
        another.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, mfa, out-of-band]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v66-out-of-band-authentication-mechanisms
