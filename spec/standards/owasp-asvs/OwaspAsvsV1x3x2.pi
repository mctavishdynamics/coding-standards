use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV1x3x2:
    standard: @{OwaspAsvs}
    ruleId: V1.3.2
    title: Avoid eval and other dynamic code execution
    statement:
        Do not use eval or similar features, such as Spring Expression
        Language, that run strings as code. If one cannot be avoided,
        sanitize any user input before it is included.
    rationale:
        Running strings as code means any injected input executes with the
        full power of the application.
    exceptions: null
    severity: null
    noncompliant:
        ```javascript
        \\\
        const total = eval(`${price} * ${quantity}`);
        \\\
        ```
    compliant:
        ```javascript
        \\\
        const total = Number(price) * Number(quantity);
        \\\
        ```
    languages: [any]
    tags: [level-1, code-execution, eval]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x10-V1-Encoding-and-Sanitization.md#v13-sanitization
