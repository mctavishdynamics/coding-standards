use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV5x2x3:
    standard: @{OwaspAsvs}
    ruleId: V5.2.3
    title: Check archives for size and file count before extracting
    statement:
        Before decompressing zip, gz, docx, odt or similar files, compare
        the declared uncompressed size and number of entries with set
        maximums.
    rationale:
        A small compressed file can expand into a decompression bomb that
        fills disk or memory.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, file-upload, archives, denial-of-service]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x14-V5-File-Handling.md#v52-file-upload-and-content
