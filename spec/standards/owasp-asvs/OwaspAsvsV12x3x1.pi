use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV12x3x1:
    standard: @{OwaspAsvs}
    ruleId: V12.3.1
    title: Encrypt all connections to and from the application
    statement:
        Use an encrypted protocol such as TLS for all inbound and outbound
        connections, including monitoring, management, remote access, SSH,
        middleware, databases, mainframes, partners and external APIs, with
        no fallback to plain protocols.
    rationale:
        Traffic beyond HTTP carries credentials and data that need the same
        protection.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, tls, transport, internal]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x21-V12-Secure-Communication.md#v123-general-service-to-service-communication-security
