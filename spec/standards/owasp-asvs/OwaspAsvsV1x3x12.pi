use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV1x3x12:
    standard: @{OwaspAsvs}
    ruleId: V1.3.12
    title: Keep regular expressions free of catastrophic backtracking
    statement:
        Write patterns without constructs that backtrack exponentially, such
        as nested quantifiers, and limit untrusted input given to them.
    rationale:
        A crafted string can make a vulnerable pattern run for minutes,
        which ties up the server and denies service to others.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        EMAIL = re.compile(r"^([a-zA-Z0-9]+)*@example\.com$")
        \\\
        ```
    compliant:
        ```python
        \\\
        EMAIL = re.compile(r"^[a-zA-Z0-9]+@example\.com$")
        \\\
        ```
    languages: [any]
    tags: [level-3, regex, denial-of-service]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x10-V1-Encoding-and-Sanitization.md#v13-sanitization
