use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x6x2:
    standard: @{OwaspAsvs}
    ruleId: V10.6.2
    title: Prevent forced logout at the OpenID Provider
    statement:
        Confirm logout explicitly with the user, or validate parameters such
        as id_token_hint in logout requests from relying parties.
    rationale:
        Unchecked logout requests let any site log users out at will.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, oidc, logout, denial-of-service]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v106-openid-provider
