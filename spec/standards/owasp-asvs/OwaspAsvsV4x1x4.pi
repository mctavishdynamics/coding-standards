use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV4x1x4:
    standard: @{OwaspAsvs}
    ruleId: V4.1.4
    title: Allow only the HTTP methods the application supports
    statement:
        Accept only HTTP methods the application or API explicitly supports,
        including OPTIONS for preflight, and block all others.
    rationale:
        Unused methods expose untested code paths and can bypass controls
        attached only to the expected methods.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, http-methods, api]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x13-V4-API-and-Web-Service.md#v41-generic-web-service-security
