use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x1x1:
    standard: @{OwaspAsvs}
    ruleId: V6.1.1
    title: Document defenses against credential stuffing and brute force
    statement:
        Describe how rate limiting, anti-automation and adaptive responses
        protect against credential stuffing and password guessing, how they
        are configured, and how they avoid letting attackers lock out
        legitimate accounts.
    rationale:
        Authentication controls can only be configured and assessed
        correctly when their intended setup is written down.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, documentation, brute-force]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v61-authentication-documentation
