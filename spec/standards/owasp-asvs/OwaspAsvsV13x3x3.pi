use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV13x3x3:
    standard: @{OwaspAsvs}
    ruleId: V13.3.3
    title: Perform cryptographic operations inside an isolated security module
    statement:
        Carry out all cryptographic operations in an isolated module, such
        as a vault or HSM, so key material never leaves it.
    rationale:
        Keys that never leave the module cannot be copied from application
        memory or disk.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, cryptography, hsm, key-management]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x22-V13-Configuration.md#v133-secret-management
