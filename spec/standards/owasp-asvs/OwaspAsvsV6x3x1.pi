use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x3x1:
    standard: @{OwaspAsvs}
    ruleId: V6.3.1
    title: Implement the documented anti brute force controls
    statement:
        Put in place the controls against credential stuffing and password
        guessing that the security documentation describes.
    rationale:
        Documented defenses protect nothing until they are actually
        implemented as specified.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, brute-force, rate-limiting]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v63-general-authentication-security
