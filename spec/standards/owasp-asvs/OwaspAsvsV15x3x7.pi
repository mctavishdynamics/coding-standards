use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV15x3x7:
    standard: @{OwaspAsvs}
    ruleId: V15.3.7
    title: Defend against HTTP parameter pollution
    statement:
        Handle repeated or conflicting parameters safely, especially when
        the framework mixes parameters from the query string, body, cookies
        and headers.
    rationale:
        Components that pick different copies of a duplicated parameter can
        be played against each other to bypass checks.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, http, parameter-pollution]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x24-V15-Secure-Coding-and-Architecture.md#v153-defensive-coding
