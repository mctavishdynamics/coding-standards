use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV2x4x2:
    standard: @{OwaspAsvs}
    ruleId: V2.4.2
    title: Require realistic human timing in business flows
    statement:
        Reject transactions submitted faster than a real person could
        complete the flow.
    rationale:
        Implausibly fast submissions point to bots, and blocking them keeps
        business flows for human interaction.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, anti-automation, business-logic]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x11-V2-Validation-and-Business-Logic.md#v24-anti-automation
