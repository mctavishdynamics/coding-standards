use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV4x2x5:
    standard: @{OwaspAsvs}
    ruleId: V4.2.5
    title: Avoid sending oversized URIs and request headers
    statement:
        When the application builds outgoing requests, validate or limit
        URIs and headers such as Authorization or Cookie so they stay within
        what the receiver accepts.
    rationale:
        An overlong request, such as a bloated cookie, can make the server
        reject every request from that client, a self-inflicted denial of
        service.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, http, denial-of-service]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x13-V4-API-and-Web-Service.md#v42-http-message-structure-validation
