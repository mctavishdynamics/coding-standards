use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV8x3x3:
    standard: @{OwaspAsvs}
    ruleId: V8.3.3
    title: Base access on the originating subject's permissions
    statement:
        Decide object access using the permissions of the original consumer,
        not those of a service acting for them, for example by passing the
        consumer's token downstream.
    rationale:
        Using a service's broad machine credentials lets any consumer reach
        whatever that service can, a confused deputy problem.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, authorization, delegation]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x17-V8-Authorization.md#v83-operation-level-authorization
