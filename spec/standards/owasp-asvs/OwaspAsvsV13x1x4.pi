use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV13x1x4:
    standard: @{OwaspAsvs}
    ruleId: V13.1.4
    title: Document critical secrets and their rotation schedule
    statement:
        Identify the secrets that are critical to the application's security
        and set a rotation schedule for them based on the threat model and
        business needs.
    rationale:
        Secrets that are never rotated stay useful to an attacker
        indefinitely once leaked.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, documentation, secrets, rotation]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x22-V13-Configuration.md#v131-configuration-documentation
