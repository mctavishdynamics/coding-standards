use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV13x1x3:
    standard: @{OwaspAsvs}
    ruleId: V13.1.3
    title: Document resource management for each external system
    statement:
        Describe for every external resource, such as databases, files,
        threads and HTTP connections, how it is released, its timeouts, how
        failures are handled, and any retry limits, delays and back-off. For
        synchronous HTTP calls, require short timeouts and few or no
        retries.
    rationale:
        Unbounded waits and retries cascade into delays and resource
        exhaustion across the system.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, documentation, resilience, timeouts]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x22-V13-Configuration.md#v131-configuration-documentation
