use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x6x4:
    standard: @{OwaspAsvs}
    ruleId: V6.6.4
    title: Rate limit push notification MFA
    statement:
        Rate limit push-based authentication requests to stop push bombing,
        and consider number matching.
    rationale:
        Repeated prompts wear users down until they approve a login they did
        not start.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, mfa, push-notifications]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v66-out-of-band-authentication-mechanisms
