use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV17x3x2:
    standard: @{OwaspAsvs}
    ruleId: V17.3.2
    title: Keep signaling working when messages are malformed
    statement:
        Make the signaling server continue handling legitimate messages when
        it meets malformed ones, using input validation, safe integer
        handling, buffer overflow prevention and robust error handling.
    rationale:
        A single crafted message should not be able to take down session
        setup for everyone.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, webrtc, signaling, robustness]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x26-V17-WebRTC.md#v173-signaling
