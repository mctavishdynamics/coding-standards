use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV2x3x3:
    standard: @{OwaspAsvs}
    ruleId: V2.3.3
    title: Make business operations all or nothing
    statement:
        Wrap business operations in transactions so they either complete
        fully or roll back to the previous valid state.
    rationale:
        A partly completed operation can leave inconsistent data that an
        attacker can exploit, such as goods shipped without payment.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, business-logic, transactions]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x11-V2-Validation-and-Business-Logic.md#v23-business-logic-security
