use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV3x5x8:
    standard: @{OwaspAsvs}
    ruleId: V3.5.8
    title: Allow authenticated resources to be embedded only when intended
    statement:
        Make sure authenticated images, videos, scripts and documents load
        on the user's behalf only where intended, by checking Sec-Fetch
        headers or sending a restrictive Cross-Origin-Resource-Policy.
    rationale:
        Otherwise a hostile page can embed private resources and learn about
        them through side channels.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, headers, resource-isolation]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x12-V3-Web-Frontend-Security.md#v35-browser-origin-separation
