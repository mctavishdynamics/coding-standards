use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV3x5x7:
    standard: @{OwaspAsvs}
    ruleId: V3.5.7
    title: Keep authorized data out of script responses
    statement:
        Do not place data that requires authorization inside script
        resources such as JavaScript files.
    rationale:
        Script files can be loaded cross-site with the victim's cookies, so
        any private data inside them leaks to the including page.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, xssi, authorization]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x12-V3-Web-Frontend-Security.md#v35-browser-origin-separation
