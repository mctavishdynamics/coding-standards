use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV15x2x4:
    standard: @{OwaspAsvs}
    ruleId: V15.2.4
    title: Pull dependencies only from the expected repositories
    statement:
        Make sure every third-party component and transitive dependency
        comes from its intended repository, internal or external, with no
        chance of dependency confusion.
    rationale:
        Attackers publish public packages with internal package names so
        that builds fetch the malicious copy.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, dependencies, supply-chain, dependency-confusion]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x24-V15-Secure-Coding-and-Architecture.md#v152-security-architecture-and-dependencies
