use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x3x5:
    standard: @{OwaspAsvs}
    ruleId: V6.3.5
    title: Notify users of suspicious authentication attempts
    statement:
        Tell users about unusual successful or failed logins, such as
        attempts from a new location or client, partial success with only
        one factor, logins after long inactivity, or success after many
        failures.
    rationale:
        Users who learn of suspicious activity quickly can react before an
        attacker does real damage.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, notification, anomaly-detection]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v63-general-authentication-security
