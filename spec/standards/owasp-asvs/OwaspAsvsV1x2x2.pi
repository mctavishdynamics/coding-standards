use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV1x2x2:
    standard: @{OwaspAsvs}
    ruleId: V1.2.2
    title: Encode untrusted data in built URLs and allow only safe schemes
    statement:
        When assembling a URL from untrusted values, encode each part for
        its position, such as percent or base64url encoding for path and
        query parts. Accept only safe schemes and refuse ones like
        javascript or data.
    rationale:
        Unencoded values can inject extra parameters or path segments, and a
        dangerous scheme turns an ordinary link into script execution.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, injection, url, output-encoding]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x10-V1-Encoding-and-Sanitization.md#v12-injection-prevention
