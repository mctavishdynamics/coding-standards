use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV11x7x2:
    standard: @{OwaspAsvs}
    ruleId: V11.7.2
    title: Minimize exposed data during processing and re-encrypt promptly
    statement:
        Expose only the minimum data needed while processing, and encrypt it
        again right after use or as soon as possible.
    rationale:
        Less plaintext in memory for less time means less to steal.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, data-minimization, cryptography]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x20-V11-Cryptography.md#v117-in-use-data-cryptography
