use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x4x3:
    standard: @{OwaspAsvs}
    ruleId: V10.4.3
    title: Keep authorization codes short-lived
    statement:
        Expire authorization codes within 10 minutes at levels 1 and 2 and
        within 1 minute at level 3.
    rationale:
        A short life narrows the window in which an intercepted code can be
        redeemed.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, oauth, authorization-code, expiry]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v104-oauth-authorization-server
