use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV7x4x3:
    standard: @{OwaspAsvs}
    ruleId: V7.4.3
    title: Offer to end other sessions after an authentication factor changes
    statement:
        After a user changes or removes any authentication factor, including
        a password reset or MFA change, give them the option to log out all
        other sessions.
    rationale:
        If the change was prompted by a compromise, the attacker's existing
        session must be closed too.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, session, credentials]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x16-V7-Session-Management.md#v74-session-termination
