use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x7x2:
    standard: @{OwaspAsvs}
    ruleId: V10.7.2
    title: Explain clearly what the user is consenting to
    statement:
        Show enough clear information on the consent screen, such as the
        requested authorizations, the application's identity and how long
        the grant lasts.
    rationale:
        Users cannot make a safe decision about consent they do not
        understand.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, oauth, consent, user-interface]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v107-consent-management
