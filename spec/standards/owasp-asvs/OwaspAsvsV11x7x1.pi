use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV11x7x1:
    standard: @{OwaspAsvs}
    ruleId: V11.7.1
    title: Use full memory encryption for sensitive data in use
    statement:
        Protect sensitive data while it is processed with full memory
        encryption so unauthorized users or processes cannot read it.
    rationale:
        Data in memory is exposed to other processes, dumps and physical
        attacks even when storage and transport are encrypted.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, cryptography, memory-encryption]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x20-V11-Cryptography.md#v117-in-use-data-cryptography
