use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x3x2:
    standard: @{OwaspAsvs}
    ruleId: V10.3.2
    title: Base resource server decisions on delegated authorization claims
    statement:
        Make access decisions from the claims that describe delegated
        authorization, including sub, scope and authorization_details when
        present.
    rationale:
        Ignoring these claims grants clients more than the user actually
        delegated.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, oauth, authorization, resource-server]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v103-oauth-resource-server
