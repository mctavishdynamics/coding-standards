use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV4x1x2:
    standard: @{OwaspAsvs}
    ruleId: V4.1.2
    title: Redirect HTTP to HTTPS only on browser-facing endpoints
    statement:
        Automatically redirect from HTTP to HTTPS only for endpoints people
        open in a browser. API and service endpoints should not redirect
        transparently.
    rationale:
        A silent redirect hides that a client is sending sensitive data over
        plain HTTP, so the leak is never noticed or fixed.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, transport, redirects, api]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x13-V4-API-and-Web-Service.md#v41-generic-web-service-security
