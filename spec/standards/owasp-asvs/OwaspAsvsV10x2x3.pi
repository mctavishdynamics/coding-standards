use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x2x3:
    standard: @{OwaspAsvs}
    ruleId: V10.2.3
    title: Request only the scopes the client needs
    statement:
        Ask the authorization server only for the scopes and authorization
        parameters the client actually requires.
    rationale:
        Narrow scopes limit what a leaked token can do.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, oauth, least-privilege, scopes]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v102-oauth-client
