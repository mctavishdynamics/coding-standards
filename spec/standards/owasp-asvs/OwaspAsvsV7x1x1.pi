use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV7x1x1:
    standard: @{OwaspAsvs}
    ruleId: V7.1.1
    title: Document session inactivity and absolute timeouts
    statement:
        Record the inactivity timeout and the absolute maximum session
        lifetime, show they fit with the other controls, and justify any
        departure from the NIST SP 800-63B re-authentication guidance.
    rationale:
        No single set of limits suits every application, so session handling
        must rest on a documented risk analysis.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, documentation, session, timeout]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x16-V7-Session-Management.md#v71-session-management-documentation
