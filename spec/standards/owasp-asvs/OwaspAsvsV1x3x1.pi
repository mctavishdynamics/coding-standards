use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV1x3x1:
    standard: @{OwaspAsvs}
    ruleId: V1.3.1
    title: Sanitize rich HTML input with a proven library
    statement:
        Clean any untrusted HTML, such as content from rich text editors,
        with a well-known HTML sanitization library or a framework feature
        built for that job.
    rationale:
        Where encoding is not possible because markup must be kept, removing
        dangerous content is the remaining defense, and home-made filters
        are easily bypassed.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, sanitization, html, xss]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x10-V1-Encoding-and-Sanitization.md#v13-sanitization
