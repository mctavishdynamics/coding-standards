use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV11x4x3:
    standard: @{OwaspAsvs}
    ruleId: V11.4.3
    title: Use collision-resistant hashes of adequate length
    statement:
        Use collision-resistant hashes with outputs of at least 256 bits
        where collision resistance is needed, and at least 128 bits where
        only second preimage resistance is needed.
    rationale:
        Short or weak hashes let attackers forge data that matches a signed
        or trusted value.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, cryptography, hashing, integrity]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x20-V11-Cryptography.md#v114-hashing-and-hash-based-functions
