use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV13x2x3:
    standard: @{OwaspAsvs}
    ruleId: V13.2.3
    title: Do not use default credentials for service authentication
    statement:
        Make sure service credentials are never defaults such as root/root
        or admin/admin.
    rationale:
        Default credentials are widely known and are tried first by
        attackers and automated scanners.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, default-credentials, service-accounts]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x22-V13-Configuration.md#v132-backend-communication-configuration
