use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x5x8:
    standard: @{OwaspAsvs}
    ruleId: V6.5.8
    title: Check TOTPs against a trusted time source
    statement:
        Validate time-based codes using time from a trusted service, never
        time supplied by the client.
    rationale:
        A client-controlled clock would let an attacker reuse old codes or
        extend their validity.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, mfa, totp, time]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v65-general-multi-factor-authentication-requirements
