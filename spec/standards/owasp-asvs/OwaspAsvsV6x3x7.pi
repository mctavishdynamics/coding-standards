use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x3x7:
    standard: @{OwaspAsvs}
    ruleId: V6.3.7
    title: Notify users after changes to authentication details
    statement:
        Inform users when their credentials are reset or their username or
        email address is changed.
    rationale:
        Notification lets a user spot and report an account takeover that
        changed their login details.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, notification, credentials]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v63-general-authentication-security
