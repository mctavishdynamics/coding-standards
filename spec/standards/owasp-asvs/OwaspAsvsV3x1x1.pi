use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV3x1x1:
    standard: @{OwaspAsvs}
    ruleId: V3.1.1
    title: Document required browser security features and fallbacks
    statement:
        State in the documentation which browser security features the
        application depends on, such as HTTPS, HSTS and Content Security
        Policy, and how it reacts when a browser lacks one, for example by
        warning the user or refusing access.
    rationale:
        Browser protections only help when the team knows which ones are
        required and has decided what happens without them.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, documentation, browser-security]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x12-V3-Web-Frontend-Security.md#v31-web-frontend-security-documentation
