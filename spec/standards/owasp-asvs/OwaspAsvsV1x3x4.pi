use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV1x3x4:
    standard: @{OwaspAsvs}
    ruleId: V1.3.4
    title: Restrict user-supplied SVG to safe elements
    statement:
        Validate or sanitize uploaded SVG so it holds only the drawing
        elements and attributes the application needs, with no scripts and
        no foreignObject content.
    rationale:
        SVG is a scriptable format, so an uploaded image can carry script
        that runs in the browser of whoever views it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, sanitization, svg, xss]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x10-V1-Encoding-and-Sanitization.md#v13-sanitization
