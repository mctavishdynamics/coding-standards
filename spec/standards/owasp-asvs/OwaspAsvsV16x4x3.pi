use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV16x4x3:
    standard: @{OwaspAsvs}
    ruleId: V16.4.3
    title: Ship logs securely to a separate system
    statement:
        Forward logs over a secure channel to a separate system where they
        are analyzed and where alerts are raised.
    rationale:
        If the application is breached, logs kept elsewhere stay out of the
        attacker's reach.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, logging, isolation]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x25-V16-Security-Logging-and-Error-Handling.md#v164-log-protection
