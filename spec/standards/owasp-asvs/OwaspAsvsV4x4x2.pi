use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV4x4x2:
    standard: @{OwaspAsvs}
    ruleId: V4.4.2
    title: Check the Origin header during the WebSocket handshake
    statement:
        When a WebSocket connection is being established, check its Origin
        header against the application's allowlist of origins and reject the
        connection if it does not match.
    rationale:
        Browsers send cookies with cross-site WebSocket handshakes, so
        without an origin check any site can hijack the user's session.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, websocket, origin]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x13-V4-API-and-Web-Service.md#v44-websocket
