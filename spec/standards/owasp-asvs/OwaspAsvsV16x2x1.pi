use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV16x2x1:
    standard: @{OwaspAsvs}
    ruleId: V16.2.1
    title: Include when, where, who and what in each log entry
    statement:
        Record enough metadata in every log entry to rebuild a detailed
        timeline of events during an investigation.
    rationale:
        Entries without context cannot be tied together to understand an
        incident.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, logging, metadata]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x25-V16-Security-Logging-and-Error-Handling.md#v162-general-logging
