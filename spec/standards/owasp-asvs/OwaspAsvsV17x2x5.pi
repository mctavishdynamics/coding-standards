use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV17x2x5:
    standard: @{OwaspAsvs}
    ruleId: V17.2.5
    title: Keep media processing running during SRTP floods
    statement:
        Ensure the media server keeps handling incoming media during a flood
        of SRTP packets from legitimate users, for example by rate limiting
        and dropping excess packets.
    rationale:
        Flooding a media server degrades or ends calls for everyone using
        it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, webrtc, denial-of-service]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x26-V17-WebRTC.md#v172-media
