use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x2x4:
    standard: @{OwaspAsvs}
    ruleId: V6.2.4
    title: Reject the most common passwords
    statement:
        Check new passwords at registration and change time against a list
        of at least the 3000 most common passwords that meet the length
        policy.
    rationale:
        Common passwords fall to the first guesses of any brute force or
        spraying attack.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, passwords, password-policy]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v62-password-security
