use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV3x3x1:
    standard: @{OwaspAsvs}
    ruleId: V3.3.1
    title: Mark cookies Secure and give them a secure name prefix
    statement:
        Set the Secure attribute on cookies, and name each one with the
        __Host- prefix or, failing that, the __Secure- prefix.
    rationale:
        The attribute keeps cookies off plain HTTP, and the prefix tells the
        browser to reject versions of the cookie set over an insecure
        channel.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, cookies, transport]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x12-V3-Web-Frontend-Security.md#v33-cookie-setup
