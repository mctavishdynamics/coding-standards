use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV1x5x3:
    standard: @{OwaspAsvs}
    ruleId: V1.5.3
    title: Parse the same data type consistently across parsers
    statement:
        Make sure every parser that handles one kind of data, such as JSON,
        XML or URLs, parses it in the same way and uses the same character
        encoding.
    rationale:
        When two parsers disagree on the same input, an attacker can craft
        data that passes a check in one and acts differently in the other,
        leading to interoperability, file inclusion or SSRF flaws.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, parsing, consistency]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x10-V1-Encoding-and-Sanitization.md#v15-safe-deserialization
