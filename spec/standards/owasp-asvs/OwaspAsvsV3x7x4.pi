use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV3x7x4:
    standard: @{OwaspAsvs}
    ruleId: V3.7.4
    title: Add the domain to the HSTS preload list
    statement:
        Submit the application's top-level domain to the public HSTS preload
        list.
    rationale:
        Preloading builds HTTPS-only behavior into browsers, protecting even
        the very first visit, which the header alone cannot do.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, hsts, transport]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x12-V3-Web-Frontend-Security.md#v37-other-browser-security-considerations
