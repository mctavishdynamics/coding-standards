use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x7x1:
    standard: @{OwaspAsvs}
    ruleId: V6.7.1
    title: Protect certificates used to verify authentication assertions
    statement:
        Store the certificates that verify cryptographic authentication
        assertions so they cannot be modified.
    rationale:
        Anyone who can replace these certificates can make forged assertions
        pass verification.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, cryptographic-authentication, certificates]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v67-cryptographic-authentication-mechanism
