use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV16x2x3:
    standard: @{OwaspAsvs}
    ruleId: V16.2.3
    title: Send logs only to documented destinations
    statement:
        Write or send logs only to the files and services listed in the log
        inventory.
    rationale:
        Logs often contain sensitive data, so undocumented destinations are
        uncontrolled leaks.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, logging, data-flow]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x25-V16-Security-Logging-and-Error-Handling.md#v162-general-logging
