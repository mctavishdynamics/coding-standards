use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV2x1x1:
    standard: @{OwaspAsvs}
    ruleId: V2.1.1
    title: Document the validation rules for each data item
    statement:
        Write down how every data item is checked against its expected
        structure, whether a common format such as phone numbers and card
        numbers or a format internal to the application.
    rationale:
        Clear documentation of validation rules makes it obvious what the
        code has to enforce and lets reviewers check that it does.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, documentation, input-validation]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x11-V2-Validation-and-Business-Logic.md#v21-validation-and-business-logic-documentation
