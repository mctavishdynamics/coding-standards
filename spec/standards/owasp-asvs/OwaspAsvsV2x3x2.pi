use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV2x3x2:
    standard: @{OwaspAsvs}
    ruleId: V2.3.2
    title: Implement documented business logic limits
    statement:
        Enforce the business logic limits that the documentation describes.
    rationale:
        Missing limits let attackers exploit the logic, for example through
        a stream of small transfers or mass actions.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, business-logic, limits]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x11-V2-Validation-and-Business-Logic.md#v23-business-logic-security
