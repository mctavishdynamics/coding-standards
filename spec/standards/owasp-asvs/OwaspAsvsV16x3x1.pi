use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV16x3x1:
    standard: @{OwaspAsvs}
    ruleId: V16.3.1
    title: Log all authentication attempts
    statement:
        Record every authentication attempt, whether it succeeds or fails,
        along with details such as the method or factors used.
    rationale:
        Authentication logs are the main source for spotting credential
        attacks and account takeovers.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, logging, authentication]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x25-V16-Security-Logging-and-Error-Handling.md#v163-security-events
