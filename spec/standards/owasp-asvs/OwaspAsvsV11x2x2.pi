use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV11x2x2:
    standard: @{OwaspAsvs}
    ruleId: V11.2.2
    title: Design for crypto agility
    statement:
        Make it possible to reconfigure or swap random generators,
        encryption, MAC and hash algorithms, key lengths, rounds and modes
        at any time, and to swap out keys and passwords and encrypt data
        again.
    rationale:
        When an algorithm breaks, or post-quantum schemes become ready, the
        application must be able to switch without a redesign.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, cryptography, crypto-agility]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x20-V11-Cryptography.md#v112-secure-cryptography-implementation
