use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV8x4x1:
    standard: @{OwaspAsvs}
    ruleId: V8.4.1
    title: Isolate tenants in multi-tenant applications
    statement:
        Use cross-tenant controls so a consumer's operations can never
        affect tenants they lack permission for.
    rationale:
        A single missing tenant check can expose or alter another customer's
        data.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, authorization, multi-tenancy]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x17-V8-Authorization.md#v84-other-authorization-considerations
