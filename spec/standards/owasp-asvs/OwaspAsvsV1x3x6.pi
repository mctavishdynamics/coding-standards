use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV1x3x6:
    standard: @{OwaspAsvs}
    ruleId: V1.3.6
    title: Protect outbound requests against SSRF
    statement:
        Before calling another service with untrusted data, check that the
        scheme, host, path and port of the target are all on an allowlist,
        and strip dangerous characters.
    rationale:
        Without such checks, an attacker can steer the server into
        contacting internal systems or cloud metadata services it should
        never reach.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, ssrf, sanitization]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x10-V1-Encoding-and-Sanitization.md#v13-sanitization
