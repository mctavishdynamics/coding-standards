use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV1x4x1:
    standard: @{OwaspAsvs}
    ruleId: V1.4.1
    title: Use memory-safe string and copy operations
    statement:
        Use bounded string functions, safer memory copies and checked
        pointer arithmetic so stack, buffer and heap overflows are detected
        or prevented.
    rationale:
        In systems languages and unmanaged code, an unchecked copy can write
        past a buffer and corrupt memory or hand control to an attacker.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        char name[32];
        strcpy(name, input);
        \\\
        ```
    compliant:
        ```c
        \\\
        char name[32];
        snprintf(name, sizeof name, "%s", input);
        \\\
        ```
    languages: [any]
    tags: [level-2, memory, buffer-overflow]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x10-V1-Encoding-and-Sanitization.md#v14-memory-string-and-unmanaged-code
