use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV14x2x7:
    standard: @{OwaspAsvs}
    ruleId: V14.2.7
    title: Delete sensitive data according to retention rules
    statement:
        Classify sensitive data for retention and delete outdated or
        unnecessary data automatically, on schedule or when circumstances
        require.
    rationale:
        Data that no longer exists cannot be leaked.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, data-retention, sensitive-data]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x23-V14-Data-Protection.md#v142-general-data-protection
