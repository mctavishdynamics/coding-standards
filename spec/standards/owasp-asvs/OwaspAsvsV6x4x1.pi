use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x4x1:
    standard: @{OwaspAsvs}
    ruleId: V6.4.1
    title: Make initial passwords and activation codes random and short-lived
    statement:
        Generate initial passwords or activation codes with a secure random
        source, follow the password policy, and expire them quickly or after
        first use. They must never become the lasting password.
    rationale:
        Predictable or long-lived initial secrets can be guessed or reused
        to take over new accounts.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, credentials, randomness]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v64-authentication-factor-lifecycle-and-recovery
