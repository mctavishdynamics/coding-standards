use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV3x7x5:
    standard: @{OwaspAsvs}
    ruleId: V3.7.5
    title: Act as documented when browser security features are missing
    statement:
        When a browser lacks a required security feature, respond the way
        the documentation says, for instance by showing a warning or denying
        entry.
    rationale:
        Defined fallback behavior keeps users on weak browsers from silently
        losing protections.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, browser-security]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x12-V3-Web-Frontend-Security.md#v37-other-browser-security-considerations
