use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x4x4:
    standard: @{OwaspAsvs}
    ruleId: V10.4.4
    title: Allow only the grants each client needs
    statement:
        Permit each client only the grant types it uses, and never the
        implicit or resource owner password grants.
    rationale:
        Unneeded grants widen the attack surface, and the deprecated grants
        expose tokens or passwords.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, oauth, grants]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v104-oauth-authorization-server
