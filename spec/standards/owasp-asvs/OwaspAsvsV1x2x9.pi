use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV1x2x9:
    standard: @{OwaspAsvs}
    ruleId: V1.2.9
    title: Escape special characters in regular expressions
    statement:
        When untrusted text becomes part of a regular expression, escape its
        metacharacters so they match literally.
    rationale:
        Unescaped characters change what the pattern matches and can break
        security checks or make the pattern very slow.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        pattern = re.compile(search_term + r"\d+")
        \\\
        ```
    compliant:
        ```python
        \\\
        pattern = re.compile(re.escape(search_term) + r"\d+")
        \\\
        ```
    languages: [any]
    tags: [level-2, injection, regex]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x10-V1-Encoding-and-Sanitization.md#v12-injection-prevention
