use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV9x2x2:
    standard: @{OwaspAsvs}
    ruleId: V9.2.2
    title: Check the token type and purpose
    statement:
        Confirm a token is the right kind and meant for the current purpose
        before using it, for example only access tokens for authorization
        and only ID tokens for proof of login.
    rationale:
        Accepting one token type in place of another lets tokens issued for
        one purpose be misused for another.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, tokens, token-type]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x18-V9-Self-contained-Tokens.md#v92-token-content
