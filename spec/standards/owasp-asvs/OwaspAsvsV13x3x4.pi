use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV13x3x4:
    standard: @{OwaspAsvs}
    ruleId: V13.3.4
    title: Expire and rotate secrets as documented
    statement:
        Configure secrets to expire and be rotated according to the
        documented schedule.
    rationale:
        Regular rotation limits how long a leaked secret stays useful.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, secrets, rotation]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x22-V13-Configuration.md#v133-secret-management
