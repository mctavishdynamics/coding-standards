use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV3x7x3:
    standard: @{OwaspAsvs}
    ruleId: V3.7.3
    title: Warn users before sending them outside the application
    statement:
        Show a notice, with a way to cancel, when a user is about to be sent
        to a URL the application does not control.
    rationale:
        The warning gives users a chance to notice and back out of a
        redirect to an untrusted site.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, redirects, user-notification]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x12-V3-Web-Frontend-Security.md#v37-other-browser-security-considerations
