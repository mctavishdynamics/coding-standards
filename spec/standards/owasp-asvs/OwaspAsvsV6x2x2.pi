use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV6x2x2:
    standard: @{OwaspAsvs}
    ruleId: V6.2.2
    title: Let users change their password
    statement:
        Provide a way for users to change their own password.
    rationale:
        Users need to replace a password they suspect is exposed.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, passwords]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x15-V6-Authentication.md#v62-password-security
