use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV11x2x5:
    standard: @{OwaspAsvs}
    ruleId: V11.2.5
    title: Make cryptographic modules fail securely
    statement:
        Handle errors in cryptographic modules so failures do not open
        weaknesses, for example by not revealing padding errors.
    rationale:
        Distinguishable failures enable attacks such as padding oracles that
        decrypt data without the key.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, cryptography, error-handling]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x20-V11-Cryptography.md#v112-secure-cryptography-implementation
