use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV15x4x4:
    standard: @{OwaspAsvs}
    ruleId: V15.4.4
    title: Prevent thread starvation with fair resource allocation
    statement:
        Allocate resources fairly, for example through thread pools, so
        lower priority threads still make progress in reasonable time.
    rationale:
        Starved threads stall work and can be exploited to degrade service.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, concurrency, starvation]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x24-V15-Secure-Coding-and-Architecture.md#v154-safe-concurrency
