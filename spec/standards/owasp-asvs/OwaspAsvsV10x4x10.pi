use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x4x10:
    standard: @{OwaspAsvs}
    ruleId: V10.4.10
    title: Authenticate confidential clients on backchannel requests
    statement:
        Require confidential clients to authenticate on token, pushed
        authorization and revocation requests.
    rationale:
        Unauthenticated backchannel calls let anyone holding a code or token
        act as the client.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, oauth, client-authentication]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v104-oauth-authorization-server
