use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV1x3x8:
    standard: @{OwaspAsvs}
    ruleId: V1.3.8
    title: Sanitize JNDI lookups and configure JNDI securely
    statement:
        Clean untrusted values before using them in JNDI lookups, and
        configure JNDI so it cannot load remote objects.
    rationale:
        A JNDI lookup on an attacker-controlled name can fetch and run
        remote code, as shown by widely exploited logging flaws.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, injection, jndi, java]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x10-V1-Encoding-and-Sanitization.md#v13-sanitization
