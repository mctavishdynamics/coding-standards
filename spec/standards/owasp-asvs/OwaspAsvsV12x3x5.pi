use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV12x3x5:
    standard: @{OwaspAsvs}
    ruleId: V12.3.5
    title: Authenticate internal service endpoints strongly
    statement:
        Have internal services verify each other with strong,
        replay-resistant, public-key-based authentication such as TLS client
        certificates. A service mesh can ease certificate management.
    rationale:
        Without mutual authentication, a compromised component can pose as
        any other internal service.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, authentication, internal, mtls]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x21-V12-Secure-Communication.md#v123-general-service-to-service-communication-security
