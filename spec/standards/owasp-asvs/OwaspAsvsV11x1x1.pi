use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV11x1x1:
    standard: @{OwaspAsvs}
    ruleId: V11.1.1
    title: Document a key management policy and key lifecycle
    statement:
        Document how cryptographic keys are created, stored, rotated and
        retired, basing the process on a recognised standard like NIST SP
        800-57, and limit each key to the parties that genuinely need it.
    rationale:
        Cryptography designed up front with clear key rules is far cheaper
        to get right than protection retrofitted later.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, cryptography, key-management, documentation]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x20-V11-Cryptography.md#v111-cryptographic-inventory-and-documentation
