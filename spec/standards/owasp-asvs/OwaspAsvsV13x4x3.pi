use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV13x4x3:
    standard: @{OwaspAsvs}
    ruleId: V13.4.3
    title: Disable directory listings unless intended
    statement:
        Configure web servers not to show directory listings unless that is
        deliberate.
    rationale:
        Listings reveal files that were never meant to be found, such as
        backups and configuration.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, directory-listing, information-disclosure]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x22-V13-Configuration.md#v134-unintended-information-leakage
