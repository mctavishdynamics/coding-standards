use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV7x3x1:
    standard: @{OwaspAsvs}
    ruleId: V7.3.1
    title: Enforce an inactivity timeout
    statement:
        Require re-authentication after a period of inactivity set by the
        risk analysis and documented decisions.
    rationale:
        Idle timeouts limit how long an abandoned or hijacked session stays
        usable.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, session, timeout]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x16-V7-Session-Management.md#v73-session-timeout
