use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV1x1x2:
    standard: @{OwaspAsvs}
    ruleId: V1.1.2
    title: Encode output at the last step before the interpreter
    statement:
        Apply output encoding or escaping right before data reaches the
        interpreter that will read it, or let that interpreter do it itself.
        Keep stored data in its original form rather than storing it
        encoded.
    rationale:
        Encoding applied too early can be undone or doubled by later steps,
        which produces broken content or leaves the encoding with no effect.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, encoding, output-encoding]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x10-V1-Encoding-and-Sanitization.md#v11-encoding-and-sanitization-architecture
