use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x4x13:
    standard: @{OwaspAsvs}
    ruleId: V10.4.13
    title: Always pair the code grant with pushed authorization requests
    statement:
        Use pushed authorization requests whenever the code grant is used.
    rationale:
        PAR sends authorization parameters directly to the server, so they
        cannot be tampered with or leaked in the browser.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, oauth, par]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v104-oauth-authorization-server
