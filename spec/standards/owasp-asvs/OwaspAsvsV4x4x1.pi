use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV4x4x1:
    standard: @{OwaspAsvs}
    ruleId: V4.4.1
    title: Use WebSocket over TLS for all connections
    statement:
        Use the secure wss scheme for every WebSocket connection.
    rationale:
        Unencrypted WebSocket traffic can be read and altered by anyone on
        the network path.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, websocket, transport]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x13-V4-API-and-Web-Service.md#v44-websocket
