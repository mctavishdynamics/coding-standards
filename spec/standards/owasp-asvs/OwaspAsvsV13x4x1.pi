use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV13x4x1:
    standard: @{OwaspAsvs}
    ruleId: V13.4.1
    title: Deploy without accessible source control metadata
    statement:
        Ship the application without folders such as .git or .svn, or make
        them unreachable from outside and from the application itself.
    rationale:
        Exposed repository metadata can reveal source code, history and
        embedded secrets.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-1, information-disclosure, deployment]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x22-V13-Configuration.md#v134-unintended-information-leakage
