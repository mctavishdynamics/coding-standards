use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV17x2x1:
    standard: @{OwaspAsvs}
    ruleId: V17.2.1
    title: Manage the DTLS certificate key under the key policy
    statement:
        Protect and manage the key of the DTLS certificate according to the
        documented key management policy.
    rationale:
        A stolen DTLS key lets an attacker impersonate the media server and
        intercept streams.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, webrtc, dtls, key-management]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x26-V17-WebRTC.md#v172-media
