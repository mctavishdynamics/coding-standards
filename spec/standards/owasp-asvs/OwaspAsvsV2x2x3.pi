use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV2x2x3:
    standard: @{OwaspAsvs}
    ruleId: V2.2.3
    title: Check that combinations of related data are reasonable
    statement:
        Make sure related data items, taken together, are plausible
        according to the predefined rules.
    rationale:
        Individually valid fields can combine into values the business never
        allows, which attackers use to reach unexpected states.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, input-validation, business-logic]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x11-V2-Validation-and-Business-Logic.md#v22-input-validation
