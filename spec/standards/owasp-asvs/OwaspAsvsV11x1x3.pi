use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV11x1x3:
    standard: @{OwaspAsvs}
    ruleId: V11.1.3
    title: Use discovery tools to find all cryptography in use
    statement:
        Apply cryptographic discovery methods to locate every use of
        encryption, hashing and signing in the system.
    rationale:
        Hidden or forgotten cryptographic code escapes review and upgrades.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, cryptography, inventory, discovery]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x20-V11-Cryptography.md#v111-cryptographic-inventory-and-documentation
