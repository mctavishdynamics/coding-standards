use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV10x3x5:
    standard: @{OwaspAsvs}
    ruleId: V10.3.5
    title: Require sender-constrained access tokens
    statement:
        Prevent use of stolen or replayed access tokens by requiring tokens
        bound to the sender through mutual TLS or DPoP.
    rationale:
        A plain bearer token works for whoever holds it, while a bound token
        is useless without the client's key.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, oauth, sender-constrained, replay]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x19-V10-OAuth-and-OIDC.md#v103-oauth-resource-server
