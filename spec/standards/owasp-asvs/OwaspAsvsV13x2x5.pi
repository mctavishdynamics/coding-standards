use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV13x2x5:
    standard: @{OwaspAsvs}
    ruleId: V13.2.5
    title: Configure the server with an allowlist of outbound destinations
    statement:
        Set up the web or application server with an allowlist of systems it
        may send requests to or load data and files from.
    rationale:
        Server-level restrictions catch outbound access that application
        checks miss.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, allowlist, server-configuration, ssrf]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x22-V13-Configuration.md#v132-backend-communication-configuration
