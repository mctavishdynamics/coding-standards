use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV16x5x4:
    standard: @{OwaspAsvs}
    ruleId: V16.5.4
    title: Define a last-resort handler for unhandled exceptions
    statement:
        Install a catch-all handler for unhandled exceptions, or an
        equivalent pattern in languages without exceptions.
    rationale:
        It keeps error details flowing to the logs and stops a single error
        from crashing the whole process.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-3, error-handling, availability]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x25-V16-Security-Logging-and-Error-Handling.md#v165-error-handling
