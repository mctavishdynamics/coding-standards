use ../lib/CodingRule

from ./OwaspAsvs import OwaspAsvs

export coding-rule OwaspAsvsV5x4x2:
    standard: @{OwaspAsvs}
    ruleId: V5.4.2
    title: Encode filenames placed in headers and attachments
    statement:
        Encode or sanitize file names in response headers or email
        attachments, for example following RFC 6266.
    rationale:
        Unencoded names can break the header or message structure and inject
        extra content.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [level-2, file-download, injection, encoding]
    source: https://github.com/OWASP/ASVS/blob/v5.0.0_release/5.0/en/0x14-V5-File-Handling.md#v54-file-download
