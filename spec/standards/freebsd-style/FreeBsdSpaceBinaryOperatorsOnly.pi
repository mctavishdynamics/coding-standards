use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdSpaceBinaryOperatorsOnly:
    standard: @{FreeBsdStyle}
    ruleId: operator-spacing
    title: Space binary operators but not unary ones
    statement:
        Surround binary operators with spaces, but write unary operators
        directly against what they apply to.
    rationale:
        The spacing shows how operators bind.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        n=- x+y*2;
        \\\
        ```
    compliant:
        ```c
        \\\
        n = -x + y * 2;
        \\\
        ```
    languages: [c]
    tags: [formatting, whitespace, expressions]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
