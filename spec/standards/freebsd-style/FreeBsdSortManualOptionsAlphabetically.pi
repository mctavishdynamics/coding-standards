use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdSortManualOptionsAlphabetically:
    standard: @{FreeBsdStyle}
    ruleId: manual-option-order
    title: List options in the manual page in pure alphabetical order
    statement:
        In the manual page's option descriptions, order options purely
        alphabetically, following the same case ordering as the usage line,
        regardless of whether they take arguments.
    rationale:
        Readers can look up any option quickly.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [documentation, command-line]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
