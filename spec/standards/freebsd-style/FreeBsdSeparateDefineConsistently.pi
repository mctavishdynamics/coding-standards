use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdSeparateDefineConsistently:
    standard: @{FreeBsdStyle}
    ruleId: define-spacing
    title: Use one space or one tab after #define, consistently within a file
    statement:
        Separate #define from the macro name with a single space or a single
        tab, choosing one and using it throughout the file.
    rationale:
        Consistency keeps the definitions in a file visually aligned.
    exceptions:
        Examples are omitted because this specification renders tabs as
        spaces, so they cannot show the difference.
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [preprocessor, formatting, whitespace]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
