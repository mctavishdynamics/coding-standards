use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdUppercaseEnumValues:
    standard: @{FreeBsdStyle}
    ruleId: enum-values
    title: Write enumeration values in upper case
    statement:
        Spell enumeration constants entirely in upper case.
    rationale:
        They are constants and should look like other constants.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        enum state { idle, running };
        \\\
        ```
    compliant:
        ```c
        \\\
        enum state { IDLE, RUNNING };
        \\\
        ```
    languages: [c]
    tags: [naming, enums]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
