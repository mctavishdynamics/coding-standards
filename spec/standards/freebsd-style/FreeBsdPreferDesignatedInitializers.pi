use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdPreferDesignatedInitializers:
    standard: @{FreeBsdStyle}
    ruleId: designated-initializers
    title: Prefer C99 designated initializers where they fit
    statement:
        Where it fits, initialize structures by naming their members.
    rationale:
        Named fields stay correct when the structure layout changes and show
        which member gets which value.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        static struct cdevsw foo_cdevsw = { D_VERSION, 0, foo_open, foo_close };
        \\\
        ```
    compliant:
        ```c
        \\\
        static struct cdevsw foo_cdevsw = {
                .d_version = D_VERSION,
                .d_open = foo_open,
                .d_close = foo_close,
        };
        \\\
        ```
    languages: [c]
    tags: [initialization, structs]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
