use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdRunCodeCheckers:
    standard: @{FreeBsdStyle}
    ruleId: code-checkers
    title: Build with warnings enabled and keep them to a minimum
    statement:
        Run code through static analyzers or compile with flags such as
        -Wall whenever possible, and leave as few warnings as you can.
    rationale:
        Warnings often reveal real bugs.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [warnings, tooling]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
