use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdKeepLinesTo80Columns:
    standard: @{FreeBsdStyle}
    ruleId: line-width
    title: Keep lines to 80 columns but never split grep-able messages
    statement:
        Aim for lines of at most 80 characters, allowing a slightly longer
        line when it is clearer. Do not break diagnostic, error or panic
        message strings across lines even if they exceed the limit.
    rationale:
        Narrow lines are easier to read, while whole message strings can
        still be found with grep.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        panic("vm_fault: page table entry for %p is "
            "inconsistent", va);
        \\\
        ```
    compliant:
        ```c
        \\\
        panic("vm_fault: page table entry for %p is inconsistent",
            va);
        \\\
        ```
    languages: [c]
    tags: [formatting, line-length]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
