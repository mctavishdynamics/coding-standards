use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdUseErrAndWarn:
    standard: @{FreeBsdStyle}
    ruleId: err-warn
    title: Report errors with err(3) and warn(3)
    statement:
        Use the err and warn families of functions for diagnostics instead
        of writing your own.
    rationale:
        They print the program name and system error consistently.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        if ((fd = open(path, O_RDONLY)) < 0) {
                fprintf(stderr, "cannot open %s\n", path);
                exit(1);
        }
        \\\
        ```
    compliant:
        ```c
        \\\
        if ((fd = open(path, O_RDONLY)) < 0)
                err(1, "%s", path);
        \\\
        ```
    languages: [c]
    tags: [error-handling, error-messages]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
