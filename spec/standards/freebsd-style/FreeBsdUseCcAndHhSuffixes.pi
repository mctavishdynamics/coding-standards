use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdUseCcAndHhSuffixes:
    standard: @{FreeBsdStyle}
    ruleId: cpp-file-suffixes
    title: Name C++ files with .cc and .hh suffixes
    statement:
        Use .cc for C++ source files and .hh for headers, and always give
        headers a suffix.
    rationale:
        A consistent suffix lets tools and people recognize C++ files.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [cpp, files, naming]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
