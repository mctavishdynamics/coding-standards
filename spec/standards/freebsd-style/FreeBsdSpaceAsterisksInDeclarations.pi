use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdSpaceAsterisksInDeclarations:
    standard: @{FreeBsdStyle}
    ruleId: pointer-declarations
    title: Attach asterisks to declared names, not to type names
    statement:
        In declarations, put no whitespace between an asterisk and adjacent
        tokens, except for a single space separating it from preceding type
        names and qualifiers.
    rationale:
        This shows that the asterisk binds to the declarator, not to the
        type.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        char* name;
        const char * const * argv;
        \\\
        ```
    compliant:
        ```c
        \\\
        char *name;
        const char *const *argv;
        \\\
        ```
    languages: [c]
    tags: [formatting, declarations, pointers]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
