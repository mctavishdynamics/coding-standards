use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdAlignStructMemberNames:
    standard: @{FreeBsdStyle}
    ruleId: struct-member-alignment
    title: Align struct member names with one or two tabs
    statement:
        Align member names with one tab, if that aligns at least 90 percent
        of them, or with two tabs otherwise. Separate a name that follows a
        very long type with a single space.
    rationale:
        Aligned names make a structure easy to scan.
    exceptions:
        Examples are omitted because this specification renders tabs as
        spaces, so they cannot show the difference.
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [formatting, structs, alignment]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
