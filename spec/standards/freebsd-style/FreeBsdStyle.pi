export coding-standard FreeBsdStyle:
    title: FreeBSD Kernel Source File Style Guide, style(9)
    publisher: The FreeBSD Project
    url: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9
    version: FreeBSD 15.1, July 28, 2025
    license: BSD 2-Clause License; Copyright (c) 1995-2025 The FreeBSD Project
    description:
        The FreeBSD kernel and userland source style, Kernel Normal Form,
        from the style(9) manual page. It covers file layout, includes,
        macros, declarations, formatting and a C++ section.
    rules:
        - @{FreeBsdKeepLinesTo80Columns}
        - @{FreeBsdWriteKnfComments}
        - @{FreeBsdChooseOneCommentKindPerFile}
        - @{FreeBsdWriteCopyrightHeaderBlock}
        - @{FreeBsdAddCopyrightLinesCorrectly}
        - @{FreeBsdPreserveForeignVcsIds}
        - @{FreeBsdOrderKernelIncludes}
        - @{FreeBsdPlaceNetworkIncludesNext}
        - @{FreeBsdNoUsrIncludeInKernel}
        - @{FreeBsdSortUserlandIncludes}
        - @{FreeBsdKeepPathnamesInHeaders}
        - @{FreeBsdPutLocalIncludesLast}
        - @{FreeBsdAvoidImplementationNamespace}
        - @{FreeBsdNameMacrosInUpperCase}
        - @{FreeBsdSeparateDefineConsistently}
        - @{FreeBsdWrapCompoundMacrosInDoWhile}
        - @{FreeBsdCommentLongConditionalBlocks}
        - @{FreeBsdUseC99FixedWidthTypes}
        - @{FreeBsdUseC99Bool}
        - @{FreeBsdPreferDesignatedInitializers}
        - @{FreeBsdUppercaseEnumValues}
        - @{FreeBsdPreferUnderscoresInIdentifiers}
        - @{FreeBsdSpaceAsterisksInDeclarations}
        - @{FreeBsdOrderStructMembers}
        - @{FreeBsdAlignStructMemberNames}
        - @{FreeBsdDeclareMajorStructsAtTop}
        - @{FreeBsdUseQueueMacros}
        - @{FreeBsdAvoidStructTypedefs}
        - @{FreeBsdMatchTypedefToStructTag}
        - @{FreeBsdPrototypeAllFunctions}
        - @{FreeBsdPrototypeSharedFunctionsInHeaders}
        - @{FreeBsdNameParametersByContext}
        - @{FreeBsdAlignPrototypeNames}
        - @{FreeBsdCommentMajorRoutines}
        - @{FreeBsdParseOptionsWithGetopt}
        - @{FreeBsdAlignCaseWithSwitch}
        - @{FreeBsdMarkObscureUnreachableCode}
        - @{FreeBsdSpaceAfterKeywords}
        - @{FreeBsdBraceSingleStatementsConsistently}
        - @{FreeBsdWriteForeverLoopsWithFor}
        - @{FreeBsdUseForLoopFlexibility}
        - @{FreeBsdIndentWithTabsAndFourSpaceContinuation}
        - @{FreeBsdWrapAfterOperators}
        - @{FreeBsdNoTrailingOrMixedWhitespace}
        - @{FreeBsdCuddleElse}
        - @{FreeBsdNoSpaceAfterFunctionNames}
        - @{FreeBsdSpaceBinaryOperatorsOnly}
        - @{FreeBsdAvoidNeedlessParentheses}
        - @{FreeBsdExitZeroOrOne}
        - @{FreeBsdPutReturnTypeOnOwnLine}
        - @{FreeBsdSortLocalDeclarations}
        - @{FreeBsdInitializeDeclarationsSimply}
        - @{FreeBsdNoFunctionDeclarationsInFunctions}
        - @{FreeBsdNoSpaceAfterCastsOrSizeof}
        - @{FreeBsdUseNullWithCastsForArguments}
        - @{FreeBsdCompareAgainstNull}
        - @{FreeBsdAvoidImplicitTruthTests}
        - @{FreeBsdDoNotCastVoidPointerReturns}
        - @{FreeBsdParenthesizeReturnValues}
        - @{FreeBsdUseErrAndWarn}
        - @{FreeBsdUseAnsiDefinitions}
        - @{FreeBsdWrapParametersWithFourSpaces}
        - @{FreeBsdWriteVariadicFunctionsWithStdarg}
        - @{FreeBsdSeparateDeclarationsWithBlankLine}
        - @{FreeBsdPreferPrintf}
        - @{FreeBsdFormatUsageLikeSynopsis}
        - @{FreeBsdSortManualOptionsAlphabetically}
        - @{FreeBsdRunCodeCheckers}
        - @{FreeBsdUseStaticAssert}
        - @{FreeBsdUsePredictHintsSparingly}
        - @{FreeBsdFollowStyleInNewCoreCode}
        - @{FreeBsdAvoidStandaloneStyleChanges}
        - @{FreeBsdUseCcAndHhSuffixes}
        - @{FreeBsdNoReturnParenthesesInCpp}
        - @{FreeBsdOpenNamespacesOnOneLine}
        - @{FreeBsdFormatMemberDeclarationsLikePrototypes}
        - @{FreeBsdBreakAfterTypeInTopLevelDefinitions}
        - @{FreeBsdKeepInClassDefinitionsCompact}
        - @{FreeBsdDeclareDefaultedMethodsOnOneLine}
        - @{FreeBsdBreakAfterTemplateHeader}
        - @{FreeBsdAttachAmpersandToName}
        - @{FreeBsdDeclareCppVariablesWhereUsed}
        - @{FreeBsdPreferStandardContainers}
        - @{FreeBsdUseNullptr}
        - @{FreeBsdUseStandardStringTypes}
        - @{FreeBsdUseAutoForReadability}
        - @{FreeBsdUseSmartPointers}
        - @{FreeBsdNoGlobalUsingInHeaders}
        - @{FreeBsdUseUsingForTypeAliases}
