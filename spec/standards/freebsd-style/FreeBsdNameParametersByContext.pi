use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdNameParametersByContext:
    standard: @{FreeBsdStyle}
    ruleId: prototype-parameter-names
    title: Name kernel prototype parameters and protect them in user headers
    statement:
        Kernel prototypes include parameter names. In headers visible to
        userland, either omit the names or use protected names that begin
        with an underscore, preferably the latter.
    rationale:
        Unprotected names in public headers can collide with user macros of
        the same name.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        /* include/stdlib.h */
        long    strtol(const char *str, char **end, int base);
        \\\
        ```
    compliant:
        ```c
        \\\
        /* include/stdlib.h */
        long    strtol(const char *_str, char **_end, int _base);
        \\\
        ```
    languages: [c]
    tags: [functions, headers, naming]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
