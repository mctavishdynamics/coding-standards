use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdPutReturnTypeOnOwnLine:
    standard: @{FreeBsdStyle}
    ruleId: function-definition-layout
    title: Put the function type and the opening brace on their own lines
    statement:
        In a function definition, write the return type on a line by itself
        before the name, and the opening brace of the body on a line by
        itself.
    rationale:
        Function names then start in column one, where they are easy to find
        with grep.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        static char *dup_name(const char *s) {
        \\\
        ```
    compliant:
        ```c
        \\\
        static char *
        dup_name(const char *s)
        {
        \\\
        ```
    languages: [c]
    tags: [formatting, functions]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
