use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdAddCopyrightLinesCorrectly:
    standard: @{FreeBsdStyle}
    ruleId: copyright-lines
    title: Add copyright lines only for substantial changes and in the right place
    statement:
        Add a new Copyright line only for substantial changes. Keep any All
        Rights Reserved phrase on the same line as its Copyright word, and
        add new lines after an existing All Rights Reserved line, or last
        when the phrase shares lines with Copyright, rather than between an
        old line and its phrase.
    rationale:
        Inserting lines in the wrong place changes which holders an existing
        rights statement appears to cover.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [licensing, comments]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
