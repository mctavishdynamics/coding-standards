use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdBreakAfterTypeInTopLevelDefinitions:
    standard: @{FreeBsdStyle}
    ruleId: cpp-top-level-definitions
    title: Put the return type on its own line in top-level C++ definitions
    statement:
        Function definitions at namespace or file scope put a newline after
        the return type, as in C.
    rationale:
        It keeps the function name at the start of the line, the same as C
        code.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int parser::parse(const char *s)
        {
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int
        parser::parse(const char *s)
        {
        \\\
        ```
    languages: [cpp]
    tags: [cpp, formatting, functions]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
