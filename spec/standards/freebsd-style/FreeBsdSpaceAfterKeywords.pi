use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdSpaceAfterKeywords:
    standard: @{FreeBsdStyle}
    ruleId: keyword-spacing
    title: Put a space after control keywords
    statement:
        Write a space after if, while, for, return and switch.
    rationale:
        It separates keywords visually from function calls.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        if(error)
                return(error);
        \\\
        ```
    compliant:
        ```c
        \\\
        if (error)
                return (error);
        \\\
        ```
    languages: [c]
    tags: [formatting, whitespace]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
