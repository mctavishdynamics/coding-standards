use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdIndentWithTabsAndFourSpaceContinuation:
    standard: @{FreeBsdStyle}
    ruleId: indentation
    title: Indent with 8-column tabs and continue lines with four spaces
    statement:
        Indent each level with an eight-column tab, and indent continuation
        lines of a wrapped statement by four spaces.
    rationale:
        Wide indentation makes block structure obvious, and the smaller
        continuation indent separates wrapped lines from new blocks.
    exceptions:
        Examples are omitted because this specification renders tabs as
        spaces, so they cannot show the difference.
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [formatting, indentation]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
