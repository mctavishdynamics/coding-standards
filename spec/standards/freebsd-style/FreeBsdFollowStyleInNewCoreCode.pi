use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdFollowStyleInNewCoreCode:
    standard: @{FreeBsdStyle}
    ruleId: compliance
    title: Make new core code comply and keep other code self-consistent
    statement:
        New core kernel code complies with this guide. Third-party modules
        and device drivers may differ, but must be internally consistent,
        and code that already roughly complies must not drift away.
    rationale:
        A shared style keeps the core uniform while respecting externally
        maintained code.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [consistency, maintainability]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
