use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdNoTrailingOrMixedWhitespace:
    standard: @{FreeBsdStyle}
    ruleId: whitespace
    title: Do not leave trailing whitespace or put spaces before tabs
    statement:
        Lines must not end in spaces or tabs. Indent with tabs followed by
        spaces only, never more spaces than a tab would cover and never
        spaces before a tab.
    rationale:
        Stray whitespace creates noisy diffs, and mixed indentation looks
        different in each editor.
    exceptions:
        Examples are omitted because this specification renders tabs as
        spaces, so they cannot show the difference.
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [formatting, whitespace, indentation]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
