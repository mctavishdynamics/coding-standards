use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdAvoidNeedlessParentheses:
    standard: @{FreeBsdStyle}
    ruleId: redundant-parentheses
    title: Use parentheses only for precedence or real clarity
    statement:
        Add parentheses only where precedence demands them or where the
        expression would otherwise be hard to follow, judged from the view
        of a reader less familiar with the code than you.
    rationale:
        Extra parentheses add clutter, but genuinely ambiguous expressions
        deserve them.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        total = ((a) + (b));
        \\\
        ```
    compliant:
        ```c
        \\\
        total = a + b;
        mask = (flags & M_WAITOK) != 0;
        \\\
        ```
    languages: [c]
    tags: [expressions, readability]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
