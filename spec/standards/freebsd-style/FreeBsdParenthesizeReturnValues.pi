use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdParenthesizeReturnValues:
    standard: @{FreeBsdStyle}
    ruleId: return-parentheses
    title: Enclose return values in parentheses
    statement:
        Write the value of a return statement in parentheses.
    rationale:
        This is the long-standing KNF convention for C code.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        return error;
        \\\
        ```
    compliant:
        ```c
        \\\
        return (error);
        \\\
        ```
    languages: [c]
    tags: [formatting, functions]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
