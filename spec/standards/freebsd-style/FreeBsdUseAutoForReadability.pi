use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdUseAutoForReadability:
    standard: @{FreeBsdStyle}
    ruleId: cpp-auto
    title: Use auto where it improves readability, with qualifiers before it
    statement:
        Use auto where it helps, such as for iterators, complex range-for
        element types and values whose type is obvious from the right side.
        Put qualifiers before it, as in const auto.
    rationale:
        auto removes noise when the type is evident, and a fixed qualifier
        position keeps declarations uniform.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::unique_ptr<session> s = std::make_unique<session>(fd);
        auto const n = s->count();
        \\\
        ```
    compliant:
        ```cpp
        \\\
        auto s = std::make_unique<session>(fd);
        const auto n = s->count();
        \\\
        ```
    languages: [cpp]
    tags: [cpp, type-deduction]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
