use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdAlignPrototypeNames:
    standard: @{FreeBsdStyle}
    ruleId: prototype-alignment
    title: Line up function names in prototypes with a tab and optional space
    statement:
        Separate the return type from the function name in a prototype with
        a tab, and add an extra space after the tab where needed so the
        names line up.
    rationale:
        Aligned names make a list of prototypes easy to scan.
    exceptions:
        Examples are omitted because this specification renders tabs as
        spaces, so they cannot show the difference.
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [formatting, functions, alignment]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
