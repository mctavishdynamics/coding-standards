use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdSortUserlandIncludes:
    standard: @{FreeBsdStyle}
    ruleId: include-order-userland
    title: Put sorted /usr/include headers after a blank line
    statement:
        After a blank line, list the /usr/include headers, sorted
        alphabetically by name.
    rationale:
        Sorted groups are easy to scan and merge without conflicts.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        #include <string.h>
        #include <errno.h>
        #include <stdio.h>
        \\\
        ```
    compliant:
        ```c
        \\\
        #include <errno.h>
        #include <stdio.h>
        #include <string.h>
        \\\
        ```
    languages: [c]
    tags: [includes, file-structure]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
