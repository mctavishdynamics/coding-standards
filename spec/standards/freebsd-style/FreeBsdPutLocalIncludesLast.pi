use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdPutLocalIncludesLast:
    standard: @{FreeBsdStyle}
    ruleId: include-order-local
    title: Put local headers last, in double quotes, after a blank line
    statement:
        After another blank line, include the program's own headers using
        double quotes; system headers use angle brackets.
    rationale:
        The quote style and position show at once which headers belong to
        the program.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        #include <stdio.h>
        #include <extern.h>
        \\\
        ```
    compliant:
        ```c
        \\\
        #include <stdio.h>

        #include "extern.h"
        \\\
        ```
    languages: [c]
    tags: [includes, file-structure]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
