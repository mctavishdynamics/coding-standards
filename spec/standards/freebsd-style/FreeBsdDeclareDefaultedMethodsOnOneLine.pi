use ../lib/CodingRule

from ./FreeBsdStyle import FreeBsdStyle

export coding-rule FreeBsdDeclareDefaultedMethodsOnOneLine:
    standard: @{FreeBsdStyle}
    ruleId: cpp-defaulted-methods
    title: Declare defaulted and deleted methods on a single line
    statement:
        Write = default and = delete declarations on one line.
    rationale:
        They have no body, so spreading them over lines adds nothing.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class handle {
                handle(const handle &)
                    = delete;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class handle {
                handle(const handle &) = delete;
        };
        \\\
        ```
    languages: [cpp]
    tags: [cpp, formatting, classes]
    source: https://man.freebsd.org/cgi/man.cgi?query=style&sektion=9#DESCRIPTION
