use ../lib/CodingRule

from ./JoelTest import JoelTest

export coding-rule JoelTestHallwayUsabilityTesting:
    standard: @{JoelTest}
    ruleId: question-12
    title: Run quick hallway usability tests
    statement:
        Ask a few passers-by to try the feature you have just built and
        watch where they struggle. Five or six people are enough.
    rationale:
        A handful of users reveals most of the serious usability problems at
        almost no cost, even when the team's design skills are modest.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, usability, testing]
    source: https://www.joelonsoftware.com/2000/08/09/the-joel-test-12-steps-to-better-code/
