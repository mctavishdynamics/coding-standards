use ../lib/CodingRule

from ./JoelTest import JoelTest

export coding-rule JoelTestWriteSpecs:
    standard: @{JoelTest}
    ruleId: question-7
    title: Write a specification before writing the code
    statement:
        Describe the design in a written spec first, and follow the
        principle of no code without a spec.
    rationale:
        Fixing a design problem in a document costs a few edited lines,
        while fixing it in written code is expensive and meets resistance.
        Software built without a spec tends to end up badly designed and
        late.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, specification, design]
    source: https://www.joelonsoftware.com/2000/08/09/the-joel-test-12-steps-to-better-code/
