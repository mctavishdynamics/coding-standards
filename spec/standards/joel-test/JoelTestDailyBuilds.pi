use ../lib/CodingRule

from ./JoelTest import JoelTest

export coding-rule JoelTestDailyBuilds:
    standard: @{JoelTest}
    ruleId: question-3
    title: Build the whole product every day
    statement:
        Run a complete build at least daily so that a broken check-in is
        noticed straight away and fixed. A fixed time, such as midday, lets
        everyone check in beforehand.
    rationale:
        A change that compiles only on its author's machine can stop the
        whole team, and a regular build makes that breakage visible before
        it spreads.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, build, continuous-integration]
    source: https://www.joelonsoftware.com/2000/08/09/the-joel-test-12-steps-to-better-code/
