use ../lib/CodingRule

from ./JoelTest import JoelTest

export coding-rule JoelTestQuietWorkingConditions:
    standard: @{JoelTest}
    ruleId: question-8
    title: Give programmers quiet places to work
    statement:
        Provide programmers with space, quiet and privacy, such as offices
        with doors, rather than a noisy open floor.
    rationale:
        Deep concentration takes time to reach and a brief interruption can
        throw it away, so constant disturbance costs far more than the
        moment it takes.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, productivity, environment]
    source: https://www.joelonsoftware.com/2000/08/09/the-joel-test-12-steps-to-better-code/
