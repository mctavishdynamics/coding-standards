use ../lib/CodingRule

from ./JoelTest import JoelTest

export coding-rule JoelTestUpToDateSchedule:
    standard: @{JoelTest}
    ruleId: question-6
    title: Keep an up-to-date schedule
    statement:
        Maintain a current schedule for the work, and use it to decide which
        features to build and which low-priority ones to cut.
    rationale:
        The business has to plan demos, events and marketing ahead of
        release, and a schedule guards against features creeping in without
        limit.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, scheduling, planning]
    source: https://www.joelonsoftware.com/2000/08/09/the-joel-test-12-steps-to-better-code/
