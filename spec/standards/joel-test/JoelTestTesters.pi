use ../lib/CodingRule

from ./JoelTest import JoelTest

export coding-rule JoelTestTesters:
    standard: @{JoelTest}
    ruleId: question-10
    title: Employ dedicated testers
    statement:
        Employ people whose job is testing, at about one tester per two or
        three developers.
    rationale:
        Without testers a team either ships more bugs or pays programmers to
        do testing work that others could do for less.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, testing, staffing]
    source: https://www.joelonsoftware.com/2000/08/09/the-joel-test-12-steps-to-better-code/
