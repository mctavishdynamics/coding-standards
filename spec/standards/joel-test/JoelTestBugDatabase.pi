use ../lib/CodingRule

from ./JoelTest import JoelTest

export coding-rule JoelTestBugDatabase:
    standard: @{JoelTest}
    ruleId: question-4
    title: Track every known bug in a bug database
    statement:
        Record all known bugs formally, even on a one-person team. Each
        entry needs reproduction steps, expected and actual behaviour, an
        owner and its fixed status.
    rationale:
        Nobody can keep more than a handful of bugs in their head, and bugs
        that are only remembered get forgotten in the rush to ship.
    exceptions:
        A simple table with those five columns is enough when a full
        tracking tool feels like too much.
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, bug-tracking]
    source: https://www.joelonsoftware.com/2000/08/09/the-joel-test-12-steps-to-better-code/
