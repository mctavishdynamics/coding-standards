use ../lib/CodingRule

from ./JoelTest import JoelTest

export coding-rule JoelTestFixBugsFirst:
    standard: @{JoelTest}
    ruleId: question-5
    title: Fix known bugs before writing new code
    statement:
        Make removing existing bugs a higher priority than adding features,
        so the defect count stays near zero at all times.
    rationale:
        A bug costs more to fix the longer it waits, and the time to fix one
        is hard to predict, so a schedule full of open bugs is unreliable. A
        product with no known bugs can also ship at short notice.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, quality, scheduling]
    source: https://www.joelonsoftware.com/2000/08/09/the-joel-test-12-steps-to-better-code/
