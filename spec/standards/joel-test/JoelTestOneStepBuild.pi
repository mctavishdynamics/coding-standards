use ../lib/CodingRule

from ./JoelTest import JoelTest

export coding-rule JoelTestOneStepBuild:
    standard: @{JoelTest}
    ruleId: question-2
    title: Produce a shipping build with a single step
    statement:
        Have one script that takes a clean checkout of the latest source and
        produces everything that ships, including every variant and the
        installer.
    rationale:
        Each manual step is a chance for error, and near release the team
        needs to rebuild quickly and often without slips.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, build, automation]
    source: https://www.joelonsoftware.com/2000/08/09/the-joel-test-12-steps-to-better-code/
