use ../lib/CodingRule

from ./JoelTest import JoelTest

export coding-rule JoelTestCodingInterviews:
    standard: @{JoelTest}
    ruleId: question-11
    title: Have candidates write code in interviews
    statement:
        Ask every programming candidate to write code during the interview,
        instead of judging them on a résumé, conversation, trivia or trick
        puzzles.
    rationale:
        The job is producing code, so watching a candidate do it is the most
        direct evidence of whether they can.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, hiring]
    source: https://www.joelonsoftware.com/2000/08/09/the-joel-test-12-steps-to-better-code/
