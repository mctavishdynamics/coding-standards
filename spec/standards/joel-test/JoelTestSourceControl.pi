use ../lib/CodingRule

from ./JoelTest import JoelTest

export coding-rule JoelTestSourceControl:
    standard: @{JoelTest}
    ruleId: question-1
    title: Keep all code in source control
    statement:
        Store the team's code in a source control system. Spolsky notes that
        a free system is perfectly adequate.
    rationale:
        Without it, programmers cannot see each other's changes or undo
        mistakes, and with it every working copy doubles as a backup of the
        code.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, version-control]
    source: https://www.joelonsoftware.com/2000/08/09/the-joel-test-12-steps-to-better-code/
