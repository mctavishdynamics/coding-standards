use ../lib/CodingStandard

from ./JoelTestBestTools import JoelTestBestTools
from ./JoelTestBugDatabase import JoelTestBugDatabase
from ./JoelTestCodingInterviews import JoelTestCodingInterviews
from ./JoelTestDailyBuilds import JoelTestDailyBuilds
from ./JoelTestFixBugsFirst import JoelTestFixBugsFirst
from ./JoelTestHallwayUsabilityTesting import JoelTestHallwayUsabilityTesting
from ./JoelTestOneStepBuild import JoelTestOneStepBuild
from ./JoelTestQuietWorkingConditions import JoelTestQuietWorkingConditions
from ./JoelTestSourceControl import JoelTestSourceControl
from ./JoelTestTesters import JoelTestTesters
from ./JoelTestUpToDateSchedule import JoelTestUpToDateSchedule
from ./JoelTestWriteSpecs import JoelTestWriteSpecs

export coding-standard JoelTest:
    title: The Joel Test - 12 Steps to Better Code
    publisher: Joel Spolsky
    url: https://www.joelonsoftware.com/2000/08/09/the-joel-test-12-steps-to-better-code/
    version: 2000-08-09
    license: Copyright Joel Spolsky, all rights reserved. Items are paraphrased.
    description:
        Joel Spolsky's twelve yes-or-no questions for judging the practices
        of a software team, covering source control, builds, bugs,
        schedules, specs, working conditions, testing and hiring.
    rules:
        - @{JoelTestSourceControl}
        - @{JoelTestOneStepBuild}
        - @{JoelTestDailyBuilds}
        - @{JoelTestBugDatabase}
        - @{JoelTestFixBugsFirst}
        - @{JoelTestUpToDateSchedule}
        - @{JoelTestWriteSpecs}
        - @{JoelTestQuietWorkingConditions}
        - @{JoelTestBestTools}
        - @{JoelTestTesters}
        - @{JoelTestCodingInterviews}
        - @{JoelTestHallwayUsabilityTesting}
