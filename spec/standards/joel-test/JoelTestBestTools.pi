use ../lib/CodingRule

from ./JoelTest import JoelTest

export coding-rule JoelTestBestTools:
    standard: @{JoelTest}
    ruleId: question-9
    title: Equip programmers with the best tools available
    statement:
        Buy fast machines, extra monitors, good editors and ample storage
        for the people who write the code.
    rationale:
        Slow builds and weak tools break concentration and add up to
        frustration and lost hours that cost far more than the equipment.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [practice, tools, productivity]
    source: https://www.joelonsoftware.com/2000/08/09/the-joel-test-12-steps-to-better-code/
