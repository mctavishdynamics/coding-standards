// The shape of one published collection of coding rules, such as PEP 8
// or the SEI CERT C Coding Standard. Each collection directory holds one
// anchor of this kind, named after the collection, beside its rule files.
export abstract anchor CodingStandard as coding-standard:
    title:: string
    publisher:: string
    url:: string
    version:: string:: null: null
    license:: string
    description:: string
    rules:: list
