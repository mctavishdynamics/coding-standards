// The shape of one rule taken from a coding standard. Every rule lives in
// its own file, named after its anchor, inside its collection's directory.
// `standard` is a reference to the collection's coding-standard anchor.
export abstract anchor CodingRule as coding-rule:
    standard:: any
    ruleId:: string
    title:: string
    statement:: string
    rationale:: string
    exceptions:: string:: null: null
    severity:: string:: null: null
    noncompliant:: string:: null: null
    compliant:: string:: null: null
    languages:: string[]
    tags:: string[]
    source:: string
