use ../lib/CodingRule

from ./EffectiveJava import EffectiveJava

export coding-rule EffectiveJavaItem28:
    standard: @{EffectiveJava}
    ruleId: item-28
    title: Reach for List rather than an array when generics are involved
    statement:
        When you mix arrays and generics and run into errors or warnings,
        replace the arrays with lists.
    rationale:
        Arrays are covariant and check element types at run time, while
        generics are invariant and checked at compile time. Lists catch type
        mistakes earlier.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        Object[] values = new Long[1];
        values[0] = "text"; // ArrayStoreException at run time
        \\\
        ```
    compliant:
        ```java
        \\\
        List<Long> values = new ArrayList<>();
        // values.add("text"); does not compile
        \\\
        ```
    languages: [java]
    tags: [generics, collections]
    source: https://www.informit.com/store/effective-java-9780134686097
