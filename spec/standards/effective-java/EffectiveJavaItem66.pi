use ../lib/CodingRule

from ./EffectiveJava import EffectiveJava

export coding-rule EffectiveJavaItem66:
    standard: @{EffectiveJava}
    ruleId: item-66
    title: Think carefully before using native methods
    statement:
        Rarely use native code to gain performance. Use it to reach platform
        facilities or existing native libraries, keep it to a minimum and
        test it thoroughly.
    rationale:
        Native code is unsafe, platform dependent and hard to debug, and the
        JVM is usually fast enough without it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [java]
    tags: [general-programming, native-code, performance]
    source: https://www.informit.com/store/effective-java-9780134686097
