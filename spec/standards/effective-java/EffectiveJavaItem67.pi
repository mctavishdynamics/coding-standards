use ../lib/CodingRule

from ./EffectiveJava import EffectiveJava

export coding-rule EffectiveJavaItem67:
    standard: @{EffectiveJava}
    ruleId: item-67
    title: Optimise only with care and measurement
    statement:
        Aim for a good design first. Think about performance in API and
        architecture decisions, and change code for speed only after
        measuring before and after.
    rationale:
        Premature optimisation often harms the design without speeding
        anything up, while a poor API can lock in slowness permanently.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [java]
    tags: [general-programming, performance, design]
    source: https://www.informit.com/store/effective-java-9780134686097
