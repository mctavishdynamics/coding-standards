use ../lib/CodingRule

from ./EffectiveJava import EffectiveJava

export coding-rule EffectiveJavaItem61:
    standard: @{EffectiveJava}
    ruleId: item-61
    title: Use primitives rather than boxed primitives where you can
    statement:
        Prefer int, long and the other primitives to Integer, Long and
        friends. Use boxed types only for collection elements, type
        arguments and reflection.
    rationale:
        Comparing boxed values with == checks identity, unboxing a null
        throws, and repeated boxing is slow.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        Long sum = 0L;
        for (long i = 0; i < n; i++) sum += i;
        \\\
        ```
    compliant:
        ```java
        \\\
        long sum = 0L;
        for (long i = 0; i < n; i++) sum += i;
        \\\
        ```
    languages: [java]
    tags: [general-programming, numbers, performance, boxing]
    source: https://www.informit.com/store/effective-java-9780134686097
