use ../lib/CodingRule

from ./EffectiveJava import EffectiveJava

export coding-rule EffectiveJavaItem51:
    standard: @{EffectiveJava}
    ruleId: item-51
    title: Keep method names clear and parameter lists short
    statement:
        Choose method names carefully, avoid too many convenience methods,
        keep parameter lists to four or fewer, use interfaces as parameter
        types and prefer two-element enums to boolean parameters.
    rationale:
        Well-shaped signatures make an API easier to learn, use correctly
        and evolve.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        void schedule(String id, int h, int m, boolean recurring, boolean urgent);
        \\\
        ```
    compliant:
        ```java
        \\\
        void schedule(Job job, LocalTime at, Recurrence recurrence);
        \\\
        ```
    languages: [java]
    tags: [methods, api-design]
    source: https://www.informit.com/store/effective-java-9780134686097
