use ../lib/CodingRule

from ./EffectiveJava import EffectiveJava

export coding-rule EffectiveJavaItem30:
    standard: @{EffectiveJava}
    ruleId: item-30
    title: Write methods as generics where they fit
    statement:
        Give static utility methods type parameters so that their arguments
        and results are typed, instead of working on raw or Object types.
    rationale:
        Generic methods need no casts at the call site and let the compiler
        check that arguments agree with each other.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        public static Set union(Set a, Set b) {
            Set result = new HashSet(a);
            result.addAll(b);
            return result;
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        public static <E> Set<E> union(Set<E> a, Set<E> b) {
            Set<E> result = new HashSet<>(a);
            result.addAll(b);
            return result;
        }
        \\\
        ```
    languages: [java]
    tags: [generics, methods]
    source: https://www.informit.com/store/effective-java-9780134686097
