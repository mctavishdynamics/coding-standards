use ../lib/CodingRule

from ./EffectiveJava import EffectiveJava

export coding-rule EffectiveJavaItem68:
    standard: @{EffectiveJava}
    ruleId: item-68
    title: Spell names the way Java programmers expect
    statement:
        Follow the standard spelling and grammar rules for names of
        packages, classes, methods, fields, constants and type parameters.
    rationale:
        Names that break the conventions confuse readers and can lead to
        wrong assumptions about what code does.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        public class order_service {
            static final int maxRetries = 3;
            public void Process_Order() { }
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        public class OrderService {
            static final int MAX_RETRIES = 3;
            public void processOrder() { }
        }
        \\\
        ```
    languages: [java]
    tags: [general-programming, naming]
    source: https://www.informit.com/store/effective-java-9780134686097
