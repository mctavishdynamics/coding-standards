use ../lib/CodingRule

from ./EffectiveJava import EffectiveJava

export coding-rule EffectiveJavaItem64:
    standard: @{EffectiveJava}
    ruleId: item-64
    title: Declare variables and parameters with interface types
    statement:
        When a suitable interface exists, use it for the types of
        parameters, return values, variables and fields, and name the class
        only when you construct the object.
    rationale:
        Code written against an interface can switch implementations by
        changing a single line.
    exceptions:
        Use a class type when no interface fits, or when you need methods
        only the class provides.
    severity: null
    noncompliant:
        ```java
        \\\
        LinkedHashSet<String> tags = new LinkedHashSet<>();
        \\\
        ```
    compliant:
        ```java
        \\\
        Set<String> tags = new LinkedHashSet<>();
        \\\
        ```
    languages: [java]
    tags: [general-programming, interfaces, types]
    source: https://www.informit.com/store/effective-java-9780134686097
