use ../lib/CodingRule

from ./EffectiveJava import EffectiveJava

export coding-rule EffectiveJavaItem41:
    standard: @{EffectiveJava}
    ruleId: item-41
    title: Tag classes with an empty interface when the tag should be a type
    statement:
        If a marker only applies to classes and you want methods to accept
        only marked objects, use a marker interface. Use a marker annotation
        for other program elements or annotation-based frameworks.
    rationale:
        A marker interface defines a type, so the compiler can check that
        only marked objects are passed where they are required.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```java
        \\\
        public interface Auditable { }

        public void record(Auditable entity) { /* ... */ }
        \\\
        ```
    languages: [java]
    tags: [enums-and-annotations, interfaces, annotations]
    source: https://www.informit.com/store/effective-java-9780134686097
