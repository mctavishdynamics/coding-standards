use ../lib/CodingRule

from ./EffectiveJava import EffectiveJava

export coding-rule EffectiveJavaItem59:
    standard: @{EffectiveJava}
    ruleId: item-59
    title: Learn and use the standard libraries
    statement:
        Before writing a utility yourself, check whether the platform
        libraries already provide it, and keep up with what each release
        adds.
    rationale:
        Library code is written by experts, widely tested and improves over
        time without effort from you.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        int r = Math.abs(rnd.nextInt()) % n;
        \\\
        ```
    compliant:
        ```java
        \\\
        int r = ThreadLocalRandom.current().nextInt(n);
        \\\
        ```
    languages: [java]
    tags: [general-programming, libraries]
    source: https://www.informit.com/store/effective-java-9780134686097
