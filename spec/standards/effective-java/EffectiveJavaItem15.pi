use ../lib/CodingRule

from ./EffectiveJava import EffectiveJava

export coding-rule EffectiveJavaItem15:
    standard: @{EffectiveJava}
    ruleId: item-15
    title: Keep classes and members as private as possible
    statement:
        Give each class and member the lowest access level that still lets
        the program work. Public classes should not have public mutable
        fields or expose mutable arrays.
    rationale:
        Hidden parts can be changed, optimised or replaced without breaking
        clients. Everything exposed becomes a commitment.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        public static final String[] RESERVED = { "if", "for" };
        \\\
        ```
    compliant:
        ```java
        \\\
        private static final String[] RESERVED = { "if", "for" };

        public static List<String> reserved() {
            return List.of(RESERVED);
        }
        \\\
        ```
    languages: [java]
    tags: [classes-and-interfaces, encapsulation, access-control]
    source: https://www.informit.com/store/effective-java-9780134686097
