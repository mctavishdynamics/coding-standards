use ../lib/CodingRule

from ./EffectiveJava import EffectiveJava

export coding-rule EffectiveJavaItem21:
    standard: @{EffectiveJava}
    ruleId: item-21
    title: Design interfaces carefully, since they are hard to change later
    statement:
        Think hard about an interface before releasing it and test it with
        several implementations. Do not count on default methods to fix it
        afterwards.
    rationale:
        A default method added later may break existing implementations that
        cannot know about it, causing runtime failures.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [java]
    tags: [classes-and-interfaces, interfaces, api-design]
    source: https://www.informit.com/store/effective-java-9780134686097
