use ../lib/CodingRule

from ./EffectiveJava import EffectiveJava

export coding-rule EffectiveJavaItem40:
    standard: @{EffectiveJava}
    ruleId: item-40
    title: Put Override on every method meant to override
    statement:
        Annotate each method declaration that you intend to override a
        supertype method with Override.
    rationale:
        The compiler then reports a method that overloads by mistake, such
        as an equals taking the wrong parameter type.
    exceptions:
        It may be left off concrete methods implementing an abstract method,
        though adding it does no harm.
    severity: null
    noncompliant:
        ```java
        \\\
        public boolean equals(Point other) { return x == other.x; }
        \\\
        ```
    compliant:
        ```java
        \\\
        @Override
        public boolean equals(Object o) { return o instanceof Point p && x == p.x; }
        \\\
        ```
    languages: [java]
    tags: [enums-and-annotations, annotations, inheritance]
    source: https://www.informit.com/store/effective-java-9780134686097
