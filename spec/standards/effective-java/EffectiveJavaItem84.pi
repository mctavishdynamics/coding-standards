use ../lib/CodingRule

from ./EffectiveJava import EffectiveJava

export coding-rule EffectiveJavaItem84:
    standard: @{EffectiveJava}
    ruleId: item-84
    title: Write threaded code that works whatever order threads run in
    statement:
        Keep the number of runnable threads close to the number of
        processors, avoid busy waiting, and do not use Thread.yield or
        thread priorities to fix behaviour.
    rationale:
        Scheduling policies differ between systems, so a program whose
        correctness or speed depends on them will not be portable.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        while (!done.get()) {
            Thread.yield();
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        done.await();
        \\\
        ```
    languages: [java]
    tags: [concurrency, portability]
    source: https://www.informit.com/store/effective-java-9780134686097
