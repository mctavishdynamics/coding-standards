use ../lib/CodingRule

from ./EffectiveJava import EffectiveJava

export coding-rule EffectiveJavaItem86:
    standard: @{EffectiveJava}
    ruleId: item-86
    title: Think hard before implementing Serializable
    statement:
        Implement Serializable only after weighing the costs, especially for
        classes meant for inheritance and inner classes, which should
        usually not implement it.
    rationale:
        Once released, the serialized form is part of the API, it opens a
        hidden constructor that bypasses invariants, and every release needs
        more testing.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [java]
    tags: [serialization, api-design]
    source: https://www.informit.com/store/effective-java-9780134686097
