use ../lib/CodingRule

from ./EffectivePython import EffectivePython

export coding-rule EffectivePythonItem96:
    standard: @{EffectivePython}
    ruleId: item-96
    title: Write extension modules for the best speed and API
    statement:
        When native code must be fast and feel Pythonic, write a proper
        extension module using the C API or a binding tool.
    rationale:
        Extensions avoid per-call ctypes overhead and can expose natural
        Python types, at the cost of more code and a compiler.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [performance, native-code]
    source: https://effectivepython.com/
