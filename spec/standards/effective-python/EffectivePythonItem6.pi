use ../lib/CodingRule

from ./EffectivePython import EffectivePython

export coding-rule EffectivePythonItem6:
    standard: @{EffectivePython}
    ruleId: item-6
    title: Wrap one-item tuples in parentheses
    statement:
        Write a tuple of one element with parentheses as well as the
        trailing comma.
    rationale:
        A stray trailing comma silently turns a value into a tuple. The
        parentheses make the intent visible.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        limit = 10,
        \\\
        ```
    compliant:
        ```python
        \\\
        limits = (10,)
        \\\
        ```
    languages: [python]
    tags: [pythonic-thinking, tuples, readability]
    source: https://effectivepython.com/
