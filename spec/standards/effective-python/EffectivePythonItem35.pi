use ../lib/CodingRule

from ./EffectivePython import EffectivePython

export coding-rule EffectivePythonItem35:
    standard: @{EffectivePython}
    ruleId: item-35
    title: Offer optional behaviour through keyword arguments
    statement:
        Give optional parameters defaults and have callers pass them by
        keyword, so the function can grow without breaking existing calls.
    rationale:
        Keyword arguments make calls self-explanatory and let new options be
        added later in a compatible way.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        resize(img, 640, 480, True, False)
        \\\
        ```
    compliant:
        ```python
        \\\
        resize(img, 640, 480, keep_aspect=True)
        \\\
        ```
    languages: [python]
    tags: [functions, arguments]
    source: https://effectivepython.com/
