use ../lib/CodingRule

from ./EffectivePython import EffectivePython

export coding-rule EffectivePythonItem116:
    standard: @{EffectivePython}
    ruleId: item-116
    title: Look for community packages before writing your own
    statement:
        Search the Python Package Index for an existing package before
        building common functionality, and install it with pip.
    rationale:
        Well-maintained community packages save time and are often more
        thoroughly tested than new code.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [collaboration, dependencies, packages]
    source: https://effectivepython.com/
