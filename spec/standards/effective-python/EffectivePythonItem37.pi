use ../lib/CodingRule

from ./EffectivePython import EffectivePython

export coding-rule EffectivePythonItem37:
    standard: @{EffectivePython}
    ruleId: item-37
    title: Mark parameters that must be named or must be positional
    statement:
        Put a bare star before parameters that callers must name, and a
        slash after parameters that callers must pass positionally.
    rationale:
        Keyword-only options keep calls readable, and positional-only names
        can be renamed later without breaking callers.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        def transfer(src, dst, amount, dry_run):
            ...

        transfer(a, b, 100, True)
        \\\
        ```
    compliant:
        ```python
        \\\
        def transfer(src, dst, /, amount, *, dry_run=False):
            ...

        transfer(a, b, 100, dry_run=True)
        \\\
        ```
    languages: [python]
    tags: [functions, arguments]
    source: https://effectivepython.com/
