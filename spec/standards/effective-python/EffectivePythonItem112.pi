use ../lib/CodingRule

from ./EffectivePython import EffectivePython

export coding-rule EffectivePythonItem112:
    standard: @{EffectivePython}
    ruleId: item-112
    title: Wrap dependencies so they are easy to mock
    statement:
        Put external dependencies behind a class or parameter that the code
        receives, rather than calling them directly, so tests can pass in
        fakes.
    rationale:
        Injected dependencies avoid fragile patching of module globals and
        make test setup short.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        def overdue():
            return [b for b in db.query_books() if b.due < date.today()]
        \\\
        ```
    compliant:
        ```python
        \\\
        def overdue(books, today):
            return [b for b in books.all() if b.due < today]
        \\\
        ```
    languages: [python]
    tags: [testing-and-debugging, testing, dependency-injection]
    source: https://effectivepython.com/
