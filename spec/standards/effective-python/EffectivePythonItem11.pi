use ../lib/CodingRule

from ./EffectivePython import EffectivePython

export coding-rule EffectivePythonItem11:
    standard: @{EffectivePython}
    ruleId: item-11
    title: Build formatted text with f-strings
    statement:
        Use f-strings for string formatting rather than the percent operator
        or str.format.
    rationale:
        F-strings put values next to where they appear, need no repeated
        names and support the full format specification language.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        msg = "%s has %d items" % (name, count)
        \\\
        ```
    compliant:
        ```python
        \\\
        msg = f"{name} has {count} items"
        \\\
        ```
    languages: [python]
    tags: [strings-and-slicing, strings, formatting]
    source: https://effectivepython.com/
