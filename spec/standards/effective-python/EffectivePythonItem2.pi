use ../lib/CodingRule

from ./EffectivePython import EffectivePython

export coding-rule EffectivePythonItem2:
    standard: @{EffectivePython}
    ruleId: item-2
    title: Format code according to PEP 8
    statement:
        Follow PEP 8 for whitespace, naming and expressions, and let an
        automatic formatter and linter enforce it.
    rationale:
        A shared style makes code easier for everyone to read and review,
        and tools remove arguments about layout.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        def CalcTotal( Items ):
            if not len(Items)==0 : return sum(Items)
        \\\
        ```
    compliant:
        ```python
        \\\
        def calc_total(items):
            if items:
                return sum(items)
        \\\
        ```
    languages: [python]
    tags: [pythonic-thinking, style, pep8]
    source: https://effectivepython.com/
