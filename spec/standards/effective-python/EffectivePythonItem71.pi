use ../lib/CodingRule

from ./EffectivePython import EffectivePython

export coding-rule EffectivePythonItem71:
    standard: @{EffectivePython}
    ruleId: item-71
    title: Recognise when a program needs concurrency
    statement:
        As programs grow, look for the point where work must be spread
        across many independent tasks, known as fan-out, and then collected,
        known as fan-in. That is when to reach for a concurrency tool.
    rationale:
        Knowing the shape of the problem helps pick an approach that scales
        instead of bolting threads on ad hoc.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [concurrency-and-parallelism, design]
    source: https://effectivepython.com/
