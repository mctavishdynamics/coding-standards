use ../lib/CodingRule

from ./EffectivePython import EffectivePython

export coding-rule EffectivePythonItem125:
    standard: @{EffectivePython}
    ruleId: item-125
    title: Package programs with open source tools rather than zipapp
    statement:
        To ship a Python program as a single artifact, prefer an established
        open source bundler over building it yourself with zipimport or
        zipapp.
    rationale:
        zip-based bundles cannot load native extensions or data files
        easily, while dedicated tools handle these cases.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [collaboration, packaging, deployment]
    source: https://effectivepython.com/
