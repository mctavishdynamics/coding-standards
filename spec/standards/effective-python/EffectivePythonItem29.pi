use ../lib/CodingRule

from ./EffectivePython import EffectivePython

export coding-rule EffectivePythonItem29:
    standard: @{EffectivePython}
    ruleId: item-29
    title: Replace deeply nested built-in containers with classes
    statement:
        When dictionaries, lists and tuples nest more than one level deep,
        break the data into small classes such as dataclasses or named
        tuples.
    rationale:
        Deep nesting makes code fragile and hard to read, and classes give
        names and structure to each layer.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        grades["ana"]["math"].append((90, 0.4))
        \\\
        ```
    compliant:
        ```python
        \\\
        @dataclass
        class Grade:
            score: int
            weight: float

        student("ana").subject("math").add(Grade(90, 0.4))
        \\\
        ```
    languages: [python]
    tags: [dictionaries, classes, data-modeling]
    source: https://effectivepython.com/
