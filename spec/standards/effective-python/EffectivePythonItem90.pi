use ../lib/CodingRule

from ./EffectivePython import EffectivePython

export coding-rule EffectivePythonItem90:
    standard: @{EffectivePython}
    ruleId: item-90
    title: Leave the built-in debug flag alone
    statement:
        Do not try to turn assertions off by setting __debug__ to False in
        code. Run Python with the optimise flag if you really need them off.
    rationale:
        Assigning to __debug__ is a syntax error in modern Python, and
        assertions are meant to stay on in development and usually in
        production.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [robustness, assertions, debugging]
    source: https://effectivepython.com/
