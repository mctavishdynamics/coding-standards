use ../lib/CodingRule

from ./EffectivePython import EffectivePython

export coding-rule EffectivePythonItem13:
    standard: @{EffectivePython}
    ruleId: item-13
    title: Join strings explicitly, especially inside lists
    statement:
        Avoid relying on adjacent string literals being joined
        automatically, particularly in lists and argument lists. Use the
        plus operator or a single literal.
    rationale:
        A missing comma between two literals silently merges them into one
        item instead of raising an error.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        colors = [
            "red",
            "green"
            "blue",
        ]
        \\\
        ```
    compliant:
        ```python
        \\\
        colors = [
            "red",
            "green",
            "blue",
        ]
        \\\
        ```
    languages: [python]
    tags: [strings-and-slicing, strings, bugs]
    source: https://effectivepython.com/
