use ../lib/CodingRule

from ./EffectivePython import EffectivePython

export coding-rule EffectivePythonItem73:
    standard: @{EffectivePython}
    ruleId: item-73
    title: Expect a Queue-based design to need restructuring
    statement:
        Moving to queues and worker threads for fan-out requires real
        refactoring and a fixed pool of workers. Weigh that cost before
        choosing it.
    rationale:
        Queue pipelines need careful shutdown, error propagation and sizing,
        and they get complex as stages are added.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [concurrency-and-parallelism, threads, queues, design]
    source: https://effectivepython.com/
