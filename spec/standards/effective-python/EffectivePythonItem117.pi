use ../lib/CodingRule

from ./EffectivePython import EffectivePython

export coding-rule EffectivePythonItem117:
    standard: @{EffectivePython}
    ruleId: item-117
    title: Give each project its own venv with pinned versions
    statement:
        Create a virtual environment for each project with venv, and record
        exact dependency versions so the environment can be rebuilt.
    rationale:
        Separate environments avoid version conflicts between projects and
        make builds reproducible.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [collaboration, dependencies, environments]
    source: https://effectivepython.com/
