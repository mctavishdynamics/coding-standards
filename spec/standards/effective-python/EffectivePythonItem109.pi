use ../lib/CodingRule

from ./EffectivePython import EffectivePython

export coding-rule EffectivePythonItem109:
    standard: @{EffectivePython}
    ruleId: item-109
    title: Spend most testing effort on components working together
    statement:
        Put most effort into tests that exercise components working
        together, and use unit tests mainly for tricky logic in isolation.
    rationale:
        In a dynamic language, integration tests catch the interface and
        type mistakes that isolated unit tests miss.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [testing-and-debugging, testing]
    source: https://effectivepython.com/
