use ../lib/CodingRule

from ./EffectivePython import EffectivePython

export coding-rule EffectivePythonItem114:
    standard: @{EffectivePython}
    ruleId: item-114
    title: Debug interactively with pdb
    statement:
        Call breakpoint() where you want to stop and inspect a running
        program, or use post-mortem debugging after a crash.
    rationale:
        An interactive debugger lets you inspect state and step through code
        faster than adding print calls.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```python
        \\\
        def reconcile(ledger):
            for entry in ledger:
                if entry.amount < 0:
                    breakpoint()
        \\\
        ```
    languages: [python]
    tags: [testing-and-debugging, debugging]
    source: https://effectivepython.com/
