use ../lib/CodingRule

from ./EffectivePython import EffectivePython

export coding-rule EffectivePythonItem94:
    standard: @{EffectivePython}
    ruleId: item-94
    title: Weigh the cost before moving code to another language
    statement:
        Rewriting parts of a program in a faster language can help, but
        first try better algorithms, libraries such as NumPy or tools such
        as Cython. Move only the hot spots, and only when the gain justifies
        the cost.
    rationale:
        Native code brings build complexity, new failure modes and
        maintenance burden.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [performance, native-code]
    source: https://effectivepython.com/
