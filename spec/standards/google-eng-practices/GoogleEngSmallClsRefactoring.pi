use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSmallClsRefactoring:
    standard: @{GoogleEngPractices}
    ruleId: developer/small-cls/refactoring
    title: Put refactorings in separate CLs from features and fixes
    statement:
        Do refactorings such as moving or renaming a class in a different CL
        from a feature change or a bug fix in that code.
    rationale:
        Reviewers understand each change much more easily when they are
        separate.
    exceptions:
        Small cleanups, such as renaming a local variable, can go in a
        feature or fix CL; developers and reviewers judge when a refactoring
        is too big to include.
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, refactoring, cl-size]
    source: https://google.github.io/eng-practices/review/developer/small-cls.html#refactoring
