use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSpeedInterruption:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/speed/interruption
    title: Do not break off focused work to review
    statement:
        If you are in a focused task such as writing code, finish it or
        reach a natural break, such as after lunch or a meeting, before
        responding to a review request.
    rationale:
        Getting back into flow after an interruption takes a long time, so
        interrupting yourself costs the team more than a short wait for the
        author.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, speed, focus]
    source: https://google.github.io/eng-practices/review/reviewer/speed.html#interruption
