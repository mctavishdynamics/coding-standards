use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSpeedInterruption:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/speed/interruption
    title: Finish focused work before turning to a review
    statement:
        While deep in a task like coding, keep going until it is done or you
        hit a natural pause, for example returning from lunch or leaving a
        meeting, and handle pending review requests then.
    rationale:
        Regaining concentration after a break is slow, so stopping mid-task
        costs more overall than making the author wait a little.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, speed, focus]
    source: https://google.github.io/eng-practices/review/reviewer/speed.html#interruption
