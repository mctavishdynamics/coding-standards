use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngClDescriptionsGenerated:
    standard: @{GoogleEngPractices}
    ruleId: developer/cl-descriptions/generated-cl-descriptions
    title: Make tool-generated CL descriptions follow the same advice
    statement:
        When a tool generates a CL, give it a short, focused standalone
        first line and a body with details that explain the change's effect,
        wherever possible.
    rationale:
        Readers of history and reviewers need the same information whether a
        person or a tool wrote the change.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, cl-description, automation]
    source: https://google.github.io/eng-practices/review/developer/cl-descriptions.html#generated-cl-descriptions
