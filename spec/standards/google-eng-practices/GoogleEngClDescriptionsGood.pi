use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngClDescriptionsGood:
    standard: @{GoogleEngPractices}
    ruleId: developer/cl-descriptions/good
    title: Describe what the CL does first, then the problem and solution
    statement:
        Open with words that say what the change actually does, then explain
        the problem, why this is a good solution, and implementation
        details. For refactorings also note how this differs from the past,
        any known shortcomings and the future direction; small CLs still
        need enough context to explain why.
    rationale:
        Descriptions shaped like this serve both reviewers and later code
        searchers.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, cl-description]
    source: https://google.github.io/eng-practices/review/developer/cl-descriptions.html#good
