use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngClDescriptionsGood:
    standard: @{GoogleEngPractices}
    ruleId: developer/cl-descriptions/good
    title: Lead the CL description with a summary of the change
    statement:
        Start with a line stating plainly what the change does, then cover
        the problem, the reasons the chosen approach fits and notable
        implementation choices. A refactoring description also says how the
        new design departs from the old one, its known limits and where it
        is heading, and even a tiny CL needs enough background for a reader
        to see its purpose.
    rationale:
        A description built this way helps the reviewer today and anyone
        searching the history later.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, cl-description]
    source: https://google.github.io/eng-practices/review/developer/cl-descriptions.html#good
