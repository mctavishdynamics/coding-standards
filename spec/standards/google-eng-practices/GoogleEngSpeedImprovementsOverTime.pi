use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSpeedImprovementsOverTime:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/speed/time
    title: Do not trade review standards for imagined speed
    statement:
        Stay strict about code review standards. Over time authors learn
        what healthy code needs and reviewers learn to respond quickly, so
        reviews get faster without lowering the bar.
    rationale:
        Compromising on quality for speed does not actually make delivery
        faster in the long run.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, speed, code-health]
    source: https://google.github.io/eng-practices/review/reviewer/speed.html#time
