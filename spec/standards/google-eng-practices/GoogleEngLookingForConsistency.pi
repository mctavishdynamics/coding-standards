use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngLookingForConsistency:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/looking-for/consistency
    title: Follow the style guide even where existing code does not
    statement:
        Mandatory points in the style guide apply to new code even when
        nearby code ignores them. For points the guide only recommends, side
        with the guide unless breaking from the local pattern would confuse
        a reader. When nothing else settles the question, match the existing
        code, and ask the author to open a bug and leave a TODO so the old
        code gets tidied later.
    rationale:
        The style guide is the authority, but readability within a file also
        matters, and tracked cleanup keeps old inconsistencies from
        spreading.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, consistency, style]
    source: https://google.github.io/eng-practices/review/reviewer/looking-for.html#consistency
