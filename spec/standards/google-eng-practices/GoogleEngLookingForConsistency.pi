use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngLookingForConsistency:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/looking-for/consistency
    title: Follow the style guide even where existing code does not
    statement:
        If the style guide requires something, the new code follows it even
        when the surrounding code is inconsistent. Where the guide only
        recommends, lean toward the guide unless the local inconsistency
        would confuse readers. If no other rule applies, stay consistent
        with existing code, and encourage the author to file a bug and add a
        TODO for cleaning up old code.
    rationale:
        The style guide is the authority, but readability within a file also
        matters, and tracked cleanup keeps old inconsistencies from
        spreading.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, consistency, style]
    source: https://google.github.io/eng-practices/review/reviewer/looking-for.html#consistency
