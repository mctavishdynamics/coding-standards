use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSmallClsSplittingHorizontally:
    standard: @{GoogleEngPractices}
    ruleId: developer/small-cls/splitting-horizontally
    title: Split horizontally across layers with shared code or stubs
    statement:
        Introduce shared interfaces or stubs that isolate one layer of the
        stack from another, such as client, API, service and data model, so
        each layer can be changed in its own CL.
    rationale:
        This speeds development and encourages clean abstraction between
        layers.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, cl-size, architecture]
    source: https://google.github.io/eng-practices/review/developer/small-cls.html#splitting-horizontally
