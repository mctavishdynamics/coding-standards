use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngLookingForEveryLine:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/looking-for/every-line
    title: Look at every line you were asked to review
    statement:
        Read every human-written line assigned to you and be sure you
        understand what it does; data files, generated code and large data
        structures may be scanned. If the code is too hard to read, tell the
        author and wait for clarification. If you are not qualified for some
        part, such as security, privacy, concurrency, accessibility or
        internationalization, make sure a qualified reviewer is on the CL.
    rationale:
        Code a reviewer cannot understand will likely confuse other
        developers too, and specialist risks need specialist eyes.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, thoroughness]
    source: https://google.github.io/eng-practices/review/reviewer/looking-for.html#every-line
