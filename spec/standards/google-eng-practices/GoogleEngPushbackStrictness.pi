use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngPushbackStrictness:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/pushback/strictness
    title: Answer complaints about strictness by reviewing faster
    statement:
        When moving from lax to strict reviews draws complaints, keep the
        standard and improve review speed.
    rationale:
        Complaints usually fade, sometimes over months, as developers see
        the quality strict reviews produce.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, pushback, speed]
    source: https://google.github.io/eng-practices/review/reviewer/pushback.html#strictness
