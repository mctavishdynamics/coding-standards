use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngPushbackWhoIsRight:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/pushback/who_is_right
    title: Consider the author's pushback, then explain or concede
    statement:
        When an author disagrees, first consider whether they are right,
        since they are often closer to the code; if so, say so and drop the
        point. If not, explain further, showing you understood their reply,
        and keep advocating for changes that improve code health enough to
        justify the work. Stay polite throughout.
    rationale:
        Authors sometimes have better insight, but code health improves in
        small steps that are worth defending.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, pushback, communication]
    source: https://google.github.io/eng-practices/review/reviewer/pushback.html#who_is_right
