use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngEmergenciesDeadlines:
    standard: @{GoogleEngPractices}
    ruleId: emergencies/deadlines
    title: Sacrifice code health only for hard deadlines
    statement:
        Treat a deadline as hard only when missing it would be disastrous,
        such as a contractual obligation, a product failing in the market,
        or a once-a-year hardware shipment. Do not sacrifice code health for
        soft deadlines; if late-cycle rushes are routine, change the process
        so large features land early with time for review.
    rationale:
        Most deadlines are soft, and repeatedly rushing changes in under
        them builds up overwhelming technical debt.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, emergencies, code-health]
    source: https://google.github.io/eng-practices/review/emergencies.html#deadlines
