use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSmallClsTestCode:
    standard: @{GoogleEngPractices}
    ruleId: developer/small-cls/test-code
    title: Keep related test code in the same CL
    statement:
        A CL that adds or changes logic includes new or updated tests for
        that behavior, and pure refactorings should be covered by tests,
        adding them if missing. Independent test work, such as new tests for
        existing code, test refactoring or larger test frameworks, may go in
        separate CLs first.
    rationale:
        Smallness means focus, not line count; tests belong with the
        behavior they check, and tests landed before a refactoring prove
        behavior is unchanged.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, testing, cl-size]
    source: https://google.github.io/eng-practices/review/developer/small-cls.html#test-code
