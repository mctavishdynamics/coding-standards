use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSmallClsTestCode:
    standard: @{GoogleEngPractices}
    ruleId: developer/small-cls/test-code
    title: Ship tests together with the code they cover
    statement:
        When a CL changes or adds behavior, the tests for that behavior come
        in the same CL, and a refactoring should land with test coverage,
        written first if none exists. Test work that stands alone, like
        covering old code, restructuring tests or building test
        infrastructure, can be sent as its own earlier CLs.
    rationale:
        Keeping a CL small is about a single focus rather than few lines.
        Tests stay with the behavior they verify, and tests submitted ahead
        of a refactoring show that it preserves behavior.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, testing, cl-size]
    source: https://google.github.io/eng-practices/review/developer/small-cls.html#test-code
