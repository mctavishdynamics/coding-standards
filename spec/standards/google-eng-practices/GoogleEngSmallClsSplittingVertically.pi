use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSmallClsSplittingVertically:
    standard: @{GoogleEngPractices}
    ruleId: developer/small-cls/splitting-vertically
    title: Split vertically into small full-stack features
    statement:
        Break the work into smaller end-to-end features that can be built as
        independent parallel tracks, even if they share some code.
    rationale:
        Some tracks can progress while others wait for review or feedback.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, cl-size]
    source: https://google.github.io/eng-practices/review/developer/small-cls.html#splitting-vertically
