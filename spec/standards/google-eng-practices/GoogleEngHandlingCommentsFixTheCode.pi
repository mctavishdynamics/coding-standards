use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngHandlingCommentsFixTheCode:
    standard: @{GoogleEngPractices}
    ruleId: developer/handling-comments/code
    title: Answer confusion by clarifying the code
    statement:
        When a reviewer does not understand something, first make the code
        itself clearer. If that is not possible, add a code comment
        explaining why the code is there. Reply only in the review tool when
        such a comment would be pointless.
    rationale:
        Future readers will likely be confused too, and they will see the
        code and its comments, not the review discussion.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, readability, comments]
    source: https://google.github.io/eng-practices/review/developer/handling-comments.html#code
