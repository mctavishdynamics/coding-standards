use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngClDescriptionsReviewBeforeSubmit:
    standard: @{GoogleEngPractices}
    ruleId: developer/cl-descriptions/review-the-description-before-submitting-the-cl
    title: Recheck the description before submitting
    statement:
        Before submitting, reread the description and update it so it still
        matches what the CL does after review changes.
    rationale:
        CLs can change significantly during review, leaving the original
        description wrong.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, cl-description]
    source: https://google.github.io/eng-practices/review/developer/cl-descriptions.html#review-the-description-before-submitting-the-cl
