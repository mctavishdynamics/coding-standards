use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngPushbackCleaningUpLater:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/pushback/later
    title: Insist on cleanup now rather than in a later CL
    statement:
        Usually require authors to clean up a CL before it lands instead of
        accepting a promise to fix it later. New complexity must be removed
        before submission. If the CL exposes surrounding problems that
        cannot be fixed now, the author files a bug assigned to themselves,
        optionally with a TODO referring to it.
    rationale:
        Unless cleanup happens immediately it rarely happens at all, and
        deferred cleanup is a common way for codebases to decay.
    exceptions:
        In an emergency, new complexity may be cleaned up after submission.
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, pushback, code-health]
    source: https://google.github.io/eng-practices/review/reviewer/pushback.html#later
