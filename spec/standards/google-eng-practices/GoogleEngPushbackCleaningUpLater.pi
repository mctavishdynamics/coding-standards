use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngPushbackCleaningUpLater:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/pushback/later
    title: Ask for cleanup before submission, not after
    statement:
        As a rule, have the author tidy a CL before it is submitted rather
        than accept a pledge to do it afterwards, and any complexity the CL
        introduces has to go before it lands. When the change reveals nearby
        problems that are out of scope, the author opens a bug for
        themselves and may add a TODO pointing at it.
    rationale:
        Cleanup that is put off tends never to happen, and this pattern is
        one of the usual paths by which a codebase degrades.
    exceptions:
        During an emergency, complexity introduced by the CL may be removed
        after it is submitted.
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, pushback, code-health]
    source: https://google.github.io/eng-practices/review/reviewer/pushback.html#later
