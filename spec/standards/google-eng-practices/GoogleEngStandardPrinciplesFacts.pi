use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngStandardPrinciplesFacts:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/standard/principles-facts
    title: Let technical facts and data overrule opinions
    statement:
        When reviewer and author disagree, decide on the basis of technical
        facts and data, not personal preference.
    rationale:
        Facts can be checked and agreed on; preferences cannot, so arguments
        based on them never settle.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, decision-making]
    source: https://google.github.io/eng-practices/review/reviewer/standard.html#principles
