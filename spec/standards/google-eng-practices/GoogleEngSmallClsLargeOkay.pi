use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSmallClsLargeOkay:
    standard: @{GoogleEngPractices}
    ruleId: developer/small-cls/large-okay
    title: Know the cases where a large CL is acceptable
    statement:
        Treat deleting a whole file as roughly one line of change, and
        accept larger CLs produced by a fully trusted automatic refactoring
        tool, where the reviewer mainly confirms the change is wanted.
    rationale:
        These changes take little effort to review, though merging and
        testing concerns still apply.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, cl-size]
    source: https://google.github.io/eng-practices/review/developer/small-cls.html#large-okay
