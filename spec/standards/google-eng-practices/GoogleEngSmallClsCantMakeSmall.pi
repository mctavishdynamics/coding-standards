use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSmallClsCantMakeSmall:
    standard: @{GoogleEngPractices}
    ruleId: developer/small-cls/cant
    title: Look hard for a way to split a large change
    statement:
        Large CLs are seldom unavoidable. Start by checking whether a pure
        refactoring could land separately, and ask colleagues how the work
        might be divided. When splitting really is impossible, warn the
        reviewers and get their agreement beforehand, then plan for a long
        review, take extra care to avoid bugs and write especially thorough
        tests.
    rationale:
        With practice, authors nearly always find a way to break work into
        smaller pieces, and reviewers who are told in advance can make time
        for a big one.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, cl-size]
    source: https://google.github.io/eng-practices/review/developer/small-cls.html#cant
