use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSmallClsCantMakeSmall:
    standard: @{GoogleEngPractices}
    ruleId: developer/small-cls/cant
    title: Try hard to decompose a change before writing a large CL
    statement:
        A CL rarely has to be large. Consider a refactoring-only CL first
        and ask teammates for ways to split the work. If it truly cannot be
        split, get reviewers' consent in advance, and expect a long review,
        guard against bugs and be extra thorough with tests.
    rationale:
        Authors who practice small CLs can almost always find a
        decomposition, and forewarned reviewers can plan for a large one.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, cl-size]
    source: https://google.github.io/eng-practices/review/developer/small-cls.html#cant
