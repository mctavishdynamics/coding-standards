use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSpeedLgtmWithComments:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/speed/lgtm-with-comments
    title: Grant approval with unresolved comments where appropriate
    statement:
        Approve a CL that still has open comments if you are confident the
        author will address them sensibly, if the comments are optional, or
        if they are trivial, like import order or a spelling slip. Make
        clear which of these situations you mean when it might be ambiguous.
    rationale:
        Approving now avoids another complete review cycle, a saving that
        counts most when the two people work hours apart.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, speed, approval]
    source: https://google.github.io/eng-practices/review/reviewer/speed.html#lgtm-with-comments
