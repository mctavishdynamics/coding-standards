use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSpeedLgtmWithComments:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/speed/lgtm-with-comments
    title: Approve with open comments when it is safe to do so
    statement:
        Give approval while leaving unresolved comments when you trust the
        author to handle them, when they are optional, or when they are
        minor, such as sorting imports or fixing a typo. Say which case
        applies if it is not clear.
    rationale:
        This saves a full extra round trip, which matters most when author
        and reviewer are in different time zones.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, speed, approval]
    source: https://google.github.io/eng-practices/review/reviewer/speed.html#lgtm-with-comments
