use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngCommentsGuidance:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/comments/guidance
    title: Balance pointing out problems with giving direct guidance
    statement:
        Fixing the CL is the author's job, so the reviewer need not design
        the solution or write the code. Often point out the problem and let
        the author decide; at other times give direct suggestions or code
        when that helps more. Also comment on what you like, and say why.
    rationale:
        Letting the author solve problems helps them learn and can produce a
        better result, since they know the code best. The main goal is the
        best CL; a second goal is authors who need less review over time.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, mentoring, communication]
    source: https://google.github.io/eng-practices/review/reviewer/comments.html#guidance
