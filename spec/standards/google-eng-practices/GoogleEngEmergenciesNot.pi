use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngEmergenciesNot:
    standard: @{GoogleEngPractices}
    ruleId: emergencies/not
    title: Do not treat ordinary pressure as an emergency
    statement:
        A wish to launch this week instead of next, a long-running feature,
        reviewers being asleep or away, a Friday evening, a manager's soft
        deadline, or rolling back a CL that breaks tests or the build are
        not emergencies.
    rationale:
        Treating ordinary urgency as an emergency bypasses review quality
        for no real benefit.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, emergencies]
    source: https://google.github.io/eng-practices/review/emergencies.html#not
