use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngLookingForGoodThings:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/looking-for/good-things
    title: Tell the author when they did something well
    statement:
        When you see something good in the change, especially a comment
        addressed in a great way, say so.
    rationale:
        Reviews tend to dwell on mistakes. Encouragement reinforces good
        practice and can teach more than criticism.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, mentoring, encouragement]
    source: https://google.github.io/eng-practices/review/reviewer/looking-for.html#good-things
