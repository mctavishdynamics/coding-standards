use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSpeedFast:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/speed/fast
    title: Answer review requests within a business day
    statement:
        Look at an incoming CL soon after it arrives, unless doing so would
        break your concentration on other work. Never let a reply wait
        longer than one business day, so that a normal CL can complete
        several rounds of review in a single day.
    rationale:
        Short turnaround keeps work flowing and spares authors long idle
        waits between rounds.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, speed]
    source: https://google.github.io/eng-practices/review/reviewer/speed.html#fast
