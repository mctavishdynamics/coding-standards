use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSpeedFast:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/speed/fast
    title: Respond to review requests within one business day
    statement:
        Unless you are in the middle of a focused task, review a CL shortly
        after it arrives. Take at most one business day to respond, so a
        typical CL can go through several review rounds in a day.
    rationale:
        Quick turnaround keeps changes moving and avoids long waits for each
        round.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, speed]
    source: https://google.github.io/eng-practices/review/reviewer/speed.html#fast
