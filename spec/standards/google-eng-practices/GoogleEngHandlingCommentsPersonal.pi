use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngHandlingCommentsPersonal:
    standard: @{GoogleEngPractices}
    ruleId: developer/handling-comments/personal
    title: Respond calmly to critical review comments
    statement:
        Treat critique as an effort to improve your code and the codebase,
        and find the useful point even in a comment written in frustration.
        Do not answer while angry; wait until you can reply with courtesy.
        When a reviewer keeps being unhelpful, raise it with them face to
        face or in private, and involve your manager if that does not
        resolve it.
    rationale:
        A hostile reply is unprofessional, and it remains visible in the
        review history long after the moment passes.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, courtesy, communication]
    source: https://google.github.io/eng-practices/review/developer/handling-comments.html#personal
