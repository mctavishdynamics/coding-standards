use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngHandlingCommentsPersonal:
    standard: @{GoogleEngPractices}
    ruleId: developer/handling-comments/personal
    title: Do not take review comments personally or reply in anger
    statement:
        Read critique as help for you and the codebase, and look for the
        constructive point even in a frustrated comment. Never reply in
        anger; step away until you can respond politely. If a reviewer is
        not constructive, tell them kindly in person or privately, and
        escalate to your manager if that fails.
    rationale:
        An angry reply is a serious breach of professional etiquette and
        stays in the review tool permanently.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, courtesy, communication]
    source: https://google.github.io/eng-practices/review/developer/handling-comments.html#personal
