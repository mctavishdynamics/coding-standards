use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngLookingForDesign:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/looking-for/design
    title: Review the overall design of the CL first
    statement:
        Check that the pieces of the change interact sensibly, that the code
        belongs in this codebase rather than a library, that it fits the
        rest of the system, and that now is the right time to add it.
    rationale:
        Design is the most important thing a review covers; a poor design is
        costly to fix later and makes detailed review of the rest pointless.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, design]
    source: https://google.github.io/eng-practices/review/reviewer/looking-for.html#design
