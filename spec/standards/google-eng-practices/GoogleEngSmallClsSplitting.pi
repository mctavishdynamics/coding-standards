use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSmallClsSplitting:
    standard: @{GoogleEngPractices}
    ruleId: developer/small-cls/splitting
    title: Plan how to split dependent work before coding
    statement:
        When work will span several dependent CLs, decide at a high level
        how to split and order them before writing code.
    rationale:
        Planning the split makes the CLs easier to manage for the author and
        easier to review.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, cl-size, planning]
    source: https://google.github.io/eng-practices/review/developer/small-cls.html#splitting
