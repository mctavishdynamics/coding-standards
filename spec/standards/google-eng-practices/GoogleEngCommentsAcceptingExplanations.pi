use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngCommentsAcceptingExplanations:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/comments/explanations
    title: Ask for clearer code rather than accepting explanations in the tool
    statement:
        When you ask about code you do not understand, the usual result
        should be clearer code, or sometimes a code comment that is not just
        excusing complexity. An explanation that exists only in the review
        tool rarely suffices.
    rationale:
        Future readers of the code never see review-tool discussions.
    exceptions:
        An explanation in the tool is fine when the reviewer is unfamiliar
        with the area and the answer is something normal readers of that
        code would already know.
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, readability, comments]
    source: https://google.github.io/eng-practices/review/reviewer/comments.html#explanations
