use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngLookingForComplexity:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/looking-for/complexity
    title: Reject unnecessary complexity and over-engineering
    statement:
        Check every level, from lines to functions to classes, for code that
        readers cannot understand quickly or that callers and maintainers
        are likely to break. Be especially alert to over-engineering; ask
        authors to solve the problem they have now, not one they speculate
        about.
    rationale:
        Complex code is slow to read and easy to break. Speculative
        generality adds cost today for a future problem whose real shape is
        not yet known.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, complexity, simplicity]
    source: https://google.github.io/eng-practices/review/reviewer/looking-for.html#complexity
