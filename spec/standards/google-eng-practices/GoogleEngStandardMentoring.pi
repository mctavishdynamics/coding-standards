use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngStandardMentoring:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/standard/mentoring
    title: Use review comments to teach, and mark educational ones as optional
    statement:
        Feel free to leave comments that teach the author something about a
        language, a framework or design principles. When such a comment is
        not needed to meet the review standard, prefix it with Nit or
        otherwise say it need not be resolved in this change.
    rationale:
        Sharing knowledge improves code health over time, but authors should
        not be blocked on lessons that are not required.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, mentoring, comments]
    source: https://google.github.io/eng-practices/review/reviewer/standard.html#mentoring
