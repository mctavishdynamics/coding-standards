use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngStandardOfCodeReview:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/standard/the-standard-of-code-review
    title: Approve a CL once it definitely improves overall code health
    statement:
        Favor approving a change as soon as it clearly leaves the code
        health of the system better than before, even if it is not perfect.
        Seek continuous improvement rather than perfection, and mark
        optional polish points with a prefix such as Nit so the author knows
        they may skip them.
    rationale:
        Developers must be able to make progress, and a reviewer who makes
        every change hard to land discourages future improvements. Code
        health still has to be protected, because codebases usually decay
        through many small regressions.
    exceptions:
        A reviewer may refuse a well-built change that adds a feature they
        do not want in the system. Nothing here allows a change that clearly
        worsens code health, except in an emergency.
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, code-health, approval]
    source: https://google.github.io/eng-practices/review/reviewer/standard.html#the-standard-of-code-review
