use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngStandardOfCodeReview:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/standard/the-standard-of-code-review
    title: Approve changes that clearly improve code health
    statement:
        Lean toward approving a CL once it leaves the system in better shape
        than it found it, whether or not it is flawless. Aim for steady
        improvement rather than a perfect result, and label optional
        suggestions with a marker like Nit so the author can treat them as
        optional.
    rationale:
        Progress depends on changes landing, and a reviewer who blocks every
        change discourages people from improving things. Code health still
        needs defending, since systems usually degrade through an
        accumulation of small regressions.
    exceptions:
        A reviewer can decline a well-designed CL whose feature they do not
        want in the system. Apart from emergencies, no CL that clearly harms
        code health should be approved.
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, code-health, approval]
    source: https://google.github.io/eng-practices/review/reviewer/standard.html#the-standard-of-code-review
