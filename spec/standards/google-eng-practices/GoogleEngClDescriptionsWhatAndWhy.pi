use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngClDescriptionsWhatAndWhy:
    standard: @{GoogleEngPractices}
    ruleId: developer/cl-descriptions/writing-good-cl-descriptions
    title: Make the CL description say what changed and why
    statement:
        Write the description as a permanent public record that summarizes
        what the change does and why it is being made, including context and
        decisions not visible in the code.
    rationale:
        Future developers search history by description and need the reason
        for a change to know whether it is safe to undo.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, cl-description, version-control]
    source: https://google.github.io/eng-practices/review/developer/cl-descriptions.html#writing-good-cl-descriptions
