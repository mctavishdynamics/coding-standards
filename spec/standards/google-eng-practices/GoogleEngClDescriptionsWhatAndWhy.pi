use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngClDescriptionsWhatAndWhy:
    standard: @{GoogleEngPractices}
    ruleId: developer/cl-descriptions/writing-good-cl-descriptions
    title: Explain the change and its reason in the CL description
    statement:
        Treat the description as a lasting record in version history.
        Summarize the change and its motivation, and include background and
        decisions that a reader could not recover from the diff alone.
    rationale:
        Later developers find changes by searching descriptions, and they
        need the motivation to judge whether reverting a change would break
        something.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, cl-description, version-control]
    source: https://google.github.io/eng-practices/review/developer/cl-descriptions.html#writing-good-cl-descriptions
