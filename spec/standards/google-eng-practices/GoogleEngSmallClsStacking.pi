use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSmallClsStacking:
    standard: @{GoogleEngPractices}
    ruleId: developer/small-cls/stacking
    title: Stack dependent CLs on top of each other
    statement:
        Send one small CL for review and immediately start the next one
        based on it, using your version control system's support for stacked
        changes.
    rationale:
        This splits work into reviewable pieces without blocking the author.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, cl-size, version-control]
    source: https://google.github.io/eng-practices/review/developer/small-cls.html#stacking
