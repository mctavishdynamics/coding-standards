use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngStandardPrinciplesDesign:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/standard/principles-design
    title: Weigh design choices on engineering principles, not taste
    statement:
        Treat software design questions as matters of principle, almost
        never as pure style. If the author shows with data or sound
        engineering reasoning that several approaches are equally valid,
        accept the author's choice; otherwise follow standard design
        principles.
    rationale:
        Design affects maintainability and correctness, so it should be
        judged on reasons that can be stated and tested rather than on
        opinion.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, design, decision-making]
    source: https://google.github.io/eng-practices/review/reviewer/standard.html#principles
