use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngPushbackConflicts:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/pushback/conflicts
    title: Use the review standard to settle unresolved pushback
    statement:
        If a disagreement with the author remains after following the
        pushback guidance, resolve it using the principles and conflict
        process in the standard of code review.
    rationale:
        A shared, written set of principles gives both sides a neutral basis
        for a decision.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, conflict-resolution]
    source: https://google.github.io/eng-practices/review/reviewer/pushback.html#conflicts
