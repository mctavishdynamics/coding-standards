use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSpeedResponses:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/speed/responses
    title: Keep individual responses fast, even if the whole review takes longer
    statement:
        Aim for fast individual replies throughout the review. If you are
        too busy for a full review, say when you will get to it, suggest
        other reviewers or send initial broad comments. Still spend enough
        time that your LGTM really means the code meets the standard.
    rationale:
        Quick replies ease the frustration of a long review process far more
        than shortening the whole process does.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, speed, communication]
    source: https://google.github.io/eng-practices/review/reviewer/speed.html#responses
