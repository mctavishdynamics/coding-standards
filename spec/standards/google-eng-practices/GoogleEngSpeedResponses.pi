use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSpeedResponses:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/speed/responses
    title: Reply quickly at each step, even when the review runs long
    statement:
        Keep each response prompt through the whole review. When you lack
        time for a complete review, give the author an estimate, point them
        to other possible reviewers or post some high-level feedback first.
        Do not rush the approval itself, which must still mean the code
        meets the bar.
    rationale:
        Developers are frustrated less by a long review overall than by slow
        answers at each step, so prompt replies help more.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, speed, communication]
    source: https://google.github.io/eng-practices/review/reviewer/speed.html#responses
