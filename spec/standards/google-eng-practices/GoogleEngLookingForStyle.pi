use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngLookingForStyle:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/looking-for/style
    title: Enforce the style guide, and keep big style changes separate
    statement:
        Make sure the change follows the relevant style guide. Prefix a
        style point the guide does not cover with Nit and do not block on
        personal style preferences. Ask authors to send major reformatting
        as its own CL, separate from functional changes.
    rationale:
        Mixing reformatting with real changes hides what changed and makes
        merges and rollbacks harder.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, style, formatting]
    source: https://google.github.io/eng-practices/review/reviewer/looking-for.html#style
