use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSmallClsSplittingFiles:
    standard: @{GoogleEngPractices}
    ruleId: developer/small-cls/splitting-files
    title: Split CLs by groups of files with different reviewers
    statement:
        Separate self-contained groups of files, such as a protocol buffer
        change and the code that uses it, or code and the configuration that
        turns it on, into separate CLs that can be reviewed at the same
        time. Tell each set of reviewers about the other CL.
    rationale:
        Different reviewers can work in parallel, and separate configuration
        CLs are easier to roll back.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, cl-size]
    source: https://google.github.io/eng-practices/review/developer/small-cls.html#splitting-files
