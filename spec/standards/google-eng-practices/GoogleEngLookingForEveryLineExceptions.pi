use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngLookingForEveryLineExceptions:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/looking-for/every-line-exceptions
    title: Say which parts you reviewed when reviewing only part of a CL
    statement:
        When you are one of several reviewers and asked to look at only some
        files or aspects, note in a comment which parts you reviewed, and
        prefer giving LGTM with comments. If you will approve only after
        others review their parts, say so explicitly and respond quickly
        once the CL is ready.
    rationale:
        Clear statements of scope set expectations and avoid gaps where
        everyone assumes someone else reviewed a part.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, thoroughness, communication]
    source: https://google.github.io/eng-practices/review/reviewer/looking-for.html#every-line-exceptions
