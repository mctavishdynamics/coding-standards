use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngLookingForEveryLineExceptions:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/looking-for/every-line-exceptions
    title: State your review scope when you cover only part of a CL
    statement:
        If several reviewers share a CL and you were asked to check certain
        files or concerns, leave a comment listing what you looked at, and
        lean toward approving with comments. If your approval depends on
        other reviewers finishing their parts, make that explicit and act
        promptly when they are done.
    rationale:
        Saying exactly what you covered sets expectations and keeps parts of
        the change from going unreviewed because each reviewer counted on
        another.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, thoroughness, communication]
    source: https://google.github.io/eng-practices/review/reviewer/looking-for.html#every-line-exceptions
