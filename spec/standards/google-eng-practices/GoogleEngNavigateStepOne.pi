use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngNavigateStepOne:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/navigate/step_one
    title: Start by checking that the change makes sense at all
    statement:
        Read the CL description and get a broad view of what the change
        does. If it should not happen at all, reply immediately and
        courteously explaining why, and suggest what the author could do
        instead. If this happens often, change the team process so that
        there is more discussion before CLs are written.
    rationale:
        Saying no early saves the author from work that would be thrown
        away, and courtesy shows respect even in disagreement.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, process, navigation]
    source: https://google.github.io/eng-practices/review/reviewer/navigate.html#step_one
