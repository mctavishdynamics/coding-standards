use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSpeedEmergencies:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/speed/emergencies
    title: Relax review quality only for genuine emergencies
    statement:
        Move a CL through the whole review process quickly with relaxed
        quality only when it is a real emergency as defined in the
        emergencies guidance.
    rationale:
        Many urgent-seeming situations are not emergencies, and treating
        them as such erodes code health.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, speed, emergencies]
    source: https://google.github.io/eng-practices/review/reviewer/speed.html#emergencies
