use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngLookingForNaming:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/looking-for/naming
    title: Check that every name is clear and appropriately long
    statement:
        Make sure each name is long enough to say fully what the item is or
        does, without being so long that it is hard to read.
    rationale:
        Good names let readers understand code without tracing its
        definition.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, naming]
    source: https://google.github.io/eng-practices/review/reviewer/looking-for.html#naming
