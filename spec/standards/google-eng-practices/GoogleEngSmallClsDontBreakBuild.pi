use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSmallClsDontBreakBuild:
    standard: @{GoogleEngPractices}
    ruleId: developer/small-cls/break
    title: Keep the system working after each dependent CL lands
    statement:
        When several CLs depend on each other, make sure the whole system
        still builds and works after each one is submitted.
    rationale:
        Otherwise the build may be broken for other developers between
        submissions.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, build, cl-size]
    source: https://google.github.io/eng-practices/review/developer/small-cls.html#break
