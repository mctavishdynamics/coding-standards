use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSmallClsEfficiently:
    standard: @{GoogleEngPractices}
    ruleId: developer/small-cls/efficiently
    title: Arrange your work so you are not blocked waiting for review
    statement:
        Do not sit idle while a small CL waits for approval. Work on several
        projects, find reviewers who can respond at once, review in person,
        pair program or split CLs so you can keep going.
    rationale:
        Waiting for each small CL to be approved before starting the next
        wastes a lot of time.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, cl-size, workflow]
    source: https://google.github.io/eng-practices/review/developer/small-cls.html#efficiently
