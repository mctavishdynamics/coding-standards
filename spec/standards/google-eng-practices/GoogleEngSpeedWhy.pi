use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSpeedWhy:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/speed/why
    title: Optimize reviews for team velocity, not individual speed
    statement:
        Treat prompt code review as part of how the team delivers, because
        the speed of the whole team matters more than any one person's
        coding speed.
    rationale:
        Slow reviews delay features and fixes for everyone, make developers
        resent the process, and pressure reviewers into accepting weaker
        code while discouraging cleanups.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, speed, velocity]
    source: https://google.github.io/eng-practices/review/reviewer/speed.html#why
