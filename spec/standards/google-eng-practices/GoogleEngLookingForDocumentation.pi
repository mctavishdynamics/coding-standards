use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngLookingForDocumentation:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/looking-for/documentation
    title: Check that documentation is updated with the change
    statement:
        If the change alters how users build, test, interact with or release
        code, check that related documentation such as READMEs and generated
        reference docs is updated too. When code is deleted or deprecated,
        consider removing its documentation. Ask for documentation that is
        missing.
    rationale:
        Stale or missing documentation misleads users and future
        maintainers.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, documentation]
    source: https://google.github.io/eng-practices/review/reviewer/looking-for.html#documentation
