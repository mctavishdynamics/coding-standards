use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSpeedTimeZones:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/speed/tz
    title: Reply across time zones while the author can still act
    statement:
        When the author is in another time zone, try to respond before their
        working day ends, or at least before their next one begins.
    rationale:
        Missing the author's working hours turns each review round into a
        lost day.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, speed, time-zones]
    source: https://google.github.io/eng-practices/review/reviewer/speed.html#tz
