use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngLookingForContext:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/looking-for/context
    title: Review the change in the context of the file and the system
    statement:
        Look beyond the few lines the review tool shows; sometimes you need
        the whole file to see, for example, that a method has grown too
        long. Consider whether the change improves the system as a whole,
        and do not accept changes that degrade code health.
    rationale:
        Systems usually become complex through many small additions, so even
        small new complexity has to be stopped.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, code-health, context]
    source: https://google.github.io/eng-practices/review/reviewer/looking-for.html#context
