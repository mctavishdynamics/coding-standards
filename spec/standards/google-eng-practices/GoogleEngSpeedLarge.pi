use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSpeedLarge:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/speed/large
    title: Ask for large CLs to be split, or at least comment on the design
    statement:
        When a CL is too big to review soon, ask the author to split it into
        smaller CLs that build on each other. If it cannot be split, send
        comments on the overall design so the author can act.
    rationale:
        A reviewer should always unblock the author or give them a next step
        quickly, without giving up code health.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, speed, cl-size]
    source: https://google.github.io/eng-practices/review/reviewer/speed.html#large
