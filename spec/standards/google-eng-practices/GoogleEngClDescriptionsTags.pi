use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngClDescriptionsTags:
    standard: @{GoogleEngPractices}
    ruleId: developer/cl-descriptions/tags
    title: Keep tags short and few, especially in the first line
    statement:
        Tags that categorize CLs are optional. When you use them, decide
        whether they belong in the first line or the body, and keep
        first-line tags short so they do not hide the content.
    rationale:
        Long or numerous tags crowd out the summary that readers skim in
        history.
    exceptions: null
    severity: null
    noncompliant:
        ```text
        \\\
        [payments platform migration][checkout service team] Add retry to charge call.
        \\\
        ```
    compliant:
        ```text
        \\\
        [payments] Add retry to charge call.
        \\\
        ```
    languages: [any]
    tags: [author, cl-description]
    source: https://google.github.io/eng-practices/review/developer/cl-descriptions.html#tags
