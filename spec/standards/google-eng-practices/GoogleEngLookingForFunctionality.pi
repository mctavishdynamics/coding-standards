use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngLookingForFunctionality:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/looking-for/functionality
    title: Check that the CL does what was intended and serves its users
    statement:
        Confirm the change does what the author meant and that this is good
        for end users and for future developers of the code. Think about
        edge cases, look for concurrency problems and bugs visible from
        reading, ask for a demo of user-facing changes such as UI, and
        reason carefully through any parallel code for deadlocks and races.
    rationale:
        Authors test their own work, but UI effects and race conditions are
        hard to see by running the code and need a second person to think
        them through.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, correctness, concurrency]
    source: https://google.github.io/eng-practices/review/reviewer/looking-for.html#functionality
