use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngStandardPrinciplesConsistency:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/standard/principles-consistency
    title: Use consistency with existing code as the tiebreaker
    statement:
        If no style rule or principle settles a point, a reviewer can
        request that the new code follow the conventions already used in the
        codebase, provided this does not harm overall code health.
    rationale:
        Uniform code is easier to read and maintain, which makes consistency
        a sensible default when nothing more important decides.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, consistency]
    source: https://google.github.io/eng-practices/review/reviewer/standard.html#principles
