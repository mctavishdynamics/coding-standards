use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngStandardPrinciplesConsistency:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/standard/principles-consistency
    title: Fall back on consistency with the existing codebase
    statement:
        When no other rule applies, the reviewer may ask the author to match
        what the current codebase does, as long as that does not worsen
        overall code health.
    rationale:
        Consistency makes code easier to read and maintain when no stronger
        reason decides the question.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, consistency]
    source: https://google.github.io/eng-practices/review/reviewer/standard.html#principles
