use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngHandlingCommentsConflicts:
    standard: @{GoogleEngPractices}
    ruleId: developer/handling-comments/conflicts
    title: Seek consensus with the reviewer before anything else
    statement:
        Try first to reach consensus with your reviewer. If you cannot,
        follow the principles in the standard of code review.
    rationale:
        Agreement between the two people closest to the change is the
        fastest and most durable resolution.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, conflict-resolution]
    source: https://google.github.io/eng-practices/review/developer/handling-comments.html#conflicts
