use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngLookingForTests:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/looking-for/tests
    title: Expect sound, meaningful tests alongside the change
    statement:
        Request whatever mix of unit, integration and system tests fits the
        change, and expect them in the CL that carries the production code.
        Confirm that the tests break when the code is wrong, stay stable as
        unrelated code evolves, assert simple useful facts and are divided
        into sensible separate cases.
    rationale:
        Tests have no tests of their own, so a reviewer is the only check on
        their correctness. They also cost maintenance like any other code,
        so unnecessary complexity in them is a burden.
    exceptions:
        An emergency CL may ship first and receive its tests in a follow-up.
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, testing]
    source: https://google.github.io/eng-practices/review/reviewer/looking-for.html#tests
