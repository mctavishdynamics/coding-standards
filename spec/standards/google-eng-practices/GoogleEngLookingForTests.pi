use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngLookingForTests:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/looking-for/tests
    title: Require correct, useful tests in the same CL
    statement:
        Ask for unit, integration or end-to-end tests that suit the change,
        normally in the same CL as the production code. Check that the tests
        would fail when the code breaks, will not give false positives as
        the code changes, make simple and useful assertions, and are split
        sensibly into separate test methods.
    rationale:
        Nobody tests the tests, so a human must check that they are valid.
        Tests are code that has to be maintained too, so needless complexity
        in them is a cost.
    exceptions:
        Tests may follow later when the CL is handling an emergency.
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, testing]
    source: https://google.github.io/eng-practices/review/reviewer/looking-for.html#tests
