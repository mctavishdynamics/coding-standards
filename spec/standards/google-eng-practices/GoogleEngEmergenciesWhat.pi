use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngEmergenciesWhat:
    standard: @{GoogleEngPractices}
    ruleId: emergencies/what
    title: Reserve emergency handling for small, urgent fixes
    statement:
        Treat a CL as an emergency only when it is small and urgent, for
        instance a fix that spares a major launch from a rollback, repairs a
        defect hurting many production users, addresses an urgent legal
        problem or patches a serious security flaw. Put such a CL ahead of
        other reviews, judge mainly whether it resolves the problem quickly
        and correctly, and give it a full review once the crisis has passed.
    rationale:
        During a genuine crisis, getting the fix out fast outweighs
        everything else, yet the shortcuts taken must be revisited
        afterwards to repair code health.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, emergencies, speed]
    source: https://google.github.io/eng-practices/review/emergencies.html#what
