use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngEmergenciesWhat:
    standard: @{GoogleEngPractices}
    ruleId: emergencies/what
    title: Rush only small CLs that resolve a true emergency
    statement:
        An emergency CL is a small change that, for example, lets a major
        launch go ahead instead of rolling back, fixes a bug badly affecting
        production users, handles a pressing legal issue or closes a major
        security hole. Review it before other work, focusing on speed and on
        whether it actually fixes the emergency, and review it thoroughly
        once the emergency is over.
    rationale:
        In a real emergency the speed of the whole process matters most, but
        relaxed review must be followed up so code health is restored.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, emergencies, speed]
    source: https://google.github.io/eng-practices/review/emergencies.html#what
