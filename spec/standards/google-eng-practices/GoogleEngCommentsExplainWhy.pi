use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngCommentsExplainWhy:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/comments/why
    title: Explain the reasoning behind a comment
    statement:
        Where it helps, say why you are asking for something: your intent,
        the best practice you are following, or how the change improves code
        health.
    rationale:
        Understanding the reason helps the author learn and judge the
        suggestion on its merits.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, communication]
    source: https://google.github.io/eng-practices/review/reviewer/comments.html#why
