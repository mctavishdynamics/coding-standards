use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngStandardPrinciplesStyleGuide:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/standard/principles-style-guide
    title: Treat the style guide as the authority on style
    statement:
        On style, the style guide decides. A purely stylistic point the
        guide does not cover is personal preference; keep new code
        consistent with the code around it, and if there is no existing
        style, accept the author's choice.
    rationale:
        A single written authority ends style debates and keeps reviews
        focused on issues that matter.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, style]
    source: https://google.github.io/eng-practices/review/reviewer/standard.html#principles
