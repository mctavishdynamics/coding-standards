use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngPushbackUpsettingDevelopers:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/pushback/upsetting_developers
    title: Insist on quality politely rather than fearing to upset the author
    statement:
        Do not drop a needed improvement for fear of upsetting the author.
        Write your comments politely.
    rationale:
        Upset is usually brief and followed by gratitude, and it usually
        comes from how comments are worded rather than from insistence on
        quality.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, pushback, courtesy]
    source: https://google.github.io/eng-practices/review/reviewer/pushback.html#upsetting_developers
