use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngHandlingCommentsThinkCollaboratively:
    standard: @{GoogleEngPractices}
    ruleId: developer/handling-comments/think
    title: Respond to disagreement collaboratively, not defensively
    statement:
        First check that you understand what the reviewer asks, and ask for
        clarification if not. If you disagree, explain your tradeoffs and
        reasons, discuss pros and cons, share context the reviewer lacks,
        and fix the code where appropriate, always with courtesy and
        respect.
    rationale:
        A collaborative discussion grounded in technical facts usually
        reaches consensus; a flat refusal does not.
    exceptions: null
    severity: null
    noncompliant:
        ```text
        \\\
        No, I'm not changing this.
        \\\
        ```
    compliant:
        ```text
        \\\
        I used a list here because order matters for the retry log, and a set
        would lose it. Are you suggesting the order isn't needed, or that we
        should track it some other way?
        \\\
        ```
    languages: [any]
    tags: [author, communication, pushback]
    source: https://google.github.io/eng-practices/review/developer/handling-comments.html#think
