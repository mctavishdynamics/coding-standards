use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngStandardConflicts:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/standard/conflicts
    title: Resolve review conflicts by consensus, then by escalation
    statement:
        First try to reach consensus using the review guidelines. If that is
        hard, talk face to face or by video and record the outcome as a
        comment on the CL. If it still does not resolve, escalate to a team
        discussion, a tech lead, a code maintainer or an engineering
        manager. Never let a CL sit because the two sides cannot agree.
    rationale:
        A stalled change wastes everyone's time, and a written record of the
        decision helps future readers understand it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, conflict-resolution]
    source: https://google.github.io/eng-practices/review/reviewer/standard.html#conflicts
