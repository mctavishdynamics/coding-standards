use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngNavigateStepThree:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/navigate/step_three
    title: Review the remaining files in a sensible order
    statement:
        Once no major design problems remain, go through the rest of the
        files in a logical sequence without skipping any, often simply in
        the order the tool shows them. Reading the tests first can help show
        what the change is meant to do.
    rationale:
        A deliberate order makes it less likely that a file is missed and
        makes the code easier to understand.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, navigation]
    source: https://google.github.io/eng-practices/review/reviewer/navigate.html#step_three
