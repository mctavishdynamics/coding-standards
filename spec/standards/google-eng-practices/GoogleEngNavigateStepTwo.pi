use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngNavigateStepTwo:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/navigate/step_two
    title: Examine the main parts first and send design problems at once
    statement:
        Find the file or files with the most significant logical changes and
        review them first. If the CL is too big to tell, ask the author
        where to start or ask for a split. Send major design comments
        immediately, even before reviewing the rest.
    rationale:
        The main parts give context to the rest. Authors often build further
        work on a CL under review, and big redesigns take time, so early
        design feedback saves the most rework.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, navigation, design]
    source: https://google.github.io/eng-practices/review/reviewer/navigate.html#step_two
