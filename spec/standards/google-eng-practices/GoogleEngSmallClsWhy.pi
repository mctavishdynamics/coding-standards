use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSmallClsWhy:
    standard: @{GoogleEngPractices}
    ruleId: developer/small-cls/why
    title: Write small CLs
    statement:
        Prefer small, simple changes. Expect that a reviewer may reject a
        change solely because it is too large.
    rationale:
        Small CLs are reviewed faster and more thoroughly, are less likely
        to add bugs, waste less work if rejected, merge and roll back more
        easily, are easier to design well, and let you keep working while
        one is in review.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, cl-size]
    source: https://google.github.io/eng-practices/review/developer/small-cls.html#why
