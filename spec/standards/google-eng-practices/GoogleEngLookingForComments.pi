use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngLookingForComments:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/looking-for/comments
    title: Review comments for clarity, need and purpose
    statement:
        Each comment should be easy to understand, written in plain English
        and actually needed. A good comment usually records the reason code
        exists; when code only makes sense with a comment narrating its
        behavior, request simpler code instead. Look at nearby existing
        comments too, for example a TODO the change has made obsolete.
    rationale:
        Comments hold knowledge the code itself cannot express, such as why
        a choice was made. API documentation for classes, modules and
        functions serves another purpose and should cover what they are for,
        how to use them and how they behave.
    exceptions:
        Explaining the behavior of a regular expression or an intricate
        algorithm in a comment is often worthwhile.
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, comments, documentation]
    source: https://google.github.io/eng-practices/review/reviewer/looking-for.html#comments
