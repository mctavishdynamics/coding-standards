use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngLookingForComments:
    standard: @{GoogleEngPractices}
    ruleId: reviewer/looking-for/comments
    title: Check that comments are clear, necessary and explain why
    statement:
        Comments should be clear, in understandable English, and necessary.
        They should usually explain why code exists rather than what it
        does; if code needs a comment to explain what it does, ask for
        simpler code. Also check older comments touched by the change, such
        as a TODO that can now be removed.
    rationale:
        Comments are for information the code cannot carry, like the reason
        behind a decision. Documentation of classes, modules and functions
        is different and should describe purpose, usage and behavior.
    exceptions:
        Regular expressions and complex algorithms often benefit from
        comments that explain what they do.
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [reviewer, comments, documentation]
    source: https://google.github.io/eng-practices/review/reviewer/looking-for.html#comments
