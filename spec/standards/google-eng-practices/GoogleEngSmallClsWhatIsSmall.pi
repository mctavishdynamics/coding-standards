use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSmallClsWhatIsSmall:
    standard: @{GoogleEngPractices}
    ruleId: developer/small-cls/what-is-small
    title: Make each CL one self-contained change
    statement:
        A CL should address just one thing, include its tests, contain
        everything the reviewer needs to understand it, and leave the system
        working. It should not be so small that its implications are
        unclear; a new API should come with a usage. As a rough guide, 100
        lines is often fine, 1000 lines often too many, and spreading across
        many files makes a change larger; when in doubt, go smaller.
    rationale:
        The reviewer usually lacks the author's context, so what seems a
        fine size to the author may overwhelm them. Reviewers rarely
        complain about CLs being too small.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, cl-size]
    source: https://google.github.io/eng-practices/review/developer/small-cls.html#what-is-small
