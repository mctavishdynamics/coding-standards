use ../lib/CodingRule

from ./GoogleEngPractices import GoogleEngPractices

export coding-rule GoogleEngSmallClsSplittingGrid:
    standard: @{GoogleEngPractices}
    ruleId: developer/small-cls/splitting-grid
    title: Combine horizontal and vertical splits into a plan of CLs
    statement:
        Chart the work as a grid of layers by features, where each cell is a
        standalone CL, and work up from the data model to the client.
    rationale:
        A grid makes the full set of small, independent changes visible
        before you start.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [author, cl-size, planning]
    source: https://google.github.io/eng-practices/review/developer/small-cls.html#splitting-grid
