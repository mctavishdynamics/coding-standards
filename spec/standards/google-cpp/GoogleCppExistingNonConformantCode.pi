use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppExistingNonConformantCode:
    standard: @{GoogleCpp}
    ruleId: Existing_Non-conformant_Code
    title: Stay consistent with existing non-conforming code
    statement:
        When changing code written to other conventions, you may diverge
        from this guide to stay consistent with that code's local style, and
        ask its owner if in doubt.
    rationale:
        Local consistency matters too, and mixing styles in one file makes
        it harder to read.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [consistency, legacy-code]
    source: https://google.github.io/styleguide/cppguide.html#Existing_Non-conformant_Code
