use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppThreadLocal:
    standard: @{GoogleCpp}
    ruleId: thread_local
    title: Initialize namespace-scope thread_local with constinit
    statement:
        At namespace or class scope, give each thread_local variable a value
        the compiler can compute ahead of time, and mark it constinit so the
        rule is checked. Choose thread_local over hand-rolled thread-local
        storage, and favour types whose destruction runs no user-written
        code.
    rationale:
        Non-constant thread_local globals share the initialization order
        problems of statics, and their destructors may access thread_locals
        that are already gone, leading to use-after-free bugs that are
        difficult to diagnose.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        thread_local std::string request_id = MakeRequestId();
        \\\
        ```
    compliant:
        ```cpp
        \\\
        constinit thread_local int request_depth = 0;

        std::string& RequestId() {
          thread_local std::string id;
          return id;
        }
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, globals, initialization]
    source: https://google.github.io/styleguide/cppguide.html#thread_local
