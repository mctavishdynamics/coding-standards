use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppCppVersion:
    standard: @{GoogleCpp}
    ruleId: C++_Version
    title: Target C++20 and avoid newer features
    statement:
        Write code for C++20 and do not use C++23 features or non-standard
        extensions. Think about portability to other environments before
        relying on C++17 and C++20 features.
    rationale:
        A single target version keeps the codebase buildable everywhere it
        is used. The targeted version moves forward over time.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // Uses C++23 std::expected and deducing this.
        std::expected<int, Error> Parse(std::string_view text);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // C++20: return a status-or value from a library type.
        absl::StatusOr<int> Parse(std::string_view text);
        \\\
        ```
    languages: [cpp]
    tags: [language-version, portability]
    source: https://google.github.io/styleguide/cppguide.html#C++_Version
