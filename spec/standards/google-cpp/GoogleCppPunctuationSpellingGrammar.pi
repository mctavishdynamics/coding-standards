use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppPunctuationSpellingGrammar:
    standard: @{GoogleCpp}
    ruleId: Punctuation_Spelling_and_Grammar
    title:
        Write comments with proper punctuation, spelling and grammar
    statement:
        Write comments as readable as narrative text, with correct
        capitalization and punctuation, and usually as complete sentences.
        Short end-of-line comments may be less formal but should be
        consistent.
    rationale:
        Well-written comments are easier to read and keep the source clear.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // retry w/ backoff if we get err, upto 3 times
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // Retry with exponential backoff, up to three times, if the call fails.
        \\\
        ```
    languages: [cpp]
    tags: [comments, readability]
    source: https://google.github.io/styleguide/cppguide.html#Punctuation_Spelling_and_Grammar
