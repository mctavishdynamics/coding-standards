use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppNamespaces:
    standard: @{GoogleCpp}
    ruleId: Namespaces
    title: Place code in a uniquely named namespace
    statement:
        Apart from rare exceptions, place code inside a namespace named for
        the project and perhaps its path. Avoid using-directives, inline
        namespaces and declarations in namespace std, and keep namespace
        aliases out of namespace scope in headers unless the namespace is
        internal. End each multi-line namespace with a comment giving its
        name.
    rationale:
        Namespaces prevent name collisions in a large codebase while keeping
        names short. Using-directives and header aliases leak names into
        every includer and make it hard to tell what a name refers to.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // parser.h
        using namespace std;
        namespace fmt = ::myproject::formatting;

        class Parser {
          string Parse(const string& input);
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // parser.h
        namespace myproject {

        class Parser {
          std::string Parse(const std::string& input);
        };

        }  // namespace myproject
        \\\
        ```
    languages: [cpp]
    tags: [namespaces, scoping]
    source: https://google.github.io/styleguide/cppguide.html#Namespaces
