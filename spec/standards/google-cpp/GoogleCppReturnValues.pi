use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppReturnValues:
    standard: @{GoogleCpp}
    ruleId: Return_Values
    title: Do not wrap return expressions in needless parentheses
    statement:
        Parenthesize a return expression only in cases where the same
        expression would need parentheses in an assignment.
    rationale:
        Extra parentheses add clutter and suggest return is a function call.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        return (result);
        return(value);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        return result;
        return (some_long_condition &&
                another_condition);
        \\\
        ```
    languages: [cpp]
    tags: [formatting, expressions]
    source: https://google.github.io/styleguide/cppguide.html#Return_Values
