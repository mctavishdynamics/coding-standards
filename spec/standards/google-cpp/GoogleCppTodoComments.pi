use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppTodoComments:
    standard: @{GoogleCpp}
    ruleId: TODO_Comments
    title: Write TODO comments with an owner or issue reference
    statement:
        Mark code that is temporary or not yet good enough with a TODO
        comment. Spell it in capitals and attach a reference, such as a bug
        number or the name of whoever knows most about the problem. When the
        TODO waits on something in the future, name the exact date or event.
    rationale:
        A consistent, searchable form lets anyone find who or what to ask
        for more details.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // todo: fix this later
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // TODO: bug 12345 - Remove this fallback once all clients send v2.
        // TODO(alice): Use a hash set when the list grows past 100 items.
        \\\
        ```
    languages: [cpp]
    tags: [comments, todo]
    source: https://google.github.io/styleguide/cppguide.html#TODO_Comments
