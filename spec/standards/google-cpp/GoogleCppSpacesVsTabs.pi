use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppSpacesVsTabs:
    standard: @{GoogleCpp}
    ruleId: Spaces_vs._Tabs
    title: Indent with two spaces and never tabs
    statement:
        Use only spaces, indenting two spaces at a time. Do not use tabs,
        and set your editor to insert spaces for the tab key.
    rationale:
        Spaces render the same in every editor and review tool.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        if (ready) {
            Start();
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        if (ready) {
          Start();
        }
        \\\
        ```
    languages: [cpp]
    tags: [formatting, indentation]
    source: https://google.github.io/styleguide/cppguide.html#Spaces_vs._Tabs
