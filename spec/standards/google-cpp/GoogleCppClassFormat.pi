use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppClassFormat:
    standard: @{GoogleCpp}
    ruleId: Class_Format
    title:
        Indent access specifiers one space in public, protected, private
        order
    statement:
        Arrange sections in the order public, protected, private, indenting
        each access keyword by one space. Put a blank line before every
        keyword but the first and none after it. Write base classes on the
        class name's line when the line limit allows.
    rationale:
        A fixed class layout makes interfaces quick to find and scan.
    exceptions:
        The blank line before access keywords is optional in small classes.
    severity: null
    noncompliant:
        ```cpp
        \\\
        class MyClass:public OtherClass
        {
        private:

          int count_;
        public:
          MyClass();
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class MyClass : public OtherClass {
         public:
          MyClass();

         private:
          int count_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [formatting, classes]
    source: https://google.github.io/styleguide/cppguide.html#Class_Format
