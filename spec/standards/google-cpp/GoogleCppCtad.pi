use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppCtad:
    standard: @{GoogleCpp}
    ruleId: CTAD
    title: Use class template argument deduction only where opted in
    statement:
        Rely on class template argument deduction only for templates whose
        maintainers have opted in by supplying one or more explicit
        deduction guides, and treat std templates as opted in. Turn on a
        compiler warning to enforce this where possible, and apply the
        general type deduction rules too.
    rationale:
        Without deduction guides, the deduced type comes from implicit rules
        that are hard to predict and may change as the template evolves.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // Matrix provides no deduction guide.
        Matrix m(3, 4, 0.0);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        Matrix<double> m(3, 4, 0.0);
        std::array primes = {2, 3, 5, 7};  // std templates are opted in.
        \\\
        ```
    languages: [cpp]
    tags: [templates, type-deduction]
    source: https://google.github.io/styleguide/cppguide.html#CTAD
