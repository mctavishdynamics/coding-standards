use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppTypeNames:
    standard: @{GoogleCpp}
    ruleId: Type_Names
    title: Name types in PascalCase
    statement:
        Name classes, structs, type aliases, enums and type template
        parameters with a capital letter for each word and no underscores.
    rationale:
        A single convention for all types lets readers recognize a type name
        at a glance.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class url_table;
        struct Url_Properties;
        using property_map = std::map<std::string, std::string>;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class UrlTable;
        struct UrlProperties;
        using PropertyMap = std::map<std::string, std::string>;
        \\\
        ```
    languages: [cpp]
    tags: [naming, types]
    source: https://google.github.io/styleguide/cppguide.html#Type_Names
