use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppThirdPartyLibraries:
    standard: @{GoogleCpp}
    ruleId: Third_party_Libraries
    title: Choose libraries consistently with the codebase
    statement:
        First use the library your codebase already uses for the problem.
        Otherwise prefer, roughly in order, Abseil, the C++ standard
        library, existing first-party libraries, then third-party libraries,
        and follow your codebase's policy for third-party code.
    rationale:
        Consistency avoids several libraries solving the same problem and
        the conversion costs between them.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [dependencies, libraries]
    source: https://google.github.io/styleguide/cppguide.html#Third_party_Libraries
