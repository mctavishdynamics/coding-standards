use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppDoingWorkInConstructors:
    standard: @{GoogleCpp}
    ruleId: Doing_Work_in_Constructors
    title: Keep constructors free of virtual calls and failing work
    statement:
        Constructors must not call virtual functions, and should avoid
        initialization that may fail without a way to signal the error. If
        crashing is unacceptable, move such work to an Init method or a
        factory function, but do not add Init methods to objects whose other
        state does not affect which methods are callable.
    rationale:
        Virtual calls in a constructor do not reach subclass overrides.
        Constructors cannot return errors and exceptions are not used, so
        failed work leaves a half-built object that needs an easy-to-forget
        validity check.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Connection {
         public:
          explicit Connection(const std::string& host) {
            socket_ = OpenSocket(host);  // May fail; no way to report it.
            OnConnected();               // Virtual: subclass override not called.
          }
          virtual void OnConnected();
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Connection {
         public:
          static absl::StatusOr<std::unique_ptr<Connection>> Create(
              const std::string& host);

         private:
          explicit Connection(Socket socket) : socket_(std::move(socket)) {}
          Socket socket_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [classes, constructors, error-handling]
    source: https://google.github.io/styleguide/cppguide.html#Doing_Work_in_Constructors
