use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppFunctionDeclarationsAndDefinitions:
    standard: @{GoogleCpp}
    ruleId: Function_Declarations_and_Definitions
    title:
        Format function declarations with the return type on the name line
    statement:
        Write the return type, the function name and, space permitting, the
        parameters together on one line. If the parameters do not fit, wrap
        them as you would call arguments, either aligned or with a four-
        space indent. No space separates the name from the opening
        parenthesis, none goes just inside the parentheses, and the opening
        brace closes the last line after a single space. Attributes come
        before the return type.
    rationale:
        A single layout makes every signature quick to read.
    exceptions:
        If the return type and name cannot fit on one line, break between
        them without indenting. Unused parameters may omit or comment out
        their names.
    severity: null
    noncompliant:
        ```cpp
        \\\
        ReturnType
            ClassName::FunctionName ( Type par1, Type par2 )
        {
          DoSomething();
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        ReturnType ClassName::ReallyLongFunctionName(Type par_name1,
                                                     Type par_name2) {
          DoSomething();
        }

        [[nodiscard]] bool IsReady();
        \\\
        ```
    languages: [cpp]
    tags: [formatting, functions]
    source: https://google.github.io/styleguide/cppguide.html#Function_Declarations_and_Definitions
