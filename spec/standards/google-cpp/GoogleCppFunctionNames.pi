use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppFunctionNames:
    standard: @{GoogleCpp}
    ruleId: Function_Names
    title: Name functions in PascalCase
    statement:
        Ordinary function names capitalize every word. Constants in an API
        that are meant to look like functions follow the same style.
        Accessor and mutator names may instead follow snake_case variable
        naming.
    rationale:
        A consistent style distinguishes functions from variables and types
        at a glance.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void add_table_entry();
        bool deleteUrl();
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void AddTableEntry();
        bool DeleteUrl();
        int count() const;
        void set_count(int count);
        \\\
        ```
    languages: [cpp]
    tags: [naming, functions]
    source: https://google.github.io/styleguide/cppguide.html#Function_Names
