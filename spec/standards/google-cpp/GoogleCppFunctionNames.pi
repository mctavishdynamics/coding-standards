use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppFunctionNames:
    standard: @{GoogleCpp}
    ruleId: Function_Names
    title: Name functions in PascalCase
    statement:
        Name ordinary functions with a capital letter for each word. API
        constants meant to look like functions use the same style. Accessors
        and mutators may be named like variables in snake_case.
    rationale:
        A consistent style distinguishes functions from variables and types
        at a glance.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void add_table_entry();
        bool deleteUrl();
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void AddTableEntry();
        bool DeleteUrl();
        int count() const;
        void set_count(int count);
        \\\
        ```
    languages: [cpp]
    tags: [naming, functions]
    source: https://google.github.io/styleguide/cppguide.html#Function_Names
