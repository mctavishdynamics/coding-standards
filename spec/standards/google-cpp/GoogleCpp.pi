export coding-standard GoogleCpp:
    title: Google C++ Style Guide
    publisher: Google
    url: https://google.github.io/styleguide/cppguide.html
    version: null
    license: CC BY 3.0
    description:
        Google's conventions for writing C++, covering headers, scoping,
        classes, functions, language features, naming, comments and
        formatting, with a bias toward readability at large scale.
    rules:
        - @{GoogleCppCppVersion}
        - @{GoogleCppSelfContainedHeaders}
        - @{GoogleCppDefineGuard}
        - @{GoogleCppIncludeWhatYouUse}
        - @{GoogleCppForwardDeclarations}
        - @{GoogleCppDefiningFunctionsInHeaders}
        - @{GoogleCppNamesAndOrderOfIncludes}
        - @{GoogleCppNamespaces}
        - @{GoogleCppInternalLinkage}
        - @{GoogleCppNonmemberStaticMemberGlobalFunctions}
        - @{GoogleCppLocalVariables}
        - @{GoogleCppStaticAndGlobalVariables}
        - @{GoogleCppThreadLocal}
        - @{GoogleCppDoingWorkInConstructors}
        - @{GoogleCppImplicitConversions}
        - @{GoogleCppCopyableMovableTypes}
        - @{GoogleCppStructsVsClasses}
        - @{GoogleCppStructsVsTuples}
        - @{GoogleCppInheritance}
        - @{GoogleCppOperatorOverloading}
        - @{GoogleCppAccessControl}
        - @{GoogleCppDeclarationOrder}
        - @{GoogleCppInputsAndOutputs}
        - @{GoogleCppWriteShortFunctions}
        - @{GoogleCppFunctionOverloading}
        - @{GoogleCppDefaultArguments}
        - @{GoogleCppTrailingReturnType}
        - @{GoogleCppCpplint}
        - @{GoogleCppOwnershipAndSmartPointers}
        - @{GoogleCppRvalueReferences}
        - @{GoogleCppFriends}
        - @{GoogleCppExceptions}
        - @{GoogleCppNoexcept}
        - @{GoogleCppRtti}
        - @{GoogleCppCasting}
        - @{GoogleCppStreams}
        - @{GoogleCppPreincrement}
        - @{GoogleCppUseOfConst}
        - @{GoogleCppUseOfConstexpr}
        - @{GoogleCppIntegerTypes}
        - @{GoogleCppFloatingPointTypes}
        - @{GoogleCppArchitecturePortability}
        - @{GoogleCppPreprocessorMacros}
        - @{GoogleCppNullptr}
        - @{GoogleCppSizeof}
        - @{GoogleCppTypeDeduction}
        - @{GoogleCppCtad}
        - @{GoogleCppDesignatedInitializers}
        - @{GoogleCppLambdaExpressions}
        - @{GoogleCppTemplateMetaprogramming}
        - @{GoogleCppConcepts}
        - @{GoogleCppModules}
        - @{GoogleCppCoroutines}
        - @{GoogleCppDisallowedStdlib}
        - @{GoogleCppThirdPartyLibraries}
        - @{GoogleCppNonstandardExtensions}
        - @{GoogleCppAliases}
        - @{GoogleCppSwitchStatements}
        - @{GoogleCppInclusiveLanguage}
        - @{GoogleCppChoosingNames}
        - @{GoogleCppFileNames}
        - @{GoogleCppTypeNames}
        - @{GoogleCppConceptNames}
        - @{GoogleCppVariableNames}
        - @{GoogleCppConstantNames}
        - @{GoogleCppFunctionNames}
        - @{GoogleCppNamespaceNames}
        - @{GoogleCppEnumeratorNames}
        - @{GoogleCppTemplateParameterNames}
        - @{GoogleCppMacroNames}
        - @{GoogleCppNamingAliases}
        - @{GoogleCppExceptionsToNamingRules}
        - @{GoogleCppCommentStyle}
        - @{GoogleCppFileComments}
        - @{GoogleCppClassComments}
        - @{GoogleCppFunctionComments}
        - @{GoogleCppVariableComments}
        - @{GoogleCppImplementationComments}
        - @{GoogleCppPunctuationSpellingGrammar}
        - @{GoogleCppTodoComments}
        - @{GoogleCppLineLength}
        - @{GoogleCppNonAsciiCharacters}
        - @{GoogleCppSpacesVsTabs}
        - @{GoogleCppFunctionDeclarationsAndDefinitions}
        - @{GoogleCppFormattingLambdaExpressions}
        - @{GoogleCppFloatingLiterals}
        - @{GoogleCppFunctionCalls}
        - @{GoogleCppBracedInitializerListFormat}
        - @{GoogleCppLoopingAndBranching}
        - @{GoogleCppPointerAndReferenceExpressions}
        - @{GoogleCppBooleanExpressions}
        - @{GoogleCppReturnValues}
        - @{GoogleCppVariableAndArrayInitialization}
        - @{GoogleCppPreprocessorDirectives}
        - @{GoogleCppClassFormat}
        - @{GoogleCppConstructorInitializerLists}
        - @{GoogleCppNamespaceFormatting}
        - @{GoogleCppHorizontalWhitespace}
        - @{GoogleCppVerticalWhitespace}
        - @{GoogleCppExistingNonConformantCode}
        - @{GoogleCppWindowsCode}
