use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppDeclarationOrder:
    standard: @{GoogleCpp}
    ruleId: Declaration_Order
    title: Order class sections public, protected, private
    statement:
        Order a class as public, protected and private, leaving out empty
        sections. Inside each section put types and aliases first, then
        static constants, then factory functions, then constructors with
        assignment operators, the destructor, remaining functions, and data
        members last. Keep large method definitions out of the class body.
    rationale:
        Readers looking for the interface find it first, and a consistent
        grouping makes every class quick to navigate.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Cache {
         private:
          std::map<std::string, Entry> entries_;
         public:
          void Clear();
          Cache();
          using Entry = std::string;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Cache {
         public:
          using Entry = std::string;

          Cache();

          void Clear();

         private:
          std::map<std::string, Entry> entries_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [classes, declarations, readability]
    source: https://google.github.io/styleguide/cppguide.html#Declaration_Order
