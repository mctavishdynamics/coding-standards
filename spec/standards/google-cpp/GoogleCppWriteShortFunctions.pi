use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppWriteShortFunctions:
    standard: @{GoogleCpp}
    ruleId: Write_Short_Functions
    title: Prefer small and focused functions
    statement:
        Keep functions small and focused. When a function grows past about
        40 lines, consider whether it can be split without harming the
        program's structure.
    rationale:
        Short functions are easier to read, change and test, and long ones
        tend to collect bugs as people add behavior later.
    exceptions:
        There is no hard limit; some long functions are appropriate.
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [functions, readability]
    source: https://google.github.io/styleguide/cppguide.html#Write_Short_Functions
