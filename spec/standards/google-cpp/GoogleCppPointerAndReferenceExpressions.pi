use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppPointerAndReferenceExpressions:
    standard: @{GoogleCpp}
    ruleId: Pointer_and_Reference_Expressions
    title: Attach pointer and reference symbols to the type
    statement:
        Leave no space on either side of a period or arrow in member access,
        and none after a unary asterisk or ampersand. In a declaration,
        attach the asterisk or ampersand to the type with no space before
        it, and put one space before the name. Avoid declaring multiple
        variables in one declaration when any of them is a pointer or
        reference.
    rationale:
        Consistent spacing makes pointer use easy to recognize, and mixed
        declarations such as a pointer beside a plain variable are easily
        misread.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int * p = & value;
        int* a, *b;
        std::string &name = user . name;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int* p = &value;
        int* a = nullptr;
        int* b = nullptr;
        const std::string& name = user.name;
        \\\
        ```
    languages: [cpp]
    tags: [formatting, pointers]
    source: https://google.github.io/styleguide/cppguide.html#Pointer_and_Reference_Expressions
