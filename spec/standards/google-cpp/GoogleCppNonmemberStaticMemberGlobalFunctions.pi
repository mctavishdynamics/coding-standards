use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppNonmemberStaticMemberGlobalFunctions:
    standard: @{GoogleCpp}
    ruleId: Nonmember,_Static_Member,_and_Global_Functions
    title: Put nonmember functions in a namespace, not a static class
    statement:
        Put nonmember functions inside a namespace, and keep truly global
        functions rare. Never write a class just to collect static members.
        Give a nonmember function internal linkage when only its own .cc
        file uses it.
    rationale:
        C++ already offers a natural home for operations that do not act on
        an object, and that home is a namespace. Wrapping statics in a class
        only gives them a shared prefix, which a namespace does just as
        well.
    exceptions:
        Static-only classes still have a place in a few designs, for
        instance policy classes, traits, a type wrapped around some other
        representation, or an interface you want to seal against extension.
    severity: null
    noncompliant:
        ```cpp
        \\\
        class StringUtils {
         public:
          static std::string Trim(std::string_view s);
          static bool IsBlank(std::string_view s);
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        namespace myproject::strings {

        std::string Trim(std::string_view s);
        bool IsBlank(std::string_view s);

        }  // namespace myproject::strings
        \\\
        ```
    languages: [cpp]
    tags: [functions, namespaces, classes]
    source: https://google.github.io/styleguide/cppguide.html#Nonmember,_Static_Member,_and_Global_Functions
