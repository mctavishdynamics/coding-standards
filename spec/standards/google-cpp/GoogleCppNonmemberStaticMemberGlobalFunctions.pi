use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppNonmemberStaticMemberGlobalFunctions:
    standard: @{GoogleCpp}
    ruleId: Nonmember,_Static_Member,_and_Global_Functions
    title: Put nonmember functions in a namespace, not a static class
    statement:
        Place nonmember functions in a namespace and use fully global
        functions rarely. Do not create a class only to group static
        members. If a nonmember function is needed only in its .cc file,
        give it internal linkage.
    rationale:
        Free functions in a namespace are the idiomatic way to write
        operations that need no instance. A class of statics adds nothing
        over a common name prefix.
    exceptions:
        A class of static members can be justified for a policy class, a
        trait, giving type semantics to a separate representation, or
        closing an interface to extension.
    severity: null
    noncompliant:
        ```cpp
        \\\
        class StringUtils {
         public:
          static std::string Trim(std::string_view s);
          static bool IsBlank(std::string_view s);
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        namespace myproject::strings {

        std::string Trim(std::string_view s);
        bool IsBlank(std::string_view s);

        }  // namespace myproject::strings
        \\\
        ```
    languages: [cpp]
    tags: [functions, namespaces, classes]
    source: https://google.github.io/styleguide/cppguide.html#Nonmember,_Static_Member,_and_Global_Functions
