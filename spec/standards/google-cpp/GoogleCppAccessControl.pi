use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppAccessControl:
    standard: @{GoogleCpp}
    ruleId: Access_Control
    title: Make class data members private
    statement:
        Keep data members of a class private, except constants, and add
        accessor methods when they are needed.
    rationale:
        With private data, a class's invariants are far simpler to reason
        about, and the price is only some accessor boilerplate.
    exceptions:
        Google Test fixture classes declared in a .cc file may keep their
        data members protected.
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Counter {
         public:
          int count;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Counter {
         public:
          int count() const { return count_; }
          void Increment() { ++count_; }

         private:
          int count_ = 0;
        };
        \\\
        ```
    languages: [cpp]
    tags: [classes, encapsulation]
    source: https://google.github.io/styleguide/cppguide.html#Access_Control
