use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppStructsVsClasses:
    standard: @{GoogleCpp}
    ruleId: Structs_vs._Classes
    title: Use struct only for passive data carriers
    statement:
        Reserve the struct keyword for plain bundles of data whose fields
        are all public and do not depend on one another. Any type with
        behaviour or invariants should be a class, and a class is the safer
        pick when unsure.
    rationale:
        The two keywords behave almost the same, so the choice signals
        intent. Users of a struct may write any field directly, which would
        break any invariant the type tried to keep.
    exceptions:
        Types that hold no state, like traits, metafunctions in templates or
        certain function objects, may be declared as structs to match the
        style of the standard library.
    severity: null
    noncompliant:
        ```cpp
        \\\
        struct Account {
          void Deposit(int64_t cents);  // Keeps balance_ and history_ in sync.
         private:
          int64_t balance_;
          std::vector<int64_t> history_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        struct Point {
          double x = 0.0;
          double y = 0.0;
        };

        class Account {
         public:
          void Deposit(int64_t cents);
         private:
          int64_t balance_ = 0;
          std::vector<int64_t> history_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [classes, structs]
    source: https://google.github.io/styleguide/cppguide.html#Structs_vs._Classes
