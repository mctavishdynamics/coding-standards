use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppFriends:
    standard: @{GoogleCpp}
    ruleId: Friends
    title: Use friends sparingly and define them in the same file
    statement:
        Friend classes and functions are allowed within reason. Define a
        friend in the same file as the class, so readers can find every use
        of the private members, and keep most interaction through public
        members.
    rationale:
        Granting friendship lets one trusted partner, a builder for
        instance, reach past encapsulation, which beats exposing the member
        publicly to every caller.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```cpp
        \\\
        // order.h
        class Order {
         private:
          friend class OrderBuilder;  // Defined below in this file.
          std::vector<Item> items_;
        };

        class OrderBuilder {
         public:
          Order Build();
        };
        \\\
        ```
    languages: [cpp]
    tags: [classes, encapsulation]
    source: https://google.github.io/styleguide/cppguide.html#Friends
