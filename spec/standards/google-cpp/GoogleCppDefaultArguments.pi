use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppDefaultArguments:
    standard: @{GoogleCpp}
    ruleId: Default_Arguments
    title: Avoid default arguments on virtual functions
    statement:
        A non-virtual function may take a default argument, provided that
        default yields the same value on every call. Keep defaults off
        virtual functions and away from expressions whose result can vary,
        and reach for an overload whenever the choice is unclear.
    rationale:
        A virtual call takes its defaults from the static type, so an
        override may end up with different ones. Default values are also
        computed anew at every call, which confuses readers when that value
        can vary.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Renderer {
         public:
          virtual void Draw(int scale = 1);
        };
        int NextId(int seed = counter++);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Renderer {
         public:
          void Draw() { Draw(1); }
          virtual void Draw(int scale);
        };
        std::string Join(const std::vector<std::string>& parts,
                         std::string_view separator = ", ");
        \\\
        ```
    languages: [cpp]
    tags: [functions, parameters]
    source: https://google.github.io/styleguide/cppguide.html#Default_Arguments
