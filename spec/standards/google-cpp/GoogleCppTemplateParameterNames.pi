use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppTemplateParameterNames:
    standard: @{GoogleCpp}
    ruleId: Template_Parameter_Names
    title: Name template parameters by their category
    statement:
        Name type template parameters like types, and non-type template
        parameters like variables or constants.
    rationale:
        Following the category's convention tells readers whether a
        parameter is a type or a value.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template <typename element_type, int SIZE>
        class RingBuffer;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template <typename ElementType, int kSize>
        class RingBuffer;
        \\\
        ```
    languages: [cpp]
    tags: [naming, templates]
    source: https://google.github.io/styleguide/cppguide.html#Template_Parameter_Names
