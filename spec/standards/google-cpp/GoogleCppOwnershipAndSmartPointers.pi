use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppOwnershipAndSmartPointers:
    standard: @{GoogleCpp}
    ruleId: Ownership_and_Smart_Pointers
    title:
        Keep single owners and transfer ownership with smart pointers
    statement:
        Every dynamically allocated object should have one fixed owner, and
        ownership transfers should be made explicit with std::unique_ptr.
        Share ownership only for a strong reason, for example to avoid
        expensive copies of an immutable object, and rely on std::shared_ptr
        in that case. Never use std::auto_ptr.
    rationale:
        Clear ownership removes doubt about who deletes an object and when.
        Shared ownership makes lifetimes hard to predict.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Widget* MakeWidget();  // Caller must remember to delete.

        void Use() {
          Widget* w = MakeWidget();
          w->Draw();
          delete w;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::unique_ptr<Widget> MakeWidget();

        void Use() {
          std::unique_ptr<Widget> w = MakeWidget();
          w->Draw();
        }
        \\\
        ```
    languages: [cpp]
    tags: [memory, ownership, smart-pointers]
    source: https://google.github.io/styleguide/cppguide.html#Ownership_and_Smart_Pointers
