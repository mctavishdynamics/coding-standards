use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppCpplint:
    standard: @{GoogleCpp}
    ruleId: cpplint
    title: Run cpplint to detect style errors
    statement:
        Use cpplint.py to find style errors, following your project's
        instructions for running it when it has them.
    rationale:
        The tool catches many style problems automatically. It has false
        positives and false negatives but is still valuable.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [tooling, linting]
    source: https://google.github.io/styleguide/cppguide.html#cpplint
