use ../lib/CodingRule

from ./GoogleCpp import GoogleCpp

export coding-rule GoogleCppVerticalWhitespace:
    standard: @{GoogleCpp}
    ruleId: Vertical_Whitespace
    title: Use blank lines sparingly
    statement:
        Add blank lines only where they make structure clearer, splitting
        closely related chunks the way paragraphs do. Skip them where
        indentation already shows the separation, for instance at the
        beginning or end of a block.
    rationale:
        Unnecessary blank lines make the overall structure of the code
        harder to see.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void Process() {

          Load();


          Save();

        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void Process() {
          Load();
          Validate();

          Save();
        }
        \\\
        ```
    languages: [cpp]
    tags: [formatting, whitespace]
    source: https://google.github.io/styleguide/cppguide.html#Vertical_Whitespace
