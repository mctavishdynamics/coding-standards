use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagReadingLevel:
    standard: @{Wcag22}
    ruleId: 3.1.5
    title: Offer simpler content when text needs advanced reading skills
    statement:
        When text needs reading ability beyond lower secondary education,
        ignoring proper names and titles, provide supplemental content or a
        simpler version.
    rationale:
        Plain summaries, illustrations or audio help people with reading
        disabilities understand the content.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [html]
    tags: [level-aaa, content, readability, plain-language]
    source: https://www.w3.org/TR/WCAG22/#reading-level
