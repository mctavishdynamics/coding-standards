use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagConsistentIdentification:
    standard: @{Wcag22}
    ruleId: 3.2.4
    title: Identify components with the same function consistently
    statement:
        Give components that do the same thing across a set of pages the
        same labels, names and icons.
    rationale:
        Users learn what a control does once and recognize it everywhere.
    exceptions: null
    severity: null
    noncompliant:
        ```html
        \\\
        <!-- page 1 --> <button>Search</button>
        <!-- page 2 --> <button>Find</button>
        \\\
        ```
    compliant:
        ```html
        \\\
        <!-- page 1 --> <button>Search</button>
        <!-- page 2 --> <button>Search</button>
        \\\
        ```
    languages: [html]
    tags: [level-aa, consistency, labels]
    source: https://www.w3.org/TR/WCAG22/#consistent-identification
