use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagMediaAlternativePrerecorded:
    standard: @{Wcag22}
    ruleId: 1.2.8
    title: Provide a full text alternative for recorded media
    statement:
        Provide a complete text alternative for all recorded synchronized
        media and all recorded video-only media.
    rationale:
        A full text version serves deafblind users and anyone who needs to
        read the content at their own pace.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [html]
    tags: [level-aaa, media, transcripts]
    source: https://www.w3.org/TR/WCAG22/#media-alternative-prerecorded
