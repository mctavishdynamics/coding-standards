use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagExtendedAudioDescriptionPrerecorded:
    standard: @{Wcag22}
    ruleId: 1.2.7
    title: Pause video for extended audio description when gaps are too short
    statement:
        When natural pauses in the dialogue are too short to describe the
        video, provide extended audio description that pauses the video to
        give the description room.
    rationale:
        Without extra time, important visual information cannot be described
        and blind users lose it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [html]
    tags: [level-aaa, media, audio-description]
    source: https://www.w3.org/TR/WCAG22/#extended-audio-description-prerecorded
