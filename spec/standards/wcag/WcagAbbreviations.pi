use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagAbbreviations:
    standard: @{Wcag22}
    ruleId: 3.1.4
    title: Provide the expanded form of abbreviations
    statement:
        Provide a way to find out what an abbreviation stands for, such as
        expanding it on first use or linking to a glossary.
    rationale:
        Abbreviations can be unfamiliar or mean different things in
        different contexts.
    exceptions: null
    severity: null
    noncompliant:
        ```html
        \\\
        <p>Submit the form to the HOA by Friday.</p>
        \\\
        ```
    compliant:
        ```html
        \\\
        <p>Submit the form to the <abbr title="homeowners association">HOA</abbr>
        (homeowners association) by Friday.</p>
        \\\
        ```
    languages: [html]
    tags: [level-aaa, content, readability]
    source: https://www.w3.org/TR/WCAG22/#abbreviations
