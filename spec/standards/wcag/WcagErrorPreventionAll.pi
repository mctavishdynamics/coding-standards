use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagErrorPreventionAll:
    standard: @{Wcag22}
    ruleId: 3.3.6
    title: Let users review, correct or reverse any submission
    statement:
        For any page that submits user information, make submissions
        reversible, check input and let users correct it, or let users
        review and confirm before finalizing.
    rationale:
        Extending error prevention to every form protects all users from
        costly slips.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [html]
    tags: [level-aaa, forms, errors]
    source: https://www.w3.org/TR/WCAG22/#error-prevention-all
