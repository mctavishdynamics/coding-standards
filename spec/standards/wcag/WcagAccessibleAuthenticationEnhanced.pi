use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagAccessibleAuthenticationEnhanced:
    standard: @{Wcag22}
    ruleId: 3.3.9
    title: Do not require any cognitive test to log in, including object recognition
    statement:
        Do not make any authentication step depend on a cognitive function
        test unless there is an alternative method or an assisting
        mechanism. Object recognition and personal content are not accepted
        exceptions at this level.
    rationale:
        Even recognizing images can be a barrier for some users.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [html]
    tags: [level-aaa, authentication, cognitive]
    source: https://www.w3.org/TR/WCAG22/#accessible-authentication-enhanced
