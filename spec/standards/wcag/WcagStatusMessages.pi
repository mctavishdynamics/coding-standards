use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagStatusMessages:
    standard: @{Wcag22}
    ruleId: 4.1.3
    title: Announce status messages without moving focus
    statement:
        In markup content, give status messages a role or property, such as
        role status or alert, so assistive technology can announce them
        without the message taking focus.
    rationale:
        Screen reader users otherwise miss confirmations like item added to
        cart or search results updated.
    exceptions: null
    severity: null
    noncompliant:
        ```html
        \\\
        <div class="toast">3 results found</div>
        \\\
        ```
    compliant:
        ```html
        \\\
        <div class="toast" role="status">3 results found</div>
        \\\
        ```
    languages: [html]
    tags: [level-aa, aria, live-regions, notifications]
    source: https://www.w3.org/TR/WCAG22/#status-messages
