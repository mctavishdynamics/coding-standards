use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagCaptionsLive:
    standard: @{Wcag22}
    ruleId: 1.2.4
    title: Caption live audio in synchronized media
    statement:
        Provide real-time captions for all live audio in synchronized media
        such as webcasts and streamed events.
    rationale:
        Deaf and hard of hearing viewers need captions to follow live events
        as they happen.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [html]
    tags: [level-aa, media, captions, live]
    source: https://www.w3.org/TR/WCAG22/#captions-live
