use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagReAuthenticating:
    standard: @{Wcag22}
    ruleId: 2.2.5
    title: Keep the user's data when a session expires
    statement:
        When an authenticated session ends, let the user sign in again and
        carry on without losing data they entered.
    rationale:
        Users who need extra time should not have to start a long form from
        scratch.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [html]
    tags: [level-aaa, sessions, authentication, forms]
    source: https://www.w3.org/TR/WCAG22/#re-authenticating
