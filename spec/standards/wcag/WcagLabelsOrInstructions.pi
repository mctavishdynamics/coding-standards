use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagLabelsOrInstructions:
    standard: @{Wcag22}
    ruleId: 3.3.2
    title: Provide labels or instructions for user input
    statement:
        Give every field that needs input a label or instructions, including
        required formats.
    rationale:
        Users need to know what to enter before they can complete a form.
    exceptions: null
    severity: null
    noncompliant:
        ```html
        \\\
        <input type="text" placeholder="DD/MM/YYYY">
        \\\
        ```
    compliant:
        ```html
        \\\
        <label for="dob">Date of birth (DD/MM/YYYY)</label>
        <input id="dob" type="text" name="dob">
        \\\
        ```
    languages: [html]
    tags: [level-a, forms, labels]
    source: https://www.w3.org/TR/WCAG22/#labels-or-instructions
