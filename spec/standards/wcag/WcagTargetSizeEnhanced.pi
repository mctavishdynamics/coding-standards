use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagTargetSizeEnhanced:
    standard: @{Wcag22}
    ruleId: 2.5.5
    title: Size pointer targets to 44 CSS pixels square or larger
    statement:
        Give every pointer target a size of 44 CSS pixels or more in each
        dimension.
    rationale:
        Larger targets help people with tremors, limited dexterity or large
        fingers.
    exceptions:
        Exempt when an equivalent large target exists on the page, the
        target is inline in text, the browser sets the size, or the
        presentation is essential.
    severity: null
    noncompliant:
        ```css
        \\\
        .icon-button { width: 24px; height: 24px; padding: 0; }
        \\\
        ```
    compliant:
        ```css
        \\\
        .icon-button { min-width: 44px; min-height: 44px; }
        \\\
        ```
    languages: [html]
    tags: [level-aaa, pointer, target-size]
    source: https://www.w3.org/TR/WCAG22/#target-size-enhanced
