use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagContrastEnhanced:
    standard: @{Wcag22}
    ruleId: 1.4.6
    title: Reach a text contrast ratio of 7 to 1 or higher
    statement:
        Make text and images of text contrast with their background at a
        ratio of at least 7 to 1, or 4.5 to 1 for large text.
    rationale:
        Higher contrast serves users with moderately low vision who do not
        use contrast-enhancing tools.
    exceptions:
        Logos, decorative text, inactive controls and incidental text in
        pictures are excluded.
    severity: null
    noncompliant:
        ```css
        \\\
        body { color: #666666; background: #ffffff; }
        \\\
        ```
    compliant:
        ```css
        \\\
        body { color: #333333; background: #ffffff; }
        \\\
        ```
    languages: [html]
    tags: [level-aaa, color, contrast]
    source: https://www.w3.org/TR/WCAG22/#contrast-enhanced
