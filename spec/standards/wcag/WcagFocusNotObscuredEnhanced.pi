use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagFocusNotObscuredEnhanced:
    standard: @{Wcag22}
    ruleId: 2.4.12
    title: Do not let author content hide any part of the focused element
    statement:
        When a component receives keyboard focus, make sure no part of it is
        covered by content the author added.
    rationale:
        A fully visible focused element is easiest to identify, especially
        for low vision users.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [html]
    tags: [level-aaa, focus, layout]
    source: https://www.w3.org/TR/WCAG22/#focus-not-obscured-enhanced
