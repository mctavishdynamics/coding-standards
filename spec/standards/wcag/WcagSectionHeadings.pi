use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagSectionHeadings:
    standard: @{Wcag22}
    ruleId: 2.4.10
    title: Organize content with section headings
    statement:
        Use headings to divide written content into sections.
    rationale:
        Headings let readers skim and let screen reader users jump between
        sections.
    exceptions: null
    severity: null
    noncompliant:
        ```html
        \\\
        <p><strong>Installation</strong></p>
        <p>Run the installer ...</p>
        \\\
        ```
    compliant:
        ```html
        \\\
        <h2>Installation</h2>
        <p>Run the installer ...</p>
        \\\
        ```
    languages: [html]
    tags: [level-aaa, headings, structure]
    source: https://www.w3.org/TR/WCAG22/#section-headings
