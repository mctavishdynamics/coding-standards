use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagThreeFlashes:
    standard: @{Wcag22}
    ruleId: 2.3.2
    title: Never flash more than three times a second
    statement:
        Content must not flash more often than three times in a single
        second, regardless of how large or bright the flashing is.
    rationale:
        Removing the threshold exception gives the strongest protection
        against seizures.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [html]
    tags: [level-aaa, seizures, animation]
    source: https://www.w3.org/TR/WCAG22/#three-flashes
