use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagThreeFlashesOrBelowThreshold:
    standard: @{Wcag22}
    ruleId: 2.3.1
    title: Avoid flashing more than three times a second
    statement:
        Content must not flash more often than three times in a single
        second, unless every flash stays under the limits set for general
        flashes and for red flashes.
    rationale:
        Flashing can trigger seizures in people with photosensitive
        epilepsy.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [html]
    tags: [level-a, seizures, animation]
    source: https://www.w3.org/TR/WCAG22/#three-flashes-or-below-threshold
