use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagFocusVisible:
    standard: @{Wcag22}
    ruleId: 2.4.7
    title: Keep the keyboard focus indicator visible
    statement:
        Make sure every keyboard operable interface shows where focus is.
        Never remove the focus outline without replacing it.
    rationale:
        Keyboard users cannot tell which element will act on their keypress
        without a focus indicator.
    exceptions: null
    severity: null
    noncompliant:
        ```css
        \\\
        *:focus { outline: none; }
        \\\
        ```
    compliant:
        ```css
        \\\
        :focus-visible { outline: 2px solid #1a5fb4; outline-offset: 2px; }
        \\\
        ```
    languages: [html]
    tags: [level-aa, focus, keyboard, visual-design]
    source: https://www.w3.org/TR/WCAG22/#focus-visible
