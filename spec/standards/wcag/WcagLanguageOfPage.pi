use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagLanguageOfPage:
    standard: @{Wcag22}
    ruleId: 3.1.1
    title: Declare the default language of each page
    statement:
        Make the main human language of each page determinable by software,
        in HTML with the lang attribute on the html element.
    rationale:
        Screen readers choose pronunciation rules from the language, and
        browsers use it for translation and hyphenation.
    exceptions: null
    severity: null
    noncompliant:
        ```html
        \\\
        <html>
        \\\
        ```
    compliant:
        ```html
        \\\
        <html lang="th">
        \\\
        ```
    languages: [html]
    tags: [level-a, language, i18n]
    source: https://www.w3.org/TR/WCAG22/#language-of-page
