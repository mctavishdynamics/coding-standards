use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagConsistentHelp:
    standard: @{Wcag22}
    ruleId: 3.2.6
    title: Place help options in the same relative order on every page
    statement:
        When pages in a set offer help such as contact details, a contact
        form, a self-help page or a chatbot, place them in the same order
        relative to the rest of the page each time.
    rationale:
        People who need help can find it without searching anew on every
        page.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [html]
    tags: [level-a, help, consistency]
    source: https://www.w3.org/TR/WCAG22/#consistent-help
