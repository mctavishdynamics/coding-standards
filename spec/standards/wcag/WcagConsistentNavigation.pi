use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagConsistentNavigation:
    standard: @{Wcag22}
    ruleId: 3.2.3
    title: Keep repeated navigation in the same order across pages
    statement:
        When several pages share navigation links, keep those links in one
        fixed relative sequence on every page, except where the user has
        rearranged them.
    rationale:
        Predictable navigation helps users with low vision, cognitive
        disabilities and screen readers find things quickly.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [html]
    tags: [level-aa, navigation, consistency]
    source: https://www.w3.org/TR/WCAG22/#consistent-navigation
