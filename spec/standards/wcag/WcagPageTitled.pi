use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagPageTitled:
    standard: @{Wcag22}
    ruleId: 2.4.2
    title: Give each page a descriptive title
    statement:
        Give every page a title that describes its topic or purpose.
    rationale:
        The title is the first thing screen readers announce and what users
        see in tabs and history.
    exceptions: null
    severity: null
    noncompliant:
        ```html
        \\\
        <title>Untitled</title>
        \\\
        ```
    compliant:
        ```html
        \\\
        <title>Order history - Northwind Store</title>
        \\\
        ```
    languages: [html]
    tags: [level-a, metadata, navigation]
    source: https://www.w3.org/TR/WCAG22/#page-titled
