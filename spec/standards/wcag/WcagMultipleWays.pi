use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagMultipleWays:
    standard: @{Wcag22}
    ruleId: 2.4.5
    title: Offer more than one way to find a page
    statement:
        Provide at least two ways to locate a page within a site, such as
        navigation, search, a site map or a table of contents.
    rationale:
        Different people find content in different ways; some prefer search,
        others browsing.
    exceptions:
        Pages that are a step in a process, or the result of one, are
        exempt.
    severity: null
    noncompliant: null
    compliant: null
    languages: [html]
    tags: [level-aa, navigation, search]
    source: https://www.w3.org/TR/WCAG22/#multiple-ways
