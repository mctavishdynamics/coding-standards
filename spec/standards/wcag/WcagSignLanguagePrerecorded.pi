use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagSignLanguagePrerecorded:
    standard: @{Wcag22}
    ruleId: 1.2.6
    title: Provide sign language interpretation for recorded audio
    statement:
        Provide sign language interpretation for all recorded audio content
        in synchronized media.
    rationale:
        For many Deaf people sign language is their first language and
        conveys tone and emphasis better than captions.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [html]
    tags: [level-aaa, media, sign-language]
    source: https://www.w3.org/TR/WCAG22/#sign-language-prerecorded
