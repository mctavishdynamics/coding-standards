use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagKeyboardNoException:
    standard: @{Wcag22}
    ruleId: 2.1.3
    title: Make every function keyboard operable without exception
    statement:
        Make all functionality operable through the keyboard without timing
        requirements, including functions that would otherwise depend on the
        path of movement.
    rationale:
        At this level no function is left out for people who cannot use a
        pointer.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [html]
    tags: [level-aaa, keyboard]
    source: https://www.w3.org/TR/WCAG22/#keyboard-no-exception
