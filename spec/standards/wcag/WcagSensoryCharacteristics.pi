use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagSensoryCharacteristics:
    standard: @{Wcag22}
    ruleId: 1.3.3
    title: Do not rely only on shape, position or sound in instructions
    statement:
        Write instructions that do not depend solely on sensory
        characteristics such as shape, color, size, visual position,
        orientation or sound. Name the control or add text as well.
    rationale:
        A user who cannot see the layout or hear a tone cannot follow
        instructions like press the round button on the right.
    exceptions: null
    severity: null
    noncompliant:
        ```html
        \\\
        <p>Click the green button on the right to continue.</p>
        \\\
        ```
    compliant:
        ```html
        \\\
        <p>Select Continue to go to the payment step.</p>
        <button class="btn-green">Continue</button>
        \\\
        ```
    languages: [html]
    tags: [level-a, instructions, content]
    source: https://www.w3.org/TR/WCAG22/#sensory-characteristics
