use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagAudioOnlyLive:
    standard: @{Wcag22}
    ruleId: 1.2.9
    title: Provide a text alternative for live audio-only content
    statement:
        Provide an equivalent text alternative, such as live captioning or a
        real-time transcript, for live audio-only content like radio
        streams.
    rationale:
        Deaf users otherwise have no access to live audio broadcasts.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [html]
    tags: [level-aaa, media, live, transcripts]
    source: https://www.w3.org/TR/WCAG22/#audio-only-live
