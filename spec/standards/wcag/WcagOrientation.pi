use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagOrientation:
    standard: @{Wcag22}
    ruleId: 1.3.4
    title: Do not lock content to one screen orientation
    statement:
        Let content work in both portrait and landscape unless a particular
        orientation is essential.
    rationale:
        Some users have devices mounted in a fixed orientation and cannot
        rotate them.
    exceptions:
        Applies only where an orientation is not essential, as with a piano
        keyboard app or a bank check image.
    severity: null
    noncompliant:
        ```css
        \\\
        @media (orientation: portrait) {
          body { transform: rotate(90deg); }
          .app { display: none; }
        }
        \\\
        ```
    compliant:
        ```css
        \\\
        @media (orientation: portrait) {
          .app { grid-template-columns: 1fr; }
        }
        \\\
        ```
    languages: [html]
    tags: [level-aa, responsive, mobile]
    source: https://www.w3.org/TR/WCAG22/#orientation
