use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagHeadingsAndLabels:
    standard: @{Wcag22}
    ruleId: 2.4.6
    title: Write headings and labels that describe their topic
    statement:
        Make headings and labels describe the topic or purpose of the
        content or control they belong to.
    rationale:
        Clear headings and labels help everyone find content and understand
        what a field expects.
    exceptions: null
    severity: null
    noncompliant:
        ```html
        \\\
        <h2>More</h2>
        <label for="d">Date</label> <input id="d" type="date">
        \\\
        ```
    compliant:
        ```html
        \\\
        <h2>Delivery options</h2>
        <label for="d">Preferred delivery date</label> <input id="d" type="date">
        \\\
        ```
    languages: [html]
    tags: [level-aa, headings, forms, content]
    source: https://www.w3.org/TR/WCAG22/#headings-and-labels
