use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagImagesOfTextNoException:
    standard: @{Wcag22}
    ruleId: 1.4.9
    title: Use images of text only for decoration or where essential
    statement:
        Use images of text only when they are purely decorative or when a
        particular presentation of the text is essential, such as a logo.
    rationale:
        Even customizable images of text are harder to adapt than real text.
    exceptions: null
    severity: null
    noncompliant:
        ```html
        \\\
        <img src="/img/opening-hours.png" alt="Open Monday to Friday, 9 to 5">
        \\\
        ```
    compliant:
        ```html
        \\\
        <p class="hours">Open Monday to Friday, 9 to 5</p>
        \\\
        ```
    languages: [html]
    tags: [level-aaa, images, typography]
    source: https://www.w3.org/TR/WCAG22/#images-of-text-no-exception
