from ./WcagUseOfColor import WcagUseOfColor
from ./WcagVisualPresentation import WcagVisualPresentation

export coding-standard Wcag22:
    title: Web Content Accessibility Guidelines (WCAG) 2.2
    publisher: W3C
    url: https://www.w3.org/TR/WCAG22/
    version: 2.2, W3C Recommendation 12 December 2024
    license: Copyright 2020-2024 World Wide Web Consortium, W3C Document License
    description:
        The W3C success criteria for making web content accessible to people
        with disabilities, grouped under perceivable, operable,
        understandable and robust, at conformance levels A, AA and AAA.
    rules:
        - @{WcagNonTextContent}
        - @{WcagAudioOnlyVideoOnlyPrerecorded}
        - @{WcagCaptionsPrerecorded}
        - @{WcagAudioDescriptionOrMediaAlternativePrerecorded}
        - @{WcagCaptionsLive}
        - @{WcagAudioDescriptionPrerecorded}
        - @{WcagSignLanguagePrerecorded}
        - @{WcagExtendedAudioDescriptionPrerecorded}
        - @{WcagMediaAlternativePrerecorded}
        - @{WcagAudioOnlyLive}
        - @{WcagInfoAndRelationships}
        - @{WcagMeaningfulSequence}
        - @{WcagSensoryCharacteristics}
        - @{WcagOrientation}
        - @{WcagIdentifyInputPurpose}
        - @{WcagIdentifyPurpose}
        - @{WcagUseOfColor}
        - @{WcagAudioControl}
        - @{WcagContrastMinimum}
        - @{WcagResizeText}
        - @{WcagImagesOfText}
        - @{WcagContrastEnhanced}
        - @{WcagLowOrNoBackgroundAudio}
        - @{WcagVisualPresentation}
        - @{WcagImagesOfTextNoException}
        - @{WcagReflow}
        - @{WcagNonTextContrast}
        - @{WcagTextSpacing}
        - @{WcagContentOnHoverOrFocus}
        - @{WcagKeyboard}
        - @{WcagNoKeyboardTrap}
        - @{WcagKeyboardNoException}
        - @{WcagCharacterKeyShortcuts}
        - @{WcagTimingAdjustable}
        - @{WcagPauseStopHide}
        - @{WcagNoTiming}
        - @{WcagInterruptions}
        - @{WcagReAuthenticating}
        - @{WcagTimeouts}
        - @{WcagThreeFlashesOrBelowThreshold}
        - @{WcagThreeFlashes}
        - @{WcagAnimationFromInteractions}
        - @{WcagBypassBlocks}
        - @{WcagPageTitled}
        - @{WcagFocusOrder}
        - @{WcagLinkPurposeInContext}
        - @{WcagMultipleWays}
        - @{WcagHeadingsAndLabels}
        - @{WcagFocusVisible}
        - @{WcagLocation}
        - @{WcagLinkPurposeLinkOnly}
        - @{WcagSectionHeadings}
        - @{WcagFocusNotObscuredMinimum}
        - @{WcagFocusNotObscuredEnhanced}
        - @{WcagFocusAppearance}
        - @{WcagPointerGestures}
        - @{WcagPointerCancellation}
        - @{WcagLabelInName}
        - @{WcagMotionActuation}
        - @{WcagTargetSizeEnhanced}
        - @{WcagConcurrentInputMechanisms}
        - @{WcagDraggingMovements}
        - @{WcagTargetSizeMinimum}
        - @{WcagLanguageOfPage}
        - @{WcagLanguageOfParts}
        - @{WcagUnusualWords}
        - @{WcagAbbreviations}
        - @{WcagReadingLevel}
        - @{WcagPronunciation}
        - @{WcagOnFocus}
        - @{WcagOnInput}
        - @{WcagConsistentNavigation}
        - @{WcagConsistentIdentification}
        - @{WcagChangeOnRequest}
        - @{WcagConsistentHelp}
        - @{WcagErrorIdentification}
        - @{WcagLabelsOrInstructions}
        - @{WcagErrorSuggestion}
        - @{WcagErrorPreventionLegalFinancialData}
        - @{WcagHelp}
        - @{WcagErrorPreventionAll}
        - @{WcagRedundantEntry}
        - @{WcagAccessibleAuthenticationMinimum}
        - @{WcagAccessibleAuthenticationEnhanced}
        - @{WcagNameRoleValue}
        - @{WcagStatusMessages}
