use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagNoTiming:
    standard: @{Wcag22}
    ruleId: 2.2.3
    title: Do not make timing essential to an activity
    statement:
        Design activities so that timing is not essential.
    rationale:
        Users of any speed can then complete everything the content offers.
    exceptions:
        Real-time events and synchronized media that offer no interaction do
        not need to meet this.
    severity: null
    noncompliant: null
    compliant: null
    languages: [html]
    tags: [level-aaa, timing]
    source: https://www.w3.org/TR/WCAG22/#no-timing
