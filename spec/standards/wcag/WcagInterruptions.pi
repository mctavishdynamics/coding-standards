use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagInterruptions:
    standard: @{Wcag22}
    ruleId: 2.2.4
    title: Let users postpone or suppress interruptions
    statement:
        Let users postpone or turn off interruptions such as automatic
        updates and promotional popups.
    rationale:
        Interruptions break concentration and are hard for people with
        cognitive disabilities to recover from.
    exceptions:
        Interruptions about an emergency are exempt.
    severity: null
    noncompliant: null
    compliant: null
    languages: [html]
    tags: [level-aaa, notifications, focus]
    source: https://www.w3.org/TR/WCAG22/#interruptions
