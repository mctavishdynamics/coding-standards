use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagLowOrNoBackgroundAudio:
    standard: @{Wcag22}
    ruleId: 1.4.7
    title: Keep background sound low behind recorded speech
    statement:
        In recorded audio that is mainly speech, either have no background
        sound, let it be turned off, or keep it at least 20 decibels below
        the speech, apart from brief sounds of a second or two.
    rationale:
        Hard of hearing listeners struggle to separate speech from music or
        noise behind it.
    exceptions:
        Does not apply to audio CAPTCHAs, audio logos or content that is
        mainly musical, such as singing.
    severity: null
    noncompliant: null
    compliant: null
    languages: [html]
    tags: [level-aaa, media, audio]
    source: https://www.w3.org/TR/WCAG22/#low-or-no-background-audio
