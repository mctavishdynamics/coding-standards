use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagTimeouts:
    standard: @{Wcag22}
    ruleId: 2.2.6
    title: Warn users how long inactivity can last before data is lost
    statement:
        Tell users how long they can be inactive before data may be lost.
    rationale:
        Users who know the limit can plan breaks or save their work.
    exceptions:
        Not required when data is kept for more than 20 hours of inactivity.
    severity: null
    noncompliant: null
    compliant: null
    languages: [html]
    tags: [level-aaa, timing, sessions]
    source: https://www.w3.org/TR/WCAG22/#timeouts
