use ../lib/CodingRule

from ./Wcag22 import Wcag22

export coding-rule WcagAnimationFromInteractions:
    standard: @{Wcag22}
    ruleId: 2.3.3
    title: Let users turn off motion triggered by interaction
    statement:
        Allow motion animation that is triggered by user interaction, such
        as parallax or zooming transitions, to be disabled, for example by
        honoring the reduced motion preference.
    rationale:
        Motion can cause dizziness and nausea for people with vestibular
        disorders.
    exceptions:
        Animation that is essential to the function or the information is
        exempt.
    severity: null
    noncompliant:
        ```css
        \\\
        .panel { transition: transform 600ms ease; }
        .panel.open { transform: scale(1.4) rotate(3deg); }
        \\\
        ```
    compliant:
        ```css
        \\\
        .panel { transition: transform 600ms ease; }
        @media (prefers-reduced-motion: reduce) {
          .panel { transition: none; }
        }
        \\\
        ```
    languages: [html]
    tags: [level-aaa, animation, motion]
    source: https://www.w3.org/TR/WCAG22/#animation-from-interactions
