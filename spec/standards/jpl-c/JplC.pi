        - @{JplCRule17}
        - @{JplCRule18}
        - @{JplCRule19}
        - @{JplCRule20}
        - @{JplCRule21}
        - @{JplCRule22}
        - @{JplCRule23}
        - @{JplCRule24}
        - @{JplCRule25}
        - @{JplCRule26}
        - @{JplCRule27}
        - @{JplCRule28}
        - @{JplCRule29}
        - @{JplCRule30}
        - @{JplCRule31}
