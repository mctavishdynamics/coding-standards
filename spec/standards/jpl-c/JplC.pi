export coding-standard JplC:
    title: JPL Institutional Coding Standard for the C Programming Language
    publisher: NASA Jet Propulsion Laboratory
    url: https://web.archive.org/web/20150215140644/http://lars-lab.jpl.nasa.gov/JPL_Coding_Standard_C.pdf
    version: 1.0, March 3, 2009
    license: Copyright 2009 California Institute of Technology, all rights reserved. Rules are paraphrased.
    description:
        JPL's institutional C standard for mission-critical flight software,
        with 31 rules in four levels of compliance. Levels 5 and 6, which
        adopt the MISRA-C 2004 rules, are omitted from the public edition.
    rules:
        - @{JplCRule1}
        - @{JplCRule2}
        - @{JplCRule3}
        - @{JplCRule4}
        - @{JplCRule5}
        - @{JplCRule6}
        - @{JplCRule7}
