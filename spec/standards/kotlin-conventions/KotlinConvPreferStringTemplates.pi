use ../lib/CodingRule

from ./KotlinConventions import KotlinConventions

export coding-rule KotlinConvPreferStringTemplates:
    standard: @{KotlinConventions}
    ruleId: prefer-string-templates
    title: Prefer string templates to concatenation
    statement:
        Build strings with templates instead of concatenating pieces.
    rationale:
        Templates show the final text in one piece and are easier to read.
    exceptions: null
    severity: null
    noncompliant:
        ```kotlin
        \\\
        val line = "User " + user.name + " has " + user.points + " points"
        \\\
        ```
    compliant:
        ```kotlin
        \\\
        val line = "User ${user.name} has ${user.points} points"
        \\\
        ```
    languages: [kotlin]
    tags: [strings]
    source: https://kotlinlang.org/docs/coding-conventions.html#strings
