use ../lib/CodingRule

from ./KotlinConventions import KotlinConventions

export coding-rule KotlinConvClassAndObjectNames:
    standard: @{KotlinConventions}
    ruleId: class-and-object-names
    title: Name classes and objects in UpperCamelCase
    statement:
        Use upper camel case for the names of classes and objects.
    rationale:
        It distinguishes types from values at a glance and matches the rest
        of the ecosystem.
    exceptions: null
    severity: null
    noncompliant:
        ```kotlin
        \\\
        class shipping_label
        object defaultTheme
        \\\
        ```
    compliant:
        ```kotlin
        \\\
        class ShippingLabel
        object DefaultTheme
        \\\
        ```
    languages: [kotlin]
    tags: [naming, casing]
    source: https://kotlinlang.org/docs/coding-conventions.html#naming-rules
