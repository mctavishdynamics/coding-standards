from ./KotlinConvSemicolons import KotlinConvSemicolons
from ./KotlinConvSourceFileNames import KotlinConvSourceFileNames
from ./KotlinConvSourceFileOrganization import KotlinConvSourceFileOrganization
from ./KotlinConvStringTemplates import KotlinConvStringTemplates
from ./KotlinConvTrailingCommas import KotlinConvTrailingCommas
from ./KotlinConvTypeAliases import KotlinConvTypeAliases
from ./KotlinConvUnitReturnType import KotlinConvUnitReturnType
from ./KotlinConvWhenBranchFormatting import KotlinConvWhenBranchFormatting
from ./KotlinConvWrapChainedCalls import KotlinConvWrapChainedCalls

export coding-standard KotlinConventions:
    title: Kotlin Coding Conventions
    publisher: JetBrains
    url: https://kotlinlang.org/docs/coding-conventions.html
    version: Last updated 12 August 2026
    license: Apache-2.0
    description:
        JetBrains' official code style for Kotlin, covering source organisation,
        naming, formatting, documentation comments and idiomatic use of language
        features, with extra rules for library code.
    rules:
        - @{KotlinConvConfigureStyleInIde}
        - @{KotlinConvDirectoryStructure}
        - @{KotlinConvSourceFileNames}
        - @{KotlinConvMultiplatformProjects}
        - @{KotlinConvSourceFileOrganization}
        - @{KotlinConvClassLayout}
        - @{KotlinConvInterfaceImplementationLayout}
        - @{KotlinConvOverloadLayout}
        - @{KotlinConvPackageNames}
        - @{KotlinConvClassAndObjectNames}
        - @{KotlinConvFunctionNames}
        - @{KotlinConvNamesForClassLikeFunctions}
        - @{KotlinConvNamesForTestMethods}
        - @{KotlinConvPropertyNames}
        - @{KotlinConvEnumConstantNames}
        - @{KotlinConvNamesForBackingProperties}
        - @{KotlinConvChooseGoodNames}
        - @{KotlinConvAcronymNames}
        - @{KotlinConvIndentation}
        - @{KotlinConvHorizontalWhitespace}
        - @{KotlinConvAvoidHorizontalAlignment}
        - @{KotlinConvColon}
        - @{KotlinConvClassHeaders}
        - @{KotlinConvModifiersOrder}
        - @{KotlinConvOmitRedundantModifiers}
        - @{KotlinConvAnnotations}
        - @{KotlinConvFileAnnotations}
        - @{KotlinConvFunctions}
        - @{KotlinConvPreferExpressionBody}
        - @{KotlinConvExpressionBodies}
        - @{KotlinConvProperties}
        - @{KotlinConvControlFlowMultilineConditions}
        - @{KotlinConvControlFlowKeywordPlacement}
        - @{KotlinConvWhenBranchFormatting}
        - @{KotlinConvMethodCalls}
        - @{KotlinConvWrapChainedCalls}
        - @{KotlinConvLambdas}
        - @{KotlinConvLambdaParameterFormatting}
        - @{KotlinConvTrailingCommas}
        - @{KotlinConvDocumentationComments}
        - @{KotlinConvAvoidParamAndReturnTags}
        - @{KotlinConvAvoidRedundantConstructs}
        - @{KotlinConvUnitReturnType}
        - @{KotlinConvSemicolons}
        - @{KotlinConvStringTemplates}
        - @{KotlinConvMultiDollarInterpolation}
        - @{KotlinConvImmutability}
        - @{KotlinConvImmutableCollectionTypes}
        - @{KotlinConvDefaultParameterValues}
        - @{KotlinConvTypeAliases}
        - @{KotlinConvLambdaParameters}
        - @{KotlinConvReturnsInALambda}
        - @{KotlinConvNamedArguments}
        - @{KotlinConvConditionalStatements}
        - @{KotlinConvIfVersusWhen}
        - @{KotlinConvGuardConditionsInWhenExpression}
        - @{KotlinConvNullableBooleanValuesInConditions}
        - @{KotlinConvLoops}
        - @{KotlinConvLoopsOnRanges}
        - @{KotlinConvPreferStringTemplates}
        - @{KotlinConvMultilineStrings}
        - @{KotlinConvFunctionsVsProperties}
        - @{KotlinConvExtensionFunctions}
        - @{KotlinConvInfixFunctions}
        - @{KotlinConvFactoryFunctions}
        - @{KotlinConvFactoryFunctionsForOverloadedConstructors}
        - @{KotlinConvPlatformTypes}
        - @{KotlinConvLibraryExplicitVisibility}
        - @{KotlinConvLibraryExplicitTypes}
        - @{KotlinConvLibraryKdoc}
