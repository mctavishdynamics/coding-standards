use ../lib/CodingRule

from ./KotlinConventions import KotlinConventions

export coding-rule KotlinConvTrailingCommas:
    standard: @{KotlinConventions}
    ruleId: trailing-commas
    title: Use trailing commas at declaration sites
    statement:
        Add a trailing comma after the last element of multi-line
        declaration lists such as parameters, enum entries and type
        parameters. At call sites it is your choice.
    rationale:
        Trailing commas give cleaner diffs and make adding or reordering
        items easier.
    exceptions: null
    severity: null
    noncompliant:
        ```kotlin
        \\\
        data class Address(
            val street: String,
            val city: String
        )
        \\\
        ```
    compliant:
        ```kotlin
        \\\
        data class Address(
            val street: String,
            val city: String,
        )
        \\\
        ```
    languages: [kotlin]
    tags: [formatting, commas]
    source: https://kotlinlang.org/docs/coding-conventions.html#trailing-commas
