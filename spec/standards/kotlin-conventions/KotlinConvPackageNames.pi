use ../lib/CodingRule

from ./KotlinConventions import KotlinConventions

export coding-rule KotlinConvPackageNames:
    standard: @{KotlinConventions}
    ruleId: package-names
    title: Write package names in lowercase without underscores
    statement:
        Use lowercase package names with no underscores. Avoid multi-word
        names, and if you need one, either join the words or use camel case.
    rationale:
        A single lowercase style keeps imports uniform and avoids case
        problems on file systems.
    exceptions: null
    severity: null
    noncompliant:
        ```kotlin
        \\\
        package com.acme.order_service
        \\\
        ```
    compliant:
        ```kotlin
        \\\
        package com.acme.orders
        \\\
        ```
    languages: [kotlin]
    tags: [naming, packages]
    source: https://kotlinlang.org/docs/coding-conventions.html#naming-rules
