use ../lib/CodingRule

from ./KotlinConventions import KotlinConventions

export coding-rule KotlinConvAvoidHorizontalAlignment:
    standard: @{KotlinConventions}
    ruleId: avoid-horizontal-alignment
    title: Do not align code horizontally
    statement:
        Avoid lining up declarations or values in columns.
    rationale:
        Renaming one identifier should not force formatting changes to its
        neighbours or its uses.
    exceptions: null
    severity: null
    noncompliant:
        ```kotlin
        \\\
        val id        = 1
        val firstName = "Ada"
        val age       = 36
        \\\
        ```
    compliant:
        ```kotlin
        \\\
        val id = 1
        val firstName = "Ada"
        val age = 36
        \\\
        ```
    languages: [kotlin]
    tags: [formatting, whitespace]
    source: https://kotlinlang.org/docs/coding-conventions.html#horizontal-whitespace
