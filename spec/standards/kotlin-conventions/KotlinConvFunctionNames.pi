use ../lib/CodingRule

from ./KotlinConventions import KotlinConventions

export coding-rule KotlinConvFunctionNames:
    standard: @{KotlinConventions}
    ruleId: function-names
    title: Name functions, properties and locals in lowerCamelCase
    statement:
        Functions, properties and local variables are named in lower camel
        case, which means a lowercase first letter and words joined without
        underscores.
    rationale:
        Consistent casing tells readers that a name refers to a value or an
        action.
    exceptions: null
    severity: null
    noncompliant:
        ```kotlin
        \\\
        fun Send_Reminder() { }
        var RetryCount = 0
        \\\
        ```
    compliant:
        ```kotlin
        \\\
        fun sendReminder() { }
        var retryCount = 0
        \\\
        ```
    languages: [kotlin]
    tags: [naming, casing]
    source: https://kotlinlang.org/docs/coding-conventions.html#function-names
