use ../lib/CodingRule

from ./KotlinConventions import KotlinConventions

export coding-rule KotlinConvAcronymNames:
    standard: @{KotlinConventions}
    ruleId: acronym-names
    title: Capitalise acronyms by their length
    statement:
        In declaration names, write two-letter acronyms fully in upper case
        and capitalise only the first letter of longer acronyms.
    rationale:
        The rule keeps word boundaries readable while staying predictable.
    exceptions: null
    severity: null
    noncompliant:
        ```kotlin
        \\\
        class XMLParser
        class IoBuffer
        \\\
        ```
    compliant:
        ```kotlin
        \\\
        class XmlParser
        class IOBuffer
        \\\
        ```
    languages: [kotlin]
    tags: [naming, casing]
    source: https://kotlinlang.org/docs/coding-conventions.html#choose-good-names
