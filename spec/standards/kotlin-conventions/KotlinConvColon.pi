use ../lib/CodingRule

from ./KotlinConventions import KotlinConventions

export coding-rule KotlinConvColon:
    standard: @{KotlinConventions}
    ruleId: colon
    title: Space colons according to their role
    statement:
        Put a space before a colon that separates a type from its supertype,
        introduces a delegating constructor call, or follows the object
        keyword. Put no space before a colon between a declaration and its
        type, and always put a space after a colon.
    rationale:
        The spacing makes inheritance visually distinct from type
        annotations.
    exceptions: null
    severity: null
    noncompliant:
        ```kotlin
        \\\
        class Admin: User() {
            val level :Int = 1
        }
        \\\
        ```
    compliant:
        ```kotlin
        \\\
        class Admin : User() {
            val level: Int = 1
        }
        \\\
        ```
    languages: [kotlin]
    tags: [formatting, whitespace]
    source: https://kotlinlang.org/docs/coding-conventions.html#colon
