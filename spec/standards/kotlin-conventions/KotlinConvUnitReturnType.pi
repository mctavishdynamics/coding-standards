use ../lib/CodingRule

from ./KotlinConventions import KotlinConventions

export coding-rule KotlinConvUnitReturnType:
    standard: @{KotlinConventions}
    ruleId: unit-return-type
    title: Do not write a Unit return type
    statement:
        Do not declare a Unit return type on a function.
    rationale:
        Unit is the default, so writing it adds nothing.
    exceptions: null
    severity: null
    noncompliant:
        ```kotlin
        \\\
        fun clear(): Unit {
            items.clear()
        }
        \\\
        ```
    compliant:
        ```kotlin
        \\\
        fun clear() {
            items.clear()
        }
        \\\
        ```
    languages: [kotlin]
    tags: [redundancy, functions]
    source: https://kotlinlang.org/docs/coding-conventions.html#unit-return-type
