use ../lib/CodingRule

from ./KotlinConventions import KotlinConventions

export coding-rule KotlinConvConfigureStyleInIde:
    standard: @{KotlinConventions}
    ruleId: configure-style-in-ide
    title: Set the IDE to the Kotlin style guide and check formatting
    statement:
        In IntelliJ IDEA or Android Studio, select the Kotlin style guide as
        the code style and turn on the inspection that reports incorrect
        formatting.
    rationale:
        The IDE can then format code to these conventions automatically and
        flag anything that drifts from them.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [kotlin]
    tags: [tooling, formatting]
    source: https://kotlinlang.org/docs/coding-conventions.html#configure-style-in-ide
