use ../lib/CodingRule

from ./KotlinConventions import KotlinConventions

export coding-rule KotlinConvSemicolons:
    standard: @{KotlinConventions}
    ruleId: semicolons
    title: Leave out semicolons
    statement:
        Leave out semicolons wherever the language allows it.
    rationale:
        Kotlin ends statements at line breaks, so semicolons are clutter.
    exceptions: null
    severity: null
    noncompliant:
        ```kotlin
        \\\
        val count = 3;
        println(count);
        \\\
        ```
    compliant:
        ```kotlin
        \\\
        val count = 3
        println(count)
        \\\
        ```
    languages: [kotlin]
    tags: [redundancy]
    source: https://kotlinlang.org/docs/coding-conventions.html#semicolons
