use ../lib/CodingRule

from ./KotlinConventions import KotlinConventions

export coding-rule KotlinConvChooseGoodNames:
    standard: @{KotlinConventions}
    ruleId: choose-good-names
    title: Name classes as nouns and methods as verbs
    statement:
        Name a class with a noun or noun phrase saying what it is, and a
        method with a verb or verb phrase saying what it does, showing
        whether it mutates or returns a new value. Avoid empty words such as
        Manager or Wrapper.
    rationale:
        Names that state purpose make the code explain itself.
    exceptions: null
    severity: null
    noncompliant:
        ```kotlin
        \\\
        class DataManager
        fun userData(): List<User>
        \\\
        ```
    compliant:
        ```kotlin
        \\\
        class UserRepository
        fun loadUsers(): List<User>
        \\\
        ```
    languages: [kotlin]
    tags: [naming]
    source: https://kotlinlang.org/docs/coding-conventions.html#choose-good-names
