use ../lib/CodingRule

from ./CleanCode import CleanCode

export coding-rule CleanCodeT7:
    standard: @{CleanCode}
    ruleId: T7
    title: Look for patterns in test failures
    statement:
        Study which tests fail together. Ordering the tests well and keeping
        them complete makes patterns in the failures show the cause of the
        problem.
    rationale:
        Patterns such as every input longer than five characters failing, or
        every negative value failing, often point straight at the bug.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [testing, debugging]
    source: https://www.oreilly.com/library/view/clean-code-a/9780136083238/chapter17.html
