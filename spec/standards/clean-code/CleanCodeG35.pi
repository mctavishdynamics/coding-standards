use ../lib/CodingRule

from ./CleanCode import CleanCode

export coding-rule CleanCodeG35:
    standard: @{CleanCode}
    ruleId: G35
    title: Keep configurable data at high levels
    statement:
        Define defaults and configuration values near the top of the system,
        for example in the entry point or a configuration class, and pass
        them down instead of burying them inside low-level functions.
    rationale:
        Configuration buried deep in the code is hard to find and change,
        and the low-level code should not need to know where its settings
        come from.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        class ReportMailer {
            void send(Report report) {
                smtp.retry(3); // retry count fixed deep inside
                smtp.deliver(report.toMessage());
            }
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        class App {
            static final int MAIL_RETRIES = 3;

            void boot(Settings settings) {
                int retries = settings.intOr("mail.retries", MAIL_RETRIES);
                new ReportMailer(retries).sendDaily();
            }
        }
        \\\
        ```
    languages: [any]
    tags: [configuration, design]
    source: https://www.oreilly.com/library/view/clean-code-a/9780136083238/chapter17.html
