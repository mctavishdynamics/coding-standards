use ../lib/CodingRule

from ./CleanCode import CleanCode

export coding-rule CleanCodeG3:
    standard: @{CleanCode}
    ruleId: G3
    title: Handle every boundary condition correctly
    statement:
        Do not trust intuition about edge cases. Find each boundary and
        corner case, then write a test that proves the code handles it.
    rationale:
        Code that looks obviously right often fails at the edges, such as
        empty input, the first or last element, or the largest value.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        int lastIndexOfMax(int[] values) {
            int best = 0;
            for (int i = 1; i < values.length - 1; i++) {
                if (values[i] >= values[best]) best = i;
            }
            return best;
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        int lastIndexOfMax(int[] values) {
            if (values.length == 0) throw new IllegalArgumentException("empty");
            int best = 0;
            for (int i = 1; i < values.length; i++) {
                if (values[i] >= values[best]) best = i;
            }
            return best;
        }
        \\\
        ```
    languages: [any]
    tags: [correctness, edge-cases, testing]
    source: https://www.oreilly.com/library/view/clean-code-a/9780136083238/chapter17.html
