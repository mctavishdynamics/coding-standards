use ../lib/CodingRule

from ./CleanCode import CleanCode

export coding-rule CleanCodeG19:
    standard: @{CleanCode}
    ruleId: G19
    title: Use explanatory variables
    statement:
        Break complex calculations into steps and hold the intermediate
        results in well-named variables, so each step explains itself.
    rationale:
        A named intermediate value turns an opaque expression into readable
        code at almost no cost.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        if (line.split(":")[0].trim().equalsIgnoreCase("content-type")) {
            type = line.split(":")[1].trim();
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        String[] parts = line.split(":", 2);
        String headerName = parts[0].trim();
        String headerValue = parts[1].trim();
        if (headerName.equalsIgnoreCase("content-type")) {
            type = headerValue;
        }
        \\\
        ```
    languages: [any]
    tags: [readability, naming, variables]
    source: https://www.oreilly.com/library/view/clean-code-a/9780136083238/chapter17.html
