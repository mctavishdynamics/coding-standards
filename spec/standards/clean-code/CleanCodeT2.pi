use ../lib/CodingRule

from ./CleanCode import CleanCode

export coding-rule CleanCodeT2:
    standard: @{CleanCode}
    ruleId: T2
    title: Use a coverage tool
    statement:
        Run a coverage tool and use its report to find modules, classes and
        functions that the tests do not exercise.
    rationale:
        Coverage reports make gaps in testing visible that are easy to miss
        by reading code.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [testing, coverage, tools]
    source: https://www.oreilly.com/library/view/clean-code-a/9780136083238/chapter17.html
