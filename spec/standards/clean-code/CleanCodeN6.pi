use ../lib/CodingRule

from ./CleanCode import CleanCode

export coding-rule CleanCodeN6:
    standard: @{CleanCode}
    ruleId: N6
    title: Avoid encodings in names
    statement:
        Do not encode type or scope information in names, such as m_ or f
        prefixes, hungarian notation or subsystem prefixes.
    rationale:
        Modern tools show this information already, and the prefixes add
        noise that readers learn to ignore.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        private String m_strName;
        private int iCount;
        interface IShapeFactory { }
        \\\
        ```
    compliant:
        ```java
        \\\
        private String name;
        private int count;
        interface ShapeFactory { }
        \\\
        ```
    languages: [any]
    tags: [naming, encodings]
    source: https://www.oreilly.com/library/view/clean-code-a/9780136083238/chapter17.html
