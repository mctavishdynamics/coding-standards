use ../lib/CodingRule

from ./CleanCode import CleanCode

export coding-rule CleanCodeC5:
    standard: @{CleanCode}
    ruleId: C5
    title: Delete commented-out code
    statement:
        Remove code that has been commented out instead of leaving it in the
        file. Version control keeps the old version if anyone needs it.
    rationale:
        Readers hesitate to delete it, so it piles up, rots as the code
        around it changes and leaves everyone wondering whether it still
        matters.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        void close() {
            flush();
            // socket.shutdownOutput();
            // logger.debug("closed " + id);
            socket.close();
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        void close() {
            flush();
            socket.close();
        }
        \\\
        ```
    languages: [any]
    tags: [comments, dead-code]
    source: https://www.oreilly.com/library/view/clean-code-a/9780136083238/chapter17.html
