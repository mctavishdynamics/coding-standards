use ../lib/CodingRule

from ./CleanCode import CleanCode

export coding-rule CleanCodeC2:
    standard: @{CleanCode}
    ruleId: C2
    title: Update or remove comments that have become obsolete
    statement:
        When a comment no longer describes the code, fix it or delete it
        right away. Avoid writing comments that are likely to drift out of
        date.
    rationale:
        A stale comment misleads the reader and floats away from the code it
        once described, which is worse than having no comment at all.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        // Returns null when the user is not found.
        Optional<User> findUser(String id) {
            return Optional.ofNullable(users.get(id));
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        Optional<User> findUser(String id) {
            return Optional.ofNullable(users.get(id));
        }
        \\\
        ```
    languages: [any]
    tags: [comments, maintenance]
    source: https://www.oreilly.com/library/view/clean-code-a/9780136083238/chapter17.html
