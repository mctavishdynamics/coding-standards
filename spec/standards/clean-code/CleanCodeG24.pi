use ../lib/CodingRule

from ./CleanCode import CleanCode

export coding-rule CleanCodeG24:
    standard: @{CleanCode}
    ruleId: G24
    title: Follow the team's standard conventions
    statement:
        Follow a coding standard agreed by the team, based on common
        industry practice, covering things such as names, layout and where
        declarations go. Everyone on the team follows it.
    rationale:
        A shared convention lets anyone read and change any part of the code
        without first learning a personal style.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        public class order_service
        {
          private int Count ;
          public void Process_Order( Order o ){ Count++ ; }
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        public class OrderService {
            private int count;

            public void processOrder(Order order) {
                count++;
            }
        }
        \\\
        ```
    languages: [any]
    tags: [conventions, formatting, teamwork]
    source: https://www.oreilly.com/library/view/clean-code-a/9780136083238/chapter17.html
