use ../lib/CodingRule

from ./CleanCode import CleanCode

export coding-rule CleanCodeG23:
    standard: @{CleanCode}
    ruleId: G23
    title: Replace repeated type switches with polymorphism
    statement:
        Branch on a type in one place only, usually the factory that builds
        the objects. Every other piece of behavior that varies by type
        belongs in overridden methods.
    rationale:
        Each copy of a type switch is one more spot to hunt down and edit
        whenever a new type appears, and missing one causes a bug.
    exceptions:
        A switch may fit better when the set of types is stable and new
        operations arrive more often than new types.
    severity: null
    noncompliant:
        ```java
        \\\
        double fee(Account a) {
            switch (a.type()) {
                case BASIC: return 0;
                case PREMIUM: return 9.99;
                default: throw new IllegalStateException();
            }
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        interface Account {
            double fee();
        }

        class PremiumAccount implements Account {
            public double fee() { return 9.99; }
        }
        \\\
        ```
    languages: [any]
    tags: [polymorphism, design, conditionals]
    source: https://www.oreilly.com/library/view/clean-code-a/9780136083238/chapter17.html
