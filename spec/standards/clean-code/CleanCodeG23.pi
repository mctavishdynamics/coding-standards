use ../lib/CodingRule

from ./CleanCode import CleanCode

export coding-rule CleanCodeG23:
    standard: @{CleanCode}
    ruleId: G23
    title: Prefer polymorphism to if/else or switch/case chains
    statement:
        Allow at most one switch on a given type, typically where objects
        are created, and let polymorphism handle the type-dependent behavior
        everywhere else.
    rationale:
        Repeated switches over the same type must all be found and updated
        each time a new case is added.
    exceptions:
        When new functions are more likely to be added than new types, a
        switch can be the better choice.
    severity: null
    noncompliant:
        ```java
        \\\
        double fee(Account a) {
            switch (a.type()) {
                case BASIC: return 0;
                case PREMIUM: return 9.99;
                default: throw new IllegalStateException();
            }
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        interface Account {
            double fee();
        }

        class PremiumAccount implements Account {
            public double fee() { return 9.99; }
        }
        \\\
        ```
    languages: [any]
    tags: [polymorphism, design, conditionals]
    source: https://www.oreilly.com/library/view/clean-code-a/9780136083238/chapter17.html
