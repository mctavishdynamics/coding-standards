use ../lib/CodingRule

from ./CleanCode import CleanCode

export coding-rule CleanCodeG20:
    standard: @{CleanCode}
    ruleId: G20
    title: Name functions for what they do
    statement:
        Give each function a name that tells the reader exactly what it does
        and what it returns. If you must read the body or the documentation
        to know, rename it.
    rationale:
        A misleading or vague name forces every reader to open the
        implementation.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        Date newDate = date.add(5); // days? weeks? does it change date?
        \\\
        ```
    compliant:
        ```java
        \\\
        Date newDate = date.plusDays(5);
        date.advanceByDays(5);
        \\\
        ```
    languages: [any]
    tags: [naming, functions]
    source: https://www.oreilly.com/library/view/clean-code-a/9780136083238/chapter17.html
