use ../lib/CodingRule

from ./CleanCode import CleanCode

export coding-rule CleanCodeN1:
    standard: @{CleanCode}
    ruleId: N1
    title: Give names that reveal meaning
    statement:
        Choose a name that tells the reader the purpose or behavior of the
        thing it labels. Rename freely when the code changes and an old name
        stops fitting, and spend real effort on naming.
    rationale:
        Readers spend most of their attention on identifiers, so precise
        names carry much of the burden of making code clear.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        int d; // elapsed time in days
        List<int[]> get() {
            List<int[]> l = new ArrayList<>();
            for (int[] x : list) if (x[0] == 4) l.add(x);
            return l;
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        int elapsedDays;
        List<Cell> flaggedCells() {
            List<Cell> flagged = new ArrayList<>();
            for (Cell cell : board) if (cell.isFlagged()) flagged.add(cell);
            return flagged;
        }
        \\\
        ```
    languages: [any]
    tags: [naming, readability]
    source: https://www.oreilly.com/library/view/clean-code-a/9780136083238/chapter17.html
