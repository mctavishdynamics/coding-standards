use ../lib/CodingRule

from ./CleanCode import CleanCode

export coding-rule CleanCodeG4:
    standard: @{CleanCode}
    ruleId: G4
    title: Do not override safety mechanisms
    statement:
        Leave compiler warnings, failing tests and other safety checks
        switched on. Fix what they report instead of silencing or skipping
        them.
    rationale:
        Turning off a safety feels faster at the time but tends to lead to
        long debugging sessions later.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        @SuppressWarnings("unchecked")
        List<Order> orders = (List<Order>) cache.get("orders");
        \\\
        ```
    compliant:
        ```java
        \\\
        List<Order> orders = cache.getOrders();
        \\\
        ```
    languages: [any]
    tags: [safety, warnings, testing]
    source: https://www.oreilly.com/library/view/clean-code-a/9780136083238/chapter17.html
