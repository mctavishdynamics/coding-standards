use ../lib/CodingRule

from ./CleanCode import CleanCode

export coding-rule CleanCodeT8:
    standard: @{CleanCode}
    ruleId: T8
    title: Look for patterns in test coverage
    statement:
        Examine which code the passing tests do or do not run. The pattern
        of covered lines can explain why failing tests fail.
    rationale:
        Coverage data often shows that a failing case takes a branch that no
        passing test reaches.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [testing, coverage, debugging]
    source: https://www.oreilly.com/library/view/clean-code-a/9780136083238/chapter17.html
