use ../lib/CodingRule

from ./CleanCode import CleanCode

export coding-rule CleanCodeE1:
    standard: @{CleanCode}
    ruleId: E1
    title: Build the system with a single step
    statement:
        Make it possible to check out the project and build everything with
        one simple command, without hunting for extra pieces, scripts or
        manual setup.
    rationale:
        A multi-step build is fragile, hard to learn and discourages people
        from building often.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [build, environment, automation]
    source: https://www.oreilly.com/library/view/clean-code-a/9780136083238/chapter17.html
