use ../lib/CodingRule

from ./CleanCode import CleanCode

export coding-rule CleanCodeC1:
    standard: @{CleanCode}
    ruleId: C1
    title: Keep comments free of information that belongs elsewhere
    statement:
        Use comments only for technical notes about the code they sit
        beside. Change history, authorship, ticket status and similar
        records belong in version control, the issue tracker or other tools.
    rationale:
        Metadata in comments goes stale, clutters the file and duplicates
        what the tooling already records more reliably.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        /*
         * 2021-03-04 jsmith: added discount logic (TICKET-812)
         * 2021-05-19 akhan: fixed rounding, see email from finance
         */
        Money applyDiscount(Money price, Percent rate) {
            return price.minus(price.times(rate));
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        // Rate is applied before tax, as required by the pricing policy.
        Money applyDiscount(Money price, Percent rate) {
            return price.minus(price.times(rate));
        }
        \\\
        ```
    languages: [any]
    tags: [comments, documentation]
    source: https://www.oreilly.com/library/view/clean-code-a/9780136083238/chapter17.html
