use ../lib/CodingRule

from ./CleanCode import CleanCode

export coding-rule CleanCodeG9:
    standard: @{CleanCode}
    ruleId: G9
    title: Remove dead code
    statement:
        Delete code that can never run, such as branches whose condition
        cannot be true, catch blocks for exceptions that are never thrown
        and helpers that no longer have callers.
    rationale:
        Dead code is not updated when the rest of the system changes, so it
        decays and misleads readers about how the program behaves.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        int parsePort(String text) {
            int port = Integer.parseInt(text);
            if (port < 0 && port > 65535) {
                return -1; // can never happen
            }
            return port;
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        int parsePort(String text) {
            int port = Integer.parseInt(text);
            if (port < 0 || port > 65535) {
                throw new IllegalArgumentException("bad port " + port);
            }
            return port;
        }
        \\\
        ```
    languages: [any]
    tags: [dead-code, maintenance]
    source: https://www.oreilly.com/library/view/clean-code-a/9780136083238/chapter17.html
