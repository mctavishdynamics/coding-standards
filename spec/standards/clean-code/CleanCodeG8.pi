use ../lib/CodingRule

from ./CleanCode import CleanCode

export coding-rule CleanCodeG8:
    standard: @{CleanCode}
    ruleId: G8
    title: Keep interfaces small and hide information
    statement:
        Expose as little as possible. Give classes and modules few methods,
        few variables and few things a caller must know about, and keep
        data, utilities, constants and temporaries private.
    rationale:
        A narrow interface lowers coupling, so modules can change without
        rippling into their callers.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        public class Counter {
            public int count;
            public int step = 1;
            public void reset() { count = 0; }
            public void increment() { count += step; }
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        public class Counter {
            private int count;

            public void increment() { count++; }
            public int value() { return count; }
        }
        \\\
        ```
    languages: [any]
    tags: [encapsulation, coupling, interfaces]
    source: https://www.oreilly.com/library/view/clean-code-a/9780136083238/chapter17.html
