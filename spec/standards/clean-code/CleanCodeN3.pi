use ../lib/CodingRule

from ./CleanCode import CleanCode

export coding-rule CleanCodeN3:
    standard: @{CleanCode}
    ruleId: N3
    title: Use standard nomenclature where possible
    statement:
        Base names on existing conventions, such as design pattern names and
        the domain language the team and users share.
    rationale:
        Familiar terms carry meaning on their own, so readers understand
        more from a name without further explanation.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        class ThingMaker {
            static Order makeIt(OrderSpec spec) { /* ... */ }
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        class OrderFactory {
            static Order create(OrderSpec spec) { /* ... */ }
        }
        \\\
        ```
    languages: [any]
    tags: [naming, conventions]
    source: https://www.oreilly.com/library/view/clean-code-a/9780136083238/chapter17.html
