use ../lib/CodingRule

from ./CleanCode import CleanCode

export coding-rule CleanCodeG30:
    standard: @{CleanCode}
    ruleId: G30
    title: Make each function do one thing
    statement:
        When a function performs a sequence of separate operations, split it
        into smaller functions that each do one of them.
    rationale:
        Small single-purpose functions are easier to name, understand, test
        and reuse.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        void checkout(Cart cart) {
            for (Item i : cart.items()) {
                if (i.quantity() > stock.available(i.sku())) throw new OutOfStock(i);
            }
            Money total = cart.items().stream().map(Item::subtotal).reduce(Money.ZERO, Money::plus);
            gateway.charge(cart.customer(), total);
            mailer.send(cart.customer(), "Thanks for your order");
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        void checkout(Cart cart) {
            ensureInStock(cart);
            Money total = totalOf(cart);
            gateway.charge(cart.customer(), total);
            sendConfirmation(cart.customer());
        }
        \\\
        ```
    languages: [any]
    tags: [functions, single-responsibility]
    source: https://www.oreilly.com/library/view/clean-code-a/9780136083238/chapter17.html
