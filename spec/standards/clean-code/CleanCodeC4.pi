use ../lib/CodingRule

from ./CleanCode import CleanCode

export coding-rule CleanCodeC4:
    standard: @{CleanCode}
    ruleId: C4
    title: Write each comment with care
    statement:
        If a comment is worth writing, write it well. Choose words
        carefully, use correct grammar, stay brief and avoid explaining the
        obvious.
    rationale:
        A careless comment confuses readers and wastes the one chance to
        explain something the code cannot say on its own.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        // do the thing w/ the retry stuff, kinda hacky?? fix l8r
        int attempts = 3;
        \\\
        ```
    compliant:
        ```java
        \\\
        // The payment gateway drops about one request in a thousand, so we
        // retry up to three times before reporting a failure.
        int attempts = 3;
        \\\
        ```
    languages: [any]
    tags: [comments, clarity]
    source: https://www.oreilly.com/library/view/clean-code-a/9780136083238/chapter17.html
