use ../lib/CodingRule

from ./CleanCode import CleanCode

export coding-rule CleanCodeE2:
    standard: @{CleanCode}
    ruleId: E2
    title: Run all tests with a single step
    statement:
        Make it possible to run every unit test with one command or one
        action in the IDE. Running the whole suite should be quick, easy and
        obvious.
    rationale:
        When running tests takes effort, people run them less often and
        problems are found later.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [testing, environment, automation]
    source: https://www.oreilly.com/library/view/clean-code-a/9780136083238/chapter17.html
