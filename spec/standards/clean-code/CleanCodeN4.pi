use ../lib/CodingRule

from ./CleanCode import CleanCode

export coding-rule CleanCodeN4:
    standard: @{CleanCode}
    ruleId: N4
    title: Use unambiguous names
    statement:
        Choose names that make the purpose of a function or variable clear,
        even if that makes them longer.
    rationale:
        An ambiguous name lets readers guess wrongly about what the code
        does.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        void handle(File file) {
            // copies, then deletes the original
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        void moveToArchive(File file) {
            // copies, then deletes the original
        }
        \\\
        ```
    languages: [any]
    tags: [naming, clarity]
    source: https://www.oreilly.com/library/view/clean-code-a/9780136083238/chapter17.html
