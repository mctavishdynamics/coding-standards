use ../lib/CodingRule

from ./McIlroyUnix import McIlroyUnix

export coding-rule McIlroyWorkTogether:
    standard: @{McIlroyUnix}
    ruleId: salus-2
    title: Design programs to cooperate with each other
    statement:
        Write programs intended to be combined with other programs rather
        than to stand alone.
    rationale:
        Cooperation between small programs gives more power than any single
        large program can.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [composability]
    source: http://www.catb.org/esr/writings/taoup/html/ch01s06.html
