use ../lib/CodingRule

from ./McIlroyUnix import McIlroyUnix

export coding-rule McIlroyTryEarly:
    standard: @{McIlroyUnix}
    ruleId: 1978-iii
    title: Get software into use early and rebuild the weak parts
    statement:
        Get a first version of any system, however large, into use quickly,
        in a matter of weeks. Be ready to discard and redo the awkward parts
        once use exposes them.
    rationale:
        Early use shows what works and what does not far sooner than design
        on paper, and parts that are cheap to replace keep the system
        healthy.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [prototyping, iteration]
    source: https://archive.org/details/bstj57-6-1899
