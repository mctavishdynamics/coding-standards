use ../lib/CodingRule

from ./McIlroyUnix import McIlroyUnix

export coding-rule McIlroyDoOneThing:
    standard: @{McIlroyUnix}
    ruleId: salus-1
    title: Make each program do a single thing well
    statement:
        Write programs that each perform one task and perform it well. This
        is the first sentence of McIlroy's later short summary.
    rationale:
        A focused program is easier to understand, test and combine with
        others.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [simplicity, single-responsibility]
    source: http://www.catb.org/esr/writings/taoup/html/ch01s06.html
