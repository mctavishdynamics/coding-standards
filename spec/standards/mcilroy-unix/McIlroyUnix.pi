use ../lib/CodingStandard

from ./McIlroyDoOneThing import McIlroyDoOneThing
from ./McIlroyDoOneThingWell import McIlroyDoOneThingWell
from ./McIlroyOutputBecomesInput import McIlroyOutputBecomesInput
from ./McIlroyTextStreams import McIlroyTextStreams
from ./McIlroyTryEarly import McIlroyTryEarly
from ./McIlroyUseTools import McIlroyUseTools
from ./McIlroyWorkTogether import McIlroyWorkTogether

export coding-standard McIlroyUnix:
    title: The Unix Philosophy, as stated by Doug McIlroy
    publisher: Doug McIlroy, Bell Labs
    url: https://archive.org/details/bstj57-6-1899
    version: 1978 and 1994
    license: Copyright 1978 AT&T (Bell System Technical Journal) and Peter H. Salus (A Quarter Century of UNIX, 1994), all rights reserved. Items are paraphrased.
    description:
        Doug McIlroy's four maxims from the 1978 foreword to the Bell System
        Technical Journal Unix issue, and his later three-sentence summary
        of the Unix philosophy as quoted by Peter Salus.
    rules:
        - @{McIlroyDoOneThingWell}
        - @{McIlroyOutputBecomesInput}
        - @{McIlroyTryEarly}
        - @{McIlroyUseTools}
        - @{McIlroyDoOneThing}
        - @{McIlroyWorkTogether}
        - @{McIlroyTextStreams}
