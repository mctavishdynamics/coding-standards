use ../lib/CodingRule

from ./McIlroyUnix import McIlroyUnix

export coding-rule McIlroyDoOneThingWell:
    standard: @{McIlroyUnix}
    ruleId: 1978-i
    title: Give each program one job and do it well
    statement:
        Keep each program focused on one task. Meet a new need with a
        separate program, leaving existing programs uncluttered.
    rationale:
        Small single-purpose programs stay simple and reliable, and new
        needs are met by combining them rather than by bloating old ones.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [simplicity, single-responsibility]
    source: https://archive.org/details/bstj57-6-1899
