use ../lib/CodingRule

from ./AirbnbReact import AirbnbReact

export coding-rule AirbnbReactSelfCloseEmptyTags:
    standard: @{AirbnbReact}
    ruleId: tags-1
    title: Use a self-closing tag when an element is empty
    statement:
        Write an element without children as a self-closing tag. Enforced by
        the ESLint rule react/self-closing-comp.
    rationale:
        A self-closing tag is shorter and states plainly that the element
        has no children.
    exceptions: null
    severity: null
    noncompliant:
        ```jsx
        \\\
        <Divider spacing="large"></Divider>
        \\\
        ```
    compliant:
        ```jsx
        \\\
        <Divider spacing="large" />
        \\\
        ```
    languages: [javascript, jsx]
    tags: [formatting, jsx]
    source: https://github.com/airbnb/javascript/blob/master/react/README.md#tags
