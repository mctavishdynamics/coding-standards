use ../lib/CodingRule

from ./AirbnbReact import AirbnbReact

export coding-rule AirbnbReactJsxExtension:
    standard: @{AirbnbReact}
    ruleId: naming-1
    title: Use the .jsx extension for React components
    statement:
        Give files that contain React components the .jsx extension.
        Enforced by the ESLint rule react/jsx-filename-extension.
    rationale:
        The extension tells readers and tools that the file holds JSX.
    exceptions: null
    severity: null
    noncompliant:
        ```jsx
        \\\
        // components/SearchBox.js
        export default function SearchBox() {
          return <input type="search" />;
        }
        \\\
        ```
    compliant:
        ```jsx
        \\\
        // components/SearchBox.jsx
        export default function SearchBox() {
          return <input type="search" />;
        }
        \\\
        ```
    languages: [javascript, jsx]
    tags: [naming, files]
    source: https://github.com/airbnb/javascript/blob/master/react/README.md#naming
