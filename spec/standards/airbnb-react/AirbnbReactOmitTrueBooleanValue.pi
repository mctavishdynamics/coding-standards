use ../lib/CodingRule

from ./AirbnbReact import AirbnbReact

export coding-rule AirbnbReactOmitTrueBooleanValue:
    standard: @{AirbnbReact}
    ruleId: props-2
    title: Omit the value of a prop that is explicitly true
    statement:
        When a prop is set to true, write only the prop name. Enforced by
        the ESLint rule react/jsx-boolean-value.
    rationale:
        The bare prop name already means true, so the value adds noise.
    exceptions: null
    severity: null
    noncompliant:
        ```jsx
        \\\
        <Checkbox checked={true} />
        \\\
        ```
    compliant:
        ```jsx
        \\\
        <Checkbox checked />
        \\\
        ```
    languages: [javascript, jsx]
    tags: [props, jsx]
    source: https://github.com/airbnb/javascript/blob/master/react/README.md#props
