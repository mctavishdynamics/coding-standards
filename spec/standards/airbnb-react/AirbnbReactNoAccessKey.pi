use ../lib/CodingRule

from ./AirbnbReact import AirbnbReact

export coding-rule AirbnbReactNoAccessKey:
    standard: @{AirbnbReact}
    ruleId: props-6
    title: Do not use accessKey on elements
    statement:
        Do not set the accessKey prop on any element. Enforced by the ESLint
        rule jsx-a11y/no-access-key.
    rationale:
        Access keys can conflict with the keyboard commands that screen
        reader and keyboard users depend on.
    exceptions: null
    severity: null
    noncompliant:
        ```jsx
        \\\
        <button accessKey="s" onClick={save}>Save</button>
        \\\
        ```
    compliant:
        ```jsx
        \\\
        <button onClick={save}>Save</button>
        \\\
        ```
    languages: [javascript, jsx]
    tags: [accessibility, keyboard]
    source: https://github.com/airbnb/javascript/blob/master/react/README.md#props
