use ../lib/CodingRule

from ./AirbnbReact import AirbnbReact

export coding-rule AirbnbReactSelfClosingTagSpace:
    standard: @{AirbnbReact}
    ruleId: spacing-1
    title: Put a single space before the slash of a self-closing tag
    statement:
        Write exactly one space between the tag name or last prop and the
        closing slash of a self-closing tag, on the same line. Enforced by
        the ESLint rules no-multi-spaces and react/jsx-tag-spacing.
    rationale:
        Consistent spacing keeps self-closing tags uniform and easy to read.
    exceptions: null
    severity: null
    noncompliant:
        ```jsx
        \\\
        <Spinner/>
        <Spinner      />
        <Spinner
         />
        \\\
        ```
    compliant:
        ```jsx
        \\\
        <Spinner />
        \\\
        ```
    languages: [javascript, jsx]
    tags: [formatting, spacing, jsx]
    source: https://github.com/airbnb/javascript/blob/master/react/README.md#spacing
