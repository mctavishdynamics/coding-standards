use ../lib/CodingStandard

from ./AirbnbReactAlwaysUseJsx import AirbnbReactAlwaysUseJsx
from ./AirbnbReactArrowFunctionsForClosures import
    AirbnbReactArrowFunctionsForClosures
from ./AirbnbReactBindInConstructor import AirbnbReactBindInConstructor
from ./AirbnbReactCamelCasePropNames import AirbnbReactCamelCasePropNames
from ./AirbnbReactClassMemberOrder import AirbnbReactClassMemberOrder
from ./AirbnbReactCloseMultilineTagOnNewLine import
    AirbnbReactCloseMultilineTagOnNewLine
from ./AirbnbReactComponentNaming import AirbnbReactComponentNaming
from ./AirbnbReactCreateClassMemberOrder import
    AirbnbReactCreateClassMemberOrder
from ./AirbnbReactDefineStaticProperties import
    AirbnbReactDefineStaticProperties
from ./AirbnbReactExplicitArrayObjectPropTypes import
    AirbnbReactExplicitArrayObjectPropTypes
from ./AirbnbReactExplicitDefaultProps import AirbnbReactExplicitDefaultProps
from ./AirbnbReactHocDisplayName import AirbnbReactHocDisplayName
from ./AirbnbReactImgAltText import AirbnbReactImgAltText
from ./AirbnbReactJsxAlignment import AirbnbReactJsxAlignment
from ./AirbnbReactJsxExtension import AirbnbReactJsxExtension
from ./AirbnbReactJsxQuotes import AirbnbReactJsxQuotes
from ./AirbnbReactNoAccessKey import AirbnbReactNoAccessKey
from ./AirbnbReactNoArrayIndexKey import AirbnbReactNoArrayIndexKey
from ./AirbnbReactNoCreateElement import AirbnbReactNoCreateElement
from ./AirbnbReactNoCurlySpacing import AirbnbReactNoCurlySpacing
from ./AirbnbReactNoDisplayNameDeclaration import
    AirbnbReactNoDisplayNameDeclaration
from ./AirbnbReactNoIsMounted import AirbnbReactNoIsMounted
from ./AirbnbReactNoMixins import AirbnbReactNoMixins
from ./AirbnbReactNoRedundantAlt import AirbnbReactNoRedundantAlt
from ./AirbnbReactNoUnderscorePrefix import AirbnbReactNoUnderscorePrefix
from ./AirbnbReactOmitTrueBooleanValue import AirbnbReactOmitTrueBooleanValue
from ./AirbnbReactOneComponentPerFile import AirbnbReactOneComponentPerFile
from ./AirbnbReactPascalCaseFilenames import AirbnbReactPascalCaseFilenames
from ./AirbnbReactPreferClassOrFunction import AirbnbReactPreferClassOrFunction
from ./AirbnbReactPropsNaming import AirbnbReactPropsNaming
from ./AirbnbReactRefCallbacks import AirbnbReactRefCallbacks
from ./AirbnbReactReferenceNaming import AirbnbReactReferenceNaming
from ./AirbnbReactRenderReturnsValue import AirbnbReactRenderReturnsValue
from ./AirbnbReactSelfCloseEmptyTags import AirbnbReactSelfCloseEmptyTags
from ./AirbnbReactSelfClosingTagSpace import AirbnbReactSelfClosingTagSpace
from ./AirbnbReactSpreadPropsSparingly import AirbnbReactSpreadPropsSparingly
from ./AirbnbReactValidAriaRoles import AirbnbReactValidAriaRoles
from ./AirbnbReactWrapMultilineJsx import AirbnbReactWrapMultilineJsx

export coding-standard AirbnbReact:
    title: Airbnb React/JSX Style Guide
    publisher: Airbnb
    url: https://github.com/airbnb/javascript/tree/master/react
    version: null
    license: MIT License, Copyright (c) 2012 Airbnb
    description:
        Airbnb's style guide for React components and JSX. It covers
        component declaration, naming, JSX formatting, props, refs, methods
        and the ordering of component members, with many rules backed by
        ESLint.
    rules:
        - @{AirbnbReactOneComponentPerFile}
        - @{AirbnbReactAlwaysUseJsx}
        - @{AirbnbReactNoCreateElement}
        - @{AirbnbReactExplicitArrayObjectPropTypes}
        - @{AirbnbReactPreferClassOrFunction}
        - @{AirbnbReactNoMixins}
        - @{AirbnbReactJsxExtension}
        - @{AirbnbReactPascalCaseFilenames}
        - @{AirbnbReactReferenceNaming}
        - @{AirbnbReactComponentNaming}
        - @{AirbnbReactHocDisplayName}
        - @{AirbnbReactPropsNaming}
        - @{AirbnbReactNoDisplayNameDeclaration}
        - @{AirbnbReactJsxAlignment}
        - @{AirbnbReactJsxQuotes}
        - @{AirbnbReactSelfClosingTagSpace}
        - @{AirbnbReactNoCurlySpacing}
        - @{AirbnbReactCamelCasePropNames}
        - @{AirbnbReactOmitTrueBooleanValue}
        - @{AirbnbReactImgAltText}
        - @{AirbnbReactNoRedundantAlt}
        - @{AirbnbReactValidAriaRoles}
        - @{AirbnbReactNoAccessKey}
        - @{AirbnbReactNoArrayIndexKey}
        - @{AirbnbReactExplicitDefaultProps}
        - @{AirbnbReactSpreadPropsSparingly}
        - @{AirbnbReactRefCallbacks}
        - @{AirbnbReactWrapMultilineJsx}
        - @{AirbnbReactSelfCloseEmptyTags}
        - @{AirbnbReactCloseMultilineTagOnNewLine}
        - @{AirbnbReactArrowFunctionsForClosures}
        - @{AirbnbReactBindInConstructor}
        - @{AirbnbReactNoUnderscorePrefix}
        - @{AirbnbReactRenderReturnsValue}
        - @{AirbnbReactClassMemberOrder}
        - @{AirbnbReactDefineStaticProperties}
        - @{AirbnbReactCreateClassMemberOrder}
        - @{AirbnbReactNoIsMounted}
