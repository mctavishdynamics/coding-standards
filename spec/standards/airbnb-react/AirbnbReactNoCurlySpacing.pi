use ../lib/CodingRule

from ./AirbnbReact import AirbnbReact

export coding-rule AirbnbReactNoCurlySpacing:
    standard: @{AirbnbReact}
    ruleId: spacing-2
    title: Do not pad JSX curly braces with spaces
    statement:
        Write JSX expression containers with no space just inside the
        braces. Enforced by the ESLint rule react/jsx-curly-spacing.
    rationale:
        Unpadded braces keep attribute values compact and consistent.
    exceptions: null
    severity: null
    noncompliant:
        ```jsx
        \\\
        <Avatar user={ currentUser } />
        \\\
        ```
    compliant:
        ```jsx
        \\\
        <Avatar user={currentUser} />
        \\\
        ```
    languages: [javascript, jsx]
    tags: [formatting, spacing, jsx]
    source: https://github.com/airbnb/javascript/blob/master/react/README.md#spacing
