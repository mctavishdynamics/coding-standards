use ../lib/CodingRule

from ./AirbnbReact import AirbnbReact

export coding-rule AirbnbReactPascalCaseFilenames:
    standard: @{AirbnbReact}
    ruleId: naming-2
    title: Use PascalCase for component file names
    statement:
        Name component files in PascalCase, such as BookingForm.jsx.
    rationale:
        The file name then matches the component it exports, which makes
        components easy to locate.
    exceptions: null
    severity: null
    noncompliant:
        ```jsx
        \\\
        // booking-form.jsx
        export default function BookingForm() {
          return <form />;
        }
        \\\
        ```
    compliant:
        ```jsx
        \\\
        // BookingForm.jsx
        export default function BookingForm() {
          return <form />;
        }
        \\\
        ```
    languages: [javascript, jsx]
    tags: [naming, files]
    source: https://github.com/airbnb/javascript/blob/master/react/README.md#naming
