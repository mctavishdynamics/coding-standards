use ../lib/CodingRule

from ./AirbnbReact import AirbnbReact

export coding-rule AirbnbReactJsxQuotes:
    standard: @{AirbnbReact}
    ruleId: quotes-1
    title: Use double quotes for JSX attributes
    statement:
        Use double quotes for JSX attribute values and single quotes for all
        other JavaScript strings. Enforced by the ESLint rule jsx-quotes.
    rationale:
        HTML attributes usually use double quotes, and JSX attributes follow
        the same habit.
    exceptions: null
    severity: null
    noncompliant:
        ```jsx
        \\\
        <Button kind='primary' />
        <Box style={{ margin: "8px" }} />
        \\\
        ```
    compliant:
        ```jsx
        \\\
        <Button kind="primary" />
        <Box style={{ margin: '8px' }} />
        \\\
        ```
    languages: [javascript, jsx]
    tags: [formatting, quotes, jsx]
    source: https://github.com/airbnb/javascript/blob/master/react/README.md#quotes
