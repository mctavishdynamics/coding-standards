use ../lib/CodingRule

from ./AirbnbReact import AirbnbReact

export coding-rule AirbnbReactImgAltText:
    standard: @{AirbnbReact}
    ruleId: props-3
    title: Always include an alt prop on img elements
    statement:
        Give every img element an alt prop. A purely presentational image
        may use an empty alt or role presentation. Enforced by the ESLint
        rule jsx-a11y/alt-text.
    rationale:
        Screen readers rely on alt text to describe images to people who
        cannot see them.
    exceptions:
        A presentational image may have an empty alt or role presentation.
    severity: null
    noncompliant:
        ```jsx
        \\\
        <img src="/team/lena.jpg" />
        \\\
        ```
    compliant:
        ```jsx
        \\\
        <img src="/team/lena.jpg" alt="Lena presenting at the meetup" />
        <img src="/divider.svg" alt="" />
        \\\
        ```
    languages: [javascript, jsx]
    tags: [accessibility, images]
    source: https://github.com/airbnb/javascript/blob/master/react/README.md#props
