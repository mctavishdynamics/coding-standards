use ../lib/CodingRule

from ./AirbnbReact import AirbnbReact

export coding-rule AirbnbReactCloseMultilineTagOnNewLine:
    standard: @{AirbnbReact}
    ruleId: tags-2
    title: Close a tag with multi-line props on a new line
    statement:
        When a component's props span several lines, put the closing bracket
        of its tag on a line of its own. Enforced by the ESLint rule
        react/jsx-closing-bracket-location.
    rationale:
        A closing bracket on its own line separates the props from the
        children and keeps diffs clean when props are added.
    exceptions: null
    severity: null
    noncompliant:
        ```jsx
        \\\
        <Field
          name="email"
          type="email" />
        \\\
        ```
    compliant:
        ```jsx
        \\\
        <Field
          name="email"
          type="email"
        />
        \\\
        ```
    languages: [javascript, jsx]
    tags: [formatting, jsx]
    source: https://github.com/airbnb/javascript/blob/master/react/README.md#tags
