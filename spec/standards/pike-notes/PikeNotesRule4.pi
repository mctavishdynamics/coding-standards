use ../lib/CodingRule

from ./PikeNotes import PikeNotes

export coding-rule PikeNotesRule4:
    standard: @{PikeNotes}
    ruleId: rule-4
    title: Use simple algorithms and simple data structures
    statement:
        Choose simple algorithms and simple data structures. Arrays, linked
        lists, hash tables and binary trees, alone or combined, cover nearly
        every practical need.
    rationale:
        Elaborate algorithms take longer to get right and hide more defects.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [algorithms, data-structures, simplicity]
    source: https://www.cs.princeton.edu/courses/archive/spr01/cs217/pike.html
