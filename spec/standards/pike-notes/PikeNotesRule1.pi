use ../lib/CodingRule

from ./PikeNotes import PikeNotes

export coding-rule PikeNotesRule1:
    standard: @{PikeNotes}
    ruleId: rule-1
    title: Do not guess where a program spends its time
    statement:
        Find the slow part by evidence before optimising anything; intuition
        about hot spots is usually wrong.
    rationale:
        Time tends to go to unexpected places, so a hunch-driven speed-up
        mostly buys complexity without benefit.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [performance, optimization]
    source: https://www.cs.princeton.edu/courses/archive/spr01/cs217/pike.html
