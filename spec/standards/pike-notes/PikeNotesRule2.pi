use ../lib/CodingRule

from ./PikeNotes import PikeNotes

export coding-rule PikeNotesRule2:
    standard: @{PikeNotes}
    ruleId: rule-2
    title: Measure before tuning for speed
    statement:
        Measure first. Optimise a part of the code only when the numbers
        show it takes the bulk of the running time.
    rationale:
        Without numbers there is no way to know whether a change helps, and
        small gains in code that barely runs are not worth the cost in
        clarity.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [performance, profiling]
    source: https://www.cs.princeton.edu/courses/archive/spr01/cs217/pike.html
