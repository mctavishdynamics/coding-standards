use ../lib/CodingRule

from ./PikeNotes import PikeNotes

export coding-rule PikeNotesIssuesOfTypography:
    standard: @{PikeNotes}
    ruleId: issues-of-typography
    title: Keep the layout plain and free of decoration
    statement:
        Lay code out with consistent, simple conventions such as
        indentation, and leave out ornament. Comments in particular should
        be short and should not be framed in boxes or banners.
    rationale:
        A program is read by people before machines. Decoration draws the
        eye to detail that does not matter and hides the intent of the code.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        /*==================================*/
        /*====      RESET COUNTERS      ====*/
        /*==================================*/
        hits   =   0 ;
        misses =   0 ;
        \\\
        ```
    compliant:
        ```c
        \\\
        /* reset counters */
        hits = 0;
        misses = 0;
        \\\
        ```
    languages: [c]
    tags: [formatting, comments, readability]
    source: https://www.cs.princeton.edu/courses/archive/spr01/cs217/pike.html
