use ../lib/CodingRule

from ./PikeNotes import PikeNotes

export coding-rule PikeNotesNoEmbeddedCapitals:
    standard: @{PikeNotes}
    ruleId: variable-names-capitals
    title: Avoid capital letters inside names
    statement:
        Pike prefers lower-case names without capitals in the middle, such
        as maxlen rather than MaxLen. He states this as personal taste.
    rationale:
        In his view names with internal capitals read awkwardly, much like
        uneven typography in prose.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        int MaxRetryCount = 3;
        \\\
        ```
    compliant:
        ```c
        \\\
        int maxretry = 3;
        \\\
        ```
    languages: [c]
    tags: [naming, style]
    source: https://www.cs.princeton.edu/courses/archive/spr01/cs217/pike.html
