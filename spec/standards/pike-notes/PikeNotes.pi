use ../lib/CodingStandard

from ./PikeNotesComments import PikeNotesComments
from ./PikeNotesConsistentNaming import PikeNotesConsistentNaming
from ./PikeNotesFunctionPointers import PikeNotesFunctionPointers
from ./PikeNotesIncludeFiles import PikeNotesIncludeFiles
from ./PikeNotesIssuesOfTypography import PikeNotesIssuesOfTypography
from ./PikeNotesNoEmbeddedCapitals import PikeNotesNoEmbeddedCapitals
from ./PikeNotesProcedureNames import PikeNotesProcedureNames
from ./PikeNotesProgrammingWithData import PikeNotesProgrammingWithData
from ./PikeNotesRule1 import PikeNotesRule1
from ./PikeNotesRule2 import PikeNotesRule2
from ./PikeNotesRule3 import PikeNotesRule3
from ./PikeNotesRule4 import PikeNotesRule4
from ./PikeNotesRule5 import PikeNotesRule5
from ./PikeNotesUseOfPointers import PikeNotesUseOfPointers
from ./PikeNotesVariableNameLength import PikeNotesVariableNameLength

export coding-standard PikeNotes:
    title: Notes on Programming in C
    publisher: Rob Pike
    url: https://www.cs.princeton.edu/courses/archive/spr01/cs217/pike.html
    version: September 1987
    license: Copyright Rob Pike, all rights reserved. Items are paraphrased.
    description:
        Rob Pike's short essays on clarity in C programming, covering
        naming, pointers, comments, complexity, data-driven design and
        include files.
    rules:
        - @{PikeNotesIssuesOfTypography}
        - @{PikeNotesVariableNameLength}
        - @{PikeNotesConsistentNaming}
        - @{PikeNotesNoEmbeddedCapitals}
        - @{PikeNotesUseOfPointers}
        - @{PikeNotesProcedureNames}
        - @{PikeNotesComments}
        - @{PikeNotesRule1}
        - @{PikeNotesRule2}
        - @{PikeNotesRule3}
        - @{PikeNotesRule4}
        - @{PikeNotesRule5}
        - @{PikeNotesProgrammingWithData}
        - @{PikeNotesFunctionPointers}
        - @{PikeNotesIncludeFiles}
