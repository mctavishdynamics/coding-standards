use ../lib/CodingRule

from ./PikeNotes import PikeNotes

export coding-rule PikeNotesRule5:
    standard: @{PikeNotes}
    ruleId: rule-5
    title: Design the data first
    statement:
        Spend design effort on how the data is represented and organised. A
        good representation tends to make the code that works on it obvious.
    rationale:
        Pike holds that programming centres on data structures rather than
        on algorithms.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [c]
    tags: [data-structures, design]
    source: https://www.cs.princeton.edu/courses/archive/spr01/cs217/pike.html
