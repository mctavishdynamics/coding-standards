use ../lib/CodingStandard

from ./GoogleRAvoidDotCaseNames import GoogleRAvoidDotCaseNames
from ./GoogleRDontUseAttach import GoogleRDontUseAttach
from ./GoogleRFunctionNamesBigCamelCase import GoogleRFunctionNamesBigCamelCase
from ./GoogleRPackageLevelDocumentation import GoogleRPackageLevelDocumentation
from ./GoogleRPrivateFunctionsLeadingDot import
    GoogleRPrivateFunctionsLeadingDot
from ./GoogleRQualifyingNamespaces import GoogleRQualifyingNamespaces
from ./GoogleRRightHandAssignment import GoogleRRightHandAssignment
from ./GoogleRUseExplicitReturns import GoogleRUseExplicitReturns
from ./GoogleRUseOfBullets import GoogleRUseOfBullets

export coding-standard GoogleR:
    title: Google R Style Guide
    publisher: Google
    url: https://google.github.io/styleguide/Rguide.html
    version: null
    license: Creative Commons Attribution 3.0 Unported (CC BY 3.0), adapting the Tidyverse Style Guide under CC BY-SA 2.0
    description:
        Google's R style guide, a fork of the Tidyverse Style Guide that
        lists only where Google's practice differs, such as naming,
        assignment, returns and namespaces.
    rules:
        - @{GoogleRFunctionNamesBigCamelCase}
        - @{GoogleRPrivateFunctionsLeadingDot}
        - @{GoogleRAvoidDotCaseNames}
        - @{GoogleRDontUseAttach}
        - @{GoogleRRightHandAssignment}
        - @{GoogleRUseExplicitReturns}
        - @{GoogleRQualifyingNamespaces}
        - @{GoogleRPackageLevelDocumentation}
        - @{GoogleRUseOfBullets}
