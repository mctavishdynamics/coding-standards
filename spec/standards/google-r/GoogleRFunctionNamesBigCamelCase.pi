use ../lib/CodingRule

from ./GoogleR import GoogleR

export coding-rule GoogleRFunctionNamesBigCamelCase:
    standard: @{GoogleR}
    ruleId: naming-conventions
    title: Name functions in BigCamelCase
    statement:
        Give function names BigCamelCase, so that each word starts with a
        capital letter and words are not separated.
    rationale:
        A distinct case for functions sets them apart from the other objects
        in a script, such as data frames and vectors.
    exceptions: null
    severity: null
    noncompliant:
        ```r
        \\\
        calculate_total <- function(prices) {
          return(sum(prices))
        }
        \\\
        ```
    compliant:
        ```r
        \\\
        CalculateTotal <- function(prices) {
          return(sum(prices))
        }
        \\\
        ```
    languages: [r]
    tags: [naming, functions]
    source: https://google.github.io/styleguide/Rguide.html#naming-conventions
