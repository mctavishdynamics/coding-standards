use ../lib/CodingRule

from ./GoogleR import GoogleR

export coding-rule GoogleRRightHandAssignment:
    standard: @{GoogleR}
    ruleId: right-hand-assignment
    title: Do not use right-hand assignment
    statement:
        Assign with the name on the left using the left arrow. Do not end a
        pipeline or expression with the right arrow to assign its result.
    rationale:
        Right-hand assignment is unlike most other languages and hides where
        an object is defined. Searching for one assignment form is easier
        than searching for two, possibly split across lines.
    exceptions: null
    severity: null
    noncompliant:
        ```r
        \\\
        orders %>%
          dplyr::filter(status == "open") -> open_orders
        \\\
        ```
    compliant:
        ```r
        \\\
        open_orders <- orders %>%
          dplyr::filter(status == "open")
        \\\
        ```
    languages: [r]
    tags: [assignment, pipes, readability]
    source: https://google.github.io/styleguide/Rguide.html#right-hand-assignment
