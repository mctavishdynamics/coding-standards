use ../lib/CodingRule

from ./GoogleR import GoogleR

export coding-rule GoogleRPackageLevelDocumentation:
    standard: @{GoogleR}
    ruleId: package-level-documentation
    title: Give every package a package documentation file
    statement:
        Every package has a package documentation file, named after the
        package in the form packagename-package.R.
    rationale:
        A single, predictably named file gives readers and tools one place
        to find the overview of the package.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```r
        \\\
        # File R/salesreport-package.R
        #' salesreport: Summaries of regional sales data
        #'
        #' Builds monthly and quarterly sales summaries.
        #' @keywords internal
        "_PACKAGE"
        \\\
        ```
    languages: [r]
    tags: [documentation, packages]
    source: https://google.github.io/styleguide/Rguide.html#package-level-documentation
