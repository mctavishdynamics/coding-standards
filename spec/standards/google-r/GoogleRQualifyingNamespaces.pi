use ../lib/CodingRule

from ./GoogleR import GoogleR

export coding-rule GoogleRQualifyingNamespaces:
    standard: @{GoogleR}
    ruleId: qualifying-namespaces
    title: Qualify the namespace of every external function
    statement:
        Qualify calls into other packages with the package::function form.
        Avoid the Roxygen import tag that pulls an entire package into
        NAMESPACE; if a single function must be imported, place its importFrom
        tag in the Roxygen block of the function that needs it.
    rationale:
        Importing every function of a package risks name collisions in a
        very large codebase. The small cost of the double colon is repaid by
        dependencies that are easy to see.
    exceptions:
        Infix operators such as %>% and some rlang pronouns such as .data have
        to be imported. Base R packages (stats, graphics, grDevices, utils,
        datasets and methods) can be used without qualification, and a whole
        package may be imported when necessary.
    severity: null
    noncompliant:
        ```r
        \\\
        #' @import dplyr
        SummarizeSales <- function(sales) {
          return(summarize(sales, total = sum(amount)))
        }
        \\\
        ```
    compliant:
        ```r
        \\\
        SummarizeSales <- function(sales) {
          return(dplyr::summarize(sales, total = sum(amount)))
        }
        \\\
        ```
    languages: [r]
    tags: [namespaces, dependencies, packages]
    source: https://google.github.io/styleguide/Rguide.html#qualifying-namespaces
