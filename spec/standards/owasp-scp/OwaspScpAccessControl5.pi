use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAccessControl5:
    standard: @{OwaspScp}
    ruleId: access-control-5
    title: Enforce authorization on every request
    statement:
        Every single request must pass the authorization check. That includes
        calls from server-side scripts and include files as well as requests
        issued by rich clients, for example AJAX calls.
    rationale:
        Attackers call back-end endpoints directly, so any request type that
        skips the check is an open door.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [access-control]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#access-control
