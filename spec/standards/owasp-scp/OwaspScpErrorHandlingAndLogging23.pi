use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpErrorHandlingAndLogging23:
    standard: @{OwaspScp}
    ruleId: error-handling-and-logging-23
    title: Log cryptographic module failures
    statement:
        Record failures of cryptographic modules.
    rationale:
        Cryptographic failures can leave data unprotected and need prompt
        attention.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [logging, cryptography]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#error-handling-and-logging
