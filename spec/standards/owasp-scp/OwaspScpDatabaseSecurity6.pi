use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDatabaseSecurity6:
    standard: @{OwaspScp}
    ruleId: database-security-6
    title: Store connection strings encrypted outside the code
    statement:
        Never embed connection strings in application code. Put them,
        encrypted, in their own configuration file kept on a trusted system.
    rationale:
        Embedded connection strings leak through version control and build
        output, and they are hard to change.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        conn = psycopg.connect("postgresql://app:Winter2024@db.internal/shop")
        \\\
        ```
    compliant:
        ```python
        \\\
        conn = psycopg.connect(config.secret("shop_db_url"))
        \\\
        ```
    languages: [any]
    tags: [database, secrets, configuration]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#database-security
