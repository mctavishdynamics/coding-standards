use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDatabaseSecurity13:
    standard: @{OwaspScp}
    ruleId: database-security-13
    title: Use separate database credentials per trust level
    statement:
        Connect to the database with different credentials for each trust
        level, such as user, read-only user, guest and administrator.
    rationale:
        Separate credentials keep a flaw in a low-trust path from reaching
        high-privilege operations.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [database, least-privilege, credentials]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#database-security
