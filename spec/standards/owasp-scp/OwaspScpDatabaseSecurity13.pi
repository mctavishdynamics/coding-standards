use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDatabaseSecurity13:
    standard: @{OwaspScp}
    ruleId: database-security-13
    title: Give each trust level its own database credentials
    statement:
        Use distinct database credentials for each level of trust, for
        example ordinary users, read-only users, guests and administrators.
    rationale:
        With separate credentials, a flaw in a low-trust code path cannot
        reach operations that need high privilege.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [database, least-privilege, credentials]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#database-security
