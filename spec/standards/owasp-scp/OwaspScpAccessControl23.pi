use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAccessControl23:
    standard: @{OwaspScp}
    ruleId: access-control-23
    title: Give service accounts the least privilege possible
    statement:
        Give service accounts and accounts used for connections to or from
        external systems only the privileges they need.
    rationale:
        If such an account is compromised, least privilege limits what the
        attacker can do.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [access-control, least-privilege]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#access-control
