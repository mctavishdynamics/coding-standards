use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpMemoryManagement5:
    standard: @{OwaspScp}
    ruleId: memory-management-5
    title: Truncate input strings to a reasonable length
    statement:
        Before any string from input reaches a copy, concatenation or similar
        routine, shorten it to a sensible maximum length.
    rationale:
        Bounding length early stops oversized input from overflowing buffers
        later.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [memory, input-validation, strings]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#memory-management
