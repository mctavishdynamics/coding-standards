use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDatabaseSecurity2:
    standard: @{OwaspScp}
    ruleId: database-security-2
    title: Validate input and encode output for database commands
    statement:
        Apply input validation and output encoding to database commands,
        paying attention to meta characters. If either fails, do not run the
        command.
    rationale:
        Meta characters can change the meaning of a command, and running it
        after a failed check defeats the check.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [database, input-validation, output-encoding]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#database-security
