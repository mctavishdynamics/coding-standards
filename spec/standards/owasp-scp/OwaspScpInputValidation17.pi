use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpInputValidation17:
    standard: @{OwaspScp}
    ruleId: input-validation-17
    title: Canonicalize input to defeat obfuscation
    statement:
        Reduce input to its simplest canonical form before checking it, so
        obfuscated variants are treated the same as their plain equivalents.
    rationale:
        Attackers encode payloads in many equivalent ways to slip past
        filters; canonicalization removes those disguises.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [input-validation, canonicalization]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#input-validation
