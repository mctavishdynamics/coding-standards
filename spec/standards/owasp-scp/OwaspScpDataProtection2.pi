use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDataProtection2:
    standard: @{OwaspScp}
    ruleId: data-protection-2
    title: Protect and purge temporary copies of sensitive data
    statement:
        Protect cached and temporary copies of sensitive data on the server
        from unauthorized access, and delete them as soon as they are no
        longer needed.
    rationale:
        Forgotten temporary files are an easy source of leaked data.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [data-protection, caching, temporary-files]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#data-protection
