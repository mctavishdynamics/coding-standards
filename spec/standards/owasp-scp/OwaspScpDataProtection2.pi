use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDataProtection2:
    standard: @{OwaspScp}
    ruleId: data-protection-2
    title: Protect and remove temporary copies of sensitive data
    statement:
        Restrict access to cached or temporary server-side copies of
        sensitive data, and delete those copies once they have served their
        purpose.
    rationale:
        Temporary files that nobody remembers are a common way for data to
        leak.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [data-protection, caching, temporary-files]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#data-protection
