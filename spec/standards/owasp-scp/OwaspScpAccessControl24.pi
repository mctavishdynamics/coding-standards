use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAccessControl24:
    standard: @{OwaspScp}
    ruleId: access-control-24
    title: Document access rules in an access control policy
    statement:
        Write an access control policy that documents the application's
        business rules, data types and authorization criteria and processes,
        covering both data and system resources.
    rationale:
        A written policy lets access be provisioned and controlled
        consistently and reviewed.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [access-control, documentation]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#access-control
