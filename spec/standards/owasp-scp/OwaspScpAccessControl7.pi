use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAccessControl7:
    standard: @{OwaspScp}
    ruleId: access-control-7
    title: Restrict access to files and resources to authorized users
    statement:
        Allow only authorized users to access files and other resources,
        including those outside the application's direct control.
    rationale:
        Resources that are reachable without a check can be read or modified
        by anyone who finds them.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [access-control]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#access-control
