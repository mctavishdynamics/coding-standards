use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAccessControl7:
    standard: @{OwaspScp}
    ruleId: access-control-7
    title: Let only authorized users reach files and resources
    statement:
        Require authorization for every file and resource the application
        exposes, including ones held by systems the application does not
        itself control.
    rationale:
        Anything reachable without an authorization check can be read or
        changed by whoever discovers it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [access-control]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#access-control
