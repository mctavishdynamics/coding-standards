use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAccessControl18:
    standard: @{OwaspScp}
    ruleId: access-control-18
    title: Cap the number of transactions per user or device
    statement:
        Set a maximum on the transactions a single account or device may
        make within a time window. Choose a limit that ordinary business use
        never reaches but that still hinders automated attacks.
    rationale:
        Rate limits slow scraping, brute-force guessing and similar
        automated abuse.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [access-control, rate-limiting]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#access-control
