use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAccessControl18:
    standard: @{OwaspScp}
    ruleId: access-control-18
    title: Rate-limit transactions per user or device
    statement:
        Limit how many transactions one user or device can perform in a
        period, set above the real business need but low enough to deter
        automation.
    rationale:
        Rate limits slow down scraping, brute force and other automated
        abuse.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [access-control, rate-limiting]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#access-control
