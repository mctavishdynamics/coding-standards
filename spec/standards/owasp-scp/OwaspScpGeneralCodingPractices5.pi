use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpGeneralCodingPractices5:
    standard: @{OwaspScp}
    ruleId: general-coding-practices-5
    title: Protect shared variables and resources from concurrent access
    statement:
        Guard shared variables and resources against inappropriate
        concurrent access.
    rationale:
        Unprotected shared state can be corrupted or read in an inconsistent
        state.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [general, concurrency]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#general-coding-practices
