use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSystemConfiguration9:
    standard: @{OwaspScp}
    ruleId: system-configuration-9
    title: Define which HTTP methods the application supports
    statement:
        Decide which HTTP methods, such as GET and POST, the application
        supports and whether pages handle them differently.
    rationale:
        Undefined method handling leads to inconsistent checks, for example
        a control enforced on POST but not on GET.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [configuration, http]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#system-configuration
