use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSessionManagement8:
    standard: @{OwaspScp}
    ruleId: session-management-8
    title: Disallow persistent logins and end sessions periodically
    statement:
        Do not allow persistent logins, and terminate sessions periodically
        even while they are active, giving users enough warning to avoid
        disruption.
    rationale:
        Long-lived sessions extend the time a stolen session identifier
        remains useful.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [session, timeout]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#session-management
