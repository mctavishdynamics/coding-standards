use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSystemConfiguration16:
    standard: @{OwaspScp}
    ruleId: system-configuration-16
    title: Use a change control system for code
    statement:
        Manage and record changes to code in development and production with
        a software change control system.
    rationale:
        Controlled, recorded changes make unauthorized or faulty changes
        visible and reversible.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [configuration, change-control]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#system-configuration
