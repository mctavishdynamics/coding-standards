use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpOutputEncoding5:
    standard: @{OwaspScp}
    ruleId: output-encoding-5
    title: Make output encoding safe for every target system
    statement:
        Check that the encoding you apply is safe for every system that will
        consume the output, not just the first one.
    rationale:
        Data often passes through several interpreters, and encoding that is
        safe for one may be unsafe for the next.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [output-encoding]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#output-encoding
