use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpOutputEncoding4:
    standard: @{OwaspScp}
    ruleId: output-encoding-4
    title: Encode untrusted output for the context it lands in
    statement:
        Encode all untrusted data sent back to the client with the encoding
        suited to where it is placed, for example HTML body, attribute,
        JavaScript or URL.
    rationale:
        Every output context treats certain characters specially, and
        unencoded untrusted data in any of them opens the door to cross-site
        scripting.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        def greeting(name):
            return f"<p>Hello, {name}</p>"
        \\\
        ```
    compliant:
        ```python
        \\\
        from html import escape

        def greeting(name):
            return f"<p>Hello, {escape(name)}</p>"
        \\\
        ```
    languages: [any]
    tags: [output-encoding, xss]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#output-encoding
