use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpOutputEncoding4:
    standard: @{OwaspScp}
    ruleId: output-encoding-4
    title: Contextually encode untrusted data sent to the client
    statement:
        Encode all data from untrusted sources that is returned to the
        client, using the encoding that fits the context where it lands,
        such as HTML body, attribute, JavaScript or URL.
    rationale:
        Each output context has its own special characters, and unencoded
        untrusted data in any of them leads to cross-site scripting.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        def greeting(name):
            return f"<p>Hello, {name}</p>"
        \\\
        ```
    compliant:
        ```python
        \\\
        from html import escape

        def greeting(name):
            return f"<p>Hello, {escape(name)}</p>"
        \\\
        ```
    languages: [any]
    tags: [output-encoding, xss]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#output-encoding
