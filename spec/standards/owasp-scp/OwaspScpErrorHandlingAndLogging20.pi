use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpErrorHandlingAndLogging20:
    standard: @{OwaspScp}
    ruleId: error-handling-and-logging-20
    title: Log all system exceptions
    statement:
        Record every system exception.
    rationale:
        Exceptions can reveal attacks that trigger unexpected code paths, as
        well as plain defects.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [logging, error-handling]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#error-handling-and-logging
