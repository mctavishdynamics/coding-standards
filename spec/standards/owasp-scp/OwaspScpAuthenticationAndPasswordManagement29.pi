use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement29:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-29
    title: Disable remember-me for password fields
    statement:
        Turn off remember-me or saved-password features for password fields.
    rationale:
        Stored passwords let anyone with access to the device sign in as the
        user.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, passwords]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
