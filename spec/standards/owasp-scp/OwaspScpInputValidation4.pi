use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpInputValidation4:
    standard: @{OwaspScp}
    ruleId: input-validation-4
    title: Use one centralized input validation routine
    statement:
        Route input validation for the whole application through a single
        shared routine or library.
    rationale:
        A central routine is applied consistently, is easier to review and
        test, and fixes reach every caller at once.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [input-validation, design]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#input-validation
