use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement23:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-23
    title: Give temporary passwords and links a short expiry
    statement:
        Make temporary passwords and reset links expire after a short time.
    rationale:
        A short lifetime limits the window in which an intercepted link or
        password can be used.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, password-reset]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
