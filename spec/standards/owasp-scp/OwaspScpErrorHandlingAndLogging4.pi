use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpErrorHandlingAndLogging4:
    standard: @{OwaspScp}
    ruleId: error-handling-and-logging-4
    title: Handle errors in the application, not server configuration
    statement:
        Handle application errors in the application itself instead of
        relying on server configuration to catch them.
    rationale:
        Server defaults vary between environments and may expose details or
        behave inconsistently.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [error-handling]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#error-handling-and-logging
