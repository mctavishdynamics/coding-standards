use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDataProtection12:
    standard: @{OwaspScp}
    ruleId: data-protection-12
    title: Apply access controls to sensitive data on the server
    statement:
        Apply suitable access controls to sensitive data stored on the
        server, including cached data, temporary files and data meant only
        for specific system users.
    rationale:
        Server-side data is still exposed to other users and processes
        unless access is restricted.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [data-protection, access-control]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#data-protection
