use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpErrorHandlingAndLogging18:
    standard: @{OwaspScp}
    ruleId: error-handling-and-logging-18
    title: Log all apparent tampering events
    statement:
        Record every apparent tampering event, including unexpected changes
        to state data.
    rationale:
        Tampering is a strong sign of a deliberate attack and must be
        visible.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [logging, integrity]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#error-handling-and-logging
