use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement1:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-1
    title: Require authentication for all non-public resources
    statement:
        Require users to authenticate before reaching any page or resource,
        except those deliberately meant to be public.
    rationale:
        Resources that are left open by accident are found and abused;
        making authentication the default closes those gaps.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, secure-defaults]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
