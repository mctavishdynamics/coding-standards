use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpMemoryManagement1:
    standard: @{OwaspScp}
    ruleId: memory-management-1
    title: Apply input and output controls to untrusted data
    statement:
        Use input and output controls for any untrusted data the code
        handles.
    rationale:
        Unchecked untrusted data is the root of most memory corruption
        attacks.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [memory, input-validation]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#memory-management
