use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAccessControl19:
    standard: @{OwaspScp}
    ruleId: access-control-19
    title: Use the referer header only as a supplemental check
    statement:
        Never rely on the referer header as the only authorization check;
        treat it as supplemental at most.
    rationale:
        The referer header is easy to spoof.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [access-control, http]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#access-control
