use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDataProtection11:
    standard: @{OwaspScp}
    ruleId: data-protection-11
    title: Support removal of sensitive data no longer required
    statement:
        Make it possible to delete sensitive data, such as personal or
        financial information, once it is no longer needed.
    rationale:
        Data that is not kept cannot be stolen.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [data-protection, retention]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#data-protection
