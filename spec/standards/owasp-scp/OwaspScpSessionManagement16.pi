use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSessionManagement16:
    standard: @{OwaspScp}
    ruleId: session-management-16
    title: Use HTTPS consistently instead of switching protocols
    statement:
        Within the application, use HTTPS throughout rather than switching
        between HTTP and HTTPS.
    rationale:
        Each switch to plain HTTP exposes cookies and content to
        interception.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [session, tls]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#session-management
