use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAccessControl20:
    standard: @{OwaspScp}
    ruleId: access-control-20
    title: Re-validate authorization during long sessions
    statement:
        If long authenticated sessions are allowed, re-check the user's
        authorization periodically, and if privileges have changed, log the
        user out and make them authenticate again.
    rationale:
        Privileges granted at login may be revoked later, and long sessions
        would otherwise keep the old rights.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [access-control, session]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#access-control
