use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement34:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-34
    title: Use multi-factor authentication for high-value accounts
    statement:
        Accounts that can reach very sensitive data or move money or other value
        must sign in with more than one factor.
    rationale:
        A second factor keeps an account safe even when its password is
        stolen.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, mfa]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
