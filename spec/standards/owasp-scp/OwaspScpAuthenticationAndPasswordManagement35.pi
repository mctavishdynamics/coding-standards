use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement35:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-35
    title: Inspect third-party authentication code for malicious code
    statement:
        If you use third-party code for authentication, review it carefully
        to make sure it contains no malicious code.
    rationale:
        Authentication code sees every credential, which makes it a prime
        target for supply chain attacks.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, supply-chain]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
