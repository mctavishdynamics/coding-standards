use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpErrorHandlingAndLogging22:
    standard: @{OwaspScp}
    ruleId: error-handling-and-logging-22
    title: Log all back-end TLS connection failures
    statement:
        Record every failure of a back-end TLS connection.
    rationale:
        TLS failures may indicate interception attempts or misconfiguration.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [logging, tls]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#error-handling-and-logging
