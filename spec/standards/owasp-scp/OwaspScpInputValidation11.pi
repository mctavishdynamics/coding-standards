use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpInputValidation11:
    standard: @{OwaspScp}
    ruleId: input-validation-11
    title: Validate data from redirects
    statement:
        Validate data that arrives through a redirect just like any other
        input.
    rationale:
        An attacker may send content straight to the redirect target,
        bypassing the logic and validation that ran before the redirect.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [input-validation, redirects]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#input-validation
