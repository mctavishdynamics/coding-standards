use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSessionManagement10:
    standard: @{OwaspScp}
    ruleId: session-management-10
    title: Issue a new session identifier on re-authentication
    statement:
        Generate a fresh session identifier whenever a user re-
        authenticates.
    rationale:
        Rotating the identifier at each authentication step invalidates any
        copy an attacker may hold.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [session, session-fixation]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#session-management
