use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpCommunicationSecurity6:
    standard: @{OwaspScp}
    ruleId: communication-security-6
    title: Use one standard, properly configured TLS implementation
    statement:
        Use a single standard TLS implementation throughout, configured
        appropriately.
    rationale:
        One well-configured implementation avoids weak settings creeping in
        through ad hoc alternatives.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [communication, tls, configuration]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#communication-security
