use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpCryptographicPractices3:
    standard: @{OwaspScp}
    ruleId: cryptographic-practices-3
    title: Make cryptographic modules fail securely
    statement:
        When a cryptographic module fails, stop the operation rather than
        falling back to unprotected data or a weaker mode.
    rationale:
        A silent fallback leaves data unprotected while the application
        behaves as if it were safe.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [cryptography, fail-secure]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#cryptographic-practices
