use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement28:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-28
    title: Enforce password changes required by policy
    statement:
        Require password changes as set by policy or regulation, with the
        interval between resets controlled by administrators. Critical
        systems may need more frequent changes.
    rationale:
        Regular changes limit how long a compromised password stays useful
        where policy demands it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, passwords]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
