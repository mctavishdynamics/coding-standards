use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSessionManagement18:
    standard: @{OwaspScp}
    ruleId: session-management-18
    title: Add per-request tokens for critical operations
    statement:
        For highly sensitive or critical operations, use strong random
        tokens or parameters that change with every request rather than once
        per session.
    rationale:
        A per-request token cannot be replayed, which raises the bar beyond
        a per-session token.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [session, csrf]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#session-management
