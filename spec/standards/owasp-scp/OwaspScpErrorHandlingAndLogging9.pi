use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpErrorHandlingAndLogging9:
    standard: @{OwaspScp}
    ruleId: error-handling-and-logging-9
    title: Include important event data in logs
    statement:
        Make sure log entries record the important event data, such as time,
        source, user, action and outcome.
    rationale:
        Entries without context cannot be used to reconstruct or attribute
        an incident.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [logging]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#error-handling-and-logging
