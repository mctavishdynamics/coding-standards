use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpInputValidation9:
    standard: @{OwaspScp}
    ruleId: input-validation-9
    title: Validate all client-provided data before processing
    statement:
        Validate every value the client supplies before using it, including
        parameters, URLs, HTTP headers, cookies, hidden fields and embedded
        or automated input.
    rationale:
        All of these can be modified by the client, so none of them can be
        trusted just because the application set them.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [input-validation]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#input-validation
