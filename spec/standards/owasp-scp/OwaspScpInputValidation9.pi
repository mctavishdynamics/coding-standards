use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpInputValidation9:
    standard: @{OwaspScp}
    ruleId: input-validation-9
    title: Validate everything the client sends before use
    statement:
        Check every value from the client before processing it, including
        parameters, URLs, HTTP headers, cookies, hidden form fields and
        embedded or automated input.
    rationale:
        The client can tamper with all of these, so none is trustworthy
        merely because the application originally set it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [input-validation]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#input-validation
