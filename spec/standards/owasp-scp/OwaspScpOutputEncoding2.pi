use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpOutputEncoding2:
    standard: @{OwaspScp}
    ruleId: output-encoding-2
    title: Use a standard tested routine for each output encoding
    statement:
        For each kind of outbound encoding, use an established, tested
        library routine rather than writing your own.
    rationale:
        Hand-written encoders tend to miss edge cases, and those gaps become
        injection flaws.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [output-encoding, libraries]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#output-encoding
