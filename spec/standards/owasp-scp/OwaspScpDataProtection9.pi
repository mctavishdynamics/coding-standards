use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDataProtection9:
    standard: @{OwaspScp}
    ruleId: data-protection-9
    title: Disable autocomplete on forms with sensitive data
    statement:
        Turn off autocomplete on forms that are expected to hold sensitive
        information, including login forms.
    rationale:
        Autocomplete stores the values in the browser, where others using
        the device can retrieve them.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [data-protection, client-side, ui]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#data-protection
