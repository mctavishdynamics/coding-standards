use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSystemConfiguration10:
    standard: @{OwaspScp}
    ruleId: system-configuration-10
    title: Disable unnecessary HTTP methods
    statement:
        Turn off HTTP methods the application does not need, such as WebDAV
        extensions. If an extended method that handles files is required,
        protect it with well-vetted authentication.
    rationale:
        Unused methods add attack surface and may allow file upload or
        modification.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [configuration, http, attack-surface]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#system-configuration
