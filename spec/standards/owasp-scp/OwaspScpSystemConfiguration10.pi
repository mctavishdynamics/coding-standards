use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSystemConfiguration10:
    standard: @{OwaspScp}
    ruleId: system-configuration-10
    title: Turn off HTTP methods the application does not use
    statement:
        Disable unneeded HTTP methods, WebDAV extensions among them. Where
        the application truly needs an extended method for file handling,
        put strong, proven authentication in front of it.
    rationale:
        Unused methods widen the attack surface and can permit uploading or
        altering files.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [configuration, http, attack-surface]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#system-configuration
