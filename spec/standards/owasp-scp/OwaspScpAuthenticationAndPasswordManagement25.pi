use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement25:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-25
    title: Notify users when a password reset occurs
    statement:
        Tell users whenever their password has been reset.
    rationale:
        A notification lets the real owner notice and respond to an
        unauthorized reset.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, password-reset, notification]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
