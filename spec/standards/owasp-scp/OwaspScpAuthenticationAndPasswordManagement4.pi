use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement4:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-4
    title: Centralize all authentication controls
    statement:
        Implement authentication in one central place, including any
        libraries that call external authentication services.
    rationale:
        A single implementation is applied consistently and can be reviewed
        and fixed once for the whole application.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, design]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
