use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAccessControl16:
    standard: @{OwaspScp}
    ruleId: access-control-16
    title: Encrypt and integrity-check state data stored on the client
    statement:
        If state data must be kept on the client, encrypt it and check its
        integrity on the server to detect tampering.
    rationale:
        Clients can read and modify anything they hold, so the server must
        be able to tell when state has changed.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [access-control, integrity, cryptography]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#access-control
