use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpInputValidation16:
    standard: @{OwaspScp}
    ruleId: input-validation-16
    title: Add discrete checks where the standard routine falls short
    statement:
        When the central validation routine cannot handle some input, add
        specific checks for it, for example for null bytes, newline
        characters or path alteration sequences like dot-dot-slash.
    rationale:
        Some attacks rely on characters that are only dangerous in
        particular contexts, and a general routine may let them through.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [input-validation, path-traversal]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#input-validation
