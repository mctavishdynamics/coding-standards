use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement18:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-18
    title: Obscure password entry on screen
    statement:
        Hide passwords as the user types them, for example by using a
        password input type on web forms.
    rationale:
        Visible passwords can be read by people or cameras nearby.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, passwords, ui]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
