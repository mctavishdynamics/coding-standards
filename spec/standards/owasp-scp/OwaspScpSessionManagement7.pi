use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSessionManagement7:
    standard: @{OwaspScp}
    ruleId: session-management-7
    title: Set a short session inactivity timeout
    statement:
        Expire idle sessions after a timeout that is as short as the
        business allows, in most cases no more than several hours.
    rationale:
        Idle sessions on shared or lost devices are easy to hijack; a short
        timeout limits that window.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [session, timeout]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#session-management
