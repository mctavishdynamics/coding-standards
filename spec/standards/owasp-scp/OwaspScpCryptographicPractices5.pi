use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpCryptographicPractices5:
    standard: @{OwaspScp}
    ruleId: cryptographic-practices-5
    title: Rely on validated cryptographic modules
    statement:
        Choose cryptographic modules validated against FIPS 140-2, or
        against a comparable standard.
    rationale:
        Validation means independent testers have confirmed that the module
        is implemented correctly and securely.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [cryptography, compliance]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#cryptographic-practices
