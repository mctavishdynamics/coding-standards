use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpCryptographicPractices5:
    standard: @{OwaspScp}
    ruleId: cryptographic-practices-5
    title: Use cryptographic modules compliant with FIPS 140-2
    statement:
        Use cryptographic modules that comply with FIPS 140-2 or an
        equivalent standard.
    rationale:
        Validated modules have been independently tested for correct, secure
        implementation.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [cryptography, compliance]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#cryptographic-practices
