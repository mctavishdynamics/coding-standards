use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDataProtection1:
    standard: @{OwaspScp}
    ruleId: data-protection-1
    title: Apply least privilege to users
    statement:
        Give users only the functions, data and system information they need
        for their tasks.
    rationale:
        Limiting access limits what a compromised or malicious account can
        do.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [data-protection, least-privilege]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#data-protection
