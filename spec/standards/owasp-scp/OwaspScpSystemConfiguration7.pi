use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSystemConfiguration7:
    standard: @{OwaspScp}
    ruleId: system-configuration-7
    title: Remove test code before deployment
    statement:
        Remove test code and any functionality not intended for production
        before deploying.
    rationale:
        Test code often bypasses security controls and is rarely reviewed as
        carefully.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [configuration, deployment]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#system-configuration
