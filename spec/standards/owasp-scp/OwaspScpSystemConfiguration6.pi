use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSystemConfiguration6:
    standard: @{OwaspScp}
    ruleId: system-configuration-6
    title: Remove unnecessary functionality and files
    statement:
        Remove all functionality and files the system does not need.
    rationale:
        Every unused feature or file adds attack surface without adding
        value.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [configuration, attack-surface]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#system-configuration
