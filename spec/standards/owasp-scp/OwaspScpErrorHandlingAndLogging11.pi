use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpErrorHandlingAndLogging11:
    standard: @{OwaspScp}
    ruleId: error-handling-and-logging-11
    title: Restrict log access to authorized individuals
    statement:
        Allow only authorized people to read or manage logs.
    rationale:
        Logs hold sensitive operational detail, and attackers who reach them
        can learn from or erase them.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [logging, access-control]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#error-handling-and-logging
