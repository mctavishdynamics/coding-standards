use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpOutputEncoding1:
    standard: @{OwaspScp}
    ruleId: output-encoding-1
    title: Encode output on a trusted system
    statement:
        Perform all output encoding on the server or another system you
        control, not in client code.
    rationale:
        Encoding done on the client can be skipped or tampered with by an
        attacker.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [output-encoding, trust-boundary]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#output-encoding
