use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpOutputEncoding6:
    standard: @{OwaspScp}
    ruleId: output-encoding-6
    title: Sanitize untrusted data in SQL, XML and LDAP queries
    statement:
        Contextually sanitize any untrusted data that goes into SQL, XML or
        LDAP queries.
    rationale:
        Query languages treat certain characters as syntax, so raw untrusted
        data lets an attacker change the meaning of the query.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [output-encoding, injection]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#output-encoding
