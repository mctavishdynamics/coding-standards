use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpCommunicationSecurity4:
    standard: @{OwaspScp}
    ruleId: communication-security-4
    title: Use TLS for authenticated and sensitive content
    statement:
        Serve all content that requires authentication, and all other
        sensitive information, over TLS.
    rationale:
        Authenticated pages carry session cookies and private data that must
        not travel in clear.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [communication, tls]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#communication-security
