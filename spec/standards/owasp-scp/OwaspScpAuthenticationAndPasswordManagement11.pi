use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement11:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-11
    title: Keep authentication failure messages non-specific
    statement:
        On a failed login, do not reveal which part of the credentials was
        wrong. Use one message, such as invalid username or password, and
        make the responses identical in content and markup.
    rationale:
        Distinct responses let attackers enumerate valid usernames and then
        focus guessing on them.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        def login(username, password):
            user = find_user(username)
            if user is None:
                return "Unknown username"
            if not user.check_password(password):
                return "Wrong password"
            return start_session(user)
        \\\
        ```
    compliant:
        ```python
        \\\
        def login(username, password):
            user = find_user(username)
            if user is None or not user.check_password(password):
                return "Invalid username or password"
            return start_session(user)
        \\\
        ```
    languages: [any]
    tags: [authentication, error-messages, enumeration]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
