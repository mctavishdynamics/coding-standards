use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDataProtection4:
    standard: @{OwaspScp}
    ruleId: data-protection-4
    title: Prevent users from downloading server-side source code
    statement:
        Make sure users cannot download server-side source code.
    rationale:
        Source code exposes logic, flaws and often embedded secrets.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [data-protection, information-disclosure]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#data-protection
