use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSystemConfiguration3:
    standard: @{OwaspScp}
    ruleId: system-configuration-3
    title: Disable directory listing on web servers
    statement:
        Configure the web server so it does not list directory contents.
    rationale:
        A listing exposes files, backups and layout that were never intended
        to be public.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [configuration, information-disclosure]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#system-configuration
