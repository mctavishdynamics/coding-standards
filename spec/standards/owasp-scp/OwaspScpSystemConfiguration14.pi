use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSystemConfiguration14:
    standard: @{OwaspScp}
    ruleId: system-configuration-14
    title: Register system components in an asset management system
    statement:
        Implement an asset management system and record the system
        components and software in it.
    rationale:
        You cannot patch or secure components you do not know you have.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [configuration, asset-management]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#system-configuration
