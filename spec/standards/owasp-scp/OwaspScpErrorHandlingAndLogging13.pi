use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpErrorHandlingAndLogging13:
    standard: @{OwaspScp}
    ruleId: error-handling-and-logging-13
    title: Keep sensitive information out of logs
    statement:
        Do not write sensitive information such as passwords, session
        identifiers or unnecessary system details to logs.
    rationale:
        Logs are copied and kept widely, so secrets in them leak to many
        more people and systems.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [logging, information-disclosure]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#error-handling-and-logging
