use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAccessControl3:
    standard: @{OwaspScp}
    ruleId: access-control-3
    title: Make access controls fail securely
    statement:
        When an access control check errors or cannot decide, deny access.
    rationale:
        An error path that grants access becomes an easy bypass.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [access-control, fail-secure]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#access-control
