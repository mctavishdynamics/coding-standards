use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAccessControl22:
    standard: @{OwaspScp}
    ruleId: access-control-22
    title: Support disabling accounts when authorization ends
    statement:
        Let the application disable accounts and terminate their sessions
        when authorization ends, for example after a change of role or
        employment status.
    rationale:
        Access should stop as soon as the reason for it stops.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [access-control, accounts, session]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#access-control
