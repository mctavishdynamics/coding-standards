use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAccessControl2:
    standard: @{OwaspScp}
    ruleId: access-control-2
    title: Use a single site-wide authorization component
    statement:
        Check access authorization through one component used across the
        whole site, including any libraries that call external authorization
        services.
    rationale:
        Scattered checks drift apart and leave some paths unprotected.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [access-control, design]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#access-control
