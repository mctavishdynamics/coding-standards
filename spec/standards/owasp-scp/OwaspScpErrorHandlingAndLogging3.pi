use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpErrorHandlingAndLogging3:
    standard: @{OwaspScp}
    ruleId: error-handling-and-logging-3
    title: Show generic error messages and custom error pages
    statement:
        Give users generic error messages and serve custom error pages.
    rationale:
        Default and detailed error pages disclose the technology stack and
        internal state.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [error-handling, information-disclosure]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#error-handling-and-logging
