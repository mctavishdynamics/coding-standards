use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAccessControl4:
    standard: @{OwaspScp}
    ruleId: access-control-4
    title: Deny all access when security configuration is unavailable
    statement:
        If the application cannot read its security configuration, refuse
        all access.
    rationale:
        Running without the configuration means running without the rules
        that protect the data.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [access-control, fail-secure, configuration]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#access-control
