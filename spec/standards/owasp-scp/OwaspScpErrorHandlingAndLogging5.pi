use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpErrorHandlingAndLogging5:
    standard: @{OwaspScp}
    ruleId: error-handling-and-logging-5
    title: Free allocated memory when errors occur
    statement:
        Release allocated memory properly on every error path.
    rationale:
        Error paths that leak memory can be triggered repeatedly to exhaust
        resources.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [error-handling, memory]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#error-handling-and-logging
