use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement14:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-14
    title: Send authentication credentials only with HTTP POST
    statement:
        Transmit login credentials only in the body of HTTP POST requests,
        never in the URL.
    rationale:
        Values in a GET URL end up in browser history, server logs, proxies
        and referer headers.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, http]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
