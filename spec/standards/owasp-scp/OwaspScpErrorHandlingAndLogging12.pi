use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpErrorHandlingAndLogging12:
    standard: @{OwaspScp}
    ruleId: error-handling-and-logging-12
    title: Use one central routine for all logging
    statement:
        Send all logging through a single central routine.
    rationale:
        A central routine keeps format, encoding and filtering consistent
        across the application.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [logging, design]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#error-handling-and-logging
