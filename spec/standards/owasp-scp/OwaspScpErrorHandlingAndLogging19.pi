use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpErrorHandlingAndLogging19:
    standard: @{OwaspScp}
    ruleId: error-handling-and-logging-19
    title: Log connections with invalid or expired session tokens
    statement:
        Record attempts to connect with invalid or expired session tokens.
    rationale:
        Such attempts may indicate session guessing or replay of stolen
        tokens.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [logging, session]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#error-handling-and-logging
