use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpErrorHandlingAndLogging19:
    standard: @{OwaspScp}
    ruleId: error-handling-and-logging-19
    title: Log use of invalid or expired session tokens
    statement:
        Write a log entry whenever a request arrives carrying a session
        token that is invalid or has expired.
    rationale:
        Such requests can signal attempts to guess session tokens or replay
        stolen ones.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [logging, session]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#error-handling-and-logging
