use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement15:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-15
    title: Send non-temporary passwords only over encrypted channels
    statement:
        Transmit permanent passwords only over an encrypted connection or as
        encrypted data.
    rationale:
        Passwords sent in clear text can be read by anyone on the network
        path.
    exceptions:
        Temporary passwords sent for email-based resets may be an exception.
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, passwords, encryption]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
