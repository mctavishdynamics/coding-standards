use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement15:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-15
    title: Send permanent passwords only in encrypted form
    statement:
        A password that is not temporary must travel only through an
        encrypted channel, or be encrypted itself before it is sent.
    rationale:
        Cleartext passwords can be captured by anyone able to observe the
        network traffic.
    exceptions:
        A temporary password emailed as part of a reset may be allowed to
        travel this way.
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, passwords, encryption]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
