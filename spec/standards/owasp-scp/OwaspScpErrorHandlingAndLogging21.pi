use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpErrorHandlingAndLogging21:
    standard: @{OwaspScp}
    ruleId: error-handling-and-logging-21
    title: Log all administrative functions
    statement:
        Record every administrative action, including changes to security
        configuration settings.
    rationale:
        Administrative actions have wide impact and must be traceable to who
        did them.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [logging, administration]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#error-handling-and-logging
