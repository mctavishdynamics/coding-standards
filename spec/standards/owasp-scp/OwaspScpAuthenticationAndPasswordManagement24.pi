use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement24:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-24
    title: Force a change of temporary passwords on next use
    statement:
        Require the user to replace a temporary password the next time they
        use it.
    rationale:
        Temporary passwords travel over weaker channels, so they must not
        become long-term credentials.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, passwords]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
