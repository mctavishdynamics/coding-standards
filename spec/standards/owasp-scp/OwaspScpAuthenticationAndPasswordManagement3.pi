use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement3:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-3
    title: Use standard tested authentication services
    statement:
        Rely on established, tested authentication services and libraries
        wherever possible instead of building your own.
    rationale:
        Authentication is easy to get subtly wrong, and mature services have
        already been hardened against common attacks.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, libraries]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
