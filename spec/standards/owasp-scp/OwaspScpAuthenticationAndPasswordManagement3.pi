use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement3:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-3
    title: Use proven authentication services
    statement:
        Build on established authentication services and libraries that have
        been tested, rather than writing your own, whenever you can.
    rationale:
        Subtle mistakes in authentication are common, and mature services
        have already been hardened against well-known attacks.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, libraries]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
