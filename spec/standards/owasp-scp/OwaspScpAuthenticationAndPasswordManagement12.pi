use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement12:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-12
    title: Authenticate connections to sensitive external systems
    statement:
        Require authentication on connections to external systems that
        handle sensitive information or functions.
    rationale:
        An unauthenticated back-end connection can be impersonated or used
        by anyone who reaches it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, integration]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
