use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSessionManagement17:
    standard: @{OwaspScp}
    ruleId: session-management-17
    title: Add per-session tokens for sensitive operations
    statement:
        For sensitive server-side operations such as account management, add
        strong random tokens or parameters tied to the session on top of
        standard session management.
    rationale:
        Such tokens defend against cross-site request forgery, because a
        forged request cannot know the token.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [session, csrf]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#session-management
