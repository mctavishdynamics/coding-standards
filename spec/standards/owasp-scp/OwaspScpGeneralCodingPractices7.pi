use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpGeneralCodingPractices7:
    standard: @{OwaspScp}
    ruleId: general-coding-practices-7
    title: Raise privileges late and drop them early
    statement:
        When the application must run with elevated privileges, raise them
        as late as possible and drop them as soon as possible.
    rationale:
        The shorter the privileged window, the less an attacker can do with
        a flaw in that code.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [general, least-privilege]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#general-coding-practices
