use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpErrorHandlingAndLogging8:
    standard: @{OwaspScp}
    ruleId: error-handling-and-logging-8
    title: Log both successes and failures of security events
    statement:
        Make logging capable of recording both the success and the failure
        of specified security events.
    rationale:
        Investigations need to see what succeeded as well as what was
        attempted.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [logging]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#error-handling-and-logging
