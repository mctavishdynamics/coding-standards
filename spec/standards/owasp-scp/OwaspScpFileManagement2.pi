use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpFileManagement2:
    standard: @{OwaspScp}
    ruleId: file-management-2
    title: Require authentication before file upload
    statement:
        Allow file uploads only from authenticated users.
    rationale:
        Anonymous uploads let anyone place content, including malware, on
        the server.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [files, uploads, authentication]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#file-management
