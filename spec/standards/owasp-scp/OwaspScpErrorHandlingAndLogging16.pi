use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpErrorHandlingAndLogging16:
    standard: @{OwaspScp}
    ruleId: error-handling-and-logging-16
    title: Log all authentication attempts
    statement:
        Record every authentication attempt, and especially every failure.
    rationale:
        Authentication logs reveal brute force and credential stuffing.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [logging, authentication]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#error-handling-and-logging
