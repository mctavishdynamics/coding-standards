use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpFileManagement14:
    standard: @{OwaspScp}
    ruleId: file-management-14
    title: Scan uploaded files for viruses and malware
    statement:
        Scan every user-uploaded file for viruses and malware.
    rationale:
        Uploaded files may later be opened by other users or systems.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [files, uploads, malware]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#file-management
