use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDatabaseSecurity4:
    standard: @{OwaspScp}
    ruleId: database-security-4
    title: Access the database with the lowest possible privilege
    statement:
        Connect to the database with the lowest level of privilege the
        application needs.
    rationale:
        If the application is compromised, a low-privilege account limits
        what the attacker can do to the data.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [database, least-privilege]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#database-security
