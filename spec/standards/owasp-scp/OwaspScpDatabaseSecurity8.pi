use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDatabaseSecurity8:
    standard: @{OwaspScp}
    ruleId: database-security-8
    title: Close database connections as soon as possible
    statement:
        Close each database connection as soon as it is no longer needed.
    rationale:
        Open connections tie up resources and widen the window for misuse.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [database, resources]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#database-security
