use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpCommunicationSecurity7:
    standard: @{OwaspScp}
    ruleId: communication-security-7
    title: Specify character encodings for all connections
    statement:
        Declare the character encoding for every connection.
    rationale:
        Ambiguous encodings let the two ends interpret data differently,
        which can defeat validation and encoding.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [communication, encoding]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#communication-security
