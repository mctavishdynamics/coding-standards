use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpInputValidation3:
    standard: @{OwaspScp}
    ruleId: input-validation-3
    title: Validate all data from untrusted sources
    statement:
        Validate every piece of data that comes from an untrusted source,
        including databases, file streams and other back-end systems, not
        only user forms.
    rationale:
        Attackers can plant malicious data in stores and feeds that the
        application later reads, so indirect sources need the same checks as
        direct input.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [input-validation]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#input-validation
