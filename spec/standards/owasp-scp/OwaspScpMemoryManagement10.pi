use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpMemoryManagement10:
    standard: @{OwaspScp}
    ruleId: memory-management-10
    title: Overwrite sensitive data in memory before exiting
    statement:
        Overwrite sensitive information held in allocated memory at every
        exit point from the function.
    rationale:
        Secrets left in freed memory can be recovered from dumps, swap or
        later allocations.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [memory, secrets]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#memory-management
