use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpCryptographicPractices6:
    standard: @{OwaspScp}
    ruleId: cryptographic-practices-6
    title: Manage keys under a defined policy and process
    statement:
        Set up a documented policy and procedure covering how cryptographic
        keys are generated, stored, rotated and retired, and follow it.
    rationale:
        Careless key handling defeats even the strongest algorithm.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [cryptography, key-management]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#cryptographic-practices
