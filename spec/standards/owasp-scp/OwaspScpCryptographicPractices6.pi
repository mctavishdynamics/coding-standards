use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpCryptographicPractices6:
    standard: @{OwaspScp}
    ruleId: cryptographic-practices-6
    title: Define a policy and process for key management
    statement:
        Establish and follow a policy and process for how cryptographic keys
        are created, stored, rotated and retired.
    rationale:
        Strong algorithms are useless if keys are handled carelessly.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [cryptography, key-management]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#cryptographic-practices
