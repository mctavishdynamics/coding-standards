use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpInputValidation7:
    standard: @{OwaspScp}
    ruleId: input-validation-7
    title: Reject input that fails validation
    statement:
        When input fails any validation check, reject it rather than trying
        to repair or partly accept it.
    rationale:
        Attempting to fix bad input is error prone and can turn a blocked
        attack into a successful one.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [input-validation, fail-secure]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#input-validation
