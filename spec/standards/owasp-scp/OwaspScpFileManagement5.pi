use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpFileManagement5:
    standard: @{OwaspScp}
    ruleId: file-management-5
    title: Keep uploaded files out of the application's web context
    statement:
        Store uploaded files somewhere other than the web context that
        serves the application, such as a content server or the database.
    rationale:
        Files under the web root can be fetched directly and may be run by
        the server.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [files, uploads]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#file-management
