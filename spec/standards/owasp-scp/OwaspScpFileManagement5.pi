use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpFileManagement5:
    standard: @{OwaspScp}
    ruleId: file-management-5
    title: Store uploads outside the application's web context
    statement:
        Do not save uploaded files in the same web context as the
        application. Store them on a content server or in the database.
    rationale:
        Files in the web root can be requested directly and may be executed
        by the server.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [files, uploads]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#file-management
