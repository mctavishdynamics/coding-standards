use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement7:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-7
    title: Secure admin functions as strongly as primary login
    statement:
        Protect administrative and account management functions with
        controls at least as strong as the main authentication mechanism.
    rationale:
        These functions grant wide power, so a weaker path to them
        undermines the whole system.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, administration]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
