use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement32:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-32
    title: Change or disable vendor default credentials
    statement:
        No account should keep the user name or password it shipped with.
        Replace every factory default credential, or switch the account off
        entirely.
    rationale:
        Default credentials are published and are among the first things
        attackers try.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, secure-defaults]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
