use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpErrorHandlingAndLogging15:
    standard: @{OwaspScp}
    ruleId: error-handling-and-logging-15
    title: Log all input validation failures
    statement:
        Record every input validation failure.
    rationale:
        Patterns of failed validation are an early sign of probing and
        attack.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [logging, input-validation]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#error-handling-and-logging
