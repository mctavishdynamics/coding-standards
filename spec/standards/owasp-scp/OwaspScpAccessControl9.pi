use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAccessControl9:
    standard: @{OwaspScp}
    ruleId: access-control-9
    title: Restrict protected functions to authorized users
    statement:
        Allow only authorized users to call protected functions.
    rationale:
        Without a check on the function itself, any user who can reach it
        can run it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [access-control]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#access-control
