use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement31:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-31
    title: Monitor for one password tried across many accounts
    statement:
        Watch for attacks that try the same password against many user
        accounts.
    rationale:
        Spreading guesses over many accounts avoids per-account lockout when
        user IDs can be harvested or guessed.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, monitoring, brute-force]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
