use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement31:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-31
    title: Detect one password tried against many accounts
    statement:
        Monitor for attacks that test a single password across a large
        number of accounts.
    rationale:
        When attackers can collect or predict account names, spreading
        guesses across many accounts lets them avoid lockouts that apply per
        account.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, monitoring, brute-force]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
