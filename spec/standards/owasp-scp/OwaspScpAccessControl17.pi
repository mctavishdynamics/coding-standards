use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAccessControl17:
    standard: @{OwaspScp}
    ruleId: access-control-17
    title: Enforce application logic flows that follow business rules
    statement:
        Make sure users can move through the application only in the order
        and ways the business rules allow.
    rationale:
        Skipping or repeating steps, such as payment, lets attackers abuse
        the business process.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [access-control, business-logic]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#access-control
