use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDatabaseSecurity5:
    standard: @{OwaspScp}
    ruleId: database-security-5
    title: Use secure credentials for database access
    statement:
        Protect database access with strong, securely managed credentials.
    rationale:
        Weak or shared credentials give attackers direct access to the data.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [database, credentials]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#database-security
