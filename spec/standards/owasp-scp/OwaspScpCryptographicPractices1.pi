use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpCryptographicPractices1:
    standard: @{OwaspScp}
    ruleId: cryptographic-practices-1
    title: Implement secret-protecting cryptography on a trusted system
    statement:
        Run every cryptographic function that protects secrets from the
        application's users on the server or another system you control.
    rationale:
        Keys and algorithms shipped to the client are in the hands of the
        very user they are meant to protect against.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [cryptography, trust-boundary]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#cryptographic-practices
