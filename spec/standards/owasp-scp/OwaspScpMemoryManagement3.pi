use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpMemoryManagement3:
    standard: @{OwaspScp}
    ruleId: memory-management-3
    title: Ensure null termination with length-limited copy functions
    statement:
        When using a function that copies a fixed count of bytes, such as
        strncpy, check that the result ends in a null character. It will not
        when the source fills the whole destination.
    rationale:
        Without a terminator, later string reads run beyond the buffer.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        char dst[8];
        strncpy(dst, src, sizeof dst);
        puts(dst);
        \\\
        ```
    compliant:
        ```c
        \\\
        char dst[8];
        strncpy(dst, src, sizeof dst - 1);
        dst[sizeof dst - 1] = '\0';
        puts(dst);
        \\\
        ```
    languages: [any]
    tags: [memory, strings, buffer-overflow]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#memory-management
