use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSystemConfiguration8:
    standard: @{OwaspScp}
    ruleId: system-configuration-8
    title: Keep directory structure out of robots.txt
    statement:
        Put directories that should not be indexed under one isolated parent
        directory and disallow that parent in robots.txt, instead of listing
        each directory.
    rationale:
        Listing private directories in robots.txt tells attackers exactly
        where to look.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [configuration, information-disclosure]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#system-configuration
