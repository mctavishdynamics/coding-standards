use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSystemConfiguration15:
    standard: @{OwaspScp}
    ruleId: system-configuration-15
    title: Keep development environments apart from production
    statement:
        Place development environments on a network separate from
        production, and grant access only to the authorized development and
        test teams.
    rationale:
        Development systems are typically less hardened, and attackers
        exploit them to discover weaknesses shared with production or to
        pivot into it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [configuration, environments]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#system-configuration
