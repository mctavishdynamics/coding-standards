use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSystemConfiguration15:
    standard: @{OwaspScp}
    ruleId: system-configuration-15
    title: Isolate development environments from production
    statement:
        Separate development environments from the production network and
        allow access only to authorized development and test groups.
    rationale:
        Development environments are usually less secure, and attackers use
        them to find shared weaknesses or as a way into production.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [configuration, environments]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#system-configuration
