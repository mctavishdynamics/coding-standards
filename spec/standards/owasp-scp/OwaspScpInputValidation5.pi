use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpInputValidation5:
    standard: @{OwaspScp}
    ruleId: input-validation-5
    title: Specify character sets for all input sources
    statement:
        Declare the character encoding, such as UTF-8, for every input
        source so input can be canonicalized reliably.
    rationale:
        When the encoding is ambiguous, different components may decode the
        same bytes differently, which lets crafted input slip past checks.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [input-validation, encoding, canonicalization]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#input-validation
