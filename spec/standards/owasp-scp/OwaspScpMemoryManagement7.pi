use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpMemoryManagement7:
    standard: @{OwaspScp}
    ruleId: memory-management-7
    title: Use non-executable stacks when available
    statement:
        Enable non-executable stacks wherever the platform supports them.
    rationale:
        A non-executable stack stops injected code on the stack from
        running.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [memory, hardening]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#memory-management
