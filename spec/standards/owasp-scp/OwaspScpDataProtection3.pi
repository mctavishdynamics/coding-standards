use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDataProtection3:
    standard: @{OwaspScp}
    ruleId: data-protection-3
    title: Encrypt highly sensitive stored information
    statement:
        Data whose exposure would be severe, password verifiers for instance,
        must be stored encrypted with proven algorithms, and that holds on the
        server side too.
    rationale:
        Encryption keeps the data safe if storage, backups or the server
        itself are compromised.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [data-protection, encryption]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#data-protection
