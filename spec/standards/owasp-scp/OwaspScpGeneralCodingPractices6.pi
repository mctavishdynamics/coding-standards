use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpGeneralCodingPractices6:
    standard: @{OwaspScp}
    ruleId: general-coding-practices-6
    title: Initialize all variables and data stores explicitly
    statement:
        Give every variable and data store an explicit value when it is
        declared or just before it is first used.
    rationale:
        Uninitialized data can hold leftover values that cause unpredictable
        or insecure behaviour.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [general, initialization]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#general-coding-practices
