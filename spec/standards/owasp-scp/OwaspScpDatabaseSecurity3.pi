use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDatabaseSecurity3:
    standard: @{OwaspScp}
    ruleId: database-security-3
    title: Ensure database variables are strongly typed
    statement:
        Use strongly typed variables for values that go to the database.
    rationale:
        Strong typing rejects values of the wrong kind before they can be
        interpreted as code.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [database, typing]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#database-security
