use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSessionManagement4:
    standard: @{OwaspScp}
    ruleId: session-management-4
    title: Restrict the domain and path of session cookies
    statement:
        Set the domain and path of cookies that hold authenticated session
        identifiers to the narrowest values that fit the site.
    rationale:
        Broad cookie scope sends the session to other hosts or applications
        that may not be trustworthy.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [session, cookies]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#session-management
