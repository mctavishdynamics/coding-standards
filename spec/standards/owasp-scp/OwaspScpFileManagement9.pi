use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpFileManagement9:
    standard: @{OwaspScp}
    ruleId: file-management-9
    title: Reference existing files through an allow list
    statement:
        When referring to existing files, use an allow list of permitted
        file names and types. If a supplied value is not on the list, reject
        it or use a hard-coded default.
    rationale:
        An allow list stops path manipulation from reaching files that were
        never meant to be served.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [files, allow-list, path-traversal]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#file-management
