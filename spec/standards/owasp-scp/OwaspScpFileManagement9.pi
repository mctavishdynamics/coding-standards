use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpFileManagement9:
    standard: @{OwaspScp}
    ruleId: file-management-9
    title: Use an allow list when referring to existing files
    statement:
        Resolve references to existing files against an allow list of
        permitted names and types. When a requested value is not listed,
        reject it or fall back to a fixed default.
    rationale:
        An allow list prevents path manipulation from exposing files that
        were not intended to be served.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [files, allow-list, path-traversal]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#file-management
