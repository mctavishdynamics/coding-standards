use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAccessControl11:
    standard: @{OwaspScp}
    ruleId: access-control-11
    title: Restrict access to services to authorized users
    statement:
        Allow only authorized users to access services the application
        provides or uses.
    rationale:
        Unprotected services expose functions and data outside the
        application's controls.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [access-control]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#access-control
