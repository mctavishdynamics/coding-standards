use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAccessControl21:
    standard: @{OwaspScp}
    ruleId: access-control-21
    title: Audit accounts and disable unused ones
    statement:
        Audit accounts regularly and disable those that are no longer used.
    rationale:
        Dormant accounts are attractive targets because nobody notices when
        they are misused.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [access-control, accounts]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#access-control
