use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpGeneralCodingPractices12:
    standard: @{OwaspScp}
    ruleId: general-coding-practices-12
    title: Update safely over encrypted channels
    statement:
        Deliver application updates over encrypted channels.
    rationale:
        Updates over unprotected channels can be intercepted and replaced
        with malicious code.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [general, updates, supply-chain]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#general-coding-practices
