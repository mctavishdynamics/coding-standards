use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpInputValidation2:
    standard: @{OwaspScp}
    ruleId: input-validation-2
    title: Classify every data source as trusted or untrusted
    statement:
        List every source the application reads data from and mark each one
        as trusted or untrusted.
    rationale:
        You cannot apply validation consistently until you know which inputs
        cross a trust boundary.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [input-validation, threat-modeling]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#input-validation
