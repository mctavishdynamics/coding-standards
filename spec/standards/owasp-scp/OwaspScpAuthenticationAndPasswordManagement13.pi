use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement13:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-13
    title: Keep external service credentials in a secure store
    statement:
        Store credentials for external services encrypted, in a protected
        location on a trusted system. Source code is not a secure place for
        them.
    rationale:
        Credentials in code or plain configuration leak through
        repositories, builds and backups.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        API_KEY = "sk_live_4f9a2c7e1b"
        client = PaymentClient(api_key=API_KEY)
        \\\
        ```
    compliant:
        ```python
        \\\
        import os

        client = PaymentClient(api_key=os.environ["PAYMENT_API_KEY"])
        \\\
        ```
    languages: [any]
    tags: [authentication, secrets]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
