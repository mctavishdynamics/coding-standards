use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement26:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-26
    title: Prevent password reuse
    statement:
        Do not allow users to set a password they have used before.
    rationale:
        Reusing old passwords brings back credentials that may already be
        compromised.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, passwords]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
