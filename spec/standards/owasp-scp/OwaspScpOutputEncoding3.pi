use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpOutputEncoding3:
    standard: @{OwaspScp}
    ruleId: output-encoding-3
    title: Specify character sets for all outputs
    statement:
        Declare the character encoding, such as UTF-8, for every output the
        application produces.
    rationale:
        If the receiver has to guess the encoding, it may interpret bytes in
        a way that defeats output encoding.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [output-encoding, encoding]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#output-encoding
