use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpInputValidation13:
    standard: @{OwaspScp}
    ruleId: input-validation-13
    title: Validate the range of input data
    statement:
        Check that numeric and other ordered values fall within the expected
        range.
    rationale:
        Out-of-range values cause logic errors, overflows and abuse of
        business rules.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [input-validation]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#input-validation
