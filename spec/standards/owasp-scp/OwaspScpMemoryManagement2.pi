use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpMemoryManagement2:
    standard: @{OwaspScp}
    ruleId: memory-management-2
    title: Check that a buffer is as large as specified
    statement:
        Double-check that a buffer really is as large as the size you pass
        for it.
    rationale:
        A size that is larger than the real buffer lets writes run past its
        end.
    exceptions: null
    severity: null
    noncompliant:
        ```c
        \\\
        char name[16];
        read_field(fd, name, 32);
        \\\
        ```
    compliant:
        ```c
        \\\
        char name[16];
        read_field(fd, name, sizeof name);
        \\\
        ```
    languages: [any]
    tags: [memory, buffer-overflow]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#memory-management
