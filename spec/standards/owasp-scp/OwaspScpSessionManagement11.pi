use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSessionManagement11:
    standard: @{OwaspScp}
    ruleId: session-management-11
    title: Disallow concurrent logins with the same user ID
    statement:
        Do not allow the same user ID to be logged in from more than one
        session at a time.
    rationale:
        Blocking concurrent sessions makes it harder for an attacker to use
        stolen credentials unnoticed alongside the real user.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [session, authentication]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#session-management
