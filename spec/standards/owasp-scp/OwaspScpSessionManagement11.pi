use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSessionManagement11:
    standard: @{OwaspScp}
    ruleId: session-management-11
    title: Block simultaneous sessions for one user ID
    statement:
        Allow each user ID only one active logged-in session at any time.
    rationale:
        With concurrent sessions blocked, an attacker using stolen
        credentials cannot quietly work alongside the real user.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [session, authentication]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#session-management
