use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSessionManagement14:
    standard: @{OwaspScp}
    ruleId: session-management-14
    title: Rotate session identifiers periodically
    statement:
        Periodically generate a new session identifier and deactivate the
        old one.
    rationale:
        Rotation limits the usefulness of an identifier that has been
        compromised.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [session]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#session-management
