use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpFileManagement3:
    standard: @{OwaspScp}
    ruleId: file-management-3
    title: Allow only the file types the business needs
    statement:
        Limit uploads to the file types required for business purposes.
    rationale:
        Each accepted type brings its own parsing risks, so fewer types
        means less risk.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [files, uploads, allow-list]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#file-management
