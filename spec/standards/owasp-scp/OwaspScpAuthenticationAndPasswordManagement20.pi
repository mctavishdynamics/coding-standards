use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement20:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-20
    title: Protect password reset as strongly as account creation
    statement:
        Apply the same level of control to password reset and change
        operations as to account creation and login.
    rationale:
        A weak reset flow is an easy back door into accounts with strong
        passwords.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, password-reset]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
