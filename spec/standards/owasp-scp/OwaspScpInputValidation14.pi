use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpInputValidation14:
    standard: @{OwaspScp}
    ruleId: input-validation-14
    title: Validate the length of input data
    statement:
        Check that every input is within its expected minimum and maximum
        length.
    rationale:
        Unbounded input enables buffer overflows, resource exhaustion and
        storage of oversized payloads.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [input-validation]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#input-validation
