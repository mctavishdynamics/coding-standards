use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpFileManagement7:
    standard: @{OwaspScp}
    ruleId: file-management-7
    title: Turn off execution rights on upload directories
    statement:
        Remove execution privileges from directories that receive uploaded
        files.
    rationale:
        Even if a malicious file is uploaded, it then cannot be run.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [files, uploads, permissions]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#file-management
