use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpErrorHandlingAndLogging6:
    standard: @{OwaspScp}
    ruleId: error-handling-and-logging-6
    title: Deny access by default in security error handling
    statement:
        Make error handling in security controls deny access by default.
    rationale:
        An exception in a security check must not turn into a grant of
        access.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [error-handling, fail-secure]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#error-handling-and-logging
