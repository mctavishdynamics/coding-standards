use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDataProtection8:
    standard: @{OwaspScp}
    ruleId: data-protection-8
    title: Keep sensitive information out of GET parameters
    statement:
        Do not put sensitive information in HTTP GET request parameters.
    rationale:
        URLs are stored in browser history, logs and caches and sent in
        referer headers.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [data-protection, http]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#data-protection
