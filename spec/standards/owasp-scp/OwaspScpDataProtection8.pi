use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDataProtection8:
    standard: @{OwaspScp}
    ruleId: data-protection-8
    title: Never send sensitive data in GET parameters
    statement:
        Keep sensitive values out of the query string of HTTP GET requests.
    rationale:
        URLs end up in browser history, server logs and caches, and are
        passed on in referer headers.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [data-protection, http]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#data-protection
