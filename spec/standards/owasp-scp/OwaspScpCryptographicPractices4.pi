use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpCryptographicPractices4:
    standard: @{OwaspScp}
    ruleId: cryptographic-practices-4
    title: Draw unguessable values from an approved random generator
    statement:
        Produce any random number, file name, GUID or string that must
        resist guessing with the random generator approved for your
        cryptographic module.
    rationale:
        Ordinary random generators produce predictable sequences, so their
        output can be guessed.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        import random, string

        def reset_token():
            return "".join(random.choices(string.ascii_letters, k=32))
        \\\
        ```
    compliant:
        ```python
        \\\
        import secrets

        def reset_token():
            return secrets.token_urlsafe(32)
        \\\
        ```
    languages: [any]
    tags: [cryptography, randomness]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#cryptographic-practices
