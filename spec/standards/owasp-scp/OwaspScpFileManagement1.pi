use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpFileManagement1:
    standard: @{OwaspScp}
    ruleId: file-management-1
    title: Never pass user data directly to a dynamic include
    statement:
        Do not hand user-supplied data directly to any function that
        dynamically includes files or code.
    rationale:
        Dynamic includes driven by user data lead to file inclusion attacks
        and code execution.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [files, injection]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#file-management
