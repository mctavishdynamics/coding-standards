use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpInputValidation8:
    standard: @{OwaspScp}
    ruleId: input-validation-8
    title: Validate UTF-8 input after decoding is complete
    statement:
        If the system accepts extended UTF-8 characters, run validation only
        after the UTF-8 decoding has finished.
    rationale:
        Overlong or otherwise unusual encodings can hide dangerous
        characters until they are decoded, so checking before decoding
        misses them.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [input-validation, encoding]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#input-validation
