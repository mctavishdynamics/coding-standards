use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement9:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-9
    title: Hash passwords on a trusted system
    statement:
        Perform password hashing on the server, not in client code.
    rationale:
        If the client hashes the password, the hash itself becomes the
        credential and can be replayed by anyone who obtains it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, passwords, trust-boundary]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
