use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSessionManagement1:
    standard: @{OwaspScp}
    ruleId: session-management-1
    title: Use the server or framework session management
    statement:
        Use the session management built into the server or framework, and
        treat only the session identifiers it issues as valid.
    rationale:
        Built-in session handling is well tested, and accepting identifiers
        from elsewhere invites session fixation and forgery.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [session, libraries]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#session-management
