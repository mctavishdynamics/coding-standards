use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpInputValidation15:
    standard: @{OwaspScp}
    ruleId: input-validation-15
    title: Add extra controls for hazardous input that must be allowed
    statement:
        Where potentially hazardous characters must be accepted, such as
        quotes in names, add further controls like output encoding, secure
        task-specific APIs and accounting for data use across the
        application.
    rationale:
        Accepting dangerous characters removes one layer of defence, so
        other layers must compensate for it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [input-validation, defense-in-depth]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#input-validation
