use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDatabaseSecurity7:
    standard: @{OwaspScp}
    ruleId: database-security-7
    title: Use stored procedures to abstract data access
    statement:
        Access data through stored procedures so permissions on the base
        tables can be removed.
    rationale:
        Restricting the application to procedures limits what a compromised
        connection can read or change.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [database, least-privilege]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#database-security
