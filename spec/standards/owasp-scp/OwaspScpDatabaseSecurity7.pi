use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDatabaseSecurity7:
    standard: @{OwaspScp}
    ruleId: database-security-7
    title: Access data through stored procedures
    statement:
        Route data access through stored procedures, which lets you revoke
        the application's permissions on the underlying tables.
    rationale:
        When the application can only call procedures, a compromised
        connection can read or change much less.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [database, least-privilege]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#database-security
