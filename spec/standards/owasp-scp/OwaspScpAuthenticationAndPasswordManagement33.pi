use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement33:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-33
    title: Re-authenticate users before critical operations
    statement:
        Ask users to authenticate again before performing critical
        operations.
    rationale:
        Re-authentication limits the damage of a hijacked session or an
        unattended device.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, session]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
