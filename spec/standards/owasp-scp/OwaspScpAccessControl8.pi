use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAccessControl8:
    standard: @{OwaspScp}
    ruleId: access-control-8
    title: Restrict protected URLs to authorized users
    statement:
        Allow only authorized users to reach protected URLs.
    rationale:
        Hiding a URL does not protect it; attackers find and request it
        directly.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [access-control]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#access-control
