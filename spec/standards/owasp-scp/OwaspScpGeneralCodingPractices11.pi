use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpGeneralCodingPractices11:
    standard: @{OwaspScp}
    ruleId: general-coding-practices-11
    title: Review secondary applications and third-party code
    statement:
        Audit every library, third-party component and auxiliary application the
        system depends on. Each one must have a real need and must be shown to
        behave securely.
    rationale:
        Every dependency brings its own vulnerabilities into the
        application.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [general, supply-chain]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#general-coding-practices
