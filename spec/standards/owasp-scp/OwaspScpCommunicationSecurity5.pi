use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpCommunicationSecurity5:
    standard: @{OwaspScp}
    ruleId: communication-security-5
    title: Use TLS for sensitive connections to external systems
    statement:
        Use TLS for connections to external systems that involve sensitive
        information or functions.
    rationale:
        Back-end traffic is just as exposed to interception as user traffic.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [communication, tls, integration]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#communication-security
