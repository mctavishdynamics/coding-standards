use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement19:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-19
    title: Disable accounts after repeated failed logins
    statement:
        Disable an account after a set number of failed login attempts, for
        long enough to discourage brute force but not so long that lockout
        becomes a denial of service.
    rationale:
        Without a limit, an attacker can keep guessing until a password is
        found.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, brute-force]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
