use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSessionManagement2:
    standard: @{OwaspScp}
    ruleId: session-management-2
    title: Create session identifiers on a trusted system
    statement:
        Always generate session identifiers on the server, never on the
        client.
    rationale:
        Client-generated identifiers can be chosen or predicted by an
        attacker.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [session, trust-boundary]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#session-management
