use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDataProtection7:
    standard: @{OwaspScp}
    ruleId: data-protection-7
    title: Remove unnecessary application and system documentation
    statement:
        Remove documentation from the deployed system that is not needed
        there.
    rationale:
        Leftover documentation gives attackers useful information about the
        system.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [data-protection, information-disclosure, deployment]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#data-protection
