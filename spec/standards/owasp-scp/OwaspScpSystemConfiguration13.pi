use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSystemConfiguration13:
    standard: @{OwaspScp}
    ruleId: system-configuration-13
    title: Make the security configuration readable for audit
    statement:
        Make it possible to output the application's security configuration
        store in human-readable form.
    rationale:
        Auditors and administrators can only verify settings they can read.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [configuration, auditing]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#system-configuration
