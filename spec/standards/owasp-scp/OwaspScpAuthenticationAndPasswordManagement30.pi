use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement30:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-30
    title: Report the last account use at the next login
    statement:
        At each successful login, show the user when their account was last
        used, whether that attempt succeeded or failed.
    rationale:
        Users can then spot activity they did not perform and report a
        compromise.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, notification]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
