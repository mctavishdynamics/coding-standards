use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDataProtection5:
    standard: @{OwaspScp}
    ruleId: data-protection-5
    title: Keep secrets off the client in clear or weak form
    statement:
        Never place secrets such as passwords or database connection strings on
        the client unless they are properly encrypted. Plain text, simple
        encodings and values compiled into the binary all count as unprotected.
    rationale:
        Anything on the client can be extracted by its user.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [data-protection, secrets, client-side]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#data-protection
