use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpInputValidation6:
    standard: @{OwaspScp}
    ruleId: input-validation-6
    title: Encode input to a common character set before validating
    statement:
        Convert input into a single common character set before running
        validation on it.
    rationale:
        Validation rules only work on a known representation; mixed
        encodings let equivalent malicious strings take forms the rules do
        not recognize.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [input-validation, encoding, canonicalization]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#input-validation
