use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpInputValidation6:
    standard: @{OwaspScp}
    ruleId: input-validation-6
    title: Normalize input to one character set before validation
    statement:
        Convert all input to a single shared character encoding before any
        validation runs.
    rationale:
        Validation rules work only against a known representation. With
        mixed encodings, an attacker can express the same malicious string
        in a form the rules miss.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [input-validation, encoding, canonicalization]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#input-validation
