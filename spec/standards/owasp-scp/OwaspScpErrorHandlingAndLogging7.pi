use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpErrorHandlingAndLogging7:
    standard: @{OwaspScp}
    ruleId: error-handling-and-logging-7
    title: Implement logging controls on a trusted system
    statement:
        Run all logging controls on the server or another system you
        control.
    rationale:
        Logs produced or held on the client can be forged or suppressed.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [logging, trust-boundary]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#error-handling-and-logging
