use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSessionManagement13:
    standard: @{OwaspScp}
    ruleId: session-management-13
    title: Protect server-side session data from other server users
    statement:
        Apply access controls on the server so other users of the same
        server cannot read or change session data.
    rationale:
        On shared hosts, unprotected session storage lets one tenant hijack
        another's sessions.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [session, access-control]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#session-management
