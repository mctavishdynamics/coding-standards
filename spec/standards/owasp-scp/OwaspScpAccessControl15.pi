use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAccessControl15:
    standard: @{OwaspScp}
    ruleId: access-control-15
    title: Keep server and presentation access rules in sync
    statement:
        Make sure the access rules enforced on the server match what the
        user interface shows or hides.
    rationale:
        A mismatch either exposes actions the server does not protect or
        relies on the interface to enforce rules.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [access-control, ui]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#access-control
