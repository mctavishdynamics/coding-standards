use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSystemConfiguration1:
    standard: @{OwaspScp}
    ruleId: system-configuration-1
    title: Run the latest approved versions of system components
    statement:
        Keep servers, frameworks and other system components on the latest
        approved version.
    rationale:
        Old versions carry known vulnerabilities that attackers scan for.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [configuration, patching]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#system-configuration
