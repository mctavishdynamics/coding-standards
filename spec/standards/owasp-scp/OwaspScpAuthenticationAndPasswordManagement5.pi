use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement5:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-5
    title: Separate authentication logic from requested resources
    statement:
        Keep authentication logic apart from the resources it protects, and
        redirect users to and from the central authentication control.
    rationale:
        Mixing authentication into each resource leads to inconsistent
        checks and makes some pages easy to reach without logging in.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, design]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
