use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSystemConfiguration4:
    standard: @{OwaspScp}
    ruleId: system-configuration-4
    title: Run server and service accounts with least privilege
    statement:
        Give the web server, processes and service accounts the fewest
        privileges they need.
    rationale:
        If one of them is compromised, least privilege limits how far the
        attacker can go.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [configuration, least-privilege]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#system-configuration
