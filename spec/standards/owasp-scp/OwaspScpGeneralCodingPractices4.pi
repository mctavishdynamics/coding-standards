use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpGeneralCodingPractices4:
    standard: @{OwaspScp}
    ruleId: general-coding-practices-4
    title: Use locking or synchronization to prevent race conditions
    statement:
        Use locks or another synchronization mechanism to stop simultaneous
        requests from causing race conditions.
    rationale:
        Race conditions let attackers bypass checks, for example by spending
        the same balance twice.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [general, concurrency]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#general-coding-practices
