use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpCryptographicPractices2:
    standard: @{OwaspScp}
    ruleId: cryptographic-practices-2
    title: Protect secrets from unauthorized access
    statement:
        Guard master secrets and keys against unauthorized access.
    rationale:
        Once a key leaks, everything it protects is exposed.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [cryptography, secrets]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#cryptographic-practices
