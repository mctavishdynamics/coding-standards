use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDatabaseSecurity10:
    standard: @{OwaspScp}
    ruleId: database-security-10
    title: Disable database features you do not use
    statement:
        Switch off unneeded database functionality, for example unused
        stored procedures, services and utility packages, and install only
        the components the application requires.
    rationale:
        Each feature left enabled adds to the attack surface.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [database, attack-surface]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#database-security
