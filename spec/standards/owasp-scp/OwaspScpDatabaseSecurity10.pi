use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDatabaseSecurity10:
    standard: @{OwaspScp}
    ruleId: database-security-10
    title: Turn off unnecessary database functionality
    statement:
        Disable database features you do not need, such as unused stored
        procedures, services and utility packages, and install only the
        minimum set of features.
    rationale:
        Every enabled feature is attack surface.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [database, attack-surface]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#database-security
