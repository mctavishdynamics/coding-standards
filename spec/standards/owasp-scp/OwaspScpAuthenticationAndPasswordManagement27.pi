use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement27:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-27
    title: Require a minimum password age before changes
    statement:
        Require a password to be at least one day old before the user can
        change it again.
    rationale:
        Without a minimum age, users can cycle through changes quickly to
        get back to an old password and defeat the reuse rule.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, passwords]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
