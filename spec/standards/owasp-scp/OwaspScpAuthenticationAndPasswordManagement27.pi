use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement27:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-27
    title: Enforce a minimum password age
    statement:
        Do not let users change a password again until it has been in use
        for at least a day.
    rationale:
        Without a waiting period, a user can make several quick changes and
        return to a previous password, defeating the reuse restriction.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, passwords]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
