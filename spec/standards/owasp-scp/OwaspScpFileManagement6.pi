use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpFileManagement6:
    standard: @{OwaspScp}
    ruleId: file-management-6
    title: Block uploads the web server may interpret
    statement:
        Prevent or restrict uploading of any file the web server might
        interpret, such as server-side scripts.
    rationale:
        An uploaded script that the server runs gives the attacker code
        execution.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [files, uploads]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#file-management
