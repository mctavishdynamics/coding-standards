use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement21:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-21
    title: Use reset questions with sufficiently random answers
    statement:
        If password reset questions are used, choose ones whose answers are
        hard to guess and not shared by many people.
    rationale:
        Questions with common or public answers let attackers reset other
        people's passwords.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, password-reset]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
