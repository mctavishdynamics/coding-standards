use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSystemConfiguration12:
    standard: @{OwaspScp}
    ruleId: system-configuration-12
    title: Strip revealing information from HTTP response headers
    statement:
        Remove unnecessary details about the operating system, web server
        version and frameworks from HTTP response headers.
    rationale:
        Version banners help attackers pick exploits that match the system.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [configuration, http, information-disclosure]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#system-configuration
