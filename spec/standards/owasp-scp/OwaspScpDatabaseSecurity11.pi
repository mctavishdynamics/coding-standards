use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDatabaseSecurity11:
    standard: @{OwaspScp}
    ruleId: database-security-11
    title: Remove unnecessary default vendor content
    statement:
        Remove default vendor content, such as sample schemas, that the
        application does not need.
    rationale:
        Sample content is well known and may contain weak accounts or
        exploitable objects.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [database, attack-surface]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#database-security
