use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement6:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-6
    title: Make authentication controls fail securely
    statement:
        When an authentication control errors or cannot decide, deny access
        rather than letting the request through.
    rationale:
        Attackers deliberately trigger errors; a control that fails open
        turns any error into a bypass.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        def is_authenticated(token):
            try:
                return verify_token(token)
            except Exception:
                return True
        \\\
        ```
    compliant:
        ```python
        \\\
        def is_authenticated(token):
            try:
                return verify_token(token)
            except Exception:
                return False
        \\\
        ```
    languages: [any]
    tags: [authentication, fail-secure]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
