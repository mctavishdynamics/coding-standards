use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSessionManagement3:
    standard: @{OwaspScp}
    ruleId: session-management-3
    title: Use well-vetted algorithms for random session identifiers
    statement:
        Generate session identifiers with well-vetted algorithms that make
        them sufficiently random.
    rationale:
        Predictable identifiers let an attacker guess a valid session and
        take it over.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [session, randomness]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#session-management
