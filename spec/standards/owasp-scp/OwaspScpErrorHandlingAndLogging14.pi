use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpErrorHandlingAndLogging14:
    standard: @{OwaspScp}
    ruleId: error-handling-and-logging-14
    title: Provide a mechanism for log analysis
    statement:
        Make sure there is a way to analyse the logs.
    rationale:
        Logs that nobody can search or review do not help detect or
        investigate attacks.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [logging, monitoring]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#error-handling-and-logging
