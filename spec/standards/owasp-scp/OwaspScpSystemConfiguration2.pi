use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSystemConfiguration2:
    standard: @{OwaspScp}
    ruleId: system-configuration-2
    title: Apply all patches for the versions in use
    statement:
        Install every patch issued for the versions of servers, frameworks
        and components in use.
    rationale:
        Unpatched known flaws are among the most common ways systems are
        breached.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [configuration, patching]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#system-configuration
