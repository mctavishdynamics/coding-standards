use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpCommunicationSecurity8:
    standard: @{OwaspScp}
    ruleId: communication-security-8
    title: Keep sensitive parameters out of referer to external sites
    statement:
        When linking to external sites, filter parameters with sensitive
        information out of the HTTP referer, for example with a referrer
        policy.
    rationale:
        The referer header sends the current URL, and any secrets in it, to
        the external site.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [communication, http, information-disclosure]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#communication-security
