use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpGeneralCodingPractices3:
    standard: @{OwaspScp}
    ruleId: general-coding-practices-3
    title: Verify the integrity of code, libraries and configuration
    statement:
        Use checksums or hashes to verify the integrity of interpreted code,
        libraries, executables and configuration files.
    rationale:
        Integrity checks detect tampering and corrupted or substituted
        components.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [general, integrity, supply-chain]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#general-coding-practices
