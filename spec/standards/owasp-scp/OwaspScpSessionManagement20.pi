use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSessionManagement20:
    standard: @{OwaspScp}
    ruleId: session-management-20
    title: Set the HttpOnly attribute on cookies
    statement:
        Mark cookies HttpOnly unless client-side scripts in the application
        specifically need to read or set them.
    rationale:
        HttpOnly stops injected scripts from reading the cookie, which
        limits the damage of cross-site scripting.
    exceptions:
        Cookies that the application's own client-side scripts must read or
        write.
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [session, cookies, xss]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#session-management
