use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAccessControl12:
    standard: @{OwaspScp}
    ruleId: access-control-12
    title: Restrict application data to authorized users
    statement:
        Allow only authorized users to access application data.
    rationale:
        Data is usually what attackers want, so it needs its own access
        checks.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [access-control]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#access-control
