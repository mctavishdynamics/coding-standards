use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement22:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-22
    title: Send email resets only to a pre-registered address
    statement:
        For email-based resets, send only a temporary link or password, and
        only to an address the user registered beforehand.
    rationale:
        Letting the requester choose the address hands the account to
        whoever asks.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, password-reset]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
