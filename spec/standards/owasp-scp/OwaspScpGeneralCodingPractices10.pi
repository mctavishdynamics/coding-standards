use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpGeneralCodingPractices10:
    standard: @{OwaspScp}
    ruleId: general-coding-practices-10
    title: Prevent users from generating or altering code
    statement:
        Do not let users create new code or change existing code.
    rationale:
        User-controlled code runs with the application's privileges.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [general, code-injection]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#general-coding-practices
