use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAccessControl14:
    standard: @{OwaspScp}
    ruleId: access-control-14
    title: Restrict security configuration to authorized users
    statement:
        Allow only authorized users to access security-relevant
        configuration information.
    rationale:
        Security configuration reveals and controls the defences, so
        exposing it helps an attacker disable them.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [access-control, configuration]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#access-control
