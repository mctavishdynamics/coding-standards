use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement8:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-8
    title: Store only strong salted one-way password hashes
    statement:
        If the application keeps a credential store, store only
        cryptographically strong, salted, one-way hashes of passwords, avoid
        weak algorithms such as MD5, and make the store writable only by the
        application.
    rationale:
        A stolen store of plain or weakly hashed passwords exposes every
        account and often other sites where users reuse passwords.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        import hashlib

        def store_password(user, password):
            user.password_hash = hashlib.md5(password.encode()).hexdigest()
        \\\
        ```
    compliant:
        ```python
        \\\
        import bcrypt

        def store_password(user, password):
            user.password_hash = bcrypt.hashpw(password.encode(), bcrypt.gensalt())
        \\\
        ```
    languages: [any]
    tags: [authentication, passwords, cryptography]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
