use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpInputValidation10:
    standard: @{OwaspScp}
    ruleId: input-validation-10
    title: Allow only ASCII in protocol header values
    statement:
        Check that header values in both requests and responses contain only
        ASCII characters.
    rationale:
        Non-ASCII or control characters in headers enable header injection
        and response splitting attacks.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [input-validation, http, headers]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#input-validation
