use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpFileManagement8:
    standard: @{OwaspScp}
    ruleId: file-management-8
    title: Isolate upload directories on UNIX with a mount or chroot
    statement:
        On UNIX, upload safely by mounting the target directory as a
        separate logical drive via its path, or by using a chrooted
        environment.
    rationale:
        Isolation keeps uploaded files from reaching or affecting the rest
        of the file system.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [files, uploads, isolation]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#file-management
