use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDatabaseSecurity9:
    standard: @{OwaspScp}
    ruleId: database-security-9
    title: Remove or change default database admin passwords
    statement:
        Remove or change all default database administrator passwords, using
        strong passwords or passphrases or multi-factor authentication.
    rationale:
        Default passwords are well known and are tried first.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [database, credentials, secure-defaults]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#database-security
