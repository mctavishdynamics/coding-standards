use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement16:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-16
    title: Enforce password complexity required by policy
    statement:
        Apply the password complexity rules set by policy or regulation, so
        credentials can withstand the attacks typical of the deployment
        environment.
    rationale:
        Simple passwords fall quickly to guessing and dictionary attacks.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, passwords]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
