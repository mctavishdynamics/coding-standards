use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpCommunicationSecurity2:
    standard: @{OwaspScp}
    ruleId: communication-security-2
    title: Use valid, correctly configured TLS certificates
    statement:
        Use TLS certificates that are valid, match the domain name, have not
        expired and are installed with any required intermediate
        certificates.
    rationale:
        Broken certificates train users to ignore warnings and can stop
        clients from verifying the server.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [communication, tls, certificates]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#communication-security
