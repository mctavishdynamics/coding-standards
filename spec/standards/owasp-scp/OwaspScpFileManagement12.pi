use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpFileManagement12:
    standard: @{OwaspScp}
    ruleId: file-management-12
    title: Never send absolute file paths to the client
    statement:
        Do not reveal absolute file paths to the client.
    rationale:
        Paths disclose the server's layout and help target path traversal
        and other attacks.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [files, information-disclosure]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#file-management
