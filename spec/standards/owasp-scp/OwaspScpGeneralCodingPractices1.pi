use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpGeneralCodingPractices1:
    standard: @{OwaspScp}
    ruleId: general-coding-practices-1
    title: Prefer proven managed code for common tasks
    statement:
        For routine tasks, use managed code that has been tested and
        approved instead of writing fresh unmanaged code.
    rationale:
        Mature managed code carries fewer memory safety and logic defects
        than newly written code.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [general, libraries]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#general-coding-practices
