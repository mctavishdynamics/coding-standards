use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpGeneralCodingPractices1:
    standard: @{OwaspScp}
    ruleId: general-coding-practices-1
    title: Prefer tested managed code for common tasks
    statement:
        Use tested and approved managed code rather than writing new
        unmanaged code for common tasks.
    rationale:
        Established managed code has fewer memory safety and logic flaws
        than new code.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [general, libraries]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#general-coding-practices
