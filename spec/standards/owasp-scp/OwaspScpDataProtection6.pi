use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDataProtection6:
    standard: @{OwaspScp}
    ruleId: data-protection-6
    title: Remove revealing comments from user-accessible code
    statement:
        Strip comments from production code that users can see if they might
        reveal back-end systems or other sensitive information.
    rationale:
        Comments in client-side code often disclose internal hosts,
        credentials or intentions.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [data-protection, information-disclosure]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#data-protection
