use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement2:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-2
    title: Enforce authentication controls on a trusted system
    statement:
        Run every authentication check on the server or another system you
        control.
    rationale:
        Checks done on the client can be removed or bypassed by the person
        they are meant to verify.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, trust-boundary]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
