use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement2:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-2
    title: Perform authentication checks on a trusted system
    statement:
        Carry out all authentication checks on the server or another system
        under your control.
    rationale:
        A client-side check runs on the user's machine, so the very person
        being verified can strip it out or skip it.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, trust-boundary]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
