use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpErrorHandlingAndLogging17:
    standard: @{OwaspScp}
    ruleId: error-handling-and-logging-17
    title: Log all access control failures
    statement:
        Record every access control failure.
    rationale:
        Denied requests show users or attackers testing for privileges they
        lack.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [logging, access-control]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#error-handling-and-logging
