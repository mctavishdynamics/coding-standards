use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpMemoryManagement9:
    standard: @{OwaspScp}
    ruleId: memory-management-9
    title: Free allocated memory at every exit point
    statement:
        Free allocated memory when a function finishes and on every path out
        of it.
    rationale:
        Missed paths leak memory, which attackers can trigger repeatedly to
        exhaust resources.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [memory, resources]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#memory-management
