use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpInputValidation1:
    standard: @{OwaspScp}
    ruleId: input-validation-1
    title: Validate input on a trusted system
    statement:
        Perform every input validation check on the server or another system
        you control. Client-side checks may improve usability but never
        count as validation.
    rationale:
        Anything that runs on the client can be bypassed or altered by an
        attacker, so only server-side checks can be relied on.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [input-validation, trust-boundary]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#input-validation
