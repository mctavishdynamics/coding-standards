use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpErrorHandlingAndLogging1:
    standard: @{OwaspScp}
    ruleId: error-handling-and-logging-1
    title: Leave sensitive details out of error responses
    statement:
        Error responses must not disclose sensitive information like system
        internals, session identifiers or account data.
    rationale:
        Detailed errors help an attacker map the system and can leak data
        outright.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [error-handling, information-disclosure]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#error-handling-and-logging
