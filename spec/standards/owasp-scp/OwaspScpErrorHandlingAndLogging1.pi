use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpErrorHandlingAndLogging1:
    standard: @{OwaspScp}
    ruleId: error-handling-and-logging-1
    title: Keep sensitive information out of error responses
    statement:
        Do not reveal sensitive information in error responses, such as
        system details, session identifiers or account information.
    rationale:
        Error details help attackers map the system and can leak data
        directly.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [error-handling, information-disclosure]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#error-handling-and-logging
