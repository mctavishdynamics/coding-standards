use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpGeneralCodingPractices8:
    standard: @{OwaspScp}
    ruleId: general-coding-practices-8
    title: Understand the language's numeric representation
    statement:
        Avoid calculation errors by understanding how the language
        represents numbers and handles overflow, precision and conversions.
    rationale:
        Integer overflow, truncation and rounding errors cause security
        flaws in sizes, limits and money.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [general, arithmetic]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#general-coding-practices
