use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpCommunicationSecurity1:
    standard: @{OwaspScp}
    ruleId: communication-security-1
    title: Encrypt sensitive information in transit
    statement:
        Protect every transmission of sensitive data with encryption. Use
        TLS for connections, and add separate encryption for sensitive files
        or for channels that do not use HTTP where that helps.
    rationale:
        Traffic sent without encryption can be read or altered by anyone on
        the route.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [communication, tls, encryption]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#communication-security
