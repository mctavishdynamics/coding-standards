use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpCommunicationSecurity1:
    standard: @{OwaspScp}
    ruleId: communication-security-1
    title: Encrypt the transmission of all sensitive information
    statement:
        Encrypt all sensitive information in transit, using TLS to protect
        the connection and, where useful, separate encryption of sensitive
        files or non-HTTP connections.
    rationale:
        Unencrypted traffic can be read and modified by anyone on the
        network path.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [communication, tls, encryption]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#communication-security
