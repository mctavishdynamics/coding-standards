use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement10:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-10
    title: Validate authentication data only when input is complete
    statement:
        Check authentication data only after the user has supplied all of
        it, particularly in multi-step login flows.
    rationale:
        Validating each piece as it arrives tells an attacker which parts
        are correct and lets them guess the credential piece by piece.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
