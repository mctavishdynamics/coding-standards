use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpFileManagement13:
    standard: @{OwaspScp}
    ruleId: file-management-13
    title: Make application files and resources read-only
    statement:
        Ensure the application's own files and resources are read-only.
    rationale:
        Read-only files cannot be modified by an attacker who gains control
        of the application process.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [files, permissions, integrity]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#file-management
