use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSessionManagement5:
    standard: @{OwaspScp}
    ruleId: session-management-5
    title: Make logout fully terminate the session
    statement:
        Have logout end the associated session or connection completely,
        including on the server.
    rationale:
        If the server keeps the session alive, a captured identifier still
        works after the user believes they have left.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [session, logout]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#session-management
