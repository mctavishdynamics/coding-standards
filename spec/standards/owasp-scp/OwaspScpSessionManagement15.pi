use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSessionManagement15:
    standard: @{OwaspScp}
    ruleId: session-management-15
    title: Issue a new session identifier when moving to HTTPS
    statement:
        Generate a new session identifier if the connection changes from
        HTTP to HTTPS, as can happen during authentication.
    rationale:
        An identifier that was sent over plain HTTP may already have been
        observed.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [session, tls]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#session-management
