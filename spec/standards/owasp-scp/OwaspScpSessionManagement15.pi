use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSessionManagement15:
    standard: @{OwaspScp}
    ruleId: session-management-15
    title: Rotate the session identifier on a switch to HTTPS
    statement:
        Issue a fresh session identifier whenever a connection moves from
        HTTP to HTTPS, which often happens at login.
    rationale:
        Any identifier sent over plain HTTP could already have been
        intercepted.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [session, tls]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#session-management
