use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAccessControl13:
    standard: @{OwaspScp}
    ruleId: access-control-13
    title: Restrict access to access-control attributes and policy
    statement:
        Protect the user and data attributes and policy information that
        access controls rely on.
    rationale:
        If users can change their own roles or the policy, they can grant
        themselves any access.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [access-control]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#access-control
