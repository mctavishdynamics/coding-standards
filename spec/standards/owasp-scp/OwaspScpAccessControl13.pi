use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAccessControl13:
    standard: @{OwaspScp}
    ruleId: access-control-13
    title: Protect the data that access decisions depend on
    statement:
        Guard the attributes of users and data, along with the policy
        definitions, that the access control mechanism consults.
    rationale:
        A user who can edit their own role or the policy itself can award
        themselves any permission.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [access-control]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#access-control
