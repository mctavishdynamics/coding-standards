use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSystemConfiguration5:
    standard: @{OwaspScp}
    ruleId: system-configuration-5
    title: Fail securely when exceptions occur
    statement:
        When an exception occurs, leave the system in a secure state that
        denies access rather than one that is open.
    rationale:
        Exceptions are easy for attackers to provoke, so their handling must
        not weaken security.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [configuration, fail-secure, error-handling]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#system-configuration
