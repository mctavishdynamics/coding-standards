use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSessionManagement12:
    standard: @{OwaspScp}
    ruleId: session-management-12
    title: Never reveal session identifiers in URLs, errors or logs
    statement:
        Keep session identifiers out of URLs, logs and error messages.
        Transport them only in the HTTP cookie header and never as GET
        parameters.
    rationale:
        Identifiers placed in URLs or logs leak through browser history,
        referer headers, shared links and anyone with log access.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [session, information-disclosure]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#session-management
