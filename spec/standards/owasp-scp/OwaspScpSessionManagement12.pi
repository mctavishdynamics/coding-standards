use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSessionManagement12:
    standard: @{OwaspScp}
    ruleId: session-management-12
    title: Keep session identifiers out of URLs, errors and logs
    statement:
        Never expose session identifiers in URLs, error messages or logs.
        Carry them only in the HTTP cookie header, not as GET parameters.
    rationale:
        Identifiers in URLs and logs leak through history, referer headers,
        shared links and log access.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [session, information-disclosure]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#session-management
