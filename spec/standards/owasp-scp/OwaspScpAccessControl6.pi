use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAccessControl6:
    standard: @{OwaspScp}
    ruleId: access-control-6
    title: Segregate privileged logic from other code
    statement:
        Keep privileged logic separate from the rest of the application
        code.
    rationale:
        Separation makes privileged paths easier to review and harder to
        reach by accident.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [access-control, design, least-privilege]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#access-control
