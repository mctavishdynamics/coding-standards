use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement17:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-17
    title: Enforce password length required by policy
    statement:
        Apply the minimum password length set by policy or regulation.
        Longer passwords or multi-word passphrases are better than the
        common eight-character minimum.
    rationale:
        Length is the main factor in how long a password takes to brute
        force.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, passwords]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
