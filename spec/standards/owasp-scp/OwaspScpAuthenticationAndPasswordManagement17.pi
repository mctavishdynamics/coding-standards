use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpAuthenticationAndPasswordManagement17:
    standard: @{OwaspScp}
    ruleId: authentication-and-password-management-17
    title: Enforce the policy's minimum password length
    statement:
        Require passwords at least as long as policy or regulation demands.
        Passphrases of several words or other long passwords are stronger
        than the familiar eight-character minimum.
    rationale:
        How long brute-forcing takes depends mostly on password length.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [authentication, passwords]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#authentication-and-password-management
