use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpDatabaseSecurity12:
    standard: @{OwaspScp}
    ruleId: database-security-12
    title: Disable default database accounts that are not needed
    statement:
        Disable any default accounts that the business does not need.
    rationale:
        Unused default accounts are easy targets that nobody monitors.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [database, accounts, secure-defaults]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#database-security
