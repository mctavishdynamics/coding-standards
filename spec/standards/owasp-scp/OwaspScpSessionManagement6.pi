use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSessionManagement6:
    standard: @{OwaspScp}
    ruleId: session-management-6
    title: Offer logout on every protected page
    statement:
        Make logout available from every page that requires authentication.
    rationale:
        Users can only end a session promptly if the option is always at
        hand.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [session, logout, ui]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#session-management
