use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpSystemConfiguration11:
    standard: @{OwaspScp}
    ruleId: system-configuration-11
    title: Configure all supported HTTP versions consistently
    statement:
        If the web server handles more than one HTTP version, configure them
        in the same way and understand any differences between them.
    rationale:
        Differences between protocol versions can let a request bypass
        controls set up for only one of them.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [configuration, http]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#system-configuration
