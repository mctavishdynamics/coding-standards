use ../lib/CodingRule

from ./OwaspScp import OwaspScp

export coding-rule OwaspScpErrorHandlingAndLogging24:
    standard: @{OwaspScp}
    ruleId: error-handling-and-logging-24
    title: Validate log integrity with a cryptographic hash
    statement:
        Use a cryptographic hash function to check that log entries have not
        been altered.
    rationale:
        Attackers edit logs to hide their tracks; hashes make such edits
        detectable.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [any]
    tags: [logging, integrity]
    source: https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/stable-en/02-checklist/05-checklist#error-handling-and-logging
