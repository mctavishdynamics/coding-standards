use ../lib/CodingRule

from ./EffectiveModernCpp import EffectiveModernCpp

export coding-rule EffectiveModernCppItem28:
    standard: @{EffectiveModernCpp}
    ruleId: item-28
    title: Learn how references to references collapse
    statement:
        When references to references arise in templates, auto, aliases or
        decltype, the result is an lvalue reference if either one is,
        otherwise an rvalue reference.
    rationale:
        Reference collapsing is what makes forwarding references
        and std::forward work.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [rvalue-references-move-semantics-forwarding, templates, move-semantics]
    source: https://www.oreilly.com/library/view/effective-modern-c/9781491908419/
