export coding-standard EffectiveModernCpp:
    title: Effective Modern C++
    publisher: Scott Meyers, O'Reilly
    url: https://www.aristeia.com/books.html
    version: 1st edition, 2014
    license: Copyright Scott Meyers (O'Reilly Media), all rights reserved. Items are paraphrased.
    description:
        Scott Meyers' 42 numbered items on using C++11 and C++14 well, covering type deduction, smart pointers, move semantics, lambdas and the concurrency API.
    rules:
        - @{EffectiveModernCppItem1}
        - @{EffectiveModernCppItem2}
