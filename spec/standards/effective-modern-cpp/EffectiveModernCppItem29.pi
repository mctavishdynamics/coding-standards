use ../lib/CodingRule

from ./EffectiveModernCpp import EffectiveModernCpp

export coding-rule EffectiveModernCppItem29:
    standard: @{EffectiveModernCpp}
    ruleId: item-29
    title: Write generic code that works even without fast moves
    statement:
        In generic code or with unfamiliar types, plan for moves being
        absent, as expensive as copies, or not chosen because they are not
        noexcept.
    rationale:
        Many types have no move support, some containers store elements
        inline, and small strings gain nothing from moves.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [rvalue-references-move-semantics-forwarding, move-semantics, performance]
    source: https://www.oreilly.com/library/view/effective-modern-c/9781491908419/
