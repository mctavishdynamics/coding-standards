use ../lib/CodingRule

from ./EffectiveModernCpp import EffectiveModernCpp

export coding-rule EffectiveModernCppItem38:
    standard: @{EffectiveModernCpp}
    ruleId: item-38
    title: Know how future destructors behave
    statement:
        Be aware that the last future referring to a shared state from a
        non-deferred std::async blocks in its destructor until the task
        finishes, while other futures do not.
    rationale:
        The difference affects when scopes exit and whether work runs to
        completion.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [the-concurrency-api, concurrency]
    source: https://www.oreilly.com/library/view/effective-modern-c/9781491908419/
