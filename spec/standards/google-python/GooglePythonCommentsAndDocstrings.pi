use ../lib/CodingRule

from ./GooglePython import GooglePython

export coding-rule GooglePythonCommentsAndDocstrings:
    standard: @{GooglePython}
    ruleId: 3.8
    title: Use the right style for comments and docstrings
    statement:
        Use the appropriate documentation style for modules, functions,
        methods and classes, and for block and inline comments, as the
        following subsections describe.
    rationale:
        Consistent documentation is easier to read, and docstrings in the
        expected format can be extracted by tools such as pydoc.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [documentation, comments]
    source: https://google.github.io/styleguide/pyguide.html#s3.8-comments-and-docstrings
