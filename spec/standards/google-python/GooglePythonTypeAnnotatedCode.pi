use ../lib/CodingRule

from ./GooglePython import GooglePython

export coding-rule GooglePythonTypeAnnotatedCode:
    standard: @{GooglePython}
    ruleId: 2.21
    title: Annotate public APIs and enable type checking
    statement:
        Turn on type analysis as you touch code. New or changed public
        interfaces should carry annotations, and the build should run the type
        checker on them. Where adoption is blocked, record why in a TODO or a
        linked bug.
    rationale:
        Annotations document interfaces, help tools catch type errors early,
        and make code easier to understand and maintain.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        def parse_price(text, currency):
            return Price(decimal.Decimal(text), currency)
        \\\
        ```
    compliant:
        ```python
        \\\
        def parse_price(text: str, currency: str) -> Price:
            return Price(decimal.Decimal(text), currency)
        \\\
        ```
    languages: [python]
    tags: [typing, annotations]
    source: https://google.github.io/styleguide/pyguide.html#s2.21-type-annotated-code
