use ../lib/CodingRule

from ./GooglePython import GooglePython

export coding-rule GooglePythonFunctionLength:
    standard: @{GooglePython}
    ruleId: 3.18
    title: Prefer small and focused functions
    statement:
        Keep functions small and focused. There is no hard limit, but when a
        function passes about 40 lines, consider whether it can be split
        without harming the program's structure.
    rationale:
        Short functions are easier to read and modify, and long ones invite
        hard-to-find bugs when others extend them.
    exceptions:
        Long functions are sometimes appropriate.
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [functions, complexity]
    source: https://google.github.io/styleguide/pyguide.html#s3.18-function-length
