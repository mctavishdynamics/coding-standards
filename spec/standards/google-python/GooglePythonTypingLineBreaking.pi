use ../lib/CodingRule

from ./GooglePython import GooglePython

export coding-rule GooglePythonTypingLineBreaking:
    standard: @{GooglePython}
    ruleId: 3.19.2
    title: Break annotated signatures between parameters
    statement:
        Normal indentation rules apply. If a signature is too long for one
        line, give every parameter a line of its own ending in a comma, and
        put the closing parenthesis and return annotation on a line aligned
        with def. Wrap between parameters rather than inside one, and keep
        types whole; a long type is better served by an alias, and only if
        that fails should you wrap after the colon with a four-space indent.
    rationale:
        Breaking at parameter boundaries keeps each name next to its type
        and keeps the return type easy to find.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        def schedule(self,
                     task: ScheduledTask | None,
                    ) -> dict[TaskId, ScheduledTask]:
            ...
        \\\
        ```
    compliant:
        ```python
        \\\
        def schedule(
            self,
            task: ScheduledTask | None,
        ) -> dict[TaskId, ScheduledTask]:
            ...
        \\\
        ```
    languages: [python]
    tags: [typing, formatting]
    source: https://google.github.io/styleguide/pyguide.html#s3.19.2-line-breaking
