use ../lib/CodingRule

from ./GooglePython import GooglePython

export coding-rule GooglePythonForwardDeclarations:
    standard: @{GooglePython}
    ruleId: 3.19.3
    title: Use future annotations or strings for forward references
    statement:
        When an annotation names a class that appears later in the module,
        either enable postponed evaluation with the annotations future
        import or put the class name in quotes.
    rationale:
        Without one of these, the name is evaluated before the class exists.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```python
        \\\
        from __future__ import annotations


        class TreeNode:
            def add_child(self, child: TreeNode) -> None:
                ...
        \\\
        ```
    languages: [python]
    tags: [typing, annotations]
    source: https://google.github.io/styleguide/pyguide.html#s3.19.3-forward-declarations
