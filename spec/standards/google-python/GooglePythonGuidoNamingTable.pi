use ../lib/CodingRule

from ./GooglePython import GooglePython

export coding-rule GooglePythonGuidoNamingTable:
    standard: @{GooglePython}
    ruleId: 3.16.4
    title: Use the case style for each kind of name
    statement:
        Use lower_with_under for packages, modules, functions, methods,
        variables and parameters; CapWords for classes and exceptions; and
        CAPS_WITH_UNDER for global and class constants. Prefix internal
        names with a single underscore.
    rationale:
        A consistent case style for each kind of name tells readers what a
        name refers to and whether it is public.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        maxRetries = 3


        class order_queue:
            def AddOrder(self, Order):
                ...
        \\\
        ```
    compliant:
        ```python
        \\\
        MAX_RETRIES = 3


        class OrderQueue:
            def add_order(self, order):
                ...
        \\\
        ```
    languages: [python]
    tags: [naming, conventions]
    source: https://google.github.io/styleguide/pyguide.html#s3.16.4-guidelines-derived-from-guidos-recommendations
