use ../lib/CodingRule

from ./GooglePython import GooglePython

export coding-rule GooglePythonBlankLines:
    standard: @{GooglePython}
    ruleId: 3.5
    title: Separate definitions with the standard blank lines
    statement:
        Separate top-level functions and classes with two blank lines. Use
        one blank line between methods and after a class docstring before
        the first method, and none directly below a def. Within a function
        body, add single blank lines wherever your judgement says they help.
    rationale:
        Consistent spacing shows where definitions begin and end.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        class Cart:
            """A shopping cart."""
            def total(self):

                return sum(self.prices)
        def checkout(cart):
            return cart.total()
        \\\
        ```
    compliant:
        ```python
        \\\
        class Cart:
            """A shopping cart."""

            def total(self):
                return sum(self.prices)


        def checkout(cart):
            return cart.total()
        \\\
        ```
    languages: [python]
    tags: [formatting, blank-lines]
    source: https://google.github.io/styleguide/pyguide.html#s3.5-blank-lines
