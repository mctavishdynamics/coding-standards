export coding-standard GooglePython:
    title: Google Python Style Guide
    publisher: Google
    url: https://google.github.io/styleguide/pyguide.html
    version: null
    license: Creative Commons Attribution 3.0 Unported (CC BY 3.0)
    description:
        Google's style rules for Python code, covering which language
        features to use and how to format, name, document and annotate code.
    rules:
        - @{GooglePythonLint}
        - @{GooglePythonImports}
        - @{GooglePythonImportExemptions}
        - @{GooglePythonPackages}
        - @{GooglePythonExceptions}
        - @{GooglePythonMutableGlobalState}
        - @{GooglePythonNestedFunctionsAndClasses}
        - @{GooglePythonComprehensions}
        - @{GooglePythonDefaultIteratorsAndOperators}
        - @{GooglePythonGenerators}
        - @{GooglePythonLambdaFunctions}
        - @{GooglePythonConditionalExpressions}
        - @{GooglePythonDefaultArgumentValues}
        - @{GooglePythonProperties}
        - @{GooglePythonTrueFalseEvaluations}
        - @{GooglePythonLexicalScoping}
        - @{GooglePythonDecorators}
        - @{GooglePythonThreading}
        - @{GooglePythonPowerFeatures}
        - @{GooglePythonFutureImports}
        - @{GooglePythonTypeAnnotatedCode}
        - @{GooglePythonSemicolons}
        - @{GooglePythonLineLength}
        - @{GooglePythonParentheses}
        - @{GooglePythonIndentation}
        - @{GooglePythonTrailingCommas}
        - @{GooglePythonBlankLines}
        - @{GooglePythonWhitespace}
        - @{GooglePythonShebangLine}
        - @{GooglePythonCommentsAndDocstrings}
        - @{GooglePythonDocstrings}
        - @{GooglePythonModuleDocstrings}
        - @{GooglePythonTestModuleDocstrings}
        - @{GooglePythonFunctionDocstrings}
        - @{GooglePythonOverriddenMethodDocstrings}
        - @{GooglePythonClassDocstrings}
        - @{GooglePythonBlockAndInlineComments}
        - @{GooglePythonCommentPunctuation}
        - @{GooglePythonStrings}
        - @{GooglePythonLogging}
        - @{GooglePythonErrorMessages}
        - @{GooglePythonStatefulResources}
        - @{GooglePythonTodoComments}
        - @{GooglePythonImportsFormatting}
        - @{GooglePythonStatements}
        - @{GooglePythonGettersAndSetters}
        - @{GooglePythonNaming}
        - @{GooglePythonNamesToAvoid}
        - @{GooglePythonNamingConventions}
        - @{GooglePythonNamingExemptions}
        - @{GooglePythonFileNaming}
        - @{GooglePythonGuidoNamingTable}
        - @{GooglePythonMathematicalNotation}
        - @{GooglePythonMain}
        - @{GooglePythonFunctionLength}
        - @{GooglePythonTypingGeneralRules}
        - @{GooglePythonTypingLineBreaking}
        - @{GooglePythonForwardDeclarations}
        - @{GooglePythonTypingDefaultValues}
        - @{GooglePythonNoneType}
        - @{GooglePythonTypeAliases}
        - @{GooglePythonIgnoringTypes}
        - @{GooglePythonTypingVariables}
        - @{GooglePythonTuplesVsLists}
        - @{GooglePythonTypeVariables}
        - @{GooglePythonStringTypes}
        - @{GooglePythonImportsForTyping}
        - @{GooglePythonConditionalImports}
        - @{GooglePythonCircularDependencies}
        - @{GooglePythonGenerics}
