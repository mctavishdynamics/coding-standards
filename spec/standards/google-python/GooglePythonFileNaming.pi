use ../lib/CodingRule

from ./GooglePython import GooglePython

export coding-rule GooglePythonFileNaming:
    standard: @{GooglePython}
    ruleId: 3.16.3
    title: Give Python files a .py extension and no dashes
    statement:
        Python file names must end in .py and must not contain dashes. To
        run a program without the extension, use a symbolic link or a small
        shell wrapper.
    rationale:
        Only files named this way can be imported and unit tested.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [naming, files]
    source: https://google.github.io/styleguide/pyguide.html#s3.16.3-file-naming
