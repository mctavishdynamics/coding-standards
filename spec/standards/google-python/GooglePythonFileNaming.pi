use ../lib/CodingRule

from ./GooglePython import GooglePython

export coding-rule GooglePythonFileNaming:
    standard: @{GooglePython}
    ruleId: 3.16.3
    title: Give Python files a .py extension and no dashes
    statement:
        Every Python file name ends in .py and uses no hyphens. If you want
        to invoke a program without typing .py, provide a symlink or a tiny
        shell script that calls it.
    rationale:
        Only files named this way can be imported and unit tested.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [naming, files]
    source: https://google.github.io/styleguide/pyguide.html#s3.16.3-file-naming
