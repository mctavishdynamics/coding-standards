use ../lib/CodingRule

from ./GooglePython import GooglePython

export coding-rule GooglePythonSemicolons:
    standard: @{GooglePython}
    ruleId: 3.1
    title: Do not use semicolons
    statement:
        Never finish a line with a semicolon, and never use one to join two
        statements on a single line.
    rationale:
        Python does not need them, and several statements on a line are easy
        to overlook.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        total = 0; count = 0;
        \\\
        ```
    compliant:
        ```python
        \\\
        total = 0
        count = 0
        \\\
        ```
    languages: [python]
    tags: [formatting, statements]
    source: https://google.github.io/styleguide/pyguide.html#s3.1-semicolons
