use ../lib/CodingRule

from ./GooglePython import GooglePython

export coding-rule GooglePythonNamingExemptions:
    standard: @{GooglePython}
    ruleId: 3.16.2.1
    title: Match external naming when tightly coupled to other code
    statement:
        When Python code is tightly coupled to an external or non-Python
        codebase, such as a foreign function interface to C++, it may follow
        that codebase's naming convention instead.
    rationale:
        Consistency with the code being wrapped makes the mapping between
        the two easier to follow.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [python]
    tags: [naming, interop]
    source: https://google.github.io/styleguide/pyguide.html#naming-exemptions
