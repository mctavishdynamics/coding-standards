use ../lib/CodingRule

from ./GooglePython import GooglePython

export coding-rule GooglePythonConditionalExpressions:
    standard: @{GooglePython}
    ruleId: 2.11
    title: Use conditional expressions only for simple cases
    statement:
        Conditional expressions are fine for simple cases. Each part, the
        true value, the condition and the else value, must fit on one line.
        Use a full if statement when it gets more complicated.
    rationale:
        A brief ternary saves lines, but once it grows long or spans several
        lines, an ordinary if block reads more easily.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        label = ('premium' if account.subscription.plan.tier_level(
                     account.region) > 2 else
                 'basic')
        \\\
        ```
    compliant:
        ```python
        \\\
        tier = account.subscription.plan.tier_level(account.region)
        label = 'premium' if tier > 2 else 'basic'
        \\\
        ```
    languages: [python]
    tags: [expressions, readability]
    source: https://google.github.io/styleguide/pyguide.html#s2.11-conditional-expressions
