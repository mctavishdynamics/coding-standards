use ../lib/CodingRule

from ./GooglePython import GooglePython

export coding-rule GooglePythonDocstrings:
    standard: @{GooglePython}
    ruleId: 3.8.1
    title: Format docstrings with triple double quotes and a summary line
    statement:
        Enclose docstrings in triple double quotes. The first line is a
        summary no longer than 80 characters and finishes with terminal
        punctuation such as a full stop. Any further text comes after an
        empty line and is indented to match the opening quotes.
    rationale:
        A consistent shape lets tools such as pydoc display docstrings
        properly and lets readers grasp the purpose from the first line.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        def area(radius):
            '''computes the area of a circle given the radius and returns it as a float'''
        \\\
        ```
    compliant:
        ```python
        \\\
        def area(radius):
            """Computes the area of a circle.

            The radius must be non-negative.
            """
        \\\
        ```
    languages: [python]
    tags: [documentation, docstrings]
    source: https://google.github.io/styleguide/pyguide.html#s3.8.1-comments-in-doc-strings
