use ../lib/CodingRule

from ./GooglePython import GooglePython

export coding-rule GooglePythonTuplesVsLists:
    standard: @{GooglePython}
    ruleId: 3.19.9
    title: Type lists as homogeneous and tuples as fixed or repeated
    statement:
        A typed list holds items of a single type. A typed tuple either
        repeats one type, written with an ellipsis, or has a fixed number of
        elements of given types, which is common for function return values.
    rationale:
        Choosing the matching annotation tells the checker and the reader
        the shape of the data.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        def min_max(values: list[int]) -> list[int]:
            return [min(values), max(values)]
        \\\
        ```
    compliant:
        ```python
        \\\
        def min_max(values: list[int]) -> tuple[int, int]:
            return min(values), max(values)
        \\\
        ```
    languages: [python]
    tags: [typing, collections]
    source: https://google.github.io/styleguide/pyguide.html#s3.19.9-tuples-vs-lists
