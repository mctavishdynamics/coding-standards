use ../lib/CodingRule

from ./GooglePython import GooglePython

export coding-rule GooglePythonCommentPunctuation:
    standard: @{GooglePython}
    ruleId: 3.8.6
    title: Write comments with correct punctuation, spelling and grammar
    statement:
        Write comments as readable prose with proper capitalization and
        punctuation, preferring complete sentences. Short end-of-line
        comments may be less formal, but keep the style consistent.
    rationale:
        Well-written comments are easier to read and keep source code clear.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        # retry cuz server flaky sometimes
        \\\
        ```
    compliant:
        ```python
        \\\
        # Retry once, because the server sometimes drops the first request.
        \\\
        ```
    languages: [python]
    tags: [comments, readability]
    source: https://google.github.io/styleguide/pyguide.html#s3.8.6-punctuation-spelling-and-grammar
