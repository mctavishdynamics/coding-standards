use ../lib/CodingRule

from ./GooglePython import GooglePython

export coding-rule GooglePythonMutableGlobalState:
    standard: @{GooglePython}
    ruleId: 2.5
    title: Avoid mutable global state
    statement:
        Avoid mutable module-level or class-level state. Where it is truly
        needed, make it internal with a leading underscore, expose it only
        through public functions or class methods, and explain in a comment
        why it exists. Module-level constants are encouraged and are named
        in all caps with underscores.
    rationale:
        Global state can change behavior when a module is imported, breaks
        encapsulation and makes code harder to test and reason about.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        retry_count = 0


        def fetch(url):
            global retry_count
            retry_count += 1
            return http.get(url)
        \\\
        ```
    compliant:
        ```python
        \\\
        MAX_RETRIES = 3


        def fetch(url, retries=MAX_RETRIES):
            for _ in range(retries):
                response = http.get(url)
                if response.ok:
                    return response
            raise ConnectionError(f'Could not fetch {url}.')
        \\\
        ```
    languages: [python]
    tags: [globals, state]
    source: https://google.github.io/styleguide/pyguide.html#s2.5-global-state
