use ../lib/CodingRule

from ./GooglePython import GooglePython

export coding-rule GooglePythonTodoComments:
    standard: @{GooglePython}
    ruleId: 3.12
    title: Write TODO comments with a linked context
    statement:
        Use TODO comments for temporary or imperfect code. Write TODO in
        capitals, followed by a parenthesized link to the context, ideally a
        bug, then a colon and an explanation. Do not use a person or team as
        the context, and give a specific date or event for future work.
    rationale:
        A consistent format can be searched, and a bug reference carries
        tracked follow-up that a name does not.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        # TODO(jsmith): clean this up later
        \\\
        ```
    compliant:
        ```python
        \\\
        # TODO(bugs.example.com/4821): Remove this fallback once all clients send JSON.
        \\\
        ```
    languages: [python]
    tags: [comments, todo]
    source: https://google.github.io/styleguide/pyguide.html#s3.12-todo-comments
