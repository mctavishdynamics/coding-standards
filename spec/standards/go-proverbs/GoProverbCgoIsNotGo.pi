use ../lib/CodingRule

from ./GoProverbs import GoProverbs

export coding-rule GoProverbCgoIsNotGo:
    standard: @{GoProverbs}
    ruleId: cgo-is-not-go
    title: Do not expect cgo to behave like Go
    statement:
        Treat code that calls into C as foreign code. Reach for cgo only
        when there is no reasonable pure Go route.
    rationale:
        With cgo you lose memory safety, easy cross-compilation, fast builds
        and cheap calls, and the garbage collector and tooling cannot see
        into the C side.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [go]
    tags: [cgo, safety]
    source: https://go-proverbs.github.io/
