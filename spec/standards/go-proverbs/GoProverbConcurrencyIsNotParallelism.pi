use ../lib/CodingRule

from ./GoProverbs import GoProverbs

export coding-rule GoProverbConcurrencyIsNotParallelism:
    standard: @{GoProverbs}
    ruleId: concurrency-is-not-parallelism
    title: Treat concurrency as program structure, not as parallel speed
    statement:
        Use concurrency to structure a program as independently running
        pieces. Do not assume that structure will execute in parallel or
        make it faster.
    rationale:
        Concurrency is about composing independent activities; parallelism
        is about running them at the same moment, which depends on the
        hardware and scheduler.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [go]
    tags: [concurrency, design]
    source: https://go-proverbs.github.io/
