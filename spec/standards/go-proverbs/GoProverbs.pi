use ../lib/CodingStandard

from ./GoProverbBiggerInterfaceWeakerAbstraction import
    GoProverbBiggerInterfaceWeakerAbstraction
from ./GoProverbCgoBuildTags import GoProverbCgoBuildTags
from ./GoProverbCgoIsNotGo import GoProverbCgoIsNotGo
from ./GoProverbChannelsOrchestrateMutexesSerialize import
    GoProverbChannelsOrchestrateMutexesSerialize
from ./GoProverbClearIsBetterThanClever import GoProverbClearIsBetterThanClever
from ./GoProverbConcurrencyIsNotParallelism import
    GoProverbConcurrencyIsNotParallelism
from ./GoProverbDesignNameDocument import GoProverbDesignNameDocument
from ./GoProverbDocumentationIsForUsers import GoProverbDocumentationIsForUsers
from ./GoProverbDontPanic import GoProverbDontPanic
from ./GoProverbEmptyInterfaceSaysNothing import
    GoProverbEmptyInterfaceSaysNothing
from ./GoProverbErrorsAreValues import GoProverbErrorsAreValues
from ./GoProverbGofmt import GoProverbGofmt
from ./GoProverbHandleErrorsGracefully import GoProverbHandleErrorsGracefully
from ./GoProverbLittleCopying import GoProverbLittleCopying
from ./GoProverbMakeTheZeroValueUseful import GoProverbMakeTheZeroValueUseful
from ./GoProverbReflectionIsNeverClear import GoProverbReflectionIsNeverClear
from ./GoProverbShareMemoryByCommunicating import
    GoProverbShareMemoryByCommunicating
from ./GoProverbSyscallBuildTags import GoProverbSyscallBuildTags
from ./GoProverbUnsafeNoGuarantees import GoProverbUnsafeNoGuarantees

export coding-standard GoProverbs:
    title: Go Proverbs
    publisher: Rob Pike
    url: https://go-proverbs.github.io/
    version: Gopherfest SV 2015
    license: MIT License, Copyright (c) 2015 go-proverbs. Items are paraphrased.
    description:
        Pithy design maxims for Go from Rob Pike's 2015 Gopherfest talk,
        covering concurrency, interfaces, errors, dependencies and clarity.
    rules:
        - @{GoProverbShareMemoryByCommunicating}
        - @{GoProverbConcurrencyIsNotParallelism}
        - @{GoProverbChannelsOrchestrateMutexesSerialize}
        - @{GoProverbBiggerInterfaceWeakerAbstraction}
        - @{GoProverbMakeTheZeroValueUseful}
        - @{GoProverbEmptyInterfaceSaysNothing}
        - @{GoProverbGofmt}
        - @{GoProverbLittleCopying}
        - @{GoProverbSyscallBuildTags}
        - @{GoProverbCgoBuildTags}
        - @{GoProverbCgoIsNotGo}
        - @{GoProverbUnsafeNoGuarantees}
        - @{GoProverbClearIsBetterThanClever}
        - @{GoProverbReflectionIsNeverClear}
        - @{GoProverbErrorsAreValues}
        - @{GoProverbHandleErrorsGracefully}
        - @{GoProverbDesignNameDocument}
        - @{GoProverbDocumentationIsForUsers}
        - @{GoProverbDontPanic}
