use ../lib/CodingRule

from ./GoProverbs import GoProverbs

export coding-rule GoProverbDesignNameDocument:
    standard: @{GoProverbs}
    ruleId: design-the-architecture-name-the-components-document-the-details
    title: Design the structure, name the parts well and document the specifics
    statement:
        Work at three levels: plan the overall architecture, give each
        component a good name, and write documentation for the details.
    rationale:
        Good names carry the design, so the documentation can focus on what
        the names and structure cannot say.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [go]
    tags: [design, naming, documentation]
    source: https://go-proverbs.github.io/
