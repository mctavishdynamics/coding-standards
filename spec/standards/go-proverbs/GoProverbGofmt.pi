use ../lib/CodingRule

from ./GoProverbs import GoProverbs

export coding-rule GoProverbGofmt:
    standard: @{GoProverbs}
    ruleId: gofmt-is-everyones-favorite
    title: Format all code with gofmt
    statement:
        Run gofmt on every file and accept its output, even where its
        choices are not the ones you would make.
    rationale:
        A single shared format ends arguments over layout and makes all Go
        code look alike to every reader and tool.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [go]
    tags: [formatting, tooling]
    source: https://go-proverbs.github.io/
