use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC48:
    standard: @{CppCoreGuidelines}
    ruleId: C.48
    title: Put constant member defaults in the class body
    statement:
        If all constructors give a member the same constant value, write that
        value once as a default member initializer.
    rationale:
        It shows the value is common to every constructor and removes
        repetition. One place to edit means no constructor can be forgotten.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Widget {
        public:
            Widget() : visible_(true), width_(0) {}
            explicit Widget(int w) : visible_(true), width_(w) {}
        private:
            bool visible_;
            int width_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Widget {
        public:
            Widget() = default;
            explicit Widget(int w) : width_(w) {}
        private:
            bool visible_ = true;
            int width_ = 0;
        };
        \\\
        ```
    languages: [cpp]
    tags: [constructors, initialization]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-in-class-initializer
