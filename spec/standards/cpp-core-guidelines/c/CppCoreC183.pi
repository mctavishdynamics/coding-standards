use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC183:
    standard: @{CppCoreGuidelines}
    ruleId: C.183
    title: Never reinterpret bytes by writing one union member and reading another
    statement:
        Do not use a union to reinterpret a value by writing one member and
        reading another. Use std::bit_cast or memcpy for that.
    rationale:
        Reading a member other than the one last written is undefined behavior.
        It is also harder to spot than an explicit named conversion.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        union Bits {
            float f;
            std::uint32_t u;
        };

        Bits b;
        b.f = 1.0f;
        std::uint32_t raw = b.u;     // undefined behavior
        \\\
        ```
    compliant:
        ```cpp
        \\\
        float f = 1.0f;
        auto raw = std::bit_cast<std::uint32_t>(f);
        \\\
        ```
    languages: [cpp]
    tags: [unions, undefined-behavior, casts]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ru-pun
