use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC87:
    standard: @{CppCoreGuidelines}
    ruleId: C.87
    title: Be wary of equality operators declared on base classes
    statement:
        Think twice before defining == on a base class, and especially before
        making it virtual.
    rationale:
        Equality across a hierarchy is very hard to get right. Comparing through
        a base can ignore the derived members or call objects of different types
        equal.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Animal {
        public:
            virtual bool operator==(const Animal& o) const { return name_ == o.name_; }
        protected:
            std::string name_;
        };
        class Dog : public Animal { std::string breed_; };   // breed ignored
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Dog {
        public:
            friend bool operator==(const Dog&, const Dog&) = default;
        private:
            std::string name_;
            std::string breed_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [operators, equality, inheritance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-eq-base
