use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC133:
    standard: @{CppCoreGuidelines}
    ruleId: C.133
    title: Keep data out of the protected section
    statement:
        Do not make data members protected. Keep them private, and give derived
        classes protected member functions if they need access.
    rationale:
        Every derived class can modify protected data, so the base cannot state
        or keep its invariant. It also pushes data into bases where it does not
        belong.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Account {
        protected:
            double balance_;      // any subclass can break the invariant
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Account {
        protected:
            void adjust(double delta);   // keeps the invariant
        private:
            double balance_ = 0;
        };
        \\\
        ```
    languages: [cpp]
    tags: [inheritance, encapsulation, access-control]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-protected
