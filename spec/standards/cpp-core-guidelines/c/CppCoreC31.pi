use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC31:
    standard: @{CppCoreGuidelines}
    ruleId: C.31
    title: Free everything an object acquires before the object goes away
    statement:
        A class must release every resource it takes over, such as memory, file
        handles, locks and sockets, by the time its object is destroyed.
    rationale:
        Releasing in the destructor stops leaks. This matters most on error
        paths, where cleanup written at each call site is easily missed.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Log {
        public:
            explicit Log(const char* path) : f_(std::fopen(path, "a")) {}
            // file is never closed
        private:
            std::FILE* f_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Log {
        public:
            explicit Log(const char* path) : f_(std::fopen(path, "a")) {}
            ~Log() { if (f_) std::fclose(f_); }
            Log(const Log&) = delete;
            Log& operator=(const Log&) = delete;
        private:
            std::FILE* f_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [destructors, resource-management, raii]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-dtor-release
