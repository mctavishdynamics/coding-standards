use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC20:
    standard: @{CppCoreGuidelines}
    ruleId: C.20
    title: Let the compiler generate special members whenever it can
    statement:
        Aim for classes that need no hand-written copy, move or destructor. Use
        members that manage their own resources so the compiler-generated
        operations are correct. This is called the rule of zero.
    rationale:
        The generated versions are the least code to write and have the clearest
        meaning.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Names {
        public:
            Names() : data_(new std::string[10]) {}
            ~Names() { delete[] data_; }
            // copy and move must now be written by hand
        private:
            std::string* data_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Names {
        public:
            Names() : data_(10) {}
        private:
            std::vector<std::string> data_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [classes, special-members, rule-of-zero]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-zero
