use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC37:
    standard: @{CppCoreGuidelines}
    ruleId: C.37
    title: Mark destructors noexcept
    statement:
        Destructors should be noexcept. This is the default, so it is enough not
        to add a throwing exception specification.
    rationale:
        Destruction must always succeed. If a destructor throws anyway,
        terminating the program is better than carrying on in an unknown state.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Cache {
        public:
            ~Cache() noexcept(false);
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Cache {
        public:
            ~Cache() noexcept;
        };
        \\\
        ```
    languages: [cpp]
    tags: [destructors, exceptions, noexcept]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-dtor-noexcept
