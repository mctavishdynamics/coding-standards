use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC121:
    standard: @{CppCoreGuidelines}
    ruleId: C.121
    title: Keep interface base classes free of state and function bodies
    statement:
        An interface base class should hold nothing but public pure virtual
        functions and a virtual destructor. It should have no data members.
    rationale:
        A base with no state rarely changes. Derived classes and the code that
        uses them are shielded from implementation changes.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Storage {
        public:
            virtual void write(const Blob& b) = 0;
            virtual ~Storage() = default;
        protected:
            std::string root_;      // data in an interface
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Storage {
        public:
            virtual void write(const Blob& b) = 0;
            virtual ~Storage() = default;
        };
        \\\
        ```
    languages: [cpp]
    tags: [inheritance, interfaces, abstract-classes]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-abstract
