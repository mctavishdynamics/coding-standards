use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC131:
    standard: @{CppCoreGuidelines}
    ruleId: C.131
    title: Skip accessors that only read or write a field
    statement:
        Do not write a getter and setter that just read and assign a member.
        Either make the member public or give the class operations that mean
        something.
    rationale:
        An accessor that does nothing else adds neither meaning nor protection
        compared with a public field.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Point {
        public:
            int x() const { return x_; }
            void set_x(int v) { x_ = v; }
        private:
            int x_ = 0;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        struct Point {
            int x = 0;
            int y = 0;
        };
        \\\
        ```
    languages: [cpp]
    tags: [classes, encapsulation, simplicity]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-get
