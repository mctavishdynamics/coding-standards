use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC131:
    standard: @{CppCoreGuidelines}
    ruleId: C.131
    title: Avoid trivial getters and setters
    statement:
        Do not wrap a data member in a get and set pair that only reads and
        writes it. Make the member public, or give the class real
        operations.
    rationale:
        A trivial accessor adds no meaning or protection over a public
        member.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Point {
        public:
            int x() const { return x_; }
            void set_x(int v) { x_ = v; }
        private:
            int x_ = 0;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        struct Point {
            int x = 0;
            int y = 0;
        };
        \\\
        ```
    languages: [cpp]
    tags: [classes, encapsulation, simplicity]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-get
