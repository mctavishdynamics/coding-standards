use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC47:
    standard: @{CppCoreGuidelines}
    ruleId: C.47
    title: List member initializers in the order the members are declared
    statement:
        In a member initializer list, write the members in the order they are
        declared in the class.
    rationale:
        Initialization always follows declaration order. A list in another order
        misleads readers and may lead to a member being read before it is set.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Range {
            int lo_;
            int hi_;
        public:
            Range(int a, int b) : hi_(b), lo_(hi_ - a) {}   // lo_ reads hi_ too early
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Range {
            int lo_;
            int hi_;
        public:
            Range(int a, int b) : lo_(b - a), hi_(b) {}
        };
        \\\
        ```
    languages: [cpp]
    tags: [constructors, initialization]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-order
