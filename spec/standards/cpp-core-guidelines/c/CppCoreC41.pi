use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC41:
    standard: @{CppCoreGuidelines}
    ruleId: C.41
    title: Leave every object fully set up when its constructor returns
    statement:
        An object must be ready to use as soon as its constructor finishes. Do
        not make callers run a separate init step first.
    rationale:
        Users expect a constructed object to work. A two-phase setup lets them
        use an object that is not ready yet.
    exceptions:
        If a constructor cannot conveniently produce a valid object, provide a
        factory function that returns one instead.
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Socket {
        public:
            Socket() = default;
            bool open(const std::string& host);   // must be called before use
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Socket {
        public:
            explicit Socket(const std::string& host);  // connects or throws
        };
        \\\
        ```
    languages: [cpp]
    tags: [constructors, initialization]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-complete
