use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC147:
    standard: @{CppCoreGuidelines}
    ruleId: C.147
    title: Cast to a reference type when a failed downcast is a bug
    statement:
        Use a dynamic_cast to a reference type when the object has to be of the
        target class and anything else would be a bug.
    rationale:
        The reference form shows that you expect success. If the cast fails it
        throws bad_cast, so there is no result to check.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void save(Document& d) {
            auto* t = dynamic_cast<TextDocument*>(&d);
            t->flush();                 // crashes on null
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void save(Document& d) {
            auto& t = dynamic_cast<TextDocument&>(d);   // throws if wrong
            t.flush();
        }
        \\\
        ```
    languages: [cpp]
    tags: [inheritance, casts, error-handling]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-ref-cast
