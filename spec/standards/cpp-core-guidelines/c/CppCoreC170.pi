use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC170:
    standard: @{CppCoreGuidelines}
    ruleId: C.170
    title: Write one generic lambda instead of wishing for lambda overloads
    statement:
        If a lambda has to accept arguments of several types, write one generic
        lambda with auto parameters.
    rationale:
        A lambda is a variable, so you cannot declare two lambdas with the same
        name as overloads.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        auto describe = [](int v)    { return std::to_string(v); };
        auto describe = [](double v) { return std::to_string(v); };   // error
        \\\
        ```
    compliant:
        ```cpp
        \\\
        auto describe = [](auto v) { return std::to_string(v); };
        \\\
        ```
    languages: [cpp]
    tags: [lambdas, overloading, generic-programming]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ro-lambda
