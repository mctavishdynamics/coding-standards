use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC83:
    standard: @{CppCoreGuidelines}
    ruleId: C.83
    title: Provide a non-throwing swap for value types
    statement:
        Give value-like types a swap function that cannot throw.
    rationale:
        A cheap, safe swap makes it easy to shuffle objects around. It lets copy
        assignment be built on copy construction and supports code with the
        strong exception guarantee.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Grid {
            std::vector<int> cells_;
            int width_;
        };
        // generic std::swap does three moves
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Grid {
        public:
            void swap(Grid& o) noexcept {
                using std::swap;
                swap(cells_, o.cells_);
                swap(width_, o.width_);
            }
            friend void swap(Grid& a, Grid& b) noexcept { a.swap(b); }
        private:
            std::vector<int> cells_;
            int width_ = 0;
        };
        \\\
        ```
    languages: [cpp]
    tags: [swap, noexcept, value-semantics]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-swap
