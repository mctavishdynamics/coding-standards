use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC167:
    standard: @{CppCoreGuidelines}
    ruleId: C.167
    title: Use operator symbols only for their customary operations
    statement:
        If an operation corresponds to the usual meaning of an operator, such as
        equality, ordering or stream output, implement it as that operator
        rather than as a named function.
    rationale:
        Operators with their familiar meaning read naturally. They also let the
        type work with generic code that expects those operators.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Version {
        public:
            bool equals(const Version& o) const;
            void print_to(std::ostream& os) const;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Version {
        public:
            friend bool operator==(const Version&, const Version&);
            friend std::ostream& operator<<(std::ostream& os, const Version& v);
        };
        \\\
        ```
    languages: [cpp]
    tags: [operators, overloading, conventions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ro-overload
