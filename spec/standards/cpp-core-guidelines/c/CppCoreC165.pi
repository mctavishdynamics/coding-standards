use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC165:
    standard: @{CppCoreGuidelines}
    ruleId: C.165
    title: Bring std overloads into scope with a using declaration before calling
    statement:
        In generic code that calls a customization point such as swap, first
        write a using declaration for the standard version. Then call it without
        qualification.
    rationale:
        Argument-dependent lookup then picks a type's own version when one
        exists. Otherwise the standard version is used.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<class T>
        void exchange_items(T& a, T& b) {
            std::swap(a, b);    // ignores a faster swap for T
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<class T>
        void exchange_items(T& a, T& b) {
            using std::swap;
            swap(a, b);         // picks T's own swap if it has one
        }
        \\\
        ```
    languages: [cpp]
    tags: [generic-programming, customization-points, adl]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ro-custom
