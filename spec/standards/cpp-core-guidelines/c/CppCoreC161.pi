use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC161:
    standard: @{CppCoreGuidelines}
    ruleId: C.161
    title: Write operators that treat both operands alike as free functions
    statement:
        Write binary operators that should treat both sides alike, such as ==, +
        and <, as non-member functions, which may be friends.
    rationale:
        With a member operator only the right-hand operand can be converted. So
        a == b might compile while b == a does not, or the two may behave
        differently.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Money {
        public:
            Money(long cents);
            Money operator+(const Money& o) const;
        };
        // m + 5 works, 5 + m does not
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Money {
        public:
            Money(long cents);
            friend Money operator+(const Money& a, const Money& b);
        };
        \\\
        ```
    languages: [cpp]
    tags: [operators, overloading]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ro-symmetric
