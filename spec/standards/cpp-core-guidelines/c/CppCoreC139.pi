use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC139:
    standard: @{CppCoreGuidelines}
    ruleId: C.139
    title: Seal classes with final only when there is a clear reason
    statement:
        Mark a class final only if there is a solid reason why nothing should
        ever derive from it.
    rationale:
        Real reasons to close a hierarchy are uncommon. A final class blocks
        future extension.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Widget final { /* ... */ };       // just in case
        class Panel final : public Widget {};
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Widget { /* ... */ };
        class Panel : public Widget {};
        \\\
        ```
    languages: [cpp]
    tags: [inheritance, final, extensibility]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-final
