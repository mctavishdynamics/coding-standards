use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC127:
    standard: @{CppCoreGuidelines}
    ruleId: C.127
    title: Ensure a polymorphic class cannot be destroyed incorrectly through its base
    statement:
        A class that declares any virtual function must also get the right kind
        of destructor. Make it virtual and public when callers may destroy
        derived objects through the base, and make it protected and non-virtual
        when they may not.
    rationale:
        Polymorphic objects are mostly handled through base pointers and often
        deleted that way. Without a virtual destructor, such a delete is
        undefined behavior.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Task {
        public:
            virtual void run() = 0;
        };

        std::unique_ptr<Task> t = std::make_unique<Download>();  // UB on destruction
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Task {
        public:
            virtual void run() = 0;
            virtual ~Task() = default;
        };
        \\\
        ```
    languages: [cpp]
    tags: [inheritance, destructors, virtual-functions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-dtor
