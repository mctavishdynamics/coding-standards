use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC51:
    standard: @{CppCoreGuidelines}
    ruleId: C.51
    title: Share common constructor work by delegating to another constructor
    statement:
        When constructors share setup work, let them delegate to a single
        constructor that does it.
    rationale:
        One shared constructor avoids duplicated code. It also prevents the
        constructors from drifting apart by accident.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Date {
        public:
            Date(int y, int m, int d) : y_(y), m_(m), d_(d) { validate(); }
            Date(int y, int m) : y_(y), m_(m), d_(1) { validate(); }
        private:
            int y_, m_, d_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Date {
        public:
            Date(int y, int m, int d) : y_(y), m_(m), d_(d) { validate(); }
            Date(int y, int m) : Date(y, m, 1) {}
        private:
            int y_, m_, d_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [constructors, duplication]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-delegating
