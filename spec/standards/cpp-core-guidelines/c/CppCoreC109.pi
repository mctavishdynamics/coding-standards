use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC109:
    standard: @{CppCoreGuidelines}
    ruleId: C.109
    title: Give pointer-like handles dereference and arrow operators
    statement:
        Provide operator* and operator-> for a resource handle that acts like a
        pointer.
    rationale:
        Anything that looks like a pointer is expected to support these two
        operations.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<class T>
        class Ref {
        public:
            T& get() const { return *p_; }
        private:
            T* p_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<class T>
        class Ref {
        public:
            T& operator*() const { return *p_; }
            T* operator->() const { return p_; }
        private:
            T* p_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [resource-management, operators, pointers]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rcon-ptr
