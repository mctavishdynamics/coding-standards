use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC2:
    standard: @{CppCoreGuidelines}
    ruleId: C.2
    title: Choose class when members keep an invariant and struct when they vary freely
    statement:
        Pick the keyword by whether there is an invariant. Use class when the
        type must keep its members consistent with each other. Use struct when
        any member can hold any value regardless of the rest.
    rationale:
        This simple convention tells a reader at once whether the type guards
        some relationship between its members.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        struct Date {
            Date(int y, int m, int d);   // validates the date
            int day() const;
        private:
            int y_, m_, d_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        struct Pair {        // any values are fine
            std::string key;
            int count;
        };

        class Date {         // day must fit the month
        public:
            Date(int y, int m, int d);
            int day() const;
        private:
            int y_, m_, d_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [classes, invariants, conventions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-struct
