use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC46:
    standard: @{CppCoreGuidelines}
    ruleId: C.46
    title: Make one-parameter constructors explicit unless conversion is wanted
    statement:
        Declare a constructor explicit when it can be called with one argument,
        unless an implicit conversion is the whole point.
    rationale:
        A non-explicit constructor converts values silently, so a call can pick
        an overload or create an object nobody intended.
    exceptions:
        Leave explicit off when an implicit conversion really is wanted, as with
        a complex number type built from a double.
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Timeout {
        public:
            Timeout(int ms);
        };

        void wait(Timeout t);
        wait(42);   // compiles, intent unclear
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Timeout {
        public:
            explicit Timeout(int ms);
        };

        wait(Timeout(42));
        \\\
        ```
    languages: [cpp]
    tags: [constructors, conversions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-explicit
