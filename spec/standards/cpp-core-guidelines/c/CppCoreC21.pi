use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC21:
    standard: @{CppCoreGuidelines}
    ruleId: C.21
    title: Treat copy, move and destruction as one set to declare together
    statement:
        The copy constructor, copy assignment, move constructor, move assignment
        and destructor form a group. Once you declare one, even as =default or
        =delete, declare the whole group.
    rationale:
        Declaring any one of them changes which others the compiler provides. A
        class can lose its moves and fall back to copies, or become move-only
        without anyone noticing.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Handle {
        public:
            ~Handle() { close(fd_); }
            // copy is still generated and closes fd twice; no move
        private:
            int fd_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Handle {
        public:
            ~Handle() { if (fd_ >= 0) close(fd_); }
            Handle(const Handle&) = delete;
            Handle& operator=(const Handle&) = delete;
            Handle(Handle&& o) noexcept : fd_(std::exchange(o.fd_, -1)) {}
            Handle& operator=(Handle&& o) noexcept;
        private:
            int fd_ = -1;
        };
        \\\
        ```
    languages: [cpp]
    tags: [classes, special-members, rule-of-five]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-five
