use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC103:
    standard: @{CppCoreGuidelines}
    ruleId: C.103
    title: Let a container be built from a brace list of elements
    statement:
        Add a constructor taking std::initializer_list so a container can be
        filled from a braced list of values.
    rationale:
        Users expect to list the starting elements directly, the same way they
        do with the standard containers.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        IntBag b;
        b.push_back(1);
        b.push_back(2);
        b.push_back(3);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class IntBag {
        public:
            IntBag(std::initializer_list<int> il) : elems_(il) {}
        private:
            std::vector<int> elems_;
        };

        IntBag b = {1, 2, 3};
        \\\
        ```
    languages: [cpp]
    tags: [containers, initialization]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rcon-init
