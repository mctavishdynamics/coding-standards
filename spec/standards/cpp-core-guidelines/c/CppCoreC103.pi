use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC103:
    standard: @{CppCoreGuidelines}
    ruleId: C.103
    title: Give a container an initializer-list constructor
    statement:
        Let users initialize a container from a list of values by providing
        a constructor that takes std::initializer_list.
    rationale:
        People expect to write a container's initial elements directly, as
        they do for standard containers.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        IntBag b;
        b.push_back(1);
        b.push_back(2);
        b.push_back(3);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class IntBag {
        public:
            IntBag(std::initializer_list<int> il) : elems_(il) {}
        private:
            std::vector<int> elems_;
        };

        IntBag b = {1, 2, 3};
        \\\
        ```
    languages: [cpp]
    tags: [containers, initialization]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rcon-init
