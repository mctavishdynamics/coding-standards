use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC101:
    standard: @{CppCoreGuidelines}
    ruleId: C.101
    title: Make copying a container copy its elements
    statement:
        Copying a container should copy its elements, and == should compare the
        elements, just as std::vector does.
    rationale:
        A container with regular value semantics is easy to reason about and
        matches what users already expect.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Bag {
            int* elems_;
            std::size_t n_;
            // default copy shares elems_ between bags
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Bag {
        public:
            Bag(const Bag& o) : elems_(o.elems_) {}   // copies elements
            friend bool operator==(const Bag&, const Bag&) = default;
        private:
            std::vector<int> elems_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [containers, value-semantics]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rcon-val
