use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC135:
    standard: @{CppCoreGuidelines}
    ruleId: C.135
    title: Inherit from several bases to offer several unrelated interfaces
    statement:
        If a class must support several distinct interfaces, inherit from one
        base per interface. Do not merge them into one large base class.
    rationale:
        Not every class needs every interface, and not every user needs every
        operation. Small separate interfaces keep dependencies small.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Device {
        public:
            virtual void read() = 0;
            virtual void write() = 0;
            virtual void seek() = 0;   // not all devices can seek
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Readable { public: virtual void read() = 0;  virtual ~Readable() = default; };
        class Writable { public: virtual void write() = 0; virtual ~Writable() = default; };

        class Pipe : public Readable, public Writable {
            void read() override;
            void write() override;
        };
        \\\
        ```
    languages: [cpp]
    tags: [inheritance, interfaces, multiple-inheritance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-mi-interface
