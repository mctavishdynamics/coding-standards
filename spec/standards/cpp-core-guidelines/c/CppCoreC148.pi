use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC148:
    standard: @{CppCoreGuidelines}
    ruleId: C.148
    title: Cast to a pointer type when a failed downcast is an expected case
    statement:
        Use a dynamic_cast to a pointer type when the object may or may not be
        of the target class and both outcomes are normal. Then test the pointer.
    rationale:
        A failed pointer cast just gives nullptr, which fits naturally into an
        if statement that chooses a branch.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        try {
            auto& img = dynamic_cast<Image&>(item);
            show_preview(img);
        } catch (const std::bad_cast&) {
            show_icon(item);
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        if (auto* img = dynamic_cast<Image*>(&item))
            show_preview(*img);
        else
            show_icon(item);
        \\\
        ```
    languages: [cpp]
    tags: [inheritance, casts]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-ptr-cast
