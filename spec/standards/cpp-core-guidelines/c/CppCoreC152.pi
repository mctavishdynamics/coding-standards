use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC152:
    standard: @{CppCoreGuidelines}
    ruleId: C.152
    title: Keep arrays of derived objects away from base class pointers
    statement:
        Never let a pointer to an array of derived objects be used as a pointer
        to the base class.
    rationale:
        Pointer arithmetic through the base pointer steps by the size of the
        base class. It lands inside objects instead of on them, which corrupts
        memory.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Circle circles[8];
        Shape* shapes = circles;
        shapes[1].draw();          // wrong address
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::array<Circle, 8> circles;
        for (Circle& c : circles)
            c.draw();
        \\\
        ```
    languages: [cpp]
    tags: [inheritance, arrays, memory]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-array
