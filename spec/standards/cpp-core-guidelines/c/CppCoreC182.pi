use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC182:
    standard: @{CppCoreGuidelines}
    ruleId: C.182
    title: Use an unnamed union inside a tagged wrapper class
    statement:
        When you write your own tagged union, place an anonymous union inside a
        class together with the tag. Keep both private and expose them only
        through member functions.
    rationale:
        With tag and storage in one class, every access can be checked. The
        anonymous union also saves you naming the union member and forwarding
        through it.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        union Payload { int code; std::string* text; };

        struct Message {
            enum Kind { code, text } kind;
            Payload payload;     // separate, named union; users touch it directly
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Message {
        public:
            int code() const { if (kind_ != Kind::code) throw BadAccess(); return code_; }
        private:
            enum class Kind { code, text } kind_;
            union {
                int code_;
                std::string* text_;
            };
        };
        \\\
        ```
    languages: [cpp]
    tags: [unions, type-safety]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ru-anonymous
