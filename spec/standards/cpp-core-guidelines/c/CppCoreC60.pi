use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC60:
    standard: @{CppCoreGuidelines}
    ruleId: C.60
    title: Declare copy assignment non-virtual with a const reference and a self reference result
    statement:
        Copy assignment should be a non-virtual member. It takes const T& and
        returns T& referring to *this.
    rationale:
        This is the usual signature and it is both simple and efficient. If
        rvalues need special handling, add a second overload taking T&&.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Text {
        public:
            virtual const Text& operator=(Text other);
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Text {
        public:
            Text& operator=(const Text& other);
        };
        \\\
        ```
    languages: [cpp]
    tags: [copy, assignment, special-members]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-copy-assignment
