use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC64:
    standard: @{CppCoreGuidelines}
    ruleId: C.64
    title: Leave a moved-from object usable
    statement:
        A move must give the target the source's former value. The source must
        stay valid, so that it can still be destroyed or assigned to. An empty
        or default state is usually the best choice.
    rationale:
        Callers expect that y holds the old value of x after y = std::move(x),
        and that x can still be used safely.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Buffer::Buffer(Buffer&& o) noexcept : data_(o.data_), size_(o.size_) {
            // o still points at data_; both will delete it
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        Buffer::Buffer(Buffer&& o) noexcept
            : data_(std::exchange(o.data_, nullptr)),
              size_(std::exchange(o.size_, 0)) {}
        \\\
        ```
    languages: [cpp]
    tags: [move, value-semantics]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-move-semantic
