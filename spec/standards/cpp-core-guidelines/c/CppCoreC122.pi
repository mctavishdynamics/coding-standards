use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC122:
    standard: @{CppCoreGuidelines}
    ruleId: C.122
    title: Hide implementations fully behind abstract base classes
    statement:
        Place an abstract class at any boundary where users must be fully
        isolated from the implementation, such as a library or ABI boundary.
    rationale:
        Callers see only the abstract interface. The implementation can then
        change without users having to recompile or relink.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // public header exposes implementation details
        class Codec {
        public:
            Bytes encode(const Frame& f);
        private:
            ZlibState state_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // public header
        class Codec {
        public:
            virtual Bytes encode(const Frame& f) = 0;
            virtual ~Codec() = default;
        };
        std::unique_ptr<Codec> make_codec();
        \\\
        ```
    languages: [cpp]
    tags: [inheritance, interfaces, abi]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-separation
