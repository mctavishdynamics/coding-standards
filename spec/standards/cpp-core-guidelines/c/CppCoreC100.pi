use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC100:
    standard: @{CppCoreGuidelines}
    ruleId: C.100
    title: Model custom containers on the standard ones
    statement:
        When you write your own container, give it the same shape as the
        standard ones: begin and end, size, member types such as value_type, and
        proper iterators.
    rationale:
        C++ programmers already know how standard containers behave. A look-
        alike works at once with range-for and the standard algorithms.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class IntBag {
        public:
            int count() const;
            int get(int index) const;
            void put(int value);
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class IntBag {
        public:
            using value_type = int;
            using iterator = int*;
            iterator begin();
            iterator end();
            std::size_t size() const;
            void push_back(int value);
        };
        \\\
        ```
    languages: [cpp]
    tags: [containers, stl, conventions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rcon-stl
