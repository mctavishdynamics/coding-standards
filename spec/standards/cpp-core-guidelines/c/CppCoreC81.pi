use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC81:
    standard: @{CppCoreGuidelines}
    ruleId: C.81
    title: Remove unwanted generated operations with delete
    statement:
        Declare an operation =delete when the compiler would otherwise generate
        it and the type must not have it.
    rationale:
        Some types, such as a unique owner of a resource, must never be copied.
        Deleting the operation documents this and makes misuse fail to compile.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Mutex {
        private:
            Mutex(const Mutex&);              // old trick, undefined
            Mutex& operator=(const Mutex&);
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Mutex {
        public:
            Mutex(const Mutex&) = delete;
            Mutex& operator=(const Mutex&) = delete;
        };
        \\\
        ```
    languages: [cpp]
    tags: [special-members, deleted-functions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-delete
