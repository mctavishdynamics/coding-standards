use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC166:
    standard: @{CppCoreGuidelines}
    ruleId: C.166
    title: Leave unary address-of alone outside proxy and smart pointer types
    statement:
        Give unary & a custom meaning only inside a carefully designed family of
        smart pointer or reference proxy types.
    rationale:
        Much code assumes that & gives the address of an object. Changing its
        meaning breaks that code in subtle ways.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Widget {
        public:
            int operator&() const { return id_; }   // & no longer gives an address
        private:
            int id_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Widget {
        public:
            int id() const { return id_; }
        private:
            int id_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [operators, overloading]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ro-address-of
