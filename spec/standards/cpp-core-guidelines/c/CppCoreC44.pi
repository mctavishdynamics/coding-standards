use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC44:
    standard: @{CppCoreGuidelines}
    ruleId: C.44
    title: Keep default constructors cheap and free of failures
    statement:
        Default constructors should be simple. Avoid allocation or any other
        step that could fail.
    rationale:
        If the default state can always be reached, error handling is easier.
        Move operations can also leave objects in that state cheaply.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Pool {
        public:
            Pool() : blocks_(new Block[1024]) {}   // may throw bad_alloc
        private:
            Block* blocks_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Pool {
        public:
            Pool() noexcept = default;   // empty pool, allocates on first use
        private:
            std::vector<Block> blocks_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [constructors, exceptions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-default00
