use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC163:
    standard: @{CppCoreGuidelines}
    ruleId: C.163
    title: Keep one overloaded name for one kind of operation
    statement:
        Use one name only for functions that do the same kind of thing.
        Different operations should get different names.
    rationale:
        If one name stands for unrelated actions, readers misjudge what a call
        does. Templates that depend on the meaning of the name can then silently
        do the wrong thing.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void open(const std::string& path);   // opens a file
        void open(int port);                  // starts a server
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void open_file(const std::string& path);
        void listen(int port);
        \\\
        ```
    languages: [cpp]
    tags: [overloading, naming]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ro-equivalent-2
