use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC13:
    standard: @{CppCoreGuidelines}
    ruleId: C.13
    title: Order data members so each is ready before members that depend on it
    statement:
        Declare a member before any other member whose construction or
        destruction uses it.
    rationale:
        Members are always built in declaration order and torn down in reverse,
        regardless of how the initializer list is written. The wrong order means
        one member uses another that is not yet alive or already gone.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Session {
            Reader reader_;          // built from conn_, which is not ready yet
            Connection conn_;
        public:
            Session() : conn_(), reader_(conn_) {}
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Session {
            Connection conn_;
            Reader reader_;
        public:
            Session() : conn_(), reader_(conn_) {}
        };
        \\\
        ```
    languages: [cpp]
    tags: [classes, initialization, lifetime]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-lifetime
