use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC67:
    standard: @{CppCoreGuidelines}
    ruleId: C.67
    title: Hide copy and move in polymorphic classes to prevent slicing
    statement:
        In a class with virtual functions, delete copy and move if the class
        holds no data, or make them protected if it does.
    rationale:
        Copying a polymorphic object by value slices it. Only the base part
        survives, so the copy no longer behaves like the original.
    exceptions:
        Exception types are a special case, since they must be both polymorphic
        and copy constructible.
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Handler {
        public:
            virtual ~Handler() = default;
            virtual void handle(const Request& r) {}
        };

        void dispatch(Handler h, const Request& r);   // slices the real handler
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Handler {
        public:
            Handler() = default;
            Handler(const Handler&) = delete;
            Handler& operator=(const Handler&) = delete;
            virtual ~Handler() = default;
            virtual void handle(const Request& r) = 0;
        };

        void dispatch(Handler& h, const Request& r);
        \\\
        ```
    languages: [cpp]
    tags: [copy, inheritance, slicing]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-copy-virtual
