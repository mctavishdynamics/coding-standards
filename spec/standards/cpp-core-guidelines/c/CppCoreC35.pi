use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC35:
    standard: @{CppCoreGuidelines}
    ruleId: C.35
    title: Make base class destruction either public virtual or protected non-virtual
    statement:
        Give a base class a destructor that is either public and virtual or
        protected and non-virtual. Choose public virtual if callers may delete
        derived objects through a base pointer.
    rationale:
        Deleting through a base pointer with a non-virtual destructor is
        undefined behavior. A protected destructor turns such a delete into a
        compile error.
    exceptions:
        A protected virtual destructor is conceivable when a derived object must
        destroy a different object through a base pointer. Such a design is rare
        in practice.
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Plugin {
        public:
            ~Plugin();             // public and non-virtual
            virtual void run() = 0;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Plugin {
        public:
            virtual ~Plugin() = default;
            virtual void run() = 0;
        };
        \\\
        ```
    languages: [cpp]
    tags: [destructors, inheritance, undefined-behavior]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-dtor-virtual
