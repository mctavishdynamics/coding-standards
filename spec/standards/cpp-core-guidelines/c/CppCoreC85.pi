use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC85:
    standard: @{CppCoreGuidelines}
    ruleId: C.85
    title: Mark swap noexcept
    statement:
        Mark every swap function noexcept.
    rationale:
        A swap is not allowed to fail. If one throws, ending the program is the
        right response.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void swap(Grid& a, Grid& b);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void swap(Grid& a, Grid& b) noexcept;
        \\\
        ```
    languages: [cpp]
    tags: [swap, noexcept]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-swap-noexcept
