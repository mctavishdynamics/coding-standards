use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC33:
    standard: @{CppCoreGuidelines}
    ruleId: C.33
    title: Give a class that owns a pointer a destructor that frees it
    statement:
        A class that owns an object through a raw pointer needs a destructor
        that deletes it. A better fix is to replace that pointer with a smart
        pointer.
    rationale:
        The generated destructor does not delete anything a raw pointer refers
        to. Without a user destructor, the owned object leaks when its owner
        dies.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Parser {
        public:
            Parser() : lexer_(new Lexer) {}
        private:
            Lexer* lexer_;    // leaked
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Parser {
        public:
            Parser() : lexer_(std::make_unique<Lexer>()) {}
        private:
            std::unique_ptr<Lexer> lexer_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [destructors, ownership, memory]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-dtor-ptr2
