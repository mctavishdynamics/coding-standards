use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC180:
    standard: @{CppCoreGuidelines}
    ruleId: C.180
    title: Overlay alternatives in a union when memory is tight
    statement:
        Use a union to save memory when several objects are never alive at the
        same moment and can share the same storage.
    rationale:
        Alternatives that never coexist can reuse the same bytes. The union only
        needs room for its largest member.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        struct Token {
            int kind;
            long integer;        // only one of these is ever used
            double real;
            char op;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        struct Token {
            int kind;
            union {
                long integer;
                double real;
                char op;
            };
        };
        \\\
        ```
    languages: [cpp]
    tags: [unions, memory]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ru-union
