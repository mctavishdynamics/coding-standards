use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC104:
    standard: @{CppCoreGuidelines}
    ruleId: C.104
    title: Make a default-built container start out empty
    statement:
        A container's default constructor should produce an empty container.
    rationale:
        This keeps the type regular and consistent with the standard containers.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Ring {
        public:
            explicit Ring(std::size_t capacity);   // no way to make an empty ring
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Ring {
        public:
            Ring() = default;                        // empty
            explicit Ring(std::size_t capacity);
        };
        \\\
        ```
    languages: [cpp]
    tags: [containers, constructors]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rcon-empty
