use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC10:
    standard: @{CppCoreGuidelines}
    ruleId: C.10
    title: Reach for a plain value type before an inheritance tree
    statement:
        Start with a concrete, self-contained type. Build a class hierarchy only
        when there is a real need for run-time polymorphism.
    rationale:
        A concrete type is easier to design, use and reason about. It also
        avoids virtual calls and heap allocation, so it is smaller and faster.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Shape { public: virtual double area() const = 0; virtual ~Shape() = default; };
        class Square : public Shape { /* only shape ever used */ };

        std::vector<std::unique_ptr<Shape>> squares;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Square {
        public:
            explicit Square(double side) : side_(side) {}
            double area() const { return side_ * side_; }
        private:
            double side_;
        };

        std::vector<Square> squares;
        \\\
        ```
    languages: [cpp]
    tags: [classes, design, performance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-concrete
