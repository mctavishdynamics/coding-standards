use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC140:
    standard: @{CppCoreGuidelines}
    ruleId: C.140
    title: Keep default argument values identical across an override chain
    statement:
        An overriding function must use the same default arguments as the
        virtual function it overrides, or none that differ.
    rationale:
        The default is picked from the static type at the call site, not from
        the function that actually runs. Different defaults therefore give
        results that depend on how the call was written.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        struct Base {
            virtual void scale(double factor = 1.0);
        };
        struct Derived : Base {
            void scale(double factor = 2.0) override;
        };

        Base* p = new Derived;
        p->scale();   // Derived::scale called with 1.0
        \\\
        ```
    compliant:
        ```cpp
        \\\
        struct Base {
            virtual void scale(double factor = 1.0);
        };
        struct Derived : Base {
            void scale(double factor) override;   // no differing default
        };
        \\\
        ```
    languages: [cpp]
    tags: [inheritance, virtual-functions, default-arguments]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-virtual-default-arg
