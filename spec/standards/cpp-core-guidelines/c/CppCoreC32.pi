use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC32:
    standard: @{CppCoreGuidelines}
    ruleId: C.32
    title: Decide and document ownership for every raw pointer or reference member
    statement:
        For every pointer or reference member, decide whether the class owns
        what it refers to. State the answer in the type, for instance with
        unique_ptr or GSL owner, rather than leaving it to guesswork.
    rationale:
        Unclear ownership is common in old code. It causes both leaks and
        objects deleted twice.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Node {
            Node* next_;   // owned or not? nobody can tell
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Node {
            std::unique_ptr<Node> next_;   // owns the next node
            Node* parent_ = nullptr;       // non-owning
        };
        \\\
        ```
    languages: [cpp]
    tags: [destructors, ownership, pointers]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-dtor-ptr
