use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC168:
    standard: @{CppCoreGuidelines}
    ruleId: C.168
    title: Put operator overloads in the same namespace as their operand types
    statement:
        Declare an overloaded operator in the namespace of the type it works on.
    rationale:
        Lookup on the operand type then finds it from any namespace. There is
        also just one definition instead of several that compete.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        namespace money { struct Amount { long cents; }; }

        bool operator==(money::Amount a, money::Amount b);   // global namespace
        \\\
        ```
    compliant:
        ```cpp
        \\\
        namespace money {
            struct Amount { long cents; };
            bool operator==(Amount a, Amount b);
        }
        \\\
        ```
    languages: [cpp]
    tags: [operators, namespaces, adl]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ro-namespace
