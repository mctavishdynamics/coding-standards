use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC153:
    standard: @{CppCoreGuidelines}
    ruleId: C.153
    title: Dispatch through virtual calls instead of casting
    statement:
        Instead of checking an object's type with casts and branching on it,
        call a virtual function that each class implements.
    rationale:
        The virtual call always reaches the most derived version and stays safe
        as the hierarchy grows. A chain of casts may stop at an intermediate
        class and break when new classes are added.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        double area(const Shape& s) {
            if (auto* c = dynamic_cast<const Circle*>(&s)) return c->r * c->r * 3.14159;
            if (auto* q = dynamic_cast<const Square*>(&s)) return q->side * q->side;
            return 0;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Shape {
        public:
            virtual double area() const = 0;
            virtual ~Shape() = default;
        };

        double total = shape.area();
        \\\
        ```
    languages: [cpp]
    tags: [inheritance, virtual-functions, casts]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-use-virtual
