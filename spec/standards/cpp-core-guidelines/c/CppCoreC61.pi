use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC61:
    standard: @{CppCoreGuidelines}
    ruleId: C.61
    title: Make copying produce an equal and independent object
    statement:
        A copy must give two objects that compare equal and has no other effect.
        With value semantics they are independent, and with pointer semantics
        they refer to the same thing.
    rationale:
        All code assumes that copying gives an equal object. A copy that does
        something else breaks that code.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Matrix& Matrix::operator=(const Matrix& o) {
            rows_ = o.rows_;
            cols_ = o.cols_;
            // forgot to copy elements
            return *this;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        Matrix& Matrix::operator=(const Matrix& o) {
            rows_ = o.rows_;
            cols_ = o.cols_;
            elems_ = o.elems_;
            return *this;
        }
        \\\
        ```
    languages: [cpp]
    tags: [copy, value-semantics]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-copy-semantic
