use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC151:
    standard: @{CppCoreGuidelines}
    ruleId: C.151
    title: Create shared objects with make_shared
    statement:
        Create objects for a shared_ptr with std::make_shared rather than a bare
        new. R.22 covers this in more depth.
    rationale:
        make_shared is shorter and usually places the object and its control
        block in one allocation instead of two.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::shared_ptr<Session> s(new Session(user));
        \\\
        ```
    compliant:
        ```cpp
        \\\
        auto s = std::make_shared<Session>(user);
        \\\
        ```
    languages: [cpp]
    tags: [memory, smart-pointers, performance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-make_shared
