use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC30:
    standard: @{CppCoreGuidelines}
    ruleId: C.30
    title: Write a destructor only when cleanup needs code
    statement:
        Only provide a destructor when the class has cleanup work that its
        members do not already perform. In every other case the default is
        enough.
    rationale:
        When members clean up after themselves, the generated destructor is
        correct. Writing one anyway also stops the compiler from generating move
        operations.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Report {
        public:
            ~Report() { lines_.clear(); }   // the vector does this anyway
        private:
            std::vector<std::string> lines_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Report {
        private:
            std::vector<std::string> lines_;
        };

        class TempDir {
        public:
            ~TempDir() { std::filesystem::remove_all(path_); }
        private:
            std::filesystem::path path_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [destructors, special-members]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-dtor
