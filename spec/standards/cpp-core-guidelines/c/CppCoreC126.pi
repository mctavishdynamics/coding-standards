use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC126:
    standard: @{CppCoreGuidelines}
    ruleId: C.126
    title: Let an abstract class rely on the compiler-generated constructor
    statement:
        An abstract class usually has no data, so it rarely needs a user-written
        constructor.
    rationale:
        With no members to set up, a constructor would have nothing to do.
    exceptions:
        A base constructor may still be useful when it performs work, such as
        registering each new object somewhere. In rare designs the abstract
        class also holds data shared by all derived types, and then it needs a
        constructor.
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Reader {
        public:
            Reader() {}          // does nothing
            virtual std::string read() = 0;
            virtual ~Reader() = default;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Reader {
        public:
            virtual std::string read() = 0;
            virtual ~Reader() = default;
        };
        \\\
        ```
    languages: [cpp]
    tags: [inheritance, abstract-classes, constructors]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-abstract-ctor
