use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC40:
    standard: @{CppCoreGuidelines}
    ruleId: C.40
    title: Give a class with an invariant a constructor that sets it up
    statement:
        If a class has an invariant, write a constructor that makes it true.
    rationale:
        That is the purpose of a constructor. Every object then begins life in a
        valid state.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Percentage {
        public:
            void set(int v) { value_ = v; }   // no constructor checks the range
        private:
            int value_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Percentage {
        public:
            explicit Percentage(int v) : value_(v) {
                if (v < 0 || v > 100) throw std::out_of_range("percentage");
            }
        private:
            int value_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [constructors, invariants]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-ctor
