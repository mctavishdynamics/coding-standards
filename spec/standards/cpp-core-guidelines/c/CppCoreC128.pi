use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC128:
    standard: @{CppCoreGuidelines}
    ruleId: C.128
    title: Choose one of virtual, override or final for each virtual function
    statement:
        Write exactly one of virtual, override or final on a virtual function.
        Use virtual to introduce a new one, override when replacing one that may
        be replaced again, and final for the last replacement.
    rationale:
        Each keyword carries one meaning. The compiler can then reject a
        supposed override whose signature does not match. Writing two or three
        keywords adds clutter and can contradict itself.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Button : public Widget {
        public:
            virtual void draw() const override;   // redundant
            void resize(int w);                   // meant to override resize(long)?
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Button : public Widget {
        public:
            void draw() const override;
            void resize(long w) override;
        };
        \\\
        ```
    languages: [cpp]
    tags: [inheritance, virtual-functions, override]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-override
