use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC162:
    standard: @{CppCoreGuidelines}
    ruleId: C.162
    title: Give the same name to operations that do essentially the same thing
    statement:
        When one logical operation works on different types, use a single
        overloaded name for it. Do not invent a different name per type.
    rationale:
        Type-specific names put type information into the name, confuse readers
        and make generic code hard to write.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void print_int(int v);
        void print_double(double v);
        void print_string(const std::string& v);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void print(int v);
        void print(double v);
        void print(const std::string& v);
        \\\
        ```
    languages: [cpp]
    tags: [overloading, naming, generic-programming]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ro-equivalent
