use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC136:
    standard: @{CppCoreGuidelines}
    ruleId: C.136
    title: Inherit from several bases to mix in separate implementation pieces
    statement:
        Multiple inheritance may be used to compose a class out of mixins, each
        adding its own state and operations.
    rationale:
        When the mixed-in operations are virtual, inheritance is the only way to
        supply them. When they are not, it still saves writing forwarding
        functions by hand.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Widget {
        public:
            void log(const std::string& m) { logger_.log(m); }   // forwarding
            int id() const { return counter_.id(); }             // forwarding
        private:
            Logger logger_;
            Counter counter_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Widget : public Logging, public Counted {
            // log() and id() come from the mixins
        };
        \\\
        ```
    languages: [cpp]
    tags: [inheritance, multiple-inheritance, mixins]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-mi-implementation
