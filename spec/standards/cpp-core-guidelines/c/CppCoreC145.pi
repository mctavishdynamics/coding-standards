use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC145:
    standard: @{CppCoreGuidelines}
    ruleId: C.145
    title: Reach polymorphic objects only by pointer or reference
    statement:
        Handle objects of polymorphic types through pointers or references. Do
        not pass or store them by value.
    rationale:
        A virtual call should reach the override of the real type. A by-value
        copy slices the object down to the base class and loses that behavior.
    exceptions:
        In the scope where a polymorphic object is declared by name, calling its
        members directly is fine, as long as it is never copied into a base
        class object.
    severity: null
    noncompliant:
        ```cpp
        \\\
        void describe(Animal a) {    // slices Dog to Animal
            a.speak();
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void describe(const Animal& a) {
            a.speak();               // calls Dog::speak
        }
        \\\
        ```
    languages: [cpp]
    tags: [inheritance, polymorphism, slicing]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-poly
