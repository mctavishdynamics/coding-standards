use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC145:
    standard: @{CppCoreGuidelines}
    ruleId: C.145
    title: Access polymorphic objects through pointers and references
    statement:
        Pass and hold objects of polymorphic types by pointer or reference,
        not by value.
    rationale:
        Calls on a polymorphic object should reach the override of its
        dynamic type, and a copy by value slices the object down to the
        base.
    exceptions:
        A named polymorphic object can be used directly in the scope where
        it is defined, as long as it is not sliced.
    severity: null
    noncompliant:
        ```cpp
        \\\
        void describe(Animal a) {    // slices Dog to Animal
            a.speak();
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void describe(const Animal& a) {
            a.speak();               // calls Dog::speak
        }
        \\\
        ```
    languages: [cpp]
    tags: [inheritance, polymorphism, slicing]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-poly
