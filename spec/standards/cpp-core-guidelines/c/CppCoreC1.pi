use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC1:
    standard: @{CppCoreGuidelines}
    ruleId: C.1
    title: Bundle values that belong together into one type
    statement:
        Values that only make sense together, such as the x and y of a point,
        belong in one struct or class. Do not pass them around as loose
        variables.
    rationale:
        A named type shows readers and tools that the values are linked. It also
        shortens parameter lists and makes the code easier to follow.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void draw_rect(int x, int y, int width, int height);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        struct Rect {
            int x;
            int y;
            int width;
            int height;
        };

        void draw_rect(const Rect& r);
        \\\
        ```
    languages: [cpp]
    tags: [classes, design]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-org
