use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC132:
    standard: @{CppCoreGuidelines}
    ruleId: C.132
    title: Make a member virtual only when overriding is intended
    statement:
        Declare a member function virtual only if derived classes should be able
        to override it.
    rationale:
        Each unneeded virtual function costs a little time and space and invites
        mistakes in derived classes. In class templates it can also force extra
        code to be generated.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<class T>
        class Stack {
        public:
            virtual std::size_t size() const;   // nobody overrides it
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<class T>
        class Stack {
        public:
            std::size_t size() const;
        };
        \\\
        ```
    languages: [cpp]
    tags: [inheritance, virtual-functions, performance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-virtual
