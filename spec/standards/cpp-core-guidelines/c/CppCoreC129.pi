use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC129:
    standard: @{CppCoreGuidelines}
    ruleId: C.129
    title: Keep inheriting an interface apart from inheriting an implementation
    statement:
        Decide for each base class whether it offers an interface or shares
        implementation, and do not mix the two roles. One way is to keep
        separate interface and implementation hierarchies.
    rationale:
        An interface that carries implementation detail breaks easily, and users
        must rebuild whenever that detail changes. Data in a base class also
        makes it harder to write and leads to duplication.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Codec {
        public:
            virtual Bytes encode(const Frame& f) = 0;
        protected:
            std::vector<std::byte> scratch_;   // forced on every codec
            int quality_ = 80;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Codec {                          // pure interface
        public:
            virtual ~Codec() = default;
            virtual Bytes encode(const Frame& f) = 0;
        };

        class BufferedCodec : public Codec {   // optional shared implementation
        protected:
            std::vector<std::byte> scratch_;
            int quality_ = 80;
        };
        \\\
        ```
    languages: [cpp]
    tags: [inheritance, interfaces, design]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-kind
