use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC129:
    standard: @{CppCoreGuidelines}
    ruleId: C.129
    title: Distinguish implementation inheritance from interface inheritance
    statement:
        When designing a hierarchy, decide which bases provide an interface
        and which share implementation, and keep the two kinds apart, for
        example with separate interface and implementation hierarchies.
    rationale:
        Implementation details in an interface make it brittle, forcing
        users to recompile when the implementation changes, and data in a
        base complicates it and leads to duplicated code.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Shape {
        public:
            virtual double area() const = 0;
        protected:
            Point center_;           // every shape pays for this
            Color color_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Shape {                // interface only
        public:
            virtual double area() const = 0;
            virtual ~Shape() = default;
        };

        class ShapeBase : public Shape {   // shared implementation
        protected:
            Point center_;
            Color color_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [inheritance, interfaces, design]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-kind
