use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC8:
    standard: @{CppCoreGuidelines}
    ruleId: C.8
    title: Write class instead of struct once any member is private
    statement:
        Use the class keyword for any type that has a non-public member.
    rationale:
        The keyword hints that the type hides part of its state. Readers can
        expect an abstraction with rules to respect.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        struct Counter {
            void increment() { ++n_; }
            int value() const { return n_; }
        private:
            int n_ = 0;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Counter {
        public:
            void increment() { ++n_; }
            int value() const { return n_; }
        private:
            int n_ = 0;
        };
        \\\
        ```
    languages: [cpp]
    tags: [classes, conventions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-class
