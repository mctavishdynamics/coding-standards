use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC137:
    standard: @{CppCoreGuidelines}
    ruleId: C.137
    title: Share a common base virtually instead of widening the base class
    statement:
        If several branches of a hierarchy need the same data or interface,
        think about making that shared part a virtual base. Do not just keep
        adding to a single root class.
    rationale:
        A virtual base lets the shared piece be split out on its own. The root
        class then stays small instead of collecting everything.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Node {               // root holds data only some nodes need
        protected:
            std::string label_;
            Style style_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Labelled { protected: std::string label_; };
        class Styled   { protected: Style style_; };

        class Text   : public virtual Labelled, public virtual Styled {};
        class Button : public virtual Labelled {};
        \\\
        ```
    languages: [cpp]
    tags: [inheritance, multiple-inheritance, virtual-bases]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-vbase
