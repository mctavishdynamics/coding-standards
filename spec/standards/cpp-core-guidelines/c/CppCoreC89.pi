use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC89:
    standard: @{CppCoreGuidelines}
    ruleId: C.89
    title: Keep hash functions from throwing
    statement:
        A hash function or std::hash specialization must not throw. Mark it
        noexcept.
    rationale:
        Unordered containers call the hash on every insert and lookup, and
        nobody expects those to fail for that reason. The standard library also
        demands a non-throwing hash.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<> struct std::hash<Key> {
            std::size_t operator()(const Key& k) const {
                return std::hash<std::string>()(k.to_string());  // may allocate and throw
            }
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<> struct std::hash<Key> {
            std::size_t operator()(const Key& k) const noexcept {
                return std::hash<int>()(k.id) ^ (std::hash<int>()(k.zone) << 1);
            }
        };
        \\\
        ```
    languages: [cpp]
    tags: [hashing, noexcept]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-hash
