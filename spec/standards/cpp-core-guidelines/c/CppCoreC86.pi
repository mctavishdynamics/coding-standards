use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC86:
    standard: @{CppCoreGuidelines}
    ruleId: C.86
    title: Write equality so it treats both operands alike and never throws
    statement:
        Make == treat its two operands the same way, usually by writing it as a
        non-member that takes two const references. Mark it noexcept.
    rationale:
        If conversions apply to only one side, results depend on argument order,
        which surprises users. Equality is too basic an operation to be allowed
        to fail.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Id {
        public:
            bool operator==(const Id& o) const { return v_ == o.v_; }
            Id(int v);
        private:
            int v_;
        };
        // id == 3 compiles, 3 == id does not
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Id {
        public:
            Id(int v);
            friend bool operator==(const Id& a, const Id& b) noexcept {
                return a.v_ == b.v_;
            }
        private:
            int v_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [operators, equality, noexcept]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-eq
