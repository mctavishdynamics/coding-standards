use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC62:
    standard: @{CppCoreGuidelines}
    ruleId: C.62
    title: Let copy assignment handle an object assigned to itself
    statement:
        Assigning an object to itself must leave it unchanged. Members that
        already cope with self-assignment, or the copy-and-swap idiom, usually
        take care of this.
    rationale:
        If self-assignment changes the value, users are caught off guard. It can
        also cause leaks or reads from freed memory.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Buffer& Buffer::operator=(const Buffer& o) {
            delete[] data_;                   // frees o.data_ if this == &o
            data_ = new char[o.size_];
            std::copy_n(o.data_, o.size_, data_);
            size_ = o.size_;
            return *this;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        Buffer& Buffer::operator=(const Buffer& o) {
            Buffer tmp(o);
            swap(tmp);
            return *this;
        }
        \\\
        ```
    languages: [cpp]
    tags: [copy, assignment, correctness]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-copy-self
