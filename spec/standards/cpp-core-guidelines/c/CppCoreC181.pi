use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC181:
    standard: @{CppCoreGuidelines}
    ruleId: C.181
    title: Wrap every union together with the tag that says what it holds
    statement:
        Never use a bare union. Keep a tag next to it that records which member
        is active, inside a class, or use std::variant.
    rationale:
        With a bare union the programmer alone must remember which member is
        live. Getting that wrong produces type errors.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        union Value {
            int i;
            double d;
        };

        Value v;
        v.d = 2.5;
        int n = v.i;      // wrong member, undefined behavior
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::variant<int, double> v = 2.5;
        if (auto* d = std::get_if<double>(&v))
            use(*d);
        \\\
        ```
    languages: [cpp]
    tags: [unions, type-safety]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ru-naked
