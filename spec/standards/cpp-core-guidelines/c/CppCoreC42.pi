use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC42:
    standard: @{CppCoreGuidelines}
    ruleId: C.42
    title: Signal a failed construction by throwing
    statement:
        If a constructor cannot make the invariant true, throw an exception. Do
        not hand back an object that only looks valid.
    rationale:
        A half-built object that appears to be fine will be misused later, far
        from the real failure.
    exceptions:
        In some hard real-time systems exception timing is too unpredictable.
        There an is_valid style check may be used, as long as every caller tests
        it right after construction.
    severity: null
    noncompliant:
        ```cpp
        \\\
        File::File(const char* path) : fd_(::open(path, O_RDONLY)) {
            // fd_ may be -1; object is unusable but looks fine
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        File::File(const char* path) : fd_(::open(path, O_RDONLY)) {
            if (fd_ < 0)
                throw std::system_error(errno, std::generic_category(), path);
        }
        \\\
        ```
    languages: [cpp]
    tags: [constructors, exceptions, error-handling]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-throw
