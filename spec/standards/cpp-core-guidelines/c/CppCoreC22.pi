use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC22:
    standard: @{CppCoreGuidelines}
    ruleId: C.22
    title: Keep the special member functions in agreement with each other
    statement:
        Copy and move constructors must match the corresponding assignment
        operators. All of them must handle resources the same way the
        constructors and destructor do.
    rationale:
        These operations work as a set and each depends on the others. If
        construction and assignment do different things, users get surprising
        results.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Image {
        public:
            Image(const Image& o) : px_(o.px_.clone()) {}   // deep copy
            Image& operator=(const Image& o) { px_ = o.px_; return *this; } // shallow
        private:
            Pixels px_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Image {
        public:
            Image(const Image& o) : px_(o.px_.clone()) {}
            Image& operator=(const Image& o) { px_ = o.px_.clone(); return *this; }
        private:
            Pixels px_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [classes, special-members, consistency]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-matched
