use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC149:
    standard: @{CppCoreGuidelines}
    ruleId: C.149
    title: Let a smart pointer own each heap object so it is always freed
    statement:
        Put each object made with new straight into a unique_ptr or shared_ptr.
        Do not keep it in a raw owning pointer.
    rationale:
        The smart pointer deletes the object for you, including on early returns
        and when an exception is thrown, so nothing leaks.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void process() {
            Shape* s = new Circle(3.0);
            if (!validate(*s)) return;   // leak
            draw(*s);
            delete s;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void process() {
            std::unique_ptr<Shape> s = std::make_unique<Circle>(3.0);
            if (!validate(*s)) return;
            draw(*s);
        }
        \\\
        ```
    languages: [cpp]
    tags: [memory, smart-pointers, ownership]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-smart
