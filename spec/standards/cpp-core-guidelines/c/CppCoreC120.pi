use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC120:
    standard: @{CppCoreGuidelines}
    ruleId: C.120
    title: Build an inheritance tree only for concepts that really form one
    statement:
        Use inheritance only for concepts that form a genuine hierarchy, where
        every derived type really is a kind of the base. If a member would do
        the job, prefer the member.
    rationale:
        A hierarchy that mirrors the problem is easy to understand and maintain.
        Inheriting merely to reuse some code ties classes together in ways the
        design never meant.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Engine { public: void start(); };
        class Car : public Engine {};   // a car is not an engine
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Car {
        public:
            void start() { engine_.start(); }
        private:
            Engine engine_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [inheritance, design]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-domain
