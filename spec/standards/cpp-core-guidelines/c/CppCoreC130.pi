use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC130:
    standard: @{CppCoreGuidelines}
    ruleId: C.130
    title: Copy polymorphic objects through a virtual clone member
    statement:
        For deep copies of polymorphic objects, add a virtual clone function
        that returns an owning pointer to a new object of the most derived type.
        Do not offer public copy operations.
    rationale:
        Public copying slices a polymorphic object to its base. A clone call
        always copies the real dynamic type.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Token {
        public:
            Token(const Token&) = default;     // copying a Keyword yields a Token
            virtual ~Token() = default;
            virtual std::string text() const = 0;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Token {
        public:
            virtual ~Token() = default;
            virtual std::string text() const = 0;
            virtual std::unique_ptr<Token> clone() const = 0;
        protected:
            Token(const Token&) = default;
        };

        class Keyword final : public Token {
        public:
            std::string text() const override { return word_; }
            std::unique_ptr<Token> clone() const override {
                return std::make_unique<Keyword>(*this);
            }
        private:
            std::string word_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [inheritance, copy, slicing]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-copy
