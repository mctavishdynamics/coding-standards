use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC12:
    standard: @{CppCoreGuidelines}
    ruleId: C.12
    title: Keep const and reference members out of copyable or movable types
    statement:
        A type that should be copyable or movable must not have const or
        reference data members. If a member needs to refer to another object,
        store a pointer, perhaps a not_null one.
    rationale:
        Such members delete the assignment operators without any warning. The
        type can then be copy constructed but not assigned, which confuses
        users.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Logger {
        public:
            Logger(std::ostream& out) : out_(out) {}
        private:
            std::ostream& out_;     // Logger can no longer be assigned
            const int level_ = 1;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Logger {
        public:
            explicit Logger(std::ostream& out) : out_(&out) {}
        private:
            std::ostream* out_;
            int level_ = 1;
        };
        \\\
        ```
    languages: [cpp]
    tags: [classes, copy, move]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-constref
