use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC3:
    standard: @{CppCoreGuidelines}
    ruleId: C.3
    title: Expose a type's interface through a class and keep its details private
    statement:
        Put the operations users call in the public part of a class and keep the
        data behind them private. The split between interface and implementation
        should be plain to see.
    rationale:
        Users then depend only on the public operations. The internals can be
        reworked later without touching calling code, and the class is easier to
        read.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        struct Account {
            double balance;        // anyone can edit it
            std::vector<double> log;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Account {
        public:
            void deposit(double amount);
            double balance() const;
        private:
            double balance_ = 0;
            std::vector<double> log_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [classes, encapsulation, interfaces]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-interface
