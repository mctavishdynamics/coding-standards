use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC63:
    standard: @{CppCoreGuidelines}
    ruleId: C.63
    title: Declare move assignment non-virtual with an rvalue parameter and a self reference result
    statement:
        Move assignment should be a non-virtual member. It takes T&& and returns
        T& referring to *this.
    rationale:
        This form mirrors copy assignment and is both simple and efficient.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Text {
        public:
            virtual const Text& operator=(Text&& other);
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Text {
        public:
            Text& operator=(Text&& other) noexcept;
        };
        \\\
        ```
    languages: [cpp]
    tags: [move, assignment, special-members]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-move-assignment
