use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC84:
    standard: @{CppCoreGuidelines}
    ruleId: C.84
    title: Keep swap from failing
    statement:
        swap must always succeed. Usually it only exchanges pointers and built-
        in values, which cannot fail.
    rationale:
        Many idioms and the standard containers and algorithms assume that
        swapping elements never fails. A swap that can fail breaks them.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void swap(Doc& a, Doc& b) {
            Doc tmp = a;      // copy may allocate and throw
            a = b;
            b = tmp;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void swap(Doc& a, Doc& b) noexcept {
            using std::swap;
            swap(a.body_, b.body_);   // swaps internal pointers only
        }
        \\\
        ```
    languages: [cpp]
    tags: [swap, error-handling]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-swap-fail
