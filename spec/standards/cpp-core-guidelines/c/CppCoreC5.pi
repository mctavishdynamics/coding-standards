use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC5:
    standard: @{CppCoreGuidelines}
    ruleId: C.5
    title: Keep a class's helper functions in the class's namespace
    statement:
        Free functions that support a class, such as operators and utility
        helpers, should live in the same namespace as that class.
    rationale:
        Users see at once that the helpers belong to the type. Argument-
        dependent lookup can also find them without qualification.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        namespace geo {
            struct Point { double x, y; };
        }

        double distance(const geo::Point& a, const geo::Point& b);  // global
        \\\
        ```
    compliant:
        ```cpp
        \\\
        namespace geo {
            struct Point { double x, y; };
            double distance(const Point& a, const Point& b);
        }
        \\\
        ```
    languages: [cpp]
    tags: [classes, namespaces]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-helper
