use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC138:
    standard: @{CppCoreGuidelines}
    ruleId: C.138
    title: Keep base class overloads visible in the derived class
    statement:
        When a derived class declares a function with the same name as a base
        function, add a using declaration for the base name so the full set of
        overloads stays available.
    rationale:
        A name in the derived class hides every base function with that name.
        Calls may then quietly choose a different overload or fail to compile.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        struct Printer {
            void print(int);
            void print(double);
        };
        struct LabelPrinter : Printer {
            void print(const std::string&);   // hides print(int) and print(double)
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        struct LabelPrinter : Printer {
            using Printer::print;
            void print(const std::string&);
        };
        \\\
        ```
    languages: [cpp]
    tags: [inheritance, overloading, name-hiding]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-using
