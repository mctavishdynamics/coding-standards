use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC82:
    standard: @{CppCoreGuidelines}
    ruleId: C.82
    title: Avoid virtual calls during construction and destruction
    statement:
        Do not call virtual functions from a constructor or destructor, either
        directly or through other functions.
    rationale:
        While an object is being built or torn down, a virtual call runs the
        version of the class that is currently active, not the derived override.
        Reaching a pure virtual function this way is undefined behavior.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Base {
        public:
            Base() { init(); }          // never reaches Derived::init
            virtual void init();
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Base {
        public:
            Base() { init_base(); }     // non-virtual helper
        private:
            void init_base();
        };
        \\\
        ```
    languages: [cpp]
    tags: [constructors, destructors, virtual-functions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-ctor-virtual
