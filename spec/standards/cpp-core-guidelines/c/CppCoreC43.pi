use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC43:
    standard: @{CppCoreGuidelines}
    ruleId: C.43
    title: Give copyable classes a usable default constructor
    statement:
        A copyable concrete class should also have a default constructor, which
        makes it semiregular.
    rationale:
        Built-in arrays, a vector created with a size, and many other tools need
        to default construct elements. A default state also serves well as the
        state of a moved-from object.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Color {
        public:
            Color(int r, int g, int b);
        };

        std::vector<Color> palette(16);   // error, no default constructor
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Color {
        public:
            Color() = default;            // black
            Color(int r, int g, int b);
        private:
            int r_ = 0, g_ = 0, b_ = 0;
        };
        \\\
        ```
    languages: [cpp]
    tags: [constructors, value-semantics]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-default0
