use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC9:
    standard: @{CppCoreGuidelines}
    ruleId: C.9
    title: Keep as few members public as possible
    statement:
        Expose as little as possible. Make a member private by default,
        protected if derived classes truly need it, and public only when it
        belongs to the interface.
    rationale:
        Code outside the class cannot misuse what it cannot reach. The invariant
        is safer, and changes stay inside the class.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Buffer {
        public:
            char* data;
            std::size_t size;
            std::size_t capacity;
            void append(char c);
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Buffer {
        public:
            void append(char c);
            std::size_t size() const { return size_; }
        private:
            char* data_ = nullptr;
            std::size_t size_ = 0;
            std::size_t capacity_ = 0;
        };
        \\\
        ```
    languages: [cpp]
    tags: [classes, encapsulation, access-control]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-private
