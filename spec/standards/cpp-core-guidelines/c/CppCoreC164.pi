use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC164:
    standard: @{CppCoreGuidelines}
    ruleId: C.164
    title: Do not let a class convert itself silently to another type
    statement:
        Make conversion operators explicit, or offer a named conversion function
        instead. Allow an implicit conversion only when it is clearly essential.
    rationale:
        Silent conversions occasionally help, but they often surprise. A string
        type that quietly turns into a raw char pointer is a classic example.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Path {
        public:
            operator const char*() const;   // converts anywhere
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Path {
        public:
            const char* c_str() const;
            explicit operator bool() const;
        };
        \\\
        ```
    languages: [cpp]
    tags: [operators, conversions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ro-conversion
