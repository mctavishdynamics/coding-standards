use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC50:
    standard: @{CppCoreGuidelines}
    ruleId: C.50
    title: Build objects through a factory when setup must call virtual functions
    statement:
        If setting up an object needs a virtual call so that derived classes can
        join in, use a factory function. It constructs the object, makes the
        virtual call and only then returns it.
    rationale:
        Inside a constructor, a virtual call does not reach the derived
        override. The factory also keeps callers from seeing the object before
        setup is complete.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Widget {
        public:
            Widget() { post_init(); }        // calls the base version only
        protected:
            virtual void post_init();
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Widget {
        protected:
            Widget() = default;
            virtual void post_init();
        public:
            template<class T>
            static std::unique_ptr<T> create() {
                auto p = std::make_unique<T>();
                p->post_init();
                return p;
            }
        };
        \\\
        ```
    languages: [cpp]
    tags: [constructors, virtual-functions, factory]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-factory
