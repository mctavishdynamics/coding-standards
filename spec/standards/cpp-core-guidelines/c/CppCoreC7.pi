use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC7:
    standard: @{CppCoreGuidelines}
    ruleId: C.7
    title: Declare a type and its variables in separate statements
    statement:
        Write the definition of a class or enum as one declaration, and declare
        objects of that type in a later statement.
    rationale:
        Defining a type and a variable in one line is harder to read and gains
        nothing.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        struct Config {
            int retries;
            int timeout_ms;
        } default_config;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        struct Config {
            int retries;
            int timeout_ms;
        };

        Config default_config;
        \\\
        ```
    languages: [cpp]
    tags: [classes, declarations, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-standalone
