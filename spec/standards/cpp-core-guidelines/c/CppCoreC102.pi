use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC102:
    standard: @{CppCoreGuidelines}
    ruleId: C.102
    title: Let a container be moved cheaply
    statement:
        Give container types a move constructor and a move assignment operator.
    rationale:
        Containers can be large. If returning one by value forces a deep copy,
        people start passing them around by pointer, and ownership mistakes
        follow.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Table {
        public:
            Table(const Table&);
            Table& operator=(const Table&);
            ~Table();
            // no moves, so returning a Table copies it
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Table {
        public:
            Table(const Table&);
            Table& operator=(const Table&);
            Table(Table&&) noexcept;
            Table& operator=(Table&&) noexcept;
            ~Table();
        };
        \\\
        ```
    languages: [cpp]
    tags: [containers, move, performance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rcon-move
