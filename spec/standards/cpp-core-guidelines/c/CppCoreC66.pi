use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC66:
    standard: @{CppCoreGuidelines}
    ruleId: C.66
    title: Mark move constructors and move assignment noexcept
    statement:
        Write move constructors and move assignment so they cannot throw, and
        mark them noexcept.
    rationale:
        Users expect a move not to fail. Containers such as std::vector use a
        move only when it is noexcept, and otherwise fall back to copying.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Track {
        public:
            Track(Track&& o);    // vector will copy instead of move when growing
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Track {
        public:
            Track(Track&& o) noexcept;
        };
        \\\
        ```
    languages: [cpp]
    tags: [move, noexcept, performance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-move-noexcept
