use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC52:
    standard: @{CppCoreGuidelines}
    ruleId: C.52
    title: Inherit base constructors when a derived class adds no state to set up
    statement:
        If a derived class adds no members of its own that need setting up,
        inherit the base constructors with a using declaration.
    rationale:
        Writing a forwarding constructor for every base constructor is dull work
        and easy to get wrong.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class SafeVector : public std::vector<int> {
        public:
            SafeVector() = default;
            explicit SafeVector(std::size_t n) : std::vector<int>(n) {}
            SafeVector(std::initializer_list<int> il) : std::vector<int>(il) {}
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class SafeVector : public std::vector<int> {
        public:
            using std::vector<int>::vector;
            int& checked(std::size_t i) { return this->at(i); }
        };
        \\\
        ```
    languages: [cpp]
    tags: [constructors, inheritance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-inheriting
