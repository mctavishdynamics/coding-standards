use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC80:
    standard: @{CppCoreGuidelines}
    ruleId: C.80
    title: Request compiler-generated special members explicitly with default
    statement:
        If you must declare a special member function but want the standard
        behavior, write =default rather than a hand-made body.
    rationale:
        The compiler gets the default meaning right and generates code that is
        at least as good as manual code.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Tag {
        public:
            virtual ~Tag() {}
            Tag(const Tag& o) : name_(o.name_) {}
        private:
            std::string name_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Tag {
        public:
            virtual ~Tag() = default;
            Tag(const Tag&) = default;
        private:
            std::string name_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [special-members, defaults]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-eqdefault
