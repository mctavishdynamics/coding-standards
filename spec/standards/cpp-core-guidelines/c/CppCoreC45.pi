use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC45:
    standard: @{CppCoreGuidelines}
    ruleId: C.45
    title: Set member defaults in the class body instead of an empty constructor
    statement:
        When a default constructor would only give members fixed starting
        values, write those values as default member initializers instead. Then
        let the compiler generate the constructor.
    rationale:
        The compiler-generated constructor may be faster, and each starting
        value sits right next to its member.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Retry {
        public:
            Retry() : attempts_(3), delay_ms_(100) {}
        private:
            int attempts_;
            int delay_ms_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Retry {
        private:
            int attempts_ = 3;
            int delay_ms_ = 100;
        };
        \\\
        ```
    languages: [cpp]
    tags: [constructors, initialization]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-default
