use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC90:
    standard: @{CppCoreGuidelines}
    ruleId: C.90
    title: Set up and copy objects with their own members instead of raw byte functions
    statement:
        Rely on constructors and assignment to set up and copy objects. Never
        apply memset or memcpy to a type that is not trivially copyable.
    rationale:
        Constructors and copy operations keep the invariant and maintain
        internal pointers such as a vtable. Raw byte copies of such types are
        undefined behavior and often corrupt the object.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        struct Base { virtual void f(); int n; };

        Base b;
        std::memset(&b, 0, sizeof b);   // wipes the vtable pointer
        \\\
        ```
    compliant:
        ```cpp
        \\\
        struct Base { virtual void f(); int n = 0; };

        Base b;          // constructor sets everything
        Base c = b;      // copy constructor
        \\\
        ```
    languages: [cpp]
    tags: [constructors, copy, undefined-behavior]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-memset
