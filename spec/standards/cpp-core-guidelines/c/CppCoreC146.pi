use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC146:
    standard: @{CppCoreGuidelines}
    ruleId: C.146
    title: Cast down a hierarchy with dynamic_cast only when there is no alternative
    statement:
        If you have no choice but to cast down or across a class hierarchy, use
        dynamic_cast rather than static_cast or another unchecked cast.
    rationale:
        dynamic_cast inspects the object's real type at run time rather than
        trusting an assumption.
    exceptions:
        If profiling shows dynamic_cast is too slow on a hot path, and the
        target type is guaranteed by other means and no virtual inheritance is
        involved, a static_cast with a clear comment may be used. Reviewers must
        keep an eye on that code as it evolves.
    severity: null
    noncompliant:
        ```cpp
        \\\
        void on_click(Widget* w) {
            auto* b = static_cast<Button*>(w);   // wrong if w is not a Button
            b->press();
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void on_click(Widget* w) {
            if (auto* b = dynamic_cast<Button*>(w))
                b->press();
        }
        \\\
        ```
    languages: [cpp]
    tags: [inheritance, casts, type-safety]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-dynamic_cast
