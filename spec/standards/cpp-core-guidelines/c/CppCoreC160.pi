use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC160:
    standard: @{CppCoreGuidelines}
    ruleId: C.160
    title: Overload an operator only to match its familiar meaning
    statement:
        Overload an operator only so it does what that operator conventionally
        does. For example, + should add, == should compare and << should write
        to a stream.
    rationale:
        Readers already know what an operator symbol means. Keeping that meaning
        avoids surprises.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Vector operator+(const Vector& a, const Vector& b) {
            return cross_product(a, b);
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        Vector operator+(const Vector& a, const Vector& b) {
            return Vector(a.x + b.x, a.y + b.y, a.z + b.z);
        }
        Vector cross(const Vector& a, const Vector& b);
        \\\
        ```
    languages: [cpp]
    tags: [operators, overloading, conventions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ro-conventional
