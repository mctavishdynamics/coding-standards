use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC65:
    standard: @{CppCoreGuidelines}
    ruleId: C.65
    title: Let move assignment handle an object moved into itself
    statement:
        Moving an object into itself must not destroy or corrupt its value.
    rationale:
        Few people write a self-move on purpose, but it can happen indirectly,
        for example in a swap of an object with itself. The resulting bug is
        hard to track down.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Buffer& Buffer::operator=(Buffer&& o) noexcept {
            delete[] data_;
            data_ = o.data_;     // dangling if this == &o
            o.data_ = nullptr;
            return *this;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        Buffer& Buffer::operator=(Buffer&& o) noexcept {
            if (this != &o) {
                delete[] data_;
                data_ = std::exchange(o.data_, nullptr);
            }
            return *this;
        }
        \\\
        ```
    languages: [cpp]
    tags: [move, assignment, correctness]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-move-self
