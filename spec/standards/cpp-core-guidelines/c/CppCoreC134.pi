use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC134:
    standard: @{CppCoreGuidelines}
    ruleId: C.134
    title: Put every mutable data member under one access specifier
    statement:
        All writable data members of a type should have the same access. Make
        them all private when the type keeps an invariant, or all public when it
        is just a bundle of values.
    rationale:
        Mixed access suggests the type cannot decide whether it guards an
        invariant. That uncertainty leads to logic errors.
    exceptions:
        A type may mix them for a reason such as debugging, where a non-const
        counter or trace field is not part of the value. That field can be
        public while the members that make up the invariant stay private.
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Temperature {
        public:
            double celsius;        // public
        private:
            double fahrenheit;     // must match celsius
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Temperature {
        public:
            void set_celsius(double c);
            double fahrenheit() const;
        private:
            double celsius_ = 0;
        };
        \\\
        ```
    languages: [cpp]
    tags: [classes, access-control, invariants]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-public
