use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC4:
    standard: @{CppCoreGuidelines}
    ruleId: C.4
    title: Keep functions that do not need private access outside the class
    statement:
        Only functions that must touch private data belong inside the class.
        Anything that can be built on the public interface goes in a namespace
        as a non-member.
    rationale:
        Every member can break the invariant and must be reviewed when the
        representation changes. Fewer members means looser coupling and less to
        recheck.
    exceptions:
        Virtual functions and the operators =, (), [] and -> have to be members.
        A function may also stay a member for consistency with an overload set
        or a chain of calls, even if it touches no private data.
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Date {
        public:
            int year() const;
            int month() const;
            int day() const;
            Date next_weekday() const;   // uses only the accessors above
        private:
            int y_, m_, d_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Date {
        public:
            int year() const;
            int month() const;
            int day() const;
        private:
            int y_, m_, d_;
        };

        Date next_weekday(const Date& d);
        \\\
        ```
    languages: [cpp]
    tags: [classes, coupling, encapsulation]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-member
