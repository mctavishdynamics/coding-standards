use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC150:
    standard: @{CppCoreGuidelines}
    ruleId: C.150
    title: Create uniquely owned objects with make_unique
    statement:
        Create objects for a unique_ptr with std::make_unique rather than a bare
        new. R.23 covers this in more depth.
    rationale:
        make_unique is shorter, mentions the type only once and avoids leaks
        caused by unspecified evaluation order.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::unique_ptr<Order> o(new Order(id, qty));
        \\\
        ```
    compliant:
        ```cpp
        \\\
        auto o = std::make_unique<Order>(id, qty);
        \\\
        ```
    languages: [cpp]
    tags: [memory, smart-pointers]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rh-make_unique
