use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC49:
    standard: @{CppCoreGuidelines}
    ruleId: C.49
    title: Initialize members in the initializer list instead of assigning in the body
    statement:
        Give members their values in the member initializer list, not through
        assignments in the constructor body.
    rationale:
        Initializing directly states the intent and can be faster than building
        then reassigning. It also leaves no window in which a member is used
        before it holds a value.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class User {
        public:
            User(const std::string& name) { name_ = name; }  // default-construct, then assign
        private:
            std::string name_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class User {
        public:
            explicit User(const std::string& name) : name_(name) {}
        private:
            std::string name_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [constructors, initialization, performance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-initialize
