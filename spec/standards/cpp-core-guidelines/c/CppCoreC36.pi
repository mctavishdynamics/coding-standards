use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC36:
    standard: @{CppCoreGuidelines}
    ruleId: C.36
    title: Keep destructors from failing
    statement:
        A destructor must not fail. Deal with any error inside it, for example
        by logging, and never let an exception leave it.
    rationale:
        If cleanup can fail, it is nearly impossible to write correct code
        around it. The standard library also assumes that destructors never
        throw.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Connection::~Connection() {
            if (!flush())
                throw std::runtime_error("flush failed");
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        Connection::~Connection() {
            if (!flush())
                log_error("flush failed on close");
        }
        \\\
        ```
    languages: [cpp]
    tags: [destructors, error-handling, exceptions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-dtor-fail
