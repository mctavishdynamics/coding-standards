use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreC11:
    standard: @{CppCoreGuidelines}
    ruleId: C.11
    title: Let concrete types copy and compare like built-in values
    statement:
        Make concrete types regular. They should support default construction,
        copying and assignment, and an equality test, all consistent with each
        other.
    rationale:
        Built-in types and standard containers behave this way. A type that does
        too fits in with users' habits and with standard algorithms.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        struct Money {
            long cents;
            // no operator==, so values cannot be compared
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        struct Money {
            long cents = 0;
            friend bool operator==(const Money&, const Money&) = default;
        };
        \\\
        ```
    languages: [cpp]
    tags: [classes, value-semantics]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rc-regular
