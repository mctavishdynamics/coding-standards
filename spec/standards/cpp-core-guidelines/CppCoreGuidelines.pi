export coding-standard CppCoreGuidelines:
    title: C++ Core Guidelines
    publisher: Bjarne Stroustrup and Herb Sutter
    url: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines
    version: Jun 14, 2026
    license:
        Copyright (c) Standard C++ Foundation and its contributors. MIT-style
        license that permits copying, use, modification and derivative works
        for personal or internal business use only, with the notice kept.
    description:
        A set of guidelines for using modern ISO C++ well, edited by Bjarne
        Stroustrup and Herb Sutter. Rules are grouped into numbered sections
        such as P, I, F and C, each with a reason, examples and enforcement.
    rules:
        - @{CppCoreP1}
        - @{CppCoreP2}
        - @{CppCoreP3}
        - @{CppCoreP4}
        - @{CppCoreP5}
        - @{CppCoreP6}
        - @{CppCoreP7}
        - @{CppCoreP8}
