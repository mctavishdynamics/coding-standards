use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSl1:
    standard: @{CppCoreGuidelines}
    ruleId: SL.1
    title: Use existing libraries wherever they fit
    statement:
        Before writing a facility yourself, look for a library that already provides
        it, and use that.
    rationale:
        Reusing tested work saves effort. Fixes and speedups that others make reach
        your code for free, and your own improvements can help them in return.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int my_strlen(const char* s)
        {
            int n = 0;
            while (s[n]) ++n;
            return n;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::size_t n = std::strlen(s);
        \\\
        ```
    languages: [cpp]
    tags: [libraries, reuse]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rsl-lib
