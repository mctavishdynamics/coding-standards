use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSlStr4:
    standard: @{CppCoreGuidelines}
    ruleId: SL.str.4
    title: Reserve char pointers for a single character
    statement:
        Let a plain char pointer refer to one single character only. For text, use
        zstring, std::string or std::string_view.
    rationale:
        Existing code uses char pointers for so many purposes that mix-ups are
        common, such as handing an array without a terminator to a function that
        expects a C string.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        char code[] = {'O', 'K'};          // not zero-terminated

        void show(const char* p) { std::cout << p; }
        show(code);                         // reads past the array
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void show(std::string_view s) { std::cout << s; }
        show(std::string_view{code, std::size(code)});
        \\\
        ```
    languages: [cpp]
    tags: [strings, pointers, bounds-safety]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rstr-charp
