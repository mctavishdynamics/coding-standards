use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSlIo1:
    standard: @{CppCoreGuidelines}
    ruleId: SL.io.1
    title: Read input a character at a time only when necessary
    statement:
        Let the stream operators and getline read whole words, numbers and lines.
        Read input one character at a time only when the program really works with
        single characters.
    rationale:
        Assembling tokens by hand from individual characters is easy to get wrong
        and is often slower than the library's own parsing.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int quantity = 0;
        char ch;
        while (std::cin.get(ch) && ch >= '0' && ch <= '9')
            quantity = quantity * 10 + (ch - '0');   // no sign, no overflow check
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int quantity = 0;
        if (!(std::cin >> quantity))
            report_bad_input();
        \\\
        ```
    languages: [cpp]
    tags: [io, input]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rio-low
