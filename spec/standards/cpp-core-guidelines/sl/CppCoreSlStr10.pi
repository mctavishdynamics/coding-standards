use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSlStr10:
    standard: @{CppCoreGuidelines}
    ruleId: SL.str.10
    title: Use std::string for locale-dependent text operations
    statement:
        Hold text in std::string when it has to go through locale-aware processing.
    rationale:
        The standard locale facilities are built to operate on std::string.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [strings, localization]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rstr-locale
