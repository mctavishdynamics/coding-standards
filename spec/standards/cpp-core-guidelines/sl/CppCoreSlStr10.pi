use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSlStr10:
    standard: @{CppCoreGuidelines}
    ruleId: SL.str.10
    title: Use std::string when you need to perform locale-sensitive string operations
    statement:
        Use std::string for text that must be processed with locale
        facilities.
    rationale:
        A std::string works with the standard library locale facilities.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [strings, localization]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rstr-locale
