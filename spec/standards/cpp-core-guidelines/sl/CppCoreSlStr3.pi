use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSlStr3:
    standard: @{CppCoreGuidelines}
    ruleId: SL.str.3
    title: Mark pointers to null-terminated strings with zstring or czstring
    statement:
        Declare a pointer to a zero-terminated string as gsl::zstring
        or gsl::czstring instead of a bare char pointer. Neither alias
        owns its characters.
    rationale:
        A bare char pointer could refer to one character, a raw array, a C string or
        even a tiny integer. Naming the meaning removes guesswork and a large family
        of bugs.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void set_title(const char* t);   // a string? one character? nullable?
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void set_title(gsl::czstring t); // zero-terminated string or nullptr
        \\\
        ```
    languages: [cpp]
    tags: [strings, pointers, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rstr-zstring
