use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSl3:
    standard: @{CppCoreGuidelines}
    ruleId: SL.3
    title: Never add your own declarations to namespace std
    statement:
        Keep your own classes, functions and templates out of namespace std. Declare
        them in a namespace that belongs to your project.
    rationale:
        Extra declarations in std can alter what valid code means. They may also
        collide with names a later standard introduces.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        namespace std {
            template<typename T>
            class ring_buffer { /* ... */ };
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        namespace telemetry {
            template<typename T>
            class ring_buffer { /* ... */ };
        }
        \\\
        ```
    languages: [cpp]
    tags: [standard-library, namespaces]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#sl-std
