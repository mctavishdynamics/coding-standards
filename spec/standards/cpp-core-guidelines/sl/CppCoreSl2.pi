use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSl2:
    standard: @{CppCoreGuidelines}
    ruleId: SL.2
    title: Choose the standard library first
    statement:
        Reach for the standard library before any other library when it covers the
        task.
    rationale:
        Every conforming toolchain ships it, most C++ programmers already know it,
        and it is maintained and kept stable for the long term. In-house code and
        most third-party libraries cannot match all of that.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        my_lib::Dynamic_array<int> ids;
        my_lib::sort(ids);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::vector<int> ids;
        std::ranges::sort(ids);
        \\\
        ```
    languages: [cpp]
    tags: [libraries, standard-library]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rsl-sl
