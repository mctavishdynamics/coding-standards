use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSlStr5:
    standard: @{CppCoreGuidelines}
    ruleId: SL.str.5
    title: Use std::byte for raw bytes that are not text
    statement:
        Represent raw bytes and memory that is not text with std::byte, which C++17
        introduced.
    rationale:
        When a char pointer stands for something other than characters, readers are
        misled. Character types may alias any object, so the compiler also has to
        forgo some optimizations.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void checksum(const char* data, std::size_t n);   // binary buffer, not text
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::uint32_t checksum(std::span<const std::byte> data);
        \\\
        ```
    languages: [cpp]
    tags: [strings, memory, type-safety]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rstr-byte
