use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSlCon4:
    standard: @{CppCoreGuidelines}
    ruleId: SL.con.4
    title: Keep memset and memcpy away from non-trivially-copyable types
    statement:
        Only use memset, memcpy, memmove, memcmp and their wide-character forms on
        trivially copyable types. For other types, use their constructors,
        assignment operators and comparison operators.
    rationale:
        Byte-level copying knows nothing about what an object means. It can clobber
        a virtual table pointer, skip constructors and break the class invariant.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        struct Session : Connection {        // Connection has virtual functions
            std::string user;
        };

        void reset(Session& s) { std::memset(&s, 0, sizeof s); }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void reset(Session& s) { s = Session{}; }
        \\\
        ```
    languages: [cpp]
    tags: [memory, type-safety, standard-library]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rsl-copy
