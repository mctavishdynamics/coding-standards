use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSlCon2:
    standard: @{CppCoreGuidelines}
    ruleId: SL.con.2
    title: Use std::vector as the default container
    statement:
        Choose std::vector unless you have a reason not to, and std::array when the
        size is known in advance. Pick a different container only when a measured
        need calls for it, and do not use std::string as a generic character
        container.
    rationale:
        Elements stored side by side are reached quickly, are walked in an order the
        cache prefetcher likes and carry no per-element bookkeeping. Because of
        this, a vector often outperforms a list or a map, even at their own
        specialties, for data up to a few kilobytes.
    exceptions:
        A large collection that changes often and needs guaranteed fast lookup may
        call for map or unordered_map, since keeping a vector sorted would cost too
        much.
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::list<int> recent_ids;      // small, traversed often
        for (int id : recent_ids) audit(id);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::vector<int> recent_ids;
        for (int id : recent_ids) audit(id);
        \\\
        ```
    languages: [cpp]
    tags: [containers, performance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rsl-vector
