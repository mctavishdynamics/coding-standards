use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSl4:
    standard: @{CppCoreGuidelines}
    ruleId: SL.4
    title: Call the standard library in type-safe ways
    statement:
        Call standard library facilities in a type-safe way, with no casts to force
        arguments through, no untyped byte buffers and no mismatched format
        arguments. Narrower rules spell out the details.
    rationale:
        Getting around the library's types leads to undefined behavior, corrupted
        memory and similar serious defects.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::vector<double> values(8);
        std::memset(values.data(), 1, values.size());   // wrong size, meaningless bytes
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::vector<double> values(8);
        std::ranges::fill(values, 1.0);
        \\\
        ```
    languages: [cpp]
    tags: [standard-library, type-safety]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#sl-safe
