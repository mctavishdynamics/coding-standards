use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSlCon3:
    standard: @{CppCoreGuidelines}
    ruleId: SL.con.3
    title: Never read or write outside a container's bounds
    statement:
        Stay inside a container's valid range on every access. Range-based loops,
        algorithms, span and checked accessors like at() help, while raw subscripts
        and memory functions with hand-computed sizes do not.
    rationale:
        An access past the end yields bad data, crashes the program or opens a
        security hole. Safe iteration is generally as fast as unchecked code, and
        one check up front can often cover a whole loop.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::vector<double> samples(count);
        std::memcpy(samples.data(), source, count);   // copies count bytes, not doubles
        double peak = samples[pos];                   // pos never checked
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::vector<double> samples(source, source + count);
        double peak = samples.at(pos);                // throws std::out_of_range
        \\\
        ```
    languages: [cpp]
    tags: [bounds-safety, containers, security]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rsl-bounds
