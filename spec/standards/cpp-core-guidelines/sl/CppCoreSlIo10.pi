use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSlIo10:
    standard: @{CppCoreGuidelines}
    ruleId: SL.io.10
    title: Turn off stdio synchronization when not mixing in printf
    statement:
        At the top of main, call std::ios_base::sync_with_stdio(false) unless the
        program also writes or reads through printf and its relatives.
    rationale:
        The standard streams are kept in lock step with C stdio by default. That
        coordination has a noticeable cost that buys nothing when C I/O is not used.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int main()
        {
            for (int x; std::cin >> x; ) std::cout << x * 2 << '\n';
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int main()
        {
            std::ios_base::sync_with_stdio(false);
            for (int x; std::cin >> x; ) std::cout << x * 2 << '\n';
        }
        \\\
        ```
    languages: [cpp]
    tags: [io, performance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rio-sync
