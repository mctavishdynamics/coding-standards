use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSlStr2:
    standard: @{CppCoreGuidelines}
    ruleId: SL.str.2
    title: Refer to text you do not own with string_view or a char span
    statement:
        Use std::string_view for read access to characters owned elsewhere, or a
        span of char when they must be changeable.
    rationale:
        Both work no matter where or how the characters are stored. A single
        function can therefore take a literal, a C string or a std::string, and
        access is bounded by a known length.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        bool has_prefix(const std::string& text, const std::string& prefix);

        has_prefix(line, "GET ");   // builds a temporary std::string
        \\\
        ```
    compliant:
        ```cpp
        \\\
        bool has_prefix(std::string_view text, std::string_view prefix);

        has_prefix(line, "GET ");
        \\\
        ```
    languages: [cpp]
    tags: [strings, interfaces, performance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rstr-view
