use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSlStr1:
    standard: @{CppCoreGuidelines}
    ruleId: SL.str.1
    title: Own text with std::string
    statement:
        Store character data that your code owns in a std::string, not in a char
        array or a buffer you allocate and free yourself.
    rationale:
        A string takes care of memory, ownership, copying and growth, and comes with
        many handy operations. Hand-managed C strings are a steady source of leaks,
        overruns and security flaws, and they are seldom faster.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        char* join_path(const char* dir, const char* file)
        {
            char* p = (char*) malloc(strlen(dir) + strlen(file) + 2);
            sprintf(p, "%s/%s", dir, file);
            return p;               // caller must remember free()
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::string join_path(std::string_view dir, std::string_view file)
        {
            std::string p{dir};
            p += '/';
            p += file;
            return p;
        }
        \\\
        ```
    languages: [cpp]
    tags: [strings, ownership, memory]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rstr-string
