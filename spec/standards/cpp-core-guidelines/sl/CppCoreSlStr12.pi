use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSlStr12:
    standard: @{CppCoreGuidelines}
    ruleId: SL.str.12
    title: Add the s suffix to literals that should be std::string
    statement:
        Write a string literal with the s suffix when you want a std::string, so
        that auto and template deduction produce std::string and not const char
        pointer.
    rationale:
        Saying what you mean in the code prevents surprises. Without the suffix, a
        deduced pair or container ends up holding pointers to C strings.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        auto entry = std::make_pair("timeout", 30);   // pair<const char*, int>
        \\\
        ```
    compliant:
        ```cpp
        \\\
        using namespace std::string_literals;
        auto entry = std::make_pair("timeout"s, 30);  // pair<std::string, int>
        \\\
        ```
    languages: [cpp]
    tags: [strings, literals, type-deduction]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rstr-s
