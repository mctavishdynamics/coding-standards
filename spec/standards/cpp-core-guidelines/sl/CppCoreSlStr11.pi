use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSlStr11:
    standard: @{CppCoreGuidelines}
    ruleId: SL.str.11
    title: Use a span of char to change text in place
    statement:
        When a function must modify characters it does not own, give it a span of
        char. A string_view will not do.
    rationale:
        Characters behind a std::string_view cannot be changed through it, and the
        compiler rejects any attempt to write.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void to_upper(std::string_view s)
        {
            for (char& c : s) c = std::toupper(c);   // error: read-only
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void to_upper(gsl::span<char> s)
        {
            for (char& c : s) c = static_cast<char>(std::toupper(c));
        }
        \\\
        ```
    languages: [cpp]
    tags: [strings, interfaces]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rstr-span
