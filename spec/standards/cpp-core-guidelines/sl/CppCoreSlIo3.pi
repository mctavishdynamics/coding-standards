use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSlIo3:
    standard: @{CppCoreGuidelines}
    ruleId: SL.io.3
    title: Use iostreams for input and output
    statement:
        Do input and output through iostreams instead of printf, scanf and the rest
        of the C stdio family.
    rationale:
        Streams check types at compile time, can be extended to print and read your
        own types, take care of buffer memory and respect locales. With gets and the
        percent-s conversion of scanf, a long line overruns the buffer.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        char name[32];
        scanf("%s", name);          // overflows on long input
        printf("%d\n", name);       // wrong format, compiles
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::string name;
        std::cin >> name;
        std::cout << name << '\n';
        \\\
        ```
    languages: [cpp]
    tags: [io, type-safety, security]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rio-streams
