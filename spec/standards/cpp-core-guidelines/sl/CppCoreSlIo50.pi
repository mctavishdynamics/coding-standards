use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSlIo50:
    standard: @{CppCoreGuidelines}
    ruleId: SL.io.50
    title: Write a newline character instead of endl
    statement:
        Write a newline character to end a line rather than std::endl. Flush the
        stream on purpose when you actually need the output to appear.
    rationale:
        Besides the newline, endl forces a flush, and flushing after each line can
        make output much slower. It does not give you a platform-specific line
        ending either.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        for (const auto& row : rows)
            out << row << std::endl;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        for (const auto& row : rows)
            out << row << '\n';
        \\\
        ```
    languages: [cpp]
    tags: [io, performance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rio-endl
