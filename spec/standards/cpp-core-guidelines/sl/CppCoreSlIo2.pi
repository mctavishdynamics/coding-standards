use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSlIo2:
    standard: @{CppCoreGuidelines}
    ruleId: SL.io.2
    title: Expect malformed input whenever you read
    statement:
        Validate every piece of input right where it is read, and handle read
        failures there.
    rationale:
        Catching bad data at the edge is cheapest. If it gets through, every
        function deeper in the program would have to defend against it, which nobody
        can do in practice.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int age;
        std::cin >> age;
        register_user(age);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int age;
        if (!(std::cin >> age) || age < 0 || age > 150)
            throw std::invalid_argument("bad age");
        register_user(age);
        \\\
        ```
    languages: [cpp]
    tags: [io, input-validation, error-handling]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rio-validate
