use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSlCon1:
    standard: @{CppCoreGuidelines}
    ruleId: SL.con.1
    title: Use std::array or std::vector instead of built-in arrays
    statement:
        Prefer std::array when the element count is fixed and std::vector when it
        varies. Avoid built-in arrays and new[], and use a span to look at elements
        you do not own.
    rationale:
        A built-in array converts to a pointer at the slightest chance, forgets its
        length and, when allocated with new, has to be freed by hand. The standard
        types avoid all of this at no extra cost, and a std::array still keeps its
        elements on the stack.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int scores[MAX_PLAYERS];
        double* samples = new double[n];
        // ...
        delete[] samples;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::array<int, MAX_PLAYERS> scores{};
        std::vector<double> samples(n);
        \\\
        ```
    languages: [cpp]
    tags: [containers, arrays, memory]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rsl-arrays
