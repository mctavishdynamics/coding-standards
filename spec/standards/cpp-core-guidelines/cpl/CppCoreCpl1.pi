use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCpl1:
    standard: @{CppCoreGuidelines}
    ruleId: CPL.1
    title: Choose C++ over C where you can
    statement:
        Pick C++ instead of C for new code whenever the choice is open.
    rationale:
        The C++ type system catches errors that C lets through, such as silent
        conversions from void pointers. C++ also offers richer ways to express
        abstractions, and its compilers frequently produce quicker code for them.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        double d = 0;
        void* p = &d;
        long long* q = p;      // accepted by C, silently reinterprets
        \\\
        ```
    compliant:
        ```cpp
        \\\
        double d = 0;
        void* p = &d;
        double* q = static_cast<double*>(p);   // explicit, type-correct
        \\\
        ```
    languages: [cpp]
    tags: [c-compatibility, type-safety]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rcpl-c
