use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCpl2:
    standard: @{CppCoreGuidelines}
    ruleId: CPL.2
    title: Write C that also compiles as C++ and build it with a C++ compiler
    statement:
        If the code must stay in C, restrict it to the part of C that is also legal
        C++, and build it with a C++ compiler.
    rationale:
        The same source then works with both toolchains, and the C++ compiler
        applies stricter type checks than a C compiler would.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int* ids = malloc(count * sizeof(int));   // valid C only
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int* ids = (int*) malloc(count * sizeof(int));   // valid C and C++
        \\\
        ```
    languages: [cpp]
    tags: [c-compatibility, build]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rcpl-subset
