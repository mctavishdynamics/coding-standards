use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCpl3:
    standard: @{CppCoreGuidelines}
    ruleId: CPL.3
    title: Call C interfaces from C++ code when C is required at the boundary
    statement:
        When you must use a library or system API written in C, declare it in the
        shared C and C++ subset, put a C++ wrapper around it that follows these
        guidelines, and have the rest of the program call the wrapper.
    rationale:
        Calling the bare C API from every place spreads manual memory and resource
        handling through the program. A C++ wrapper adds type safety, RAII and
        clearer abstractions at a single point.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void load(const char* path)
        {
            FILE* f = fopen(path, "r");
            parse(f);               // leaks f if parse throws
            fclose(f);
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        struct File_closer { void operator()(FILE* f) const { fclose(f); } };
        using File = std::unique_ptr<FILE, File_closer>;

        void load(const char* path)
        {
            File f{fopen(path, "r")};
            parse(f.get());
        }
        \\\
        ```
    languages: [cpp]
    tags: [c-compatibility, interfaces, resource-management]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rcpl-interface
