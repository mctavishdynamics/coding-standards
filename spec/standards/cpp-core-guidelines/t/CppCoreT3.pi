use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT3:
    standard: @{CppCoreGuidelines}
    ruleId: T.3
    title: Write containers and ranges as templates
    statement:
        Express the element type of a container or range as a template parameter. Do
        not store untyped void pointers together with an element size.
    rationale:
        A typed container is general, reusable and type safe, and it lets the
        compiler check and optimize uses. A container of void pointers hides what it
        holds and forces a cast at every access.
    exceptions:
        Where a stable ABI is required, it can make sense to put a non-template
        implementation underneath and layer a type-safe template interface over it.
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Queue {
        public:
            void push(void* item);
            void* pop();
        };

        Queue q;
        q.push(new Order{42});
        auto* o = static_cast<Order*>(q.pop());   // cast on every use
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<typename T>
        class Queue {
        public:
            void push(T item);
            T pop();
        };

        Queue<Order> q;
        q.push(Order{42});
        Order o = q.pop();
        \\\
        ```
    languages: [cpp]
    tags: [templates, containers, type-safety]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-cont
