use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT122:
    standard: @{CppCoreGuidelines}
    ruleId: T.122
    title: Compute types during compilation with templates such as alias templates
    statement:
        Produce types at compile time with templates, and prefer alias templates for
        the purpose.
    rationale:
        Templates are the one mechanism the language provides for computing types
        during compilation. An alias template does this more directly than a traits
        class with a nested type member.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```cpp
        \\\
        template<typename T>
        using Storage = std::conditional_t<(sizeof(T) <= 16), T, std::unique_ptr<T>>;

        Storage<int> small;            // int
        Storage<Big_record> large;     // std::unique_ptr<Big_record>
        \\\
        ```
    languages: [cpp]
    tags: [templates, metaprogramming, aliases]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-tmp
