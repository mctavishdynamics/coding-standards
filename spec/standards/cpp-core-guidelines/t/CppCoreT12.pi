use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT12:
    standard: @{CppCoreGuidelines}
    ruleId: T.12
    title: Declare local variables with a concept instead of plain auto
    statement:
        For a deduced local variable, write the concept it must model, such
        as std::integral auto, instead of auto on its own.
    rationale:
        Plain auto accepts anything, so it is the loosest constraint there is.
        Naming the concept tells readers what kind of value to expect, and the
        compiler verifies it.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        auto& first = names.front();
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::copyable auto& first = names.front();
        \\\
        ```
    languages: [cpp]
    tags: [templates, concepts, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-auto
