use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT141:
    standard: @{CppCoreGuidelines}
    ruleId: T.141
    title: Use an inline lambda for a small function object used once
    statement:
        When a small function object is needed at just one call site, write it as a
        lambda right there. F.11 gives the same advice.
    rationale:
        The logic stays next to the only code that uses it, which makes it easier to
        follow. No name is added to the surrounding scope for a single use.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        struct By_length {
            bool operator()(const std::string& a, const std::string& b) const
            { return a.size() < b.size(); }
        };
        std::sort(words.begin(), words.end(), By_length{});
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::sort(words.begin(), words.end(),
                  [](const std::string& a, const std::string& b) { return a.size() < b.size(); });
        \\\
        ```
    languages: [cpp]
    tags: [functions, lambdas, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-lambda
