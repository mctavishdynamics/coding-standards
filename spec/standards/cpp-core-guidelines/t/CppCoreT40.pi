use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT40:
    standard: @{CppCoreGuidelines}
    ruleId: T.40
    title: Pass operations to algorithms as function objects
    statement:
        Hand algorithms a lambda or other function object instead of a pointer to a
        function.
    rationale:
        A function object can hold state such as a limit or a reference value. The
        compiler can usually inline its call, which a function pointer often
        prevents, so the result is both more flexible and typically faster.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        bool over_limit(int x) { return x > 100; }

        auto it = std::find_if(v.begin(), v.end(), over_limit);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int limit = read_limit();
        auto it = std::find_if(v.begin(), v.end(),
                               [limit](int x) { return x > limit; });
        \\\
        ```
    languages: [cpp]
    tags: [templates, algorithms, performance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-fo
