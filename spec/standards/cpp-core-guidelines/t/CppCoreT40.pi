use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT40:
    standard: @{CppCoreGuidelines}
    ruleId: T.40
    title: Use function objects to pass operations to algorithms
    statement:
        Pass lambdas or other function objects to algorithms instead of
        pointers to functions.
    rationale:
        A function object can carry data such as a threshold and is usually
        easier to inline, so it is both more flexible and typically faster
        than a function pointer.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        bool over_limit(int x) { return x > 100; }

        auto it = std::find_if(v.begin(), v.end(), over_limit);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int limit = read_limit();
        auto it = std::find_if(v.begin(), v.end(),
                               [limit](int x) { return x > limit; });
        \\\
        ```
    languages: [cpp]
    tags: [templates, algorithms, performance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-fo
