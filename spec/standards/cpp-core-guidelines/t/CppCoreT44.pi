use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT44:
    standard: @{CppCoreGuidelines}
    ruleId: T.44
    title: Let function templates deduce class template arguments where possible
    statement:
        Let the compiler deduce template arguments, either through class template
        argument deduction or a make function, instead of writing them out when they
        follow from the arguments.
    rationale:
        Explicit template arguments are tedious, clutter the code and are easy to
        get subtly wrong.
    exceptions:
        Write them out when deduction cannot produce what you need or when you want
        a type that differs from the initializers, such as an empty list of
        pointers.
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::pair<std::string, int> entry = std::pair<std::string, int>("port"s, 8080);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        auto entry = std::make_pair("port"s, 8080);
        std::pair other("host"s, 443);
        \\\
        ```
    languages: [cpp]
    tags: [templates, type-deduction, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-deduce
