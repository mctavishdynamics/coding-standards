use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT64:
    standard: @{CppCoreGuidelines}
    ruleId: T.64
    title: Provide alternative class template implementations through specialization
    statement:
        When certain template arguments need a different implementation, write a
        specialization of the class template that presents the same interface.
    rationale:
        The primary template defines what the interface is. Specialization is the
        tool for providing other implementations of that interface for particular
        types.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename T>
        class Flags {
            std::vector<T> bits;
        };

        class Bool_flags {          // separate name, separate interface
            std::vector<std::uint64_t> words;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<typename T>
        class Flags {
            std::vector<T> bits;
        };

        template<>
        class Flags<bool> {         // same interface, packed storage
            std::vector<std::uint64_t> words;
        };
        \\\
        ```
    languages: [cpp]
    tags: [templates, specialization]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-specialization
