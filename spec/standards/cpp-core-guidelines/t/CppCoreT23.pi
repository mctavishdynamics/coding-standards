use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT23:
    standard: @{CppCoreGuidelines}
    ruleId: T.23
    title: Tell a refined concept apart by the extra operations it needs
    statement:
        Ensure a refined concept requires at least one operation that its base
        concept does not, so the two can be told apart.
    rationale:
        The compiler decides which concept is more specific by comparing their
        requirements. If two concepts require exactly the same things, overload
        resolution sees them as the same concept.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename B>
        concept Buffer = requires(B b) { b.data(); b.size(); };
        template<typename B>
        concept Growable_buffer = requires(B b) { b.data(); b.size(); };  // nothing extra
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<typename B>
        concept Buffer = requires(B b) { b.data(); b.size(); };
        template<typename B>
        concept Growable_buffer = Buffer<B> && requires(B b, std::size_t n) { b.resize(n); };
        \\\
        ```
    languages: [cpp]
    tags: [templates, concepts, overloading]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-refine
