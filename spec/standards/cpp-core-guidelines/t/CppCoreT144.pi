use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT144:
    standard: @{CppCoreGuidelines}
    ruleId: T.144
    title: Overload function templates instead of specializing them
    statement:
        To customize a function template for certain types, add an overload instead
        of writing a specialization.
    rationale:
        The language forbids partial specialization of function templates. Full
        specializations are skipped during overload resolution, so they often do not
        get called when you expect.
    exceptions:
        If you really need specialization, forward from the function template to a
        class template and specialize that class, partially if you like.
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename T>
        std::string to_text(const T& v);

        template<>
        std::string to_text<bool>(const bool& v);   // specialization
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<typename T>
        std::string to_text(const T& v);

        std::string to_text(bool v);                // overload
        \\\
        ```
    languages: [cpp]
    tags: [templates, specialization, overloading]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-specialize-function
