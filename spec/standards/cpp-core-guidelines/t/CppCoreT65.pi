use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT65:
    standard: @{CppCoreGuidelines}
    ruleId: T.65
    title: Pick alternative function implementations through tag dispatch
    statement:
        Choose among implementations of a function at compile time by passing a tag
        type that reflects a property of the argument type. In C++20, constrained
        overloads can make the same choice directly.
    rationale:
        The caller sees a single general interface, while types with special
        properties get a faster implementation. The selection happens during
        compilation and costs nothing at run time.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename It>
        void advance_by(It& it, int n)
        {
            while (n-- > 0) ++it;   // linear even for random-access iterators
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<typename It>
        void advance_by(It& it, int n, std::random_access_iterator_tag) { it += n; }

        template<typename It>
        void advance_by(It& it, int n, std::input_iterator_tag) { while (n-- > 0) ++it; }

        template<typename It>
        void advance_by(It& it, int n)
        {
            advance_by(it, n, typename std::iterator_traits<It>::iterator_category{});
        }
        \\\
        ```
    languages: [cpp]
    tags: [templates, tag-dispatch, performance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-tag-dispatch
