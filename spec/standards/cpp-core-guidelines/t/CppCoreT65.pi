use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT65:
    standard: @{CppCoreGuidelines}
    ruleId: T.65
    title: Use tag dispatch to provide alternative implementations of a function
    statement:
        Select between implementations of a function at compile time by
        passing a tag type derived from a property of the argument type. In
        C++20, constrained overloads can do the same directly.
    rationale:
        It keeps one general interface while choosing a faster
        implementation for types with special properties, with no run-time
        cost.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename It>
        void advance_by(It& it, int n)
        {
            while (n-- > 0) ++it;   // linear even for random-access iterators
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<typename It>
        void advance_by(It& it, int n, std::random_access_iterator_tag) { it += n; }

        template<typename It>
        void advance_by(It& it, int n, std::input_iterator_tag) { while (n-- > 0) ++it; }

        template<typename It>
        void advance_by(It& it, int n)
        {
            advance_by(it, n, typename std::iterator_traits<It>::iterator_category{});
        }
        \\\
        ```
    languages: [cpp]
    tags: [templates, tag-dispatch, performance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-tag-dispatch
