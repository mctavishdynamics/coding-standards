use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT150:
    standard: @{CppCoreGuidelines}
    ruleId: T.150
    title: Verify that a type meets a concept with a static assertion
    statement:
        If a class is intended to model a concept, write a static_assert that checks
        it right after the class definition.
    rationale:
        The assertion reports a missing or wrong operation where the class is
        written. Otherwise the problem shows up later as a puzzling template error
        in some user's code.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Token {
        public:
            Token(const Token&) = default;
            Token& operator=(const Token&) = default;
            // forgot the move operations; users find out later
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Token {
        public:
            Token(const Token&) = default;
            Token& operator=(const Token&) = default;
        };

        static_assert(std::copyable<Token>);
        \\\
        ```
    languages: [cpp]
    tags: [templates, concepts, testing]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-check-class
