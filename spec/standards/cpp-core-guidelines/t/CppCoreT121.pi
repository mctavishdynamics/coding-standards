use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT121:
    standard: @{CppCoreGuidelines}
    ruleId: T.121
    title: Use metaprogramming mainly to stand in for concepts
    statement:
        When the language version lacks concepts, use metaprogramming chiefly to
        imitate them, for example by selecting overloads with enable_if on a type
        property.
    rationale:
        Picking an overload according to what a type can do is the most frequent and
        simplest reason to use metaprogramming. Native concepts make that same task
        much easier once they are available.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```cpp
        \\\
        template<typename T>
        std::enable_if_t<std::is_floating_point_v<T>, bool> nearly_equal(T a, T b)
        {
            return std::abs(a - b) <= std::numeric_limits<T>::epsilon() * 4;
        }

        template<typename T>
        std::enable_if_t<std::is_integral_v<T>, bool> nearly_equal(T a, T b)
        {
            return a == b;
        }
        \\\
        ```
    languages: [cpp]
    tags: [templates, metaprogramming, concepts]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-emulate
