use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT121:
    standard: @{CppCoreGuidelines}
    ruleId: T.121
    title: Use template metaprogramming primarily to emulate concepts
    statement:
        Where concepts are not available, the main legitimate use of
        metaprogramming is emulating them, for example overloading on
        iterator category with enable_if.
    rationale:
        Overloading on concepts is one of the most common and simplest needs
        for metaprogramming, and it becomes much simpler once real concepts
        are available.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```cpp
        \\\
        template<typename It>
        std::enable_if_t<is_random_access_v<It>> skip(It& it, int n) { it += n; }

        template<typename It>
        std::enable_if_t<!is_random_access_v<It>> skip(It& it, int n)
        {
            while (n-- > 0) ++it;
        }
        \\\
        ```
    languages: [cpp]
    tags: [templates, metaprogramming, concepts]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-emulate
