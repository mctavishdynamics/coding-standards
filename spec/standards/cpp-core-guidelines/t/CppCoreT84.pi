use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT84:
    standard: @{CppCoreGuidelines}
    ruleId: T.84
    title: Put a non-template core under a template interface for ABI stability
    statement:
        Do the real work in a non-template core class and make the template a thin,
        type-safe layer on top of it.
    rationale:
        The core is compiled once and its layout does not change from one
        instantiation to another. That keeps the ABI stable and avoids generating
        the same code for every type.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename T>
        class Registry {
            std::unordered_map<std::string, T*> items;   // all lookup code per T
        public:
            void add(const std::string& key, T* obj);
            T* get(const std::string& key) const;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Registry_base {
        protected:
            void put(const std::string& key, void* obj);   // compiled once
            void* find(const std::string& key) const;
        private:
            std::unordered_map<std::string, void*> items;
        };

        template<typename T>
        class Registry : Registry_base {
        public:
            void add(const std::string& key, T* obj) { put(key, obj); }
            T* get(const std::string& key) const { return static_cast<T*>(find(key)); }
        };
        \\\
        ```
    languages: [cpp]
    tags: [templates, abi, code-size]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-abi
