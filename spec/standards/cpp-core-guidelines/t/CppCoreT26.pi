use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT26:
    standard: @{CppCoreGuidelines}
    ruleId: T.26
    title: Describe concepts by how values are used, not by bare syntax
    statement:
        Define a concept through a requires expression that shows how values of the
        type are used, not as a list of has-this-operator traits joined together.
    rationale:
        The use patterns look like the code callers will write, and they
        automatically allow for conversions. Readers also do not need to know the
        names of a dozen helper traits.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename T>
        concept Ordered = has_less_v<T> && has_greater_v<T>;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<typename T>
        concept Ordered = requires(const T& lhs, const T& rhs) {
            { lhs < rhs } -> std::same_as<bool>;
            { lhs > rhs } -> std::same_as<bool>;
        };
        \\\
        ```
    languages: [cpp]
    tags: [templates, concepts, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-use
