use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT48:
    standard: @{CppCoreGuidelines}
    ruleId: T.48
    title: Emulate missing concept support with enable_if
    statement:
        If your compiler has no concepts, use enable_if to limit which types a
        template accepts and to choose between overloads. Switch to real concepts
        once they are available.
    rationale:
        In older C++ this is the closest substitute for concepts. It lets a template
        exist only for suitable arguments, but it tends to produce pairs of
        complementary conditions, which T.25 warns about.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename T>
        T gcd(T a, T b);       // accepts double, std::string, ...
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<typename T>
        std::enable_if_t<std::is_integral_v<T>, T>
        gcd(T a, T b);         // integral types only
        \\\
        ```
    languages: [cpp]
    tags: [templates, concepts, compatibility]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-concept-def
