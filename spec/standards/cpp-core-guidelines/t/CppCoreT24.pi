use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT24:
    standard: @{CppCoreGuidelines}
    ruleId: T.24
    title: Separate concepts that differ only in meaning with tags or traits
    statement:
        When two concepts have identical syntactic requirements but different
        meanings, add a trait or tag that a type must explicitly opt into, so the
        compiler can distinguish them.
    rationale:
        Syntax alone cannot capture a difference in meaning. Unless the author makes
        the distinction explicit, every type that meets the shared syntax matches
        both concepts and calls become ambiguous.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename R>
        concept Sequence = std::ranges::forward_range<R>;
        template<typename R>
        concept Sorted_sequence = std::ranges::forward_range<R>;   // indistinguishable
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<typename R>
        inline constexpr bool declares_sorted = false;   // specialized by sorted types

        template<typename R>
        concept Sorted_sequence = std::ranges::forward_range<R> && declares_sorted<R>;
        \\\
        ```
    languages: [cpp]
    tags: [templates, concepts, traits]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-tag
