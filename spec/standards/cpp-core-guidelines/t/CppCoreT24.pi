use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT24:
    standard: @{CppCoreGuidelines}
    ruleId: T.24
    title: Use tag classes or traits to differentiate concepts that differ only in semantics
    statement:
        When two concepts need the same syntax but mean different things,
        separate them with a trait or tag the type must opt into.
    rationale:
        Concepts with the same syntactic requirements and different
        semantics are ambiguous unless the programmer marks the difference
        explicitly.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename I>
        concept Random_iter = std::random_access_iterator<I>;

        template<typename I>
        concept Contiguous_iter = std::random_access_iterator<I>;  // ambiguous
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<typename I>
        inline constexpr bool is_contiguous_v = false;   // specialized per iterator

        template<typename I>
        concept Contiguous_iter = std::random_access_iterator<I>
                                  && is_contiguous_v<I>;
        \\\
        ```
    languages: [cpp]
    tags: [templates, concepts, traits]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-tag
