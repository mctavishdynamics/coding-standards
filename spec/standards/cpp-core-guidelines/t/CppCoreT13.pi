use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT13:
    standard: @{CppCoreGuidelines}
    ruleId: T.13
    title: Write simple one-parameter constraints in the short form
    statement:
        If one type parameter needs exactly one concept, put the concept in the
        template parameter list or write a constrained auto parameter. Save requires
        clauses for harder cases.
    rationale:
        The short form reads naturally and says just what is meant. It often removes
        the template line entirely.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename N>
            requires std::integral<N>
        N round_up(N value, N step);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<std::integral N>
        N round_up(N value, N step);
        \\\
        ```
    languages: [cpp]
    tags: [templates, concepts, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-shorthand
