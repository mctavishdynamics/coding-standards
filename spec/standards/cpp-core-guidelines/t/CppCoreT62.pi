use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT62:
    standard: @{CppCoreGuidelines}
    ruleId: T.62
    title: Move members that ignore template parameters into a non-template base
    statement:
        Move members of a class template that depend on none of its parameters into
        a base class that is not a template.
    rationale:
        Code can then use those members without naming any template arguments and
        without causing the template to be instantiated.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename T>
        class Queue {
        public:
            enum class Status { ok, full, closed };
            Status push(T value);
        };

        Queue<int>::Status s = Queue<int>::Status::ok;   // needs a T
        \\\
        ```
    compliant:
        ```cpp
        \\\
        struct Queue_base {
            enum class Status { ok, full, closed };
        };

        template<typename T>
        class Queue : public Queue_base {
        public:
            Status push(T value);
        };

        Queue_base::Status s = Queue_base::Status::ok;
        \\\
        ```
    languages: [cpp]
    tags: [templates, code-size, design]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-nondependent
