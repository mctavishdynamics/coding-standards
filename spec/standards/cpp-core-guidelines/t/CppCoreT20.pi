use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT20:
    standard: @{CppCoreGuidelines}
    ruleId: T.20
    title: Give every concept a real meaning
    statement:
        Give a concept a semantic meaning, like a range, a number or an ordered
        type, not merely the presence of one operation. Constraints that check a
        single operator are building blocks for real concepts and should not be used
        on their own in user code.
    rationale:
        A single-operation check accepts types that have that operation for
        unrelated reasons. A template meant for one kind of type then compiles for
        another and quietly does the wrong thing.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename R>
        concept Has_begin = requires(R r) { r.begin(); };

        template<Has_begin R>
        auto count_items(R& r)            // also needs end(), and begin() may mean anything
        {
            return std::distance(r.begin(), r.end());
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // Sequence: begin() and end() delimit the elements, traversable more than once
        template<typename R>
        concept Sequence = requires(R r) {
            { r.begin() } -> std::forward_iterator;
            { r.end() } -> std::sentinel_for<decltype(r.begin())>;
        };

        template<Sequence R>
        auto count_items(R& r)
        {
            return std::distance(r.begin(), r.end());
        }
        \\\
        ```
    languages: [cpp]
    tags: [templates, concepts, semantics]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-low
