use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT69:
    standard: @{CppCoreGuidelines}
    ruleId: T.69
    title: Qualify calls in templates unless the call is meant as an extension point
    statement:
        In a template, qualify calls to your own helpers with their namespace, for
        example detail. Make an unqualified call only when it is a deliberate
        customization point that users can supply in their own namespace.
    rationale:
        An unqualified call with a dependent argument goes through
        argument-dependent lookup. Any function of that name in the argument's
        namespaces can then be chosen, unconstrained templates included, so the
        template's behavior shifts with its surroundings.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename T>
        std::string describe(const T& t)
        {
            return format_value(t);   // any format_value near T may be chosen
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        namespace detail {
            template<typename T> std::string format_value(const T&);
        }

        template<typename T>
        std::string describe(const T& t)
        {
            return detail::format_value(t);
        }
        \\\
        ```
    languages: [cpp]
    tags: [templates, name-lookup, customization]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-customization
