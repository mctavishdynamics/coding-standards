use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT10:
    standard: @{CppCoreGuidelines}
    ruleId: T.10
    title: Constrain every template parameter with a concept
    statement:
        Give each template type parameter a concept that says what the template
        expects from it. Fall back to plain typename only when any type at all will
        do.
    rationale:
        What a template assumes about its arguments, in syntax and in meaning,
        belongs to its interface. Writing that down as a concept documents it, and a
        bad argument then produces a short error at the call instead of a long one
        deep inside the instantiation.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename It, typename V>
        It locate(It first, It last, const V& value);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<std::input_iterator It, typename V>
            requires std::equality_comparable_with<std::iter_value_t<It>, V>
        It locate(It first, It last, const V& value);
        \\\
        ```
    languages: [cpp]
    tags: [templates, concepts, interfaces]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-concepts
