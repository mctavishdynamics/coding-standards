use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT100:
    standard: @{CppCoreGuidelines}
    ruleId: T.100
    title: Use a variadic template for a variable number of mixed-type arguments
    statement:
        Write a variadic template when a function must take a varying number of
        arguments of varying types. Do not use the C ellipsis.
    rationale:
        A parameter pack handles any mix of argument types, keeps full type checking
        and adds no run-time overhead. With va_arg the compiler checks nothing, and
        a mismatch is undefined behavior.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void log_values(const char* fmt, ...)
        {
            va_list args;
            va_start(args, fmt);
            int n = va_arg(args, int);   // trusts the caller
            va_end(args);
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<typename... Args>
        void log_values(const Args&... args)
        {
            ((std::clog << args << ' '), ...);
            std::clog << '\n';
        }
        \\\
        ```
    languages: [cpp]
    tags: [templates, variadic, type-safety]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-variadic
