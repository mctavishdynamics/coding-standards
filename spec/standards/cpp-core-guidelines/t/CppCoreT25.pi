use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT25:
    standard: @{CppCoreGuidelines}
    ruleId: T.25
    title: Avoid pairs of constraints that are exact negations of each other
    statement:
        Do not provide one overload for a constraint and another for its negation.
        Write a general template plus a more constrained one, or a deleted general
        template when there is no sensible fallback.
    rationale:
        Overload resolution already picks the more constrained candidate, so the
        negation adds nothing. It is fragile, and once several constraints are
        involved the number of negated combinations to keep in sync grows very fast.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename T> requires (!Hashable<T>)
        void index(const T&);

        template<typename T> requires Hashable<T>
        void index(const T&);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<typename T>
        void index(const T&);          // general fallback

        template<typename T> requires Hashable<T>
        void index(const T&);          // chosen when Hashable holds
        \\\
        ```
    languages: [cpp]
    tags: [templates, concepts, overloading]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-not
