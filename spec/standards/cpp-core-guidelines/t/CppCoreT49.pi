use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT49:
    standard: @{CppCoreGuidelines}
    ruleId: T.49
    title: Avoid type erasure where possible
    statement:
        Prefer templates or a plain interface to hiding types behind a type-erasing
        wrapper, unless you need what the erasure provides.
    rationale:
        Erasure adds an indirection and an indirect call on every use. The concrete
        type disappears from the compiler's view, so the call cannot be inlined and
        runs slower.
    exceptions:
        Sometimes erasure is exactly right, for example std::function for storing
        arbitrary callables.
    severity: null
    noncompliant:
        ```cpp
        \\\
        int apply_twice(std::function<int(int)> f, int x)  // called with fixed lambdas
        {
            return f(f(x));
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int apply_twice(std::invocable<int> auto f, int x)
        {
            return f(f(x));
        }
        \\\
        ```
    languages: [cpp]
    tags: [templates, performance, type-erasure]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-erasure
