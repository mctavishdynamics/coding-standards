use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT80:
    standard: @{CppCoreGuidelines}
    ruleId: T.80
    title: Think before turning a class hierarchy into a template
    statement:
        Think twice before turning a class hierarchy with many virtual functions
        into a template. Where possible, keep the virtual interface in a
        non-template class.
    rationale:
        Every virtual function of every instantiation has to be generated, because
        the compiler cannot know which ones will be called. This multiplies code
        size.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename Msg>
        class Channel {
        public:
            virtual void send(const Msg& m);
            virtual void close();             // all generated for every Msg
            virtual void reconnect();
            virtual void report_stats();
            virtual ~Channel();
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Channel_base {
        public:
            virtual void close() = 0;         // generated once
            virtual void reconnect() = 0;
            virtual ~Channel_base() = default;
        };

        template<typename Msg>
        class Channel : public Channel_base {
        public:
            void send(const Msg& m);          // non-virtual, only built if used
        };
        \\\
        ```
    languages: [cpp]
    tags: [templates, inheritance, code-size]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-hier
