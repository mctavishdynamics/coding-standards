use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT2:
    standard: @{CppCoreGuidelines}
    ruleId: T.2
    title: Write algorithms as templates that work for many types
    statement:
        If an algorithm makes sense for many types, write a single template for it
        rather than one copy per type. Do not turn code into a template if it will
        only ever be used with one type.
    rationale:
        One generic version means less source, better interoperation and more reuse.
        The STL is built entirely on this idea.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int max_of(const std::vector<int>& v);
        double max_of(const std::vector<double>& v);
        long max_of(const std::vector<long>& v);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<std::ranges::forward_range R>
            requires std::totally_ordered<std::ranges::range_value_t<R>>
        auto max_of(const R& r)
        {
            return *std::ranges::max_element(r);
        }
        \\\
        ```
    languages: [cpp]
    tags: [templates, algorithms, generic-programming]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-algo
