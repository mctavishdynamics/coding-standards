use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT1:
    standard: @{CppCoreGuidelines}
    ruleId: T.1
    title: Write templates to make code more abstract and general
    statement:
        Constrain a template by a concept that names a real idea, such as an ordered
        type or a number, rather than by the one operator the current body happens
        to call.
    rationale:
        Templates written at that level serve many types, are easy to reuse and cost
        nothing at run time. They also nudge authors of user types to supply a full,
        consistent set of operations. Requiring a single operator ties callers to
        implementation details and blocks later generalization.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename T>
            requires requires(T a, T b) { a < b; }   // one operator, no meaning
        const T& largest(const std::vector<T>& v)
        {
            return *std::max_element(v.begin(), v.end());
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<std::totally_ordered T>          // a real notion: ordered values
        const T& largest(const std::vector<T>& v)
        {
            return *std::max_element(v.begin(), v.end());
        }
        \\\
        ```
    languages: [cpp]
    tags: [templates, generic-programming, concepts]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-raise
