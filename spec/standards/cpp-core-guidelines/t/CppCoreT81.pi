use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT81:
    standard: @{CppCoreGuidelines}
    ruleId: T.81
    title: Keep inheritance hierarchies and arrays apart
    statement:
        Never pass an array of derived objects to a function that takes a pointer to
        the base class. Use a typed container or span instead.
    rationale:
        The array converts silently to a base pointer. Indexing then steps by the
        size of the base class and lands inside objects, and assigning through it
        can put the wrong type into the array.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void reset_all(Shape* shapes, int n)
        {
            for (int i = 0; i != n; ++i) shapes[i].reset();
        }

        Circle circles[8];
        reset_all(circles, 8);    // wrong stride when sizeof(Circle) != sizeof(Shape)
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void reset_all(std::span<Circle> circles)
        {
            for (auto& c : circles) c.reset();
        }

        std::vector<Circle> circles(8);
        reset_all(circles);
        \\\
        ```
    languages: [cpp]
    tags: [inheritance, arrays, type-safety]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-array
