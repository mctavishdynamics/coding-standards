use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT60:
    standard: @{CppCoreGuidelines}
    ruleId: T.60
    title: Keep templates independent of their surrounding context
    statement:
        A template should depend on its arguments and on names it qualifies on
        purpose. It should not pick up helper functions, types or variables that
        merely happen to be visible where it is defined or used.
    rationale:
        Hidden dependencies make templates harder to understand and to analyse with
        tools. Templates usually live in headers, so such dependencies can change
        meaning with include order and cause surprising errors.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename It>
        void normalize(It first, It last)
        {
            for (; first != last; ++first)
                *first = scale(*first);   // which scale? found from the context
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<typename It, typename F>
        void normalize(It first, It last, F scale)
        {
            for (; first != last; ++first)
                *first = scale(*first);
        }
        \\\
        ```
    languages: [cpp]
    tags: [templates, dependencies, headers]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-depend
