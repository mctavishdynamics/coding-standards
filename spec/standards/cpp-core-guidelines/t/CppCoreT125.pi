use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT125:
    standard: @{CppCoreGuidelines}
    ruleId: T.125
    title: If you need to go beyond the standard-library TMP facilities, use an existing library
    statement:
        When the standard metaprogramming tools are not enough, use an
        established metaprogramming library. Write your own advanced support
        only if you really must.
    rationale:
        Advanced metaprogramming facilities are hard to build well, and an
        existing library brings a tested design and a community of users.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [templates, metaprogramming, libraries]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-lib
