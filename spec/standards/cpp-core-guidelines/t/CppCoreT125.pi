use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT125:
    standard: @{CppCoreGuidelines}
    ruleId: T.125
    title: Use an established metaprogramming library when the standard one falls short
    statement:
        If the standard metaprogramming facilities do not go far enough, adopt a
        mature metaprogramming library. Build advanced support of your own only as a
        last resort.
    rationale:
        Good advanced metaprogramming tools are hard to design. A library that many
        people use comes with tested code and people who can help.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [templates, metaprogramming, libraries]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-lib
