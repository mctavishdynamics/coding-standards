use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT83:
    standard: @{CppCoreGuidelines}
    ruleId: T.83
    title: Never make a member function template virtual
    statement:
        Do not try to declare a member function template virtual. Choose the
        function another way, for example with double dispatch, a visitor or a set
        of ordinary virtual overloads.
    rationale:
        The language forbids it. Allowing it would mean the full set of virtual
        functions is only known at link time, which conflicts with how vtables are
        built and with dynamic linking. The rule is stated because people keep
        reaching for it.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Serializer {
        public:
            template<typename T>
            virtual void write(const T& value);   // error
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Serializer {
        public:
            virtual void write(int value) = 0;
            virtual void write(const std::string& value) = 0;
            virtual ~Serializer() = default;
        };
        \\\
        ```
    languages: [cpp]
    tags: [templates, virtual-functions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-virtual
