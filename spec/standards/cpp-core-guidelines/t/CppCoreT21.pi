use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT21:
    standard: @{CppCoreGuidelines}
    ruleId: T.21
    title: Make a concept require a whole coherent set of operations
    statement:
        Have a concept require a complete, coherent group of operations, for
        instance every comparison operator, and design classes the same way. Avoid
        picking out an arbitrary few.
    rationale:
        A complete set is easier to understand and to implement, and types that
        provide it work together better. Partial sets lead to surprises such as a
        type where less-than compiles but greater-or-equal does not.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename T>
        concept Has_less = requires(T a, T b) { a < b; };   // a lone operator
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<typename T>
        concept Fully_comparable = requires(const T& a, const T& b) {
            a == b; a != b;
            a < b; a > b; a <= b; a >= b;
        };
        \\\
        ```
    languages: [cpp]
    tags: [templates, concepts, operators]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-complete
