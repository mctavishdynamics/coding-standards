use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT124:
    standard: @{CppCoreGuidelines}
    ruleId: T.124
    title: Use the standard type traits before writing your own
    statement:
        Use what namespace std already provides, such as conditional, enable_if, the
        type traits and tuple, before building your own metaprogramming tools.
    rationale:
        The standard facilities work on every conforming compiler, and other
        programmers already know them.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename T> struct my_remove_ref      { using type = T; };
        template<typename T> struct my_remove_ref<T&>  { using type = T; };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<typename T>
        using Plain = std::remove_cvref_t<T>;
        \\\
        ```
    languages: [cpp]
    tags: [templates, metaprogramming, standard-library]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-std-tmp
