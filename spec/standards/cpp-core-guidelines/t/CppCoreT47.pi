use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT47:
    standard: @{CppCoreGuidelines}
    ruleId: T.47
    title: Do not give widely visible unconstrained templates common names
    statement:
        Do not place an unconstrained template with a common name, such as a
        catch-all operator== or a generic print, in a namespace that also defines
        ordinary types.
    rationale:
        An unconstrained template matches any argument exactly. Through
        argument-dependent lookup it can win against a more fitting function that
        needs a minor conversion, and the program quietly calls the wrong code.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        namespace geo {
            struct Point { int x, y; };

            template<typename A, typename B>
            bool operator==(const A&, const B&) { return false; }  // matches anything
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        namespace geo {
            struct Point { int x, y; };

            bool operator==(const Point& a, const Point& b)
            {
                return a.x == b.x && a.y == b.y;
            }
        }
        \\\
        ```
    languages: [cpp]
    tags: [templates, overloading, namespaces]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-visible
