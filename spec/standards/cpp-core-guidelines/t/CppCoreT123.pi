use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT123:
    standard: @{CppCoreGuidelines}
    ruleId: T.123
    title: Compute values during compilation with constexpr functions
    statement:
        Write compile-time value calculations as constexpr functions, not as
        recursive template metaprograms.
    rationale:
        A constexpr function looks like any other function, with loops and local
        variables, so it is far easier to read. It also tends to compile faster than
        the equivalent recursive templates.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<int B, int E>
        struct Power { static constexpr int value = B * Power<B, E - 1>::value; };
        template<int B>
        struct Power<B, 0> { static constexpr int value = 1; };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        constexpr int power(int base, int exp)
        {
            int result = 1;
            while (exp-- > 0) result *= base;
            return result;
        }

        constexpr int kb = power(2, 10);
        \\\
        ```
    languages: [cpp]
    tags: [templates, constexpr, metaprogramming]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-fct
