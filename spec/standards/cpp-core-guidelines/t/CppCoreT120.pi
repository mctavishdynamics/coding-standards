use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT120:
    standard: @{CppCoreGuidelines}
    ruleId: T.120
    title: Use template metaprogramming only when nothing simpler works
    statement:
        Only resort to template metaprogramming when it is clearly better than every
        simpler option. Concepts usually express constraints better, and constexpr
        functions usually compute values better.
    rationale:
        Metaprograms are tricky to write correctly, make builds slow and are a
        burden to maintain. In rare cases they do give the fastest code or the
        clearest expression of an idea, but wrapping them in macros is a warning
        sign that things have gone too far.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<unsigned N>
        struct Factorial { static constexpr unsigned value = N * Factorial<N - 1>::value; };
        template<>
        struct Factorial<0> { static constexpr unsigned value = 1; };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        constexpr unsigned factorial(unsigned n)
        {
            return n == 0 ? 1 : n * factorial(n - 1);
        }
        \\\
        ```
    languages: [cpp]
    tags: [templates, metaprogramming, maintainability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-metameta
