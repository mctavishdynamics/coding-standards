use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT61:
    standard: @{CppCoreGuidelines}
    ruleId: T.61
    title: Do not make members depend on template parameters they do not use
    statement:
        Make each member type or function of a class template depend only on the
        template parameters it actually uses. Move members that ignore some
        parameters into a separate, smaller template.
    rationale:
        A member that is tied to a parameter it does not need is generated again for
        every combination of arguments, and cannot be shared between instantiations
        that differ only in that parameter. Code grows and reuse suffers.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename K, typename Compare = std::less<K>>
        class Counter {
        public:
            struct Entry { K key; int count; };   // ignores Compare, yet tied to it
            const Entry* top() const;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<typename K>
        struct Counter_entry { K key; int count; };

        template<typename K, typename Compare = std::less<K>>
        class Counter {
        public:
            using Entry = Counter_entry<K>;      // shared across comparators
            const Entry* top() const;
        };
        \\\
        ```
    languages: [cpp]
    tags: [templates, code-size, design]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-scary
