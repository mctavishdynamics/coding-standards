use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT68:
    standard: @{CppCoreGuidelines}
    ruleId: T.68
    title: Use braces in templates to avoid parsing ambiguity
    statement:
        In template code, initialize with braces rather than parentheses, and avoid
        function-style casts of dependent types.
    rationale:
        Parentheses can be parsed in surprising ways, for example as a function
        declaration where a variable was intended. A function-style cast may also
        perform a dangerous conversion that braces would reject.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename T, typename Source>
        T convert(Source s)
        {
            T result();     // declares a function returning T
            return T(s);    // may silently act as a C-style cast
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<typename T, typename Source>
        T convert(Source s)
        {
            T result{s};    // a variable; narrowing is rejected
            return result;
        }
        \\\
        ```
    languages: [cpp]
    tags: [templates, initialization]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-cast
