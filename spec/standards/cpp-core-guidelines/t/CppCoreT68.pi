use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT68:
    standard: @{CppCoreGuidelines}
    ruleId: T.68
    title: Use \ {} \ rather than () within templates to avoid ambiguities
    statement:
        Inside templates, initialize objects with braces instead of
        parentheses, and avoid function-style casts of dependent types.
    rationale:
        Parenthesized initialization is open to grammar ambiguities, such as
        a declaration being parsed as a function, and a function-style cast
        can hide a dangerous conversion.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename T, typename U>
        void store(U u)
        {
            T item(T(u));       // declares a function, not a variable
            auto copy = T(u);   // construction or C-style cast?
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<typename T, typename U>
        void store(U u)
        {
            T item{u};          // clearly a variable
        }
        \\\
        ```
    languages: [cpp]
    tags: [templates, initialization]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-cast
