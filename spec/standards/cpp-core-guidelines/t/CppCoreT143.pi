use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT143:
    standard: @{CppCoreGuidelines}
    ruleId: T.143
    title: Avoid needlessly restricting generic code
    statement:
        Choose the most general form that does the job in generic code. Compare
        iterators with != rather than less-than, call empty() rather than checking
        size() against zero, and take the least-derived type that offers the needed
        operations.
    rationale:
        Depending on details the algorithm does not need cuts down the types and
        containers it can be used with, and so makes the code less reusable.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void print_all(const Derived_logger& log)   // uses only Logger members
        {
            for (auto it = log.begin(); it < log.end(); ++it)
                std::cout << *it;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void print_all(const Logger& log)
        {
            for (auto it = log.begin(); it != log.end(); ++it)
                std::cout << *it;
        }
        \\\
        ```
    languages: [cpp]
    tags: [generic-programming, reuse]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-non-generic
