use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT143:
    standard: @{CppCoreGuidelines}
    ruleId: T.143
    title: Don't write unintentionally non-generic code
    statement:
        Use the most general facility that does the job, such as comparing
        iterators with != instead of less-than, testing empty() instead of
        size() == 0, and taking the least-derived type that has the needed
        operations.
    rationale:
        Committing to details you do not need limits which types and
        containers the code works with and makes it less reusable.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void print_all(const Derived_logger& log)   // uses only Logger members
        {
            for (auto it = log.begin(); it < log.end(); ++it)
                std::cout << *it;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void print_all(const Logger& log)
        {
            for (auto it = log.begin(); it != log.end(); ++it)
                std::cout << *it;
        }
        \\\
        ```
    languages: [cpp]
    tags: [generic-programming, reuse]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-non-generic
