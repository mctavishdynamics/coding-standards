use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT140:
    standard: @{CppCoreGuidelines}
    ruleId: T.140
    title: Name any operation that might be used again
    statement:
        When the same operation is needed in several spots, now or probably later,
        define it once as a named function or function object instead of repeating
        the same lambda. F.10 says the same.
    rationale:
        A name tells readers what the operation is for. It can be tested by itself,
        and there are no copies left to drift apart.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        auto a = std::count_if(v.begin(), v.end(), [](const Order& o) { return o.total > 1000 && !o.paid; });
        auto b = std::find_if(w.begin(), w.end(), [](const Order& o) { return o.total > 1000 && !o.paid; });
        \\\
        ```
    compliant:
        ```cpp
        \\\
        bool is_large_unpaid(const Order& o) { return o.total > 1000 && !o.paid; }

        auto a = std::count_if(v.begin(), v.end(), is_large_unpaid);
        auto b = std::find_if(w.begin(), w.end(), is_large_unpaid);
        \\\
        ```
    languages: [cpp]
    tags: [functions, lambdas, reuse]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-name
