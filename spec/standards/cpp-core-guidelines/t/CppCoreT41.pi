use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT41:
    standard: @{CppCoreGuidelines}
    ruleId: T.41
    title: Constrain templates only on the properties they truly need
    statement:
        List in a template's constraints only what is essential to its purpose.
        Requirements that come from incidental code, such as debug output or
        logging, should stay out.
    rationale:
        If every operation the body touches becomes part of the interface, the
        interface changes whenever tracing or test support changes, and callers must
        recompile. The price of leaving them out is that a missing helper operation
        is reported later, during instantiation.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<std::ranges::input_range R, typename V>
            requires std::equality_comparable_with<std::ranges::range_value_t<R>, V>
                     && Loggable<V>             // only for a trace message
        bool contains(const R& r, const V& v);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<std::ranges::input_range R, typename V>
            requires std::equality_comparable_with<std::ranges::range_value_t<R>, V>
        bool contains(const R& r, const V& v);   // tracing stays an internal detail
        \\\
        ```
    languages: [cpp]
    tags: [templates, concepts, interfaces]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-essential
