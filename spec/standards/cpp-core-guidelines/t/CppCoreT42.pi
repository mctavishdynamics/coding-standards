use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT42:
    standard: @{CppCoreGuidelines}
    ruleId: T.42
    title: Shorten type spellings and hide details with alias templates
    statement:
        Define alias templates for long dependent type names and to wrap traits, so
        users can write a short, clear name.
    rationale:
        An alias is easier to read and hides how the type is computed or which
        container stores the elements. Many former uses of traits classes are better
        served by an alias.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename K, typename V>
        void dump(const std::map<K, V>& m)
        {
            for (typename std::map<K, V>::const_iterator it = m.begin(); it != m.end(); ++it)
                print(it->first, it->second);
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<typename K, typename V>
        using Map_iter = typename std::map<K, V>::const_iterator;

        template<typename K, typename V>
        void dump(const std::map<K, V>& m)
        {
            for (Map_iter<K, V> it = m.begin(); it != m.end(); ++it)
                print(it->first, it->second);
        }
        \\\
        ```
    languages: [cpp]
    tags: [templates, aliases, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-alias
