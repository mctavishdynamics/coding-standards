use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT103:
    standard: @{CppCoreGuidelines}
    ruleId: T.103
    title: Take same-typed argument lists without a variadic template
    statement:
        When every argument has the same type, accept a std::initializer_list, a
        span or a container instead of a parameter pack.
    rationale:
        Those types say directly that the input is a sequence of one element type.
        The code is shorter to write and simpler to read than pack expansion.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename... Ints>
        int sum_all(Ints... values)
        {
            return (values + ... + 0);
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int sum_all(std::initializer_list<int> values)
        {
            return std::accumulate(values.begin(), values.end(), 0);
        }
        \\\
        ```
    languages: [cpp]
    tags: [templates, variadic, interfaces]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-variadic-not
