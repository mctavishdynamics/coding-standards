use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT22:
    standard: @{CppCoreGuidelines}
    ruleId: T.22
    title: Write down the semantic rules a concept assumes
    statement:
        Document the semantic laws a concept relies on, for example associativity or
        the meaning of equality. Until the language can express axioms, do it in
        comments.
    rationale:
        Writing the laws down makes a concept understandable to readers. The
        exercise of stating them also tends to reveal design mistakes.
    exceptions:
        A concept still being designed may at first list only its syntactic
        requirements while its semantics are worked out. Such a concept can be
        useful, but treat it as provisional.
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename T>
        concept Group_element = requires(T a, T b) { a * b; inverse(a); };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // axioms: (a * b) * c == a * (b * c); a * inverse(a) == identity<T>()
        template<typename T>
        concept Group_element = requires(T a, T b) {
            { a * b } -> std::convertible_to<T>;
            { inverse(a) } -> std::convertible_to<T>;
        };
        \\\
        ```
    languages: [cpp]
    tags: [templates, concepts, semantics]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-axiom
