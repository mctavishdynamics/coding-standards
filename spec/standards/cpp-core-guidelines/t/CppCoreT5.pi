use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT5:
    standard: @{CppCoreGuidelines}
    ruleId: T.5
    title: Mix generic and object-oriented code so each covers the other's weaknesses
    statement:
        Combine templates and class hierarchies so each makes up for what the other
        lacks. For example, let a class template implement a virtual interface, or
        put a generic interface in front of an implementation that dispatches at run
        time.
    rationale:
        The two styles complement each other. Mixed without care they inflate code
        size, because every virtual member of a class template is generated for each
        instantiation even if it is never called.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename T>
        class Store {
        public:
            virtual void save(const T&);     // instantiated for every T
            virtual void export_csv();       // even if never called
            virtual void export_xml();
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Shape {
        public:
            virtual ~Shape() = default;
            virtual double area() const = 0;
        };

        template<typename Geometry>
        class Shape_of : public Shape {
        public:
            double area() const override { return g.area(); }
        private:
            Geometry g;
        };
        \\\
        ```
    languages: [cpp]
    tags: [templates, object-oriented, design]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-generic-oo
