use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT11:
    standard: @{CppCoreGuidelines}
    ruleId: T.11
    title: Choose concepts from the standard library when one fits
    statement:
        Before inventing a concept, check whether the standard library already
        offers it, for example std::sortable or std::totally_ordered, and use that
        one if it does.
    rationale:
        Standard concepts were designed with care that a quick home-made version
        rarely gets, they spare you the design effort, and they make your templates
        work smoothly with other code. Apart from people building new generic
        libraries, most programmers will find what they need already there.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename T>
        concept Same_value = requires(const T& x, const T& y) {
            bool(x == y);
            bool(x != y);
        };
        bool all_same(const std::vector<Same_value auto>& v);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<std::equality_comparable T>
        bool all_same(const std::vector<T>& v);
        \\\
        ```
    languages: [cpp]
    tags: [templates, concepts, standard-library]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-std-concepts
