use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT11:
    standard: @{CppCoreGuidelines}
    ruleId: T.11
    title: Whenever possible use standard concepts
    statement:
        Use the concepts the standard library already provides, such as
        sortable or totally_ordered, before defining your own.
    rationale:
        Standard concepts are better thought out than ones made in a hurry,
        save design work and improve interoperability. Outside new generic
        libraries, most needed concepts already exist.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename T>
        concept Sortable_seq = Sequence<T> && Random_access<Iterator<T>>
                               && Ordered<Value_type<T>>;

        void sort_all(Sortable_seq auto& s);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void sort_all(std::sortable auto& s);
        \\\
        ```
    languages: [cpp]
    tags: [templates, concepts, standard-library]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-std-concepts
