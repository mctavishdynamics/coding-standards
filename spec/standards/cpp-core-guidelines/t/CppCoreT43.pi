use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreT43:
    standard: @{CppCoreGuidelines}
    ruleId: T.43
    title: Define type aliases with using instead of typedef
    statement:
        Write type aliases with using, not typedef.
    rationale:
        In a using declaration the new name comes first instead of being buried
        inside the declarator. The same syntax also works for alias templates, which
        typedef cannot express, and it mirrors the shape of an auto declaration.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        typedef void (*Callback)(int, const char*);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        using Callback = void (*)(int, const char*);

        template<typename T>
        using Handler = void (*)(const T&);
        \\\
        ```
    languages: [cpp]
    tags: [templates, aliases, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rt-using
