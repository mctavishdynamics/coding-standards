use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCorePer4:
    standard: @{CppCoreGuidelines}
    ruleId: Per.4
    title: Do not take for granted that clever code runs faster
    statement:
        Write computations in the plain, direct way. Do not swap in a
        convoluted version on the belief that it will be faster.
    rationale:
        Compilers optimize straightforward loops and obvious intent
        remarkably well, so simple code is often fast. Clever tricks
        frequently run slower and may rely on undefined behavior.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // "Faster" absolute value through bit tricks
        int magnitude(int v)
        {
            int mask = v >> (sizeof(int) * 8 - 1);
            return (v + mask) ^ mask;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int magnitude(int v)
        {
            return std::abs(v);   // compilers emit branch-free code for this
        }
        \\\
        ```
    languages: [cpp]
    tags: [performance, simplicity]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rper-simple
