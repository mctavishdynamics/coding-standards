use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCorePer18:
    standard: @{CppCoreGuidelines}
    ruleId: Per.18
    title: Count memory use as a cost just like time
    statement:
        Treat memory as a performance cost. Keep frequently used data as
        small as possible.
    rationale:
        Most programs spend their time waiting on memory. Each extra byte
        that has to travel to the processor adds to that wait.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        struct Pixel {
            double r, g, b, a;   // 32 bytes per pixel
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        struct Pixel {
            std::uint8_t r, g, b, a;   // 4 bytes per pixel
        };
        \\\
        ```
    languages: [cpp]
    tags: [performance, memory]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rper-space
