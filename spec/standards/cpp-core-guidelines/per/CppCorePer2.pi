use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCorePer2:
    standard: @{CppCoreGuidelines}
    ruleId: Per.2
    title: Do not optimize prematurely
    statement:
        Write clear, correct code first and optimize later, once you know
        where it pays off.
    rationale:
        Heavily optimized code is usually larger and harder to change than
        the plain version, so optimizing early makes the rest of development
        slower.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [performance, optimization]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rper-knuth
