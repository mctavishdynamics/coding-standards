use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCorePer2:
    standard: @{CppCoreGuidelines}
    ruleId: Per.2
    title: Hold off on optimization until it is needed
    statement:
        Get the code clear and correct first. Leave optimization for later,
        when measurements show where it matters.
    rationale:
        Heavily tuned code is usually bigger and harder to modify. Paying
        that price before knowing the hot spots raises the cost of every
        future change while gaining little.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [performance, optimization]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rper-knuth
