use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCorePer19:
    standard: @{CppCoreGuidelines}
    ruleId: Per.19
    title: Lay out and visit memory in a cache-friendly order
    statement:
        Visit data in the order it sits in memory, ideally stepping through
        neighbouring elements one after another. In a row-major array, rows
        go in the outer loop and columns in the inner one.
    rationale:
        Speed depends strongly on how well the cache is used. Caches work
        best with simple sequential reads of adjacent memory.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // order_ids is a shuffled list of every index into prices
        double total = 0;
        for (std::size_t id : order_ids)
            total += prices[id];   // jumps around memory
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // same total, read in storage order
        double total = 0;
        for (double p : prices)
            total += p;
        \\\
        ```
    languages: [cpp]
    tags: [performance, memory, cache]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rper-access
