use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCorePer16:
    standard: @{CppCoreGuidelines}
    ruleId: Per.16
    title: Keep data structures small
    statement:
        Favour compact, contiguous storage such as std::vector or arrays.
        Avoid node-based structures that scatter their elements across the
        heap.
    rationale:
        Run time is usually governed by how long memory accesses take. Data
        packed together makes better use of the cache.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::list<Particle> particles;   // one heap node per element
        for (auto& p : particles) p.advance(dt);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::vector<Particle> particles;   // elements stored next to each other
        for (auto& p : particles) p.advance(dt);
        \\\
        ```
    languages: [cpp]
    tags: [performance, data-structures, memory]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rper-compact
