use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCorePer1:
    standard: @{CppCoreGuidelines}
    ruleId: Per.1
    title: Optimize only with a concrete reason
    statement:
        Start optimizing only when a real performance requirement is not
        being met. Habit and enjoyment do not count as requirements.
    rationale:
        Tuning code that is already fast enough buys nothing. What it does
        bring is new bugs and code that costs more to maintain.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [performance, optimization]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rper-reason
