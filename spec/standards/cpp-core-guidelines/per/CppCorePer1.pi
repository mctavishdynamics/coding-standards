use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCorePer1:
    standard: @{CppCoreGuidelines}
    ruleId: Per.1
    title: Do not optimize without a reason
    statement:
        Optimize only when there is a demonstrated need for better
        performance. Doing it out of habit or for fun is not a reason.
    rationale:
        When no speed-up is needed, the main result of optimization work is
        extra bugs and higher maintenance cost.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [performance, optimization]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rper-reason
