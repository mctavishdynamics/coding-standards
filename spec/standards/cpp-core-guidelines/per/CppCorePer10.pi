use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCorePer10:
    standard: @{CppCoreGuidelines}
    ruleId: Per.10
    title: Let the type system carry information for the optimizer
    statement:
        Let types describe your data. Stay away from void pointers, type
        punning and byte-by-byte handling of objects where a typed interface
        is available.
    rationale:
        The optimizer relies on type information, and weak typing or raw
        memory tricks take that away. Plain, well-typed code tends to be
        compiled into faster machine code than elaborate hand-tuned
        versions.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void scale(void* data, std::size_t count, double factor)
        {
            auto* p = static_cast<double*>(data);
            for (std::size_t i = 0; i < count; ++i) p[i] *= factor;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void scale(std::span<double> data, double factor)
        {
            for (double& x : data) x *= factor;
        }
        \\\
        ```
    languages: [cpp]
    tags: [performance, type-safety]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rper-type
