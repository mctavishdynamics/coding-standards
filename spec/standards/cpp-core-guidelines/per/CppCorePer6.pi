use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCorePer6:
    standard: @{CppCoreGuidelines}
    ruleId: Per.6
    title: Back every performance claim with measurements
    statement:
        Do not claim that something is fast or slow without measuring it.
        Use a profiler to locate the critical code, and if the whole system
        cannot be measured, at least benchmark its key operations.
    rationale:
        Intuitions about performance are frequently wrong. Modern processors
        and optimizers behave in ways that surprise even experienced
        engineers, and much common wisdom on the subject is myth.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```cpp
        \\\
        auto start = std::chrono::steady_clock::now();
        rebuild_index(records);
        auto elapsed = std::chrono::steady_clock::now() - start;
        std::cout << "rebuild_index: "
                  << std::chrono::duration_cast<std::chrono::milliseconds>(elapsed).count()
                  << " ms\n";
        \\\
        ```
    languages: [cpp]
    tags: [performance, measurement]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rper-measure
