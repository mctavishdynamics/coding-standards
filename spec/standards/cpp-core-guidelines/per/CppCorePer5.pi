use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCorePer5:
    standard: @{CppCoreGuidelines}
    ruleId: Per.5
    title: Do not take for granted that low-level code beats high-level code
    statement:
        Do not abandon standard containers and algorithms for raw pointers,
        hand-managed memory or byte fiddling merely on the expectation of
        speed.
    rationale:
        Low-level code can obscure what is going on and prevent the compiler
        from optimizing. Higher-level code often gives it more to exploit,
        with surprisingly good results.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int total(const int* data, int n)
        {
            int sum = 0;
            const int* end = data + n;
            while (data != end) sum += *data++;
            return sum;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int total(const std::vector<int>& values)
        {
            return std::accumulate(values.begin(), values.end(), 0);
        }
        \\\
        ```
    languages: [cpp]
    tags: [performance, abstraction]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rper-low
