use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCorePer11:
    standard: @{CppCoreGuidelines}
    ruleId: Per.11
    title: Shift work from run time to compile time
    statement:
        If a value depends only on constants, have the compiler work it out
        through constexpr functions and variables, or choose between types
        at compile time. Do not go to extremes trying to move everything
        there.
    rationale:
        Work done during compilation costs nothing at run time and needs no
        dynamic initialization. The result is a constant, so threads cannot
        race on it, and some mistakes are caught as compile errors instead
        of needing handling code.
    exceptions:
        Pushing large amounts of computation into compile time can lengthen
        builds a great deal and make debugging harder. In rare cases it even
        makes the program slower, so use it in moderation.
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::array<std::uint32_t, 32> powers;
        void init_powers()   // must be called before first use
        {
            for (int i = 0; i < 32; ++i) powers[i] = 1u << i;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        constexpr auto make_powers()
        {
            std::array<std::uint32_t, 32> t{};
            for (int i = 0; i < 32; ++i) t[i] = 1u << i;
            return t;
        }
        constexpr auto powers = make_powers();   // built by the compiler
        \\\
        ```
    languages: [cpp]
    tags: [performance, constexpr, compile-time]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rper-comp
