use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCorePer3:
    standard: @{CppCoreGuidelines}
    ruleId: Per.3
    title: Do not optimize code that is not performance critical
    statement:
        Spend optimization effort only on the parts of a program that
        dominate its running time. A program that mostly waits for the
        network or a user gains little from faster in-memory computation.
    rationale:
        Speeding up a part that takes a small share of the time barely
        changes overall performance; halving a step that takes 4 percent of
        the time is worth about as much as a 5 percent gain on one that
        takes 40 percent.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [performance, optimization]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rper-critical
