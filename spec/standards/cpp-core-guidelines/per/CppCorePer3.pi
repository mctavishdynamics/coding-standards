use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCorePer3:
    standard: @{CppCoreGuidelines}
    ruleId: Per.3
    title: Spend optimization effort only on hot code
    statement:
        Direct optimization work at the parts of the program that take most
        of the time. If the program mostly waits on users or the network,
        faster computation in memory will hardly help.
    rationale:
        Improving a part that uses little of the run time cannot improve the
        whole by much. For example, if A takes 4 percent and B takes 40
        percent of the time, making A twice as fast gains about as much as
        making B 5 percent faster.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [performance, optimization]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rper-critical
