use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreI10:
    standard: @{CppCoreGuidelines}
    ruleId: I.10
    title: Throw when a function cannot do what was asked
    statement:
        Signal failure with an exception when a function cannot complete its
        task or meet its postcondition. An error code is too easy to drop.
    rationale:
        When an error goes unnoticed, the program continues with a broken state.
        That leads to many hard bugs.
    exceptions:
        Older APIs that report a status through errno or a return code may be
        called as they are. Where exceptions are not allowed, return the result
        together with an error value, for example as a pair read with structured
        bindings.
    severity: null
    noncompliant:
        ```cpp
        \\\
        int open_config(const std::string& path, Config& out);   // returns -1 on failure

        Config c;
        open_config("app.ini", c);   // error silently ignored
        \\\
        ```
    compliant:
        ```cpp
        \\\
        Config open_config(const std::string& path);   // throws on failure

        Config c = open_config("app.ini");
        \\\
        ```
    languages: [cpp]
    tags: [interfaces, error-handling, exceptions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ri-except
