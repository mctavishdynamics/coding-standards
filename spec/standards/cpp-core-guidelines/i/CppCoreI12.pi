use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreI12:
    standard: @{CppCoreGuidelines}
    ruleId: I.12
    title: Mark parameters that may not be null with not_null
    statement:
        Use the GSL not_null wrapper for a pointer parameter or return value
        that must always point to something.
    rationale:
        The type then carries the guarantee. Callers cannot pass null by
        accident, and the callee need not test for it again.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::size_t word_count(const char* text);   // may text be null?
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::size_t word_count(gsl::not_null<const char*> text);
        \\\
        ```
    languages: [cpp]
    tags: [interfaces, pointers, null-safety]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ri-nullptr
