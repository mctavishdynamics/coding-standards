use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreI23:
    standard: @{CppCoreGuidelines}
    ruleId: I.23
    title: Keep parameter lists short
    statement:
        Keep functions to three parameters or fewer where practical. Bundle
        related values into a struct, or offer default arguments and overloads
        for the usual cases.
    rationale:
        Long argument lists are hard to read at the call site and may be costly
        to pass. They often mean the function does too much or an abstraction is
        missing.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void create_account(std::string first, std::string last,
                            std::string street, std::string city,
                            std::string zip, int age);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        struct Name { std::string first, last; };
        struct Address { std::string street, city, zip; };

        void create_account(const Name& name, const Address& address, int age);
        \\\
        ```
    languages: [cpp]
    tags: [interfaces, parameters, design]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ri-nargs
