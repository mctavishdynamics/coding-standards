use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreI13:
    standard: @{CppCoreGuidelines}
    ruleId: I.13
    title: Pass arrays with their length, not as a lone pointer
    statement:
        Hand a range to a function as one object that knows its length, such as
        a span or a container. Avoid a lone pointer whose size the callee must
        guess or receive separately.
    rationale:
        Separate pointer and count arguments are easy to get out of step. With
        only a pointer, the callee depends on an unwritten convention to find
        the end.
    exceptions:
        A C-style string ending in a zero byte may be marked with zstring or
        czstring. Prefer string_view or a span of char where you can, since they
        guard against range errors.
    severity: null
    noncompliant:
        ```cpp
        \\\
        double average(const double* values, int n);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        double average(std::span<const double> values);
        \\\
        ```
    languages: [cpp]
    tags: [interfaces, arrays, bounds]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ri-array
