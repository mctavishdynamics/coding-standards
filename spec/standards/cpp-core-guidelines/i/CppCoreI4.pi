use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreI4:
    standard: @{CppCoreGuidelines}
    ruleId: I.4
    title: Make interfaces precisely and strongly typed
    statement:
        Use specific types for parameters and results, such as units,
        enumerations and spans, instead of generic ones like int, bool,
        void* or plain pointers.
    rationale:
        Types are the best documentation, have a well-defined meaning and
        are checked by the compiler. Precise types also often optimize
        better.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void set_timeout(int t);              // seconds? milliseconds?
        void draw(int x, int y, bool fill);   // what does true mean?
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void set_timeout(std::chrono::milliseconds t);

        enum class Fill { solid, outline };
        void draw(Point p, Fill fill);
        \\\
        ```
    languages: [cpp]
    tags: [interfaces, types, type-safety]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ri-typed
