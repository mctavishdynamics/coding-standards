use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreI4:
    standard: @{CppCoreGuidelines}
    ruleId: I.4
    title: Use precise, strong types in interfaces
    statement:
        Give parameters and return values types that say exactly what they hold.
        Prefer a unit type, an enum or a span to a raw int, bool, void* or bare
        pointer.
    rationale:
        A precise type documents itself and the compiler enforces it. Precise
        types also give the optimizer more to work with.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void set_timeout(int t);              // seconds? milliseconds?
        void draw(int x, int y, bool fill);   // what does true mean?
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void set_timeout(std::chrono::milliseconds t);

        enum class Fill { solid, outline };
        void draw(Point p, Fill fill);
        \\\
        ```
    languages: [cpp]
    tags: [interfaces, types, type-safety]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ri-typed
