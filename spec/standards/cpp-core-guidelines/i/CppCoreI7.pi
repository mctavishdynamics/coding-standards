use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreI7:
    standard: @{CppCoreGuidelines}
    ruleId: I.7
    title: Say what a function promises about its result
    statement:
        Document what is true when the function returns, including side effects
        that the return value does not reveal. Use code for this where possible.
    rationale:
        An explicit postcondition shows whether the author and the caller agree
        on the result. It can also expose an implementation that gets it wrong.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // fills buffer
        void read_header(std::vector<char>& buffer);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void read_header(std::vector<char>& buffer) {
            // ...
            Ensures(buffer.size() == header_size);
        }
        \\\
        ```
    languages: [cpp]
    tags: [interfaces, contracts, postconditions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ri-post
