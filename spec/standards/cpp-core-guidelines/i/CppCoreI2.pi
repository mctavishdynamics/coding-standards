use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreI2:
    standard: @{CppCoreGuidelines}
    ruleId: I.2
    title: Avoid global variables that can be modified
    statement:
        Do not keep mutable state at namespace or global scope. Pass the data as
        an argument, or wrap it in an object and operate on it through member
        functions.
    rationale:
        Any code anywhere can change a writable global, so readers cannot see
        who depends on it. Concurrent access to it also risks data races.
    exceptions:
        Global constants are fine, as are a few established objects such
        as std::cout. If shared mutable state truly cannot be avoided, a plain
        global object is still better than a singleton.
    severity: null
    noncompliant:
        ```cpp
        \\\
        int retry_count = 3;

        void connect() {
            for (int i = 0; i < retry_count; ++i) { /* ... */ }
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void connect(int retry_count) {
            for (int i = 0; i < retry_count; ++i) { /* ... */ }
        }
        \\\
        ```
    languages: [cpp]
    tags: [interfaces, globals, concurrency]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ri-global
