use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreI3:
    standard: @{CppCoreGuidelines}
    ruleId: I.3
    title: Steer clear of singletons
    statement:
        Avoid classes built to force exactly one instance. For shared read-only
        data, a const or constexpr object is enough.
    rationale:
        A singleton has all the problems of a global variable, such as hidden
        coupling and awkward testing. It adds its own creation and lifetime
        logic on top.
    exceptions:
        A function that returns a reference to a function-local static object is
        fine. It gives lazy initialization and is not a singleton class.
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Config {
        public:
            static Config& instance();
            std::string value(const std::string& key);
        private:
            Config();
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Config {
        public:
            explicit Config(const std::string& path);
            std::string value(const std::string& key) const;
        };

        void start(const Config& config);
        \\\
        ```
    languages: [cpp]
    tags: [interfaces, globals, design]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ri-singleton
