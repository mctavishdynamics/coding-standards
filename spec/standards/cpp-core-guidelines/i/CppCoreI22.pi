use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreI22:
    standard: @{CppCoreGuidelines}
    ruleId: I.22
    title: Keep the setup of global objects simple
    statement:
        Initialize globals with simple values. Avoid initializers that call into
        other globals, above all globals defined in a different source file.
    rationale:
        The order in which source files run their dynamic initialization is not
        specified. A global may therefore be read before it has its value, and
        threads make this worse.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // a.cpp
        extern const std::string base_dir;
        const std::string log_dir = base_dir + "/logs";   // base_dir may be empty
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // a.cpp
        const std::string& log_dir() {
            static const std::string dir = base_dir() + "/logs";
            return dir;
        }
        \\\
        ```
    languages: [cpp]
    tags: [interfaces, globals, initialization]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ri-global-init
