use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreI6:
    standard: @{CppCoreGuidelines}
    ruleId: I.6
    title: Express preconditions with Expects
    statement:
        Put each precondition in an Expects call at the top of the function. Do
        not hide it in a plain if, an assert or a comment.
    rationale:
        Expects says plainly that the caller must meet this condition. Tools can
        find it, check it and decide how to react when it fails.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int element(const std::vector<int>& v, std::size_t i) {
            if (i >= v.size()) std::abort();
            return v[i];
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int element(const std::vector<int>& v, std::size_t i) {
            Expects(i < v.size());
            return v[i];
        }
        \\\
        ```
    languages: [cpp]
    tags: [interfaces, contracts, preconditions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ri-expects
