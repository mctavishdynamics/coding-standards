use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreI25:
    standard: @{CppCoreGuidelines}
    ruleId: I.25
    title: Use abstract interface classes instead of deep hierarchies
    statement:
        Define interfaces as abstract classes that hold no data members. Keep
        state in the concrete classes that implement them.
    rationale:
        A base class without data rarely needs to change. Users who depend on it
        are not disturbed when an implementation evolves.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Logger {
        public:
            virtual void write(std::string_view msg) = 0;
        protected:
            std::mutex lock_;          // clients now depend on this layout
            std::size_t lines_ = 0;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Logger {
        public:
            virtual ~Logger() = default;
            virtual void write(std::string_view msg) = 0;
            virtual std::size_t lines() const = 0;
        };
        \\\
        ```
    languages: [cpp]
    tags: [interfaces, abstract-classes, inheritance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ri-abstract
