use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreI8:
    standard: @{CppCoreGuidelines}
    ruleId: I.8
    title: Express postconditions with Ensures
    statement:
        State postconditions with Ensures instead of a comment or ad hoc code.
        When the promise is that a resource gets released, use an RAII object
        instead.
    rationale:
        Ensures labels the check as a guarantee about the result. Tools can
        recognise it and verify it.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int clamp_percent(int v) {
            int r = std::clamp(v, 0, 100);
            assert(r >= 0 && r <= 100);
            return r;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int clamp_percent(int v) {
            int r = std::clamp(v, 0, 100);
            Ensures(r >= 0 && r <= 100);
            return r;
        }
        \\\
        ```
    languages: [cpp]
    tags: [interfaces, contracts, postconditions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ri-ensures
