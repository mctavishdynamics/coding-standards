use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreI30:
    standard: @{CppCoreGuidelines}
    ruleId: I.30
    title: Hide unavoidable rule breaking behind a clean interface
    statement:
        Sometimes a hack or an unsafe trick is really needed. Keep it inside the
        implementation and give callers a clean, safe interface.
    rationale:
        If the trick leaks into the interface, every user has to learn its
        pitfalls. Confining it to one place keeps the rest of the code base
        simple.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // every caller must remember to free the result
        char* read_name(int id);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::string read_name(int id) {
            char* raw = legacy_read_name(id);   // the C API stays inside
            std::string name(raw);
            std::free(raw);
            return name;
        }
        \\\
        ```
    languages: [cpp]
    tags: [interfaces, encapsulation]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ri-encapsulate
