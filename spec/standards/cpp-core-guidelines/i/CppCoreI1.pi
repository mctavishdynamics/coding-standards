use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreI1:
    standard: @{CppCoreGuidelines}
    ruleId: I.1
    title: Put everything a function depends on in its signature
    statement:
        A function's inputs and outputs should all appear in its signature.
        Avoid reading or writing hidden state such as globals to get work done.
    rationale:
        A dependency that the declaration does not show is easy to miss when
        calling or testing the function. Explicit parameters make every input
        visible.
    exceptions:
        A process-wide setting, for example an environment variable that turns
        on debug logging, may be acceptable when it only tunes how a fixed
        behavior is carried out.
    severity: null
    noncompliant:
        ```cpp
        \\\
        int rounding_mode;   // set somewhere before calling

        double round_price(double p);   // silently depends on rounding_mode
        \\\
        ```
    compliant:
        ```cpp
        \\\
        enum class Rounding { up, down, nearest };

        double round_price(double p, Rounding mode);
        \\\
        ```
    languages: [cpp]
    tags: [interfaces, dependencies]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ri-explicit
