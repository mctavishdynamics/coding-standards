use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreI9:
    standard: @{CppCoreGuidelines}
    ruleId: I.9
    title: Describe template parameter requirements with concepts
    statement:
        Constrain every template parameter with a concept that names what the
        type must support.
    rationale:
        A concept makes the template's requirements part of its declaration. The
        compiler checks them at the call site and reports errors in terms the
        user understands.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<typename Iter, typename Val>
        Iter find_value(Iter first, Iter last, const Val& v);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<std::input_iterator Iter, typename Val>
            requires std::equality_comparable_with<std::iter_value_t<Iter>, Val>
        Iter find_value(Iter first, Iter last, const Val& v);
        \\\
        ```
    languages: [cpp]
    tags: [interfaces, templates, concepts]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ri-concepts
