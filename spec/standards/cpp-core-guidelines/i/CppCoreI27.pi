use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreI27:
    standard: @{CppCoreGuidelines}
    ruleId: I.27
    title: Hide a library's implementation behind a pointer for a stable ABI
    statement:
        For a library that must keep a stable ABI, move private data and helpers
        into a separate implementation class. The public class holds only a
        pointer to it.
    rationale:
        Private members still affect object size and overload resolution, so
        editing them forces every client to rebuild. The pointer hides those
        details at the price of one indirection.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // parser.h
        class Parser {
        public:
            Ast parse(std::string_view text);
        private:
            std::vector<Token> tokens_;   // changes here break the ABI
            std::size_t pos_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // parser.h
        class Parser {
        public:
            Parser();
            ~Parser();
            Ast parse(std::string_view text);
        private:
            struct Impl;
            std::unique_ptr<Impl> impl_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [interfaces, abi, pimpl]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ri-pimpl
