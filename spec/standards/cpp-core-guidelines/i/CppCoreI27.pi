use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreI27:
    standard: @{CppCoreGuidelines}
    ruleId: I.27
    title: For stable library ABI, consider the Pimpl idiom
    statement:
        Keep private data and helper functions in a separate implementation
        class reached through a pointer, so the public class layout does not
        change.
    rationale:
        Private members are part of the class layout and of overload
        resolution, so changing them forces all users to recompile. A
        pointer to implementation isolates users at the cost of one
        indirection.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // parser.h
        class Parser {
        public:
            Ast parse(std::string_view text);
        private:
            std::vector<Token> tokens_;   // changes here break the ABI
            std::size_t pos_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // parser.h
        class Parser {
        public:
            Parser();
            ~Parser();
            Ast parse(std::string_view text);
        private:
            struct Impl;
            std::unique_ptr<Impl> impl_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [interfaces, abi, pimpl]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ri-pimpl
