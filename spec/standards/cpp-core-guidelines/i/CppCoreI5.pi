use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreI5:
    standard: @{CppCoreGuidelines}
    ruleId: I.5
    title: Say what a function requires of its arguments
    statement:
        Write down the conditions an argument must meet before the call. Express
        them in code such as Expects where possible, and in a comment otherwise.
    rationale:
        The function body may rely on those conditions. A caller who does not
        know them can pass a value that breaks the function.
    exceptions:
        Most member functions assume the class invariant holds. That assumption
        need not be restated in every one of them.
    severity: null
    noncompliant:
        ```cpp
        \\\
        double sqrt_of(double x);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        double sqrt_of(double x) {
            Expects(x >= 0);
            return std::sqrt(x);
        }
        \\\
        ```
    languages: [cpp]
    tags: [interfaces, contracts, preconditions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ri-pre
