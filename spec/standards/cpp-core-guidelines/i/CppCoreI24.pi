use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreI24:
    standard: @{CppCoreGuidelines}
    ruleId: I.24
    title: Avoid neighbouring parameters of the same type that are easy to swap
    statement:
        If two neighbouring parameters share a type, a caller can swap them
        silently. Use distinct types, a range object or a struct with named
        members instead.
    rationale:
        The compiler sees nothing wrong with arguments in the wrong order. The
        mistake surfaces only as wrong behavior at run time.
    exceptions:
        When the order does not change the result, as in a function that returns
        the smaller of two values, adjacent same-typed parameters are harmless.
    severity: null
    noncompliant:
        ```cpp
        \\\
        void copy_file(const std::string& from, const std::string& to);

        copy_file(backup, original);   // swapped by accident
        \\\
        ```
    compliant:
        ```cpp
        \\\
        struct Source { std::string path; };
        struct Target { std::string path; };

        void copy_file(const Source& from, const Target& to);
        \\\
        ```
    languages: [cpp]
    tags: [interfaces, parameters, type-safety]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ri-unrelated
