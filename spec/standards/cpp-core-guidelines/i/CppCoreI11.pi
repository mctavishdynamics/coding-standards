use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreI11:
    standard: @{CppCoreGuidelines}
    ruleId: I.11
    title: Never pass ownership through a plain pointer or reference
    statement:
        Raw pointers and references must not carry ownership across an
        interface. Return by value, use a smart pointer such as unique_ptr, or
        mark the pointer with GSL owner.
    rationale:
        Readers treat a plain pointer as non-owning. If ownership is unclear,
        the object is either leaked or deleted while still in use.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Widget* make_widget(int id) {
            return new Widget(id);   // who deletes it?
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::unique_ptr<Widget> make_widget(int id) {
            return std::make_unique<Widget>(id);
        }
        \\\
        ```
    languages: [cpp]
    tags: [interfaces, ownership, pointers]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ri-raw
