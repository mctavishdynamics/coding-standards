use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreI26:
    standard: @{CppCoreGuidelines}
    ruleId: I.26
    title: Expose a C-style interface when other compilers must link against it
    statement:
        If parts of a program are built by different compilers and linked
        together, limit the shared interface to a C subset: extern "C" functions
        and plain data types.
    rationale:
        Each compiler has its own rules for class layout, exceptions and name
        mangling. A full C++ interface may therefore not link or work across
        them.
    exceptions:
        Some platforms have a common C++ ABI, which removes much of this limit.
        When one compiler builds everything, a full C++ interface is fine, but a
        compiler upgrade means rebuilding all parts.
    severity: null
    noncompliant:
        ```cpp
        \\\
        // plugin.h, built by another compiler
        std::vector<std::string> plugin_names();
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // plugin.h
        extern "C" {
            int plugin_count(void);
            const char* plugin_name(int index);
        }
        \\\
        ```
    languages: [cpp]
    tags: [interfaces, abi, portability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ri-abi
