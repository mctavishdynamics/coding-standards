use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCon3:
    standard: @{CppCoreGuidelines}
    ruleId: Con.3
    title: Take pointers and references to const unless the callee modifies the target
    statement:
        Pass objects by pointer to const or reference to const by default. Use a
        non-const pointer or reference only for a parameter the function is supposed
        to change.
    rationale:
        A const parameter guarantees the caller's object comes back unchanged.
        Readers must assume that a plain reference will be written to, and code that
        does not mutate its inputs is much simpler to reason about.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::size_t count_vowels(std::string& text);   // does it modify text?
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::size_t count_vowels(const std::string& text);
        \\\
        ```
    languages: [cpp]
    tags: [const, parameters, interfaces]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconst-ref
