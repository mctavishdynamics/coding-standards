use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCon2:
    standard: @{CppCoreGuidelines}
    ruleId: Con.2
    title: Mark member functions const unless they change the object
    statement:
        Mark a member function const whenever calling it leaves the object's
        observable state unchanged. Internal caches can still be updated through
        mutable members.
    rationale:
        A const member function tells readers and the compiler exactly what the
        design intends. More mistakes are caught at compile time, and the optimizer
        sometimes has more room. Leaving const off also makes the function unusable
        on const objects.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Temperature {
        public:
            double celsius() { return celsius_; }
        private:
            double celsius_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Temperature {
        public:
            double celsius() const { return celsius_; }
        private:
            double celsius_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [const, member-functions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconst-fct
