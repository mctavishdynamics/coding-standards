use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCon1:
    standard: @{CppCoreGuidelines}
    ruleId: Con.1
    title: Start from immutable and add mutability only when needed
    statement:
        Make const the default for every object, and drop it only for objects that
        really must change.
    rationale:
        Code is easier to follow when most values stay fixed. The compiler also
        rejects an accidental assignment instead of letting it pass silently.
    exceptions:
        Skip const on a local that you return by value when moving it is cheaper
        than copying, because const would turn the move into a copy. Parameters
        taken by value rarely benefit from const either.
    severity: null
    noncompliant:
        ```cpp
        \\\
        for (std::string name : names)
            std::cout << name << '\n';   // only read, yet a mutable copy
        \\\
        ```
    compliant:
        ```cpp
        \\\
        for (const std::string& name : names)
            std::cout << name << '\n';
        \\\
        ```
    languages: [cpp]
    tags: [const, immutability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconst-immutable
