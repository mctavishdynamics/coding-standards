use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCon5:
    standard: @{CppCoreGuidelines}
    ruleId: Con.5
    title: Mark values computable during compilation constexpr
    statement:
        Use constexpr for values whose initializer can be worked out during
        compilation.
    rationale:
        A constexpr value is guaranteed to be computed by the compiler. Mistakes
        surface at build time, the program does no work for it at run time and no
        thread can race on it. A const value, in contrast, may still be initialized
        at run time.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        const double circle_area = area(2.0);   // may be computed at run time
        \\\
        ```
    compliant:
        ```cpp
        \\\
        constexpr double circle_area = area(2.0);   // error unless computable at compile time
        \\\
        ```
    languages: [cpp]
    tags: [constexpr, compile-time]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconst-constexpr
