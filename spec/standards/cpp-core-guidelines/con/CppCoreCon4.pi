use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCon4:
    standard: @{CppCoreGuidelines}
    ruleId: Con.4
    title: Use const to define objects whose values do not change after construction
    statement:
        Declare an object const when its value is fixed once it has been
        initialized.
    rationale:
        It prevents surprises from unexpectedly changed values; a reader
        must otherwise assume a non-const variable is modified somewhere,
        for example inside a long loop.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void retry(Request& req)
        {
            int max_attempts = 5;
            for (int i = 0; i < max_attempts; ++i) {
                // ... many lines; is max_attempts changed in here?
            }
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void retry(Request& req)
        {
            const int max_attempts = 5;
            for (int i = 0; i < max_attempts; ++i) {
                // ...
            }
        }
        \\\
        ```
    languages: [cpp]
    tags: [const, immutability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconst-const
