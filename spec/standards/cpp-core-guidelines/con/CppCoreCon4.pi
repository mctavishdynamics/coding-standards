use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCon4:
    standard: @{CppCoreGuidelines}
    ruleId: Con.4
    title: Mark objects const when their value is fixed after creation
    statement:
        Add const to any object that keeps the value it was initialized with.
    rationale:
        Without const, a reader has to scan the rest of the scope, perhaps a long
        loop, to be sure the value never changes. With it, an unexpected change
        cannot happen.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void retry(Request& req)
        {
            int max_attempts = 5;
            for (int i = 0; i < max_attempts; ++i) {
                // ... many lines; is max_attempts changed in here?
            }
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void retry(Request& req)
        {
            const int max_attempts = 5;
            for (int i = 0; i < max_attempts; ++i) {
                // ...
            }
        }
        \\\
        ```
    languages: [cpp]
    tags: [const, immutability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconst-const
