use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR4:
    standard: @{CppCoreGuidelines}
    ruleId: R.4
    title: Assume a raw reference does not own what it refers to
    statement:
        Treat a bare T& as a way to reach an object, never as its owner.
        Never delete through a reference, and never return ownership in the
        form of a reference.
    rationale:
        References almost never own, and people and tools rely on that.
        Ownership has to be visible somewhere else for deletion to be
        reliable.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Config& load_config() {
            return *new Config(read_file("app.ini"));   // owner hidden behind a reference
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        Config load_config() {
            return Config(read_file("app.ini"));
        }
        \\\
        ```
    languages: [cpp]
    tags: [ownership, references]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-ref
