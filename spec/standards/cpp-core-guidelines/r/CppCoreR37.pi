use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR37:
    standard: @{CppCoreGuidelines}
    ruleId: R.37
    title: Pin a shared object before passing out raw access to it
    statement:
        A smart pointer that other code could reset is not a safe source for
        a raw pointer or reference you pass down. Take a local copy of the
        smart pointer first, and pass access through that copy.
    rationale:
        Something deeper in the call chain may reassign the shared smart
        pointer and free the object while the callee still uses it. This
        pattern is the most common way programs end up with a dangling
        pointer and a lost reference count.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::shared_ptr<Scene> g_current;

        void show() {
            paint(*g_current);    // paint may reset g_current
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::shared_ptr<Scene> g_current;

        void show() {
            auto pin = g_current;  // keeps the scene alive
            paint(*pin);
        }
        \\\
        ```
    languages: [cpp]
    tags: [smart-pointers, lifetime]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-smartptrget
