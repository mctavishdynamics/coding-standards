use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR11:
    standard: @{CppCoreGuidelines}
    ruleId: R.11
    title: Leave new and delete to owning types
    statement:
        Application code should not contain bare new and delete expressions.
        Allocation and release belong to a container, a smart pointer or
        another resource handle.
    rationale:
        Every bare delete is something a reader has to verify on every path,
        and a missing or doubled one is a bug that may surface only later.
        Storing the result of new in a plain pointer means any early exit
        leaks it.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void process() {
            Buffer* buf = new Buffer(4096);
            fill(*buf);
            delete buf;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void process() {
            auto buf = std::make_unique<Buffer>(4096);
            fill(*buf);
        }
        \\\
        ```
    languages: [cpp]
    tags: [memory, allocation]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-newdelete
