use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR24:
    standard: @{CppCoreGuidelines}
    ruleId: R.24
    title: Break shared_ptr reference cycles with weak_ptr
    statement:
        Where shared_ptr links form a loop, for example a child pointing
        back at its parent, turn one of the links into a std::weak_ptr.
    rationale:
        Objects in a ring of shared_ptrs keep one another's counts above
        zero forever, so none of them is ever freed. A weak_ptr observes
        without holding a count, which lets the ring be torn down.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        struct Parent;
        struct Child  { std::shared_ptr<Parent> parent; };
        struct Parent { std::vector<std::shared_ptr<Child>> children; };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        struct Parent;
        struct Child  { std::weak_ptr<Parent> parent; };
        struct Parent { std::vector<std::shared_ptr<Child>> children; };
        \\\
        ```
    languages: [cpp]
    tags: [smart-pointers, ownership]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-weak_ptr
