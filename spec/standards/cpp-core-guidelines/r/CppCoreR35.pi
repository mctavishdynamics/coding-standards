use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR35:
    standard: @{CppCoreGuidelines}
    ruleId: R.35
    title: Take a shared_ptr by reference when the function may repoint it
    statement:
        Pass a non-const reference to shared_ptr when the function might
        point the caller's shared_ptr at a different object.
    rationale:
        Such a signature announces that reseating may happen, so callers are
        not caught out.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void refresh(std::shared_ptr<Token>& token) {
            log(token->expiry());      // never reseats: take const Token&
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void refresh(std::shared_ptr<Token>& token) {
            if (token->expired()) token = std::make_shared<Token>(fetch_token());
        }
        \\\
        ```
    languages: [cpp]
    tags: [smart-pointers, interfaces]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-sharedptrparam
