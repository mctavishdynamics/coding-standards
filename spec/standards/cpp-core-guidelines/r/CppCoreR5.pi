use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR5:
    standard: @{CppCoreGuidelines}
    ruleId: R.5
    title: Use local objects and avoid needless heap allocation
    statement:
        When an object only needs to live as long as some scope, make it a
        local, a member or a global. Do not put it on the heap for no
        reason.
    rationale:
        Such an object needs no extra allocation, and the scope or
        containing object ends its life for you. Nothing can leak, and the
        code is shorter.
    exceptions:
        For a very large object when stack space is tight, keep it on the
        heap through a local const unique_ptr.
    severity: null
    noncompliant:
        ```cpp
        \\\
        void render() {
            auto* canvas = new Canvas(800, 600);
            canvas->draw_frame();
            delete canvas;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void render() {
            Canvas canvas(800, 600);
            canvas.draw_frame();
        }
        \\\
        ```
    languages: [cpp]
    tags: [resource-management, allocation]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-scoped
