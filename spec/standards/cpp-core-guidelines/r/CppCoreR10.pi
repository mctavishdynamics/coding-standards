use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR10:
    standard: @{CppCoreGuidelines}
    ruleId: R.10
    title: Keep malloc and free out of C++ code
    statement:
        Keep malloc() and free() out of C++ code that creates objects.
        Prefer containers and smart pointers, and if raw allocation is
        unavoidable, use new and delete hidden inside a handle class.
    rationale:
        The C allocation functions hand back raw bytes and never call a
        constructor or destructor. Memory obtained one way also cannot be
        released the other way, so mixing them breaks programs.
    exceptions:
        Code that cannot tolerate exceptions, as in some hard real-time
        systems, should switch to the nothrow overloads of new instead of
        returning to malloc().
    severity: null
    noncompliant:
        ```cpp
        \\\
        auto* order = static_cast<Order*>(std::malloc(sizeof(Order)));
        order->id = 42;      // Order's constructor never ran
        std::free(order);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        auto order = std::make_unique<Order>();
        order->id = 42;
        \\\
        ```
    languages: [cpp]
    tags: [memory, allocation]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-mallocfree
