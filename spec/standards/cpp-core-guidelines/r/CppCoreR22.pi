use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR22:
    standard: @{CppCoreGuidelines}
    ruleId: R.22
    title: Create shared_ptr objects with make_shared
    statement:
        Build a shared_ptr with std::make_shared instead of wrapping the
        result of a new expression.
    rationale:
        The type appears only once, so the line is shorter. The library can
        also place the reference count in the same block of memory as the
        object. In code older than C++17 it also kept compound expressions
        from leaking.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::shared_ptr<Session> s(new Session(user_id));
        \\\
        ```
    compliant:
        ```cpp
        \\\
        auto s = std::make_shared<Session>(user_id);
        \\\
        ```
    languages: [cpp]
    tags: [smart-pointers, allocation]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-make_shared
