use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR12:
    standard: @{CppCoreGuidelines}
    ruleId: R.12
    title: Hand the result of an allocation to its owner in the same statement
    statement:
        If you allocate a resource by hand, pass it to its managing object
        as part of the very statement that allocates it.
    rationale:
        Leaving even one line between acquiring the resource and handing it
        over creates a window. A throw or a return inside that window loses
        the resource.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void copy_file(const char* name) {
            FILE* f = std::fopen(name, "r");
            check_permissions(name);           // may throw: f leaks
            std::unique_ptr<FILE, decltype(&std::fclose)> file(f, &std::fclose);
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void copy_file(const char* name) {
            std::unique_ptr<FILE, decltype(&std::fclose)> file(
                std::fopen(name, "r"), &std::fclose);
            check_permissions(name);
        }
        \\\
        ```
    languages: [cpp]
    tags: [resource-management, exception-safety]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-immediate-alloc
