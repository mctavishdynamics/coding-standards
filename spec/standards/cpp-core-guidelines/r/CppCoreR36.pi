use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR36:
    standard: @{CppCoreGuidelines}
    ruleId: R.36
    title: Take a shared_ptr by const reference when the function may keep a copy
    statement:
        A parameter of type const reference to shared_ptr should mean the
        function might copy it and so extend the object's life. If no copy
        is ever taken, prefer a raw pointer or a reference.
    rationale:
        This form tells callers the object may outlive the call. The
        guideline itself leaves the detailed reasoning for this rule
        unfinished.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void draw(const std::shared_ptr<Sprite>& sprite) {
            sprite->render();          // never keeps a copy
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void Watcher::maybe_watch(const std::shared_ptr<File>& file) {
            if (file->is_config()) watched_.push_back(file);
        }
        \\\
        ```
    languages: [cpp]
    tags: [smart-pointers, interfaces]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-sharedptrparam-const
