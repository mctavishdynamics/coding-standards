use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR23:
    standard: @{CppCoreGuidelines}
    ruleId: R.23
    title: Create unique_ptr objects with make_unique
    statement:
        Build a unique_ptr with std::make_unique instead of wrapping the
        result of a new expression.
    rationale:
        Naming the type once keeps the code short and free of repetition.
        Before C++17 it also stopped leaks in expressions that allocated
        more than once.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::unique_ptr<Texture> tex(new Texture("grass.png"));
        \\\
        ```
    compliant:
        ```cpp
        \\\
        auto tex = std::make_unique<Texture>("grass.png");
        \\\
        ```
    languages: [cpp]
    tags: [smart-pointers, allocation]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-make_unique
