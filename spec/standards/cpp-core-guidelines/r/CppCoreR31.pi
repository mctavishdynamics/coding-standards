use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR31:
    standard: @{CppCoreGuidelines}
    ruleId: R.31
    title: Model custom smart pointers on the standard ones
    statement:
        Custom or library smart pointers should follow the standard model. A
        copyable one should act like shared_ptr, and a move-only one like
        unique_ptr.
    rationale:
        The parameter rules in this section, and the checkers built on them,
        can then apply to every smart pointer in the program. Checkers count
        any type with overloaded unary * and -> as a smart pointer.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // copyable, but copies do not share a count: copies double-delete
        template<class T> class Handle {
            T* p;
        public:
            T* operator->() const { return p; }
            ~Handle() { delete p; }
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<class T> class Handle {      // unique-ownership, like unique_ptr
            T* p;
        public:
            Handle(const Handle&) = delete;
            Handle(Handle&& other) noexcept : p(std::exchange(other.p, nullptr)) {}
            T* operator->() const { return p; }
            ~Handle() { delete p; }
        };
        \\\
        ```
    languages: [cpp]
    tags: [smart-pointers, interfaces]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-smart
