use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR2:
    standard: @{CppCoreGuidelines}
    ruleId: R.2
    title: Let raw pointers in interfaces refer to single objects only
    statement:
        In an interface, a raw pointer parameter should stand for one
        object. A sequence of elements should arrive as a container or a
        span, so its length comes along.
    rationale:
        Given only a pointer to the first element, the function has no way
        to know where the data ends. Containers and spans carry the size and
        so allow bounds checks.
    exceptions:
        Zero-terminated C strings are still passed as one pointer. Spell the
        type as zstring instead of char* so the reliance on the terminator
        is visible.
    severity: null
    noncompliant:
        ```cpp
        \\\
        double average(const double* values, int count);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        double average(std::span<const double> values);
        \\\
        ```
    languages: [cpp]
    tags: [interfaces, pointers]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-use-ptr
