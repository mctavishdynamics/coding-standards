use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR32:
    standard: @{CppCoreGuidelines}
    ruleId: R.32
    title: Take a unique_ptr by value when the function takes ownership
    statement:
        Declare a parameter as unique_ptr of T, by value, when the function
        becomes the new owner of the T.
    rationale:
        Callers must std::move their pointer to make the call. The signature
        therefore both states and enforces that ownership changes hands.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void Scene::add(Mesh* mesh);   // does the scene now own it?
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void Scene::add(std::unique_ptr<Mesh> mesh);
        \\\
        ```
    languages: [cpp]
    tags: [smart-pointers, ownership, interfaces]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-uniqueptrparam
