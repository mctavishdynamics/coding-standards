use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR30:
    standard: @{CppCoreGuidelines}
    ruleId: R.30
    title: Take smart pointer parameters only when lifetime is the point
    statement:
        Let a function take a smart pointer parameter only when it really
        affects the lifetime of the object, for instance by storing it,
        sharing it or making it point elsewhere. Otherwise pass a plain
        pointer or a reference. See F.7 for the full treatment.
    rationale:
        When the function merely uses the object, demanding a particular
        smart pointer type needlessly restricts callers. Copying a
        shared_ptr also costs an atomic count update.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void print(std::shared_ptr<Report> report) {
            std::cout << report->title();
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void print(const Report& report) {
            std::cout << report.title();
        }
        \\\
        ```
    languages: [cpp]
    tags: [smart-pointers, interfaces]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-smartptrparam
