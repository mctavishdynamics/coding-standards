use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR6:
    standard: @{CppCoreGuidelines}
    ruleId: R.6
    title: Avoid mutable global state
    statement:
        Steer clear of global variables that can be modified. The reasoning
        lives in I.2.
    rationale:
        Writable globals tie functions together in ways no signature shows.
        They make behaviour hard to follow and invite data races in threaded
        code.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int g_retry_count = 3;

        void connect() {
            for (int i = 0; i < g_retry_count; ++i) try_connect();
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void connect(int retry_count) {
            for (int i = 0; i < retry_count; ++i) try_connect();
        }
        \\\
        ```
    languages: [cpp]
    tags: [globals, state]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-global
