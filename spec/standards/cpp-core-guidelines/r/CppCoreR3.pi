use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR3:
    standard: @{CppCoreGuidelines}
    ruleId: R.3
    title: Assume a raw pointer does not own what it points to
    statement:
        Treat a bare T* as an observer that never deletes its target. If a
        pointer has to own, make it a smart pointer or tag it
        with gsl::owner.
    rationale:
        Most pointers in typical code do not own, and the language offers no
        way to tell the two kinds apart. Marking the owning ones lets people
        and tools confirm that each owned object gets deleted.
    exceptions:
        Older code may still rely on owning raw pointers, in particular code
        shared with C or exposed through C-style ABIs. Handle classes like
        vector also hold owning raw pointers inside, and those should carry
        the owner annotation where practical.
    severity: null
    noncompliant:
        ```cpp
        \\\
        Sensor* open_sensor(int port) {
            return new Sensor(port);   // caller must guess it owns this
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::unique_ptr<Sensor> open_sensor(int port) {
            return std::make_unique<Sensor>(port);
        }
        \\\
        ```
    languages: [cpp]
    tags: [ownership, pointers]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-ptr
