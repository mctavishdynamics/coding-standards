use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR20:
    standard: @{CppCoreGuidelines}
    ruleId: R.20
    title: Express ownership with smart pointers
    statement:
        Use unique_ptr or shared_ptr whenever a pointer is responsible for
        deleting its target. Reserve raw pointers for observing.
    rationale:
        A smart pointer destroys its object on its own when it goes away.
        That removes the most common source of leaks.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void build() {
            Mesh* mesh = new Mesh();
            if (!mesh->load("tree.obj")) return;   // leak
            upload(*mesh);
            delete mesh;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void build() {
            auto mesh = std::make_unique<Mesh>();
            if (!mesh->load("tree.obj")) return;
            upload(*mesh);
        }
        \\\
        ```
    languages: [cpp]
    tags: [ownership, smart-pointers]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-owner
