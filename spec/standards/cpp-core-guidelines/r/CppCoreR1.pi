use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR1:
    standard: @{CppCoreGuidelines}
    ruleId: R.1
    title: Tie each resource's lifetime to an owning object
    statement:
        Any resource that comes with a release step, for instance an open
        file, a held mutex or heap memory, should live inside an object.
        That object grabs the resource when it is constructed and gives it
        back when it is destroyed.
    rationale:
        Manual cleanup is easy to forget and hard to get right on every
        path. A destructor is called whenever the owner goes out of scope,
        whether by return or by exception, so the release happens without
        extra code.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void write_log(const char* path, const std::string& line) {
            FILE* f = std::fopen(path, "a");
            if (line.empty()) return;          // leaks the file handle
            std::fputs(line.c_str(), f);
            std::fclose(f);
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void write_log(const char* path, const std::string& line) {
            std::ofstream out(path, std::ios::app);
            if (line.empty()) return;          // file closed by the destructor
            out << line;
        }
        \\\
        ```
    languages: [cpp]
    tags: [resource-management, raii]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-raii
