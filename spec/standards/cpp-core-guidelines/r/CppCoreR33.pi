use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR33:
    standard: @{CppCoreGuidelines}
    ruleId: R.33
    title: Take a unique_ptr by reference when the function may replace the object
    statement:
        Use a parameter of type unique_ptr of T, by non-const reference,
        only for a function that may swap in a different object for the
        caller. Do not use it to simply give access to the object.
    rationale:
        This type tells readers and the compiler that the function is
        allowed to reseat the caller's pointer. Using it for anything else
        misleads both.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void reload(std::unique_ptr<Shader>& shader) {
            shader->bind();            // only uses it: should take Shader&
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void reload(std::unique_ptr<Shader>& shader) {
            shader = std::make_unique<Shader>(read_source());
        }
        \\\
        ```
    languages: [cpp]
    tags: [smart-pointers, interfaces]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-reseat
