use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR13:
    standard: @{CppCoreGuidelines}
    ruleId: R.13
    title: Allocate at most one resource per statement
    statement:
        One expression should contain no more than one explicit allocation.
        Two new calls in the arguments of a single function call are the
        classic case, so split them into separate statements or use the
        make_ functions.
    rationale:
        C++ does not fix the order in which arguments and many other
        subexpressions are evaluated. One allocation may finish, the second
        may then throw, and the first object is lost before anything owns
        it.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        connect(std::shared_ptr<Node>(new Node("a")),
                std::shared_ptr<Node>(new Node("b")));
        \\\
        ```
    compliant:
        ```cpp
        \\\
        connect(std::make_shared<Node>("a"), std::make_shared<Node>("b"));
        \\\
        ```
    languages: [cpp]
    tags: [resource-management, exception-safety]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-single-alloc
