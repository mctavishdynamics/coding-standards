use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR21:
    standard: @{CppCoreGuidelines}
    ruleId: R.21
    title: Default to unique ownership and share only when needed
    statement:
        Start with unique_ptr. Switch to shared_ptr only when ownership
        truly has to be split among several holders.
    rationale:
        Single ownership is easier to reason about, and you can see exactly
        where the object dies. It also skips the reference count that
        shared_ptr has to maintain at run time.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::shared_ptr<Parser> make_parser() {
            return std::make_shared<Parser>();   // only ever one owner
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::unique_ptr<Parser> make_parser() {
            return std::make_unique<Parser>();
        }
        \\\
        ```
    languages: [cpp]
    tags: [ownership, smart-pointers]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-unique
