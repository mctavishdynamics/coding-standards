use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR14:
    standard: @{CppCoreGuidelines}
    ruleId: R.14
    title: Avoid array parameters and prefer span
    statement:
        Do not declare parameters with array syntax such as int a[]. Take a
        span so that the size travels with the data.
    rationale:
        An array parameter decays to a pointer and loses its size, which
        opens the door to range errors.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void clear_scores(int scores[], int n);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void clear_scores(std::span<int> scores);
        \\\
        ```
    languages: [cpp]
    tags: [interfaces, arrays, bounds]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-ap
