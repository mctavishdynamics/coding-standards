use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR14:
    standard: @{CppCoreGuidelines}
    ruleId: R.14
    title: Pass a span instead of an array parameter
    statement:
        Avoid parameters written with brackets, like int a[]. Accept a span,
        which bundles the pointer with the element count.
    rationale:
        In a parameter list the brackets mean only a pointer, and the length
        is silently dropped. Without the length the callee can easily read
        or write past the end.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void clear_scores(int scores[], int n);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void clear_scores(std::span<int> scores);
        \\\
        ```
    languages: [cpp]
    tags: [interfaces, arrays, bounds]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-ap
