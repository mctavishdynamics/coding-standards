use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR15:
    standard: @{CppCoreGuidelines}
    ruleId: R.15
    title: Overload allocation and deallocation operators together
    statement:
        Overloaded allocation and deallocation functions come in pairs.
        Define operator delete whenever you define operator new for a type,
        and the reverse.
    rationale:
        With only one half replaced, memory gets allocated by one scheme and
        freed by another. The outcome is undefined and hard to diagnose. If
        memory must never be freed, delete the deallocation function
        explicitly instead of leaving it out.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Packet {
        public:
            static void* operator new(std::size_t size) { return pool.allocate(size); }
            // no matching operator delete: the global one frees pool memory
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Packet {
        public:
            static void* operator new(std::size_t size) { return pool.allocate(size); }
            static void operator delete(void* p) noexcept { pool.release(p); }
        };
        \\\
        ```
    languages: [cpp]
    tags: [memory, allocation]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-pair
