use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreR34:
    standard: @{CppCoreGuidelines}
    ruleId: R.34
    title: Take a shared_ptr by value when the function becomes a co-owner
    statement:
        Pass a shared_ptr by value to a function that will hold on to a
        share of the object, such as by storing it in a member.
    rationale:
        Seeing a by-value shared_ptr in the signature tells the caller that
        the function joins in owning the object.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Cache {
        public:
            void store(Image* img) { items_.push_back(std::shared_ptr<Image>(img)); }
        private:
            std::vector<std::shared_ptr<Image>> items_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Cache {
        public:
            void store(std::shared_ptr<Image> img) { items_.push_back(std::move(img)); }
        private:
            std::vector<std::shared_ptr<Image>> items_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [smart-pointers, ownership, interfaces]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rr-sharedptrparam-owner
