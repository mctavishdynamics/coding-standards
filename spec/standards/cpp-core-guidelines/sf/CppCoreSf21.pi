use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSf21:
    standard: @{CppCoreGuidelines}
    ruleId: SF.21
    title: Keep unnamed namespaces out of headers
    statement:
        Never write an unnamed namespace in a header. Use a named namespace, and
        inline functions where a definition must live in the header.
    rationale:
        Every translation unit that includes the header gets a distinct private copy
        of what the unnamed namespace holds. That is nearly never what the author
        wanted.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // limits.h
        namespace {
            int max_users = 100;
            int scaled(int n) { return n * max_users; }
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // limits.h
        namespace limits {
            inline constexpr int max_users = 100;
            inline int scaled(int n) { return n * max_users; }
        }
        \\\
        ```
    languages: [cpp]
    tags: [namespaces, headers]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rs-unnamed
