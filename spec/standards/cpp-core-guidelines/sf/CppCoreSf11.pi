use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSf11:
    standard: @{CppCoreGuidelines}
    ruleId: SF.11
    title: Make each header compile on its own
    statement:
        Every header should include whatever it needs, so that a file containing
        nothing but that one include compiles cleanly.
    rationale:
        Users should be able to include a header first, last or alone and have it
        work. A header that depends on what was included before it pushes its own
        dependencies onto every user and fails in puzzling ways when their include
        order changes.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // invoice.h
        struct Invoice {
            std::string customer;          // relies on the includer for <string>
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // invoice.h
        #include <string>

        struct Invoice {
            std::string customer;
        };
        \\\
        ```
    languages: [cpp]
    tags: [headers, includes]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rs-contained
