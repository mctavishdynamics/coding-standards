use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSf9:
    standard: @{CppCoreGuidelines}
    ruleId: SF.9
    title: Keep source files free of circular dependencies
    statement:
        Arrange headers and source files so that no include chain leads back to its
        starting file. Break such a loop instead of only hiding it behind include
        guards.
    rationale:
        Include loops make the code harder to follow and slow down builds. They also
        get in the way of moving the code to modules.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // order.h
        #include "customer.h"

        // customer.h
        #include "order.h"
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // order.h
        class Customer;              // forward declaration
        class Order { Customer* owner; };

        // customer.h
        #include "order.h"
        \\\
        ```
    languages: [cpp]
    tags: [headers, dependencies]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rs-cycles
