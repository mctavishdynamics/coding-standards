use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSf8:
    standard: @{CppCoreGuidelines}
    ruleId: SF.8
    title: Protect every header with an include guard
    statement:
        Wrap every header in an include guard. Build the guard's macro name from the
        project or component name as well as the file name.
    rationale:
        Guards make a second inclusion of the same header harmless, and a
        distinctive name stops two headers from sharing one guard. The pragma once
        directive is not standard and depends on how a compiler identifies files.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // util.h
        #ifndef UTIL_H
        #define UTIL_H
        int clamp_percent(int v);
        #endif
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // util.h
        #ifndef BILLING_CORE_UTIL_H
        #define BILLING_CORE_UTIL_H
        int clamp_percent(int v);
        #endif // BILLING_CORE_UTIL_H
        \\\
        ```
    languages: [cpp]
    tags: [headers, preprocessor]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rs-guards
