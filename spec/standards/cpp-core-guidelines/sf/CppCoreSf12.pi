use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSf12:
    standard: @{CppCoreGuidelines}
    ruleId: SF.12
    title: Use quotes for local includes and angle brackets for the rest
    statement:
        Write quotes around a header that lives at a path relative to the including
        file in your own project. Write angle brackets for standard headers,
        third-party libraries and anything located through the include path.
    rationale:
        Compilers search differently for the two forms. Picking the right one
        documents where a header is expected to come from, and it stops a stray
        local file with the same name from being used by mistake.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // src/server.cpp
        #include "vector"
        #include <server.h>
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // src/server.cpp
        #include <vector>
        #include <json_lib/parser.h>
        #include "server.h"
        \\\
        ```
    languages: [cpp]
    tags: [includes, headers]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rs-incform
