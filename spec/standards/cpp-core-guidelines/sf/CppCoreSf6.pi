use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSf6:
    standard: @{CppCoreGuidelines}
    ruleId: SF.6
    title: Limit using namespace directives to migration, core libraries or local scopes
    statement:
        Write a using namespace directive only in three cases. Use it while
        migrating code, for a foundational namespace such as std, or inside a local
        scope, which may be a whole source file.
    rationale:
        Each directive can create name clashes, so keep them scarce. On the other
        hand, writing out a namespace that is used throughout the code on every
        single name adds noise.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        using namespace network;
        using namespace storage;     // both declare Connection

        Connection c;                // ambiguous
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void transfer()
        {
            using namespace storage;     // limited to this function
            Connection c = open_default();
            network::Connection n = network::dial();
        }
        \\\
        ```
    languages: [cpp]
    tags: [namespaces, naming]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rs-using
