use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSf1:
    standard: @{CppCoreGuidelines}
    ruleId: SF.1
    title: Use a .cpp suffix for code files and .h for interface files if your project doesn't already follow another convention
    statement:
        Name implementation files with .cpp and header files with .h, unless
        the project already has a different established convention. Rule
        NL.27 covers the details.
    rationale:
        A common convention lets people and tools tell headers from
        implementation files at a glance.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [source-files, naming]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rs-file-suffix
