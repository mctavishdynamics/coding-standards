use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSf1:
    standard: @{CppCoreGuidelines}
    ruleId: SF.1
    title: Use .cpp for source files and .h for headers unless the project has a convention
    statement:
        Give implementation files the .cpp suffix and headers the .h suffix. A
        project that already follows another settled scheme may keep it. NL.27
        discusses the choice further.
    rationale:
        When every file follows one naming scheme, both developers and build tools
        can see immediately which files are headers.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [source-files, naming]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rs-file-suffix
