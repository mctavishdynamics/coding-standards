use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSf4:
    standard: @{CppCoreGuidelines}
    ruleId: SF.4
    title: Put includes at the top of a file
    statement:
        Place every include at the start of the file, ahead of any declaration the
        file makes itself.
    rationale:
        A reader sees a file's dependencies in one place. Includes that come later
        can change meaning depending on what was declared above them.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        #include <vector>

        void tally(std::vector<int>& v);

        #include <string>
        \\\
        ```
    compliant:
        ```cpp
        \\\
        #include <string>
        #include <vector>

        void tally(std::vector<int>& v);
        \\\
        ```
    languages: [cpp]
    tags: [headers, includes, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rs-include-order
