use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSf3:
    standard: @{CppCoreGuidelines}
    ruleId: SF.3
    title: Put declarations shared by several source files in a header
    statement:
        When several source files use the same entity, declare it once in a header
        and include that header in each of them. Do not copy extern declarations
        into each file.
    rationale:
        Copies scattered across files drift apart when the entity changes. Nothing
        checks them against each other, so a mismatch shows up late as a link error
        or as wrong behavior at run time.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // report.cpp
        extern void flush_cache(int level);
        void report() { flush_cache(2); }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // cache.h
        void flush_cache(int level);

        // report.cpp
        #include "cache.h"
        void report() { flush_cache(2); }
        \\\
        ```
    languages: [cpp]
    tags: [headers, maintainability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rs-declaration-header
