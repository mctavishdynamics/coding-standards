use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSf2:
    standard: @{CppCoreGuidelines}
    ruleId: SF.2
    title: Keep object and non-inline function definitions out of headers
    statement:
        Headers may hold declarations, class and template definitions, inline and
        constexpr functions, constants, type aliases and includes. Ordinary function
        bodies and variable definitions belong in source files.
    rationale:
        Each file that includes the header receives its own copy of every definition
        in it. For things covered by the one-definition rule, that produces
        duplicate symbols at link time.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // config.h
        int retry_limit = 3;
        int doubled_limit() { return retry_limit * 2; }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // config.h
        extern int retry_limit;
        inline int doubled_limit() { return retry_limit * 2; }

        // config.cpp
        int retry_limit = 3;
        \\\
        ```
    languages: [cpp]
    tags: [headers, linkage]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rs-inline
