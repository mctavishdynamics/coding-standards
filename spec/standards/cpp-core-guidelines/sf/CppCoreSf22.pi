use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSf22:
    standard: @{CppCoreGuidelines}
    ruleId: SF.22
    title: Put internal names of a source file in an unnamed namespace
    statement:
        Wrap the helpers of a source file that are not part of its public interface
        in an unnamed namespace. Prefer this to static functions or leaving them at
        namespace scope.
    rationale:
        Entities in an unnamed namespace cannot be referred to from any other file,
        so no outside code can come to depend on them.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // report.cpp
        static int column_width(int n);
        std::string pad(const std::string& s);   // helper, but externally visible

        std::string render_report();
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // report.cpp
        namespace {
            int column_width(int n);
            std::string pad(const std::string& s);
        }

        std::string render_report();
        \\\
        ```
    languages: [cpp]
    tags: [namespaces, linkage, encapsulation]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rs-unnamed2
