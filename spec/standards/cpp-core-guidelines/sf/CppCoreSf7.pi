use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSf7:
    standard: @{CppCoreGuidelines}
    ruleId: SF.7
    title: Never put a global using namespace directive in a header
    statement:
        Keep using namespace directives out of the global namespace of every header.
    rationale:
        Everyone who includes the header loses control over which names their code
        refers to. The header's meaning can also shift with the order in which
        headers are included.
    exceptions:
        A using namespace std::literals directive is fine, because user-defined
        literal suffixes must avoid the names the standard reserves and therefore
        cannot clash with it.
    severity: null
    noncompliant:
        ```cpp
        \\\
        // geometry.h
        #include <cmath>
        using namespace std;

        double distance(double dx, double dy);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // geometry.h
        #include <cmath>

        double distance(double dx, double dy);
        \\\
        ```
    languages: [cpp]
    tags: [namespaces, headers]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rs-using-directive
