use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSf13:
    standard: @{CppCoreGuidelines}
    ruleId: SF.13
    title: Write include paths that work on every platform
    statement:
        In include directives, match the case of the file name exactly as it is on
        disk and use forward slashes between directories.
    rationale:
        The language leaves the mapping from include names to files up to each
        implementation. A spelling that works on a case-insensitive system or with
        backslashes can fail elsewhere, and a backslash may even be taken as an
        escape.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        #include <Vector>
        #include "Net\Socket.H"
        \\\
        ```
    compliant:
        ```cpp
        \\\
        #include <vector>
        #include "net/socket.h"
        \\\
        ```
    languages: [cpp]
    tags: [includes, portability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rs-portable-header-id
