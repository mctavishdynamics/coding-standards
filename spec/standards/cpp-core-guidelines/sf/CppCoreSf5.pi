use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSf5:
    standard: @{CppCoreGuidelines}
    ruleId: SF.5
    title: Include a source file's own header in that source file
    statement:
        Have a source file include the header that declares its interface, so the
        compiler sees declarations and definitions together.
    rationale:
        A mismatch, such as a definition with a different return type than its
        declaration, is then reported while compiling that file. Otherwise it might
        only appear at link time, or not at all.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // parser.cpp (does not include parser.h)
        long parse_port(const char* text) { return 0; }   // header says int
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // parser.cpp
        #include "parser.h"

        int parse_port(const char* text) { return 0; }
        \\\
        ```
    languages: [cpp]
    tags: [headers, consistency]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rs-consistency
