use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreSf10:
    standard: @{CppCoreGuidelines}
    ruleId: SF.10
    title: Include every header whose names you use
    statement:
        For each name a file uses, include the header that declares it. Do not count
        on some other header pulling it in for you.
    rationale:
        Which headers a header includes internally can differ between library
        versions and vendors. Code that relied on such a side effect then stops
        compiling for no visible reason, and an include list that names every real
        dependency avoids this.
    exceptions:
        A header written deliberately to bundle a related group of headers is meant
        to be relied on, so including just that one is fine.
    severity: null
    noncompliant:
        ```cpp
        \\\
        #include <vector>

        int total(const std::vector<int>& values)
        {
            return std::accumulate(values.begin(), values.end(), 0);   // <numeric> missing
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        #include <numeric>
        #include <vector>

        int total(const std::vector<int>& values)
        {
            return std::accumulate(values.begin(), values.end(), 0);
        }
        \\\
        ```
    languages: [cpp]
    tags: [headers, includes, dependencies]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rs-implicit
