use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF18:
    standard: @{CppCoreGuidelines}
    ruleId: F.18
    title: Take sink parameters by rvalue reference and move from them
    statement:
        A parameter whose contents the function will take over should be an
        rvalue reference, and the body should std::move from it.
    rationale:
        Moving avoids a copy. Because X&& will not bind to a named object, a
        caller who passes one must write std::move, so a move never happens by
        accident.
    exceptions:
        A move-only owner that is cheap to move, such as unique_ptr, may simply
        be taken by value. A shared_ptr that the function will move from is also
        passed by value, as R.34 explains.
    severity: null
    noncompliant:
        ```cpp
        \\\
        void Queue::push(std::vector<Job>& jobs) {
            pending_ = std::move(jobs);   // the caller's vector is emptied silently
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void Queue::push(std::vector<Job>&& jobs) {
            pending_ = std::move(jobs);
        }

        queue.push(std::move(batch));
        \\\
        ```
    languages: [cpp]
    tags: [functions, parameters, move-semantics]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-consume
