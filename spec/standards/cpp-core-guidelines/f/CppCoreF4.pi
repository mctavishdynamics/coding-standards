use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF4:
    standard: @{CppCoreGuidelines}
    ruleId: F.4
    title: Mark functions that may run during compilation constexpr
    statement:
        Declare a function constexpr if callers may need its result as a
        constant, such as an array size or a template argument.
    rationale:
        Without constexpr the compiler will not run the function during
        compilation, even if it could.
    exceptions:
        Not everything should be constexpr, since most work happens at run time
        anyway. Leave it off functions whose logic may later need run-time data
        such as configuration.
    severity: null
    noncompliant:
        ```cpp
        \\\
        int kib(int n) { return n * 1024; }

        std::array<char, kib(4)> buffer;   // error: not a constant expression
        \\\
        ```
    compliant:
        ```cpp
        \\\
        constexpr int kib(int n) { return n * 1024; }

        std::array<char, kib(4)> buffer;
        \\\
        ```
    languages: [cpp]
    tags: [functions, constexpr, compile-time]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-constexpr
