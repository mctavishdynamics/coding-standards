use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF47:
    standard: @{CppCoreGuidelines}
    ruleId: F.47
    title: Have assignment operators return a reference to the object
    statement:
        Copy assignment, move assignment and compound assignment operators
        should return *this as a non-const T&.
    rationale:
        Built-in types and the standard library behave this way. Matching them
        lets user types work like an int in chained and nested expressions.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Money {
        public:
            void operator=(const Money& other);
            const Money& operator+=(const Money& other);
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Money {
        public:
            Money& operator=(const Money& other);
            Money& operator+=(const Money& other);
        };
        \\\
        ```
    languages: [cpp]
    tags: [functions, operators, conventions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-assignment-op
