use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF15:
    standard: @{CppCoreGuidelines}
    ruleId: F.15
    title: Pass data in and out of functions in the plainest way
    statement:
        Pass arguments and return results the ordinary way, as F.16 through F.21
        describe. Turn to fancier techniques only when measurement shows a need,
        and leave a comment explaining them.
    rationale:
        Clever parameter passing confuses other programmers and breeds mistakes.
        Any speed gain may also vanish on a different compiler or platform.
    exceptions:
        Shared ownership through shared_ptr has its own rules in R.34, R.35 and
        R.36.
    severity: null
    noncompliant:
        ```cpp
        \\\
        // result returned through a static buffer to avoid a copy
        const char* format_name(const Person& p);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::string format_name(const Person& p);
        \\\
        ```
    languages: [cpp]
    tags: [functions, parameters, simplicity]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-conventional
