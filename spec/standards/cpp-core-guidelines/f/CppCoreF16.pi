use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF16:
    standard: @{CppCoreGuidelines}
    ruleId: F.16
    title: Pass small inputs by value and larger ones by const reference
    statement:
        A small type that is cheap to copy, about two or three words in size,
        goes by value. Anything bigger goes by reference to const.
    rationale:
        Either way the caller knows the argument stays unchanged, and
        temporaries can be passed. Copying a small value is safe and often
        faster than going through a reference.
    exceptions:
        For shared ownership with shared_ptr, see R.34 and R.36 instead.
    severity: null
    noncompliant:
        ```cpp
        \\\
        void set_scale(const double& factor);
        void print(std::vector<std::string> lines);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void set_scale(double factor);
        void print(const std::vector<std::string>& lines);
        \\\
        ```
    languages: [cpp]
    tags: [functions, parameters, performance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-in
