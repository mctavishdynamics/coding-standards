use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF44:
    standard: @{CppCoreGuidelines}
    ruleId: F.44
    title: Return a reference when a copy is unwanted and a result always exists
    statement:
        Return T& when the caller should work with an existing object directly,
        without a copy, and the function always has an object to return. The
        reference must not suggest the caller now owns it.
    rationale:
        A reference cannot be null, so callers can use the result without
        checking for nullptr.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Item* Inventory::at(std::size_t i) {   // never null, yet callers check
            return &items_[i];
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        Item& Inventory::at(std::size_t i) {
            return items_[i];
        }
        \\\
        ```
    languages: [cpp]
    tags: [functions, return-values, references]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-return-ref
