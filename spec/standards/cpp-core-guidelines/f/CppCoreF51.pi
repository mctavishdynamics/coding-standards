use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF51:
    standard: @{CppCoreGuidelines}
    ruleId: F.51
    title: Prefer a default argument to an extra overload when either would work
    statement:
        If a set of overloads would only drop trailing parameters of the same
        types, write a single function with default arguments instead.
    rationale:
        All calls then reach one body, so there is no duplicated code. Separate
        overloads can slowly start behaving differently.
    exceptions:
        Overloads remain necessary when the same operation must accept different
        parameter types.
    severity: null
    noncompliant:
        ```cpp
        \\\
        void print(const Report& r);
        void print(const Report& r, int indent);
        void print(const Report& r, int indent, bool color);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void print(const Report& r, int indent = 0, bool color = false);
        \\\
        ```
    languages: [cpp]
    tags: [functions, overloading, default-arguments]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-default-args
