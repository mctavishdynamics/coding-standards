use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF21:
    standard: @{CppCoreGuidelines}
    ruleId: F.21
    title: Bundle several results into a returned struct
    statement:
        Return several results together as one object, best a struct with named
        members. A tuple is fine in generic code, and optional or expected fit a
        value that may be missing.
    rationale:
        Member names describe each result, and the caller can unpack them with
        structured bindings. Nothing about the call looks like input.
    exceptions:
        A function that works on an existing object, such as a stream, or that
        refills a buffer to avoid allocation, may take that object as an in-out
        reference parameter.
    severity: null
    noncompliant:
        ```cpp
        \\\
        bool parse_point(const std::string& s, int& x, int& y);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        struct Point { int x; int y; };

        std::optional<Point> parse_point(const std::string& s);

        if (auto p = parse_point(text)) use(p->x, p->y);
        \\\
        ```
    languages: [cpp]
    tags: [functions, return-values, structs]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-out-multi
