use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF46:
    standard: @{CppCoreGuidelines}
    ruleId: F.46
    title: Give main an int return type
    statement:
        Declare main as returning int. Never write void main.
    rationale:
        The standard demands int. Some compilers allow void as an extension, but
        code using it is not portable. A return statement inside main may be
        omitted.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void main() {
            run();
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int main() {
            run();
        }
        \\\
        ```
    languages: [cpp]
    tags: [functions, main, portability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-main
