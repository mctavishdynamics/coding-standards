use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF50:
    standard: @{CppCoreGuidelines}
    ruleId: F.50
    title: Use a lambda when a function will not do
    statement:
        Use a lambda when you need to capture local variables or define a
        function at local scope. Use a function when you need overloading.
        When either works, prefer a function.
    rationale:
        Functions cannot capture locals or be defined locally, and lambdas
        cannot be overloaded. Choosing the simplest tool that works keeps
        code clear.
    exceptions:
        Generic lambdas are a concise way to write a function template and
        can be useful even where a normal template would work.
    severity: null
    noncompliant:
        ```cpp
        \\\
        struct AboveLimit {               // hand-written to capture limit
            int limit;
            bool operator()(int x) const { return x > limit; }
        };
        auto n = std::count_if(v.begin(), v.end(), AboveLimit{limit});
        \\\
        ```
    compliant:
        ```cpp
        \\\
        auto n = std::count_if(v.begin(), v.end(),
                               [limit](int x) { return x > limit; });
        \\\
        ```
    languages: [cpp]
    tags: [functions, lambdas]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-capture-vs-overload
