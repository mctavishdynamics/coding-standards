use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF50:
    standard: @{CppCoreGuidelines}
    ruleId: F.50
    title: Write a lambda when a plain function cannot capture what you need
    statement:
        Pick a lambda when you need to capture locals or define a function
        inside a block. Pick a function when you need overloads. If both fit, a
        function is simpler.
    rationale:
        Lambdas can capture state and live in local scope, which functions
        cannot. Functions can be overloaded, which lambdas cannot. Use the least
        powerful tool that does the job.
    exceptions:
        A generic lambda is a short way to write a function template, so it can
        be handy even where an ordinary template would do.
    severity: null
    noncompliant:
        ```cpp
        \\\
        struct AboveLimit {               // hand-written to capture limit
            int limit;
            bool operator()(int x) const { return x > limit; }
        };
        auto n = std::count_if(v.begin(), v.end(), AboveLimit{limit});
        \\\
        ```
    compliant:
        ```cpp
        \\\
        auto n = std::count_if(v.begin(), v.end(),
                               [limit](int x) { return x > limit; });
        \\\
        ```
    languages: [cpp]
    tags: [functions, lambdas]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-capture-vs-overload
