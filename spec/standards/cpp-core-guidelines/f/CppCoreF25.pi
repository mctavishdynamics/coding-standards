use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF25:
    standard: @{CppCoreGuidelines}
    ruleId: F.25
    title: Mark pointers to C strings with a zstring alias
    statement:
        Mark a pointer to a zero-terminated character array with the GSL alias
        zstring or czstring, and wrap it in not_null if it can never be null. If
        the terminator is not needed, use string_view.
    rationale:
        A bare char* could point to one character, a raw byte buffer or a C
        string. The alias says which, and it makes clear the pointer does not
        own the text.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::size_t name_length(const char* name);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::size_t name_length(gsl::not_null<gsl::czstring> name);

        std::size_t title_length(std::string_view title);
        \\\
        ```
    languages: [cpp]
    tags: [functions, strings, pointers]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-zstring
