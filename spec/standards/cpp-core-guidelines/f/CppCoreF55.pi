use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF55:
    standard: @{CppCoreGuidelines}
    ruleId: F.55
    title: Avoid C varargs for passing arguments
    statement:
        Do not define functions with C-style ... argument lists. Use a variadic
        template, overloads or an initializer_list.
    rationale:
        With va_arg, the callee guesses the type of each argument and nothing in
        the language checks the guess. Safety rests entirely on the programmer.
    exceptions:
        A ... parameter is fine when no argument is ever read from it, as in a
        catch-all overload or a metaprogramming trick.
    severity: null
    noncompliant:
        ```cpp
        \\\
        int sum(int count, ...) {
            va_list args;
            va_start(args, count);
            int total = 0;
            for (int i = 0; i < count; ++i) total += va_arg(args, int);
            va_end(args);
            return total;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<typename... Ints>
        int sum(Ints... values) {
            return (0 + ... + values);
        }
        \\\
        ```
    languages: [cpp]
    tags: [functions, type-safety, varargs]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#f-varargs
