use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF54:
    standard: @{CppCoreGuidelines}
    ruleId: F.54
    title: Capture this explicitly instead of relying on a value default capture
    statement:
        Inside a member function, name the captures, and write this explicitly
        when you mean it. Do not rely on the value default capture. Capture
        *this if the lambda needs its own copy of the object.
    rationale:
        The value default looks as if it copies everything. In fact members are
        reached through a copied this pointer, so they behave as if captured by
        reference.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        auto Timer::callback() {
            return [=] { return elapsed_; };   // really uses this->elapsed_
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        auto Timer::callback() {
            return [this] { return elapsed_; };
        }
        \\\
        ```
    languages: [cpp]
    tags: [functions, lambdas, captures]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-this-capture
