use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF6:
    standard: @{CppCoreGuidelines}
    ruleId: F.6
    title: Mark functions that must never throw noexcept
    statement:
        Add noexcept to functions that must not fail with an exception,
        especially destructors, swap, move operations and default constructors.
        Think about each case instead of marking every function.
    rationale:
        When an exception escapes a noexcept function the program terminates at
        once, which is the right outcome if nothing could handle it. Fewer
        possible exception paths also let the compiler generate tighter code.
    exceptions:
        On a virtual function or a public API, noexcept binds every present and
        future implementation. Add it there only after careful thought.
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Buffer {
        public:
            Buffer(Buffer&& other);            // may throw, so vector copies instead
            void swap(Buffer& other);
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Buffer {
        public:
            Buffer(Buffer&& other) noexcept;
            void swap(Buffer& other) noexcept;
        };
        \\\
        ```
    languages: [cpp]
    tags: [functions, exceptions, noexcept]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-noexcept
