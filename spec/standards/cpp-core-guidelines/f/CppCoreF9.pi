use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF9:
    standard: @{CppCoreGuidelines}
    ruleId: F.9
    title: Omit the names of parameters a function ignores
    statement:
        Leave out the name of a parameter that the function never uses but the
        signature requires. If it goes unused only in some builds, keep the name
        and add the maybe_unused attribute.
    rationale:
        A nameless parameter tells readers the omission is deliberate. It also
        silences compiler warnings about unused parameters.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void on_resize(Window& window, int width, int height) {
            redraw(window);
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void on_resize(Window& window, int /*width*/, int /*height*/) {
            redraw(window);
        }
        \\\
        ```
    languages: [cpp]
    tags: [functions, parameters, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-unused
