use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF2:
    standard: @{CppCoreGuidelines}
    ruleId: F.2
    title: Give each function one job
    statement:
        Each function should have a single responsibility. Split a function
        that, say, parses input, computes a result and prints it into one
        function per step.
    rationale:
        Small focused functions are quicker to understand. They are also easier
        to test on their own and to reuse elsewhere.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void read_and_print_sum(std::istream& in) {
            int sum = 0;
            for (int x; in >> x;) sum += x;
            std::cout << "sum: " << sum << '\n';
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::vector<int> read_ints(std::istream& in);
        int sum(const std::vector<int>& values);
        void print_sum(std::ostream& out, int sum);
        \\\
        ```
    languages: [cpp]
    tags: [functions, design, cohesion]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-logical
