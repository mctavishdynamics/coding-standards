use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF8:
    standard: @{CppCoreGuidelines}
    ruleId: F.8
    title: Favour functions without side effects
    statement:
        Where you can, write functions that compute their result only from their
        arguments and change nothing else.
    rationale:
        Such a function can be tested and understood by itself. Its results can
        be cached, and calls can be reordered or run in parallel without risk.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int offset = 0;

        int next_index(int i) {
            offset += i;           // hidden side effect
            return offset;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int next_index(int offset, int i) {
            return offset + i;
        }
        \\\
        ```
    languages: [cpp]
    tags: [functions, purity, side-effects]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-pure
