use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF26:
    standard: @{CppCoreGuidelines}
    ruleId: F.26
    title: Hand over ownership through a unique_ptr when a pointer is required
    statement:
        Use unique_ptr when ownership has to move through a pointer, for example
        when a factory returns an object through its base class.
    rationale:
        unique_ptr makes the transfer visible in the type and adds virtually no
        overhead. It is the cheapest safe owning pointer.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Shape* make_shape(Kind kind);   // caller must remember to delete
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::unique_ptr<Shape> make_shape(Kind kind);
        \\\
        ```
    languages: [cpp]
    tags: [functions, ownership, smart-pointers]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-unique_ptr
