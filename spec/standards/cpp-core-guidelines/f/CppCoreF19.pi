use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF19:
    standard: @{CppCoreGuidelines}
    ruleId: F.19
    title: Take forwarding parameters as forwarding references and forward them once
    statement:
        If a function only relays an argument to another call, declare the
        parameter as a forwarding reference TP&& on a template parameter. Pass
        it along once with std::forward and use it for nothing else.
    rationale:
        Forwarding keeps the argument's const qualification and its lvalue or
        rvalue nature intact. The final callee therefore receives exactly what
        the original caller gave.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        template<class T, class Arg>
        std::unique_ptr<T> make(Arg arg) {           // copies and loses rvalue-ness
            return std::unique_ptr<T>(new T(arg));
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<class T, class Arg>
        std::unique_ptr<T> make(Arg&& arg) {
            return std::unique_ptr<T>(new T(std::forward<Arg>(arg)));
        }
        \\\
        ```
    languages: [cpp]
    tags: [functions, parameters, templates, move-semantics]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-forward
