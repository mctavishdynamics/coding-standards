use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF43:
    standard: @{CppCoreGuidelines}
    ruleId: F.43
    title: Never hand back a pointer or reference to a local variable
    statement:
        A non-static local variable must not be reachable after its function
        ends. Do not return its address, store it through an out parameter, put
        it in a returned object or save it in a longer-lived container.
    rationale:
        The local dies when the function returns. Anything still pointing at it
        dangles, and using it corrupts memory or crashes.
    exceptions:
        This applies only to automatic locals. A pointer to a static variable
        remains valid.
    severity: null
    noncompliant:
        ```cpp
        \\\
        const std::string& greeting(const std::string& name) {
            std::string s = "Hello, " + name;
            return s;                // dangling reference
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::string greeting(const std::string& name) {
            return "Hello, " + name;
        }
        \\\
        ```
    languages: [cpp]
    tags: [functions, lifetime, dangling-pointers]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-dangle
