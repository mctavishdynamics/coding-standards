use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF22:
    standard: @{CppCoreGuidelines}
    ruleId: F.22
    title: Use a plain pointer to refer to one object
    statement:
        Let a plain T* mean exactly one thing: a non-owning pointer to a single
        object. Use GSL owner for owning pointers and other types such as span
        or string_view for arrays and text.
    rationale:
        Old C and C++ code used raw pointers for ownership, arrays, strings and
        iterators alike. When T* has one meaning, both readers and analysis
        tools can understand it.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void process(int* p);   // one int? an array? who frees it?
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void process(int* value);                // single object, not owned
        void process_all(std::span<int> values);
        gsl::owner<Node*> make_node();
        \\\
        ```
    languages: [cpp]
    tags: [functions, pointers, ownership]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-ptr
