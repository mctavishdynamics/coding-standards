use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF1:
    standard: @{CppCoreGuidelines}
    ruleId: F.1
    title: Wrap each meaningful step in a well-named function
    statement:
        If a block of code does one clear task, move it into a function and name
        the function after that task. Give a name to a lambda too once it is big
        enough to reuse.
    rationale:
        Named functions read like a summary of the work. They can be called from
        other places, and short pieces are easier to get right than one long
        stretch of logic.
    exceptions:
        A loop body, a lambda that serves as one, or a callback written for a
        single call usually needs no name of its own. Very long loop bodies are
        a different problem and should be shortened.
    severity: null
    noncompliant:
        ```cpp
        \\\
        void report(const std::vector<Order>& orders) {
            double total = 0;
            for (const auto& o : orders)
                if (o.paid) total += o.amount * (1 + o.tax_rate);
            std::cout << total << '\n';
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        double paid_total(const std::vector<Order>& orders) {
            double total = 0;
            for (const auto& o : orders)
                if (o.paid) total += o.amount * (1 + o.tax_rate);
            return total;
        }

        void report(const std::vector<Order>& orders) {
            std::cout << paid_total(orders) << '\n';
        }
        \\\
        ```
    languages: [cpp]
    tags: [functions, naming, modularity]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-package
