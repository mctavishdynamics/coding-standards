use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF11:
    standard: @{CppCoreGuidelines}
    ruleId: F.11
    title: Write a one-off function object inline as a lambda
    statement:
        When a function object is short and needed only once, write it as a
        lambda right where it is used.
    rationale:
        The logic then sits next to the call that uses it, and there is no extra
        declaration to look up.
    exceptions:
        Giving a single-use lambda a name may still be worthwhile if the name
        explains it better.
    severity: null
    noncompliant:
        ```cpp
        \\\
        struct ByLength {
            bool operator()(const std::string& a, const std::string& b) const {
                return a.size() < b.size();
            }
        };
        std::sort(words.begin(), words.end(), ByLength());
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::sort(words.begin(), words.end(),
                  [](const std::string& a, const std::string& b) {
                      return a.size() < b.size();
                  });
        \\\
        ```
    languages: [cpp]
    tags: [functions, lambdas]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-lambda
