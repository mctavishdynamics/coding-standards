use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF17:
    standard: @{CppCoreGuidelines}
    ruleId: F.17
    title: Pass parameters a function reads and updates by non-const reference
    statement:
        Use a reference to non-const for a parameter that the function both
        reads and changes.
    rationale:
        The signature then warns every caller that the argument may come back
        modified.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void normalize(Vector* v);   // may v be null? is it modified?
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void normalize(Vector& v);
        \\\
        ```
    languages: [cpp]
    tags: [functions, parameters, references]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-inout
