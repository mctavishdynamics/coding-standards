use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF56:
    standard: @{CppCoreGuidelines}
    ruleId: F.56
    title: Flatten conditions instead of nesting them deeply
    statement:
        Avoid deep nesting of conditions. Handle error cases first and return
        early, so the main logic stays at the top level, unless doing so makes
        the purpose harder to see.
    rationale:
        Code with few levels of indentation is easier to read, and its main path
        stands out.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void send(const Message& m) {
            if (connected_) {
                if (!m.empty()) {
                    transmit(m);
                }
            }
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void send(const Message& m) {
            if (!connected_ || m.empty()) return;
            transmit(m);
        }
        \\\
        ```
    languages: [cpp]
    tags: [functions, control-flow, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#f-nesting
