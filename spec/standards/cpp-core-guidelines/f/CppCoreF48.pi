use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF48:
    standard: @{CppCoreGuidelines}
    ruleId: F.48
    title: Return local variables plainly, without std::move
    statement:
        When returning a local variable, write just its name. Do not wrap it
        in std::move.
    rationale:
        The compiler already treats a returned local as an rvalue.
        Adding std::move blocks return value optimization, which might have removed the
        move altogether.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::vector<int> squares(int n) {
            std::vector<int> v;
            for (int i = 0; i < n; ++i) v.push_back(i * i);
            return std::move(v);
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::vector<int> squares(int n) {
            std::vector<int> v;
            for (int i = 0; i < n; ++i) v.push_back(i * i);
            return v;
        }
        \\\
        ```
    languages: [cpp]
    tags: [functions, return-values, move-semantics]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-return-move-local
