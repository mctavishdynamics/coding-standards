use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF7:
    standard: @{CppCoreGuidelines}
    ruleId: F.7
    title: Take plain pointers or references unless ownership is involved
    statement:
        If a function just uses an object, give it a T& or T* parameter. Reserve
        smart pointer parameters for functions that take, share or change
        ownership.
    rationale:
        A smart pointer parameter forces callers to hold the object in that
        exact smart pointer. Passing shared_ptr also costs reference count
        updates.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void render(const std::shared_ptr<Widget>& w) {
            w->draw();
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void render(const Widget& w) {
            w.draw();
        }
        \\\
        ```
    languages: [cpp]
    tags: [functions, parameters, smart-pointers]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-smart
