use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF60:
    standard: @{CppCoreGuidelines}
    ruleId: F.60
    title: Take a pointer instead of a reference when no argument is allowed
    statement:
        Take T* when calling without an object is a valid choice, and test it
        for nullptr. Take T& when an object must always be supplied.
    rationale:
        A pointer may be null and a reference may not. The parameter type
        therefore tells callers whether the argument is optional, and a
        reference is also easier to use.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void draw(const Shape& shape, const Style& style);   // callers fake a style
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void draw(const Shape& shape, const Style* style = nullptr) {
            if (style) apply(*style);
            // ...
        }
        \\\
        ```
    languages: [cpp]
    tags: [functions, parameters, pointers]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-ptr-ref
