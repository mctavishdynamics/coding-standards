use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF45:
    standard: @{CppCoreGuidelines}
    ruleId: F.45
    title: Avoid returning rvalue references
    statement:
        Do not give a function a return type of T&&.
    rationale:
        An rvalue reference binds readily to temporaries. A function that
        returns one will almost always end up referring to a temporary that is
        already gone.
    exceptions:
        The helpers std::move and std::forward return T&&, but they act as casts
        whose result is consumed in the same expression. No other good use is
        known.
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::string&& make_label(int id) {
            return std::move(std::to_string(id));   // refers to a dead temporary
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::string make_label(int id) {
            return std::to_string(id);
        }
        \\\
        ```
    languages: [cpp]
    tags: [functions, return-values, lifetime]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-return-ref-ref
