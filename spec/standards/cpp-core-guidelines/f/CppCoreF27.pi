use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF27:
    standard: @{CppCoreGuidelines}
    ruleId: F.27
    title: Share ownership through a shared_ptr
    statement:
        Use shared_ptr when several parties must keep one object alive and the
        last of them should destroy it. If only one owner exists at any time,
        use unique_ptr.
    rationale:
        shared_ptr is the standard tool for joint ownership. Its reference
        counting is not free, so do not reach for it without a reason.
    exceptions:
        Another option is to give ownership to one scoped object that outlives
        every user and deletes the shared object at the end.
    severity: null
    noncompliant:
        ```cpp
        \\\
        Texture* tex = load("stone.png");
        a.set_texture(tex);
        b.set_texture(tex);   // which one deletes it?
        \\\
        ```
    compliant:
        ```cpp
        \\\
        auto tex = std::make_shared<Texture>("stone.png");
        a.set_texture(tex);
        b.set_texture(tex);
        \\\
        ```
    languages: [cpp]
    tags: [functions, ownership, smart-pointers]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-shared_ptr
