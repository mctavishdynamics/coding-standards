use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF10:
    standard: @{CppCoreGuidelines}
    ruleId: F.10
    title: Give reusable operations a name of their own
    statement:
        Any operation that appears, or might appear, in more than one place
        deserves a name, whether it is a function, a lambda or an operator.
    rationale:
        The name explains what the code does. It makes call sites easier to read
        and lets other code reuse the operation.
    exceptions:
        A lambda that only makes sense in one spot, such as an argument to an
        algorithm, or a lambda used to initialize a variable, can stay unnamed.
    severity: null
    noncompliant:
        ```cpp
        \\\
        auto a = std::find_if(v.begin(), v.end(),
            [](const User& u) { return u.active && u.age >= 18; });
        auto b = std::count_if(v.begin(), v.end(),
            [](const User& u) { return u.active && u.age >= 18; });
        \\\
        ```
    compliant:
        ```cpp
        \\\
        auto is_active_adult = [](const User& u) { return u.active && u.age >= 18; };

        auto a = std::find_if(v.begin(), v.end(), is_active_adult);
        auto b = std::count_if(v.begin(), v.end(), is_active_adult);
        \\\
        ```
    languages: [cpp]
    tags: [functions, naming, reuse]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-name
