use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF24:
    standard: @{CppCoreGuidelines}
    ruleId: F.24
    title: Pass ranges of elements as a span
    statement:
        Pass a sequence of elements as a span, or as span_p if a predicate marks
        its end. Do not pass a pointer with a separate element count.
    rationale:
        Given just a pointer and a number, nobody can verify that that many
        elements really exist there. A span keeps the two together, owns nothing
        and costs about the same as two pointers to pass.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void zero(int* p, int n) {
            for (int i = 0; i < n; ++i) p[i] = 0;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void zero(std::span<int> values) {
            for (int& v : values) v = 0;
        }
        \\\
        ```
    languages: [cpp]
    tags: [functions, bounds, span]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-range
