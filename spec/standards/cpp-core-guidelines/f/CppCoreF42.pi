use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF42:
    standard: @{CppCoreGuidelines}
    ruleId: F.42
    title: Return a raw pointer only to say where something is
    statement:
        Return a T* only to point at an object that already exists elsewhere,
        such as an element found by a search. Never use it to give the caller
        ownership.
    rationale:
        Pointing at a location is the natural job of a pointer. Using one to
        hand over ownership invites leaks, because callers assume they need not
        delete it.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Node* clone(const Node& n) {
            return new Node(n);         // returns ownership through T*
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        Node* find(Node* head, int key) {
            for (Node* p = head; p; p = p->next)
                if (p->key == key) return p;
            return nullptr;
        }
        \\\
        ```
    languages: [cpp]
    tags: [functions, pointers, ownership]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-return-ptr
