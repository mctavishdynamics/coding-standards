use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF20:
    standard: @{CppCoreGuidelines}
    ruleId: F.20
    title: Return results instead of writing them through parameters
    statement:
        Hand results back through the return value, not through a reference or
        pointer parameter. Even large objects such as vectors should be
        returned.
    rationale:
        The return type tells readers what comes out, while an out parameter
        could just as well be read as input. Return value optimization and move
        semantics keep returning a container cheap.
    exceptions:
        Moving a struct with many members can add up, and refilling an existing
        object may save repeated allocation. In such cases an out parameter can
        be justified.
    severity: null
    noncompliant:
        ```cpp
        \\\
        void split(const std::string& s, std::vector<std::string>& parts);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::vector<std::string> split(const std::string& s);
        \\\
        ```
    languages: [cpp]
    tags: [functions, return-values]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-out
