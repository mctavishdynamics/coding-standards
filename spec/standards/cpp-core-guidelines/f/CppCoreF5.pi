use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF5:
    standard: @{CppCoreGuidelines}
    ruleId: F.5
    title: Mark only tiny, hot functions inline
    statement:
        Use inline only for very small functions that are called often, or
        define them inside the class. Measure whether it helps.
    rationale:
        Compilers do not always inline well without a hint. The keyword nudges
        them toward it.
    exceptions:
        An inline function is baked into callers, so it becomes part of the ABI.
        Avoid it in a stable interface unless the body will never change.
        Templates and in-class member definitions are already inline, and a body
        longer than a few statements rarely benefits.
    severity: null
    noncompliant:
        ```cpp
        \\\
        // point.cpp, called millions of times per frame
        double Point::length_squared() const {
            return x * x + y * y;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // point.h
        inline double length_squared(const Point& p) {
            return p.x * p.x + p.y * p.y;
        }
        \\\
        ```
    languages: [cpp]
    tags: [functions, inline, performance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-inline
