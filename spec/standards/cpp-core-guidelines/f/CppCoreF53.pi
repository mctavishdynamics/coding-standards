use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF53:
    standard: @{CppCoreGuidelines}
    ruleId: F.53
    title: Capture by value in lambdas that may outlive the scope
    statement:
        Capture by value when a lambda may still exist after the enclosing scope
        ends, for example when it is returned, stored or run on another thread.
    rationale:
        A reference capture holds a reference to a local. If the lambda or a
        copy survives the scope, that reference dangles.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::function<int()> make_counter() {
            int count = 0;
            return [&count] { return ++count; };   // count dies on return
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::function<int()> make_counter() {
            int count = 0;
            return [count]() mutable { return ++count; };
        }
        \\\
        ```
    languages: [cpp]
    tags: [functions, lambdas, captures, lifetime]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-value-capture
