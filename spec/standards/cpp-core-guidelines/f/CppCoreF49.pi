use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF49:
    standard: @{CppCoreGuidelines}
    ruleId: F.49
    title: Avoid const on by-value return types
    statement:
        Do not mark a type returned by value as const.
    rationale:
        Returning const values was once advised but no longer is. The const
        gives no benefit and stops the caller from moving out of the result.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        const std::string full_name(const Person& p);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::string full_name(const Person& p);
        \\\
        ```
    languages: [cpp]
    tags: [functions, return-values, move-semantics]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-return-const
