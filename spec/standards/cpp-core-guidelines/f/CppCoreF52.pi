use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF52:
    standard: @{CppCoreGuidelines}
    ruleId: F.52
    title: Capture by reference in lambdas that do not outlive the scope
    statement:
        A lambda that only runs while the current scope is alive may capture by
        reference. This covers lambdas passed to algorithms and to local
        parallel work that finishes before the function returns.
    rationale:
        Reference capture avoids copying and lets the lambda change local
        variables. It is safe because the lambda cannot outlive what it refers
        to.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::vector<std::string> names = load();
        std::for_each(ids.begin(), ids.end(),
                      [names](int id) { log(names[id]); });   // copies the vector
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::vector<std::string> names = load();
        std::for_each(ids.begin(), ids.end(),
                      [&names](int id) { log(names[id]); });
        \\\
        ```
    languages: [cpp]
    tags: [functions, lambdas, captures]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-reference-capture
