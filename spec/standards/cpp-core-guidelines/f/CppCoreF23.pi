use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF23:
    standard: @{CppCoreGuidelines}
    ruleId: F.23
    title: Mark pointers that can never be null with not_null
    statement:
        Declare a pointer parameter or return type as not_null when it must
        always refer to an object.
    rationale:
        For a parameter, it puts the burden of avoiding null on the caller. For
        a result, it tells callers they need not check. The wrapper adds no run-
        time cost and works with smart pointers too.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int length(const char* text);   // must text be non-null?
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int length(gsl::not_null<const char*> text);
        \\\
        ```
    languages: [cpp]
    tags: [functions, pointers, null-safety]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-nullptr
