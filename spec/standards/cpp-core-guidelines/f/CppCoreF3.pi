use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreF3:
    standard: @{CppCoreGuidelines}
    ruleId: F.3
    title: Keep each function brief and easy to follow
    statement:
        Keep functions small enough to see at a glance, with straightforward
        control flow. Split a large function into a few named helpers that each
        do one part.
    rationale:
        Long functions are hard to follow and tend to keep variables alive
        longer than needed. Tangled branching is where logic errors hide.
        Functions of a handful of lines should be common.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int classify(const Reading& r) {
            if (r.valid) {
                if (r.value > 100) {
                    if (r.sensor == Sensor::temp) { /* 30 lines */ }
                    else { /* 30 lines */ }
                } else { /* 40 lines */ }
            }
            return -1;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int classify(const Reading& r) {
            if (!r.valid) return -1;
            return r.value > 100 ? classify_high(r) : classify_normal(r);
        }
        \\\
        ```
    languages: [cpp]
    tags: [functions, simplicity, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rf-single
