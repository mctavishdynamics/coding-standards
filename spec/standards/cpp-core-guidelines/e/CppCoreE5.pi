use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreE5:
    standard: @{CppCoreGuidelines}
    ruleId: E.5
    title: Have constructors set up the invariant or throw
    statement:
        A constructor must either leave the object satisfying its class invariant or
        throw. Do not return a partially initialized object.
    rationale:
        The other member functions assume the invariant holds. With a half-built
        object some of them cannot be called safely, and bugs follow.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Percentage {
        public:
            explicit Percentage(int value) : value_(value) {}   // accepts 250
            bool valid() const { return value_ >= 0 && value_ <= 100; }
        private:
            int value_;
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Percentage {
        public:
            explicit Percentage(int value) : value_(value)
            {
                if (value < 0 || value > 100)
                    throw std::out_of_range("percentage must be between 0 and 100");
            }
        private:
            int value_;   // always between 0 and 100
        };
        \\\
        ```
    languages: [cpp]
    tags: [error-handling, constructors, invariants]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#re-invariant
