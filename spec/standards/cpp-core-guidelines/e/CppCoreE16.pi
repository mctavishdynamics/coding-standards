use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreE16:
    standard: @{CppCoreGuidelines}
    ruleId: E.16
    title: Keep destructors, deallocation, swap and exception copies from failing
    statement:
        Destructors, deallocation functions, swap operations and the copy and move
        constructors of exception classes must not fail or throw. Declare them
        noexcept.
    rationale:
        Reliable error handling depends on these operations always succeeding. The
        standard library is built on that assumption, and its guarantees fall apart
        when one of them throws.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Connection::~Connection()
        {
            if (!close_socket(fd_))
                throw NetworkError("close failed");
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        Connection::~Connection()
        {
            if (!close_socket(fd_))
                report_close_failure(fd_);   // noexcept logging, no throw
        }
        \\\
        ```
    languages: [cpp]
    tags: [error-handling, noexcept, destructors]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#re-never-fail
