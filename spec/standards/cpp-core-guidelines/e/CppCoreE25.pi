use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreE25:
    standard: @{CppCoreGuidelines}
    ruleId: E.25
    title: Emulate scope-based cleanup when exceptions are unavailable
    statement:
        When exceptions are off, keep using handle classes whose destructors free
        their resources. Give each one a way to signal that construction failed,
        such as a valid() member, and test it immediately after creating the object.
    rationale:
        Automatic release in destructors is still far safer than freeing things by
        hand, even with no exceptions in play. Callers must remember the check, and
        marking the test function nodiscard makes forgetting it harder.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int run(const char* path)
        {
            FILE* f = std::fopen(path, "r");
            if (!f) return -1;
            if (!parse(f)) return -2;   // f leaks
            std::fclose(f);
            return 0;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int run(const char* path)
        {
            File f(path);               // destructor closes the file
            if (!f.valid()) return -1;
            if (!parse(f)) return -2;
            return 0;
        }
        \\\
        ```
    languages: [cpp]
    tags: [error-handling, raii, no-exceptions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#re-no-throw-raii
