use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreE17:
    standard: @{CppCoreGuidelines}
    ruleId: E.17
    title: Catch exceptions only where they can be handled
    statement:
        Write a catch clause only in a function that can recover from the failure or
        turn it into a different error. In all other functions let the exception
        pass through, and let destructors release resources while the stack unwinds.
    rationale:
        A handler that can do nothing useful adds paths through the code, hides
        where the problem really began and costs run time.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void load_settings()
        {
            try {
                read_settings_file();
            } catch (...) {
                throw;   // catches only to rethrow
            }
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void load_settings()
        {
            read_settings_file();
        }
        \\\
        ```
    languages: [cpp]
    tags: [error-handling, exceptions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#re-not-always
