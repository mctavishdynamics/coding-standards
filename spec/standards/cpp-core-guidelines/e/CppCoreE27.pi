use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreE27:
    standard: @{CppCoreGuidelines}
    ruleId: E.27
    title: Return error codes consistently when exceptions are unavailable
    statement:
        When exceptions are unavailable, choose a single error-reporting convention,
        such as a result struct with value and error members or a validity flag.
        Check it after every call and free resources on every failing path.
    rationale:
        A uniform convention tells each caller exactly what to test, and a missing
        check stands out during review.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Connection open_connection(const std::string& host);   // failure: empty object or id() == -1

        void sync(const std::string& host)
        {
            Connection c = open_connection(host);
            c.send(snapshot());   // failure never checked
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        struct OpenResult {
            Connection conn;
            Status status;
        };

        [[nodiscard]] OpenResult open_connection(const std::string& host);

        void sync(const std::string& host)
        {
            auto res = open_connection(host);
            if (res.status != Status::ok) {
                log_failure(res.status);
                return;
            }
            res.conn.send(snapshot());
        }
        \\\
        ```
    languages: [cpp]
    tags: [error-handling, error-codes, no-exceptions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#re-no-throw-codes
