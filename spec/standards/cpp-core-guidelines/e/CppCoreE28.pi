use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreE28:
    standard: @{CppCoreGuidelines}
    ruleId: E.28
    title: Avoid reporting errors through global state
    statement:
        Report a failure by returning it or throwing it, not by setting a global
        flag for callers to look at.
    rationale:
        Callers routinely forget to inspect global error state, and it is awkward to
        manage, especially with threads.
    exceptions:
        C library functions signal errors through errno, so code that calls them
        cannot avoid this style entirely.
    severity: null
    noncompliant:
        ```cpp
        \\\
        int last_error = 0;

        Buffer* allocate(std::size_t n)
        {
            auto* b = static_cast<Buffer*>(std::malloc(n));
            if (!b) last_error = ENOMEM;
            return b;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::expected<Buffer*, std::errc> allocate(std::size_t n)
        {
            auto* b = static_cast<Buffer*>(std::malloc(n));
            if (!b) return std::unexpected(std::errc::not_enough_memory);
            return b;
        }
        \\\
        ```
    languages: [cpp]
    tags: [error-handling, global-state]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#re-no-throw
