use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreE3:
    standard: @{CppCoreGuidelines}
    ruleId: E.3
    title: Throw exceptions only for errors, not for ordinary control flow
    statement:
        Keep exceptions for real errors. Do not throw to signal that a search found
        its target, that input ran out or that a loop is done.
    rationale:
        This keeps failure handling apart from the regular logic. Compilers also
        assume exceptions are uncommon and make the normal path fast at the expense
        of the throwing one.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::size_t position_of(const std::vector<int>& v, int target)
        {
            try {
                for (std::size_t i = 0; i < v.size(); ++i)
                    if (v[i] == target) throw i;
            } catch (std::size_t found) {
                return found;
            }
            return v.size();
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::size_t position_of(const std::vector<int>& v, int target)
        {
            auto it = std::find(v.begin(), v.end(), target);
            return static_cast<std::size_t>(it - v.begin());
        }
        \\\
        ```
    languages: [cpp]
    tags: [error-handling, exceptions, control-flow]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#re-errors
