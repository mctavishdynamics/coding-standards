use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreE4:
    standard: @{CppCoreGuidelines}
    ruleId: E.4
    title: Design your error-handling strategy around invariants
    statement:
        Base the error-handling design on class invariants. Every object
        must be in a valid state to be used, and after recovering from an
        error every object that was not destroyed must still satisfy its
        invariant.
    rationale:
        An object can only be used safely when its invariant holds, so
        recovery is only meaningful if errors never leave surviving objects
        in a broken state.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [error-handling, invariants, design]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#re-design-invariants
