use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreE4:
    standard: @{CppCoreGuidelines}
    ruleId: E.4
    title: Build the error strategy around the invariants each type keeps
    statement:
        Design error handling around class invariants. An object may only be used
        while its invariant holds, and once an error has been handled, every object
        still alive must satisfy its invariant again.
    rationale:
        Member functions depend on the invariant, so recovering is pointless if it
        leaves some object broken.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [error-handling, invariants, design]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#re-design-invariants
