use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreE7:
    standard: @{CppCoreGuidelines}
    ruleId: E.7
    title: Spell out what a function needs from its caller
    statement:
        Write down what a function demands of its inputs, ideally as code such as
        Expects or an assertion, instead of leaving callers to guess.
    rationale:
        A visible precondition stops callers from passing values the function was
        never meant to handle.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        double average(const std::vector<double>& values)
        {
            return std::accumulate(values.begin(), values.end(), 0.0) / values.size();
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        double average(const std::vector<double>& values)
        {
            Expects(!values.empty());
            return std::accumulate(values.begin(), values.end(), 0.0) / values.size();
        }
        \\\
        ```
    languages: [cpp]
    tags: [error-handling, contracts, interfaces]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#re-precondition
