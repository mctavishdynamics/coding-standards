use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreE19:
    standard: @{CppCoreGuidelines}
    ruleId: E.19
    title: Run cleanup through a scope guard when no resource class fits
    statement:
        If a cleanup step has no handle class to perform it, wrap it in gsl::finally
        or a similar final_action object. Treat this as a fallback, used only after
        you have looked for a proper RAII type.
    rationale:
        The guard sits right beside the acquisition and runs on every way out of the
        scope. It is shorter and safer than a try block or a goto to a cleanup
        label. A real resource class remains the better design when one is
        practical.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void stage(std::size_t n)
        {
            void* area = std::malloc(n);
            if (!fill(area, n)) goto done;
            commit(area, n);
        done:
            std::free(area);
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void stage(std::size_t n)
        {
            void* area = std::malloc(n);
            auto release = gsl::finally([area] { std::free(area); });
            if (!fill(area, n)) return;
            commit(area, n);
        }
        \\\
        ```
    languages: [cpp]
    tags: [error-handling, raii, cleanup]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#re-finally
