use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreE6:
    standard: @{CppCoreGuidelines}
    ruleId: E.6
    title: Rely on scope-bound owners so resources cannot leak
    statement:
        Give every resource to an owning object, such as a container, smart pointer
        or file stream, whose destructor frees it. That way release happens on every
        exit, exceptions included. A local object beats a pointer when you do not
        need pointer semantics.
    rationale:
        Freeing resources by hand is error-prone, more so when many statements can
        throw, and leaks are rarely acceptable. RAII is the plainest and most
        consistent fix.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void parse(const std::string& text)
        {
            char* buffer = new char[text.size() + 1];
            tokenize(text, buffer);   // if this throws, buffer leaks
            delete[] buffer;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void parse(const std::string& text)
        {
            std::vector<char> buffer(text.size() + 1);
            tokenize(text, buffer.data());
        }
        \\\
        ```
    languages: [cpp]
    tags: [error-handling, raii, resources]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#re-raii
