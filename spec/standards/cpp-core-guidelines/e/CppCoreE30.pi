use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreE30:
    standard: @{CppCoreGuidelines}
    ruleId: E.30
    title: Do not write dynamic exception specifications
    statement:
        Never write a throw list naming the exception types a function may raise.
        When a function must not throw, mark it noexcept.
    rationale:
        Such lists were checked at run time, which cost time and terminated the
        program when a deep library change added a new exception type. Keeping them
        accurate forced edits along whole call chains, and the language has since
        dropped them.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Order parse_order(const std::string& text) throw(ParseError, std::bad_alloc);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        Order parse_order(const std::string& text);
        \\\
        ```
    languages: [cpp]
    tags: [error-handling, exceptions, legacy]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#re-specifications
