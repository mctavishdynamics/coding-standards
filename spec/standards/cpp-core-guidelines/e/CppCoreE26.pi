use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreE26:
    standard: @{CppCoreGuidelines}
    ruleId: E.26
    title: Consider terminating promptly when exceptions are unavailable
    statement:
        Without exceptions, if the function that detects a failure cannot deal with
        it and there is no systematic error path, record why and stop the program
        with abort, quick_exit or a similar call that leads to a restart.
    rationale:
        When good recovery is out of reach, stopping early contains the harm. In
        systems designed to tolerate crashes, it passes the problem up to the
        supervising layer.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Frame* frames = static_cast<Frame*>(std::malloc(count * sizeof(Frame)));
        // used without a check; may dereference null much later
        frames[0].reset();
        \\\
        ```
    compliant:
        ```cpp
        \\\
        Frame* frames = static_cast<Frame*>(std::malloc(count * sizeof(Frame)));
        if (!frames) {
            log_fatal("out of memory allocating frames");
            std::abort();
        }
        frames[0].reset();
        \\\
        ```
    languages: [cpp]
    tags: [error-handling, no-exceptions, fail-fast]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#re-no-throw-crash
