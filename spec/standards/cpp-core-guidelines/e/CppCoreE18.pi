use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreE18:
    standard: @{CppCoreGuidelines}
    ruleId: E.18
    title: Keep try blocks rare
    statement:
        Rely on RAII handles, or a final_action when nothing else fits, so that try
        blocks are rarely needed.
    rationale:
        Non-trivial try and catch code is wordy and easy to get wrong. A function
        full of it usually means resources or errors are being managed by hand at
        too low a level.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void print(const std::string& name)
        {
            Printer* p = nullptr;
            try {
                p = new Printer(name);
                p->print_test_page();
                delete p;
            } catch (...) {
                delete p;
                throw;
            }
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void print(const std::string& name)
        {
            Printer p(name);
            p.print_test_page();
        }
        \\\
        ```
    languages: [cpp]
    tags: [error-handling, exceptions, raii]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#re-catch
