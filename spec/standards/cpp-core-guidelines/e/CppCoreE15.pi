use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreE15:
    standard: @{CppCoreGuidelines}
    ruleId: E.15
    title: Throw objects by value and catch them by reference
    statement:
        Throw exception objects themselves, not pointers to them. Catch polymorphic
        exceptions through a reference, normally const. To rethrow, write throw with
        no operand.
    rationale:
        A by-value catch copies the object and cuts a derived exception down to its
        base part. A plain throw sends on the original object with its full dynamic
        type.
    exceptions:
        Catching small, non-polymorphic types by value, such as an enumerator, is
        harmless.
    severity: null
    noncompliant:
        ```cpp
        \\\
        try {
            throw new ParseError("bad header");
        } catch (std::exception e) {   // slices; and the pointer is never caught here
            log(e.what());
            throw e;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        try {
            throw ParseError("bad header");
        } catch (const std::exception& e) {
            log(e.what());
            throw;
        }
        \\\
        ```
    languages: [cpp]
    tags: [error-handling, exceptions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#re-exception-ref
