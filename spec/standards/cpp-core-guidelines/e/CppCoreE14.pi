use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreE14:
    standard: @{CppCoreGuidelines}
    ruleId: E.14
    title: Throw types made specifically to describe the error
    statement:
        Define an exception class for each kind of failure, for example by deriving
        from std::runtime_error, and throw that. Avoid throwing an int, a string
        literal or a plain std::exception.
    rationale:
        The type tells the handler what went wrong and can carry details along with
        it. Purpose-built types also do not collide with exceptions thrown by
        unrelated libraries.
    exceptions:
        When a standard type such as std::invalid_argument already says everything
        and there is nothing to add, throwing it is acceptable.
    severity: null
    noncompliant:
        ```cpp
        \\\
        if (balance < amount)
            throw -1;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class InsufficientFunds : public std::runtime_error {
        public:
            explicit InsufficientFunds(long shortfall)
                : std::runtime_error("insufficient funds"), shortfall(shortfall) {}
            long shortfall;
        };

        if (balance < amount)
            throw InsufficientFunds{amount - balance};
        \\\
        ```
    languages: [cpp]
    tags: [error-handling, exceptions, types]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#re-exception-types
