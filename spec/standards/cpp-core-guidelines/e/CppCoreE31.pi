use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreE31:
    standard: @{CppCoreGuidelines}
    ruleId: E.31
    title: List catch handlers from most derived to most general
    statement:
        Order catch clauses from the most specific exception type to the most
        general, and keep any catch-all clause at the end.
    rationale:
        The first matching clause wins. A handler for a base class or a catch-all
        that comes early makes every later handler unreachable.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        try {
            connect(server);
        } catch (const std::exception& e) {
            log(e.what());
        } catch (const TimeoutError& e) {   // never reached
            retry_later();
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        try {
            connect(server);
        } catch (const TimeoutError& e) {
            retry_later();
        } catch (const std::exception& e) {
            log(e.what());
        }
        \\\
        ```
    languages: [cpp]
    tags: [error-handling, exceptions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#re_catch
