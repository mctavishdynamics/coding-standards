use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreE12:
    standard: @{CppCoreGuidelines}
    ruleId: E.12
    title: Mark functions noexcept when throwing out of them is impossible or unwanted
    statement:
        Add noexcept to a function that never throws. Also add it when an exception
        escaping would leave you nothing better to do than stop, as with running out
        of memory in many programs.
    rationale:
        The keyword documents for readers and the compiler that no exception leaves
        the function. That lets the compiler emit tighter code and keeps the error
        policy predictable.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int sign(int x)
        {
            return (x > 0) - (x < 0);
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int sign(int x) noexcept
        {
            return (x > 0) - (x < 0);
        }
        \\\
        ```
    languages: [cpp]
    tags: [error-handling, noexcept, exceptions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#re-noexcept
