use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreE2:
    standard: @{CppCoreGuidelines}
    ruleId: E.2
    title: Report a function's failure to do its job by throwing
    statement:
        Throw when a function is unable to complete its task, for example when a
        precondition fails, an object cannot be made valid, a value is out of range
        or a resource cannot be acquired. Never use throw to pass back normal
        results.
    rationale:
        An exception cannot be ignored by accident, keeps failure handling out of
        the main path and spares every caller from repeating the same check. It also
        works in constructors, which have no return value, and destructors tidy up
        as the stack unwinds.
    exceptions:
        Hard real-time systems that need a known worst-case response time should use
        exceptions only when a tool can bound the time taken to recover from a
        throw.
    severity: null
    noncompliant:
        ```cpp
        \\\
        bool open_log(LogFile& log, const std::string& path)   // easy to ignore
        {
            log.handle = std::fopen(path.c_str(), "a");
            return log.handle != nullptr;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        LogFile::LogFile(const std::string& path)
            : handle_(std::fopen(path.c_str(), "a"))
        {
            if (!handle_)
                throw std::runtime_error("cannot open log file " + path);
        }
        \\\
        ```
    languages: [cpp]
    tags: [error-handling, exceptions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#re-throw
