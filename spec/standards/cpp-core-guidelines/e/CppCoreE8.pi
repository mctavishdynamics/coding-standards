use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreE8:
    standard: @{CppCoreGuidelines}
    ruleId: E.8
    title: Spell out what a function guarantees on return
    statement:
        Write down what a function promises about its result or the state it leaves
        behind, ideally as code such as Ensures or an assertion.
    rationale:
        A visible postcondition keeps callers from depending on behavior the
        function does not actually provide, and lets tools check the promise.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int clamp_volume(int requested)
        {
            return std::min(requested, max_volume);
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int clamp_volume(int requested)
        {
            int result = std::clamp(requested, 0, max_volume);
            Ensures(result >= 0 && result <= max_volume);
            return result;
        }
        \\\
        ```
    languages: [cpp]
    tags: [error-handling, contracts, interfaces]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#re-postcondition
