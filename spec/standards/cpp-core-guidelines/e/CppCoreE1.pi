use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreE1:
    standard: @{CppCoreGuidelines}
    ruleId: E.1
    title: Develop an error-handling strategy early in a design
    statement:
        Decide early how the system will detect, report and recover from
        errors and how it will avoid resource leaks, and apply that strategy
        consistently.
    rationale:
        A consistent and complete strategy for errors and resource leaks is
        hard to retrofit into an existing system.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [error-handling, design]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#re-design
