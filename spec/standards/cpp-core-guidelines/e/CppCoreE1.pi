use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreE1:
    standard: @{CppCoreGuidelines}
    ruleId: E.1
    title: Decide how errors will be handled early in the design
    statement:
        Settle on an approach to error detection, reporting, recovery and leak
        prevention while the system is still being designed. Then follow it
        everywhere.
    rationale:
        Bolting a uniform error policy onto existing code is expensive and seldom
        fully succeeds. Choosing one up front costs far less.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [error-handling, design]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#re-design
