use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreE13:
    standard: @{CppCoreGuidelines}
    ruleId: E.13
    title: Hand objects to an owner before any throw can occur
    statement:
        Never let an exception be raised while a resource is held only through a raw
        pointer. Move it into a smart pointer, container or other handle before
        calling anything that might throw.
    rationale:
        If unwinding passes over a plain owning pointer, nothing deletes the object,
        and it leaks.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void process(int id)
        {
            Session* s = new Session(id);
            if (!s->authorized()) throw AccessDenied{id};   // leaks s
            s->run();
            delete s;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void process(int id)
        {
            auto s = std::make_unique<Session>(id);
            if (!s->authorized()) throw AccessDenied{id};
            s->run();
        }
        \\\
        ```
    languages: [cpp]
    tags: [error-handling, exceptions, resources]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#re-never-throw
