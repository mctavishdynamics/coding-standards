use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreP12:
    standard: @{CppCoreGuidelines}
    ruleId: P.12
    title: Use static analysis and other tools where they help
    statement:
        Let tools do the routine checking. Static analyzers, sanitizers, race
        detectors and test frameworks find many errors faster than people do.
    rationale:
        Machines repeat the same checks without getting tired or careless.
        People can then spend their attention on design and review.
    exceptions:
        Do not tie a project to an unusual or fragile tool chain. That can turn
        otherwise portable code into code that builds in only one place.
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [philosophy, tooling]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rp-tools
