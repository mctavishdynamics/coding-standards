use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreP12:
    standard: @{CppCoreGuidelines}
    ruleId: P.12
    title: Use supporting tools as appropriate
    statement:
        Use static analyzers, sanitizers, concurrency checkers and test
        tools for the routine checking that machines do well.
    rationale:
        Computers do repetitive checks without tiring, which frees people
        for more valuable work.
    exceptions:
        Avoid becoming dependent on elaborate or specialized tool chains,
        which can make otherwise portable code non-portable.
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [philosophy, tooling]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rp-tools
