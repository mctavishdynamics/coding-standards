use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreP2:
    standard: @{CppCoreGuidelines}
    ruleId: P.2
    title: Write portable standard C++
    statement:
        Target ISO C++. Stay away from vendor extensions, undefined behavior and
        code that depends on how one compiler chose to implement a detail.
    rationale:
        A compiler extension may behave one way here and another way there, and
        its exact meaning is often unclear. Standard code builds and behaves the
        same across toolchains.
    exceptions:
        Low-level work sometimes requires an extension, such as access to a
        hardware feature. Confine it to a small area, follow a project policy
        for it and, where you can, wrap it in an interface that a different
        build can replace.
    severity: null
    noncompliant:
        ```cpp
        \\\
        void fill(int n) {
            int buffer[n];   // variable-length array: a GCC extension
            // ...
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void fill(int n) {
            std::vector<int> buffer(n);
            // ...
        }
        \\\
        ```
    languages: [cpp]
    tags: [philosophy, portability, standards]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rp-cplusplus
