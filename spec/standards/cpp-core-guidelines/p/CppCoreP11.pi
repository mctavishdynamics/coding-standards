use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreP11:
    standard: @{CppCoreGuidelines}
    ruleId: P.11
    title: Wrap ugly code in one place instead of repeating it
    statement:
        Put low-level, error-prone code in one function or class with a clean
        interface. The rest of the program then calls that interface and never
        touches the details.
    rationale:
        Tricky code tends to hide bugs, and copies of it spread the bugs
        further. One well-tested place behind a simple API keeps the risk
        contained.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // every caller manages the raw buffer itself
        int* data = new int[n];
        int count = 0;
        if (count == n) { /* grow by hand */ }
        data[count++] = x;
        delete[] data;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::vector<int> data;
        data.push_back(x);   // growth and cleanup are encapsulated
        \\\
        ```
    languages: [cpp]
    tags: [philosophy, encapsulation, abstraction]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rp-library
