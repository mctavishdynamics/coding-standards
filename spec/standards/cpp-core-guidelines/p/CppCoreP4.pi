use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreP4:
    standard: @{CppCoreGuidelines}
    ruleId: P.4
    title: Write programs whose types are checked by the compiler
    statement:
        Aim for code the compiler can type check. Unions, casts, decayed arrays,
        out-of-range access and narrowing are the usual weak spots, so reach for
        safer tools such as variant, span and brace initialization.
    rationale:
        C++ cannot be made fully type safe, yet most crashes and exploits trace
        back to those few weak spots. Shrinking them removes a large class of
        defects.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        union Value {
            int i;
            double d;
        };
        Value v;
        v.d = 3.5;
        int n = v.i;   // reads the wrong member
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::variant<int, double> v = 3.5;
        if (auto* d = std::get_if<double>(&v)) {
            use(*d);
        }
        \\\
        ```
    languages: [cpp]
    tags: [philosophy, type-safety]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rp-typesafe
