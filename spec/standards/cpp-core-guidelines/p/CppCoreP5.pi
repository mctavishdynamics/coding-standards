use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreP5:
    standard: @{CppCoreGuidelines}
    ruleId: P.5
    title: Catch errors at compile time instead of run time
    statement:
        If a condition can be verified during compilation, verify it there. Use
        static_assert, constexpr and precise types instead of a run-time test.
    rationale:
        A compile-time check costs nothing when the program runs and needs no
        error path. It also documents the assumption right in the code.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void encode(std::uint32_t value) {
            if (sizeof(int) < 4) {
                throw std::logic_error("int too small");
            }
            // ...
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        static_assert(sizeof(int) >= 4, "int must hold 32 bits");

        void encode(std::uint32_t value) {
            // ...
        }
        \\\
        ```
    languages: [cpp]
    tags: [philosophy, compile-time, error-checking]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rp-compile-time
