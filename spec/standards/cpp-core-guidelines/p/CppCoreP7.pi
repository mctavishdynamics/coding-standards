use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreP7:
    standard: @{CppCoreGuidelines}
    ruleId: P.7
    title: Detect run-time errors as soon as possible
    statement:
        Validate data early, ideally where it crosses an interface. Do not let a
        bad value travel far before it is noticed.
    rationale:
        A fault found far from its cause is hard to trace. A fault never found
        produces silent wrong answers.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void set_ratio(double r) {
            ratio_ = r;            // a bad value fails much later
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void set_ratio(double r) {
            if (r < 0.0 || r > 1.0) {
                throw std::invalid_argument("ratio out of range");
            }
            ratio_ = r;
        }
        \\\
        ```
    languages: [cpp]
    tags: [philosophy, error-checking]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rp-early
