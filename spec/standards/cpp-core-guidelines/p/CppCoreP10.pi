use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreP10:
    standard: @{CppCoreGuidelines}
    ruleId: P.10
    title: Choose data that does not change over data that does
    statement:
        Declare values const or constexpr by default. Leave an object mutable
        only when the program has to change it.
    rationale:
        A value that cannot change is simpler to follow and safe to share
        between threads. The compiler may also generate better code for it.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        double tax_rate = 0.2;
        double tax(double amount) { return amount * tax_rate; }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        constexpr double tax_rate = 0.2;
        double tax(double amount) { return amount * tax_rate; }
        \\\
        ```
    languages: [cpp]
    tags: [philosophy, immutability, const]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rp-mutable
