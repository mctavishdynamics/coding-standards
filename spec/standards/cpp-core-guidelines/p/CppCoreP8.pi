use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreP8:
    standard: @{CppCoreGuidelines}
    ruleId: P.8
    title: Release every resource you acquire
    statement:
        Every acquired resource must be given back, whether it is memory, a file
        handle, a lock or a socket. The simplest way is an owning object whose
        destructor does the release.
    rationale:
        Small leaks add up. A server that runs for weeks will eventually run out
        of the leaked resource and fail.
    exceptions:
        Memory and handles owned by objects that live until the program ends may
        be left for the operating system to reclaim at exit.
    severity: null
    noncompliant:
        ```cpp
        \\\
        void log_line(const char* path, const char* text) {
            FILE* f = std::fopen(path, "a");
            if (!f) return;
            if (std::fputs(text, f) < 0) return;   // leaks f
            std::fclose(f);
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void log_line(const std::string& path, const std::string& text) {
            std::ofstream out(path, std::ios::app);
            out << text;
        }   // closed on every path
        \\\
        ```
    languages: [cpp]
    tags: [philosophy, resources, raii]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rp-leak
