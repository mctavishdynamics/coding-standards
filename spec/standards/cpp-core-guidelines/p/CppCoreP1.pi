use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreP1:
    standard: @{CppCoreGuidelines}
    ruleId: P.1
    title: Say what you mean directly in the code
    statement:
        Let types, names and library calls carry the design. A reader should
        learn the intent from the code itself, not from a comment or a separate
        document.
    rationale:
        Tools can check code, but they cannot check prose. People skim past
        comments too. Intent that lives in the code is precise and verifiable.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        struct Order {
            int status() const;   // 0 = new, 1 = paid, 2 = shipped
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        enum class OrderStatus { placed, paid, shipped };

        struct Order {
            OrderStatus status() const;
        };
        \\\
        ```
    languages: [cpp]
    tags: [philosophy, expressiveness, types]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rp-direct
