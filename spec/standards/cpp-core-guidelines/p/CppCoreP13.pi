use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreP13:
    standard: @{CppCoreGuidelines}
    ruleId: P.13
    title: Use well-made support libraries where they help
    statement:
        When a good library already solves your problem, use it. Begin with the
        standard library and the GSL before writing your own.
    rationale:
        A popular library has been tested by many users, is documented and keeps
        being maintained. Writing your own costs time and usually yields
        something less reliable.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void sort_ints(int* a, int n) {   // hand-written bubble sort
            for (int i = 0; i < n; ++i)
                for (int j = 0; j + 1 < n - i; ++j)
                    if (a[j] > a[j + 1]) std::swap(a[j], a[j + 1]);
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::sort(values.begin(), values.end());
        \\\
        ```
    languages: [cpp]
    tags: [philosophy, libraries]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rp-lib
