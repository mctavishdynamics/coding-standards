use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreP13:
    standard: @{CppCoreGuidelines}
    ruleId: P.13
    title: Use support libraries as appropriate
    statement:
        When a well-designed, documented and supported library exists for
        your domain, use it. By default use the ISO C++ standard library and
        the Guidelines Support Library.
    rationale:
        A widely used library is usually of higher quality than what you
        could write yourself, its cost is shared by many users, and it is
        kept up to date and ported.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void sort_ints(int* a, int n) {   // hand-written bubble sort
            for (int i = 0; i < n; ++i)
                for (int j = 0; j + 1 < n - i; ++j)
                    if (a[j] > a[j + 1]) std::swap(a[j], a[j + 1]);
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::sort(values.begin(), values.end());
        \\\
        ```
    languages: [cpp]
    tags: [philosophy, libraries]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rp-lib
