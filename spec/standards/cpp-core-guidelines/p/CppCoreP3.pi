use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreP3:
    standard: @{CppCoreGuidelines}
    ruleId: P.3
    title: Make the purpose of code obvious
    statement:
        Show the goal of each piece of code, not only its mechanics. Good names,
        standard algorithms and a short comment where needed tell the reader
        what result is wanted.
    rationale:
        A reviewer can only find a bug by comparing what the code does with what
        it was meant to do. If the goal is hidden, that comparison is
        impossible.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int i = 0;
        while (i < v.size()) {
            process(v[i]);
            ++i;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        for (const auto& item : v) {
            process(item);
        }
        \\\
        ```
    languages: [cpp]
    tags: [philosophy, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rp-what
