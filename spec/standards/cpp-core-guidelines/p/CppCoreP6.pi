use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreP6:
    standard: @{CppCoreGuidelines}
    ruleId: P.6
    title: Make the checks the compiler cannot do possible at run time
    statement:
        Some mistakes slip past the compiler. Shape the code so those mistakes
        can still be caught at run time, for instance by keeping a length next
        to the buffer it belongs to.
    rationale:
        An error that no check can see turns into a crash or into wrong output.
        Even when you skip a check for speed, the data to perform it should
        remain available.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // the callee cannot know how many elements p points to
        void scale(double* p);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // the size travels with the data and can be checked
        void scale(std::span<double> values);
        \\\
        ```
    languages: [cpp]
    tags: [philosophy, run-time, error-checking]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rp-run-time
