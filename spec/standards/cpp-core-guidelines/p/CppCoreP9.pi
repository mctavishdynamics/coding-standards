use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreP9:
    standard: @{CppCoreGuidelines}
    ruleId: P.9
    title: Avoid needless use of memory and time
    statement:
        Do not spend memory or processor time for no reason. Extra copies,
        allocations and repeated work are waste. Cost paid for a real benefit,
        such as safety or easier testing, is not waste.
    rationale:
        A single slow spot is seldom a problem. Waste scattered across a whole
        program adds up, and it is hard to find and remove later.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::size_t count_long(std::vector<std::string> words) {  // copies all
            std::size_t n = 0;
            for (std::string w : words)                            // copies each
                if (w.size() > 10) ++n;
            return n;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::size_t count_long(const std::vector<std::string>& words) {
            std::size_t n = 0;
            for (const auto& w : words)
                if (w.size() > 10) ++n;
            return n;
        }
        \\\
        ```
    languages: [cpp]
    tags: [philosophy, performance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rp-waste
