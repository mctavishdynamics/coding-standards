use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreA1:
    standard: @{CppCoreGuidelines}
    ruleId: A.1
    title: Separate stable code from less stable code
    statement:
        Keep code that changes often apart from code that is stable, behind
        a clear interface.
    rationale:
        Isolated, less stable code is easier to unit test, to improve, to
        refactor and eventually to deprecate.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [architecture, modularity]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ra-stable
