use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreA1:
    standard: @{CppCoreGuidelines}
    ruleId: A.1
    title: Keep volatile code apart from code that rarely changes
    statement:
        Put a clear interface between the parts of a system that are still in flux
        and the parts that have settled.
    rationale:
        When unsettled code sits in its own module it can be tested alone, reworked
        or replaced without touching the stable core, and retired cleanly later.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [architecture, modularity]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ra-stable
