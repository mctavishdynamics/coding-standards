use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreA4:
    standard: @{CppCoreGuidelines}
    ruleId: A.4
    title: Keep the library dependency graph acyclic
    statement:
        Make sure no two libraries depend on each other, directly or through a chain
        of others. Mutual references inside a single library are fine.
    rationale:
        A dependency loop between libraries makes builds harder to set up and the
        structure harder to grasp. It can also lead to unspecified behavior, for
        example around initialization order.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [architecture, dependencies, libraries]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ra-dag
