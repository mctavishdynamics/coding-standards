use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreA4:
    standard: @{CppCoreGuidelines}
    ruleId: A.4
    title: There should be no cycles among libraries
    statement:
        Do not let a library depend on another library that depends on it.
        Cyclic references inside one library are acceptable.
    rationale:
        Cycles complicate the build, are hard to understand and can
        introduce unspecified behavior.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [architecture, dependencies, libraries]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ra-dag
