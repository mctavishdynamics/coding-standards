use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreA2:
    standard: @{CppCoreGuidelines}
    ruleId: A.2
    title: Factor code that others could reuse into its own library
    statement:
        Package code that other programs could use as a library. That is a set of
        headers, possibly with compiled objects, that is versioned, documented and
        shipped as one unit.
    rationale:
        Shared code then has a clear boundary and a single place where it is
        maintained. Other programs can include it or link against it, statically or
        dynamically.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [architecture, libraries, reuse]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ra-lib
