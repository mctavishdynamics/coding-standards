use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreA2:
    standard: @{CppCoreGuidelines}
    ruleId: A.2
    title: Express potentially reusable parts as a library
    statement:
        Package parts that could be reused as a library, meaning
        declarations and definitions maintained, documented and shipped
        together, either header-only or headers plus object files.
    rationale:
        A library gives reusable code a defined boundary and a single place
        to maintain it, and it can be linked or included by other programs.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [architecture, libraries, reuse]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#ra-lib
