use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl20:
    standard: @{CppCoreGuidelines}
    ruleId: NL.20
    title: Write one statement per line
    statement:
        Give every statement a line of its own.
    rationale:
        When two statements share a line, a reader skimming the code can easily miss
        the second.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int width = 80; int height = 24;
        reset(screen); ++frames;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int width = 80;
        int height = 24;
        reset(screen);
        ++frames;
        \\\
        ```
    languages: [cpp]
    tags: [formatting, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-stmt
