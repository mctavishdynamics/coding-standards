use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl20:
    standard: @{CppCoreGuidelines}
    ruleId: NL.20
    title: Don't place two statements on the same line
    statement:
        Write each statement on its own line.
    rationale:
        A statement is easy to overlook when it shares a line with another.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int width = 80; int height = 24;
        reset(screen); ++frames;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int width = 80;
        int height = 24;
        reset(screen);
        ++frames;
        \\\
        ```
    languages: [cpp]
    tags: [formatting, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-stmt
