use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl8:
    standard: @{CppCoreGuidelines}
    ruleId: NL.8
    title: Pick one naming style and keep to it
    statement:
        Settle on one naming scheme, covering details like acronyms and name length,
        and use it consistently, while leaving names from third-party libraries as
        they are. Never use names with two underscores in a row or names made of a
        leading underscore plus an uppercase letter.
    rationale:
        A uniform scheme makes code easier to scan. The forbidden forms are reserved
        for the compiler and standard library, so using them risks clashes.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int maxConn = 64;
        int mean_time_between_failures = 12;
        int MTTR = 3;
        int _Retry_count = 0;     // reserved identifier
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int max_connections = 64;
        int mean_time_between_failures = 12;
        int mean_time_to_repair = 3;
        int retry_count = 0;
        \\\
        ```
    languages: [cpp]
    tags: [naming, consistency]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-name
