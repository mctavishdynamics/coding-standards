use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl3:
    standard: @{CppCoreGuidelines}
    ruleId: NL.3
    title: Keep comments crisp
    statement:
        Write short, clear comments in intelligible English, with proper
        grammar and punctuation and no text-message shorthand.
    rationale:
        Verbose comments slow understanding and spread code out, and
        maintainers may not share your native language or slang.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // ok so basically this thing here is gonna go thru all the users n
        // check if they r active and if so it will like send them the email lol
        notify_active(users);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // Email every active user.
        notify_active(users);
        \\\
        ```
    languages: [cpp]
    tags: [comments, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-comments-crisp
