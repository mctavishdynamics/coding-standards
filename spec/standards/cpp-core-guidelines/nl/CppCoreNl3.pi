use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl3:
    standard: @{CppCoreGuidelines}
    ruleId: NL.3
    title: Keep comments short and to the point
    statement:
        Make comments brief and precise. Use plain, correct English with full
        punctuation, and avoid chat abbreviations.
    rationale:
        Long comments take longer to read and push the code apart. The people
        maintaining it may not speak your first language or know your slang.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        // ok so basically this thing here is gonna go thru all the users n
        // check if they r active and if so it will like send them the email lol
        notify_active(users);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // Email every active user.
        notify_active(users);
        \\\
        ```
    languages: [cpp]
    tags: [comments, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-comments-crisp
