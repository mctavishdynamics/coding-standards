use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl10:
    standard: @{CppCoreGuidelines}
    ruleId: NL.10
    title: Prefer underscore_style names
    statement:
        When you have free choice, separate the words of a name with
        underscores, as the standard library does. Follow an established
        project style when there is one.
    rationale:
        Underscore style is the original C and C++ style and the one used by
        the standard library, but consistency beats personal taste.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int maxRetryCount;
        void sendHeartbeat();
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int max_retry_count;
        void send_heartbeat();
        \\\
        ```
    languages: [cpp]
    tags: [naming]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-camel
