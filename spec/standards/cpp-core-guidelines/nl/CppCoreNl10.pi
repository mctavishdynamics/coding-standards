use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl10:
    standard: @{CppCoreGuidelines}
    ruleId: NL.10
    title: Name things in lowercase with underscores
    statement:
        If no existing style binds you, write names in lowercase with underscores
        between words, like the standard library. Where a project already has its
        own style, use that.
    rationale:
        This underscore style goes back to early C and runs through the whole
        standard library. Sticking to one style throughout a code base still matters
        more than which style is picked.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int maxRetryCount;
        void sendHeartbeat();
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int max_retry_count;
        void send_heartbeat();
        \\\
        ```
    languages: [cpp]
    tags: [naming]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-camel
