use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl21:
    standard: @{CppCoreGuidelines}
    ruleId: NL.21
    title: Introduce one name in each declaration
    statement:
        Declare one name per declaration. ES.10 covers the same ground.
    rationale:
        Separate declarations read more easily. They also avoid the declarator trap
        where a star or ampersand belongs to only one of the names on the line.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int* first, last;      // last is an int, not a pointer
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int* first;
        int* last;
        \\\
        ```
    languages: [cpp]
    tags: [declarations, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-dcl
