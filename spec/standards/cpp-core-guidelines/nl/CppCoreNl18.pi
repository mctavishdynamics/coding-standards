use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl18:
    standard: @{CppCoreGuidelines}
    ruleId: NL.18
    title: Attach the pointer or reference symbol to the type
    statement:
        Write the asterisk or ampersand next to the type, as in int* p, instead of
        next to the variable name.
    rationale:
        C++ puts the emphasis on types. The C habit of placing the symbol by the
        name, to mirror how it is used in expressions, makes no sense for
        references.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        const Config &current_config();
        char *buffer_start;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        const Config& current_config();
        char* buffer_start;
        \\\
        ```
    languages: [cpp]
    tags: [formatting, declarations]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-ptr
