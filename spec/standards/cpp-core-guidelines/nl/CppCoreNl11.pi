use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl11:
    standard: @{CppCoreGuidelines}
    ruleId: NL.11
    title: Write literals so they are easy to read
    statement:
        Break up long numeric literals with digit separators, and add a suffix when
        it makes the type or unit plain.
    rationale:
        Long runs of digits invite typing and reading mistakes. Suffixes such as s
        or ms state at a glance that a literal is a std::string or a duration.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        long long bytes = 10737418240;
        auto mask = 0b1111000011110000;
        auto delay = 250;          // milliseconds?
        \\\
        ```
    compliant:
        ```cpp
        \\\
        long long bytes = 10'737'418'240;
        auto mask = 0b1111'0000'1111'0000;
        auto delay = 250ms;
        \\\
        ```
    languages: [cpp]
    tags: [literals, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-literals
