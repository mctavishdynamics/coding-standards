use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl17:
    standard: @{CppCoreGuidelines}
    ruleId: NL.17
    title: Lay out braces in the K and R tradition
    statement:
        Follow the K&R style, also called the Stroustrup style. A class, struct or
        control statement opens its brace on the same line, a function body opens
        its brace on a new line, and every statement and every branch or loop body
        starts a line of its own.
    rationale:
        This is the layout C and C++ began with. It is economical with vertical
        space and makes a function definition look different from a class
        definition.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        struct Point
        {
            int x, y;
        };

        int clamp(int v, int lo, int hi) {
            if (v < lo) { return lo; } else if (v > hi) return hi;
            return v;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        struct Point {
            int x, y;
        };

        int clamp(int v, int lo, int hi)
        {
            if (v < lo)
                return lo;
            if (v > hi)
                return hi;
            return v;
        }
        \\\
        ```
    languages: [cpp]
    tags: [formatting, braces, layout]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-knr
