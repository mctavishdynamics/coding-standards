use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl26:
    standard: @{CppCoreGuidelines}
    ruleId: NL.26
    title: Use conventional const notation
    statement:
        Put const before the type it qualifies, as in const int, rather than
        after it.
    rationale:
        The conventional form is familiar to more programmers, including
        novices learning from common material, and keeps large code bases
        consistent.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int const max_depth = 8;
        char const* const label = "root";
        \\\
        ```
    compliant:
        ```cpp
        \\\
        const int max_depth = 8;
        const char* const label = "root";
        \\\
        ```
    languages: [cpp]
    tags: [formatting, const, consistency]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-const
