use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl26:
    standard: @{CppCoreGuidelines}
    ruleId: NL.26
    title: Place const before the type it qualifies
    statement:
        Write const ahead of the type it modifies, as in const int, rather than
        after it, as in int const.
    rationale:
        Most programmers, and most teaching material, use this order. Following it
        keeps big code bases uniform.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int const max_depth = 8;
        char const* const label = "root";
        \\\
        ```
    compliant:
        ```cpp
        \\\
        const int max_depth = 8;
        const char* const label = "root";
        \\\
        ```
    languages: [cpp]
    tags: [formatting, const, consistency]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-const
