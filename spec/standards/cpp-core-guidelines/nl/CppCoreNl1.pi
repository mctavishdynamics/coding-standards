use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl1:
    standard: @{CppCoreGuidelines}
    ruleId: NL.1
    title: Let the code say what it does and keep comments for the rest
    statement:
        Skip comments that only repeat, in words, what a clear piece of code already
        shows.
    rationale:
        Code is checked by the compiler and comments are not, and prose is vaguer
        than code. A redundant comment tells the reader nothing new and is likely to
        go stale after the next edit.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        total = price * qty + shipping;   // multiply price by qty and add shipping
        \\\
        ```
    compliant:
        ```cpp
        \\\
        total = price * qty + shipping;
        \\\
        ```
    languages: [cpp]
    tags: [comments, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-comments
