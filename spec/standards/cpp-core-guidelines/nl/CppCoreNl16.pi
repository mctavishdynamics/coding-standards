use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl16:
    standard: @{CppCoreGuidelines}
    ruleId: NL.16
    title: Order class members in a familiar way
    statement:
        Inside a class, list nested types and aliases first. Constructors,
        assignment operators and the destructor come next, then other member
        functions, then data. Put public before protected and protected before
        private, each in one block.
    rationale:
        Readers find their way around a class faster when members follow a familiar
        layout. Private helpers and private types may stay near the private data
        when that keeps the interface cleaner.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        class Account {
            double balance;
        public:
            void deposit(double amount);
        private:
            void audit();
        public:
            Account();
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class Account {
        public:
            Account();
            void deposit(double amount);
        private:
            void audit();
            double balance;
        };
        \\\
        ```
    languages: [cpp]
    tags: [formatting, classes, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-order
