use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl19:
    standard: @{CppCoreGuidelines}
    ruleId: NL.19
    title: Avoid names that are easy to misread
    statement:
        Avoid identifiers that differ only by characters that are easy to confuse,
        such as l and 1 or O and 0, and names that look almost the same.
    rationale:
        Some fonts, screens and printers make similar characters hard to tell apart.
        People also read past small spelling differences and treat two names as one.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int l1 = 4;
        int ll = 5;
        int total_count = 0;
        int total_counts = 0;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int line_number = 4;
        int line_limit = 5;
        int item_count = 0;
        int error_count = 0;
        \\\
        ```
    languages: [cpp]
    tags: [naming, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-misread
