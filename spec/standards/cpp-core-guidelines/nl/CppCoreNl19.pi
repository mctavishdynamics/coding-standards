use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl19:
    standard: @{CppCoreGuidelines}
    ruleId: NL.19
    title: Avoid names that are easily misread
    statement:
        Do not use names that look alike or differ by a single easily
        confused character.
    rationale:
        Not every display or printer makes all characters distinct, and
        readers easily mix up similarly spelled words.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int l1 = 4;
        int ll = 5;
        int total_count = 0;
        int total_counts = 0;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int line_number = 4;
        int line_limit = 5;
        int item_count = 0;
        int error_count = 0;
        \\\
        ```
    languages: [cpp]
    tags: [naming, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-misread
