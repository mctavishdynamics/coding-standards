use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl25:
    standard: @{CppCoreGuidelines}
    ruleId: NL.25
    title: Write an empty parameter list without void
    statement:
        Write a function with no parameters as f(), not f(void).
    rationale:
        Spelling out void adds noise and only serves code that must also compile as
        C.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int next_id(void);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int next_id();
        \\\
        ```
    languages: [cpp]
    tags: [declarations, c-compatibility]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-void
