use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl25:
    standard: @{CppCoreGuidelines}
    ruleId: NL.25
    title: Don't use void as an argument type
    statement:
        Write an empty parameter list for a function that takes no
        arguments, not a void parameter.
    rationale:
        The void form is verbose and only needed for C compatibility.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int next_id(void);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int next_id();
        \\\
        ```
    languages: [cpp]
    tags: [declarations, c-compatibility]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-void
