use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl15:
    standard: @{CppCoreGuidelines}
    ruleId: NL.15
    title: Keep whitespace modest
    statement:
        Add spaces and blank lines where they make the structure clearer, and do not
        surround every token with them.
    rationale:
        Excess whitespace makes the code longer and pulls attention away from it.
        Whitespace used with care makes it easier to read.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        #include < vector >

        int sum ( const std :: vector < int > & v ) ;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        #include <vector>

        int sum(const std::vector<int>& v);
        \\\
        ```
    languages: [cpp]
    tags: [formatting, whitespace]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-space
