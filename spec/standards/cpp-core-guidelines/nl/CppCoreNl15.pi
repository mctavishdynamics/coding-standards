use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl15:
    standard: @{CppCoreGuidelines}
    ruleId: NL.15
    title: Use spaces sparingly
    statement:
        Use whitespace where it helps readability, but do not pad every
        token with spaces.
    rationale:
        Too much space enlarges the text and distracts, while well-placed
        whitespace helps.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        #include < vector >

        int sum ( const std :: vector < int > & v ) ;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        #include <vector>

        int sum(const std::vector<int>& v);
        \\\
        ```
    languages: [cpp]
    tags: [formatting, whitespace]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-space
