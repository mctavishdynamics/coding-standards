use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl9:
    standard: @{CppCoreGuidelines}
    ruleId: NL.9
    title: Keep capital-letter names for macros
    statement:
        Spell names entirely in capitals only when they are macros. Give constants,
        enumerators and variables normal names.
    rationale:
        Macros ignore scope and type rules. Using capitals only for them warns
        readers that the usual rules do not apply, and a constant that does follow
        those rules should not look like one.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        const int BUFFER_SIZE = 4096;
        enum class Level { LOW, HIGH };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        #define APP_ASSERT(x) ((x) ? void() : report_failure(#x))

        const int buffer_size = 4096;
        enum class Level { low, high };
        \\\
        ```
    languages: [cpp]
    tags: [naming, macros]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-all-caps
