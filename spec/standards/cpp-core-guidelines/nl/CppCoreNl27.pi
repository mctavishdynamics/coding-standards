use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl27:
    standard: @{CppCoreGuidelines}
    ruleId: NL.27
    title: Name source files .cpp and header files .h
    statement:
        Unless the project has already chosen other suffixes, such as .hh or .cxx,
        use .h for headers and .cpp for implementation files.
    rationale:
        These suffixes have long been the usual ones. The .h suffix fits headers
        that C code may share, and .cpp marks a file as C++ rather than C. Still, a
        consistent choice matters more than any particular suffix.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [source-files, naming]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-file-suffix
