use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl27:
    standard: @{CppCoreGuidelines}
    ruleId: NL.27
    title: Use a .cpp suffix for code files and .h for interface files
    statement:
        By default name headers with .h and implementation files with .cpp,
        but follow the project's existing convention, such as .hh or .cxx,
        if it has one.
    rationale:
        It is a long-standing convention; .h suits headers often shared with
        C, and a distinct suffix separates C++ implementation files from C
        ones. Consistency matters more than the particular suffix.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [source-files, naming]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-file-suffix
