use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl2:
    standard: @{CppCoreGuidelines}
    ruleId: NL.2
    title: Explain the purpose in comments
    statement:
        Write comments that state the purpose of the code, the part the code cannot
        tell the reader itself.
    rationale:
        Code shows what it does, not what it was meant to do. A sentence about the
        goal is often clearer and shorter than the implementation, and when the two
        disagree, both deserve a second look.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void merge_ranges(std::vector<Range>& rs)
            // loop over rs, compare ends, erase some elements
        {
            // ...
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void merge_ranges(std::vector<Range>& rs)
            // replace overlapping or touching ranges by their union;
            // the result is sorted by start
        {
            // ...
        }
        \\\
        ```
    languages: [cpp]
    tags: [comments, documentation]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-comments-intent
