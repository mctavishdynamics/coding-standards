use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl7:
    standard: @{CppCoreGuidelines}
    ruleId: NL.7
    title: Use short names for short scopes and longer names for wide ones
    statement:
        Match how long a name is to how far it reaches. Short names suit tiny
        scopes, and names visible across many lines or files should be longer and
        more descriptive.
    rationale:
        A name in a wide scope is read far from its declaration and is more likely
        to clash with or be confused with another one. In a few lines, familiar
        short names such as i, p or x are clear enough.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int t;   // global with a cryptic name

        void scale(std::vector<double>& values_to_be_multiplied, double multiplication_factor);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int retry_timeout_seconds;   // global, descriptive

        void scale(std::vector<double>& v, double factor);   // short names in a small scope
        \\\
        ```
    languages: [cpp]
    tags: [naming, scope]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-name-length
