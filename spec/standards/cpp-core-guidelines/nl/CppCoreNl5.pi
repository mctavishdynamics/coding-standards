use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl5:
    standard: @{CppCoreGuidelines}
    ruleId: NL.5
    title: Leave types out of names
    statement:
        Choose names that describe a thing's role, not its type. Do not use
        Hungarian notation or type tags in names, and overload a single name instead
        of adding a tag for each type.
    rationale:
        Type tags must be renamed whenever a type changes and, like comments, they
        fall out of date. They also defeat overloading and generic code.
    exceptions:
        Conventions that do not spell out a type are not covered. Examples are a p
        for something used through indirection, cnt for a count, a suffix marking
        members, or capital letters for type names.
    severity: null
    noncompliant:
        ```cpp
        \\\
        void log_int(int value);
        void log_str(const char* value);

        int iRetries;
        char* szHostName;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void log(int value);
        void log(std::string_view value);

        int retries;
        std::string host_name;
        \\\
        ```
    languages: [cpp]
    tags: [naming]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-name-type
