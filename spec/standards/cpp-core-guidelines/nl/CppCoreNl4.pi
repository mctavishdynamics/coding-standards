use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreNl4:
    standard: @{CppCoreGuidelines}
    ruleId: NL.4
    title: Indent consistently
    statement:
        Use the same indentation scheme everywhere, and always indent the body of an
        if, for or while.
    rationale:
        Regular indentation helps reading and makes careless errors, like a
        semicolon that cuts off a loop body, easy to spot.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        for (i = 0; i < n; ++i);
        total += v[i];
        if (total > limit)
        return total;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        for (i = 0; i < n; ++i)
            total += v[i];
        if (total > limit)
            return total;
        \\\
        ```
    languages: [cpp]
    tags: [formatting, indentation]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rl-indent
