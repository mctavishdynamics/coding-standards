use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp23:
    standard: @{CppCoreGuidelines}
    ruleId: CP.23
    title: Treat a thread that is joined at scope exit like a local object
    statement:
        Think of a thread that is joined before its scope ends as an ordinary local
        variable. It may use pointers to objects that live in that scope or any
        outer one.
    rationale:
        Because the join happens before the scope closes, everything the thread
        refers to is still alive while it runs. That makes its lifetimes as easy to
        reason about as a local's.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```cpp
        \\\
        void render_frame(Frame& frame)
        {
            Buffer scratch;
            std::jthread left([&] { render_half(frame, scratch, Side::left); });
            std::jthread right([&] { render_half(frame, scratch, Side::right); });
        }   // both threads join here, before scratch is destroyed
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, threads, lifetime]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-join
