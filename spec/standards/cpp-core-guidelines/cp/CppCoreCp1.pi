use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp1:
    standard: @{CppCoreGuidelines}
    ruleId: CP.1
    title: Write code that stays correct when called from several threads
    statement:
        Assume any function may one day be called from more than one thread. Keep
        mutable state in objects the caller passes in, or make it thread_local or
        guarded, instead of hiding it in globals or function-local statics. Library
        code needs this most.
    rationale:
        Programs grow threads over time and code moves between projects. A routine
        written for a single-threaded tool can later sit inside a server, where
        hidden state turns into a data race that is costly to track down.
    exceptions:
        Code with a firm guarantee that it only ever runs on one thread. Mark that
        limit plainly and check it at build or run time if you can, because such
        guarantees tend to break as the code base changes.
    severity: null
    noncompliant:
        ```cpp
        \\\
        const Route& shortest_route(int from, int to)
        {
            static std::pair<int, int> last_query{-1, -1};   // shared by all threads
            static Route last_route;
            if (last_query != std::pair{from, to}) {
                last_query = {from, to};
                last_route = compute_route(from, to);
            }
            return last_route;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class RouteCache {
        public:
            const Route& shortest_route(int from, int to)
            {
                if (last_query_ != std::pair{from, to}) {
                    last_query_ = {from, to};
                    last_route_ = compute_route(from, to);
                }
                return last_route_;
            }
        private:
            std::pair<int, int> last_query_{-1, -1};
            Route last_route_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, thread-safety, shared-state]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-multi
