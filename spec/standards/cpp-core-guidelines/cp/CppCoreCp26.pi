use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp26:
    standard: @{CppCoreGuidelines}
    ruleId: CP.26
    title: Keep threads joined instead of detached
    statement:
        Avoid detach(). When a thread must run for a long time, store it in an owner
        whose lifetime matches the thread's job, for example a global or an object
        held by a unique_ptr, and join it there.
    rationale:
        Once detached, a thread can no longer be watched or talked to through its
        handle. You lose an easy way to confirm that it ended properly or that it is
        still running when it should be.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void start_service()
        {
            std::thread watchdog(run_watchdog);
            watchdog.detach();   // nobody can tell if it is still running
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::unique_ptr<std::jthread> watchdog;

        void start_service()
        {
            watchdog = std::make_unique<std::jthread>(run_watchdog);
        }
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, threads, lifetime]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-detached_thread
