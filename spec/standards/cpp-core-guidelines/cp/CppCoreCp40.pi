use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp40:
    standard: @{CppCoreGuidelines}
    ruleId: CP.40
    title: Minimize context switching
    statement:
        Structure concurrent work so that threads are not constantly
        switched in and out, for example by batching work and avoiding
        needless blocking and waking.
    rationale:
        Context switches are expensive.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [concurrency, performance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-switch
