use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp40:
    standard: @{CppCoreGuidelines}
    ruleId: CP.40
    title: Avoid forcing frequent thread switches
    statement:
        Arrange concurrent work so threads do not keep swapping on and off the
        processor. Batch small jobs and avoid sleeping and waking threads without
        need.
    rationale:
        Every switch between threads costs real time.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [concurrency, performance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-switch
