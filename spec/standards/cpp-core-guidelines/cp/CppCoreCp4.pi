use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp4:
    standard: @{CppCoreGuidelines}
    ruleId: CP.4
    title: Design concurrency around units of work, not around threads
    statement:
        Model concurrent work as tasks that return results, through std::async or a
        higher-level library, instead of creating and coordinating threads by hand.
    rationale:
        Threads describe how the machine runs code, while tasks describe what the
        program wants done. The second view is simpler to reason about, and working
        at that level tends to give code that is more correct, more productive to
        write and often faster.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int checksum = 0;
        std::thread worker([&] { checksum = compute_checksum(file); });
        // ...
        worker.join();
        \\\
        ```
    compliant:
        ```cpp
        \\\
        auto checksum = std::async([&] { return compute_checksum(file); });
        // ...
        use(checksum.get());
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, tasks, abstraction]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-task
