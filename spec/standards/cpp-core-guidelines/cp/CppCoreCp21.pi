use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp21:
    standard: @{CppCoreGuidelines}
    ruleId: CP.21
    title: Take several mutexes together with a deadlock-free acquire
    statement:
        Acquire a group of mutexes in one call to std::scoped_lock or std::lock, not
        one at a time.
    rationale:
        Sequential locking deadlocks as soon as two threads grab the same pair in
        opposite order. The standard functions use an algorithm that avoids this no
        matter how the arguments are listed.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void transfer(Account& from, Account& to, int amount)
        {
            std::lock_guard a(from.mutex);
            std::lock_guard b(to.mutex);   // another transfer may lock these in reverse
            from.balance -= amount;
            to.balance += amount;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void transfer(Account& from, Account& to, int amount)
        {
            std::scoped_lock lock(from.mutex, to.mutex);
            from.balance -= amount;
            to.balance += amount;
        }
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, deadlock, locking]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-lock
