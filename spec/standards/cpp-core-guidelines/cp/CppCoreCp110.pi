use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp110:
    standard: @{CppCoreGuidelines}
    ruleId: CP.110
    title: Do not write your own double-checked locking for initialization
    statement:
        For one-time initialization, use a function-local static
        or std::call_once instead of a hand-written double-checked locking
        scheme.
    rationale:
        Since C++11, local statics are initialized in a thread-safe way,
        and std::call_once gives the same guarantee, so hand-rolled versions
        only add risk.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Config* config_instance = nullptr;
        std::mutex config_mutex;

        Config& config()
        {
            if (!config_instance) {
                std::lock_guard lock(config_mutex);
                if (!config_instance) config_instance = new Config(load());
            }
            return *config_instance;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        Config& config()
        {
            static Config instance(load());   // initialized once, thread-safely
            return instance;
        }
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, initialization]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-double
