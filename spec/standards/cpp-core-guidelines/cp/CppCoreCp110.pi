use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp110:
    standard: @{CppCoreGuidelines}
    ruleId: CP.110
    title: Leave lazy initialization locking to the language and library
    statement:
        Initialize shared data once with a function-local static or
        with std::call_once. Do not build your own double-checked lock
        for this.
    rationale:
        The language has guaranteed thread-safe initialization of local statics
        since C++11, and std::call_once offers the same. A home-made scheme only
        adds a chance for races.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Config* config_instance = nullptr;
        std::mutex config_mutex;

        Config& config()
        {
            if (!config_instance) {
                std::lock_guard lock(config_mutex);
                if (!config_instance) config_instance = new Config(load());
            }
            return *config_instance;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        Config& config()
        {
            static Config instance(load());   // initialized once, thread-safely
            return instance;
        }
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, initialization]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-double
