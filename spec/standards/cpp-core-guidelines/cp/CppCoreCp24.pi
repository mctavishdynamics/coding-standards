use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp24:
    standard: @{CppCoreGuidelines}
    ruleId: CP.24
    title: Treat a detached thread like a global object
    statement:
        Think of a thread that is or may be detached as a global object. Give it
        pointers only to static objects or to heap objects that stay alive longer
        than it does. Never hand it the address of a local.
    rationale:
        Nothing ties a detached thread to the scope that started it, so locals may
        be gone while it still runs. Even static objects are at risk while they are
        torn down during program shutdown.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void start_logging()
        {
            std::string prefix = "app";
            std::thread t([&prefix] { log_forever(prefix); });
            t.detach();   // prefix dies when start_logging returns
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void start_logging()
        {
            std::thread t([prefix = std::string("app")] { log_forever(prefix); });
            t.detach();   // the thread owns its own copy
        }
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, threads, lifetime]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-detach
