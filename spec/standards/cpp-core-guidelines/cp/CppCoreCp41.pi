use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp41:
    standard: @{CppCoreGuidelines}
    ruleId: CP.41
    title: Reuse threads instead of creating and destroying them often
    statement:
        Keep a set of long-lived worker threads that take jobs from a queue, or use
        the platform's thread pool, instead of spawning a thread for each job.
    rationale:
        Starting and tearing down a thread is costly.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void serve(Listener& listener)
        {
            while (auto conn = listener.accept())
                std::thread(handle, std::move(*conn)).detach();   // one thread per connection
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void serve(Listener& listener, ThreadPool& pool)
        {
            while (auto conn = listener.accept())
                pool.submit([c = std::move(*conn)]() mutable { handle(std::move(c)); });
        }
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, performance, threads]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-create
