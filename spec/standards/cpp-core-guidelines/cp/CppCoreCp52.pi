use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp52:
    standard: @{CppCoreGuidelines}
    ruleId: CP.52
    title: Release locks before a coroutine suspends
    statement:
        Make sure no lock or other synchronization object is held at a co_await or
        any other suspension point. Scope the guard to a block that ends before the
        suspension.
    rationale:
        A thread that does other work while the coroutine waits can try to take the
        same lock and deadlock. If the coroutine resumes on a different thread, the
        unlock is undefined behavior. In every case the lock keeps others waiting
        for the whole suspension.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Task<void> Store::save(Record r)
        {
            std::lock_guard lock(mutex_);
            pending_.push_back(r);
            co_await disk_.flush(pending_);   // suspends while holding mutex_
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        Task<void> Store::save(Record r)
        {
            std::vector<Record> batch;
            {
                std::lock_guard lock(mutex_);
                pending_.push_back(r);
                batch.swap(pending_);
            }
            co_await disk_.flush(batch);
        }
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, coroutines, locking]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rcoro-locks
