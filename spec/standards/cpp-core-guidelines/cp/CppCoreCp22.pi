use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp22:
    standard: @{CppCoreGuidelines}
    ruleId: CP.22
    title: Release locks before calling code you do not control
    statement:
        Code you cannot inspect, such as callbacks and virtual functions, must
        not run under a lock you hold. Copy the data you need, release the lock,
        and only then make the call.
    rationale:
        Foreign code might lock the same mutex again, grab locks of its own or run
        for a long time. Each of these can deadlock the program or keep other
        threads waiting.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void EventBus::publish(const Event& e)
        {
            std::lock_guard lock(mutex_);
            for (auto& listener : listeners_)
                listener(e);   // a listener may call subscribe() and deadlock
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void EventBus::publish(const Event& e)
        {
            std::vector<Listener> snapshot;
            {
                std::lock_guard lock(mutex_);
                snapshot = listeners_;
            }
            for (auto& listener : snapshot)
                listener(e);
        }
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, deadlock, callbacks]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-unknown
