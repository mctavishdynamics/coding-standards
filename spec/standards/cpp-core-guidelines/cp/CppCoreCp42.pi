use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp42:
    standard: @{CppCoreGuidelines}
    ruleId: CP.42
    title: Always wait on a condition variable with a predicate
    statement:
        Pass a predicate describing the awaited state to every condition variable
        wait, so the shared state is tested again each time the thread wakes.
    rationale:
        Without a predicate, a notify that fires before the wait begins is lost and
        the thread may sleep forever. A spurious wakeup can also return with nothing
        to do.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Job JobQueue::pop()
        {
            std::unique_lock lock(mutex_);
            ready_.wait(lock);   // may miss a notify or wake with an empty queue
            Job job = std::move(jobs_.front());
            jobs_.pop_front();
            return job;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        Job JobQueue::pop()
        {
            std::unique_lock lock(mutex_);
            ready_.wait(lock, [this] { return !jobs_.empty(); });
            Job job = std::move(jobs_.front());
            jobs_.pop_front();
            return job;
        }
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, condition-variables]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-wait
