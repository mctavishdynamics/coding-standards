use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp25:
    standard: @{CppCoreGuidelines}
    ruleId: CP.25
    title: Use a thread type that joins on destruction
    statement:
        Prefer std::jthread in C++20, or gsl::joining_thread, over std::thread, so
        the thread is joined automatically when its owner goes away.
    rationale:
        Destroying a std::thread that was never joined or detached
        calls std::terminate, and a forgotten join is an easy slip.
        Threads that might end up detached are also hard to watch and
        to verify.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int main()
        {
            std::thread loader(load_assets);
            std::thread audio(start_audio);
        }   // destroyed while joinable: std::terminate
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int main()
        {
            std::jthread loader(load_assets);
            std::jthread audio(start_audio);
        }   // both join automatically
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, threads, raii]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-joining_thread
