use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp44:
    standard: @{CppCoreGuidelines}
    ruleId: CP.44
    title: Give every scoped lock object a variable name
    statement:
        Bind every lock guard to a named variable so it stays alive until the scope
        ends.
    rationale:
        A guard without a name is a temporary, which unlocks at the semicolon.
        Certain spellings even parse as a declaration of a fresh, unlocked object
        that hides the mutex.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void Counter::increment()
        {
            std::lock_guard<std::mutex>{mutex_};   // locks and unlocks immediately
            ++count_;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void Counter::increment()
        {
            std::lock_guard<std::mutex> lock{mutex_};
            ++count_;
        }
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, locking]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-name
