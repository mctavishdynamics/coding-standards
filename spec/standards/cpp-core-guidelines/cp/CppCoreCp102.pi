use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp102:
    standard: @{CppCoreGuidelines}
    ruleId: CP.102
    title: Learn the published research before writing lock-free code
    statement:
        Before shipping lock-free code that others build on, read the academic and
        industry literature on memory models and lock-free algorithms.
    rationale:
        Outside of basic atomics and a handful of well-known idioms, this area
        belongs to specialists, and the subtle mistakes are already documented.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [concurrency, lock-free]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-literature
