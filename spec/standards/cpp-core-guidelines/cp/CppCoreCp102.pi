use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp102:
    standard: @{CppCoreGuidelines}
    ruleId: CP.102
    title: Carefully study the literature
    statement:
        Become an expert on memory models and lock-free techniques, by
        studying the established literature, before shipping lock-free code
        for others to use.
    rationale:
        Apart from atomics and a few standard patterns, lock-free
        programming is an expert-only topic.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [concurrency, lock-free]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-literature
