use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp111:
    standard: @{CppCoreGuidelines}
    ruleId: CP.111
    title: Follow a proven recipe when double-checked locking is unavoidable
    statement:
        If you truly need double-checked locking for an expensive, rarely taken
        path, use the conventional form. The flag is a std::atomic that you test,
        then you take the lock, test the flag again and only then do the work.
    rationale:
        This idiom is notoriously easy to break. A plain or volatile flag makes the
        unlocked first test a data race.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        volatile bool rebuild_needed = true;
        std::mutex rebuild_mutex;

        void maybe_rebuild()
        {
            if (rebuild_needed) {
                std::lock_guard lock(rebuild_mutex);
                if (rebuild_needed) { rebuild(); rebuild_needed = false; }
            }
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::atomic<bool> rebuild_needed{true};
        std::mutex rebuild_mutex;

        void maybe_rebuild()
        {
            if (rebuild_needed) {
                std::lock_guard lock(rebuild_mutex);
                if (rebuild_needed) { rebuild(); rebuild_needed = false; }
            }
        }
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, locking, atomics]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-double-pattern
