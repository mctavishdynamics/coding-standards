use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp50:
    standard: @{CppCoreGuidelines}
    ruleId: CP.50
    title: Keep a mutex next to the data it protects
    statement:
        Put a mutex in the same class or struct as the data it guards and note which
        members it covers. If your library has a synchronized_value type that
        bundles the two, use it.
    rationale:
        The guarded data and its lock should be obvious to anyone reading the code.
        Keeping them apart invites locking the wrong mutex or skipping the lock.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::mutex registry_mutex;            // in one file
        // ...
        std::map<int, Session> sessions;      // in another file, guarded by which mutex?
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class SessionRegistry {
        public:
            void add(int id, Session s)
            {
                std::lock_guard lock(mutex_);
                sessions_.emplace(id, std::move(s));
            }
        private:
            std::mutex mutex_;                 // guards sessions_
            std::map<int, Session> sessions_;
        };
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, locking, design]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-mutex
