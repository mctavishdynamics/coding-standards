use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp200:
    standard: @{CppCoreGuidelines}
    ruleId: CP.200
    title: Reserve volatile for memory changed by hardware or code outside C++
    statement:
        Limit volatile to objects that hardware or non-C++ code reads or modifies,
        such as memory-mapped device registers. If you find volatile on a local or a
        class member, you most likely wanted std::atomic.
    rationale:
        The keyword only stops the compiler from removing or merging accesses that
        the outside world can see. It gives no ordering or atomicity between
        threads.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void poll()
        {
            volatile int attempts = 0;   // a local cannot be shared with hardware
            while (attempts++ < 10) try_once();
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // status register of a memory-mapped UART
        auto* const uart_status = reinterpret_cast<const volatile std::uint32_t*>(0x4000'1000);

        bool uart_ready() { return (*uart_status & 0x1u) != 0; }
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, volatile, hardware]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-volatile2
