use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp8:
    standard: @{CppCoreGuidelines}
    ruleId: CP.8
    title: Never rely on volatile to coordinate threads
    statement:
        Coordinate threads with std::atomic or mutexes. Do not use volatile for
        this.
    rationale:
        The C++ volatile qualifier does not make an operation atomic, does not
        create a happens-before relation and does not stop the compiler or CPU from
        reordering. Other languages give it thread meaning, but C++ does not.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        volatile bool stop_requested = false;

        void worker()
        {
            while (!stop_requested) process_next();   // still a data race
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::atomic<bool> stop_requested{false};

        void worker()
        {
            while (!stop_requested) process_next();
        }
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, volatile, atomics]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-volatile
