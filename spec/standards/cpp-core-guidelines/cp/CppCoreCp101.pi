use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp101:
    standard: @{CppCoreGuidelines}
    ruleId: CP.101
    title: Do not trust a lock-free design tested on one compiler and machine
    statement:
        Whenever the compiler, standard library, operating system or processor
        changes, test lock-free code again, thoroughly, for both correctness and
        speed.
    rationale:
        The hardware features lock-free code relies on differ from platform to
        platform and are hard to get right. Reordering of loads and stores makes
        such code fragile, so a design that passed on one machine can fail or slow
        down on another.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [cpp]
    tags: [concurrency, lock-free, portability, testing]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-distrust
