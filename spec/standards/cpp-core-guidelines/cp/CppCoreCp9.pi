use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp9:
    standard: @{CppCoreGuidelines}
    ruleId: CP.9
    title: Check concurrent code with analysis and testing tools
    statement:
        Besides reviews and tests, run tools on concurrent code. Examples are
        compiler thread-safety annotations checked at build time and race detectors
        such as ThreadSanitizer run against threaded tests.
    rationale:
        Ordinary review and testing rarely catch concurrency defects. Missed ones
        can corrupt memory, deadlock the program or open security holes.
    exceptions: null
    severity: null
    noncompliant: null
    compliant:
        ```cpp
        \\\
        class Account {
        public:
            void deposit(int amount)
            {
                std::lock_guard lock(mutex_);
                balance_ += amount;
            }
        private:
            std::mutex mutex_;
            int balance_ __attribute__((guarded_by(mutex_))) = 0;   // checked by clang -Wthread-safety
        };
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, tooling, testing]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-tools
