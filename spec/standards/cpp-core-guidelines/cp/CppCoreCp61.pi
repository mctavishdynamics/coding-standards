use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp61:
    standard: @{CppCoreGuidelines}
    ruleId: CP.61
    title: Launch concurrent work with std::async
    statement:
        Start asynchronous work through std::async or another factory that gives
        back a future. Avoid assembling threads, promises and packaged tasks by
        hand. When std::async does not fit, write a factory of your own, perhaps
        backed by a work queue.
    rationale:
        Raw threads and promises are as easy to misuse as raw owning pointers. A
        factory keeps thread creation and reuse in one place and gives callers
        nothing but a future.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::promise<Image> promise;
        std::future<Image> image = promise.get_future();
        std::thread([p = std::move(promise)]() mutable {
            p.set_value(decode("photo.jpg"));
        }).detach();
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::future<Image> image = std::async(std::launch::async, decode, "photo.jpg");
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, tasks, futures]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-async
