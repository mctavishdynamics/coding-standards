use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp53:
    standard: @{CppCoreGuidelines}
    ruleId: CP.53
    title: Pass coroutine arguments by value
    statement:
        Take coroutine parameters by value, even ones you would normally pass as
        const references, and do not use output parameters in coroutines.
    rationale:
        The caller may return once the coroutine first suspends, so any reference
        parameter can dangle from then on, and using it is undefined behavior.
        Values are copied into the coroutine frame and live as long as it does.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Task<std::size_t> count_words(const std::string& text)
        {
            co_await scheduler.yield();
            co_return split(text).size();   // text may refer to a destroyed string
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        Task<std::size_t> count_words(std::string text)
        {
            co_await scheduler.yield();
            co_return split(text).size();
        }
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, coroutines, parameters]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rcoro-reference-parameters
