use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp3:
    standard: @{CppCoreGuidelines}
    ruleId: CP.3
    title: Share as little mutable data between threads as possible
    statement:
        Keep the amount of writable state that threads share to a minimum. Hand
        read-only input to tasks as const, and favor copies or passing messages over
        a shared mutable object.
    rationale:
        Immutable data can never race. Every shared mutable object is another spot
        where synchronization can be forgotten and where threads may queue up behind
        a lock.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void analyse(std::vector<Sample>& samples)
        {
            auto stats = std::async([&] { return summarize(samples); });
            auto peaks = std::async([&] { return find_peaks(samples); });
            // must inspect both functions to know whether they modify samples
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void analyse(const std::vector<Sample>& samples)
        {
            auto stats = std::async([&] { return summarize(samples); });
            auto peaks = std::async([&] { return find_peaks(samples); });
            // samples is read-only here, so the tasks cannot race on it
        }
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, immutability, shared-state]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-data
