use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp51:
    standard: @{CppCoreGuidelines}
    ruleId: CP.51
    title: Do not write coroutine lambdas that capture variables
    statement:
        Give coroutine lambdas an empty capture list. Pass what they need as
        by-value parameters, or turn the coroutine into a named function.
    rationale:
        Captured values are stored in the closure, and the closure can be destroyed
        while the coroutine sits suspended. When it resumes it then reads freed
        storage. Copying values or holding shared_ptr captures does not help.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        auto upload = [client, path]() -> Task<void> {
            co_await client->connect();
            co_await client->send_file(path);   // closure may already be gone
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        auto upload = [](std::shared_ptr<Client> client, std::string path) -> Task<void> {
            co_await client->connect();
            co_await client->send_file(path);   // parameters live in the coroutine frame
        };
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, coroutines, lifetime]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rcoro-capture
