use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp60:
    standard: @{CppCoreGuidelines}
    ruleId: CP.60
    title: Get results from concurrent work through a future
    statement:
        Have a concurrent task hand back its result through a std::future instead of
        writing it into a variable that another thread reads.
    rationale:
        A future works like a normal return value for code that runs elsewhere. The
        caller needs no lock, and it receives either the value or the exception the
        task threw.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        Report report;
        std::mutex report_mutex;
        std::thread t([&] {
            Report r = build_report();
            std::lock_guard lock(report_mutex);
            report = std::move(r);
        });
        t.join();
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::future<Report> pending = std::async(build_report);
        Report report = pending.get();   // also rethrows any exception
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, futures, tasks]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-future
