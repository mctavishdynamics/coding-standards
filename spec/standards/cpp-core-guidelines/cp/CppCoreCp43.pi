use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp43:
    standard: @{CppCoreGuidelines}
    ruleId: CP.43
    title: Keep the code that runs under a lock short
    statement:
        Lock only around the statements that touch the guarded data. Do setup and
        follow-up work outside, and use an inner block to end the lock object early.
    rationale:
        Every moment a mutex is held, other threads may be stalled, and putting a
        thread to sleep and waking it again is costly.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void Cache::store(const Key& key, const Blob& raw)
        {
            std::lock_guard lock(mutex_);
            Entry entry = decode(raw);   // slow and does not need the lock
            entries_[key] = std::move(entry);
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void Cache::store(const Key& key, const Blob& raw)
        {
            Entry entry = decode(raw);
            {
                std::lock_guard lock(mutex_);
                entries_[key] = std::move(entry);
            }
        }
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, locking, performance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-time
