use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp32:
    standard: @{CppCoreGuidelines}
    ruleId: CP.32
    title: Use shared_ptr when unrelated threads jointly own an object
    statement:
        Use std::shared_ptr, or something with the same semantics, for a heap object
        that several threads with independent lifetimes need and that must be freed
        eventually.
    rationale:
        When no thread is guaranteed to finish last, reference counting is the only
        reliable way to free the object once, after its final user is done.
    exceptions:
        Sharing without a shared_ptr is fine for statics that belong to no thread,
        for heap objects that are deliberately never freed, and for objects whose
        owning thread is known to outlive every user.
    severity: null
    noncompliant:
        ```cpp
        \\\
        auto* config = new Config(load_config());
        std::thread(watch_changes, config).detach();
        std::thread(serve_requests, config).detach();
        // who deletes config, and when?
        \\\
        ```
    compliant:
        ```cpp
        \\\
        auto config = std::make_shared<const Config>(load_config());
        std::thread(watch_changes, config).detach();
        std::thread(serve_requests, config).detach();
        // deleted when the last thread drops its copy
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, ownership, smart-pointers]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-shared
