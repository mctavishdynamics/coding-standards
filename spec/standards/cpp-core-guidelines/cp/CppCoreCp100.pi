use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp100:
    standard: @{CppCoreGuidelines}
    ruleId: CP.100
    title: Reserve lock-free algorithms for cases with no workable alternative
    statement:
        Prefer a mutex or a proven lock-free container from a trusted library over
        hand-written atomics with compare-and-swap loops.
    rationale:
        Correct lock-free code demands deep knowledge of the memory model, the
        hardware and the data structure. Its failures, such as ABA, are timing
        dependent and almost never appear in tests.
    exceptions:
        Ordinary std::atomic variables left at their default sequentially consistent
        ordering are not a problem. Experts are not needed for those.
    severity: null
    noncompliant:
        ```cpp
        \\\
        void Stack::push(Node* n)
        {
            n->next = head_.load();
            while (!head_.compare_exchange_weak(n->next, n)) {
            }
        }

        Node* Stack::pop()   // suffers from the ABA problem
        {
            Node* old = head_.load();
            while (old && !head_.compare_exchange_weak(old, old->next)) {
            }
            return old;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void Stack::push(Item item)
        {
            std::lock_guard lock(mutex_);
            items_.push_back(std::move(item));
        }
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, lock-free, atomics]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-lockfree
