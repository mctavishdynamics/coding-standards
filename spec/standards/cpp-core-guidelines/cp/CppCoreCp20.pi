use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp20:
    standard: @{CppCoreGuidelines}
    ruleId: CP.20
    title: Hold mutexes through scoped lock objects
    statement:
        Lock a mutex through an RAII guard like std::scoped_lock, std::lock_guard
        or std::unique_lock. Avoid paired lock() and unlock() calls.
    rationale:
        With manual calls, any early return, thrown exception or careless edit can
        skip the unlock and leave the mutex held, which stalls every other thread
        waiting for it.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void Inventory::add(Item item)
        {
            mutex_.lock();
            if (!item.valid()) return;   // mutex never released
            items_.push_back(std::move(item));
            mutex_.unlock();
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void Inventory::add(Item item)
        {
            std::lock_guard lock(mutex_);
            if (!item.valid()) return;
            items_.push_back(std::move(item));
        }
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, raii, locking]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-raii
