use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp31:
    standard: @{CppCoreGuidelines}
    ruleId: CP.31
    title: Copy small data into a thread instead of sharing it
    statement:
        When a task only needs a little data, pass it by value so the task owns its
        own copy. Do not give it a pointer or reference to something other threads
        can change.
    rationale:
        For small objects a copy costs less than a lock. The task then owns the data
        outright, so it cannot race with anyone. Large objects may still be worth
        sharing, because copying them is expensive.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void normalize(std::string& name);   // works on the caller's string

        void handle(std::string& name)
        {
            auto job = std::async(normalize, std::ref(name));   // name is now shared
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::string normalized(std::string name);   // works on its own copy

        void handle(const std::string& name)
        {
            auto job = std::async(normalized, name);
        }
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, parameters, data-races]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-data-by-value
