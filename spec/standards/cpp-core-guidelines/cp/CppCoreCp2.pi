use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreCp2:
    standard: @{CppCoreGuidelines}
    ruleId: CP.2
    title: Never let threads touch shared data without synchronization
    statement:
        Synchronize every access to an object that one thread writes while another
        thread reads or writes it.
    rationale:
        Unsynchronized concurrent access is undefined behavior, so the program has
        no defined meaning at all. The bugs it causes are intermittent and hard to
        trace, because the optimizer may assume no other thread changes the value
        and generate code that misbehaves when one does.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int next_ticket()
        {
            static int ticket = 0;
            return ++ticket;   // two threads can read and write it at once
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int next_ticket()
        {
            static std::atomic<int> ticket{0};
            return ++ticket;
        }
        \\\
        ```
    languages: [cpp]
    tags: [concurrency, data-races, undefined-behavior]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#rconc-races
