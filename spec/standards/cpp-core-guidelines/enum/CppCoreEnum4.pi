use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEnum4:
    standard: @{CppCoreGuidelines}
    ruleId: Enum.4
    title: Give enums the operators they need to be used safely
    statement:
        Write the operators and helper functions an enumeration needs, for
        example stepping to the next value or combining flags, directly on
        the enum type.
    rationale:
        Callers then never have to cast to an integer and back. Each cast is
        a chance to produce a value that matches no enumerator, so keeping
        the logic in one place prevents bugs and keeps call sites short.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        enum class Light { red, amber, green };

        Light next = static_cast<Light>(static_cast<int>(Light::green) + 1);
        // next holds no valid enumerator
        \\\
        ```
    compliant:
        ```cpp
        \\\
        enum class Light { red, amber, green };

        Light advance(Light l) {
            switch (l) {
            case Light::red:   return Light::green;
            case Light::green: return Light::amber;
            case Light::amber: return Light::red;
            }
            return Light::red;
        }
        \\\
        ```
    languages: [cpp]
    tags: [enumerations, operators]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#renum-oper
