use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEnum3:
    standard: @{CppCoreGuidelines}
    ruleId: Enum.3
    title: Choose scoped enums over unscoped ones
    statement:
        Use enum class by default. Fall back to a plain enum only for a
        concrete need.
    rationale:
        A plain enum quietly turns into an int and dumps its enumerators
        into the enclosing scope. Both behaviours let unrelated values mix
        without any warning.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        enum Fruit { apple, pear };
        enum Color { red, green };

        bool same = (apple == red);   // compiles
        \\\
        ```
    compliant:
        ```cpp
        \\\
        enum class Fruit { apple, pear };
        enum class Color { red, green };

        // Fruit::apple == Color::red does not compile
        \\\
        ```
    languages: [cpp]
    tags: [enumerations, type-safety, scope]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#renum-class
