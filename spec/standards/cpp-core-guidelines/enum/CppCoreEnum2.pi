use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEnum2:
    standard: @{CppCoreGuidelines}
    ruleId: Enum.2
    title: Use enumerations for sets of related named constants
    statement:
        When several constants belong to one group, express them as the
        enumerators of one enumeration.
    rationale:
        An enumeration shows that the values are related, gives them a named
        type, and lets compilers warn about switch statements that miss a
        case.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        constexpr int red = 0;
        constexpr int amber = 1;
        constexpr int green = 2;

        void set_light(int color);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        enum class Light { red, amber, green };

        void set_light(Light color);
        \\\
        ```
    languages: [cpp]
    tags: [enumerations, type-safety]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#renum-set
