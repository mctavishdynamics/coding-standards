use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEnum2:
    standard: @{CppCoreGuidelines}
    ruleId: Enum.2
    title: Group named constants that belong together in an enum
    statement:
        Constants that form one family should be the enumerators of a single
        enumeration type.
    rationale:
        Grouping them gives the family a type name and makes the relation
        visible to readers. Compilers can then check a switch over that type
        and warn when a case is missing.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        constexpr int red = 0;
        constexpr int amber = 1;
        constexpr int green = 2;

        void set_light(int color);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        enum class Light { red, amber, green };

        void set_light(Light color);
        \\\
        ```
    languages: [cpp]
    tags: [enumerations, type-safety]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#renum-set
