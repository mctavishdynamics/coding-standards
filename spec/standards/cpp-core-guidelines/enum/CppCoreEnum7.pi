use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEnum7:
    standard: @{CppCoreGuidelines}
    ruleId: Enum.7
    title: Leave an enum's underlying type unspecified unless it matters
    statement:
        Only write an explicit underlying type when it is needed, such as to
        pin the storage size, to fix the bit width, or to forward-declare
        the enumeration.
    rationale:
        Omitting it keeps the declaration short and clear. The default, int,
        is the natural integer type and matches what C uses for its enums.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        enum class Mode : int { read, write };   // states the default for no reason
        \\\
        ```
    compliant:
        ```cpp
        \\\
        enum class Mode { read, write };

        enum class Flag : std::uint8_t { a, b, c };   // packed into a byte on purpose
        \\\
        ```
    languages: [cpp]
    tags: [enumerations, types]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#renum-underlying
