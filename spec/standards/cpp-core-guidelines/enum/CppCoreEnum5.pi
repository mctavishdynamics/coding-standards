use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEnum5:
    standard: @{CppCoreGuidelines}
    ruleId: Enum.5
    title: Name enumerators without shouting capitals
    statement:
        Spell enumerator names like ordinary identifiers. Keep all-capital
        names out of enumerations.
    rationale:
        Upper-case names are the customary form for macros. An enumerator
        spelled that way risks being replaced by a macro of the same name,
        which yields confusing compile errors.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        enum class Status { OK, NOT_FOUND, ERROR };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        enum class Status { ok, not_found, error };
        \\\
        ```
    languages: [cpp]
    tags: [enumerations, naming, macros]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#renum-caps
