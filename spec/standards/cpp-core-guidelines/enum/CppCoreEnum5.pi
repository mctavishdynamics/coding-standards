use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEnum5:
    standard: @{CppCoreGuidelines}
    ruleId: Enum.5
    title: Do not use ALL_CAPS for enumerators
    statement:
        Name enumerators in the same style as other identifiers, not in all
        capitals.
    rationale:
        All-capital names are by convention reserved for macros, and an
        enumerator named that way can clash with one.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        enum class Status { OK, NOT_FOUND, ERROR };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        enum class Status { ok, not_found, error };
        \\\
        ```
    languages: [cpp]
    tags: [enumerations, naming, macros]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#renum-caps
