use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEnum1:
    standard: @{CppCoreGuidelines}
    ruleId: Enum.1
    title: Define related constants as an enum instead of macros
    statement:
        Reach for an enumeration, not a list of #define lines, when you need
        a group of named integer constants.
    rationale:
        The preprocessor knows nothing about scopes or types, so a macro
        name can collide with anything. Its name is also gone before
        compilation, which means a debugger shows only a bare number.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        #define LEVEL_DEBUG 0
        #define LEVEL_INFO  1
        #define LEVEL_ERROR 2
        \\\
        ```
    compliant:
        ```cpp
        \\\
        enum class Level { debug, info, error };
        \\\
        ```
    languages: [cpp]
    tags: [enumerations, macros, type-safety]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#renum-macro
