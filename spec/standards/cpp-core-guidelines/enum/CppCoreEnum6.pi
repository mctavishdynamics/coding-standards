use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEnum6:
    standard: @{CppCoreGuidelines}
    ruleId: Enum.6
    title: Give every enumeration a name
    statement:
        Every enumeration should carry a type name. Unrelated integer
        constants belong in separate constexpr variables.
    rationale:
        Failing to find a name for an enumeration is a sign that its values
        have nothing in common. Anonymous enums used as a source of
        constants are a habit from older C++.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        enum { max_users = 100, buffer_size = 4096 };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        constexpr int max_users = 100;
        constexpr int buffer_size = 4096;
        \\\
        ```
    languages: [cpp]
    tags: [enumerations, constants]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#renum-unnamed
