use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEnum8:
    standard: @{CppCoreGuidelines}
    ruleId: Enum.8
    title: Assign enumerator values explicitly only when they matter
    statement:
        Give enumerators explicit values only when the numbers mean
        something, as with wire formats, conventional codes or bit masks.
        Otherwise let the compiler count.
    rationale:
        Automatic numbering is the simplest choice and cannot produce two
        enumerators with the same value by accident. Its dense sequence also
        suits switch statements well.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        enum class Suit { clubs = 0, diamonds = 1, hearts = 2, spades = 2 };   // duplicate
        \\\
        ```
    compliant:
        ```cpp
        \\\
        enum class Suit { clubs, diamonds, hearts, spades };

        enum class HttpStatus { ok = 200, not_found = 404 };   // values matter
        \\\
        ```
    languages: [cpp]
    tags: [enumerations]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#renum-value
