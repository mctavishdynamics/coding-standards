use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs41:
    standard: @{CppCoreGuidelines}
    ruleId: ES.41
    title: Add parentheses when operator precedence is unclear
    statement:
        If the grouping of operators might be unclear, write the
        parentheses. This matters most where bitwise operators meet
        comparisons or logical operators.
    rationale:
        Few programmers have the full precedence table in their heads.
        Explicit grouping avoids misreadings and shows what the code is
        meant to do.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        if (flags & mask == mask) enable();   // parsed as flags & (mask == mask)
        \\\
        ```
    compliant:
        ```cpp
        \\\
        if ((flags & mask) == mask) enable();
        \\\
        ```
    languages: [cpp]
    tags: [expressions, operators]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-parens
