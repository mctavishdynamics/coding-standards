use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs20:
    standard: @{CppCoreGuidelines}
    ruleId: ES.20
    title: Give every object an initial value
    statement:
        Every variable should receive a value in its declaration.
    rationale:
        Reading an unset variable is undefined behavior, and initializing at
        the point of declaration removes that risk. It also makes
        complicated setup easier to follow and code easier to restructure
        later.
    exceptions:
        A large buffer that input is about to overwrite may be left
        uninitialized to avoid paying twice, though such cases deserve
        suspicion. A plain variable that receives input is not covered by
        this exemption.
    severity: null
    noncompliant:
        ```cpp
        \\\
        int status;
        if (connected) status = 200;
        send(status);       // may read garbage
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int status = connected ? 200 : 503;
        send(status);
        \\\
        ```
    languages: [cpp]
    tags: [initialization, undefined-behavior]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-always
