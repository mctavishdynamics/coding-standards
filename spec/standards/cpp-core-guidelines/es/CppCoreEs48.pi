use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs48:
    standard: @{CppCoreGuidelines}
    ruleId: ES.48
    title: Keep casts to a minimum
    statement:
        Aim for designs that need no casts. If you find yourself writing
        one, take that as a hint to revisit the types involved.
    rationale:
        A cast tells the compiler to stop checking, which is how many hard
        bugs get in. Reinterpreting objects can also invalidate assumptions
        the optimizer makes, giving undefined behavior.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void on_event(void* data) {
            auto* click = (ClickEvent*)data;
            handle(click->x, click->y);
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void on_event(const ClickEvent& click) {
            handle(click.x, click.y);
        }
        \\\
        ```
    languages: [cpp]
    tags: [casts, type-safety]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-casts
