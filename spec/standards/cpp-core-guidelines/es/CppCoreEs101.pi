use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs101:
    standard: @{CppCoreGuidelines}
    ruleId: ES.101
    title: Do bit twiddling on unsigned types
    statement:
        Bit fields, flag sets and masks should be stored in unsigned integer
        types.
    rationale:
        With unsigned types, shifting and masking behave predictably. Signed
        types add sign-bit effects that make the results surprising.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int flags = read_flags();
        int high = flags >> 28;       // sign extension when the top bit is set
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::uint32_t flags = read_flags();
        std::uint32_t high = flags >> 28;
        \\\
        ```
    languages: [cpp]
    tags: [arithmetic, bit-manipulation]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-unsigned
