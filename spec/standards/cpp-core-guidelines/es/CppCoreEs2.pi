use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs2:
    standard: @{CppCoreGuidelines}
    ruleId: ES.2
    title: Use a fitting abstraction instead of raw language features
    statement:
        Write code in terms of a library component or class that fits the
        task. Avoid assembling it from bare loops, raw pointers and C
        arrays.
    rationale:
        An abstraction that mirrors the problem domain makes the code
        shorter and clearer. A shared component is also likely to have been
        exercised far more than one-off code.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        char* words[100];
        int n = 0;
        char buf[64];
        while (n < 100 && std::scanf("%63s", buf) == 1)
            words[n++] = strdup(buf);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::vector<std::string> words;
        for (std::string w; std::cin >> w; )
            words.push_back(w);
        \\\
        ```
    languages: [cpp]
    tags: [abstraction, simplicity]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-abstr
