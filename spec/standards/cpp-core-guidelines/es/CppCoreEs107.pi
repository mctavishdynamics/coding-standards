use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs107:
    standard: @{CppCoreGuidelines}
    ruleId: ES.107
    title: Index with a signed type such as gsl::index
    statement:
        Subscripts and loop counters that walk a container should have a
        signed type, ideally gsl::index.
    rationale:
        A signed index removes confusion between signed and unsigned values.
        It also gives optimizers and checkers more to work with, and
        sidesteps traps such as auto deducing int from a literal.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        for (unsigned i = 0; i < v.size(); ++i)
            v[i] = 0;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        for (gsl::index i = 0; i < std::ssize(v); ++i)
            v[i] = 0;
        \\\
        ```
    languages: [cpp]
    tags: [arithmetic, types, loops]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-subscripts
