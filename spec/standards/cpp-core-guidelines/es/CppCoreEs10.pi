use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs10:
    standard: @{CppCoreGuidelines}
    ruleId: ES.10
    title: Introduce a single name in each declaration
    statement:
        Write a separate declaration statement for each name you introduce.
    rationale:
        Packing several names into one line makes the declarator rules of C
        easy to misread, as with pointers and arrays declared together. A
        line per name is clearer and has space for a short trailing comment.
    exceptions:
        Function parameter lists naturally declare several names. So do
        structured bindings, which exist precisely to unpack several values
        in one declaration.
    severity: null
    noncompliant:
        ```cpp
        \\\
        int* first, last;   // last is an int, not a pointer
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int* first = nullptr;
        int* last = nullptr;
        \\\
        ```
    languages: [cpp]
    tags: [declarations, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-name-one
