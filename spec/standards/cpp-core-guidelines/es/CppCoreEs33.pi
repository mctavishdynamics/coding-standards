use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs33:
    standard: @{CppCoreGuidelines}
    ruleId: ES.33
    title: Prefix unavoidable macros so their names cannot clash
    statement:
        When a macro cannot be avoided, give it a long and unusual name, for
        example one starting with your project or company prefix.
    rationale:
        Macros ignore namespaces and scopes. A short or common name will
        sooner or later collide with someone else's identifier and silently
        change unrelated code.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        #define CHECK(x) if (!(x)) std::abort()
        \\\
        ```
    compliant:
        ```cpp
        \\\
        #define ACME_NET_CHECK(x) if (!(x)) std::abort()
        \\\
        ```
    languages: [cpp]
    tags: [macros, naming]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-macros3
