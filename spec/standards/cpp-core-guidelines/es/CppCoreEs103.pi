use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs103:
    standard: @{CppCoreGuidelines}
    ruleId: ES.103
    title: Keep arithmetic within the range of its type
    statement:
        Ensure the result of each arithmetic operation fits its type. Where
        an operand could be large, test the bounds before computing.
    rationale:
        A value that exceeds its type's range turns a calculation into
        nonsense. For signed types it is undefined behavior, and an index or
        size that overflows can damage memory.
    exceptions:
        Deliberate wraparound is fine on unsigned types. Where the overhead
        is acceptable, safety-critical code can switch to numeric types that
        check their range.
    severity: null
    noncompliant:
        ```cpp
        \\\
        int total_ms(int seconds) {
            return seconds * 1000;          // overflows past about 24 days
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::int64_t total_ms(std::int64_t seconds) {
            return seconds * 1000;
        }
        \\\
        ```
    languages: [cpp]
    tags: [arithmetic, undefined-behavior]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-overflow
