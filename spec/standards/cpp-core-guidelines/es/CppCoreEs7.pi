use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs7:
    standard: @{CppCoreGuidelines}
    ruleId: ES.7
    title: Match name length to how widely the name is used
    statement:
        Short names like i or n are fine for local variables with a
        conventional role. Things that are used rarely, or far from where
        they are declared, deserve longer descriptive names.
    rationale:
        Brief local names keep small pieces of code easy to scan.
        Wider-reaching names must carry their own meaning, and longer names
        also make collisions less likely.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int number_of_the_current_element_index = 0;   // local loop counter
        void p(Order& o);                               // public function
        \\\
        ```
    compliant:
        ```cpp
        \\\
        for (int i = 0; i < n; ++i) total += v[i];
        void print_invoice(const Order& order);
        \\\
        ```
    languages: [cpp]
    tags: [naming, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-name-length
