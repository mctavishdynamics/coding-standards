use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs65:
    standard: @{CppCoreGuidelines}
    ruleId: ES.65
    title: Never dereference a pointer that does not point to a live object
    statement:
        Only dereference a pointer, iterator or view that refers to a live
        object. Never dereference one that is null, dangling or past the
        end.
    rationale:
        Using an invalid pointer is undefined behavior. The usual outcomes
        are crashes, garbage values or corrupted memory.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int* find_slot();

        void reserve() {
            *find_slot() = 1;          // find_slot may return nullptr
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int* find_slot();

        void reserve() {
            if (int* slot = find_slot())
                *slot = 1;
        }
        \\\
        ```
    languages: [cpp]
    tags: [pointers, undefined-behavior]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-deref
