use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs63:
    standard: @{CppCoreGuidelines}
    ruleId: ES.63
    title: Avoid copying a derived object into a base object
    statement:
        Avoid initializing or assigning a base class object from a derived
        object. Work through a pointer or a reference, or convert explicitly
        with a named function.
    rationale:
        Copying into the base keeps only the base portion and throws away
        the rest. The object was meant to be handled whole, so this is
        usually a bug, and even an intended slice confuses readers.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void show(Shape s);          // takes a copy of the base part

        Circle c{1.0};
        show(c);                     // Circle-specific state is lost
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void show(const Shape& s);

        Circle c{1.0};
        show(c);
        \\\
        ```
    languages: [cpp]
    tags: [classes, inheritance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-slice
