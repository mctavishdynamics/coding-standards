use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs44:
    standard: @{CppCoreGuidelines}
    ruleId: ES.44
    title: Keep function arguments independent of the order they are evaluated in
    statement:
        Calls should give the same result whatever order their arguments are
        evaluated in. Avoid passing arguments with side effects that
        interact.
    rationale:
        C++ leaves the evaluation order of function arguments unspecified,
        even after the stricter C++17 rules.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        draw_line(read_point(in), read_point(in));   // which point comes first?
        \\\
        ```
    compliant:
        ```cpp
        \\\
        const Point from = read_point(in);
        const Point to = read_point(in);
        draw_line(from, to);
        \\\
        ```
    languages: [cpp]
    tags: [expressions, portability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-order-fct
