use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs34:
    standard: @{CppCoreGuidelines}
    ruleId: ES.34
    title: Do not write variadic functions in the C style
    statement:
        Avoid writing functions with a C-style ellipsis parameter. Use a
        variadic template, an initializer_list or a set of overloads.
    rationale:
        Arguments passed through an ellipsis lose their types, so the
        compiler cannot check them. Reading them back needs va_arg and
        casts, and a wrong guess about a type is undefined behavior.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int sum(int count, ...) {
            va_list args;
            va_start(args, count);
            int total = 0;
            for (int i = 0; i < count; ++i) total += va_arg(args, int);
            va_end(args);
            return total;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        template<class... Ts>
        int sum(Ts... values) {
            return (0 + ... + values);
        }
        \\\
        ```
    languages: [cpp]
    tags: [functions, type-safety]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-ellipses
