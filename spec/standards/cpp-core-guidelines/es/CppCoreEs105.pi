use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs105:
    standard: @{CppCoreGuidelines}
    ruleId: ES.105
    title: Check for a zero divisor before integer division
    statement:
        Before an integer division or a modulo operation, confirm the
        divisor cannot be zero, for example with a precondition check.
    rationale:
        Dividing an integer by zero has undefined behavior, and on most
        platforms the program simply crashes.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int average(int sum, int count) {
            return sum / count;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int average(int sum, int count) {
            Expects(count != 0);
            return sum / count;
        }
        \\\
        ```
    languages: [cpp]
    tags: [arithmetic, undefined-behavior]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-zero
