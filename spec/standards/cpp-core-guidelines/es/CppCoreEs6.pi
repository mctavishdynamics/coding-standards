use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs6:
    standard: @{CppCoreGuidelines}
    ruleId: ES.6
    title: Declare loop and condition variables inside the statement header
    statement:
        A variable that only a loop or a single branch needs should be
        declared in that statement, either in the for initializer or in the
        condition or init part of if, switch or while.
    rationale:
        The variable then disappears when the statement ends. It cannot be
        reused by mistake for a different job later, and anything it holds
        is released promptly.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        auto it = cache.find(key);
        if (it != cache.end())
            return it->second;
        // it is still visible and easily misused here
        \\\
        ```
    compliant:
        ```cpp
        \\\
        if (auto it = cache.find(key); it != cache.end())
            return it->second;
        \\\
        ```
    languages: [cpp]
    tags: [scope, control-flow]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-cond
