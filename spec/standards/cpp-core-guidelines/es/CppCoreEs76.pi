use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs76:
    standard: @{CppCoreGuidelines}
    ruleId: ES.76
    title: Steer clear of goto
    statement:
        Express control flow with loops, functions, break and return instead
        of goto.
    rationale:
        goto makes code hard to follow and easy to break. Humans have better
        structures available, and goto is mainly useful in machine-generated
        code.
    exceptions:
        Leaving a deeply nested loop with goto is acceptable, as long as the
        jump only goes forward.
    severity: null
    noncompliant:
        ```cpp
        \\\
        int i = 0;
        again:
        if (i < n) {
            handle(i++);
            goto again;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        for (int i = 0; i < n; ++i)
            handle(i);
        \\\
        ```
    languages: [cpp]
    tags: [control-flow, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-goto
