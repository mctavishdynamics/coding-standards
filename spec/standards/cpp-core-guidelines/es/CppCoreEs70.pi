use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs70:
    standard: @{CppCoreGuidelines}
    ruleId: ES.70
    title: Use switch when choosing among constant values
    statement:
        If you are picking among fixed constant values of one expression,
        write a switch instead of an if and else if chain.
    rationale:
        A switch is easier to read and compilers usually generate better
        code for it. For an enumeration they can also warn about values that
        have no case.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        if (state == State::idle) start();
        else if (state == State::running) poll();
        else if (state == State::stopped) cleanup();
        \\\
        ```
    compliant:
        ```cpp
        \\\
        switch (state) {
        case State::idle:    start();   break;
        case State::running: poll();    break;
        case State::stopped: cleanup(); break;
        }
        \\\
        ```
    languages: [cpp]
    tags: [control-flow, switch]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-switch-if
