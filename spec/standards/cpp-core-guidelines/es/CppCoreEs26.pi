use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs26:
    standard: @{CppCoreGuidelines}
    ruleId: ES.26
    title: Give each variable a single job
    statement:
        A variable should serve one purpose. When the code moves on to an
        unrelated task, declare a new variable for it.
    rationale:
        Reusing a variable obscures what it stands for. Leftover state from
        the first use can also seep into the second, which is a known source
        of bugs, including security holes with recycled buffers.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int n = count_users();
        print_users(n);
        n = count_orders();      // now means something else
        print_orders(n);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        const int user_count = count_users();
        print_users(user_count);
        const int order_count = count_orders();
        print_orders(order_count);
        \\\
        ```
    languages: [cpp]
    tags: [variables, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-recycle
