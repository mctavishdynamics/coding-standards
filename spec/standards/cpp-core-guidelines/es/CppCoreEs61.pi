use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs61:
    standard: @{CppCoreGuidelines}
    ruleId: ES.61
    title: Match array new with delete[] and single new with delete
    statement:
        Memory obtained with new[] must be released with delete[]. Memory
        obtained with plain new must be released with plain delete.
    rationale:
        The language requires the forms to match. Mixing them is undefined
        behavior that may corrupt the heap or skip destructors.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int* samples = new int[256];
        // ...
        delete samples;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int* samples = new int[256];
        // ...
        delete[] samples;
        \\\
        ```
    languages: [cpp]
    tags: [memory, undefined-behavior]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-del
