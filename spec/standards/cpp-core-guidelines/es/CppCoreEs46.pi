use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs46:
    standard: @{CppCoreGuidelines}
    ruleId: ES.46
    title: Avoid conversions that lose value or precision
    statement:
        Avoid arithmetic conversions to a type too small or too imprecise to
        represent the value. If losing information is intentional, say so
        with gsl::narrow_cast, or use gsl::narrow to have it checked.
    rationale:
        Narrowing silently drops digits, fractions or high bits. The loss
        usually goes unnoticed until the wrong value causes trouble
        somewhere else.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        long long bytes = file_size();
        int kb = bytes / 1024;          // may silently truncate
        \\\
        ```
    compliant:
        ```cpp
        \\\
        long long bytes = file_size();
        int kb = gsl::narrow<int>(bytes / 1024);   // throws if it does not fit
        \\\
        ```
    languages: [cpp]
    tags: [conversions, types]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-narrowing
