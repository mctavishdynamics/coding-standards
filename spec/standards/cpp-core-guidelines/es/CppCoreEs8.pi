use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs8:
    standard: @{CppCoreGuidelines}
    ruleId: ES.8
    title: Choose names that cannot be confused with each other
    statement:
        Within one scope, do not use names that differ only in characters
        that look alike, such as l and 1, O and 0, or rn and m. Also avoid
        giving a type and a non-type the same name there.
    rationale:
        Look-alike names slow readers down and invite using the wrong one by
        mistake.
    exceptions:
        Some old headers declare a struct and a function or variable with
        the same name in one scope, and that may be impossible to change.
    severity: null
    noncompliant:
        ```cpp
        \\\
        int l1 = 10;
        int ll = 20;
        int lI = 30;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int min_len = 10;
        int max_len = 20;
        int avg_len = 30;
        \\\
        ```
    languages: [cpp]
    tags: [naming, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-name-similar
