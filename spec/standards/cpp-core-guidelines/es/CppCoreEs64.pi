use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs64:
    standard: @{CppCoreGuidelines}
    ruleId: ES.64
    title: Use braces to construct a value of a type explicitly
    statement:
        When building an object of type T out of some expression e, write T
        followed by e inside braces. Avoid T with parentheses and the C cast
        notation for this.
    rationale:
        The brace form clearly means construction and refuses narrowing
        conversions. The other two notations can quietly perform dangerous
        conversions, such as reinterpreting a pointer.
    exceptions:
        For the standard containers, parentheses mean a size and braces mean
        a list of elements. Write std::vector<int>(10) when you want ten
        elements.
    severity: null
    noncompliant:
        ```cpp
        \\\
        auto level = int(3.9);         // silently becomes 3
        auto user = (UserId)raw_id;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        auto level = Level{3};
        auto user = UserId{raw_id};
        \\\
        ```
    languages: [cpp]
    tags: [initialization, conversions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-construct
