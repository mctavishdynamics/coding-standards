use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs78:
    standard: @{CppCoreGuidelines}
    ruleId: ES.78
    title: Mark or avoid every fall-through between switch cases
    statement:
        Close each case that has statements with break, return or throw.
        Where control is meant to flow into the next case, mark it with the
        fallthrough attribute.
    rationale:
        Forgetting a break is one of the most common switch bugs. Intended
        fall-through confuses later maintainers unless it is rare and
        clearly labelled.
    exceptions:
        Stacking several labels on one statement is fine, and a case that
        returns does not need a break. When you truly want fall-through,
        which should be uncommon, mark it with the fallthrough attribute.
    severity: null
    noncompliant:
        ```cpp
        \\\
        switch (level) {
        case Level::error:
            alert_oncall();
        case Level::warning:            // fallthrough: accident or intent?
            write_log();
            break;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        switch (level) {
        case Level::error:
            alert_oncall();
            [[fallthrough]];
        case Level::warning:
            write_log();
            break;
        }
        \\\
        ```
    languages: [cpp]
    tags: [switch, control-flow]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-break
