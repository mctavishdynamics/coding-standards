use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs50:
    standard: @{CppCoreGuidelines}
    ruleId: ES.50
    title: Never strip const with a cast
    statement:
        Do not remove const with const_cast or any other cast in order to
        modify an object.
    rationale:
        Code that takes a const reference promises not to change the object,
        and casting breaks that promise. If the object was really defined
        const, writing to it is undefined behavior.
    exceptions:
        Calling a function that is not const-correct may force a cast. Put
        the cast in a small inline wrapper with a correct const signature,
        so it appears in exactly one place.
    severity: null
    noncompliant:
        ```cpp
        \\\
        void clear(const std::vector<int>& v) {
            const_cast<std::vector<int>&>(v).clear();
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void clear(std::vector<int>& v) {
            v.clear();
        }
        \\\
        ```
    languages: [cpp]
    tags: [const, casts]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-casts-const
