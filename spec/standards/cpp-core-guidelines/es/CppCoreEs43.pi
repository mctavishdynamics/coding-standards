use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs43:
    standard: @{CppCoreGuidelines}
    ruleId: ES.43
    title: Avoid expressions whose evaluation order is unspecified
    statement:
        An expression should not change a variable while also reading or
        changing that same variable somewhere else without a sequencing
        guarantee.
    rationale:
        What such code computes depends on the compiler, its version and its
        optimization flags. It may appear to work today and break after an
        upgrade.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int doubled = ++count + count;   // read and write are unsequenced
        \\\
        ```
    compliant:
        ```cpp
        \\\
        ++count;
        int doubled = count + count;
        \\\
        ```
    languages: [cpp]
    tags: [undefined-behavior, expressions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-order
