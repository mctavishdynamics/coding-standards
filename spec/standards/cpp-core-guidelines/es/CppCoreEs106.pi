use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs106:
    standard: @{CppCoreGuidelines}
    ruleId: ES.106
    title: Validate non-negative values instead of relying on unsigned types
    statement:
        A value that must not be negative should still use a signed type,
        with an explicit check of the precondition. Unsigned is not a
        substitute for that check.
    rationale:
        A negative number assigned to an unsigned variable just wraps to a
        large one, so nothing is actually prevented. Meanwhile unsigned
        types switch on modular arithmetic, can hide overflow warnings and
        lead to mixed signed and unsigned bugs.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void set_volume(unsigned level);

        set_volume(-1);          // becomes 4294967295
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void set_volume(int level) {
            Expects(0 <= level && level <= 100);
            // ...
        }
        \\\
        ```
    languages: [cpp]
    tags: [arithmetic, types]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-nonnegative
