use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs31:
    standard: @{CppCoreGuidelines}
    ruleId: ES.31
    title: Don't use macros for constants or functions
    statement:
        Replace constant macros with constexpr variables and function-like
        macros with constexpr or inline functions or templates.
    rationale:
        Macros ignore scope, type and argument-passing rules and show the
        reader something different from what the compiler sees.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        #define BUFFER_SIZE 4096
        #define SQUARE(x) ((x) * (x))

        int y = SQUARE(next());     // next() is called twice
        \\\
        ```
    compliant:
        ```cpp
        \\\
        constexpr int buffer_size = 4096;
        constexpr int square(int x) { return x * x; }

        int y = square(next());
        \\\
        ```
    languages: [cpp]
    tags: [macros, preprocessor]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-macros2
