use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs31:
    standard: @{CppCoreGuidelines}
    ruleId: ES.31
    title: Replace constant and function macros with real language constructs
    statement:
        A constant should be a constexpr variable, not a #define. A
        function-like macro should be a constexpr function, an inline
        function or a template.
    rationale:
        Macros skip scope rules, type checks and normal argument passing.
        Their arguments can be evaluated twice or grouped wrongly, and the
        code the reader sees is not what gets compiled.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        #define BUFFER_SIZE 4096
        #define SQUARE(x) ((x) * (x))

        int y = SQUARE(next());     // next() is called twice
        \\\
        ```
    compliant:
        ```cpp
        \\\
        constexpr int buffer_size = 4096;
        constexpr int square(int x) { return x * x; }

        int y = square(next());
        \\\
        ```
    languages: [cpp]
    tags: [macros, preprocessor]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-macros2
