use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs84:
    standard: @{CppCoreGuidelines}
    ruleId: ES.84
    title: Always name the scoped guard objects you create
    statement:
        Give a name to every RAII object you create, such as a lock guard,
        so that it survives until the end of the block.
    rationale:
        C++ has no unnamed local variables. A guard written without a name
        is a temporary that is destroyed at the semicolon, so the lock is
        released at once.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void update() {
            std::lock_guard<std::mutex>{mtx};   // unlocked again immediately
            ++counter;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void update() {
            std::lock_guard<std::mutex> lock{mtx};
            ++counter;
        }
        \\\
        ```
    languages: [cpp]
    tags: [raii, declarations]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-noname
