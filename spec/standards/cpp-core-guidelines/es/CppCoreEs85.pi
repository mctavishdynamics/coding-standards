use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs85:
    standard: @{CppCoreGuidelines}
    ruleId: ES.85
    title: Write empty loop bodies so they are clearly intended
    statement:
        If a loop or an if is meant to do nothing in its body, write an
        empty pair of braces, perhaps with a comment. Do not end the header
        with a bare semicolon.
    rationale:
        A semicolon right after the header is nearly invisible and easy to
        type by accident. The following line then looks like the body but
        runs only once.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        for (p = head; p->next; p = p->next);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        for (p = head; p->next; p = p->next) {
            // find the last node
        }
        \\\
        ```
    languages: [cpp]
    tags: [readability, control-flow]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-empty
