use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs102:
    standard: @{CppCoreGuidelines}
    ruleId: ES.102
    title: Do ordinary arithmetic on signed types
    statement:
        Choose signed integer types for numbers you do arithmetic on, such
        as counts, offsets and differences.
    rationale:
        People expect subtracting a larger number from a smaller one to give
        a negative answer. Unsigned types instead wrap around to a huge
        value without any warning.
    exceptions:
        Modular arithmetic is the legitimate case for unsigned types. When
        code depends on wraparound, say so in a comment, since many readers
        will not expect it.
    severity: null
    noncompliant:
        ```cpp
        \\\
        unsigned stock = 3;
        unsigned ordered = 5;
        auto shortfall = stock - ordered;    // 4294967294, not -2
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int stock = 3;
        int ordered = 5;
        auto shortfall = stock - ordered;    // -2
        \\\
        ```
    languages: [cpp]
    tags: [arithmetic, types]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-signed
