use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs74:
    standard: @{CppCoreGuidelines}
    ruleId: ES.74
    title: Scope a loop variable to its for statement
    statement:
        Declare a for loop's variable in the loop's initializer, not on a
        line before it. ES.6 gives the general rule.
    rationale:
        Its lifetime ends with the loop, so it cannot be reused for
        something unrelated afterwards.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int i;
        for (i = 0; i < n; ++i)
            process(i);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        for (int i = 0; i < n; ++i)
            process(i);
        \\\
        ```
    languages: [cpp]
    tags: [loops, scope]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-for-init
