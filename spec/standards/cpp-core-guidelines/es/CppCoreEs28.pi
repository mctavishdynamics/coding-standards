use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs28:
    standard: @{CppCoreGuidelines}
    ruleId: ES.28
    title: Initialize tricky constants with an immediately invoked lambda
    statement:
        If a variable needs several statements to work out its value, put
        those statements in a lambda that is called on the spot. The
        variable can then be declared const.
    rationale:
        Temporary helpers used only for the computation stay inside the
        lambda. There is no need for a separate named function that nothing
        else will ever call.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::string greeting;
        if (user.vip()) greeting = "Welcome back, ";
        else greeting = "Hello, ";
        greeting += user.name();
        \\\
        ```
    compliant:
        ```cpp
        \\\
        const std::string greeting = [&] {
            std::string g = user.vip() ? "Welcome back, " : "Hello, ";
            return g + user.name();
        }();
        \\\
        ```
    languages: [cpp]
    tags: [initialization, const, lambdas]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-lambda-init
