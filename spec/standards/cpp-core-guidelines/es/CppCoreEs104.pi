use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs104:
    standard: @{CppCoreGuidelines}
    ruleId: ES.104
    title: Don't underflow
    statement:
        Make sure values are not decremented below the minimum their type
        can hold.
    rationale:
        Going below a minimum value can lead to memory corruption and
        undefined behavior.
    exceptions:
        Use unsigned types when you really want modular arithmetic.
    severity: null
    noncompliant:
        ```cpp
        \\\
        for (unsigned i = items.size() - 1; i >= 0; --i)   // never ends
            show(items[i]);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        for (auto i = std::ssize(items) - 1; i >= 0; --i)
            show(items[i]);
        \\\
        ```
    languages: [cpp]
    tags: [arithmetic, undefined-behavior]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-underflow
