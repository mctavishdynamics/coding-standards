use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs104:
    standard: @{CppCoreGuidelines}
    ruleId: ES.104
    title: Keep values from wrapping below the type's minimum
    statement:
        Ensure that decrements and subtractions never take a value under the
        smallest number its type can represent.
    rationale:
        Going below the minimum is undefined for signed integers and wraps
        for unsigned ones. If that value is then used as an index or a
        length, memory can be corrupted.
    exceptions:
        Deliberate wraparound on unsigned types is the one accepted use.
    severity: null
    noncompliant:
        ```cpp
        \\\
        for (unsigned i = items.size() - 1; i >= 0; --i)   // never ends
            show(items[i]);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        for (auto i = std::ssize(items) - 1; i >= 0; --i)
            show(items[i]);
        \\\
        ```
    languages: [cpp]
    tags: [arithmetic, undefined-behavior]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-underflow
