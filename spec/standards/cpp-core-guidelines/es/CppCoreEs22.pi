use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs22:
    standard: @{CppCoreGuidelines}
    ruleId: ES.22
    title: Delay a declaration until its initial value is known
    statement:
        Hold off declaring a variable until the point where its proper value
        is available.
    rationale:
        This narrows the scope and makes reading an unset value impossible.
        Constructing the object with its final value is usually also cheaper
        than default construction plus a later assignment.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::string name;
        // ...
        name = user.first() + " " + user.last();
        \\\
        ```
    compliant:
        ```cpp
        \\\
        // ...
        const std::string name = user.first() + " " + user.last();
        \\\
        ```
    languages: [cpp]
    tags: [initialization, declarations]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-init
