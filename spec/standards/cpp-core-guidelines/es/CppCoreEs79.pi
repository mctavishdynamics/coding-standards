use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs79:
    standard: @{CppCoreGuidelines}
    ruleId: ES.79
    title: Reserve the default label for the common case
    statement:
        Use default only for values that genuinely get the same treatment.
        If each enumerator deserves its own handling, write a case for every
        one and leave default out, so the compiler can report gaps.
    rationale:
        Readers can see which cases are special and which are the general
        path. Compilers can also flag enumerators added later that nobody
        handled.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        switch (color) {
        case Color::red:  paint_red();  break;
        default:          paint_blue(); break;   // green silently lands here
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        switch (color) {
        case Color::red:   paint_red();   break;
        case Color::green: paint_green(); break;
        case Color::blue:  paint_blue();  break;
        }
        \\\
        ```
    languages: [cpp]
    tags: [switch, control-flow]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-default
