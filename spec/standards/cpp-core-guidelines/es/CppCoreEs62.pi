use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs62:
    standard: @{CppCoreGuidelines}
    ruleId: ES.62
    title: Compare pointers only within the same array
    statement:
        Compare or subtract two pointers only when both point into one array
        or one object.
    rationale:
        The standard gives no meaning to ordering pointers that point into
        different arrays, so the result is undefined.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        bool comes_first(const std::vector<int>& xs, const std::vector<int>& ys)
        {
            return xs.data() < ys.data();   // two unrelated buffers
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        bool comes_first(const int* p, const int* q, std::span<const int> buf)
        {
            // both p and q are known to point into buf
            return p - buf.data() < q - buf.data();
        }
        \\\
        ```
    languages: [cpp]
    tags: [pointers, undefined-behavior]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-arr2
