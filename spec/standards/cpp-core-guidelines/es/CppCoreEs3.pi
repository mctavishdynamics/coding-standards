use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs3:
    standard: @{CppCoreGuidelines}
    ruleId: ES.3
    title: Factor out duplicated code
    statement:
        Eliminate repeated code. Pull the common part into one place, and
        use a standard algorithm where it fits rather than writing the logic
        again.
    rationale:
        Copies of the same code bury the intent, make the logic harder to
        trace and multiply the work of every later change. They usually come
        from copying and pasting.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        if (is_admin) {
            open_session();
            show_admin_panel();
        } else {
            open_session();
            show_dashboard();
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        open_session();
        if (is_admin)
            show_admin_panel();
        else
            show_dashboard();
        \\\
        ```
    languages: [cpp]
    tags: [duplication, maintainability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-dry
