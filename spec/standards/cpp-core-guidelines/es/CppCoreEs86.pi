use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs86:
    standard: @{CppCoreGuidelines}
    ruleId: ES.86
    title: Leave a counted loop's variable alone inside its body
    statement:
        Inside a for loop, do not update the counter that the header already
        advances. If the step size varies, write a while loop or rework the
        logic.
    rationale:
        Someone reading the header should be able to predict how the loop
        iterates. Changing the counter in two places breaks that and is a
        classic source of bugs.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        for (int i = 0; i < n; ++i) {
            if (is_escape(text[i])) ++i;    // skips a character
            emit(text[i]);
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int i = 0;
        while (i < n) {
            if (is_escape(text[i])) ++i;
            if (i < n) emit(text[i]);
            ++i;
        }
        \\\
        ```
    languages: [cpp]
    tags: [loops, control-flow]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-loop-counter
