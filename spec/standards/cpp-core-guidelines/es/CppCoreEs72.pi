use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs72:
    standard: @{CppCoreGuidelines}
    ruleId: ES.72
    title: Use a for loop when there is a clear loop counter
    statement:
        When a loop has an obvious counter or iterator, use a for statement
        and keep its declaration, condition and step together in the header.
    rationale:
        Readers see how the loop runs at a glance. The loop variable also
        exists only inside the loop.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int i = 0;
        while (i < retries) {
            attempt();
            ++i;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        for (int i = 0; i < retries; ++i)
            attempt();
        \\\
        ```
    languages: [cpp]
    tags: [loops, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-for-while
