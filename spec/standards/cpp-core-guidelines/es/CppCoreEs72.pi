use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs72:
    standard: @{CppCoreGuidelines}
    ruleId: ES.72
    title:
        Prefer a for statement to a while statement when there is an obvious
        loop variable
    statement:
        When a loop is driven by a counter or iterator, write it as a for
        loop that declares, tests and advances the variable in its header.
    rationale:
        The whole loop logic is visible up front and the loop variable's
        scope is limited to the loop.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int i = 0;
        while (i < retries) {
            attempt();
            ++i;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        for (int i = 0; i < retries; ++i)
            attempt();
        \\\
        ```
    languages: [cpp]
    tags: [loops, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-for-while
