use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs12:
    standard: @{CppCoreGuidelines}
    ruleId: ES.12
    title: Avoid shadowing an outer name in an inner scope
    statement:
        A name declared in an inner block should not match one already
        visible from an outer block, a class member or a parameter.
    rationale:
        When two variables share a name, readers and maintainers easily mix
        them up and change the wrong one. The risk grows with function
        length.
    exceptions:
        Reusing a base class function name in a derived class is allowed. Be
        aware that the new declaration hides every base overload of that
        name. Pull those overloads into the derived class with a using
        declaration.
    severity: null
    noncompliant:
        ```cpp
        \\\
        int total = 0;
        for (const auto& order : orders) {
            int total = order.amount();   // hides the outer total
            log(total);
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int total = 0;
        for (const auto& order : orders) {
            const int amount = order.amount();
            total += amount;
        }
        \\\
        ```
    languages: [cpp]
    tags: [naming, scope]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-reuse
