use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs12:
    standard: @{CppCoreGuidelines}
    ruleId: ES.12
    title: Do not reuse names in nested scopes
    statement:
        Do not declare a name in an inner scope that hides the same name in
        an enclosing scope, including members and function parameters.
    rationale:
        Hiding makes it easy to confuse which variable is meant and causes
        maintenance problems.
    exceptions:
        Derived classes commonly reuse base class function names. This is
        error-prone, so bring the base overloads in with a using
        declaration.
    severity: null
    noncompliant:
        ```cpp
        \\\
        int total = 0;
        for (const auto& order : orders) {
            int total = order.amount();   // hides the outer total
            log(total);
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int total = 0;
        for (const auto& order : orders) {
            const int amount = order.amount();
            total += amount;
        }
        \\\
        ```
    languages: [cpp]
    tags: [naming, scope]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-reuse
