use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs49:
    standard: @{CppCoreGuidelines}
    ruleId: ES.49
    title: Use a named C++ cast when a cast is unavoidable
    statement:
        If a conversion cannot be avoided, use static_cast, const_cast,
        reinterpret_cast, dynamic_cast or a GSL helper such as narrow_cast.
        Do not write C-style casts or functional-notation casts.
    rationale:
        Each named cast does one specific kind of conversion. The compiler
        can reject the wrong kind, and people and tools can search for every
        cast in the code.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int percent = (int)(ratio * 100);
        auto* bytes = (unsigned char*)&header;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int percent = static_cast<int>(ratio * 100);
        auto* bytes = reinterpret_cast<unsigned char*>(&header);
        \\\
        ```
    languages: [cpp]
    tags: [casts, type-safety]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-casts-named
