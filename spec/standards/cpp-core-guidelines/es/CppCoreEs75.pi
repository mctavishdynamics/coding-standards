use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs75:
    standard: @{CppCoreGuidelines}
    ruleId: ES.75
    title: Steer clear of do-while loops
    statement:
        Prefer while or for loops to do-while loops. Use do-while only when
        the body really has to execute once before any test.
    rationale:
        The condition of a do-while appears at the bottom, where readers may
        overlook it. It is also skipped entirely on the first pass, which is
        a source of bugs.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        do {
            process(next_item());
        } while (has_items());       // runs once even when there are no items
        \\\
        ```
    compliant:
        ```cpp
        \\\
        while (has_items())
            process(next_item());
        \\\
        ```
    languages: [cpp]
    tags: [loops, control-flow]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-do
