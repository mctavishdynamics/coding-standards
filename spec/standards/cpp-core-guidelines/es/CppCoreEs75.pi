use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs75:
    standard: @{CppCoreGuidelines}
    ruleId: ES.75
    title: Avoid do statements
    statement:
        Use a while or for loop instead of a do-while loop unless the body
        really must run once before the test.
    rationale:
        The termination condition sits at the end where it is easily
        overlooked, and it is not checked on the first pass.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        do {
            process(next_item());
        } while (has_items());       // runs once even when there are no items
        \\\
        ```
    compliant:
        ```cpp
        \\\
        while (has_items())
            process(next_item());
        \\\
        ```
    languages: [cpp]
    tags: [loops, control-flow]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-do
