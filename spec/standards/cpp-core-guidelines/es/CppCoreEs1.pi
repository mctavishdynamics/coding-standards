use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs1:
    standard: @{CppCoreGuidelines}
    ruleId: ES.1
    title: Reach for the standard library before other libraries or custom code
    statement:
        Before writing a facility yourself or pulling in a third-party
        package, check whether the standard library already provides it, and
        use that if it fits.
    rationale:
        A library call is typically far shorter than equivalent hand-written
        code and states the intent at a higher level. The ISO standard
        library ships with every C++ compiler, is familiar to most C++
        programmers and has been tested heavily.
    exceptions:
        Some standard components, the containers in particular, allocate on
        the heap and can be a poor fit for hard real-time or embedded
        systems. In those settings use an equivalent with the same
        interface, for example a standard-like container backed by a pool
        allocator.
    severity: null
    noncompliant:
        ```cpp
        \\\
        int total = 0;
        for (std::size_t i = 0; i < prices.size(); ++i)
            total += prices[i];
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int total = std::accumulate(prices.begin(), prices.end(), 0);
        \\\
        ```
    languages: [cpp]
    tags: [libraries, simplicity]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-lib
