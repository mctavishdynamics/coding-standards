use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs30:
    standard: @{CppCoreGuidelines}
    ruleId: ES.30
    title: Avoid macros that rewrite source text
    statement:
        Never use macros to produce or transform program text. Templates,
        constexpr functions and inline functions do the same jobs within the
        language.
    rationale:
        Macros sit outside scope and type checking, so the compiler sees
        code that differs from what the reader sees. They are behind a large
        share of bugs and make tools harder to write. Macros for
        configuration control, as with #ifdef, are not covered.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        #define DECLARE_GETTER(type, name) type get_##name() const { return name; }

        class User {
            std::string email;
        public:
            DECLARE_GETTER(std::string, email)
        };
        \\\
        ```
    compliant:
        ```cpp
        \\\
        class User {
            std::string email;
        public:
            const std::string& get_email() const { return email; }
        };
        \\\
        ```
    languages: [cpp]
    tags: [macros, preprocessor]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-macros
