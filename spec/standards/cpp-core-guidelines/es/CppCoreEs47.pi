use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs47:
    standard: @{CppCoreGuidelines}
    ruleId: ES.47
    title: Write nullptr for null pointers
    statement:
        Spell a null pointer as nullptr. Do not use 0 or NULL for that
        purpose.
    rationale:
        The literal 0 and the NULL macro are integers, so overloads and
        template deduction can pick an integer version by surprise. The type
        of nullptr is narrow and specific, so it always selects the pointer
        case and states the intent clearly.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void notify(int code);
        void notify(Listener* l);

        notify(NULL);      // may call notify(int)
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void notify(int code);
        void notify(Listener* l);

        notify(nullptr);
        \\\
        ```
    languages: [cpp]
    tags: [pointers, types]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-nullptr
