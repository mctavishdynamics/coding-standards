use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs55:
    standard: @{CppCoreGuidelines}
    ruleId: ES.55
    title: Design code so range checks are not needed
    statement:
        Use forms of access that cannot run off the end, such as range-for
        loops and standard algorithms, in preference to subscripts that have
        to be bounds-checked.
    rationale:
        Without an index there is no index to get wrong, so no check is
        needed. Such code is often faster as well.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        for (std::size_t i = 0; i <= names.size(); ++i)   // off by one
            print(names[i]);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        for (const auto& name : names)
            print(name);
        \\\
        ```
    languages: [cpp]
    tags: [bounds, loops]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-range-checking
