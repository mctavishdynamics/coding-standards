use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs9:
    standard: @{CppCoreGuidelines}
    ruleId: ES.9
    title: Keep capital-letter names for macros
    statement:
        Reserve all-capital names for macros. Constants, enumerators and
        other names should use the normal style.
    rationale:
        Because upper case is the usual macro style, an ordinary name
        written that way can be hijacked by a macro defined elsewhere.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        enum class Color { RED, GREEN, BLUE };   // RED may be a macro somewhere
        const int MAX_USERS = 100;
        \\\
        ```
    compliant:
        ```cpp
        \\\
        enum class Color { red, green, blue };
        const int max_users = 100;
        \\\
        ```
    languages: [cpp]
    tags: [naming, macros]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-not-caps
