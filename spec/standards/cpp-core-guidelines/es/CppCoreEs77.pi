use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs77:
    standard: @{CppCoreGuidelines}
    ruleId: ES.77
    title: Keep break and continue in loops rare
    statement:
        In loop bodies of any size, favour a clear loop condition, a helper
        function or an early return over break and continue.
    rationale:
        Such statements are easy to overlook inside a long body. A break
        also behaves very differently inside a loop than inside a switch,
        and nesting one in the other makes it easy to misread.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        for (auto& job : jobs) {
            if (job.done()) continue;
            if (job.failed()) {
                report(job);
                break;
            }
            job.run();
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        const auto failed = std::find_if(jobs.begin(), jobs.end(),
                                         [](const Job& j) { return j.failed(); });
        for (auto it = jobs.begin(); it != failed; ++it)
            if (!it->done()) it->run();
        if (failed != jobs.end()) report(*failed);
        \\\
        ```
    languages: [cpp]
    tags: [loops, control-flow]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-continue
