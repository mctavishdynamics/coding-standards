use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs21:
    standard: @{CppCoreGuidelines}
    ruleId: ES.21
    title: Declare variables close to their first use
    statement:
        Introduce each variable or constant right before the code that first
        needs it, rather than collecting declarations at the start of a
        function.
    rationale:
        A short distance between declaration and use is easier to read. It
        also keeps the variable out of the parts of the function that have
        no business touching it.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void handle(const Request& req) {
            std::string reply;
            validate(req);
            audit(req);
            reply = build_reply(req);
            send(reply);
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void handle(const Request& req) {
            validate(req);
            audit(req);
            const std::string reply = build_reply(req);
            send(reply);
        }
        \\\
        ```
    languages: [cpp]
    tags: [declarations, scope]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-introduce
