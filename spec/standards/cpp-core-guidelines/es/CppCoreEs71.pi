use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs71:
    standard: @{CppCoreGuidelines}
    ruleId: ES.71
    title: Iterate over a whole container with a range-based for
    statement:
        To visit every element of a range, write a range-based for loop
        rather than stepping an index or iterator yourself.
    rationale:
        There is less to read, no bounds to get wrong and sometimes faster
        code.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        for (std::size_t i = 0; i < users.size(); ++i)
            greet(users[i]);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        for (const auto& user : users)
            greet(user);
        \\\
        ```
    languages: [cpp]
    tags: [loops, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-for-range
