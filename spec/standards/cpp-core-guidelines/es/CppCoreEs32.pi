use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs32:
    standard: @{CppCoreGuidelines}
    ruleId: ES.32
    title: Spell every macro name in capitals
    statement:
        Write all macro names in upper case letters with underscores.
    rationale:
        By convention, upper case marks a name the preprocessor will
        replace. Readers can then spot macros at a glance and treat them
        with care.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        #define max_retries 5
        #define debug_log(msg) std::fprintf(stderr, "%s\n", msg)
        \\\
        ```
    compliant:
        ```cpp
        \\\
        #define MAX_RETRIES 5
        #define DEBUG_LOG(msg) std::fprintf(stderr, "%s\n", msg)
        \\\
        ```
    languages: [cpp]
    tags: [macros, naming]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-all_caps
