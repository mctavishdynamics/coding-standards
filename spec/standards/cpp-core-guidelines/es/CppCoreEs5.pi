use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs5:
    standard: @{CppCoreGuidelines}
    ruleId: ES.5
    title: Declare names in the narrowest scope that works
    statement:
        Declare every name in the tightest scope where it is still useful.
        Keep functions and blocks small, so scopes stay small too.
    rationale:
        A name visible over fewer lines is easier to follow and cannot be
        misused far from its intended purpose. Objects in small scopes are
        also destroyed sooner, freeing what they hold.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void report() {
            int i;
            std::string line;
            for (i = 0; i < count(); ++i) {
                line = format_row(i);
                print(line);
            }
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void report() {
            for (int i = 0; i < count(); ++i) {
                const std::string line = format_row(i);
                print(line);
            }
        }
        \\\
        ```
    languages: [cpp]
    tags: [scope, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-scope
