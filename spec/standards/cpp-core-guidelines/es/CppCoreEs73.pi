use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs73:
    standard: @{CppCoreGuidelines}
    ruleId: ES.73
    title: Use a while loop when there is no loop counter
    statement:
        If a loop has no natural counter and simply repeats until some
        condition is false, write it as a while loop.
    rationale:
        A for statement with blank sections, or with an unrelated counter in
        its header, hints at a loop variable that is not really there. A
        while loop says plainly what drives the repetition.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        for (; !queue.empty(); )
            dispatch(queue.pop());
        \\\
        ```
    compliant:
        ```cpp
        \\\
        while (!queue.empty())
            dispatch(queue.pop());
        \\\
        ```
    languages: [cpp]
    tags: [loops, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-while-for
