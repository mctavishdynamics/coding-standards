use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs24:
    standard: @{CppCoreGuidelines}
    ruleId: ES.24
    title: Hold owning pointers in unique_ptr
    statement:
        Store a newly allocated object in a std::unique_ptr, not in a raw
        pointer.
    rationale:
        This is the simplest defence against leaks, since the object is
        freed automatically. The type documents who owns the object and lets
        the compiler police it, and the run-time cost is zero or close to
        it.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void parse(std::istream& in) {
            Token* tok = new Token(read_token(in));
            if (!tok->valid()) throw ParseError{};   // leaks tok
            consume(*tok);
            delete tok;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void parse(std::istream& in) {
            auto tok = std::make_unique<Token>(read_token(in));
            if (!tok->valid()) throw ParseError{};
            consume(*tok);
        }
        \\\
        ```
    languages: [cpp]
    tags: [smart-pointers, ownership]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-unique
