use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs11:
    standard: @{CppCoreGuidelines}
    ruleId: ES.11
    title: Let auto stand in for a type already spelled out nearby
    statement:
        When the initializer already makes the type plain, declare the
        variable with auto instead of writing the type again.
    rationale:
        Writing a long type twice is tiresome and can introduce mismatches.
        With auto, the variable name always sits in the same spot, which
        makes declarations easier to scan.
    exceptions:
        Write the type explicitly when the initializer is a braced list, or
        when you need a particular type that differs from what the
        initializer would deduce.
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::map<std::string, std::vector<int>>::const_iterator it = index.find(word);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        auto it = index.find(word);
        \\\
        ```
    languages: [cpp]
    tags: [declarations, types]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-auto
