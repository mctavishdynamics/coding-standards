use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs25:
    standard: @{CppCoreGuidelines}
    ruleId: ES.25
    title: Make objects const or constexpr unless they must change
    statement:
        Declare a variable const, or constexpr if the value is known at
        compile time, unless later code has to modify it.
    rationale:
        Any accidental write then becomes a compile error. The compiler may
        also be able to optimize better.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        double tax_rate = 0.2;
        double gross = net * (1 + tax_rate);
        \\\
        ```
    compliant:
        ```cpp
        \\\
        constexpr double tax_rate = 0.2;
        const double gross = net * (1 + tax_rate);
        \\\
        ```
    languages: [cpp]
    tags: [const, immutability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-const
