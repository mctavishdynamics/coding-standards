use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs56:
    standard: @{CppCoreGuidelines}
    ruleId: ES.56
    title: Call std::move only to hand an object on to another scope
    statement:
        Write std::move only to pass an lvalue that you are finished with
        into another scope. Leave it off return statements, temporaries and
        const objects.
    rationale:
        Moving from an object usually leaves it empty, which surprises
        anyone who reads it later. Returns and temporaries already move on
        their own, and an explicit move there can even prevent copy elision.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::vector<int> make_ids() {
            std::vector<int> ids = load_ids();
            return std::move(ids);       // blocks copy elision
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::vector<int> make_ids() {
            std::vector<int> ids = load_ids();
            return ids;
        }

        void Registry::add(std::string name) { names_.push_back(std::move(name)); }
        \\\
        ```
    languages: [cpp]
    tags: [move-semantics, performance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-move
