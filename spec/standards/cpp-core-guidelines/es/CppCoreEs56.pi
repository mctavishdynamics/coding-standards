use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs56:
    standard: @{CppCoreGuidelines}
    ruleId: ES.56
    title:
        Write std::move only when you need to explicitly move an object to
        another scope
    statement:
        Use std::move only to hand an lvalue you no longer need to another
        scope. Do not write it on return values, temporaries or const
        objects.
    rationale:
        A move typically leaves an empty object behind, which is surprising
        if the variable is used later, and needless moves can block copy
        elision.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        std::vector<int> make_ids() {
            std::vector<int> ids = load_ids();
            return std::move(ids);       // blocks copy elision
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        std::vector<int> make_ids() {
            std::vector<int> ids = load_ids();
            return ids;
        }

        void Registry::add(std::string name) { names_.push_back(std::move(name)); }
        \\\
        ```
    languages: [cpp]
    tags: [move-semantics, performance]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-move
