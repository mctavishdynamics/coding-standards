use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs60:
    standard: @{CppCoreGuidelines}
    ruleId: ES.60
    title: Confine new and delete to resource management code
    statement:
        Application code should not call new or delete. Those calls belong
        in the implementation of classes that manage resources, such as
        containers and smart pointers.
    rationale:
        Doing resource management by hand everywhere is laborious. Any path
        that skips the delete leaks, so mistakes come easily.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void load_level() {
            Level* level = new Level("castle");
            play(*level);
            delete level;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void load_level() {
            auto level = std::make_unique<Level>("castle");
            play(*level);
        }
        \\\
        ```
    languages: [cpp]
    tags: [memory, allocation]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-new
