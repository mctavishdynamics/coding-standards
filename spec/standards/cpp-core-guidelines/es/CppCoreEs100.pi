use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs100:
    standard: @{CppCoreGuidelines}
    ruleId: ES.100
    title: Keep signed and unsigned values out of the same arithmetic
    statement:
        Avoid arithmetic and comparisons where one operand is signed and the
        other unsigned.
    rationale:
        C++ converts the signed side to unsigned before the operation. A
        negative number then becomes a very large positive one, and the
        result is quietly wrong.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        int offset = -1;
        unsigned size = 10;
        if (offset < size) use(offset);   // false: -1 becomes a huge unsigned
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int offset = -1;
        int size = 10;
        if (offset < size) use(offset);
        \\\
        ```
    languages: [cpp]
    tags: [arithmetic, types]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-mix
