use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs42:
    standard: @{CppCoreGuidelines}
    ruleId: ES.42
    title: Keep pointer manipulation plain and obvious
    statement:
        Use pointers in simple ways. Instead of pointer arithmetic and
        clever manipulation, use span, containers and accessors that check
        the range.
    rationale:
        Arithmetic on raw pointers is fragile. It is behind a great many
        buffer overruns and other memory safety flaws.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void scale(double* data, int n, double k) {
            for (double* p = data + n - 1; p >= data; --p)
                *p *= k;
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void scale(std::span<double> data, double k) {
            for (double& x : data)
                x *= k;
        }
        \\\
        ```
    languages: [cpp]
    tags: [pointers, bounds]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-ptr
