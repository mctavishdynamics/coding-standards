use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs27:
    standard: @{CppCoreGuidelines}
    ruleId: ES.27
    title: Use std::array or a stack array type for local fixed-size arrays
    statement:
        Stack arrays should be std::array when the length is a compile-time
        constant, or gsl::stack_array when the length is computed at run
        time. Avoid C arrays and variable-length arrays.
    rationale:
        These types are easy to read and never silently decay into pointers.
        They also cannot be mistaken for the non-standard variable-length
        array extension, which is a security risk.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        void sample(int n) {
            int fixed[16];
            double readings[n];    // non-standard VLA
        }
        \\\
        ```
    compliant:
        ```cpp
        \\\
        void sample(int n) {
            std::array<int, 16> fixed{};
            gsl::stack_array<double> readings(n);
        }
        \\\
        ```
    languages: [cpp]
    tags: [arrays, containers]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-stack
