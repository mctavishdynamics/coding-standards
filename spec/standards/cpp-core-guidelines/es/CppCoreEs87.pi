use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs87:
    standard: @{CppCoreGuidelines}
    ruleId: ES.87
    title: Write conditions without needless comparisons to true or zero
    statement:
        In a condition, test a pointer or a bool as it is. Do not compare it
        against nullptr, true or false.
    rationale:
        The extra comparison is just noise and gives one more place to make
        a typo. The plain form is also the conventional style.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        if (session != nullptr && session->active() == true) refresh();
        \\\
        ```
    compliant:
        ```cpp
        \\\
        if (session && session->active()) refresh();
        \\\
        ```
    languages: [cpp]
    tags: [expressions, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-if
