use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs45:
    standard: @{CppCoreGuidelines}
    ruleId: ES.45
    title: Name literal values instead of scattering them through code
    statement:
        Give a literal number a name with a constexpr constant before using
        it in logic, or avoid the bare number altogether by iterating over
        the range or calling an algorithm.
    rationale:
        A bare number in the middle of an expression tells the reader
        nothing about what it means. It is easy to miss, and when it changes
        every copy has to be found and edited.
    exceptions: null
    severity: null
    noncompliant:
        ```cpp
        \\\
        if (elapsed > 86400) expire_session();
        \\\
        ```
    compliant:
        ```cpp
        \\\
        constexpr int seconds_per_day = 24 * 60 * 60;
        if (elapsed > seconds_per_day) expire_session();
        \\\
        ```
    languages: [cpp]
    tags: [constants, readability]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-magic
