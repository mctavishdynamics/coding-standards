use ../../lib/CodingRule

from ../CppCoreGuidelines import CppCoreGuidelines

export coding-rule CppCoreEs23:
    standard: @{CppCoreGuidelines}
    ruleId: ES.23
    title: Use brace initialization by default
    statement:
        Make braces the default way to initialize. Fall back to the equals
        sign only where narrowing cannot occur, and for built-in arithmetic
        types only together with auto. Avoid initializing with parentheses,
        since the parser can misread them.
    rationale:
        The brace form follows fewer and more uniform rules. It rejects
        narrowing conversions and cannot be mistaken for a function
        declaration.
    exceptions:
        Containers are a known exception. By convention braces give the
        element list and parentheses give a size, so write parentheses when
        you mean an element count.
    severity: null
    noncompliant:
        ```cpp
        \\\
        int ratio(2.7);        // silently truncated to 2
        Timer t();             // declares a function, not a Timer
        \\\
        ```
    compliant:
        ```cpp
        \\\
        int ratio{2};          // int ratio{2.7} would not compile
        Timer t{};
        \\\
        ```
    languages: [cpp]
    tags: [initialization, conversions]
    source: https://isocpp.github.io/CppCoreGuidelines/CppCoreGuidelines#res-list
