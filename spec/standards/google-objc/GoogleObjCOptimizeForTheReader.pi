use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCOptimizeForTheReader:
    standard: @{GoogleObjC}
    ruleId: optimize-for-the-reader-not-the-writer
    title: Optimize code for the reader rather than the writer
    statement:
        Write code so that the average engineer can easily read, maintain
        and debug it, even when that makes it slower to write. When
        something unusual happens in the code, leave a hint for the reader.
    rationale:
        Code lives for a long time and is read far more often than it is
        written.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [objective-c]
    tags: [readability, principles]
    source: https://google.github.io/styleguide/objcguide.html#optimize-for-the-reader-not-the-writer
