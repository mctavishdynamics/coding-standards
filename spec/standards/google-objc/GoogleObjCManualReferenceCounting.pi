use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCManualReferenceCounting:
    standard: @{GoogleObjC}
    ruleId: manual-reference-counting
    title: Mark non-retained and non-Objective-C pointers
    statement:
        Instance variables holding NSObject types are assumed to be
        retained. Flag any that are not as weak, by comment or by the __weak
        qualifier. Pointer ivars to Core Foundation, C++ or other
        non-Objective-C types always need a comment saying whether they are
        strong or weak.
    rationale:
        Non-Objective-C pointers need manual memory management even under
        ARC, so readers must know which pointers own their objects.
    exceptions:
        On the Mac, ivars marked as IBOutlet are presumed not to be
        retained.
    severity: null
    noncompliant:
        ```objectivec
        \\\
        @implementation ABCPlayerController {
          ABCPlayerView *_owner;
          CGImageRef _artwork;
        }
        @end
        \\\
        ```
    compliant:
        ```objectivec
        \\\
        @implementation ABCPlayerController {
          __weak ABCPlayerView *_owner;  // Owns this controller.
          CGImageRef _artwork;           // Strong; released in -dealloc.
        }
        @end
        \\\
        ```
    languages: [objective-c]
    tags: [memory, ownership]
    source: https://google.github.io/styleguide/objcguide.html#manual-reference-counting
