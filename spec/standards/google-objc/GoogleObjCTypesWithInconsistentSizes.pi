use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCTypesWithInconsistentSizes:
    standard: @{GoogleObjC}
    ruleId: types-with-inconsistent-sizes
    title: Use exact-width types where exact sizes matter
    statement:
        Use long, NSInteger, NSUInteger and CGFloat only to match system
        interfaces. Use exact-width types for APIs that require a specific
        size, such as protos, and int64_t for file and buffer sizes.
    rationale:
        These types differ in size between 32-bit and 64-bit builds, and
        file sizes often exceed 32 bits.
    exceptions: null
    severity: null
    noncompliant:
        ```objectivec
        \\\
        NSInteger fileSize = record.byteCount;
        long userIdentifier = proto.userId;
        \\\
        ```
    compliant:
        ```objectivec
        \\\
        int64_t fileSize = record.byteCount;
        int64_t userIdentifier = proto.userId;
        \\\
        ```
    languages: [objective-c]
    tags: [types, portability]
    source: https://google.github.io/styleguide/objcguide.html#types-with-inconsistent-sizes
