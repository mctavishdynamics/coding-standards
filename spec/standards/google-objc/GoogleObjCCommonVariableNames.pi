use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCCommonVariableNames:
    standard: @{GoogleObjC}
    ruleId: common-variable-names
    title: Do not use Hungarian notation
    statement:
        Let readers infer what a variable holds from its name, but do not
        encode syntactic details such as the static type in the name.
        Globals and file scope variables should be rare and use the g
        prefix.
    rationale:
        Type prefixes add noise and go stale when the type changes.
    exceptions: null
    severity: null
    noncompliant:
        ```objectivec
        \\\
        int iCount;
        NSString *pstrTitle;
        \\\
        ```
    compliant:
        ```objectivec
        \\\
        int visitorCount;
        NSString *title;
        \\\
        ```
    languages: [objective-c]
    tags: [naming, variables]
    source: https://google.github.io/styleguide/objcguide.html#common-variable-names
