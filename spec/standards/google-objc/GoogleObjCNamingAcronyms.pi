use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCNamingAcronyms:
    standard: @{GoogleObjC}
    ruleId: naming-acronyms
    title: Write acronyms in names in all capitals
    statement:
        Keep acronyms and initialisms like URL, ID and PDF fully capitalized
        wherever they appear in a name, at the start as well, for classes,
        categories, methods, functions and variables alike. Typedefs and C
        functions begin with a capital and use camel case to fit nearby
        code.
    rationale:
        This matches Apple's own convention for names that contain acronyms.
    exceptions: null
    severity: null
    noncompliant:
        ```objectivec
        \\\
        NSURL *imageUrl;
        NSString *userId;
        - (void)loadPdfFromUrl:(NSURL *)url;
        \\\
        ```
    compliant:
        ```objectivec
        \\\
        NSURL *imageURL;
        NSString *userID;
        - (void)loadPDFFromURL:(NSURL *)URL;
        \\\
        ```
    languages: [objective-c]
    tags: [naming, acronyms]
    source: https://google.github.io/styleguide/objcguide.html#naming
