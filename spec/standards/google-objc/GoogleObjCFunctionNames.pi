use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCFunctionNames:
    standard: @{GoogleObjC}
    ruleId: function-names
    title: Name functions in Pascal case with a prefix if non-static
    statement:
        Start function names with a capital letter and capitalize each new
        word. Give non-static functions a project prefix to avoid name
        collisions.
    rationale:
        Objective-C has no namespaces, so exported functions need a prefix
        to stay unique.
    exceptions: null
    severity: null
    noncompliant:
        ```objectivec
        \\\
        static void add_row(NSString *row);
        extern NSString *formattedDate(NSDate *date);
        \\\
        ```
    compliant:
        ```objectivec
        \\\
        static void AddRow(NSString *row);
        extern NSString *ABCFormattedDate(NSDate *date);
        \\\
        ```
    languages: [objective-c]
    tags: [naming, functions]
    source: https://google.github.io/styleguide/objcguide.html#function-names
