use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCComments:
    standard: @{GoogleObjC}
    ruleId: comments
    title: Write comments as readable, well-punctuated prose
    statement:
        Write comments with correct spelling, grammar, capitalization and
        punctuation, preferring complete sentences. Short end-of-line
        comments may be less formal but should keep a consistent style.
        Prefer clear names over comments that explain obscure ones.
    rationale:
        Well-written comments are easier to read, and self-documenting code
        needs fewer of them.
    exceptions: null
    severity: null
    noncompliant:
        ```objectivec
        \\\
        // calc tot w tax
        double t = s * 1.2;
        \\\
        ```
    compliant:
        ```objectivec
        \\\
        // Adds the 20% sales tax to the subtotal.
        double totalWithTax = subtotal * 1.2;
        \\\
        ```
    languages: [objective-c]
    tags: [comments, documentation]
    source: https://google.github.io/styleguide/objcguide.html#comments
