use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCVerticalWhitespace:
    standard: @{GoogleObjC}
    ruleId: vertical-whitespace
    title: Use blank lines sparingly
    statement:
        Avoid blank lines right after an opening or before a closing
        function brace. Between functions or between logical sections, one
        or two blank lines at most.
    rationale:
        More code fits on screen when blank lines are scarce.
    exceptions: null
    severity: null
    noncompliant:
        ```objectivec
        \\\
        - (void)reload {

          [self.tableView reloadData];

        }
        \\\
        ```
    compliant:
        ```objectivec
        \\\
        - (void)reload {
          [self.tableView reloadData];
        }
        \\\
        ```
    languages: [objective-c]
    tags: [formatting, whitespace]
    source: https://google.github.io/styleguide/objcguide.html#vertical-whitespace
