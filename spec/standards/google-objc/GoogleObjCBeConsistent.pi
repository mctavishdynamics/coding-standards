use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCBeConsistent:
    standard: @{GoogleObjC}
    ruleId: be-consistent
    title: Pick one option and use it consistently
    statement:
        Where the guide allows more than one style, choose one and use it
        throughout the codebase instead of mixing styles.
    rationale:
        Consistent code lets engineers focus on more important issues and
        makes formatting and refactoring tools work better.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [objective-c]
    tags: [consistency, principles]
    source: https://google.github.io/styleguide/objcguide.html#be-consistent
