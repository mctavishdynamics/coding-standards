use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCPrefixes:
    standard: @{GoogleObjC}
    ruleId: prefixes
    title: Prefix global names with three or more capital letters
    statement:
        Give global constants, global functions, protocols and classes a
        prefix that starts with a capital letter and continues with capitals
        or digits. Make it three characters or longer, since Apple keeps
        two-letter prefixes for itself.
    rationale:
        Objective-C has a single global namespace, so prefixes prevent name
        collisions.
    exceptions: null
    severity: null
    noncompliant:
        ```objectivec
        \\\
        extern NSString *const ErrorDomain;
        @interface Uploader : NSObject
        @end
        \\\
        ```
    compliant:
        ```objectivec
        \\\
        extern NSString *const ABCUploadErrorDomain;
        @interface ABCUploader : NSObject
        @end
        \\\
        ```
    languages: [objective-c]
    tags: [naming, prefixes]
    source: https://google.github.io/styleguide/objcguide.html#prefixes
