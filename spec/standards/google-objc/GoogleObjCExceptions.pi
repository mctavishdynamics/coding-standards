use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCExceptions:
    standard: @{GoogleObjC}
    ruleId: exceptions
    title: Put @catch and @finally on the closing brace line
    statement:
        Start @catch and @finally right after the brace that closes the
        previous block, leaving a space after @catch and a space before
        every opening brace.
    rationale:
        It matches the layout of if and else blocks.
    exceptions: null
    severity: null
    noncompliant:
        ```objectivec
        \\\
        @try {
          [parser parse];
        }
        @catch(NSException *e) {
          [self log:e];
        }
        \\\
        ```
    compliant:
        ```objectivec
        \\\
        @try {
          [parser parse];
        } @catch (NSException *e) {
          [self log:e];
        }
        \\\
        ```
    languages: [objective-c]
    tags: [formatting, exceptions]
    source: https://google.github.io/styleguide/objcguide.html#exceptions
