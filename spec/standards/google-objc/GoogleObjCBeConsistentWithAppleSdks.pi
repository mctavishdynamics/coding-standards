use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCBeConsistentWithAppleSdks:
    standard: @{GoogleObjC}
    ruleId: be-consistent-with-apple-sdks
    title: Match the Objective-C conventions of Apple's frameworks
    statement:
        Use Objective-C the way Apple's SDKs use it. When a language feature
        solves the problem, that argues for using it, but flawed features or
        idioms may be restricted or banned.
    rationale:
        Consistency with the platform has the same value as consistency
        inside the codebase.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [objective-c]
    tags: [consistency, principles]
    source: https://google.github.io/styleguide/objcguide.html#be-consistent-with-apple-sdks
