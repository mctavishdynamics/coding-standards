use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCExpressions:
    standard: @{GoogleObjC}
    ruleId: expressions
    title: Space binary operators but not unary ones
    statement:
        Put spaces around binary operators and assignments, no space after a
        unary operator, and no spaces inside parentheses. Factors may omit
        spaces to show grouping.
    rationale:
        Consistent spacing makes the structure of an expression clear.
    exceptions: null
    severity: null
    noncompliant:
        ```objectivec
        \\\
        area=width*height+ margin;
        delta = - ( start-end );
        \\\
        ```
    compliant:
        ```objectivec
        \\\
        area = width * height + margin;
        delta = -(start - end);
        \\\
        ```
    languages: [objective-c]
    tags: [formatting, whitespace]
    source: https://google.github.io/styleguide/objcguide.html#expressions
