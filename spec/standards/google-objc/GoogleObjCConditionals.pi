use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCConditionals:
    standard: @{GoogleObjC}
    ruleId: conditionals
    title: Format conditionals with spaces and braces
    statement:
        The keywords if, for, while and switch take a space before their
        parenthesis, and comparison operators take a space on each side. An
        unbraced body is allowed only on the condition's own line. When
        there is an else, brace both branches and write else after the first
        branch's closing brace. Comment any intentional fall-through between
        cases, unless the case labels are simply stacked.
    rationale:
        A body on its own line without braces invites bugs when lines are
        added.
    exceptions: null
    severity: null
    noncompliant:
        ```objectivec
        \\\
        if(isReady)
          [self start];
        else [self wait];
        \\\
        ```
    compliant:
        ```objectivec
        \\\
        if (isReady) {
          [self start];
        } else {
          [self wait];
        }
        \\\
        ```
    languages: [objective-c]
    tags: [formatting, control-flow]
    source: https://google.github.io/styleguide/objcguide.html#conditionals
