use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCFileComments:
    standard: @{GoogleObjC}
    ruleId: file-comments
    title: Start a file with license and description only as needed
    statement:
        Open a file with the license text where one is required, then a brief
        note on what the file contains. If a file carries an author line and you
        rework it substantially, think about removing that line.
    rationale:
        Revision history records authorship more accurately than an author
        line.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [objective-c]
    tags: [comments, files]
    source: https://google.github.io/styleguide/objcguide.html#file-comments
