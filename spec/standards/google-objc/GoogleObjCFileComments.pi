use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCFileComments:
    standard: @{GoogleObjC}
    ruleId: file-comments
    title: Start a file with license and description only as needed
    statement:
        A file may start with the license boilerplate, if needed, followed
        by a short description of its contents. When you make significant
        changes to a file with an author line, consider deleting the author
        line.
    rationale:
        Revision history records authorship more accurately than an author
        line.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [objective-c]
    tags: [comments, files]
    source: https://google.github.io/styleguide/objcguide.html#file-comments
