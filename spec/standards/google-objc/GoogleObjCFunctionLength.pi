use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCFunctionLength:
    standard: @{GoogleObjC}
    ruleId: function-length
    title: Prefer small and focused functions
    statement:
        Keep functions and methods short and focused. When one grows past
        about 40 lines, consider splitting it without harming the program
        structure.
    rationale:
        Short functions are easier to read and modify, and long ones attract
        hard-to-find bugs as behaviour is added.
    exceptions:
        There is no hard limit; long functions are sometimes appropriate.
    severity: null
    noncompliant: null
    compliant: null
    languages: [objective-c]
    tags: [functions, maintainability]
    source: https://google.github.io/styleguide/objcguide.html#function-length
