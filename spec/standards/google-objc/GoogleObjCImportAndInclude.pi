use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCImportAndInclude:
    standard: @{GoogleObjC}
    ruleId: import-and-include
    title: Import Objective-C headers and include C headers
    statement:
        Bring in Objective-C or Objective-C++ headers with #import, and C or
        C++ headers with #include. The latter are expected to carry their
        own include guards.
    rationale:
        Importing a C or C++ header blocks later includes of it and can
        cause unexpected compilation behaviour.
    exceptions: null
    severity: null
    noncompliant:
        ```objectivec
        \\\
        #include "ABCSession.h"
        #import <vector>
        \\\
        ```
    compliant:
        ```objectivec
        \\\
        #import "ABCSession.h"
        #include <vector>
        \\\
        ```
    languages: [objective-c]
    tags: [headers, preprocessor]
    source: https://google.github.io/styleguide/objcguide.html#import-and-include
