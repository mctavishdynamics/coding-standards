use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCAvoidThrowingExceptions:
    standard: @{GoogleObjC}
    ruleId: avoid-throwing-exceptions
    title: Do not throw Objective-C exceptions
    statement:
        Do not @throw exceptions; deliver errors with NSError objects. Be
        ready to catch exceptions from third-party or OS code, and document
        which calls you expect to throw.
    rationale:
        Apple recommends error objects for error delivery, and Cocoa code is
        not written to be exception safe.
    exceptions:
        @try, @catch and @finally are allowed where third-party code
        requires them.
    severity: null
    noncompliant:
        ```objectivec
        \\\
        - (NSData *)loadFile:(NSString *)path {
          if (!path) {
            @throw [NSException exceptionWithName:@"BadPath" reason:nil userInfo:nil];
          }
          return [NSData dataWithContentsOfFile:path];
        }
        \\\
        ```
    compliant:
        ```objectivec
        \\\
        - (nullable NSData *)loadFile:(NSString *)path error:(NSError **)error {
          return [NSData dataWithContentsOfFile:path options:0 error:error];
        }
        \\\
        ```
    languages: [objective-c]
    tags: [error-handling, exceptions]
    source: https://google.github.io/styleguide/objcguide.html#avoid-throwing-exceptions
