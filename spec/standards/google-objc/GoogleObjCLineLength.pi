use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCLineLength:
    standard: @{GoogleObjC}
    ruleId: line-length
    title: Limit lines to 100 columns
    statement:
        Keep lines in Objective-C files to at most 100 columns.
    rationale:
        A fixed limit keeps code readable without horizontal scrolling.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [objective-c]
    tags: [formatting, line-length]
    source: https://google.github.io/styleguide/objcguide.html#line-length
