use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCStaticVariables:
    standard: @{GoogleObjC}
    ruleId: static-variables
    title: Declare file-private file scope variables static
    statement:
        Declare file scope variables and constants in an implementation file
        static when nothing outside the file uses them. Never declare static
        file scope variables or constants in a header.
    rationale:
        A static in a header creates a separate copy in every file that
        imports it.
    exceptions: null
    severity: null
    noncompliant:
        ```objectivec
        \\\
        // file: ABCCache.h
        static const NSUInteger ABCCacheLimit = 50;
        \\\
        ```
    compliant:
        ```objectivec
        \\\
        // file: ABCCache.m
        static const NSUInteger ABCCacheLimit = 50;
        \\\
        ```
    languages: [objective-c]
    tags: [declarations, linkage]
    source: https://google.github.io/styleguide/objcguide.html#static-variables
