use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCBoolLiterals:
    standard: @{GoogleObjC}
    ruleId: bool-literals
    title: Use @YES and @NO instead of boxed BOOL expressions
    statement:
        Write BOOL NSNumber literals as @YES and @NO. Do not use boxed
        expressions, even @(YES), and convert integer values with a
        conditional operator outside the box.
    rationale:
        Boxing an integral value can produce true or false NSNumbers that do
        not equal @YES or @NO.
    exceptions: null
    severity: null
    noncompliant:
        ```objectivec
        \\\
        settings[@"enabled"] = @(YES);
        NSNumber *hasItems = @(cart.items.count);
        \\\
        ```
    compliant:
        ```objectivec
        \\\
        settings[@"enabled"] = @YES;
        NSNumber *hasItems = cart.items.count ? @YES : @NO;
        \\\
        ```
    languages: [objective-c]
    tags: [types, booleans, literals]
    source: https://google.github.io/styleguide/objcguide.html#bool-literals
