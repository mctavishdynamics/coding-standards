use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCCategoryNaming:
    standard: @{GoogleObjC}
    ruleId: category-naming
    title: Prefix category names and category methods
    statement:
        Prefix every category name for your project, and name the file as
        the extended class, a plus sign, then the category. Category methods
        start with the prefix in lowercase followed by an underscore.
        Separate the class name from the parenthesised category with one
        space.
    rationale:
        Category methods share the global method namespace with the class
        and every other category, so prefixes prevent silent collisions.
    exceptions:
        A category on a class used only within your own project can drop
        both the category prefix and the method prefix.
    severity: null
    noncompliant:
        ```objectivec
        \\\
        // NSString+Trim.h
        @interface NSString(Trim)
        - (NSString *)trimmed;
        @end
        \\\
        ```
    compliant:
        ```objectivec
        \\\
        // NSString+ABCTrimming.h
        @interface NSString (ABCTrimming)
        - (NSString *)abc_stringByTrimmingWhitespace;
        @end
        \\\
        ```
    languages: [objective-c]
    tags: [naming, categories]
    source: https://google.github.io/styleguide/objcguide.html#category-naming
