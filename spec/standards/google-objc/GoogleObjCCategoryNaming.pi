use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCCategoryNaming:
    standard: @{GoogleObjC}
    ruleId: category-naming
    title: Prefix category names and category methods
    statement:
        Give a category name a project prefix, and name its file after the
        extended class, a plus sign and the category name. Prefix each
        category method with the lowercase prefix and an underscore. Put one
        space between the class name and the opening parenthesis.
    rationale:
        Category methods share the global method namespace with the class
        and every other category, so prefixes prevent silent collisions.
    exceptions:
        Categories on a class that is not shared with other projects may
        omit the category and method prefixes.
    severity: null
    noncompliant:
        ```objectivec
        \\\
        // NSString+Trim.h
        @interface NSString(Trim)
        - (NSString *)trimmed;
        @end
        \\\
        ```
    compliant:
        ```objectivec
        \\\
        // NSString+ABCTrimming.h
        @interface NSString (ABCTrimming)
        - (NSString *)abc_stringByTrimmingWhitespace;
        @end
        \\\
        ```
    languages: [objective-c]
    tags: [naming, categories]
    source: https://google.github.io/styleguide/objcguide.html#category-naming
