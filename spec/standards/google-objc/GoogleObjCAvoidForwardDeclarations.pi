use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCAvoidForwardDeclarations:
    standard: @{GoogleObjC}
    ruleId: avoid-forward-declarations
    title: Avoid forward declarations
    statement:
        Rather than declaring a type ahead with @class or @protocol, import the
        header that defines it. The one reason to declare ahead is when two
        types in one module refer to each other and an import cycle would
        result.
    rationale:
        Forward declarations cause problems when headers are imported into
        Swift and can hide errors when a type is renamed.
    exceptions:
        A forward declaration is fine to break a circular dependency inside
        one module.
    severity: null
    noncompliant:
        ```objectivec
        \\\
        @class ABCInvoice;

        void ABCPrintInvoice(ABCInvoice *invoice);
        \\\
        ```
    compliant:
        ```objectivec
        \\\
        #import "Billing/ABCInvoice.h"

        void ABCPrintInvoice(ABCInvoice *invoice);
        \\\
        ```
    languages: [objective-c]
    tags: [declarations, headers]
    source: https://google.github.io/styleguide/objcguide.html#avoid-forward-declarations
