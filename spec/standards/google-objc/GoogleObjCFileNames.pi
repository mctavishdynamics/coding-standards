use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCFileNames:
    standard: @{GoogleObjC}
    ruleId: file-names
    title: Name files after the class they implement
    statement:
        Name a file after the class inside it, matching case. The extensions
        are .h for headers, .m for Objective-C, .mm for Objective-C++, .cc
        for C++ and .c for C. Files shared across projects need a
        distinctive prefixed name, and a category file names the class it
        extends.
    rationale:
        Predictable names make files easy to find and avoid collisions
        between projects.
    exceptions:
        Follow the existing convention of the project you are working in.
    severity: null
    noncompliant:
        ```objectivec
        \\\
        // Contains @implementation GTMRequestQueue
        requestqueue.m
        // Category on NSDate
        DateHelpers.h
        \\\
        ```
    compliant:
        ```objectivec
        \\\
        // Contains @implementation GTMRequestQueue
        GTMRequestQueue.m
        // Category on NSDate
        NSDate+GTMFormatting.h
        \\\
        ```
    languages: [objective-c]
    tags: [naming, files]
    source: https://google.github.io/styleguide/objcguide.html#file-names
