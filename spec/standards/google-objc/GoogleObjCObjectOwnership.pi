use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCObjectOwnership:
    standard: @{GoogleObjC}
    ruleId: object-ownership
    title: Make pointer ownership explicit outside ARC
    statement:
        Outside ARC, spell out how each pointer owns its object whenever
        that ownership departs from the usual Objective-C conventions.
    rationale:
        Ownership that is not managed automatically must be understood by
        readers to avoid leaks and dangling pointers.
    exceptions:
        Under ARC, ownership of automatically retained objects is already
        explicit, so no extra comments are needed for them.
    severity: null
    noncompliant: null
    compliant: null
    languages: [objective-c]
    tags: [memory, ownership]
    source: https://google.github.io/styleguide/objcguide.html#object-ownership
