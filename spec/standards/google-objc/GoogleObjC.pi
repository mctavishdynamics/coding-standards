export coding-standard GoogleObjC:
    title: Google Objective-C Style Guide
    publisher: Google
    url: https://google.github.io/styleguide/objcguide.html
    version: null
    license: Creative Commons Attribution 3.0 Unported (CC BY 3.0)
    description:
        Google's style rules for Objective-C and Objective-C++ code,
        covering naming, declarations, comments, Cocoa idioms and
        formatting. It supplements Apple's Cocoa Coding Guidelines.
    rules:
        - @{GoogleObjCOptimizeForTheReader}
        - @{GoogleObjCBeConsistent}
        - @{GoogleObjCBeConsistentWithAppleSdks}
        - @{GoogleObjCNaming}
        - @{GoogleObjCNamingAcronyms}
        - @{GoogleObjCInclusiveLanguage}
        - @{GoogleObjCFileNames}
        - @{GoogleObjCPrefixes}
        - @{GoogleObjCClassNames}
        - @{GoogleObjCCategoryNaming}
        - @{GoogleObjCMethodNames}
        - @{GoogleObjCBooleanAccessorsAndDotNotation}
        - @{GoogleObjCFunctionNames}
        - @{GoogleObjCVariableNames}
        - @{GoogleObjCCommonVariableNames}
        - @{GoogleObjCInstanceVariables}
        - @{GoogleObjCConstants}
        - @{GoogleObjCAvoidForwardDeclarations}
        - @{GoogleObjCMethodDeclarations}
        - @{GoogleObjCLocalVariables}
        - @{GoogleObjCStaticVariables}
        - @{GoogleObjCUnsignedIntegers}
        - @{GoogleObjCTypesWithInconsistentSizes}
        - @{GoogleObjCFloatingPointConstants}
        - @{GoogleObjCComments}
        - @{GoogleObjCFileComments}
        - @{GoogleObjCDeclarationComments}
        - @{GoogleObjCImplementationComments}
        - @{GoogleObjCDisambiguatingSymbols}
        - @{GoogleObjCObjectOwnership}
        - @{GoogleObjCManualReferenceCounting}
        - @{GoogleObjCMacros}
        - @{GoogleObjCNullptrVsNull}
        - @{GoogleObjCNonstandardExtensions}
        - @{GoogleObjCTypeofKeyword}
        - @{GoogleObjCAutoTypeKeyword}
        - @{GoogleObjCIdentifyDesignatedInitializers}
        - @{GoogleObjCOverrideDesignatedInitializers}
        - @{GoogleObjCOverriddenNSObjectMethodPlacement}
        - @{GoogleObjCInitialization}
        - @{GoogleObjCInstanceVariablesInHeaders}
        - @{GoogleObjCDoNotUseNew}
        - @{GoogleObjCKeepThePublicAPISimple}
        - @{GoogleObjCImportAndInclude}
        - @{GoogleObjCOrderOfIncludes}
        - @{GoogleObjCUseUmbrellaHeaders}
        - @{GoogleObjCAvoidMessagingSelfInInitAndDealloc}
        - @{GoogleObjCAvoidRedundantPropertyAccess}
        - @{GoogleObjCMutablesCopiesAndOwnership}
        - @{GoogleObjCCopyPotentiallyMutableObjects}
        - @{GoogleObjCUseLightweightGenerics}
        - @{GoogleObjCAvoidThrowingExceptions}
        - @{GoogleObjCNilChecks}
        - @{GoogleObjCNullability}
        - @{GoogleObjCBoolExpressionsAndConversions}
        - @{GoogleObjCBoolLiterals}
        - @{GoogleObjCContainersWithoutInstanceVariables}
        - @{GoogleObjCDelegatePattern}
        - @{GoogleObjCStyleMatchesTheLanguage}
        - @{GoogleObjCSpacesVsTabs}
        - @{GoogleObjCLineLength}
        - @{GoogleObjCMethodDeclarationsAndDefinitions}
        - @{GoogleObjCFunctionDeclarationsAndDefinitions}
        - @{GoogleObjCConditionals}
        - @{GoogleObjCExpressions}
        - @{GoogleObjCMethodInvocations}
        - @{GoogleObjCFunctionCalls}
        - @{GoogleObjCExceptions}
        - @{GoogleObjCFunctionLength}
        - @{GoogleObjCVerticalWhitespace}
        - @{GoogleObjCIndicatingStyleExceptions}
