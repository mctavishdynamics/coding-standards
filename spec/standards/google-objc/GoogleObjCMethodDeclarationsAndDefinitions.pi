use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCMethodDeclarationsAndDefinitions:
    standard: @{GoogleObjC}
    ruleId: method-declarations-and-definitions
    title: Format method declarations with aligned colons
    statement:
        Leave exactly one space after the minus or plus and before the
        return type, and no other spaces except between parameters. A
        declaration too long for one line gets one parameter per line,
        colons lined up, with following lines indented by four spaces or
        more.
    rationale:
        Aligned colons make long selectors easy to scan.
    exceptions: null
    severity: null
    noncompliant:
        ```objectivec
        \\\
        -(void) scheduleReminder: (NSString *)text
            at: (NSDate *)date repeats: (BOOL)repeats;
        \\\
        ```
    compliant:
        ```objectivec
        \\\
        - (void)scheduleReminder:(NSString *)text
                              at:(NSDate *)date
                         repeats:(BOOL)repeats;
        \\\
        ```
    languages: [objective-c]
    tags: [formatting, methods]
    source: https://google.github.io/styleguide/objcguide.html#method-declarations-and-definitions
