use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCMacros:
    standard: @{GoogleObjC}
    ruleId: macros
    title: Avoid macros
    statement:
        Reach for C functions, enums, const values or Xcode snippets before
        macros. A macro that is truly needed gets a unique SHOUTY_SNAKE_CASE
        or function-like name and is undefined after use when practical.
        Macros must not imitate keywords, expand to unbalanced code, open a
        scope, or produce public API, method bodies or variables visible
        beyond the macro.
    rationale:
        Macros make the code you read differ from the code the compiler sees
        and hide where things are declared.
    exceptions:
        Macros for assertions or debug logs that compile in or out depending
        on build settings are fine.
    severity: null
    noncompliant:
        ```objectivec
        \\\
        #define kMaxRetries 3
        #define until(X) while (!(X))
        \\\
        ```
    compliant:
        ```objectivec
        \\\
        static const int kMaxRetries = 3;
        #define ABC_ASSERT_MAIN_THREAD() NSAssert(NSThread.isMainThread, @"Not on main")
        \\\
        ```
    languages: [objective-c]
    tags: [macros, preprocessor]
    source: https://google.github.io/styleguide/objcguide.html#macros
