use ../lib/CodingRule

from ./GoogleObjC import GoogleObjC

export coding-rule GoogleObjCMethodNames:
    standard: @{GoogleObjC}
    ruleId: objective-c-method-names
    title: Name methods so calls read like a sentence
    statement:
        Method and parameter names begin lowercase and continue in mixed
        case, with acronyms capitalized correctly. Pick parameter names so
        that the full selector reads naturally, and add joining words such
        as with, from or to only when they make the meaning clearer. A
        getter carries the attribute's name with no get prefix.
    rationale:
        Readable method names make calling code read almost like prose and
        make many comments unnecessary.
    exceptions: null
    severity: null
    noncompliant:
        ```objectivec
        \\\
        - (CGFloat)getWidth;
        - (CGFloat)calculateHeight;
        - (void)addObserver:(id)observer withSelector:(SEL)selector;
        \\\
        ```
    compliant:
        ```objectivec
        \\\
        - (CGFloat)width;
        - (CGFloat)height;
        - (void)addObserver:(id)observer selector:(SEL)selector;
        \\\
        ```
    languages: [objective-c]
    tags: [naming, methods]
    source: https://google.github.io/styleguide/objcguide.html#objective-c-method-names
