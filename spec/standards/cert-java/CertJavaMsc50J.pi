use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaMsc50J:
    standard: @{CertJava}
    ruleId: MSC50-J
    title: Minimize the scope of the @SuppressWarnings annotation
    statement:
        Apply SuppressWarnings to the smallest element possible, such as a
        single local variable declaration, and only when the code is known
        to be type safe.
    rationale:
        Suppressing warnings on a whole method or class hides unrelated
        unchecked warnings, which can lead to runtime exceptions and lost
        type safety.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        @SuppressWarnings("unchecked")
        List<String> load(Object raw) {
            List<String> names = (List<String>) raw;
            Set ids = new HashSet();
            return names;
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        List<String> load(Object raw) {
            @SuppressWarnings("unchecked")
            List<String> names = (List<String>) raw;
            return names;
        }
        \\\
        ```
    languages: [java]
    tags: [recommendation, annotations, generics, type-safety]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/recommendations/miscellaneous-msc/msc50-j/
