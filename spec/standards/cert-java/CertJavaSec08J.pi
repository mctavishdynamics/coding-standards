use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaSec08J:
    standard: @{CertJava}
    ruleId: SEC08-J
    title: Trusted code must discard or clean any arguments provided by untrusted code
    statement:
        Trusted code must not keep or act on arguments from untrusted code
        as given. Discard them or clean them before use.
    rationale:
        Arguments from untrusted code may be crafted to misuse the trusted
        code's privileges. The source marks this proposed rule as under
        construction and incomplete.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [java]
    tags: [security, untrusted-code, input-validation]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/platform-security-sec/sec08-j/
