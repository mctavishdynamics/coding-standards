use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaMet02J:
    standard: @{CertJava}
    ruleId: MET02-J
    title: Do not use deprecated or obsolete classes or methods
    statement:
        Do not use deprecated fields, methods or classes, or those
        documented as obsolete, in new code. Use their documented
        replacements, such as java.time instead of java.util.Date.
    rationale:
        Deprecated and obsolete APIs are often unsafe or broken, and using
        them can lead to erroneous behavior. CERT rates likelihood unlikely,
        detectable yes, repairable no, priority P2, level L3.
    exceptions: null
    severity: low
    noncompliant:
        ```java
        \\\
        int year = new Date().getYear() + 1900;
        \\\
        ```
    compliant:
        ```java
        \\\
        int year = LocalDate.now().getYear();
        \\\
        ```
    languages: [java]
    tags: [deprecation, api-usage]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/methods-met/met02-j/
