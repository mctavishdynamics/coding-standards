use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaIds08J:
    standard: @{CertJava}
    ruleId: IDS08-J
    title: Sanitize untrusted data included in a regular expression
    statement:
        Do not build a regular expression from untrusted input without
        sanitizing it. Quote the input with Pattern.quote, or whitelist the
        characters it may contain.
    rationale:
        Injected regex syntax can change what a pattern matches, which can
        bypass checks, leak data or cause catastrophic backtracking. CERT
        rates likelihood unlikely, detectable yes, repairable no, priority
        P4, level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```java
        \\\
        Pattern p = Pattern.compile("^" + userPrefix + ".*$");
        \\\
        ```
    compliant:
        ```java
        \\\
        Pattern p = Pattern.compile("^" + Pattern.quote(userPrefix) + ".*$");
        \\\
        ```
    languages: [java]
    tags: [regex, injection, input-validation]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/input-validation-and-data-sanitization-ids/ids08-j/
