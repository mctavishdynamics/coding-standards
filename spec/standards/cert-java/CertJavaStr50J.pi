use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaStr50J:
    standard: @{CertJava}
    ruleId: STR50-J
    title: Use the appropriate method for counting characters in a string
    statement:
        Do not assume one char is one character. Use code point methods, or
        BreakIterator for user-perceived characters, when counting, indexing
        or splitting strings that may hold supplementary or combining
        characters.
    rationale:
        Supplementary characters take two chars and combining sequences take
        several, so length() and substring() can count wrongly or split a
        character in half. CERT rates likelihood unlikely, detectable yes,
        repairable no, priority P2, level L3.
    exceptions: null
    severity: low
    noncompliant:
        ```java
        \\\
        String name = "Zo\uD83D\uDE00";
        int length = name.length();  // 4
        String shortName = name.substring(0, 3);  // cuts the emoji
        \\\
        ```
    compliant:
        ```java
        \\\
        String name = "Zo\uD83D\uDE00";
        int length = name.codePointCount(0, name.length());  // 3
        int end = name.offsetByCodePoints(0, 3);
        String shortName = name.substring(0, end);
        \\\
        ```
    languages: [java]
    tags: [recommendation, strings, unicode]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/recommendations/characters-and-strings-str/str50-j/
