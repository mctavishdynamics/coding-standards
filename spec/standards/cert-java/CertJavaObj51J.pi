use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaObj51J:
    standard: @{CertJava}
    ruleId: OBJ51-J
    title: Minimize the accessibility of classes and their members
    statement:
        Give each class, interface, method and field the most restrictive
        access level that still lets the program work. Make members private
        or package-private unless they are part of a deliberate API.
    rationale:
        Excess access breaks encapsulation and gives untrusted code more
        ways to call or change internals, which weakens security.
    exceptions:
        When a system's API is designed for third-party code to call or
        extend, that API has to be public, and this need takes priority over
        the guideline.
    severity: null
    noncompliant:
        ```java
        \\\
        public class TokenStore {
            public Map<String, String> tokens = new HashMap<>();

            public void purgeAll() {
                tokens.clear();
            }
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        final class TokenStore {
            private final Map<String, String> tokens = new HashMap<>();

            void purgeAll() {
                tokens.clear();
            }
        }
        \\\
        ```
    languages: [java]
    tags: [recommendation, access-control, encapsulation]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/recommendations/object-orientation-obj/obj51-j/
