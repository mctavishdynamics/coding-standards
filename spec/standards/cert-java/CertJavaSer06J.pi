use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaSer06J:
    standard: @{CertJava}
    ruleId: SER06-J
    title: Make defensive copies of private mutable components during deserialization
    statement:
        In readObject, copy every private mutable field after reading it,
        and validate the copy.
    rationale:
        An attacker can craft a stream that keeps an extra reference to the
        object's internal mutable field and use it later to break the
        class's invariants. CERT's risk assessment gives likelihood
        probable, detectable yes, repairable yes, priority P6 and level L2.
    exceptions: null
    severity: low
    noncompliant:
        ```java
        \\\
        private int[] scores;

        private void readObject(ObjectInputStream s)
                throws ClassNotFoundException, IOException {
            s.defaultReadObject();
            requireValid(scores);
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        private int[] scores;

        private void readObject(ObjectInputStream s)
                throws ClassNotFoundException, IOException {
            s.defaultReadObject();
            scores = scores.clone();
            requireValid(scores);
        }
        \\\
        ```
    languages: [java]
    tags: [serialization, defensive-copy]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/serialization-ser/ser06-j/
