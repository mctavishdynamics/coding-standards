use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaDcl60J:
    standard: @{CertJava}
    ruleId: DCL60-J
    title: Avoid cyclic dependencies between packages
    statement:
        Keep package dependencies acyclic, so that they form a directed
        acyclic graph. Break cycles by moving shared types into their own
        package or by depending on interfaces.
    rationale:
        Cycles spread the effects of every change across packages, make
        builds fragile and testing harder, and let a weakness in one package
        affect others.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        // package billing
        import shop.orders.Order;
        public class Invoice { Order order; }

        // package orders
        import shop.billing.Invoice;
        public class Order { Invoice invoice; }
        \\\
        ```
    compliant:
        ```java
        \\\
        // package model
        public interface Billable { long amountCents(); }

        // package billing
        import shop.model.Billable;
        public class Invoice { Billable item; }

        // package orders
        import shop.model.Billable;
        public class Order implements Billable { public long amountCents() { return 0; } }
        \\\
        ```
    languages: [java]
    tags: [recommendation, design, packages, maintainability]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/recommendations/declarations-and-initialization-dcl/dcl60-j/
