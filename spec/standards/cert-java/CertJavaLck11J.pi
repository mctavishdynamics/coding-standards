use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaLck11J:
    standard: @{CertJava}
    ruleId: LCK11-J
    title: Avoid client-side locking when using classes that do not commit to their locking strategy
    statement:
        Do not add compound operations to a thread-safe class by locking on
        the object from the outside unless that class documents which lock
        it uses. Prefer composition with your own private lock.
    rationale:
        If the class uses a different lock, or changes its lock later, the
        client's locking no longer excludes the class's own operations and
        the compound action is not atomic. CERT's risk assessment gives
        likelihood probable, detectable no, repairable no, priority P2 and
        level L3.
    exceptions: null
    severity: low
    noncompliant:
        ```java
        \\\
        // Roster makes no promise about which lock it uses internally.
        static void enrolOnce(Roster roster, Student s) {
            synchronized (roster) {
                if (!roster.has(s)) roster.enrol(s);
            }
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        final class GuardedRoster {
            private final Roster roster = new Roster();
            private final Object rosterGuard = new Object();

            void enrolOnce(Student s) {
                synchronized (rosterGuard) {
                    if (!roster.has(s)) roster.enrol(s);
                }
            }
        }
        \\\
        ```
    languages: [java]
    tags: [concurrency, locking, api-design]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/locking-lck/lck11-j/
