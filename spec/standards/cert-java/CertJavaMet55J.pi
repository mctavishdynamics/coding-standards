use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaMet55J:
    standard: @{CertJava}
    ruleId: MET55-J
    title: Return an empty array or collection instead of a null value for methods that return an array or collection
    statement:
        Methods that return an array or collection should return an empty
        one, not null, when there are no elements.
    rationale:
        Callers often forget to check for null, so a null return can cause a
        NullPointerException and a denial of service.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        List<Order> pendingOrders() {
            if (orders.isEmpty()) {
                return null;
            }
            return new ArrayList<>(orders);
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        List<Order> pendingOrders() {
            if (orders.isEmpty()) {
                return Collections.emptyList();
            }
            return new ArrayList<>(orders);
        }
        \\\
        ```
    languages: [java]
    tags: [recommendation, null-safety, collections, api-design]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/recommendations/methods-met/met55-j/
