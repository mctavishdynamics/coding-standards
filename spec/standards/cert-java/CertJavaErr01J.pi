use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaErr01J:
    standard: @{CertJava}
    ruleId: ERR01-J
    title: Do not allow exceptions to expose sensitive information
    statement:
        Do not let exception messages or exception types that reveal
        sensitive details, such as file paths or system structure, reach
        untrusted users. Catch them, log internally, and report a generic
        error.
    rationale:
        Exception text and type can tell an attacker about internal
        structure, such as which files exist, and help plan further attacks.
        CERT rates likelihood probable, detectable no, repairable yes,
        priority P8, level L2.
    exceptions: null
    severity: medium
    noncompliant:
        ```java
        \\\
        } catch (FileNotFoundException e) {
            response.sendError(500, e.getMessage());
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        } catch (FileNotFoundException e) {
            log.log(Level.WARNING, "Report file missing", e);
            response.sendError(500, "Report unavailable");
        }
        \\\
        ```
    languages: [java]
    tags: [exceptions, information-leak]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/exceptional-behavior-err/err01-j/
