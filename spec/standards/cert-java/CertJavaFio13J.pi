use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaFio13J:
    standard: @{CertJava}
    ruleId: FIO13-J
    title: Do not log sensitive information outside a trust boundary
    statement:
        Keep passwords, credit card numbers, personal data and similar
        sensitive values out of logs that are readable outside the trust
        boundary. Mask or omit them, or log them only at levels that stay
        within the boundary.
    rationale:
        Logs are widely readable and long-lived. Sensitive data in them can
        be leaked and may break privacy laws and regulations such as PCI
        DSS. CERT's risk assessment gives likelihood probable, detectable
        no, repairable no, priority P4 and level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```java
        \\\
        log.info("Login failed for " + user + " with password " + password);
        \\\
        ```
    compliant:
        ```java
        \\\
        log.info("Login failed for user id " + userId);
        \\\
        ```
    languages: [java]
    tags: [logging, sensitive-data, privacy]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/input-output-fio/fio13-j/
