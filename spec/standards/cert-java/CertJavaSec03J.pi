use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaSec03J:
    standard: @{CertJava}
    ruleId: SEC03-J
    title: Do not load trusted classes after allowing untrusted code to load arbitrary classes
    statement:
        If untrusted code may load classes, load every benign class the
        trusted code needs before that happens.
    rationale:
        Untrusted code can load a malicious class with the same name as a
        needed benign class, and the trusted code then receives the
        malicious one. CERT's risk assessment gives likelihood probable,
        detectable no, repairable no, priority P6 and level L2.
    exceptions: null
    severity: high
    noncompliant: null
    compliant: null
    languages: [java]
    tags: [security, class-loading]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/platform-security-sec/sec03-j/
