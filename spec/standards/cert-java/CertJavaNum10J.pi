use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaNum10J:
    standard: @{CertJava}
    ruleId: NUM10-J
    title: Do not construct BigDecimal objects from floating-point literals
    statement:
        Create BigDecimal values from strings or with BigDecimal.valueOf,
        not with the BigDecimal(double) constructor applied to a literal.
    rationale:
        A decimal literal such as 0.1 has no exact binary representation,
        and the double constructor keeps the full inexact value. CERT rates
        likelihood probable, detectable yes, repairable yes, priority P6,
        level L2.
    exceptions: null
    severity: low
    noncompliant:
        ```java
        \\\
        BigDecimal fee = new BigDecimal(0.1);
        \\\
        ```
    compliant:
        ```java
        \\\
        BigDecimal fee = new BigDecimal("0.1");
        \\\
        ```
    languages: [java]
    tags: [floating-point, bigdecimal, precision]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/numeric-types-and-operations-num/num10-j/
