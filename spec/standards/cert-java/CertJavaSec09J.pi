use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaSec09J:
    standard: @{CertJava}
    ruleId: SEC09-J
    title: Never leak the results of certain standard API methods from trusted code to untrusted code
    statement:
        Do not pass the results of sensitive, caller-sensitive standard API
        methods from trusted code to untrusted code, directly or through
        other objects.
    rationale:
        Those results can carry the trusted code's capabilities, and the
        leak is transitive. The source marks this proposed rule as under
        construction and incomplete.
    exceptions: null
    severity: null
    noncompliant: null
    compliant: null
    languages: [java]
    tags: [security, untrusted-code, information-leak]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/platform-security-sec/sec09-j/
