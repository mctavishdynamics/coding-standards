use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaMsc01J:
    standard: @{CertJava}
    ruleId: MSC01-J
    title: Do not use an empty infinite loop
    statement:
        Do not write infinite loops with empty bodies. Put real work, a
        sleep, or a wait for a condition in the loop.
    rationale:
        An empty loop burns CPU doing nothing, and optimizing compilers may
        remove it, changing the program's behavior. CERT's risk assessment
        gives likelihood unlikely, detectable yes, repairable yes, priority
        P3 and level L3.
    exceptions: null
    severity: low
    noncompliant:
        ```java
        \\\
        while (true) {
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        while (true) {
            Thread.sleep(1000);
        }
        \\\
        ```
    languages: [java]
    tags: [control-flow, performance]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/miscellaneous-msc/msc01-j/
