use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaMsc09J:
    standard: @{CertJava}
    ruleId: MSC09-J
    title: For OAuth, ensure the relying party receiving the user's ID is the one the access token was granted to
    statement:
        In an OAuth flow, check that the relying party that receives the
        user's ID in the last step is the same party the access token was
        issued to.
    rationale:
        Otherwise a token issued to one party can be replayed to another to
        log in as the user. The source marks this guideline as under
        construction. CERT's risk assessment gives likelihood probable,
        detectable no, repairable no, priority P4 and level L3.
    exceptions: null
    severity: medium
    noncompliant: null
    compliant: null
    languages: [java]
    tags: [security, oauth, authentication]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/miscellaneous-msc/msc09-j/
