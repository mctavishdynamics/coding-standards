use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaMsc54J:
    standard: @{CertJava}
    ruleId: MSC54-J
    title: Avoid inadvertent wrapping of loop counters
    statement:
        Write loop conditions so the loop ends even when the counter changes
        by more than one or approaches its type's limit. Prefer relational
        tests over equality and watch for overflow.
    rationale:
        A counter can skip past an equality test or wrap around, giving an
        infinite loop or a denial of service if an attacker influences the
        bounds.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        for (int i = 1; i != 10; i += 2) {
            process(i);
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        for (int i = 1; i < 10; i += 2) {
            process(i);
        }
        \\\
        ```
    languages: [java]
    tags: [recommendation, loops, integer-overflow]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/recommendations/miscellaneous-msc/msc54-j/
