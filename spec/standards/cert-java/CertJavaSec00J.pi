use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaSec00J:
    standard: @{CertJava}
    ruleId: SEC00-J
    title: Do not allow privileged blocks to leak sensitive information across a trust boundary
    statement:
        Code inside doPrivileged must not return or expose sensitive data or
        capabilities to callers. Return only what callers are allowed to
        have, and hide exceptions that reveal details.
    rationale:
        The privileged block runs with elevated rights, so anything it hands
        back gives untrusted callers access they would otherwise be denied.
        CERT's risk assessment gives likelihood likely, detectable no,
        repairable no, priority P6 and level L2.
    exceptions: null
    severity: medium
    noncompliant:
        ```java
        \\\
        public FileInputStream openPasswordFile() {
            return AccessController.doPrivileged(
                (PrivilegedAction<FileInputStream>) () -> new FileInputStream(PASSWD));
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        private boolean checkPassword(String user, char[] pass) {
            return AccessController.doPrivileged(
                (PrivilegedAction<Boolean>) () -> verify(PASSWD, user, pass));
        }
        \\\
        ```
    languages: [java]
    tags: [security, privileges, information-leak]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/platform-security-sec/sec00-j/
