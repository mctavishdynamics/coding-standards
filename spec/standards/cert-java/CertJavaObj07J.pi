use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaObj07J:
    standard: @{CertJava}
    ruleId: OBJ07-J
    title: Do not let sensitive classes be copied
    statement:
        Prevent copying of classes that hold sensitive data. Do not
        implement Cloneable, make the class final, or override clone to
        throw CloneNotSupportedException.
    rationale:
        Cloning creates instances without running the constructor, so
        attackers can bypass checks, duplicate singletons or break
        invariants. CERT rates likelihood probable, detectable no,
        repairable no, priority P4, level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```java
        \\\
        public class SessionKey implements Cloneable {
            private final byte[] key;
            public SessionKey(byte[] key) { this.key = key.clone(); }
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        public final class SessionKey {
            private final byte[] key;
            public SessionKey(byte[] key) { this.key = key.clone(); }
        }
        \\\
        ```
    languages: [java]
    tags: [cloning, sensitive-data]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/object-orientation-obj/obj07-j/
