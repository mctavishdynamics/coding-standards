export coding-standard CertJava:
    title: SEI CERT Oracle Coding Standard for Java
    publisher: Carnegie Mellon University Software Engineering Institute
    url: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/
    version: null
    license:
        CC BY 4.0 for the text and MIT for the code examples, copyright
        2026 Carnegie Mellon University
    description:
        Secure coding rules for Java from the CERT Division of the SEI, each
        rated by severity, likelihood, detectability and repairability. It
        covers input validation, numerics, objects, exceptions, concurrency
        and more.
