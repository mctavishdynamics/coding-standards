use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaMsc63J:
    standard: @{CertJava}
    ruleId: MSC63-J
    title: Ensure that SecureRandom is properly seeded
    statement:
        Let SecureRandom seed itself by using the no-argument constructor or
        getInstanceStrong(). Do not supply a seed, and never a predictable
        one such as the current time.
    rationale:
        A predictable seed makes the generated numbers predictable, giving
        attackers information about keys, tokens or other secrets.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        SecureRandom random = new SecureRandom(
                Long.toString(System.currentTimeMillis()).getBytes());
        \\\
        ```
    compliant:
        ```java
        \\\
        SecureRandom random = new SecureRandom();
        byte[] token = new byte[32];
        random.nextBytes(token);
        \\\
        ```
    languages: [java]
    tags: [recommendation, random-numbers, cryptography]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/recommendations/miscellaneous-msc/msc63-j/
