use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaIds04J:
    standard: @{CertJava}
    ruleId: IDS04-J
    title: Safely extract files from ZipInputStream
    statement:
        When extracting archive entries, canonicalize each entry's target
        path and check it stays inside the destination directory, and limit
        the number of entries and the total size actually extracted.
    rationale:
        Entry names can contain path traversal sequences that overwrite
        files elsewhere, and a small archive can expand to exhaust disk or
        memory (a zip bomb). Declared entry sizes can be forged, so count
        bytes as they are read. CERT rates likelihood probable, detectable
        no, repairable no, priority P2, level L3.
    exceptions: null
    severity: low
    noncompliant:
        ```java
        \\\
        try (ZipInputStream archive = new ZipInputStream(upload)) {
            for (ZipEntry e; (e = archive.getNextEntry()) != null; ) {
                Path target = Paths.get(unpackRoot, e.getName());
                Files.copy(archive, target);
            }
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        try (ZipInputStream archive = new ZipInputStream(upload)) {
            Path root = Paths.get(unpackRoot).toRealPath();
            int seen = 0;
            long written = 0;
            for (ZipEntry e; (e = archive.getNextEntry()) != null; ) {
                if (++seen > ENTRY_LIMIT) throw new ZipException("too many");
                Path target = root.resolve(e.getName()).normalize();
                if (!target.startsWith(root)) throw new ZipException("escape");
                written += copyBounded(archive, target, BYTE_LIMIT - written);
            }
        }
        \\\
        ```
    languages: [java]
    tags: [file-io, path-traversal, denial-of-service]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/input-validation-and-data-sanitization-ids/ids04-j/
