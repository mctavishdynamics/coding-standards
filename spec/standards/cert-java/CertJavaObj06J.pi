use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaObj06J:
    standard: @{CertJava}
    ruleId: OBJ06-J
    title: Defensively copy mutable inputs and mutable internal components
    statement:
        Copy mutable arguments before validating and storing them, and
        return copies of mutable internal components. Do not use clone on
        objects whose class an attacker could subclass.
    rationale:
        A caller can change a mutable object after it passes validation, a
        time-of-check to time-of-use race, or keep a reference into the
        object's internals. CERT rates likelihood probable, detectable no,
        repairable no, priority P4, level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```java
        \\\
        public void setDeadline(Date deadline) {
            if (deadline.before(new Date())) throw new IllegalArgumentException();
            this.deadline = deadline;
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        public void setDeadline(Date deadline) {
            Date copy = new Date(deadline.getTime());
            if (copy.before(new Date())) throw new IllegalArgumentException();
            this.deadline = copy;
        }
        \\\
        ```
    languages: [java]
    tags: [defensive-copy, mutability, toctou]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/object-orientation-obj/obj06-j/
