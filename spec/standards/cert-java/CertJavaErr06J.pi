use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaErr06J:
    standard: @{CertJava}
    ruleId: ERR06-J
    title: Do not throw undeclared checked exceptions
    statement:
        Do not use tricks such as Class.newInstance, Thread.stop, generic
        casts or bytecode manipulation to throw checked exceptions a method
        does not declare.
    rationale:
        Callers rely on the throws clause to know which checked exceptions
        to handle, and undeclared ones slip past them. CERT rates likelihood
        unlikely, detectable no, repairable no, priority P1, level L3.
    exceptions: null
    severity: low
    noncompliant:
        ```java
        \\\
        Object plugin = pluginClass.newInstance();
        \\\
        ```
    compliant:
        ```java
        \\\
        Object plugin = pluginClass.getDeclaredConstructor().newInstance();
        \\\
        ```
    languages: [java]
    tags: [exceptions, api-design]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/exceptional-behavior-err/err06-j/
