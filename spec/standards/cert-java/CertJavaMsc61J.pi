use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaMsc61J:
    standard: @{CertJava}
    ruleId: MSC61-J
    title: Do not use insecure or weak cryptographic algorithms
    statement:
        Avoid broken or weak algorithms, for example DES, RC4, MD5 and
        SHA-1, for protecting sensitive data. Choose current ones with
        modern modes, such as AES in GCM mode.
    rationale:
        Weak cryptography can be broken by brute force or known attacks,
        exposing the protected information.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        MessageDigest md = MessageDigest.getInstance("MD5");
        byte[] fingerprint = md.digest(contract);
        \\\
        ```
    compliant:
        ```java
        \\\
        MessageDigest md = MessageDigest.getInstance("SHA-256");
        byte[] fingerprint = md.digest(contract);
        \\\
        ```
    languages: [java]
    tags: [recommendation, cryptography]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/recommendations/miscellaneous-msc/msc61-j/
