use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaMet54J:
    standard: @{CertJava}
    ruleId: MET54-J
    title: Always provide feedback about the resulting value of a method
    statement:
        Design methods so that callers can learn the result of the
        operation, through a return value, such as a boolean status, or by
        throwing an exception.
    rationale:
        A method that fails silently leaves callers unaware of the real
        state, which leads to inconsistent objects and unexpected behavior.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        void updateNode(int id, String value) {
            Node n = find(id);
            if (n != null) {
                n.setValue(value);
            }
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        boolean updateNode(int id, String value) {
            Node n = find(id);
            if (n == null) {
                return false;
            }
            n.setValue(value);
            return true;
        }
        \\\
        ```
    languages: [java]
    tags: [recommendation, api-design, error-handling]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/recommendations/methods-met/met54-j/
