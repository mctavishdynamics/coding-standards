use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaMsc07J:
    standard: @{CertJava}
    ruleId: MSC07-J
    title: Prevent multiple instantiations of singleton objects
    statement:
        Make sure a singleton cannot be created more than once, through a
        public constructor, unsafe lazy initialization, serialization,
        cloning or reflection. An enum type is the simplest safe form.
    rationale:
        A second instance breaks the single shared state the design relies
        on, for example for resource control or logging. CERT's risk
        assessment gives likelihood unlikely, detectable yes, repairable no,
        priority P2 and level L3.
    exceptions: null
    severity: low
    noncompliant:
        ```java
        \\\
        public class Registry {
            private static Registry instance;
            public static Registry get() {
                if (instance == null) instance = new Registry();
                return instance;
            }
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        public enum Registry {
            INSTANCE;
        }
        \\\
        ```
    languages: [java]
    tags: [design-patterns, singleton, concurrency]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/miscellaneous-msc/msc07-j/
