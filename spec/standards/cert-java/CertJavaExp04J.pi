use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaExp04J:
    standard: @{CertJava}
    ruleId: EXP04-J
    title: Pass arguments of the collection's element type to Collections methods
    statement:
        When calling a method that accepts Object, such as get, contains or
        remove, pass an argument whose type matches the type parameter of
        the collection or map.
    rationale:
        These methods accept any object, so a value of the wrong type
        compiles but never matches, and the call silently does nothing. CERT
        rates likelihood probable, detectable yes, repairable no, priority
        P4, level L2.
    exceptions:
        Passing an object of another type to equals is acceptable. Legacy
        code that iterates over mixed-type objects may also pass other types
        when a no-op is the expected outcome.
    severity: low
    noncompliant:
        ```java
        \\\
        Set<Short> seen = new HashSet<>();
        for (short i = 0; i < 100; i++) {
            seen.add(i);
            seen.remove(i - 1);  // removes an Integer, never matches
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        Set<Short> seen = new HashSet<>();
        for (short i = 0; i < 100; i++) {
            seen.add(i);
            seen.remove((short) (i - 1));
        }
        \\\
        ```
    languages: [java]
    tags: [collections, generics, types]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/expressions-exp/exp04-j/
