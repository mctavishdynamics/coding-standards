use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaErr09J:
    standard: @{CertJava}
    ruleId: ERR09-J
    title: Do not allow untrusted code to terminate the JVM
    statement:
        Prevent accidental or malicious calls to System.exit from code such
        as plugins or web components, and perform cleanup through shutdown
        hooks when the JVM is terminated.
    rationale:
        System.exit stops every thread in the JVM, so one call can take down
        a whole server and deny service. CERT rates likelihood unlikely,
        detectable no, repairable no, priority P1, level L3.
    exceptions:
        A command-line utility may call System.exit, for example when it is
        given the wrong number of arguments.
    severity: low
    noncompliant:
        ```java
        \\\
        public void handle(Request req) {
            if (req.isInvalid()) {
                System.exit(1);
            }
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        public void handle(Request req) {
            if (req.isInvalid()) {
                throw new IllegalArgumentException("Invalid request");
            }
        }
        \\\
        ```
    languages: [java]
    tags: [denial-of-service, termination]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/exceptional-behavior-err/err09-j/
