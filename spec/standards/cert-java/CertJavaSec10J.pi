use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaSec10J:
    standard: @{CertJava}
    ruleId: SEC10-J
    title: Never permit untrusted code to invoke any API that may (possibly transitively) invoke the reflection APIs
    statement:
        Untrusted code must not be able to reach, directly or indirectly,
        any API that performs reflection using the permissions of trusted
        code.
    rationale:
        Reflection with trusted permissions is among the most serious
        breaches in Java. The source marks this proposed rule as under
        construction and incomplete.
    exceptions:
        Indirect calls are acceptable if every argument is fully sanitized
        and nothing produced by the reflection is ever exposed to the
        caller.
    severity: null
    noncompliant: null
    compliant: null
    languages: [java]
    tags: [security, reflection, untrusted-code]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/platform-security-sec/sec10-j/
