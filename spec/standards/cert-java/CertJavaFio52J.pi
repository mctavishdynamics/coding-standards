use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaFio52J:
    standard: @{CertJava}
    ruleId: FIO52-J
    title: Do not store unencrypted sensitive information on the client side
    statement:
        Do not keep sensitive data such as credentials in cookies or other
        client-side storage in plain form. Keep it on the server and give
        the client only a session identifier.
    rationale:
        Anyone able to compromise the client, for example with cross-site
        scripting or by stealing the device, can read data kept there.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        Cookie c = new Cookie("credentials", user + ":" + password);
        response.addCookie(c);
        \\\
        ```
    compliant:
        ```java
        \\\
        HttpSession session = request.getSession(true);
        session.setAttribute("user", user);
        \\\
        ```
    languages: [java]
    tags: [recommendation, sensitive-data, web, sessions]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/recommendations/input-output-fio/fio52-j/
