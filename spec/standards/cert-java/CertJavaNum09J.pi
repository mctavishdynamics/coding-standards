use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaNum09J:
    standard: @{CertJava}
    ruleId: NUM09-J
    title: Do not use floating-point variables as loop counters
    statement:
        Use an integer as the loop counter and derive any floating-point
        value from it inside the loop.
    rationale:
        Floating-point values cannot represent many fractions exactly, and
        large values may not change when incremented, so the loop can run
        the wrong number of times or forever. CERT rates likelihood
        probable, detectable yes, repairable no, priority P4, level L3.
    exceptions: null
    severity: low
    noncompliant:
        ```java
        \\\
        for (float x = 0.1f; x <= 1.0f; x += 0.1f) {
            plot(x);
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        for (int i = 1; i <= 10; i++) {
            plot(i / 10.0f);
        }
        \\\
        ```
    languages: [java]
    tags: [floating-point, loops]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/numeric-types-and-operations-num/num09-j/
