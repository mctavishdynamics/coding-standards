use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaFio53J:
    standard: @{CertJava}
    ruleId: FIO53-J
    title: Use the serialization methods writeUnshared() and readUnshared() with care
    statement:
        Use writeUnshared() and readUnshared() only for objects that are not
        part of reference cycles. For object graphs with cycles, use
        writeObject() and readObject().
    rationale:
        Unshared serialization does not preserve back-references, so a round
        trip of a data structure with cycles fails or produces a different
        graph.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        Person alice = new Person("Alice");
        alice.setFriend(new Person("Bob", alice));
        out.writeUnshared(alice);
        \\\
        ```
    compliant:
        ```java
        \\\
        Person alice = new Person("Alice");
        alice.setFriend(new Person("Bob", alice));
        out.writeObject(alice);
        \\\
        ```
    languages: [java]
    tags: [recommendation, serialization]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/recommendations/input-output-fio/fio53-j/
