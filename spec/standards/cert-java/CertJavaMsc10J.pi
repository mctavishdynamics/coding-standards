use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaMsc10J:
    standard: @{CertJava}
    ruleId: MSC10-J
    title: Do not use OAuth 2.0 implicit grant (unmodified) for authentication
    statement:
        Do not use the unmodified OAuth 2.0 implicit grant to authenticate
        users. It may be used to authorize access, not to authenticate.
    rationale:
        An access token from the implicit grant does not prove who the user
        is to the receiving party, so it can be misused to impersonate
        users. The source marks this guideline as under construction. CERT's
        risk assessment gives likelihood unlikely, detectable no, repairable
        no, priority P6 and level L2.
    exceptions: null
    severity: high
    noncompliant: null
    compliant: null
    languages: [java]
    tags: [security, oauth, authentication]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/miscellaneous-msc/msc10-j/
