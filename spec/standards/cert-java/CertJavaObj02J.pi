use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaObj02J:
    standard: @{CertJava}
    ruleId: OBJ02-J
    title: Preserve dependencies in subclasses when changing superclasses
    statement:
        When you change a superclass, check that every invariant its
        subclasses rely on still holds, for example that a new method does
        not bypass a check a subclass adds by overriding.
    rationale:
        A superclass change can silently break assumptions in subclasses,
        such as a security check, and open a vulnerability. CERT rates
        likelihood probable, detectable no, repairable no, priority P4,
        level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```java
        \\\
        class Account {
            void withdraw(long amount) { /* ... */ }
            void overdraft(long amount) { /* new: skips subclass checks */ }
        }
        class CheckedAccount extends Account {
            @Override void withdraw(long amount) { requireAuth(); super.withdraw(amount); }
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        class Account {
            void withdraw(long amount) { /* ... */ }
            void overdraft(long amount) { /* ... */ }
        }
        class CheckedAccount extends Account {
            @Override void withdraw(long amount) { requireAuth(); super.withdraw(amount); }
            @Override void overdraft(long amount) { requireAuth(); super.overdraft(amount); }
        }
        \\\
        ```
    languages: [java]
    tags: [inheritance, maintenance]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/object-orientation-obj/obj02-j/
