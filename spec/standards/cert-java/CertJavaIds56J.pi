use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaIds56J:
    standard: @{CertJava}
    ruleId: IDS56-J
    title: Prevent arbitrary file upload
    statement:
        When accepting file uploads, restrict the allowed file types and
        check the actual content of each file, not just its name or the
        client-supplied content type. Store uploads where they cannot be
        executed or served as active content.
    rationale:
        An uploaded file containing code, such as a JSP page or an HTML page
        with a script, can be executed by the server or a browser. That can
        lead to privilege escalation and arbitrary code execution.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        Part part = request.getPart("file");
        part.write(webRoot + "/uploads/" + part.getSubmittedFileName());
        \\\
        ```
    compliant:
        ```java
        \\\
        Part part = request.getPart("file");
        String type = new Tika().detect(part.getInputStream());
        if (!type.equals("image/png") && !type.equals("image/jpeg")) {
            throw new ServletException("File type not allowed");
        }
        part.write(storageDir + "/" + UUID.randomUUID());
        \\\
        ```
    languages: [java]
    tags: [recommendation, files, input-validation, upload]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/recommendations/input-validation-and-data-sanitization-ids/ids56-j/
