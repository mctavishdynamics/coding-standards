use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaEnv00J:
    standard: @{CertJava}
    ruleId: ENV00-J
    title: Do not sign code that performs only unprivileged operations
    statement:
        Sign only code that actually needs elevated privileges. Leave code
        that runs within the sandbox unsigned.
    rationale:
        Users and policies often grant signed code full privileges. Signing
        code that does not need them widens the attack surface if that code
        has a weakness. CERT's risk assessment gives likelihood probable,
        detectable no, repairable no, priority P6 and level L2.
    exceptions:
        An organization with an internal PKI may sign unprivileged code for
        internal development tracking, using keys separate from those for
        released code, provided that code never reaches production. Applets
        may be signed yet run without full permissions, as Oracle requires
        since Java 7 update 21.
    severity: high
    noncompliant: null
    compliant: null
    languages: [java]
    tags: [security, code-signing, deployment]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/runtime-environment-env/env00-j/
