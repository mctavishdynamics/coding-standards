use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaMsc08J:
    standard: @{CertJava}
    ruleId: MSC08-J
    title: Do not store nonserializable objects as attributes in an HTTP session
    statement:
        Store only serializable objects as HTTP session attributes.
    rationale:
        Servlet containers may serialize sessions to persist or replicate
        them, and nonserializable attributes then fail or are lost. The
        source page is a stub. CERT's risk assessment gives likelihood
        probable, detectable no, repairable no, priority P2 and level L3.
    exceptions: null
    severity: low
    noncompliant:
        ```java
        \\\
        session.setAttribute("db", dataSource.getConnection());
        \\\
        ```
    compliant:
        ```java
        \\\
        session.setAttribute("userId", user.getId());
        \\\
        ```
    languages: [java]
    tags: [servlets, web, serialization]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/miscellaneous-msc/msc08-j/
