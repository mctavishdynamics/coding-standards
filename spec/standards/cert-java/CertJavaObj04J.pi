use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaObj04J:
    standard: @{CertJava}
    ruleId: OBJ04-J
    title: Give mutable classes copy functionality so instances can be passed to untrusted code
    statement:
        Give mutable classes a copy constructor or a static copy factory so
        callers can pass disposable copies to untrusted code. Only final
        classes should rely on overriding clone for this.
    rationale:
        Without a safe way to copy, code must hand the original object to
        untrusted code, which can then change it. CERT rates likelihood
        likely, detectable no, repairable no, priority P3, level L3.
    exceptions:
        Sensitive classes should not be copyable at all, as OBJ07-J
        requires.
    severity: low
    noncompliant:
        ```java
        \\\
        public class Schedule {
            private final List<LocalDate> dates = new ArrayList<>();
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        public class Schedule {
            private final List<LocalDate> dates = new ArrayList<>();
            public Schedule() {}
            public Schedule(Schedule other) {
                dates.addAll(other.dates);
            }
        }
        \\\
        ```
    languages: [java]
    tags: [mutability, defensive-copy]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/object-orientation-obj/obj04-j/
