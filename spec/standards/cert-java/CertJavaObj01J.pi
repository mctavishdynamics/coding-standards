use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaObj01J:
    standard: @{CertJava}
    ruleId: OBJ01-J
    title: Limit accessibility of fields
    statement:
        Declare fields private or package-private and expose them through
        methods that can enforce the class's invariants.
    rationale:
        Public or protected fields can be changed by any code, including
        attackers and concurrent threads, so the class cannot keep its
        invariants. CERT rates likelihood likely, detectable no, repairable
        no, priority P6, level L2.
    exceptions:
        Fields of a pure data structure with no behavior, fields of
        package-private or private nested classes, and static final fields
        holding immutable constants may be public or protected.
    severity: medium
    noncompliant:
        ```java
        \\\
        public class Account {
            public long balance;
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        public class Account {
            private long balance;
            public long getBalance() { return balance; }
            public void deposit(long amount) {
                if (amount <= 0) throw new IllegalArgumentException();
                balance = Math.addExact(balance, amount);
            }
        }
        \\\
        ```
    languages: [java]
    tags: [encapsulation, access-control]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/object-orientation-obj/obj01-j/
