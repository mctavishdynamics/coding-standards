use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaIds06J:
    standard: @{CertJava}
    ruleId: IDS06-J
    title: Exclude unsanitized user input from format strings
    statement:
        Never use untrusted input as the format string of format, printf or
        String.format. Pass it as an argument to a constant format string
        instead.
    rationale:
        Format specifiers embedded in untrusted data can expose other
        arguments, such as secrets, or throw exceptions that deny service.
        CERT rates likelihood unlikely, detectable yes, repairable no,
        priority P4, level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```java
        \\\
        System.out.printf(userInput + " did not match the card on %s%n", expiry);
        \\\
        ```
    compliant:
        ```java
        \\\
        System.out.printf("%s did not match the card on %s%n", userInput, expiry);
        \\\
        ```
    languages: [java]
    tags: [format-string, injection, input-validation]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/input-validation-and-data-sanitization-ids/ids06-j/
