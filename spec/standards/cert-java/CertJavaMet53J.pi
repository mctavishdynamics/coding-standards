use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaMet53J:
    standard: @{CertJava}
    ruleId: MET53-J
    title: Ensure that the clone() method calls super.clone()
    statement:
        Obtain the copy in a nonfinal class's clone() method by calling
        super.clone(), not by calling a constructor.
    rationale:
        A clone() that calls a constructor returns an object of the base
        class, so cloning a subclass yields an object of the wrong type.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        class Shape implements Cloneable {
            @Override
            public Shape clone() {
                return new Shape();
            }
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        class Shape implements Cloneable {
            @Override
            public Shape clone() throws CloneNotSupportedException {
                return (Shape) super.clone();
            }
        }
        \\\
        ```
    languages: [java]
    tags: [recommendation, cloning, inheritance]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/recommendations/methods-met/met53-j/
