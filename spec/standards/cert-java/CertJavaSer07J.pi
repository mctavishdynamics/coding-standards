use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaSer07J:
    standard: @{CertJava}
    ruleId: SER07-J
    title: Do not use the default serialized form for classes with implementation-defined invariants
    statement:
        For a class whose constructors enforce invariants, provide custom
        readObject logic that rechecks them, or a readResolve, rather than
        relying on the default serialized form.
    rationale:
        Deserialization bypasses constructors, so a forged stream can create
        objects that violate the invariants or duplicate singletons. CERT's
        risk assessment gives likelihood probable, detectable no, repairable
        no, priority P4 and level L3.
    exceptions: null
    severity: medium
    noncompliant:
        ```java
        \\\
        class Percent implements Serializable {
            private final int value;

            Percent(int value) {
                if (value < 0 || value > 100) throw new IllegalArgumentException();
                this.value = value;
            }
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        class Percent implements Serializable {
            private final int value;

            Percent(int value) {
                if (value < 0 || value > 100) throw new IllegalArgumentException();
                this.value = value;
            }

            private void readObject(ObjectInputStream s)
                    throws ClassNotFoundException, IOException {
                s.defaultReadObject();
                if (value < 0 || value > 100) {
                    throw new InvalidObjectException("out of range");
                }
            }
        }
        \\\
        ```
    languages: [java]
    tags: [serialization, invariants]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/serialization-ser/ser07-j/
