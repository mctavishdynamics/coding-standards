use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaVna02J:
    standard: @{CertJava}
    ruleId: VNA02-J
    title: Ensure that compound operations on shared variables are atomic
    statement:
        Perform compound operations such as ++, += or read-modify-write
        sequences on shared variables atomically, using synchronization,
        locks or the java.util.concurrent.atomic classes.
    rationale:
        These operations consist of several steps, so concurrent threads can
        interleave them and lose updates. CERT rates likelihood probable,
        detectable yes, repairable no, priority P8, level L2.
    exceptions: null
    severity: medium
    noncompliant:
        ```java
        \\\
        private volatile int hits;
        public void record() { hits++; }
        \\\
        ```
    compliant:
        ```java
        \\\
        private final AtomicInteger hits = new AtomicInteger();
        public void record() { hits.incrementAndGet(); }
        \\\
        ```
    languages: [java]
    tags: [concurrency, atomicity]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/visibility-and-atomicity-vna/vna02-j/
