use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaEnv04J:
    standard: @{CertJava}
    ruleId: ENV04-J
    title: Do not disable bytecode verification
    statement:
        Run Java programs with bytecode verification enabled. Never use
        options such as -Xverify:none or -noverify.
    rationale:
        Class files may be malformed or tampered with. The verifier is what
        stops nonconforming bytecode from breaking type safety and the JVM's
        guarantees. CERT's risk assessment gives likelihood likely,
        detectable no, repairable no, priority P9 and level L2.
    exceptions:
        The primordial class loader may skip verification of classes on the
        boot class path, which are protected by platform and file system
        controls.
    severity: high
    noncompliant:
        ```shell
        \\\
        java -Xverify:none -jar app.jar
        \\\
        ```
    compliant:
        ```shell
        \\\
        java -jar app.jar
        \\\
        ```
    languages: [java]
    tags: [security, jvm, deployment]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/runtime-environment-env/env04-j/
