use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaErr53J:
    standard: @{CertJava}
    ruleId: ERR53-J
    title: Try to gracefully recover from system errors
    statement:
        Where a system error such as OutOfMemoryError or StackOverflowError
        can be anticipated, catch it at a suitable level and recover or shut
        down in an orderly way instead of letting the program terminate
        abruptly.
    rationale:
        An uncaught system error ends the thread or the program abruptly,
        which can cause a denial of service.
    exceptions:
        After running out of memory, program data may be inconsistent, so
        restarting the process may be the safest response.
    severity: null
    noncompliant:
        ```java
        \\\
        void handle(Request r) {
            render(parseTree(r.body()));
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        void handle(Request r) {
            try {
                render(parseTree(r.body()));
            } catch (StackOverflowError e) {
                log.warn("Input nested too deeply");
                reject(r);
            }
        }
        \\\
        ```
    languages: [java]
    tags: [recommendation, exceptions, denial-of-service, resilience]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/recommendations/exceptional-behavior-err/err53-j/
