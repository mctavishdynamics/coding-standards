use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaSer08J:
    standard: @{CertJava}
    ruleId: SER08-J
    title: Minimize privileges before deserializing from a privileged context
    statement:
        Avoid deserializing inside a privileged block. When it must happen,
        limit the privileged action to the smallest set of permissions it
        needs.
    rationale:
        Crafted input deserialized with full privileges can build objects
        the attacker could not otherwise create, such as a custom class
        loader. CERT's risk assessment gives likelihood likely, detectable
        yes, repairable no, priority P18 and level L1.
    exceptions: null
    severity: high
    noncompliant:
        ```java
        \\\
        Object obj = AccessController.doPrivileged(
                (PrivilegedExceptionAction<Object>) () -> in.readObject());
        \\\
        ```
    compliant:
        ```java
        \\\
        Permission needed = new FilePermission(zoneDir + "/-", "read");
        AccessControlContext limited = new AccessControlContext(new ProtectionDomain[] {
                new ProtectionDomain(null, needed.newPermissionCollection())});
        Object obj = AccessController.doPrivileged(
                (PrivilegedExceptionAction<Object>) () -> in.readObject(), limited, needed);
        \\\
        ```
    languages: [java]
    tags: [serialization, privileges]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/serialization-ser/ser08-j/
