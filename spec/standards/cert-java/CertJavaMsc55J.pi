use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaMsc55J:
    standard: @{CertJava}
    ruleId: MSC55-J
    title: Use comments consistently and in a readable fashion
    statement:
        Use end-of-line comments for short notes and do not mix them with
        block comments in ways that hide code. To disable code, delete it or
        guard it rather than commenting it out with nested comments.
    rationale:
        Mixed or nested comments make it unclear which statements actually
        run, which can cause serious errors.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        /* Temporarily disabled
        validate(input);  /* check bounds */
        store(input);
        */
        \\\
        ```
    compliant:
        ```java
        \\\
        // Validation disabled while the new rules are reviewed
        store(input);
        \\\
        ```
    languages: [java]
    tags: [recommendation, comments, readability]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/recommendations/miscellaneous-msc/msc55-j/
