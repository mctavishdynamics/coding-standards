use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaFio08J:
    standard: @{CertJava}
    ruleId: FIO08-J
    title: Distinguish between characters or bytes read from a stream and -1
    statement:
        Store the int returned by InputStream.read() or Reader.read() in an
        int, compare it with -1, and only then cast it to byte or char.
    rationale:
        Casting first makes the end-of-stream value indistinguishable from a
        real 0xFF byte or 0xFFFF character, so loops end early or never end.
        CERT's risk assessment gives likelihood probable, detectable yes,
        repairable yes, priority P18 and level L1.
    exceptions: null
    severity: high
    noncompliant:
        ```java
        \\\
        byte b;
        while ((b = (byte) in.read()) != -1) {
            out.write(b);
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        int read;
        while ((read = in.read()) != -1) {
            out.write((byte) read);
        }
        \\\
        ```
    languages: [java]
    tags: [io, streams, type-conversion]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/input-output-fio/fio08-j/
