use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaErr07J:
    standard: @{CertJava}
    ruleId: ERR07-J
    title: Do not throw RuntimeException, Exception, or Throwable
    statement:
        Throw a specific exception class, from the standard library or one
        you define, instead of RuntimeException, Exception or Throwable.
    rationale:
        Callers cannot tell why a generic exception was thrown, so they
        cannot recover, and catching it would require catching broad types.
        CERT rates likelihood likely, detectable yes, repairable no,
        priority P6, level L2.
    exceptions:
        Code that sanitizes exceptions for a security policy may translate
        specific exceptions into more general ones.
    severity: low
    noncompliant:
        ```java
        \\\
        if (port < 0) {
            throw new RuntimeException("bad port");
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        if (port < 0) {
            throw new IllegalArgumentException("bad port: " + port);
        }
        \\\
        ```
    languages: [java]
    tags: [exceptions, api-design]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/exceptional-behavior-err/err07-j/
