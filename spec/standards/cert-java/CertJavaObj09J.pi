use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaObj09J:
    standard: @{CertJava}
    ruleId: OBJ09-J
    title: Compare classes and not class names
    statement:
        Check an object's type by comparing Class objects, with getClass()
        == Other.class or instanceof, not by comparing class name strings.
    rationale:
        Classes with the same name can come from different packages or class
        loaders, so a name check can accept a malicious class. CERT rates
        likelihood unlikely, detectable yes, repairable no, priority P6,
        level L2.
    exceptions: null
    severity: high
    noncompliant:
        ```java
        \\\
        if (obj.getClass().getName().equals("com.example.TrustedPlugin")) {
            grant(obj);
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        if (obj.getClass() == TrustedPlugin.class) {
            grant(obj);
        }
        \\\
        ```
    languages: [java]
    tags: [types, class-loading]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/object-orientation-obj/obj09-j/
