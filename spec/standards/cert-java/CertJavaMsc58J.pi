use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaMsc58J:
    standard: @{CertJava}
    ruleId: MSC58-J
    title: Prefer using iterators over enumerations
    statement:
        Use Iterator rather than Enumeration to traverse collections,
        especially when elements may be removed during traversal.
    rationale:
        Iterators support safe removal and are fail-fast, while removing
        elements during an enumeration can skip elements silently.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        Enumeration<String> e = names.elements();
        while (e.hasMoreElements()) {
            String n = e.nextElement();
            if (n.isEmpty()) {
                names.remove(n);
            }
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        Iterator<String> it = names.iterator();
        while (it.hasNext()) {
            if (it.next().isEmpty()) {
                it.remove();
            }
        }
        \\\
        ```
    languages: [java]
    tags: [recommendation, collections, iteration]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/recommendations/miscellaneous-msc/msc58-j/
