use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaExp53J:
    standard: @{CertJava}
    ruleId: EXP53-J
    title: Use parentheses for precedence of operation
    statement:
        Use parentheses to make the intended order of evaluation explicit,
        especially for bitwise, shift and conditional operators whose
        precedence is not intuitive.
    rationale:
        Operator precedence mistakes make expressions compute something else
        than intended, and parentheses also make the intent clear to
        readers.
    exceptions:
        Parentheses may be left out of arithmetic expressions that follow
        the usual algebraic precedence, such as x + y * z.
    severity: null
    noncompliant:
        ```java
        \\\
        if (flags & MASK == 0) {
            reset();
        }
        int value = base << 2 + offset;
        \\\
        ```
    compliant:
        ```java
        \\\
        if ((flags & MASK) == 0) {
            reset();
        }
        int value = (base << 2) + offset;
        \\\
        ```
    languages: [java]
    tags: [recommendation, expressions, operators, readability]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/recommendations/expressions-exp/exp53-j/
