use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaLck05J:
    standard: @{CertJava}
    ruleId: LCK05-J
    title: Synchronize access to static fields that can be modified by untrusted code
    statement:
        A method that untrusted code can call and that changes a static
        field must do its own synchronization. Do not rely on callers to
        lock.
    rationale:
        A static field is shared by every client, and an untrusted client
        can ignore any documented locking contract. The field can then be
        corrupted by concurrent updates. CERT's risk assessment gives
        likelihood probable, detectable no, repairable no, priority P2 and
        level L3.
    exceptions: null
    severity: low
    noncompliant:
        ```java
        \\\
        public final class Tally {
            private static long votes;

            // Docs ask callers to hold Tally.class while calling this.
            public static void cast() {
                votes++;
            }
        }
        \\\
        ```
    compliant:
        ```java
        \\\
        public final class Tally {
            private static final Object VOTE_GUARD = new Object();
            private static long votes;

            public static void cast() {
                synchronized (VOTE_GUARD) {
                    votes++;
                }
            }
        }
        \\\
        ```
    languages: [java]
    tags: [concurrency, static-fields, untrusted-code]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/locking-lck/lck05-j/
