use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaIds16J:
    standard: @{CertJava}
    ruleId: IDS16-J
    title: Prevent XML injection
    statement:
        Do not insert untrusted strings into XML documents unchecked.
        Validate the input, escape it, or build the document with an XML API
        or schema validation.
    rationale:
        Injected tags are interpreted by the parser and can override values
        in the document, such as a price. CERT rates likelihood probable,
        detectable yes, repairable no, priority P12, level L1.
    exceptions: null
    severity: high
    noncompliant:
        ```java
        \\\
        String note = request.getParameter("note");
        String body = "<ticket><note>" + note + "</note></ticket>";
        \\\
        ```
    compliant:
        ```java
        \\\
        Document doc = builder.newDocument();
        Element ticket = doc.createElement("ticket");
        Element note = doc.createElement("note");
        note.setTextContent(request.getParameter("note"));
        ticket.appendChild(note);
        doc.appendChild(ticket);
        \\\
        ```
    languages: [java]
    tags: [xml, injection, input-validation]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/rules/input-validation-and-data-sanitization-ids/ids16-j/
