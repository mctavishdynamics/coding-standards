use ../lib/CodingRule

from ./CertJava import CertJava

export coding-rule CertJavaMet51J:
    standard: @{CertJava}
    ruleId: MET51-J
    title: Do not use overloaded methods to differentiate between runtime types
    statement:
        Do not rely on overloading to choose behavior based on an object's
        runtime type. Use instanceof checks or polymorphic methods in the
        class hierarchy.
    rationale:
        Overload resolution happens at compile time from the static type, so
        the same overload runs whatever the actual object is.
    exceptions: null
    severity: null
    noncompliant:
        ```java
        \\\
        String describe(Object o) { return "object"; }
        String describe(List<?> l) { return "list"; }

        Object value = List.of(1, 2);
        describe(value);  // returns "object"
        \\\
        ```
    compliant:
        ```java
        \\\
        String describe(Object o) {
            if (o instanceof List<?>) {
                return "list";
            }
            return "object";
        }
        \\\
        ```
    languages: [java]
    tags: [recommendation, overloading, polymorphism]
    source: https://cmu-sei.github.io/secure-coding-standards/sei-cert-oracle-coding-standard-for-java/recommendations/methods-met/met51-j/
