use ../lib/CodingRule

from ./Pep257 import Pep257

export coding-rule Pep257TripleDoubleQuotes:
    standard: @{Pep257}
    ruleId: what-is-a-docstring-triple-double-quotes
    title: Use triple double quotes around docstrings
    statement:
        Always delimit docstrings with three double quotes. Use a raw
        triple-quoted string, r and then three double quotes, when the
        docstring contains backslashes.
    rationale:
        One delimiter style keeps docstrings consistent and easy to find. A
        raw string stops backslashes in the text from being read as escape
        sequences.
    exceptions: null
    severity: null
    noncompliant:
        ```python
        \\\
        def split_path(path):
            'Split path on the separator \\ or /.'
            return re.split(r"[\\/]", path)
        \\\
        ```
    compliant:
        ```python
        \\\
        def split_path(path):
            r"""Split path on the separator \ or /."""
            return re.split(r"[\\/]", path)
        \\\
        ```
    languages: [python]
    tags: [documentation, docstrings, strings]
    source: https://peps.python.org/pep-0257/#what-is-a-docstring
