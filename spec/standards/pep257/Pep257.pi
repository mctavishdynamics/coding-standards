use ../lib/CodingStandard

from ./Pep257ArgumentNames import Pep257ArgumentNames
from ./Pep257BlankLineAfterClassDocstring import
    Pep257BlankLineAfterClassDocstring
from ./Pep257ClassDocstring import Pep257ClassDocstring
from ./Pep257ClosingQuotesOnOwnLine import Pep257ClosingQuotesOnOwnLine
from ./Pep257DocstringIndentation import Pep257DocstringIndentation
from ./Pep257DocstringsForPublicObjects import Pep257DocstringsForPublicObjects
from ./Pep257FunctionDocstring import Pep257FunctionDocstring
from ./Pep257ImperativeMood import Pep257ImperativeMood
from ./Pep257ModuleDocstring import Pep257ModuleDocstring
from ./Pep257MultiLineSummaryLine import Pep257MultiLineSummaryLine
from ./Pep257NoBlankLinesAroundOneLiner import Pep257NoBlankLinesAroundOneLiner
from ./Pep257NoSignatureInDocstring import Pep257NoSignatureInDocstring
from ./Pep257OneLineDocstrings import Pep257OneLineDocstrings
from ./Pep257ScriptDocstring import Pep257ScriptDocstring
from ./Pep257SubclassDocstring import Pep257SubclassDocstring
from ./Pep257TripleDoubleQuotes import Pep257TripleDoubleQuotes

export coding-standard Pep257:
    title: PEP 257 - Docstring Conventions
    publisher: Python Software Foundation
    url: https://peps.python.org/pep-0257/
    version: 2024-04-17
    license: Public domain
    description:
        Conventions for the content and layout of Python docstrings,
        including one-line and multi-line forms and how tools handle their
        indentation.
    rules:
        - @{Pep257DocstringsForPublicObjects}
        - @{Pep257TripleDoubleQuotes}
        - @{Pep257OneLineDocstrings}
        - @{Pep257NoBlankLinesAroundOneLiner}
        - @{Pep257ImperativeMood}
        - @{Pep257NoSignatureInDocstring}
        - @{Pep257MultiLineSummaryLine}
        - @{Pep257BlankLineAfterClassDocstring}
        - @{Pep257ScriptDocstring}
        - @{Pep257ModuleDocstring}
        - @{Pep257FunctionDocstring}
        - @{Pep257ClassDocstring}
        - @{Pep257SubclassDocstring}
        - @{Pep257ArgumentNames}
        - @{Pep257ClosingQuotesOnOwnLine}
        - @{Pep257DocstringIndentation}
